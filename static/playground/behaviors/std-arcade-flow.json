  "source": "",
  "lolo": "app std-arcade-flow \"1.0.0\"\n\"Headless win/lose authority for the arcade play-for-tickets loop: owns only result. Listens SCORE_CHANGED (tickets + tokens) and sets result to won once tickets reach the target, lost when tokens run out first, else none. Renders nothing.\"\norbital ArcadeFlowOrbital {\n  entity ArcadeFlowData [runtime, shared] {\n    id : string!\n    result : string = \"none\"\n  }\n\n  trait ArcadeFlow -> @rebindable ArcadeFlowData [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.result \"none\")\n\n      SCORE_CHANGED -> active when @config.running\n        (set @entity.result (if (>= @payload.tickets @config.ticketsToWin) \"won\" (if (<= @payload.tokens 0) \"lost\" \"none\")))\n        (if (!= @entity.result \"none\") (emit GAME_END { result: @entity.result }) null)\n\n      RESTART -> active\n        (set @entity.result \"none\")\n    }\n\n    emits {\n      GAME_END -> external {\n        result : string!\n      }\n        @description \"Emitted when the play loop resolves to won or lost\"\n        @tier \"domain\"\n    }\n\n    listens {\n      SCORE_CHANGED { tickets : number, tokens : number }\n      RESTART { id : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, SCORE_CHANGED signals resolve win/lose; toggle to freeze\"\n        @tier \"domain\"\n      ticketsToWin : number = 5\n        @label \"Tickets To Win\"\n        @description \"Ticket count that ends the round in a win\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/arcade-flow\" as ArcadeFlowPage -> ArcadeFlow\n}\n"
}