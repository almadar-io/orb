  "source": "",
  "lolo": "app std-round-flow \"1.0.0\"\n\"Headless win/lose round-resolution mechanic: derives result (victory/defeat/none) from team survivor counts on each UNITS_CHANGED signal and emits GAME_END. Owns only result; boards own their own phase/turn. Renders nothing.\"\norbital RoundFlowOrbital {\n  entity RoundState [runtime, shared] {\n    id : string!\n    result : string = \"none\"\n  }\n\n  trait RoundFlow -> @rebindable RoundState [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.result \"none\")\n      UNITS_CHANGED -> active when @config.running\n        (set @entity.result (if (== @payload.playersAlive 0) \"defeat\" (if (== @payload.enemiesAlive 0) \"victory\" \"none\")))\n        (if (!= @entity.result \"none\") (emit GAME_END { result: @entity.result }) null)\n    }\n\n    emits {\n      GAME_END -> external {\n        result : string\n      }\n        @description \"Called when the round resolves to a win or loss\"\n        @tier \"domain\"\n    }\n\n    listens {\n      UNITS_CHANGED { playersAlive : number, enemiesAlive : number }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, incoming unit-count changes are evaluated for win/lose; toggle to freeze.\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/round-flow\" as RoundFlowPage -> RoundFlow\n}\n"
}