  "source": "",
  "lolo": "app std-marketing-showcase \"1.0.0\"\n\"Showcase grid atom for marketing pages. Renders a grid of portfolio or product showcase cards with images, badges, and descriptions. Pick for product galleries and portfolio sections.\"\n;; Config-driven showcase using the `showcase-organism` marketing pattern.\n;; Items are declared as an array of { title, description, image, href, badge, accentColor } objects.\n;; The atom emits SHOWCASE_CLICK when a card with an href is clicked.\norbital ShowcaseItemOrbital {\n    type ShowcaseCard = { id : string!, title : string!, description : string, image : { src : string!, alt : string! }!, href : string, badge : string, accentColor : string }\n\n  entity ShowcaseItem [runtime] {\n    id : string!\n    items : [ShowcaseCard] @description \"A collection of items to display in a grid.\" @synonyms \"elements, entries, records\" = []\n  }\n\n  trait ShowcaseItemShowcase -> ShowcaseItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.items @config.items)\n        (render-ui main { entity: @entity.items, type: showcase-organism })\n      SHOWCASE_CLICK -> idle\n        (emit SHOWCASE_CLICK { id: ?id, title: ?title })\n    }\n\n    emits {\n      SHOWCASE_CLICK -> external {\n        id : string\n        title : string\n      }\n        @description \"Signals a user clicked on a showcase item.\"\n        @synonyms \"select, tap, activate\"\n        @tier \"domain\"\n    }\n\n    listens {\n      SHOWCASE_CLICK {\n        id : string\n        title : string\n      }\n        @description \"A grid item was selected or activated.\"\n        @synonyms \"select, activate, tap, press\"\n        @tier \"domain\"\n    }\n\n    config {\n      items : [ShowcaseCard] = [{\n        accentColor: \"\"\n        badge: New\n        description: \"Real-time analytics at a glance.\"\n        href: \"\"\n        id: \"1\"\n        image: {\n          alt: \"Dashboard preview\"\n          src: \"\"\n        }\n        title: Dashboard\n      }, {\n        accentColor: \"\"\n        badge: \"\"\n        description: \"GraphQL and REST in one click.\"\n        href: \"\"\n        id: \"2\"\n        image: {\n          alt: \"API docs preview\"\n          src: \"\"\n        }\n        title: API\n      }, {\n        accentColor: \"\"\n        badge: Beta\n        description: \"Native apps without native code.\"\n        href: \"\"\n        id: \"3\"\n        image: {\n          alt: \"Mobile app preview\"\n          src: \"\"\n        }\n        title: Mobile\n      }]\n        @label \"Showcase Items\"\n        @description \"Array of showcase cards\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/showcase\" as ShowcaseItemShowcasePage -> ShowcaseItemShowcase\n}"
}