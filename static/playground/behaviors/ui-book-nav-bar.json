  "source": "",
  "lolo": "app ui-book-nav-bar \"1.0.0\"\n\"BookNavBar — UI factory (1:1 with the @almadar/ui book-nav-bar pattern).\"\norbital BookNavBarOrbital {\n  entity BookNavBarItem [runtime] {\n    id : string!\n  }\n\n  trait BookNavBarRender -> @rebindable BookNavBarItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          currentPage: @config.currentPage\n          totalPages: @config.totalPages\n          chapterTitle: @config.chapterTitle\n          direction: @config.direction\n          type: book-nav-bar\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      currentPage : number = 1\n        @label \"Current Page\"\n        @description \"currentPage prop\"\n        @tier \"presentation\"\n      totalPages : number = 1\n        @label \"Total Pages\"\n        @description \"totalPages prop\"\n        @tier \"presentation\"\n      chapterTitle : string\n        @label \"Chapter Title\"\n        @description \"chapterTitle prop\"\n        @tier \"presentation\"\n      direction : \"rtl\" | \"ltr\" = rtl\n        @label \"Direction\"\n        @description \"direction prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/book-nav-bar\" as BookNavBarPage -> BookNavBarRender\n}\n"
}