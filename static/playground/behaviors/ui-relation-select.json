  "source": "",
  "lolo": "app ui-relation-select \"1.0.0\"\n\"RelationSelect — UI factory (1:1 with the @almadar/ui relation-select pattern).\"\norbital RelationSelectOrbital {\n  type RelationSelectOptionsItem = {\n    value : string!\n    label : string!\n    description : string\n    disabled : boolean\n  }\n\n  entity RelationSelectItem [runtime] {\n    id : string!\n    value : string\n  }\n\n  trait RelationSelectRender -> @rebindable RelationSelectItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.value @config.value)\n        (render-ui main {\n          value: @entity.value\n          onChange: @config.onChange\n          options: @config.options\n          placeholder: @config.placeholder\n          required: @config.required\n          disabled: @config.disabled\n          isLoading: @config.isLoading\n          error: @config.error\n          clearable: @config.clearable\n          name: @config.name\n          className: @config.className\n          searchPlaceholder: @config.searchPlaceholder\n          emptyMessage: @config.emptyMessage\n          type: relation-select\n        })\n      CHANGE -> idle\n        (set @entity.value ?value)\n        (render-ui main {\n          value: @entity.value\n          onChange: @config.onChange\n          options: @config.options\n          placeholder: @config.placeholder\n          required: @config.required\n          disabled: @config.disabled\n          isLoading: @config.isLoading\n          error: @config.error\n          clearable: @config.clearable\n          name: @config.name\n          className: @config.className\n          searchPlaceholder: @config.searchPlaceholder\n          emptyMessage: @config.emptyMessage\n          type: relation-select\n        })\n    }\n\n    emits {\n      @config.onChange -> external {\n        value : string\n      }\n        @description \"Callback when value changes\"\n        @tier \"essential\"\n    }\n\n    listens {\n      CHANGE {\n        value : string\n      }\n    }\n\n    config {\n      value : string\n        @label \"Value\"\n        @description \"Current value (ID)\"\n        @tier \"presentation\"\n      onChange : event = \"CHANGE\"\n        @label \"On Change\"\n        @description \"Callback when value changes\"\n        @tier \"presentation\"\n      options : [RelationSelectOptionsItem] = [{ value: \"Value\", label: \"Label\", description: \"Description\", disabled: false }, { value: \"Value 2\", label: \"Label 2\", description: \"Description 2\", disabled: true }]\n        @label \"Options\"\n        @description \"Available options - accepts readonly for compatibility with generated const arrays\"\n        @tier \"presentation\"\n      placeholder : string\n        @label \"Placeholder\"\n        @description \"Placeholder text\"\n        @tier \"presentation\"\n      required : boolean = false\n        @label \"Required\"\n        @description \"Whether the field is required\"\n        @tier \"presentation\"\n      disabled : boolean = false\n        @label \"Disabled\"\n        @description \"Whether the field is disabled\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Whether data is loading\"\n        @tier \"presentation\"\n      error : string\n        @label \"Error\"\n        @description \"Error message\"\n        @tier \"presentation\"\n      clearable : boolean = true\n        @label \"Clearable\"\n        @description \"Allow clearing the selection\"\n        @tier \"presentation\"\n      name : string\n        @label \"Name\"\n        @description \"Name attribute for forms\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      searchPlaceholder : string\n        @label \"Search Placeholder\"\n        @description \"Search placeholder\"\n        @tier \"presentation\"\n      emptyMessage : string\n        @label \"Empty Message\"\n        @description \"Empty state message\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/relation-select\" as RelationSelectPage -> RelationSelectRender\n}\n"
}