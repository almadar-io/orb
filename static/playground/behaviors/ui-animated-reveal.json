  "lolo": "app ui-animated-reveal \"1.0.0\"\n\"AnimatedReveal — UI factory (1:1 with the @almadar/ui animated-reveal pattern).\"\norbital AnimatedRevealOrbital {\n  entity AnimatedRevealItem [runtime] {\n    id : string!\n  }\n\n  trait AnimatedRevealRender -> @rebindable AnimatedRevealItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          trigger: @config.trigger\n          animation: @config.animation\n          duration: @config.duration\n          delay: @config.delay\n          threshold: @config.threshold\n          once: @config.once\n          animate: @config.animate\n          easing: @config.easing\n          children: @config.children\n          type: animated-reveal\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes applied to the root element.\"\n        @tier \"presentation\"\n      trigger : \"scroll\" | \"hover\" | \"manual\" = scroll\n        @label \"Trigger\"\n        @description \"What triggers the animation\"\n        @tier \"presentation\"\n      animation : \"fade-up\" | \"fade-down\" | \"fade-in\" | \"fade-left\" | \"fade-right\" | \"scale\" | \"scale-up\" | \"none\" = \"fade-up\"\n        @label \"Animation\"\n        @description \"Built-in animation preset\"\n        @tier \"presentation\"\n      duration : number = 600\n        @label \"Duration\"\n        @description \"Animation duration in ms (default: 600)\"\n        @tier \"presentation\"\n      delay : number = 0\n        @label \"Delay\"\n        @description \"Delay before animation starts in ms (default: 0)\"\n        @tier \"presentation\"\n      threshold : number = 0.15\n        @label \"Threshold\"\n        @description \"How much of the element must be visible before triggering, 0-1 (default: 0.15)\"\n        @tier \"presentation\"\n      once : boolean = true\n        @label \"Once\"\n        @description \"Animate only the first time the element enters the viewport (default: true)\"\n        @tier \"presentation\"\n      animate : boolean\n        @label \"Animate\"\n        @description \"Manual control: when trigger='manual', set this to true to animate\"\n        @tier \"presentation\"\n      easing : string = \"cubic-bezier(0.16, 1, 0.3, 1)\"\n        @label \"Easing\"\n        @description \"Easing function (default: cubic-bezier(0.16, 1, 0.3, 1))\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Children: ReactNode or render function receiving animated state\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/animated-reveal\" as AnimatedRevealPage -> AnimatedRevealRender\n}\n"
