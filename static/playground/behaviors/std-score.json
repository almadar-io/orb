  "source": "",
  "lolo": "app std-score \"1.0.0\"\n\"Headless scoring mechanic: awards points when the enemy survivor count drops on a UNITS_CHANGED signal. Owns only score (+ its kill baseline); renders nothing.\"\norbital ScoreOrbital {\n  entity ScoreState [runtime, shared] {\n    id : string!\n    score : number = 0\n    scoreBaseline : number = 0\n  }\n\n  trait ScoreKeeper -> @rebindable ScoreState [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.score @config.startScore)\n        (set @entity.scoreBaseline @config.initialEnemies)\n      UNITS_CHANGED -> active when @config.running\n        (set @entity.score (if (< @payload.enemiesAlive @entity.scoreBaseline) (+ @entity.score (* (- @entity.scoreBaseline @payload.enemiesAlive) @config.pointsPerKill)) @entity.score))\n        (set @entity.scoreBaseline @payload.enemiesAlive)\n    }\n\n    listens {\n      UNITS_CHANGED { playersAlive : number, enemiesAlive : number }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, enemy-count drops award points; toggle to freeze scoring.\"\n        @tier \"domain\"\n      pointsPerKill : number = 10\n        @label \"Points Per Kill\"\n        @description \"Points awarded for each enemy removed since the last signal.\"\n        @tier \"domain\"\n      startScore : number = 0\n        @label \"Start Score\"\n        @description \"Initial score set on INIT.\"\n        @tier \"domain\"\n      initialEnemies : number = 0\n        @label \"Initial Enemies\"\n        @description \"Enemy count at start; the kill baseline so the first kill scores correctly.\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/score\" as ScorePage -> ScoreKeeper\n}\n"
}