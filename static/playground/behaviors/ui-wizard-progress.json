  "source": "",
  "lolo": "app ui-wizard-progress \"1.0.0\"\n\"WizardProgress — UI factory (1:1 with the @almadar/ui wizard-progress pattern).\"\norbital WizardProgressOrbital {\n  type WizardProgressStepsItem = {\n    id : string!\n    title : string!\n    description : string\n  }\n\n  entity WizardProgressItem [runtime] {\n    id : string!\n  }\n\n  trait WizardProgressRender -> @rebindable WizardProgressItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          steps: @config.steps\n          currentStep: @config.currentStep\n          onStepClick: @config.onStepClick\n          allowNavigation: @config.allowNavigation\n          compact: @config.compact\n          className: @config.className\n          stepClickEvent: @config.stepClickEvent\n          type: wizard-progress\n        })\n    }\n\n    emits {\n      @config.onStepClick -> external {\n        stepIndex : number\n      }\n        @description \"Callback when a completed step is clicked\"\n        @tier \"essential\"\n    }\n\n    config {\n      steps : [WizardProgressStepsItem] = []\n        @label \"Steps\"\n        @description \"Step definitions (compatible with WizardContainer's WizardStep). A string is shorthand for `{ id: str, title: str }`.\"\n        @tier \"presentation\"\n      currentStep : number = 1\n        @label \"Current Step\"\n        @description \"Current step index (0-based)\"\n        @tier \"presentation\"\n      onStepClick : event = \"STEP_CLICK\"\n        @label \"On Step Click\"\n        @description \"Callback when a completed step is clicked\"\n        @tier \"presentation\"\n      allowNavigation : boolean = true\n        @label \"Allow Navigation\"\n        @description \"Allow clicking on completed steps to navigate back\"\n        @tier \"presentation\"\n      compact : boolean = false\n        @label \"Compact\"\n        @description \"Compact mode (smaller, no titles)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      stepClickEvent : event = \"STEP_CLICK\"\n        @label \"Step Click Event\"\n        @description \"Declarative step click event — emits UI:{stepClickEvent} with { stepIndex }. Setting it requires declaring that event (with a `{ stepIndex }` payload) and a transition handling it in the same trait; omit this prop for non-clickable progress indicators.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/wizard-progress\" as WizardProgressPage -> WizardProgressRender\n}\n"
}