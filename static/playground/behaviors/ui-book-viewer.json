  "source": "",
  "lolo": "app ui-book-viewer \"1.0.0\"\n\"BookViewer — UI factory (1:1 with the @almadar/ui book-viewer pattern).\"\norbital BookViewerOrbital {\n    type BookViewerLoaded = Event { data : [BookViewerItem] } \"BookViewer rows finished loading; payload.data holds the collection\"\n  type BookViewerError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type BookViewerFieldMap = {\n    title : string!\n    subtitle : string!\n    author : string!\n    coverImageUrl : string!\n    direction : string!\n    parts : string!\n    partTitle : string!\n    chapters : string!\n    chapterId : string!\n    chapterTitle : string!\n    chapterContent : string!\n    chapterOrbitalSchema : string!\n  }\n\n  entity BookViewerItem [runtime] {\n    id : string!\n  }\n\n  trait BookViewerRender -> @rebindable BookViewerItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle when @config.selfFetch\n        (fetch BookViewerItem { emit: { success: BookViewerLoaded } })\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          initialPage: @config.initialPage\n          fieldMap: @config.fieldMap\n          type: book-viewer\n        })\n      INIT -> idle when (not @config.selfFetch)\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          initialPage: @config.initialPage\n          fieldMap: @config.fieldMap\n          type: book-viewer\n        })\n      BookViewerLoaded -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @payload.data\n          initialPage: @config.initialPage\n          fieldMap: @config.fieldMap\n          type: book-viewer\n        })\n    }\n\n    emits {\n      BookViewerLoaded\n        @description \"BookViewer rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : BookViewerError\n        @label \"Error\"\n        @description \"Error state (UiError)\"\n        @tier \"presentation\"\n      sortBy : string\n        @label \"Sort By\"\n        @description \"Current sort field\"\n        @tier \"presentation\"\n      sortDirection : \"asc\" | \"desc\" = asc\n        @label \"Sort Direction\"\n        @description \"Current sort direction\"\n        @tier \"presentation\"\n      searchValue : string\n        @label \"Search Value\"\n        @description \"Current search query value\"\n        @tier \"presentation\"\n      pageProp : number\n        @label \"Page\"\n        @description \"Current page number\"\n        @synonyms \"page\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Number of items per page\"\n        @tier \"presentation\"\n      totalCount : number\n        @label \"Total Count\"\n        @description \"Total number of items\"\n        @tier \"presentation\"\n      activeFilters : Map string string = {}\n        @label \"Active Filters\"\n        @description \"Active filters\"\n        @tier \"presentation\"\n      selectedIds : [string] = []\n        @label \"Selected Ids\"\n        @description \"Currently selected item IDs\"\n        @tier \"presentation\"\n      initialPage : number = 0\n        @label \"Initial Page\"\n        @description \"Initial page index (default: 0 = cover)\"\n        @tier \"presentation\"\n      fieldMap : BookViewerFieldMap\n        @label \"Field Map\"\n        @description \"Field name translation map — a BookFieldMap object or locale key ('ar')\"\n        @tier \"presentation\"\n      selfFetch : boolean = true\n        @label \"Fetch its own rows on mount?\"\n        @description \"true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/book-viewer\" as BookViewerPage -> BookViewerRender\n}\n"
}