  "source": "",
  "lolo": "app ui-badge \"1.0.0\"\n\"Badge — UI factory (1:1 with the @almadar/ui badge pattern).\"\norbital BadgeOrbital {\n  type BadgeIconAsset = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\" | \"4:1\" | \"5:3\" | \"1:2\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n\n  entity BadgeItem [runtime] {\n    id : string!\n  }\n\n  trait BadgeRender -> @rebindable BadgeItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          variant: @config.variant\n          size: @config.size\n          amount: @config.amount\n          label: @config.label\n          icon: @config.icon\n          iconAsset: @config.iconAsset\n          onRemove: @config.onRemove\n          removeLabel: @config.removeLabel\n          type: badge\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes applied to the root element.\"\n        @tier \"presentation\"\n      variant : \"default\" | \"primary\" | \"secondary\" | \"success\" | \"warning\" | \"danger\" | \"error\" | \"info\" | \"neutral\" = default\n        @label \"Variant\"\n        @description \"variant prop\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = sm\n        @label \"Size\"\n        @description \"size prop\"\n        @tier \"presentation\"\n      amount : number\n        @label \"Amount\"\n        @description \"Numeric count or amount to display in badge\"\n        @tier \"presentation\"\n      label : scalar\n        @label \"Label\"\n        @description \"Badge label text (alternative to children for schema-driven rendering). Numeric values are auto-coerced to string for rendering — common case is unread counts, error counts, status codes, etc.\"\n        @tier \"presentation\"\n      icon : icon\n        @label \"Icon\"\n        @description \"Lucide icon component or canonical kebab-case icon name string\"\n        @tier \"presentation\"\n      iconAsset : BadgeIconAsset\n        @label \"Icon Asset\"\n        @description \"Asset image rendered as the badge icon; takes precedence over icon when provided.\"\n        @tier \"presentation\"\n      onRemove : event = \"\"\n        @label \"On Remove\"\n        @description \"When set, renders a small X button on the right of the badge that invokes this handler — turns the badge into a removable chip. Used by the TagInput molecule and other 'list of removable values' surfaces.\"\n        @tier \"presentation\"\n      removeLabel : string\n        @label \"Remove Label\"\n        @description \"Accessible label for the remove button. Defaults to 'Remove'.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/badge\" as BadgePage -> BadgeRender\n}\n"
}