  "source": "",
  "lolo": "app std-survival-flow \"1.0.0\"\n\"Headless win/lose authority for the nature-survival board: owns only result. Listens RESOURCES (movesLeft) and sets result to lost when the move budget runs out before the camp is built; listens BUILD_CAMP (the render-gated win intent) and sets result to won. Renders nothing.\"\norbital SurvivalFlowOrbital {\n  entity SurvivalFlowData [runtime, shared] {\n    id : string!\n    result : string = \"none\"\n  }\n\n  trait SurvivalFlow -> @rebindable SurvivalFlowData [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.result \"none\")\n\n      RESOURCES -> active when @config.running\n        (set @entity.result (if (and (<= @payload.movesLeft 0) (!= @entity.result \"won\")) \"lost\" @entity.result))\n        (if (!= @entity.result \"none\") (emit GAME_END { result: @entity.result }) null)\n\n      BUILD_CAMP -> active when @config.running\n        (set @entity.result \"won\")\n        (emit GAME_END { result: @entity.result })\n\n      RESTART -> active\n        (set @entity.result \"none\")\n    }\n\n    emits {\n      GAME_END -> external {\n        result : string!\n      }\n        @description \"Emitted once the match resolves to won or lost\"\n        @tier \"domain\"\n    }\n\n    listens {\n      RESOURCES { wood : number, stone : number, movesLeft : number }\n      BUILD_CAMP { id : string }\n      RESTART { id : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, RESOURCES/BUILD_CAMP signals resolve win/lose; toggle to freeze\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/survival-flow\" as SurvivalFlowPage -> SurvivalFlow\n}\n"
