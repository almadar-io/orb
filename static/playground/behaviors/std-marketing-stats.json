  "source": "",
  "lolo": "app std-marketing-stats \"1.0.0\"\n\"Stats grid atom for marketing pages. Renders a responsive grid of key metrics with values and labels. Pick for social proof, traction, and credibility sections.\"\n;; Config-driven stats grid using the `stats-grid` marketing pattern.\n;; Stats are declared as an array of { value, label } objects.\n;; The atom renders immediately on INIT with no fetch required.\norbital StatItemOrbital {\n    type StatCard = { value : string!, label : string! }\n\n  uses StatsGrid from \"std/behaviors/ui-stats-grid\"\n\n  entity StatItem [runtime] {\n    id : string!\n  }\n\n  trait StatItemStats = StatsGrid.traits.StatsGridRender -> StatItem {\n    config {\n      columns: @config.columns\n      stats: @config.stats\n      stats : [StatCard] = [{\n        label: Developers\n        value: \"10K+\"\n      }, {\n        label: Uptime\n        value: \"99.9%\"\n      }, {\n        label: \"Requests served\"\n        value: \"50M+\"\n      }, {\n        label: \"Average rating\"\n        value: \"4.9\"\n      }]\n        @label \"Stats\"\n        @description \"Array of stat value/label pairs\"\n        @tier \"presentation\"\n      columns : number = 4\n        @label \"Columns\"\n        @description \"Number of grid columns\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/stats\" as StatItemStatsPage -> StatItemStats\n}"
}