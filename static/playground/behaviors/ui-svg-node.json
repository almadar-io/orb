  "source": "",
  "lolo": "app ui-svg-node \"1.0.0\"\n\"SvgNode — UI factory (1:1 with the @almadar/ui svg-node pattern).\"\norbital SvgNodeOrbital {\n  entity SvgNodeItem [runtime] {\n    id : string!\n  }\n\n  trait SvgNodeRender -> @rebindable SvgNodeItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          x: @config.x\n          y: @config.y\n          r: @config.r\n          variant: @config.variant\n          color: @config.color\n          opacity: @config.opacity\n          className: @config.className\n          label: @config.label\n          asRoot: @config.asRoot\n          width: @config.width\n          height: @config.height\n          type: svg-node\n        })\n    }\n\n    config {\n      x : number = 50\n        @label \"X\"\n        @description \"x prop\"\n        @tier \"presentation\"\n      y : number = 50\n        @label \"Y\"\n        @description \"y prop\"\n        @tier \"presentation\"\n      r : number = 6\n        @label \"R\"\n        @description \"r prop\"\n        @tier \"presentation\"\n      variant : \"filled\" | \"stroked\" | \"pulse\" = filled\n        @label \"Variant\"\n        @description \"variant prop\"\n        @tier \"presentation\"\n      color : string = \"var(--color-primary)\"\n        @label \"Color\"\n        @description \"color prop\"\n        @tier \"presentation\"\n      opacity : number = 1\n        @label \"Opacity\"\n        @description \"opacity prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"label prop\"\n        @tier \"presentation\"\n      asRoot : boolean = true\n        @label \"As Root\"\n        @description \"When true (default), wraps in a standalone <svg> so the shape is visible without a parent SVG context.\"\n        @tier \"presentation\"\n      width : number = 100\n        @label \"Width\"\n        @description \"width prop\"\n        @tier \"presentation\"\n      height : number = 100\n        @label \"Height\"\n        @description \"height prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/svg-node\" as SvgNodePage -> SvgNodeRender\n}\n"
}