  "source": "",
  "lolo": "app ui-flip-card \"1.0.0\"\n\"FlipCard — flip card that reveals a hidden back face on tap or click, toggling between a front and back content slot. — UI factory (1:1 with the @almadar/ui flip-card pattern).\"\n;; @capabilities \"flashcard, study deck, spaced-repetition review card, memorization drill, quiz reveal card, question/answer card, before/after reveal, term-and-definition card\"\norbital FlipCardOrbital {\n  entity FlipCardItem [runtime] {\n    id : string!\n  }\n\n  trait FlipCardRender -> @rebindable FlipCardItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          front: @config.front\n          back: @config.back\n          flipped: @config.flipped\n          onFlip: @config.onFlip\n          className: @config.className\n          height: @config.height\n          type: flip-card\n        })\n    }\n\n    emits {\n      @config.onFlip -> external {\n        id : string\n      }\n        @description \"Callback when the card is clicked to flip\"\n        @tier \"essential\"\n    }\n\n    config {\n      front : node = []\n        @label \"Front\"\n        @description \"Content rendered on the front face\"\n        @tier \"presentation\"\n      back : node = []\n        @label \"Back\"\n        @description \"Content rendered on the back face\"\n        @tier \"presentation\"\n      flipped : boolean = false\n        @label \"Flipped\"\n        @description \"Controlled flip state\"\n        @tier \"presentation\"\n      onFlip : event = \"FLIP\"\n        @label \"On Flip\"\n        @description \"Callback when the card is clicked to flip\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Optional className for the outer container\"\n        @tier \"presentation\"\n      height : string = \"h-64\"\n        @label \"Height\"\n        @description \"Card height as a Tailwind class (default: 'h-64')\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/flip-card\" as FlipCardPage -> FlipCardRender\n}\n"
}