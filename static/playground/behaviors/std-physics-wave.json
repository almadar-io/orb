            "ticks": [
              {
                "name": "waveTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "set",
                    "@entity.bodies",
                    [
                      "array/map",
                      "@entity.bodies",
                      [
                        "fn",
                        "b",
                        [
                          "let",
                          [
                            [
                              "i",
                              [
                                "math/round",
                                [
                                  "/",
                                  [
                                    "-",
                                    [
                                      "object/get",
                                      "@b",
                                      "x"
                                    ],
                                    40
                                  ],
                                  26
                                ]
                              ]
                            ],
                            [
                              "last",
                              [
                                "-",
                                [
                                  "array/len",
                                  "@entity.bodies"
                                ],
                                1
                              ]
                            ]
                          ],
                          [
                            "if",
                            [
                              "or",
                              [
                                "=",
                                "@i",
                                0
                              ],
                              [
                                "=",
                                "@i",
                                "@last"
                              ]
                            ],
                            "@b",
                            [
                              "let",
                              [
                                [
                                  "left",
                                  [
                                    "array/nth",
                                    "@entity.bodies",
                                    [
                                      "-",
                                      "@i",
                                      1
                                    ]
                                  ]
                                ],
                                [
                                  "right",
                                  [
                                    "array/nth",
                                    "@entity.bodies",
                                    [
                                      "+",
                                      "@i",
                                      1
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "let",
                                [
                                  [
                                    "accel",
                                    [
                                      "-",
                                      [
                                        "*",
                                        0.3,
                                        [
                                          "+",
                                          [
                                            "object/get",
                                            "@left",
                                            "y"
                                          ],
                                          [
                                            "object/get",
                                            "@right",
                                            "y"
                                          ]
                                        ]
                                      ],
                                      [
                                        "*",
                                        0.3,
                                        [
                                          "*",
                                          2,
                                          [
                                            "object/get",
                                            "@b",
                                            "y"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "let",
                                  [
                                    [
                                      "nvy",
                                      [
                                        "*",
                                        [
                                          "+",
                                          [
                                            "object/get",
                                            "@b",
                                            "vy"
                                          ],
                                          "@accel"
                                        ],
                                        0.997
                                      ]
                                    ]
                                  ],
                                  [
                                    "let",
                                    [
                                      [
                                        "ny",
                                        [
                                          "+",
                                          [
                                            "object/get",
                                            "@b",
                                            "y"
                                          ],
                                          "@nvy"
                                        ]
                                      ]
                                    ],
                                    [
                                      "object/merge",
                                      "@b",
                                      {
                                        "vy": "@nvy",
                                        "y": "@ny"
                                      }
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
