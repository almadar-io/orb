                    }
                  }
                }
              },
              "width": {
                "type": "number",
                "default": 600,
                "label": "Width",
                "description": "Simulation width in pixels.",
                "tier": "presentation"
              },
              "damping": {
                "type": "number",
                "default": 0.99,
                "label": "Damping",
                "description": "Fraction of velocity retained each tick (rolling/air resistance along the ramp).",
                "tier": "domain"
              }
            },
            "scope": "instance"
          }
        ],
        "pages": [
