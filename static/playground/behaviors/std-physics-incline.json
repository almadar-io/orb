                    "y": 110,
                    "label": "",
                    "radius": 16
                  }
                ],
                "label": "Bodies",
                "description": "Initial bodies; the block starts on the ramp near the top and slides down.",
                "tier": "domain",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "name": "id",
                      "type": "string",
                      "required": false
                    },
                    "y": {
