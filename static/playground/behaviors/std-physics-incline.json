{
  "name": "std-physics-incline",
  "description": "Inclined-plane engine — slides a block down a frictional ramp under gravity via line-projection every tick and renders a physics-canvas; composed by a learning orbital via `uses`, controls auto-derived from @config.",
  "level": "atom",
  "topic": "ui/learning",
  "schema": {
    "name": "std-physics-incline",
    "version": "1.0.0",
    "description": "Inclined-plane engine — slides a block down a frictional ramp under gravity via line-projection every tick and renders a physics-canvas; composed by a learning orbital via `uses`, controls auto-derived from @config.",
    "orbitals": [
      {
        "name": "InclineEngineOrbital",
        "entity": {
          "name": "InclineState",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "bodies",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "vy": {
                    "name": "vy",
                    "type": "number",
                    "required": false
                  },
                  "fy": {
                    "name": "fy",
                    "type": "number",
                    "required": false
                  },
                  "radius": {
                    "name": "radius",
                    "type": "number",
                    "required": false
                  },
                  "vx": {
                    "name": "vx",
                    "type": "number",
                    "required": false
                  },
                  "fx": {
                    "name": "fx",
                    "type": "number",
                    "required": false
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "y": {
                    "name": "y",
                    "type": "number",
                    "required": true
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
                  "id": {
                    "name": "id",
                    "type": "string",
                    "required": false
                  },
                  "x": {
                    "name": "x",
                    "type": "number",
                    "required": true
                  }
                }
              }
            },
            {
              "name": "running",
              "type": "boolean",
              "default": false
            }
          ]
        },
        "traits": [
          {
            "name": "InclineSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "bodies",
                "running"
              ]
            },
            "category": "interaction",
            "linkedEntity": "InclineState",
            "emits": [
              {
                "event": "BODIES_UPDATED",
                "description": "The current scene each tick — a composed listener (graph, readout, mirror canvas) can subscribe; a harmless no-op when the atom runs standalone.",
                "synonyms": "tick, frame, step, redraw",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "bodies",
                    "type": "[InclineBody]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "BODIES_UPDATED",
                  "name": "Bodies Updated",
                  "description": "The current scene each tick — a composed listener (graph, readout, mirror canvas) can subscribe; a harmless no-op when the atom runs standalone.",
                  "synonyms": "tick, frame, step, redraw",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "bodies",
                      "type": "[InclineBody]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.bodies",
                      [
                        {
                          "vx": 0,
                          "vy": 0,
                          "fy": 0,
                          "x": 170,
                          "id": "block",
                          "fx": 0,
                          "color": "#2563eb",
                          "y": 110,
                          "label": "",
                          "radius": 16
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "showForces": false,
                        "velocityScale": 6,
                        "width": 600,
                        "type": "physics-canvas",
                        "backgroundColor": "#f8fafc",
                        "shapes": [
                          {
                            "y1": 90,
                            "color": "#334155",
                            "y2": 330,
                            "lineWidth": 3,
                            "x1": 120,
                            "type": "line",
                            "x2": 520
                          }
                        ],
                        "bodies": "@entity.bodies",
                        "showVelocity": true,
                        "height": 400
                      }
                    ],
                    [
                      "emit",
                      "BODIES_UPDATED",
                      {
                        "bodies": "@entity.bodies"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "inclineTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "set",
                    "@entity.bodies",
                    [
                      "array/map",
                      "@entity.bodies",
                      [
                        "fn",
                        "b",
                        [
                          "let",
                          [
                            [
                              "dirx",
                              [
                                "-",
                                520,
                                120
                              ]
                            ],
                            [
                              "diry",
                              [
                                "-",
                                330,
                                90
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "L2",
                                [
                                  "+",
                                  [
                                    "*",
                                    "@dirx",
                                    "@dirx"
                                  ],
                                  [
                                    "*",
                                    "@diry",
                                    "@diry"
                                  ]
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "nvy",
                                  [
                                    "*",
                                    [
                                      "+",
                                      [
                                        "object/get",
                                        "@b",
                                        "vy"
                                      ],
                                      0.5
                                    ],
                                    0.99
                                  ]
                                ],
                                [
                                  "nvx",
                                  [
                                    "*",
                                    [
                                      "object/get",
                                      "@b",
                                      "vx"
                                    ],
                                    0.99
                                  ]
                                ]
                              ],
                              [
                                "let",
                                [
                                  [
                                    "px",
                                    [
                                      "+",
                                      [
                                        "object/get",
                                        "@b",
                                        "x"
                                      ],
                                      "@nvx"
                                    ]
                                  ],
                                  [
                                    "py",
                                    [
                                      "+",
                                      [
                                        "object/get",
                                        "@b",
                                        "y"
                                      ],
                                      "@nvy"
                                    ]
                                  ]
                                ],
                                [
                                  "let",
                                  [
                                    [
                                      "t",
                                      [
                                        "/",
                                        [
                                          "+",
                                          [
                                            "*",
                                            [
                                              "-",
                                              "@px",
                                              120
                                            ],
                                            "@dirx"
                                          ],
                                          [
                                            "*",
                                            [
                                              "-",
                                              "@py",
                                              90
                                            ],
                                            "@diry"
                                          ]
                                        ],
                                        "@L2"
                                      ]
                                    ]
                                  ],
                                  [
                                    "let",
                                    [
                                      [
                                        "tc",
                                        [
                                          "math/clamp",
                                          "@t",
                                          0,
                                          1
                                        ]
                                      ]
                                    ],
                                    [
                                      "let",
                                      [
                                        [
                                          "cx",
                                          [
                                            "+",
                                            120,
                                            [
                                              "*",
                                              "@tc",
                                              "@dirx"
                                            ]
                                          ]
                                        ],
                                        [
                                          "cy",
                                          [
                                            "+",
                                            90,
                                            [
                                              "*",
                                              "@tc",
                                              "@diry"
                                            ]
                                          ]
                                        ]
                                      ],
                                      [
                                        "object/merge",
                                        "@b",
                                        {
                                          "y": "@cy",
                                          "vy": [
                                            "-",
                                            "@cy",
                                            [
                                              "object/get",
                                              "@b",
                                              "y"
                                            ]
                                          ],
                                          "x": "@cx",
                                          "vx": [
                                            "-",
                                            "@cx",
                                            [
                                              "object/get",
                                              "@b",
                                              "x"
                                            ]
                                          ]
                                        }
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "showForces": false,
                      "type": "physics-canvas",
                      "velocityScale": 6,
                      "width": 600,
                      "backgroundColor": "#f8fafc",
                      "bodies": "@entity.bodies",
                      "height": 400,
                      "shapes": [
                        {
                          "y1": 90,
                          "color": "#334155",
                          "y2": 330,
                          "lineWidth": 3,
                          "x1": 120,
                          "type": "line",
                          "x2": 520
                        }
                      ],
                      "showVelocity": true
                    }
                  ],
                  [
                    "emit",
                    "BODIES_UPDATED",
                    {
                      "bodies": "@entity.bodies"
                    }
                  ]
                ]
              }
            ],
            "config": {
              "gravity": {
                "type": "number",
                "default": 0.5,
                "label": "Gravity",
                "description": "Downward acceleration added to the block's vy every tick before the ramp projection.",
                "tier": "domain"
              },
              "showVelocity": {
                "type": "boolean",
                "default": true,
                "label": "Show Velocity",
                "description": "Draw each body's velocity vector as an arrow.",
                "tier": "presentation"
              },
              "velocityScale": {
                "type": "number",
                "default": 6,
                "label": "Velocity Scale",
                "description": "Length multiplier for the velocity arrows.",
                "tier": "presentation"
              },
              "rampX0": {
                "type": "number",
                "default": 120,
                "label": "Ramp Start X",
                "description": "X coordinate of the ramp's high (top) end.",
                "tier": "domain"
              },
              "bodies": {
