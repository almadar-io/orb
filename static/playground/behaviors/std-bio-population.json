{
  "name": "std-bio-population",
  "description": "Predator-prey population engine — Lotka-Volterra cycle via two out-of-phase oscillating node radii on biology-canvas.",
  "level": "atom",
  "topic": "ui/learning",
  "schema": {
    "name": "std-bio-population",
    "version": "1.0.0",
    "description": "Predator-prey population engine — Lotka-Volterra cycle via two out-of-phase oscillating node radii on biology-canvas.",
    "orbitals": [
      {
        "name": "BioPopulationEngineOrbital",
        "entity": {
          "name": "BioPopulationState",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "phase",
              "type": "number",
              "default": 0
            },
            {
              "name": "nodes",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "y": {
                    "name": "y",
                    "type": "number",
                    "required": true
                  },
                  "kind": {
                    "name": "kind",
                    "type": "string",
                    "required": false,
                    "values": [
                      "cell",
                      "organelle",
                      "molecule",
                      "organism"
                    ]
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "id": {
                    "name": "id",
                    "type": "string",
                    "required": false
                  },
                  "radius": {
                    "name": "radius",
                    "type": "number",
                    "required": false
                  },
                  "x": {
                    "name": "x",
                    "type": "number",
                    "required": true
                  }
                }
              }
            },
            {
              "name": "running",
              "type": "boolean",
              "default": false
            }
          ]
        },
        "traits": [
          {
            "name": "BioPopulationSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "nodes",
                "phase",
                "running"
              ]
            },
            "category": "interaction",
            "linkedEntity": "BioPopulationState",
            "emits": [
              {
                "event": "POPULATION_UPDATED",
                "description": "The current population scene each tick — a composed listener (readout, graph) can subscribe; a harmless no-op when the atom runs standalone.",
                "synonyms": "tick, frame, step, redraw",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "nodes",
                    "type": "[BioNode]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "POPULATION_UPDATED",
                  "name": "Population Updated",
                  "description": "The current population scene each tick — a composed listener (readout, graph) can subscribe; a harmless no-op when the atom runs standalone.",
                  "synonyms": "tick, frame, step, redraw",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "nodes",
                      "type": "[BioNode]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.phase",
                      0
                    ],
                    [
                      "set",
                      "@entity.nodes",
                      [
                        {
                          "kind": "organism",
                          "id": "prey",
                          "x": 210,
                          "color": "#16a34a",
                          "label": "Prey",
                          "radius": 20,
                          "y": 200
                        },
                        {
                          "radius": 20,
                          "x": 400,
                          "y": 200,
                          "id": "predator",
                          "label": "Predator",
                          "kind": "organism",
                          "color": "#dc2626"
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "type": "biology-canvas",
                        "width": 600,
                        "nodes": "@entity.nodes",
                        "backgroundColor": "#f0fdf4",
                        "edges": [
                          {
                            "from": "predator",
                            "label": "eats",
                            "to": "prey",
                            "color": "#94a3b8"
                          }
                        ],
                        "height": 400
                      }
                    ],
                    [
                      "emit",
                      "POPULATION_UPDATED",
                      {
                        "nodes": "@entity.nodes"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "populationTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "set",
                    "@entity.phase",
                    [
                      "+",
                      "@entity.phase",
                      3
                    ]
                  ],
                  [
                    "set",
                    "@entity.nodes",
                    [
                      "array/map",
                      "@entity.nodes",
                      [
                        "fn",
                        "n",
                        [
                          "let",
                          [
                            [
                              "p",
                              [
                                "if",
                                [
                                  "=",
                                  [
                                    "object/get",
                                    "@n",
                                    "id"
                                  ],
                                  "predator"
                                ],
                                [
                                  "+",
                                  "@entity.phase",
                                  80
                                ],
                                "@entity.phase"
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "tw",
                                [
                                  "math/abs",
                                  [
                                    "-",
                                    [
                                      "math/mod",
                                      "@p",
                                      240
                                    ],
                                    120
                                  ]
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "nr",
                                  [
                                    "+",
                                    12,
                                    [
                                      "*",
                                      "@tw",
                                      0.2
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "object/merge",
                                "@n",
                                {
                                  "radius": "@nr"
                                }
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "nodes": "@entity.nodes",
                      "backgroundColor": "#f0fdf4",
                      "type": "biology-canvas",
                      "edges": [
                        {
                          "from": "predator",
                          "label": "eats",
                          "to": "prey",
                          "color": "#94a3b8"
                        }
                      ],
                      "height": 400,
                      "width": 600
                    }
                  ],
                  [
                    "emit",
                    "POPULATION_UPDATED",
                    {
                      "nodes": "@entity.nodes"
                    }
                  ]
                ]
              }
            ],
            "config": {
              "height": {
                "type": "number",
                "default": 400,
                "label": "Height",
                "description": "Canvas height in pixels.",
                "tier": "presentation"
              },
              "edges": {
                "type": "[BioEdge]",
                "default": [
                  {
                    "from": "predator",
                    "label": "eats",
                    "to": "prey",
                    "color": "#94a3b8"
                  }
                ],
                "label": "Edges",
                "description": "Predation relationship linking the two populations.",
                "tier": "domain",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "name": "label",
                      "type": "string",
                      "required": false
                    },
                    "from": {
                      "name": "from",
                      "type": "string",
                      "required": true
                    },
                    "to": {
                      "name": "to",
                      "type": "string",
                      "required": true
                    },
                    "color": {
                      "name": "color",
                      "type": "string",
                      "required": false
                    }
                  }
                }
              },
              "nodes": {
                "type": "[BioNode]",
                "default": [
                  {
                    "kind": "organism",
                    "id": "prey",
                    "x": 210,
                    "color": "#16a34a",
                    "label": "Prey",
                    "radius": 20,
                    "y": 200
                  },
                  {
                    "radius": 20,
                    "x": 400,
                    "y": 200,
                    "id": "predator",
                    "label": "Predator",
                    "kind": "organism",
                    "color": "#dc2626"
                  }
                ],
                "label": "Nodes",
                "description": "Initial prey and predator population nodes; radius encodes population size.",
                "tier": "domain",
                "items": {
                  "type": "object",
                  "properties": {
                    "color": {
                      "name": "color",
                      "type": "string",
                      "required": false
                    },
                    "id": {
                      "name": "id",
                      "type": "string",
                      "required": false
                    },
                    "label": {
                      "name": "label",
                      "type": "string",
                      "required": false
                    },
                    "kind": {
                      "name": "kind",
                      "type": "string",
                      "required": false,
                      "values": [
                        "cell",
                        "organelle",
                        "molecule",
                        "organism"
                      ]
                    },
                    "radius": {
                      "name": "radius",
                      "type": "number",
                      "required": false
                    },
                    "x": {
                      "name": "x",
                      "type": "number",
                      "required": true
                    },
                    "y": {
                      "name": "y",
                      "type": "number",
                      "required": true
                    }
                  }
                }
              },
              "width": {
                "type": "number",
                "default": 600,
                "label": "Width",
                "description": "Canvas width in pixels.",
                "tier": "presentation"
              },
              "backgroundColor": {
                "type": "string",
                "default": "#f0fdf4",
                "label": "Background Color",
                "description": "Canvas background color.",
                "tier": "presentation"
              },
              "running": {
                "type": "boolean",
                "default": true,
                "label": "Running",
                "description": "When true the tick advances the phase and recomputes both population radii; toggle to start/pause.",
                "tier": "domain"
              }
            },
            "scope": "instance"
          }
        ],
        "pages": [
          {
            "name": "BioPopulationEnginePage",
            "path": "/bio-population",
            "traits": [
              {
                "ref": "BioPopulationSim"
              }
            ]
          }
        ]
      }
    ],
    "_metadata": {
      "configProvenance": {
        "BioPopulationEngineOrbital": [
          {
