  "source": "",
  "lolo": "app ui-popover \"1.0.0\"\n\"Popover — UI factory (1:1 with the @almadar/ui popover pattern).\"\norbital PopoverOrbital {\n  entity PopoverItem [runtime] {\n    id : string!\n    open : boolean\n  }\n\n  trait PopoverRender -> @rebindable PopoverItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.open @config.open)\n        (render-ui main {\n          content: @config.content\n          children: @config.children\n          position: @config.position\n          trigger: @config.trigger\n          showArrow: @config.showArrow\n          open: @entity.open\n          onOpenChange: @config.onOpenChange\n          className: @config.className\n          type: popover\n        })\n      OPEN_CHANGE -> idle\n        (set @entity.open ?open)\n        (render-ui main {\n          content: @config.content\n          children: @config.children\n          position: @config.position\n          trigger: @config.trigger\n          showArrow: @config.showArrow\n          open: @entity.open\n          onOpenChange: @config.onOpenChange\n          className: @config.className\n          type: popover\n        })\n    }\n\n    emits {\n      @config.onOpenChange -> external {\n        open : boolean\n      }\n        @description \"Fired when the popover wants to change visibility (trigger click, outside click)\"\n        @tier \"essential\"\n    }\n\n    listens {\n      OPEN_CHANGE {\n        open : boolean\n      }\n    }\n\n    config {\n      content : node\n        @label \"Content\"\n        @description \"Popover content\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Popover trigger element (ReactElement or ReactNode that will be wrapped in span)\"\n        @tier \"presentation\"\n      position : \"top\" | \"bottom\" | \"left\" | \"right\" = bottom\n        @label \"Position\"\n        @description \"Popover position\"\n        @tier \"presentation\"\n      trigger : \"click\" | \"hover\" = click\n        @label \"Trigger\"\n        @description \"Trigger type\"\n        @tier \"presentation\"\n      showArrow : boolean = true\n        @label \"Show Arrow\"\n        @description \"Show arrow\"\n        @tier \"presentation\"\n      open : boolean\n        @label \"Open\"\n        @description \"Controlled open state. When set, the host owns visibility and the popover reports intent through onOpenChange instead of toggling itself.\"\n        @tier \"presentation\"\n      onOpenChange : event = \"OPEN_CHANGE\"\n        @label \"On Open Change\"\n        @description \"Fired when the popover wants to change visibility (trigger click, outside click)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/popover\" as PopoverPage -> PopoverRender\n}\n"
