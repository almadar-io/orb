  "source": "",
  "lolo": "app ui-community-links \"1.0.0\"\n\"CommunityLinks — UI factory (1:1 with the @almadar/ui community-links pattern).\"\norbital CommunityLinksOrbital {\n  type CommunityLinksGithub = {\n    url : string!\n    stars : number\n  }\n  type CommunityLinksDiscord = {\n    url : string!\n    members : number\n  }\n  type CommunityLinksTwitter = {\n    url : string!\n    followers : number\n  }\n\n  entity CommunityLinksItem [runtime] {\n    id : string!\n  }\n\n  trait CommunityLinksRender -> @rebindable CommunityLinksItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          github: @config.github\n          discord: @config.discord\n          twitter: @config.twitter\n          heading: @config.heading\n          subtitle: @config.subtitle\n          className: @config.className\n          type: community-links\n        })\n    }\n\n    config {\n      github : CommunityLinksGithub\n        @label \"Github\"\n        @description \"github prop\"\n        @tier \"presentation\"\n      discord : CommunityLinksDiscord\n        @label \"Discord\"\n        @description \"discord prop\"\n        @tier \"presentation\"\n      twitter : CommunityLinksTwitter\n        @label \"Twitter\"\n        @description \"twitter prop\"\n        @tier \"presentation\"\n      heading : string\n        @label \"Heading\"\n        @description \"heading prop\"\n        @tier \"presentation\"\n      subtitle : string\n        @label \"Subtitle\"\n        @description \"subtitle prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/community-links\" as CommunityLinksPage -> CommunityLinksRender\n}\n"
}