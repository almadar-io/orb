  "source": "",
  "lolo": "app ui-svg-pulse \"1.0.0\"\n\"SvgPulse — UI factory (1:1 with the @almadar/ui svg-pulse pattern).\"\norbital SvgPulseOrbital {\n  entity SvgPulseItem [runtime] {\n    id : string!\n  }\n\n  trait SvgPulseRender -> @rebindable SvgPulseItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          cx: @config.cx\n          cy: @config.cy\n          rings: @config.rings\n          maxRadius: @config.maxRadius\n          color: @config.color\n          animated: @config.animated\n          opacity: @config.opacity\n          className: @config.className\n          asRoot: @config.asRoot\n          width: @config.width\n          height: @config.height\n          type: svg-pulse\n        })\n    }\n\n    config {\n      cx : number = 70\n        @label \"Cx\"\n        @description \"cx prop\"\n        @tier \"presentation\"\n      cy : number = 70\n        @label \"Cy\"\n        @description \"cy prop\"\n        @tier \"presentation\"\n      rings : number = 3\n        @label \"Rings\"\n        @description \"rings prop\"\n        @tier \"presentation\"\n      maxRadius : number = 60\n        @label \"Max Radius\"\n        @description \"maxRadius prop\"\n        @tier \"presentation\"\n      color : string = \"var(--color-primary)\"\n        @label \"Color\"\n        @description \"color prop\"\n        @tier \"presentation\"\n      animated : boolean = true\n        @label \"Animated\"\n        @description \"animated prop\"\n        @tier \"presentation\"\n      opacity : number = 1\n        @label \"Opacity\"\n        @description \"opacity prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      asRoot : boolean = true\n        @label \"As Root\"\n        @description \"When true (default), wraps in a standalone <svg> so the shape is visible without a parent SVG context.\"\n        @tier \"presentation\"\n      width : number = 140\n        @label \"Width\"\n        @description \"width prop\"\n        @tier \"presentation\"\n      height : number = 140\n        @label \"Height\"\n        @description \"height prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/svg-pulse\" as SvgPulsePage -> SvgPulseRender\n}\n"
}