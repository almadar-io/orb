  "source": "",
  "lolo": "app ui-svg-mesh \"1.0.0\"\n\"SvgMesh — UI factory (1:1 with the @almadar/ui svg-mesh pattern).\"\norbital SvgMeshOrbital {\n  entity SvgMeshItem [runtime] {\n    id : string!\n  }\n\n  trait SvgMeshRender -> @rebindable SvgMeshItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          cx: @config.cx\n          cy: @config.cy\n          nodes: @config.nodes\n          radius: @config.radius\n          color: @config.color\n          connectionDensity: @config.connectionDensity\n          opacity: @config.opacity\n          className: @config.className\n          asRoot: @config.asRoot\n          width: @config.width\n          height: @config.height\n          type: svg-mesh\n        })\n    }\n\n    config {\n      cx : number = 60\n        @label \"Cx\"\n        @description \"cx prop\"\n        @tier \"presentation\"\n      cy : number = 60\n        @label \"Cy\"\n        @description \"cy prop\"\n        @tier \"presentation\"\n      nodes : number = 6\n        @label \"Nodes\"\n        @description \"nodes prop\"\n        @tier \"presentation\"\n      radius : number = 50\n        @label \"Radius\"\n        @description \"radius prop\"\n        @tier \"presentation\"\n      color : string = \"var(--color-primary)\"\n        @label \"Color\"\n        @description \"color prop\"\n        @tier \"presentation\"\n      connectionDensity : number = 0.5\n        @label \"Connection Density\"\n        @description \"connectionDensity prop\"\n        @tier \"presentation\"\n      opacity : number = 1\n        @label \"Opacity\"\n        @description \"opacity prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      asRoot : boolean = true\n        @label \"As Root\"\n        @description \"When true (default), wraps in a standalone <svg> so the shape is visible without a parent SVG context.\"\n        @tier \"presentation\"\n      width : number = 120\n        @label \"Width\"\n        @description \"width prop\"\n        @tier \"presentation\"\n      height : number = 120\n        @label \"Height\"\n        @description \"height prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/svg-mesh\" as SvgMeshPage -> SvgMeshRender\n}\n"
}