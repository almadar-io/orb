  "source": "",
  "lolo": "app ui-upload-drop-zone \"1.0.0\"\n\"UploadDropZone — UI factory (1:1 with the @almadar/ui upload-drop-zone pattern).\"\norbital UploadDropZoneOrbital {\n  type UploadDropZoneACTIONFilesItem = {\n    name : string!\n    size : number!\n    type : string!\n    content : string!\n  }\n\n  entity UploadDropZoneItem [runtime] {\n    id : string!\n  }\n\n  trait UploadDropZoneRender -> @rebindable UploadDropZoneItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          accept: @config.accept\n          maxSize: @config.maxSize\n          maxFiles: @config.maxFiles\n          label: @config.label\n          description: @config.description\n          icon: @config.icon\n          disabled: @config.disabled\n          action: @config.action\n          actionPayload: @config.actionPayload\n          className: @config.className\n          type: upload-drop-zone\n        })\n    }\n\n    emits {\n      @config.action -> external {\n        files : [UploadDropZoneACTIONFilesItem]!\n      }\n        @description \"Declarative event name for file selection\"\n        @tier \"essential\"\n    }\n\n    config {\n      accept : string\n        @label \"Accept\"\n        @description \"Accepted MIME types (e.g., 'image/*', 'application/pdf')\"\n        @tier \"presentation\"\n      maxSize : number\n        @label \"Max Size\"\n        @description \"Max file size in bytes\"\n        @tier \"presentation\"\n      maxFiles : number = 1\n        @label \"Max Files\"\n        @description \"Max number of files\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Label text\"\n        @tier \"presentation\"\n      description : string\n        @label \"Description\"\n        @description \"Description text below label\"\n        @tier \"presentation\"\n      icon : icon\n        @label \"Icon\"\n        @description \"Icon name or component\"\n        @tier \"presentation\"\n      disabled : boolean = false\n        @label \"Disabled\"\n        @description \"Disabled state\"\n        @tier \"presentation\"\n      action : event = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event name for file selection\"\n        @tier \"presentation\"\n      actionPayload : @payload @config.action\n        @label \"Action Payload\"\n        @description \"Payload to include with the action event\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/upload-drop-zone\" as UploadDropZonePage -> UploadDropZoneRender\n}\n"
