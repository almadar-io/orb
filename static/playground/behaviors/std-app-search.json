  "lolo": "app std-app-search \"1.0.0\"\n\"std-app-search — reusable global search: wraps a host content view and, on a SEARCH trigger, fetches the linked entity filtered by @config.searchField and renders the matching results, then CLEAR_SEARCH returns to the host view. Rebind to any entity; point @config.idleContent at the normal view and wire a trigger (e.g. AppLayout SEARCH) into SEARCH.\"\ntype AppSearchFieldSpec = { name : string!, label : string, variant : h3 | h4 | body | caption | badge | small | progress, icon : string, format : date | currency | number | boolean | percent, event : string, href : string, payload : string, disabled : boolean, confirm : string, hidden : boolean }\ntype AppSearchActionSpec = { label : string!, event : event!, variant : primary | secondary | ghost | danger, icon : string, href : string, payload : string, disabled : boolean, confirm : string, hidden : boolean }\norbital AppSearchOrbital {\n  type AppSearchLoaded = Event { data : [AppSearchTarget] } \"Filtered search results loaded\"\n  type AppSearchFailed = Event { error : string } \"Search fetch failed\"\n\n  entity AppSearchTarget [runtime] {\n    id : string!\n    name : string @description \"The primary human-readable label matched by search.\" @synonyms \"title, label, productName\"\n    searchTerm : string @intrinsic @description \"The current search query the user submitted.\" @synonyms \"query, term, q\" = \"\"\n  }\n\n  trait AppSearchIdleHint -> AppSearchTarget [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          type: stack\n          align: center\n          direction: vertical\n          gap: sm\n          className: \"py-12\"\n          children: [{ type: icon, name: search, size: lg, color: muted }, {\n            type: typography\n            variant: caption\n            color: muted\n            content: \"Start typing to search\"\n          }]\n        })\n    }\n  }\n\n  trait AppSearch -> @rebindable AppSearchTarget [interaction, collection] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (fetch AppSearchTarget {})\n        (render-ui main {\n          type: stack\n          direction: vertical\n          gap: md\n          children: [@config.idleContent]\n        })\n      APP_SEARCH -> searching\n        (set @entity.searchTerm ?value)\n        (fetch AppSearchTarget {\n          filter: (or [\"=\", ?value, \"\"] (str/includes (object/get @entity @config.searchField) ?value))\n          emit: { success: AppSearchLoaded, failure: AppSearchFailed }\n        })\n        (render-ui main {\n          type: stack\n          align: center\n          direction: vertical\n          gap: md\n          className: \"py-12\"\n          children: [{ type: spinner }, {\n            type: typography\n            variant: caption\n            color: muted\n            content: \"Searching…\"\n          }]\n        })\n    }\n\n    state searching {\n      INIT -> idle\n        (set @entity.searchTerm \"\")\n        (fetch AppSearchTarget {})\n        (render-ui main {\n          type: stack\n          direction: vertical\n          gap: md\n          children: [@config.idleContent]\n        })\n      APP_SEARCH -> searching\n        (set @entity.searchTerm ?value)\n        (fetch AppSearchTarget {\n          filter: (or [\"=\", ?value, \"\"] (str/includes (object/get @entity @config.searchField) ?value))\n          emit: { success: AppSearchLoaded, failure: AppSearchFailed }\n        })\n        (render-ui main {\n          type: stack\n          align: center\n          direction: vertical\n          gap: md\n          className: \"py-12\"\n          children: [{ type: spinner }, {\n            type: typography\n            variant: caption\n            color: muted\n            content: \"Searching…\"\n          }]\n        })\n      AppSearchLoaded -> results\n        (render-ui main {\n          type: stack\n          direction: vertical\n          gap: lg\n          className: \"max-w-6xl mx-auto w-full p-4\"\n          children: [{\n            type: stack\n            direction: horizontal\n            gap: sm\n            justify: between\n            align: center\n            children: [{ type: icon, name: search }, {\n              type: typography\n              variant: h2\n              content: @config.resultsTitle\n            }, {\n              type: button\n              variant: ghost\n              icon: x\n              label: \"Clear search\"\n              action: CLEAR_SEARCH\n            }]\n          }, {\n            type: typography\n            variant: caption\n            color: muted\n            content: (str/concat (str/concat \"Matching “\" @entity.searchTerm) \"”\")\n          }, { type: divider }, {\n            type: data-grid\n            entity: @payload.data\n            fields: @config.resultFields\n            itemActions: @config.resultActions\n          }]\n        })\n      AppSearchFailed -> idle\n        (render-ui main {\n          type: stack\n          direction: vertical\n          gap: md\n          children: [{\n            type: alert\n            variant: error\n            message: ?error\n          }, @config.idleContent]\n        })\n    }\n\n    state results {\n      INIT -> idle\n        (set @entity.searchTerm \"\")\n        (fetch AppSearchTarget {})\n        (render-ui main {\n          type: stack\n          direction: vertical\n          gap: md\n          children: [@config.idleContent]\n        })\n      APP_SEARCH -> searching\n        (set @entity.searchTerm ?value)\n        (fetch AppSearchTarget {\n          filter: (or [\"=\", ?value, \"\"] (str/includes (object/get @entity @config.searchField) ?value))\n          emit: { success: AppSearchLoaded, failure: AppSearchFailed }\n        })\n        (render-ui main {\n          type: stack\n          align: center\n          direction: vertical\n          gap: md\n          className: \"py-12\"\n          children: [{ type: spinner }, {\n            type: typography\n            variant: caption\n            color: muted\n            content: \"Searching…\"\n          }]\n        })\n      CLEAR_SEARCH -> idle\n        (set @entity.searchTerm \"\")\n        (render-ui main {\n          type: stack\n          direction: vertical\n          gap: md\n          children: [@config.idleContent]\n        })\n    }\n\n    emits {\n      AppSearchLoaded\n      AppSearchFailed\n    }\n\n    listens {\n      APP_SEARCH {\n        value : string\n      }\n        @description \"A search query was submitted (e.g. from the AppLayout top-bar search).\"\n        @synonyms \"query, find, lookup\"\n        @tier \"domain\"\n      AppSearchFailed {\n        error : string\n      }\n    }\n\n    config {\n      idleContent : trait = @trait.AppSearchIdleHint\n        @label \"Idle content\"\n        @description \"The normal content view (e.g. the data ledger/browse trait) shown when no search is active.\"\n        @tier \"presentation\"\n      searchField : string = name\n        @label \"Search field\"\n        @description \"Entity field matched against the query (case-insensitive substring).\"\n        @tier \"presentation\"\n      resultsTitle : string = \"Search results\"\n        @label \"Results title\"\n        @description \"Heading shown above the search-results grid.\"\n        @tier \"presentation\"\n      resultFields : [AppSearchFieldSpec] = [{\n        label: Name\n        name: name\n        variant: h4\n      }]\n        @label \"Result columns\"\n        @description \"Columns shown in the search-results grid; maps entity fields to display cells.\"\n        @tier \"presentation\"\n      resultActions : [AppSearchActionSpec] = []\n        @label \"Result row actions\"\n        @description \"Optional per-row actions on a result, e.g. { label: \\\"View Details\\\", event: \\\"VIEW\\\" }.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/app-search\" as AppSearchPage -> AppSearch\n}\n"
}