{
  "name": "std-physics-friction",
  "description": "Friction engine — decelerates sliding bodies via kinetic friction each tick and renders a physics-canvas.",
  "level": "atom",
  "topic": "ui/learning",
  "schema": {
    "name": "std-physics-friction",
    "version": "1.0.0",
    "description": "Friction engine — decelerates sliding bodies via kinetic friction each tick and renders a physics-canvas.",
    "orbitals": [
      {
        "name": "FrictionEngineOrbital",
        "entity": {
          "name": "FrictionState",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "bodies",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "radius": {
                    "name": "radius",
                    "type": "number",
                    "required": false
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
                  "fx": {
                    "name": "fx",
                    "type": "number",
                    "required": false
                  },
                  "vy": {
                    "name": "vy",
                    "type": "number",
                    "required": false
                  },
                  "fy": {
                    "name": "fy",
                    "type": "number",
                    "required": false
                  },
                  "x": {
                    "name": "x",
                    "type": "number",
                    "required": true
                  },
                  "vx": {
                    "name": "vx",
                    "type": "number",
                    "required": false
                  },
                  "id": {
                    "name": "id",
                    "type": "string",
                    "required": false
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "y": {
                    "name": "y",
                    "type": "number",
                    "required": true
                  }
                }
              }
            },
            {
              "name": "running",
              "type": "boolean",
              "default": false
            }
          ]
        },
        "traits": [
          {
            "name": "FrictionSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "bodies",
                "running"
              ]
            },
            "category": "interaction",
            "linkedEntity": "FrictionState",
            "emits": [
              {
                "event": "BODIES_UPDATED",
                "description": "The current scene each tick — a composed listener (graph, readout, mirror canvas) can subscribe; a harmless no-op when the atom runs standalone.",
                "synonyms": "tick, frame, step, redraw",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "bodies",
                    "type": "[FrictionBody]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "BODIES_UPDATED",
                  "name": "Bodies Updated",
                  "description": "The current scene each tick — a composed listener (graph, readout, mirror canvas) can subscribe; a harmless no-op when the atom runs standalone.",
                  "synonyms": "tick, frame, step, redraw",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "bodies",
                      "type": "[FrictionBody]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.bodies",
                      [
                        {
                          "y": 386,
                          "radius": 14,
                          "color": "#2563eb",
                          "label": "A",
                          "vx": 6,
                          "id": "ball-a",
                          "x": 60,
                          "vy": 0,
                          "fx": 0,
                          "fy": 0
                        },
                        {
                          "color": "#16a34a",
                          "id": "ball-b",
                          "vx": 9,
                          "fy": 0,
                          "y": 386,
                          "label": "B",
                          "radius": 14,
                          "vy": 0,
                          "x": 85,
                          "fx": 0
                        },
                        {
                          "y": 386,
                          "id": "ball-c",
                          "vy": 0,
                          "label": "C",
                          "fx": 0,
                          "radius": 14,
                          "fy": 0,
                          "color": "#dc2626",
                          "vx": 13,
                          "x": 110
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "showVelocity": true,
                        "width": 600,
                        "height": 400,
                        "backgroundColor": "#f8fafc",
                        "type": "physics-canvas",
                        "bodies": "@entity.bodies",
                        "velocityScale": 8,
                        "showForces": false
                      }
                    ],
                    [
                      "emit",
                      "BODIES_UPDATED",
                      {
                        "bodies": "@entity.bodies"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "frictionTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "set",
                    "@entity.bodies",
                    [
                      "array/map",
                      "@entity.bodies",
                      [
                        "fn",
                        "b",
                        [
                          "let",
                          [
                            [
                              "r",
                              [
                                "object/get",
                                "@b",
                                "radius"
                              ]
                            ],
                            [
                              "d",
                              0.12
                            ],
                            [
                              "vx0",
                              [
                                "object/get",
                                "@b",
                                "vx"
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "nvx",
                                [
                                  "if",
                                  [
                                    ">",
                                    "@vx0",
                                    "@d"
                                  ],
                                  [
                                    "-",
                                    "@vx0",
                                    "@d"
                                  ],
                                  [
                                    "if",
                                    [
                                      "<",
                                      "@vx0",
                                      [
                                        "*",
                                        -1,
                                        "@d"
                                      ]
                                    ],
                                    [
                                      "+",
                                      "@vx0",
                                      "@d"
                                    ],
                                    0
                                  ]
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "nx",
                                  [
                                    "math/clamp",
                                    [
                                      "+",
                                      [
                                        "object/get",
                                        "@b",
                                        "x"
                                      ],
                                      "@nvx"
                                    ],
                                    "@r",
                                    [
                                      "-",
                                      600,
                                      "@r"
                                    ]
                                  ]
                                ],
                                [
                                  "ny",
                                  [
                                    "-",
                                    400,
                                    "@r"
                                  ]
                                ]
                              ],
                              [
                                "object/merge",
                                "@b",
                                {
                                  "vy": 0,
                                  "x": "@nx",
                                  "y": "@ny",
                                  "vx": "@nvx"
                                }
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "velocityScale": 8,
                      "width": 600,
                      "backgroundColor": "#f8fafc",
                      "bodies": "@entity.bodies",
                      "height": 400,
                      "showVelocity": true,
                      "showForces": false,
                      "type": "physics-canvas"
                    }
                  ],
                  [
                    "emit",
                    "BODIES_UPDATED",
                    {
                      "bodies": "@entity.bodies"
                    }
                  ]
                ]
              }
            ],
            "config": {
              "friction": {
                "type": "number",
                "default": 0.12,
                "label": "Friction",
                "description": "Deceleration subtracted from each body's |vx| every tick until it reaches zero.",
                "tier": "domain"
              },
              "running": {
                "type": "boolean",
                "default": true,
                "label": "Running",
                "description": "When true the tick integrates; toggle to start/pause the sim.",
                "tier": "domain"
              },
              "width": {
                "type": "number",
                "default": 600,
                "label": "Width",
                "description": "Simulation width in pixels; bounds body movement.",
                "tier": "presentation"
              },
              "bodies": {
                "type": "[FrictionBody]",
                "default": [
                  {
                    "y": 386,
                    "radius": 14,
                    "color": "#2563eb",
                    "label": "A",
                    "vx": 6,
                    "id": "ball-a",
                    "x": 60,
                    "vy": 0,
                    "fx": 0,
                    "fy": 0
                  },
                  {
                    "color": "#16a34a",
                    "id": "ball-b",
                    "vx": 9,
                    "fy": 0,
                    "y": 386,
                    "label": "B",
                    "radius": 14,
                    "vy": 0,
                    "x": 85,
                    "fx": 0
                  },
                  {
                    "y": 386,
                    "id": "ball-c",
                    "vy": 0,
                    "label": "C",
                    "fx": 0,
                    "radius": 14,
                    "fy": 0,
                    "color": "#dc2626",
                    "vx": 13,
                    "x": 110
                  }
                ],
                "label": "Bodies",
                "description": "Initial bodies; each carries position (x,y) and horizontal velocity (vx) sliding on the floor.",
                "tier": "domain",
                "items": {
                  "type": "object",
                  "properties": {
                    "fx": {
                      "name": "fx",
                      "type": "number",
                      "required": false
                    },
                    "label": {
                      "name": "label",
                      "type": "string",
                      "required": false
                    },
                    "vx": {
                      "name": "vx",
                      "type": "number",
                      "required": false
                    },
                    "vy": {
                      "name": "vy",
                      "type": "number",
                      "required": false
                    },
                    "radius": {
                      "name": "radius",
                      "type": "number",
                      "required": false
                    },
                    "y": {
                      "name": "y",
                      "type": "number",
                      "required": true
                    },
                    "fy": {
                      "name": "fy",
                      "type": "number",
                      "required": false
                    },
                    "color": {
                      "name": "color",
                      "type": "string",
                      "required": false
                    },
                    "id": {
                      "name": "id",
                      "type": "string",
                      "required": false
                    },
                    "x": {
                      "name": "x",
                      "type": "number",
                      "required": true
                    }
                  }
                }
              },
              "showVelocity": {
                "type": "boolean",
                "default": true,
                "label": "Show Velocity",
                "description": "Draw each body's velocity vector as an arrow.",
                "tier": "presentation"
              },
              "velocityScale": {
                "type": "number",
                "default": 8,
                "label": "Velocity Scale",
                "description": "Length multiplier for the velocity arrows.",
                "tier": "presentation"
              },
              "backgroundColor": {
                "type": "string",
                "default": "#f8fafc",
                "label": "Background Color",
                "description": "Canvas background color.",
                "tier": "presentation"
              },
              "height": {
                "type": "number",
                "default": 400,
                "label": "Height",
                "description": "Simulation height in pixels; sets the floor level.",
                "tier": "presentation"
              }
            },
            "scope": "instance"
          }
        ],
        "pages": [
          {
            "name": "FrictionEnginePage",
            "path": "/physics-friction",
            "traits": [
