  "source": "",
  "lolo": "app std-game-clock \"1.0.0\"\n\"std-game-clock — fixed-timestep authoritative clock games compose to drive time; emits GameClockTicked every 100ms while running.\"\norbital GameClockOrbital {\n    type GameClockTicked = Event { elapsedMs : number } \"Broadcast each tick while the clock is running.\"\n\n  entity GameClockRecord [persistent: game_clock_states] {\n    id : string!\n    elapsedMs : number @description \"Total milliseconds elapsed since the clock started.\" @synonyms \"elapsed, time, ms, total time\" = 0\n    running : boolean @description \"Whether the clock is currently ticking.\" @synonyms \"active, playing, started\" = true\n  }\n\n  trait GameClock -> GameClockRecord [game-core, instance] {\n    initial: running\n\n    state running {\n      PAUSE -> paused\n        (set @entity.running false)\n      RESUME -> running\n    }\n\n    state paused {\n      RESUME -> running\n        (set @entity.running true)\n      PAUSE -> paused\n    }\n\n    emits {\n      GameClockTicked -> external {\n        elapsedMs : number\n      }\n        @description \"Fires every clock tick while running; consumers use elapsedMs to drive animations and game logic.\"\n        @synonyms \"clock-tick, time-advance, tick, frame, elapsed\"\n        @tier \"domain\"\n    }\n\n    listens {\n      PAUSE { }\n      RESUME { }\n    }\n\n    ticks {\n      clockTick every 100ms\n        when (== @entity.running true)\n        (set @entity.elapsedMs (+ @entity.elapsedMs 100))\n        (emit GameClockTicked { elapsedMs: @entity.elapsedMs })\n    }\n\n    config {\n      autoStart : boolean = true\n        @label \"Auto-start clock\"\n        @description \"When true the clock begins ticking immediately on INIT without waiting for a RESUME event.\"\n        @synonyms \"start on init, auto-run, begin immediately\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/game/clock\" as GameClockPage -> GameClock\n}\n"
