  "source": "",
  "lolo": "app std-agent-memory \"1.0.0\"\n\"Wraps memory/recall + memory/store — semantic memory for agent loops.\"\n\ntype MemoryRecord = { id: string!, content: string!, category: string!, strength: number }\n\norbital AgentMemoryOrbital {\n\n  entity AgentMemory [runtime] {\n    query : string = \"\"\n    results : [MemoryRecord] = []\n    content : string = \"\"\n    category : string = \"\"\n    memoryId : string = \"\"\n    status : \"idle\" | \"recalled\" | \"stored\" = idle\n  }\n\n  trait MemoryRecall -> AgentMemory [lifecycle, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.query \"\")\n        (set @entity.results [])\n        (set @entity.content \"\")\n        (set @entity.category \"\")\n        (set @entity.memoryId \"\")\n        (set @entity.status idle)\n      RECALL -> recalling\n        (set @entity.query ?query)\n        (memory/recall @entity.query { emit: { success: RECALL_COMPLETE, failure: RECALL_FAILED } })\n    }\n\n    state recalling {\n      RECALL_COMPLETE -> recalled\n        (set @entity.results ?result)\n        (set @entity.status recalled)\n        (emit RECALLED { results: @entity.results })\n      RECALL_FAILED -> recalled\n        (set @entity.results [])\n        (set @entity.status recalled)\n        (emit RECALLED { results: @entity.results })\n    }\n\n    state recalled {\n      INIT -> recalled\n        (set @entity.status recalled)\n      RESET -> idle\n        (set @entity.results [])\n        (set @entity.query \"\")\n        (set @entity.status idle)\n    }\n\n    emits {\n      RECALLED {\n        results : [MemoryRecord]!\n      }\n      RECALL_COMPLETE {\n        result : [MemoryRecord]!\n      }\n    }\n\n    listens {\n      RECALL {\n        query : string!\n      }\n    }\n  }\n\n  trait MemoryStore -> AgentMemory [lifecycle, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.content \"\")\n        (set @entity.category \"\")\n        (set @entity.memoryId \"\")\n        (set @entity.status idle)\n      STORE -> storing\n        (set @entity.content ?content)\n        (set @entity.category ?category)\n        (memory/store @entity.content @entity.category { emit: { success: STORE_COMPLETE, failure: STORE_FAILED } })\n    }\n\n    state storing {\n      STORE_COMPLETE -> stored\n        (set @entity.memoryId ?result)\n        (set @entity.status stored)\n        (emit STORED { memoryId: @entity.memoryId })\n      STORE_FAILED -> stored\n        (set @entity.memoryId \"\")\n        (set @entity.status stored)\n        (emit STORED { memoryId: @entity.memoryId })\n    }\n\n    state stored {\n      INIT -> stored\n        (set @entity.status stored)\n      RESET -> idle\n        (set @entity.content \"\")\n        (set @entity.category \"\")\n        (set @entity.memoryId \"\")\n        (set @entity.status idle)\n    }\n\n    emits {\n      STORED {\n        memoryId : string!\n      }\n      STORE_COMPLETE {\n        result : string!\n      }\n    }\n\n    listens {\n      STORE {\n        content : string!\n        category : string!\n      }\n    }\n  }\n\n  trait MemoryListener -> AgentMemory [lifecycle, instance] {\n    initial: waiting\n\n    state waiting {\n      INIT -> waiting\n        (set @entity.status idle)\n      RECALLED -> updated\n        (set @entity.status recalled)\n      STORED -> updated\n        (set @entity.status stored)\n    }\n\n    state updated {\n      INIT -> updated\n        (set @entity.status idle)\n      RESET -> waiting\n        (set @entity.status idle)\n    }\n\n    listens {\n      MemoryRecall.RECALLED -> RECALLED\n      MemoryStore.STORED -> STORED\n      RESET\n    }\n  }\n\n  page \"/agent-memory\" as AgentMemoryPage -> MemoryRecall, MemoryStore, MemoryListener\n}\n"
