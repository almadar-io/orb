  "source": "",
  "lolo": "app ui-drawer \"1.0.0\"\n\"Drawer — UI factory (1:1 with the @almadar/ui drawer pattern).\"\norbital DrawerOrbital {\n  entity DrawerItem [runtime] {\n    id : string!\n  }\n\n  trait DrawerRender -> @rebindable DrawerItem [interaction, instance] {\n    initial: closed\n\n    state closed {\n      INIT -> closed\n        (render-ui main {\n          label: \"Open Drawer\"\n          action: OPEN\n          type: button\n        })\n      OPEN -> open\n        (render-ui drawer {\n          isOpen: @config.isOpen\n          onClose: @config.onClose\n          title: @config.title\n          children: @config.children\n          footer: @config.footer\n          position: @config.position\n          width: @config.width\n          showCloseButton: @config.showCloseButton\n          closeOnOverlayClick: @config.closeOnOverlayClick\n          closeOnEscape: @config.closeOnEscape\n          className: @config.className\n          closeEvent: @config.closeEvent\n          type: drawer\n        })\n    }\n\n    state open {\n      CLOSE -> closed\n        (render-ui drawer null)\n        (render-ui main {\n          label: \"Open Drawer\"\n          action: OPEN\n          type: button\n        })\n    }\n\n    emits {\n      @config.onClose -> external { }\n        @description \"Callback when drawer should close (injected by slot wrapper)\"\n        @tier \"essential\"\n      OPEN -> external {\n        id : string\n      }\n        @description \"Open the Drawer.\"\n        @tier \"essential\"\n    }\n\n    config {\n      isOpen : boolean = true\n        @label \"Is Open\"\n        @description \"Whether the drawer is open (defaults to true when rendered by slot wrapper)\"\n        @tier \"presentation\"\n      onClose : event = \"CLOSE\"\n        @label \"On Close\"\n        @description \"Callback when drawer should close (injected by slot wrapper)\"\n        @tier \"presentation\"\n      title : node\n        @label \"Title\"\n        @description \"Drawer title (text or any node, e.g. a brand logo + name).\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Drawer content (can be empty if using slot content)\"\n        @tier \"presentation\"\n      footer : node\n        @label \"Footer\"\n        @description \"Footer content\"\n        @tier \"presentation\"\n      position : \"left\" | \"right\" = right\n        @label \"Position\"\n        @description \"Position (left or right)\"\n        @tier \"presentation\"\n      width : string = md\n        @label \"Width\"\n        @description \"Width (CSS value or preset size)\"\n        @tier \"presentation\"\n      showCloseButton : boolean = true\n        @label \"Show Close Button\"\n        @description \"Show close button\"\n        @tier \"presentation\"\n      closeOnOverlayClick : boolean = true\n        @label \"Close On Overlay Click\"\n        @description \"Close on overlay click\"\n        @tier \"presentation\"\n      closeOnEscape : boolean = true\n        @label \"Close On Escape\"\n        @description \"Close on escape key\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class name\"\n        @tier \"presentation\"\n      closeEvent : event = \"CLOSE\"\n        @label \"Close Event\"\n        @description \"Declarative close event — emits UI:{closeEvent} via eventBus when drawer should close\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/drawer\" as DrawerPage -> DrawerRender\n}\n"
}