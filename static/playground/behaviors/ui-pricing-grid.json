  "source": "",
  "lolo": "app ui-pricing-grid \"1.0.0\"\n\"PricingGrid — UI factory (1:1 with the @almadar/ui pricing-grid pattern).\"\norbital PricingGridOrbital {\n  type PricingGridPlansItem = {\n    name : string!\n    price : string!\n    description : string\n    features : [string]!\n    action : PricingGridPlansItemAction!\n    highlighted : boolean\n    badge : string\n    className : string\n  }\n  type PricingGridPlansItemAction = {\n    label : string!\n    href : string!\n  }\n\n  entity PricingGridItem [runtime] {\n    id : string!\n  }\n\n  trait PricingGridRender -> @rebindable PricingGridItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          plans: @config.plans\n          className: @config.className\n          type: pricing-grid\n        })\n    }\n\n    config {\n      plans : [PricingGridPlansItem] = [{ name: \"Name\", price: \"Price\", description: \"Description\", features: [\"Item\", \"Item 2\"], action: { label: \"Label\", href: \"Href\" }, highlighted: false, badge: \"Badge\", className: \"Class Name\" }, { name: \"Name 2\", price: \"Price 2\", description: \"Description 2\", features: [\"Item\", \"Item 2\"], action: { label: \"Label 2\", href: \"Href 2\" }, highlighted: true, badge: \"Badge 2\", className: \"Class Name 2\" }]\n        @label \"Plans\"\n        @description \"plans prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/pricing-grid\" as PricingGridPage -> PricingGridRender\n}\n"
}