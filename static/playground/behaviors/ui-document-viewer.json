  "source": "",
  "lolo": "app ui-document-viewer \"1.0.0\"\n\"DocumentViewer — UI factory (1:1 with the @almadar/ui document-viewer pattern).\"\norbital DocumentViewerOrbital {\n  type DocumentViewerActionsItem = {\n    label : string!\n    event : event\n    navigatesTo : string\n    variant : \"primary\" | \"secondary\" | \"ghost\"\n  }\n  type DocumentViewerDocumentsItem = {\n    label : string!\n    src : asset\n    content : string\n    documentType : \"pdf\" | \"text\" | \"html\" | \"markdown\"\n  }\n  type DocumentViewerError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity DocumentViewerItem [runtime] {\n    id : string!\n  }\n\n  trait DocumentViewerRender -> @rebindable DocumentViewerItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          title: @config.title\n          src: @config.src\n          content: @config.content\n          documentType: @config.documentType\n          currentPage: @config.currentPage\n          totalPages: @config.totalPages\n          height: @config.height\n          showToolbar: @config.showToolbar\n          showDownload: @config.showDownload\n          showPrint: @config.showPrint\n          actions: @config.actions\n          documents: @config.documents\n          isLoading: @config.isLoading\n          error: @config.error\n          className: @config.className\n          type: document-viewer\n        })\n    }\n\n    config {\n      title : string\n        @label \"Title\"\n        @description \"Document title\"\n        @tier \"presentation\"\n      src : asset = \"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png\"\n        @label \"Src\"\n        @description \"Document URL (for PDF/external documents)\"\n        @tier \"presentation\"\n      content : string\n        @label \"Content\"\n        @description \"Document content (for text/html/markdown)\"\n        @tier \"presentation\"\n      documentType : \"pdf\" | \"text\" | \"html\" | \"markdown\" = pdf\n        @label \"Document Type\"\n        @description \"Document type\"\n        @tier \"presentation\"\n      currentPage : number\n        @label \"Current Page\"\n        @description \"Current page (for multi-page documents)\"\n        @tier \"presentation\"\n      totalPages : number\n        @label \"Total Pages\"\n        @description \"Total pages\"\n        @tier \"presentation\"\n      height : string\n        @label \"Height\"\n        @description \"Viewer height\"\n        @tier \"presentation\"\n      showToolbar : boolean = true\n        @label \"Show Toolbar\"\n        @description \"Show toolbar\"\n        @tier \"presentation\"\n      showDownload : boolean = false\n        @label \"Show Download\"\n        @description \"Show download button\"\n        @tier \"presentation\"\n      showPrint : boolean = false\n        @label \"Show Print\"\n        @description \"Show print button\"\n        @tier \"presentation\"\n      actions : [DocumentViewerActionsItem] = []\n        @label \"Actions\"\n        @description \"Actions\"\n        @tier \"presentation\"\n      documents : [DocumentViewerDocumentsItem] = []\n        @label \"Documents\"\n        @description \"Multiple documents (tabbed view)\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state\"\n        @tier \"presentation\"\n      error : DocumentViewerError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/document-viewer\" as DocumentViewerPage -> DocumentViewerRender\n}\n"
}