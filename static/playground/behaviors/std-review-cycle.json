  "source": "",
  "lolo": "app std-review-cycle \"0.1.0\"\n\"std-review-cycle — revise-and-resubmit review workflow (document review, pull-request review, design review, editorial review, submission review, send back for changes, request changes, resubmit, review rounds, four-eyes approval). A record moves draft → in review → changes requested → in review → … → approved. One SUBMIT event serves both the first submission and every resubmission; the atom counts review rounds and marks resubmissions on the emitted ReviewRequested. Every move writes a ReviewEvent history row stamped with the states it left and entered. `requireSeparateApproval` enforces four-eyes review: an approval raised in the same action that submitted the record (an auto-responding rule or bot) is rejected. Headless — the host renders the badge and buttons and routes its actions to SUBMIT / REQUEST_CHANGES / APPROVE.\"\norbital ReviewCycleOrbital {\n    type ReviewSubmitted = Event { id : string, note : string } \"Rename via traitOverrides.events to the host's submit action. Serves both the first submission and every resubmission.\"\n\n    type ReviewChangesRequested = Event { id : string, note : string } \"Rename to the host's request-changes action. Sends the record back to its author.\"\n\n    type ReviewApproved = Event { id : string, note : string } \"Rename to the host's approve action.\"\n\n    type ReviewRequested = Event { itemId : string, round : number, resubmission : boolean } \"Emitted when a record enters review; `resubmission` is true when it came back from changes requested.\"\n\n    type ReviewLogged = Event ReviewEvent \"Internal: a history row landed.\"\n\n    type ReviewLogFailed = Event { error : string, code : string } \"Internal: writing a history row failed.\"\n\n    type ReviewDecided = Event { itemId : string, decision : string, round : number } \"Emitted when a reviewer decides; `decision` is the state the record moved to (changes_requested or approved).\"\n\n  entity ReviewItem [persistent: review_items] {\n    id : string!\n    round : number @description \"Review round the record is on; 1 for the first review, incremented on each resubmission.\" @synonyms \"iteration, revision round, review count\" = 0\n    lastNote : string @description \"Note left with the most recent move.\" @synonyms \"comment, reason, feedback\" = \"\"\n    lastLogId : string @description \"Id of the most recent ReviewEvent history row.\" @synonyms \"history id, log entry\" = \"\"\n  }\n\n  entity ReviewEvent [persistent: review_events] {\n    id : string!\n    itemId : string @description \"The record this history entry belongs to.\" @synonyms \"record id, document id, item\" = \"\"\n    fromState : string @description \"The review state the record left.\" @synonyms \"previous state, was\" = \"\"\n    toState : string @description \"The review state the record entered.\" @synonyms \"new state, became\" = \"\"\n    round : number @description \"Review round at the time of the move.\" @synonyms \"iteration\" = 0\n    actor : string @description \"Who made the move.\" @synonyms \"user, reviewer, author\" = \"\"\n    note : string @description \"Note left with the move.\" @synonyms \"comment, feedback, reason\" = \"\"\n    at : number @description \"When the move happened.\" @synonyms \"timestamp, date, time\" = 0\n  }\n\n  trait ReviewCycle -> @rebindable ReviewItem [lifecycle, instance] {\n    initial: draft\n\n    state draft {\n      INIT -> draft\n      ReviewSubmitted -> in_review when @config.enabled\n        (set @entity.round 1)\n        (set @entity.lastNote (str/default ?note \"\"))\n        (emit ReviewRequested { itemId: (str/default ?id \"\"), round: 1, resubmission: false })\n        (persist create ReviewEvent { itemId: (str/default ?id \"\"), fromState: @fromState, toState: @toState, round: 1, actor: (str/default @user.id \"\"), note: (str/default ?note \"\"), at: @now } { emit: { success: ReviewLogged, failure: ReviewLogFailed } })\n    }\n\n    state in_review {\n      INIT -> in_review\n      ReviewLogged -> in_review\n        (set @entity.lastLogId (str/default ?id \"\"))\n      ReviewLogFailed -> in_review\n        (notify error (str/concat \"Couldn't record the review history — \" ?error))\n      ReviewChangesRequested -> changes_requested\n        (set @entity.lastNote (str/default ?note \"\"))\n        (emit ReviewDecided { itemId: (str/default ?id \"\"), decision: @toState, round: @entity.round })\n        (persist create ReviewEvent { itemId: (str/default ?id \"\"), fromState: @fromState, toState: @toState, round: @entity.round, actor: (str/default @user.id \"\"), note: (str/default ?note \"\"), at: @now } { emit: { success: ReviewLogged, failure: ReviewLogFailed } })\n      ReviewApproved -> approved when (or (not @config.requireSeparateApproval) (not (array/some @prevStates (fn s (or (= @s \"draft\") (= @s \"changes_requested\"))))))\n        (set @entity.lastNote (str/default ?note \"\"))\n        (emit ReviewDecided { itemId: (str/default ?id \"\"), decision: @toState, round: @entity.round })\n        (persist create ReviewEvent { itemId: (str/default ?id \"\"), fromState: @fromState, toState: @toState, round: @entity.round, actor: (str/default @user.id \"\"), note: (str/default ?note \"\"), at: @now } { emit: { success: ReviewLogged, failure: ReviewLogFailed } })\n    }\n\n    state changes_requested {\n      INIT -> changes_requested\n      ReviewLogged -> changes_requested\n        (set @entity.lastLogId (str/default ?id \"\"))\n      ReviewLogFailed -> changes_requested\n        (notify error (str/concat \"Couldn't record the review history — \" ?error))\n      ReviewSubmitted -> in_review\n        (set @entity.round (+ @entity.round 1))\n        (set @entity.lastNote (str/default ?note \"\"))\n        (emit ReviewRequested { itemId: (str/default ?id \"\"), round: @entity.round, resubmission: true })\n        (persist create ReviewEvent { itemId: (str/default ?id \"\"), fromState: @fromState, toState: @toState, round: @entity.round, actor: (str/default @user.id \"\"), note: (str/default ?note \"\"), at: @now } { emit: { success: ReviewLogged, failure: ReviewLogFailed } })\n    }\n\n    state approved {\n      INIT -> approved\n      ReviewLogged -> approved\n        (set @entity.lastLogId (str/default ?id \"\"))\n      ReviewLogFailed -> approved\n        (notify error (str/concat \"Couldn't record the review history — \" ?error))\n    }\n\n    emits {\n      ReviewLogged\n      ReviewLogFailed\n      ReviewRequested -> external {\n        itemId : string\n        round : number\n        resubmission : boolean\n      }\n      ReviewDecided -> external {\n        itemId : string\n        decision : string\n        round : number\n      }\n    }\n\n    listens {\n      ReviewLogged\n      ReviewLogFailed {\n        error : string\n        code : string\n      }\n      ReviewSubmitted {\n        id : string\n        note : string\n      }\n      ReviewChangesRequested {\n        id : string\n        note : string\n      }\n      ReviewApproved {\n        id : string\n        note : string\n      }\n    }\n\n    config {\n      enabled : boolean = true\n        @label \"Run the review workflow?\"\n        @description \"Accept submissions into review. Off = submissions are ignored.\"\n        @synonyms \"enable, turn on, review, require review, review workflow\"\n        @tier \"policy\"\n      requireSeparateApproval : boolean = true\n        @label \"Require approval to be a separate action?\"\n        @description \"Four-eyes review: reject an approval raised by the same action that submitted the record, such as an automatic rule or bot that approves instantly. Approvals made as their own action are unaffected.\"\n        @synonyms \"four eyes, two person rule, no self approval, separate reviewer, independent approval, no auto approve\"\n        @tier \"policy\"\n    }\n  }\n\n  page \"/review-cycle\" as ReviewCyclePage -> ReviewCycle\n}\n"
}