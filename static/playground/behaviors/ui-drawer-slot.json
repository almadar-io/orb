  "source": "",
  "lolo": "app ui-drawer-slot \"1.0.0\"\n\"DrawerSlot — UI factory (1:1 with the @almadar/ui drawer-slot pattern).\"\norbital DrawerSlotOrbital {\n  type DrawerSlotError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity DrawerSlotItem [runtime] {\n    id : string!\n  }\n\n  trait DrawerSlotRender -> @rebindable DrawerSlotItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (fetch DrawerSlotItem {})\n        (render-ui main {\n          children: @config.children\n          title: @config.title\n          position: @config.position\n          size: @config.size\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          entity: DrawerSlotItem\n          sourceTrait: @config.sourceTrait\n          type: drawer-slot\n        })\n    }\n\n    config {\n      children : node\n        @label \"Children\"\n        @description \"Content to display in the drawer\"\n        @tier \"presentation\"\n      title : string\n        @label \"Title\"\n        @description \"Override drawer title (extracted from children if not provided)\"\n        @tier \"presentation\"\n      position : \"left\" | \"right\" = right\n        @label \"Position\"\n        @description \"Drawer position\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" | \"xl\" | \"full\" = md\n        @label \"Size\"\n        @description \"Drawer size\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Custom class name\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state\"\n        @tier \"presentation\"\n      error : DrawerSlotError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      sourceTrait : string\n        @label \"Source Trait\"\n        @description \"Source trait name for qualified event emission\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/drawer-slot\" as DrawerSlotPage -> DrawerSlotRender\n}\n"
}