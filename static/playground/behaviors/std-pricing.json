  "lolo": "app std-pricing \"1.0.0\"\n\"std-pricing — side-by-side plan cards from a config list: plan name, price and billing period, a one-line summary, the included features, and a link action per plan; one plan can be highlighted as recommended with a badge. Optional heading and footnote. Clicking a plan's action follows its href and emits PLAN_SELECTED. Pick for pricing pages, subscription tiers and service packages.\"\ntype PricingPlan = { name : string!, price : string!, period : string, summary : string, features : [string], actionLabel : string, actionHref : string, highlighted : boolean, badge : string }\norbital PricingOrbital {\n\n  entity PricingView [runtime] {\n    id : string!\n  }\n\n  trait PricingRender -> @rebindable PricingView [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          type: box\n          paddingY: xl\n          bg: (if (== @config.surface muted) muted transparent)\n          fullWidth: true\n          children: [{\n            type: container\n            size: xl\n            maxWidth: xl\n            padding: lg\n            children: [{ type: stack, direction: vertical, gap: xl, children: [{\n              type: stack\n              direction: vertical\n              gap: sm\n              align: center\n              className: (if (== @config.heading \"\") (if (== @config.lede \"\") hidden \"\") \"\")\n              children: [{\n              type: typography\n              content: @config.heading\n              variant: h2\n              weight: bold\n              align: center\n              className: (if (== @config.heading \"\") hidden \"tracking-tight text-balance\")\n            }, {\n              type: typography\n              content: @config.lede\n              variant: large\n              color: muted\n              align: center\n              className: (if (== @config.lede \"\") hidden \"max-w-2xl text-pretty\")\n            }]\n            }, {\n              type: simple-grid\n              cols: (math/min (math/max (array/len @config.plans) 1) 4)\n              gap: lg\n              className: \"items-stretch\"\n              children: (array/map @config.plans (fn plan {\n                type: card\n                look: elevated\n                padding: lg\n                className: (if (object/get @plan highlighted false) \"h-full ring-2 ring-primary\" \"h-full\")\n                children: [{\n                  type: stack\n                  direction: vertical\n                  gap: md\n                  className: \"h-full\"\n                  children: [{\n                    type: stack\n                    direction: horizontal\n                    gap: sm\n                    align: center\n                    justify: between\n                    children: [{\n                      type: typography\n                      content: (object/get @plan name \"\")\n                      variant: h4\n                      weight: semibold\n                    }, {\n                      type: badge\n                      label: (object/get @plan badge \"\")\n                      variant: primary\n                    }]\n                  }, {\n                    type: stack\n                    direction: horizontal\n                    gap: xs\n                    align: baseline\n                    children: [{\n                      type: typography\n                      content: (object/get @plan price \"\")\n                      variant: h2\n                      weight: bold\n                      className: \"tracking-tight\"\n                    }, {\n                      type: typography\n                      content: (object/get @plan period \"\")\n                      variant: body\n                      color: muted\n                      className: (if (== (object/get @plan period \"\") \"\") hidden \"\")\n                    }]\n                  }, {\n                    type: typography\n                    content: (object/get @plan summary \"\")\n                    variant: body\n                    color: muted\n                    className: (if (== (object/get @plan summary \"\") \"\") hidden \"text-pretty\")\n                  }, {\n                    type: divider\n                  }, {\n                    type: markdown-content\n                    content: (if (== (array/len (object/get @plan features [])) 0) \"\" (str/concat \"- \" (str/join (object/get @plan features []) \"\\n- \")))\n                    className: \"flex-1\"\n                  }, {\n                    type: button\n                    label: (object/get @plan actionLabel \"\")\n                    href: (object/get @plan actionHref \"\")\n                    variant: (if (object/get @plan highlighted false) primary secondary)\n                    size: lg\n                    action: PLAN_CHOOSE\n                    actionPayload: { plan: (object/get @plan name \"\"), href: (object/get @plan actionHref \"\") }\n                    className: (if (== (object/get @plan actionLabel \"\") \"\") hidden \"w-full\")\n                  }]\n                }]\n              }))\n            }, {\n              type: typography\n              content: @config.footnote\n              variant: caption\n              color: muted\n              align: center\n              className: (if (== @config.footnote \"\") hidden \"\")\n            }] }]\n          }]\n        })\n      PLAN_CHOOSE -> idle\n        (emit PLAN_SELECTED { plan: ?plan, href: ?href })\n    }\n\n    emits {\n      PLAN_SELECTED -> external {\n        plan : string\n        href : string\n      }\n        @description \"A plan's action was clicked; carries the plan name and its href.\"\n        @synonyms \"choose plan, select tier, subscribe click\"\n        @tier \"domain\"\n    }\n\n    listens {\n      PLAN_CHOOSE {\n        plan : string\n        href : string\n      }\n        @description \"Plan action click.\"\n        @tier \"internal\"\n    }\n\n    config {\n      heading : string = \"\"\n        @label \"Heading\"\n        @description \"Section heading above the plans; empty hides it\"\n        @synonyms \"title\"\n        @tier \"presentation\"\n      lede : string = \"\"\n        @label \"Supporting text\"\n        @tier \"presentation\"\n      plans : [PricingPlan] = [{ name: \"Starter\", price: \"$0\", period: \"/month\", summary: \"For trying things out.\", features: [\"1 project\", \"Community support\"], actionLabel: \"Start free\", actionHref: \"#\" }, { name: \"Team\", price: \"$29\", period: \"/month\", summary: \"For teams shipping every week.\", features: [\"Unlimited projects\", \"Shared workspace\", \"Priority support\"], actionLabel: \"Choose Team\", actionHref: \"#\", highlighted: true, badge: \"Popular\" }]\n        @label \"Plans\"\n        @description \"One card per plan: name, price, period, summary, features, action; `highlighted` marks the recommended plan\"\n        @synonyms \"tiers, packages, subscriptions, pricing table\"\n        @tier \"presentation\"\n      footnote : string = \"\"\n        @label \"Footnote\"\n        @description \"Small print under the plans, e.g. taxes or billing terms\"\n        @tier \"presentation\"\n      surface : \"plain\" | \"muted\" = plain\n        @label \"Surface\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/pricing\" as PricingPage -> PricingRender\n}\n"
}