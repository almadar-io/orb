  "lolo": "app std-vote \"1.0.0\"\n\"std-vote — forum-style up/down vote tally with single-vote-per-user constraint. Owns a Vote entity, rebindable so a host orbital can target its own entity in place of Vote. VOTE carries the targetId being voted on and persists it plus the new direction onto that row (toggling to none when re-clicking the active arrow), emitting VoteCasted -> external so sibling traits can react. SET_VOTE_TARGET rebinds the trait to a new targetId and refetches scoped to it, mirroring std-browse's REFETCH_FILTER.\"\norbital VoteOrbital {\n    type VoteLoaded = Event { data : [Vote] } \"Fired when the vote collection finishes loading\"\n\n    type VoteLoadFailed = Event { error : string, code : string } \"Fired when the vote collection fails to load\"\n\n    type VoteCasted = Event { row : Vote } \"Fired after a vote persists successfully\"\n\n    type VoteCastFailed = Event { error : string, code : string } \"Fired when persisting a vote fails\"\n\n  entity Vote [persistent: votes] {\n    id : string!\n    targetId : string! @description \"Identifier for the item being voted on.\" @synonyms \"reference, item, subject\"\n    voterId : string! @description \"Unique identifier of the user casting the vote.\" @synonyms \"user, author, participant\"\n    direction : \"up\" | \"down\" | \"none\" @description \"Indicates the vote's direction.\" @synonyms \"vote, sentiment, choice\" = none\n    createdAt : string\n  }\n\n  trait VoteCast -> @rebindable Vote [interaction, instance] {\n    initial: loading\n\n    state loading {\n      INIT -> loading\n        (fetch Vote {\n          emit: { failure: VoteLoadFailed, success: VoteLoaded }\n        })\n        (render-ui main {\n          align: center\n          children: [{ type: spinner }, {\n            color: muted\n            content: \"Loading votes…\"\n            type: typography\n            variant: caption\n          }]\n          className: py-12\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      VoteLoaded -> idle\n        (render-ui main {\n          count: 0\n          label: Vote\n          onVote: VOTE\n          type: vote-stack\n          userVote: @entity.direction\n          variant: vertical\n        })\n      VoteLoadFailed -> idle\n        (render-ui main {\n          message: ?error\n          type: alert\n          variant: error\n        })\n    }\n\n    state idle {\n      VOTE -> voting when (not [\"=\", ?next, @entity.direction])\n        (set @entity.direction ?next)\n        (set @entity.targetId ?targetId)\n        (persist update Vote (object/set ?data targetId ?targetId) {\n          emit: { failure: VoteCastFailed, success: VoteCasted }\n        })\n        (render-ui main {\n          align: center\n          children: [{ type: spinner }, {\n            color: muted\n            content: \"Recording your vote…\"\n            type: typography\n            variant: caption\n          }]\n          className: py-12\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      VOTE -> voting when [\"=\", ?next, @entity.direction]\n        (set @entity.direction none)\n        (set @entity.targetId ?targetId)\n        (persist update Vote (object/set ?data targetId ?targetId) {\n          emit: { failure: VoteCastFailed, success: VoteCasted }\n        })\n        (render-ui main {\n          align: center\n          children: [{ type: spinner }, {\n            color: muted\n            content: \"Clearing your vote…\"\n            type: typography\n            variant: caption\n          }]\n          className: py-12\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      ;; Rebinds the trait to a new target and refetches scoped to it, no\n      ;; skeleton repaint — same rationale as std-browse's REFETCH_FILTER:\n      ;; a populated body shouldn't flicker to a spinner mid-refetch.\n      SET_VOTE_TARGET -> idle\n        (set @entity.targetId ?targetId)\n        (fetch Vote {\n          emit: { failure: VoteLoadFailed, success: VoteLoaded }\n          filter: [\"=\", @entity.targetId, ?targetId]\n        })\n      VoteLoaded -> idle\n        (render-ui main {\n          count: 0\n          label: Vote\n          onVote: VOTE\n          type: vote-stack\n          userVote: @entity.direction\n          variant: vertical\n        })\n      VoteLoadFailed -> idle\n        (render-ui main {\n          message: ?error\n          type: alert\n          variant: error\n        })\n    }\n\n    state voting {\n      VoteCasted -> idle\n        (render-ui main {\n          count: 0\n          label: Vote\n          onVote: VOTE\n          type: vote-stack\n          userVote: @entity.direction\n          variant: vertical\n        })\n      VoteCastFailed -> error\n        (render-ui main {\n          message: ?error\n          type: alert\n          variant: error\n        })\n    }\n\n    state error {\n      INIT -> loading\n        (fetch Vote {\n          emit: { failure: VoteLoadFailed, success: VoteLoaded }\n        })\n        (render-ui main {\n          align: center\n          children: [{ type: spinner }, {\n            color: muted\n            content: \"Loading votes…\"\n            type: typography\n            variant: caption\n          }]\n          className: py-12\n          direction: vertical\n          gap: md\n          type: stack\n        })\n    }\n\n    emits {\n      VOTE {\n        targetId : string!\n        next : \"up\" | \"down\" | \"none\"\n        data : @entity!\n      }\n        @description \"Signals a vote has been successfully recorded.\"\n        @synonyms \"voted, submitted, confirmed\"\n        @tier \"domain\"\n      VoteLoaded {\n        data : [Vote]\n      }\n        @description \"Indicates a vote has been successfully retrieved.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"internal\"\n      VoteLoadFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates that loading a vote failed.\"\n        @synonyms \"load error, failed load, fetch failure\"\n        @tier \"internal\"\n      VoteCasted -> external {\n        row : Vote\n      }\n        @description \"Indicates a vote has been successfully recorded.\"\n        @synonyms \"voted, vote-submitted, vote-changed\"\n        @tier \"domain\"\n      VoteCastFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates a vote submission failed, likely due to a constraint.\"\n        @synonyms \"failed, rejected, error\"\n        @tier \"presentation\"\n    }\n\n    listens {\n      VOTE {\n        targetId : string!\n        next : \"up\" | \"down\" | \"none\"\n        data : @entity!\n      }\n        @description \"A user has submitted or changed their vote.\"\n        @synonyms \"voted, submitted, updated\"\n        @tier \"domain\"\n      SET_VOTE_TARGET {\n        targetId : string!\n      }\n        @description \"Rebinds the trait to a new target and refetches the vote row scoped to it.\"\n        @synonyms \"retarget, rebind target, scope to item, set target, change target\"\n        @tier \"domain\"\n      VoteLoaded {\n        data : [Vote]\n      }\n        @description \"Indicates a vote data load has completed.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"internal\"\n      VoteLoadFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates a failure to load vote data.\"\n        @synonyms \"error, failed, problem, issue\"\n        @tier \"internal\"\n      VoteCasted {\n        row : Vote\n      }\n        @description \"A vote has been successfully recorded.\"\n        @synonyms \"voted, tallied, updated\"\n        @tier \"domain\"\n      VoteCastFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates a vote submission could not be processed.\"\n        @synonyms \"error, rejected, failed, invalid\"\n        @tier \"internal\"\n    }\n\n    config {\n      allowDown : boolean = true\n        @label \"Allow downvotes\"\n        @description \"Show the downvote arrow alongside the upvote\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/votes/cast\" as VoteCastPage -> VoteCast\n}"
}