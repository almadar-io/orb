  "source": "",
  "lolo": "app std-slide-deck \"1.0.0\"\n\"std-slide-deck — generic presentation atom. An ordered list of slide nodes (`config.slides`, any render tree or @trait) shown one at a time, with a previous/next arrow on either side, a dot strip and a k / n counter underneath, and keyboard stepping through the host's KEY router (`config.nextKeys` / `config.prevKeys`, captured per `config.keymap`). The cursor clamps at either end unless `loop` is on. Each visit mounts the slide fresh, so its own entry animations replay. Carries no content or visual style: a realization supplies the slides and restyles via `bodyContent`. The default body picks the slide inside a mapped-children lambda, which expands static slides only; a deck whose slides hold stateful traits (forms, live lists) overrides `bodyContent` with one `presence` per slide gated on `@entity.slideIndex`. Every move emits SLIDE_CHANGED for speaker notes, timers or analytics.\"\n;; @capabilities \"slide deck, presentation, pitch deck, keynote-style slideshow, previous and next slide arrows, arrow-key slide navigation, jump to slide from dots, slide counter\"\n;; @synonyms \"slideshow, deck, presentation, slides, pitch\"\norbital SlideDeckOrbital {\n  entity SlideDeck [runtime] {\n    id : string!\n    slideIndex : number @description \"Zero-based index of the slide currently shown.\" @synonyms \"current slide, cursor, position\" = 0\n  }\n\n  trait SlideDeckPresenter -> @rebindable SlideDeck [interaction, instance] {\n    initial: presenting\n\n    state presenting {\n      INIT -> presenting\n        (set @entity.slideIndex @config.startIndex)\n        (render-ui main @config.bodyContent)\n      GO_TO -> presenting\n        (set @entity.slideIndex ?index)\n        (emit SLIDE_CHANGED { index: @entity.slideIndex })\n        (render-ui main @config.bodyContent)\n    }\n\n    emits {\n      SLIDE_CHANGED -> external {\n        index : number!\n      }\n        @description \"The deck moved to a new slide (zero-based index).\"\n        @synonyms \"slide shown, advanced, went back\"\n        @tier \"domain\"\n    }\n\n    listens {\n      GO_TO {\n        index : number!\n      }\n        @description \"Show a zero-based slide index. The arrows and dots send the already-bounded target; a remote or table of contents can send any index.\"\n        @synonyms \"jump, seek, next slide, previous slide, select slide\"\n        @tier \"domain\"\n    }\n\n    config {\n      slides : [trait] = []\n        @label \"Slides\"\n        @description \"Ordered slide nodes; each entry is a render tree or a @trait reference and is shown one at a time.\"\n        @tier \"domain\"\n      startIndex : number = 0\n        @label \"Start slide\"\n        @description \"Zero-based slide shown on first render; clamped to the deck.\"\n        @tier \"presentation\"\n      loop : boolean = false\n        @label \"Loop\"\n        @description \"Wrap from the last slide to the first (and back) instead of stopping at either end.\"\n        @tier \"presentation\"\n      showArrows : boolean = true\n        @label \"Show arrows\"\n        @description \"Previous/next buttons on the left and right of the slide.\"\n        @tier \"presentation\"\n      showProgress : boolean = true\n        @label \"Show progress\"\n        @description \"Dot strip and k / n counter under the slide; dots jump to their slide.\"\n        @tier \"presentation\"\n      stageMinHeight : string = \"70vh\"\n        @label \"Stage height\"\n        @description \"Minimum height of the slide stage (any CSS length, e.g. 70vh or 640px); the slide is centred vertically inside it so short and tall slides share one frame.\"\n        @tier \"presentation\"\n      prevIcon : icon = chevron-left\n        @label \"Previous icon\"\n        @tier \"presentation\"\n      nextIcon : icon = chevron-right\n        @label \"Next icon\"\n        @tier \"presentation\"\n      bodyContent : render-ui = {\n        type: stack\n        direction: vertical\n        gap: md\n        className: \"w-full\"\n        children: [{\n          type: stack\n          direction: horizontal\n          gap: md\n          align: center\n          children: [\n            (array/map [(array/len @config.slides)] (fn n (if @config.showArrows { type: button, variant: ghost, size: lg, icon: @config.prevIcon, action: GO_TO, actionPayload: { index: (if @config.loop (math/wrap (- @entity.slideIndex 1) 0 @n) (math/max 0 (- @entity.slideIndex 1))) }, disabled: (and (== @config.loop false) (<= @entity.slideIndex 0)) } null))),\n            { type: center, className: \"flex-1 min-w-0\", minHeight: @config.stageMinHeight, children: (array/map [@entity.slideIndex] (fn i { type: box, className: \"w-full\", children: [(array/nth @config.slides @i)] })) },\n            (array/map [(array/len @config.slides)] (fn n (if @config.showArrows { type: button, variant: ghost, size: lg, icon: @config.nextIcon, action: GO_TO, actionPayload: { index: (if @config.loop (math/wrap (+ @entity.slideIndex 1) 0 @n) (math/min (- @n 1) (+ @entity.slideIndex 1))) }, disabled: (and (== @config.loop false) (>= @entity.slideIndex (- @n 1))) } null)))\n          ]\n        }, (if @config.showProgress {\n          type: stack\n          direction: horizontal\n          gap: md\n          align: center\n          justify: center\n          children: (array/map [(array/len @config.slides)] (fn n {\n            type: stack\n            direction: horizontal\n            gap: md\n            align: center\n            children: [\n              { type: progress-dots, count: @n, currentIndex: @entity.slideIndex, onDotClick: GO_TO, size: sm },\n              { type: typography, variant: caption, color: muted, content: (str/concat \"\" (+ @entity.slideIndex 1) \" / \" @n) }\n            ]\n          }))\n        } null)]\n      }\n        @label \"Body content tree\"\n        @description \"Render-ui tree for the deck. Default: slide centred between previous/next arrows, dot strip and counter below. A realization overrides this to restyle (full-bleed, bottom bar, no chrome) while keeping the same cursor, keys and emits.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/slide-deck\" as SlideDeckPage -> SlideDeckPresenter\n}\n"
}