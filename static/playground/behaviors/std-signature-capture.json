  "source": "",
  "lolo": "app std-signature-capture \"2.0.0\"\n\"std-signature-capture — a drawn-signature pad. The signer draws, clears, or submits; on submit the signature persists and the atom emits SignatureSubmitted. One job: capture a signature and report when done.\"\norbital SignatureCaptureOrbital {\n    type SignatureLoaded = Event { data : [Signature] } \"Fired when the signer's prior signature (if any) loads\"\n\n    type SignatureLoadFailed = Event { error : string, code : string } \"Fired when the prior-signature load fails\"\n\n    type SignatureSubmitted = Event Signature \"Fired after a signature persists successfully\"\n\n    type SignatureSubmitFailed = Event { error : string, code : string } \"Fired when persisting a signature fails\"\n\n  entity Signature [persistent: signatures] {\n    id : string!\n    targetId : string! @description \"Unique identifier for the target of the signature.\" @synonyms \"referenceId, associatedId, target\"\n    targetType : string! @description \"Specifies the type of target associated with the signature.\" @synonyms \"type, kind, category\"\n    signerName : string! @description \"The name of the person providing the signature.\" @synonyms \"name, user, person\"\n    signatureDataUrl : string! @description \"Encoded signature image data, typically a data URL.\" @synonyms \"signature image, image data, signature representation\"\n    signedAt : datetime @description \"Timestamp indicating when the signature was captured.\" @synonyms \"date, time, timestamp\"\n    ipAddress : string @description \"The client's IP address during signature capture.\" @synonyms \"client IP, source IP, originating IP\"\n  }\n\n  trait SignatureCapture -> Signature [interaction, instance] {\n    initial: loading\n\n    state loading {\n      INIT -> loading\n        (fetch Signature {\n          emit: { failure: SignatureLoadFailed, success: SignatureLoaded }\n        })\n        (render-ui main {\n          align: center\n          children: [{ type: spinner }, {\n            color: muted\n            content: \"Loading…\"\n            type: typography\n            variant: caption\n          }]\n          className: py-12\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      SignatureLoaded -> idle\n        (render-ui main {\n          children: [{\n            content: @config.title\n            type: typography\n            variant: h3\n          }, {\n            color: muted\n            content: @config.instructions\n            type: typography\n            variant: caption\n          }, {\n            onChange: CHANGE\n            type: signature-pad\n            value: @entity.signatureDataUrl\n          }, {\n            children: [{\n              action: CLEAR\n              icon: trash\n              label: Clear\n              type: button\n              variant: secondary\n            }, {\n              action: SUBMIT\n              icon: send\n              label: Submit\n              type: button\n              variant: primary\n            }]\n            direction: horizontal\n            gap: sm\n            type: stack\n          }]\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      SignatureLoadFailed -> idle\n        (render-ui main {\n          children: [{\n            content: @config.title\n            type: typography\n            variant: h3\n          }, {\n            color: muted\n            content: @config.instructions\n            type: typography\n            variant: caption\n          }, {\n            onChange: CHANGE\n            type: signature-pad\n            value: @entity.signatureDataUrl\n          }, {\n            children: [{\n              action: CLEAR\n              icon: trash\n              label: Clear\n              type: button\n              variant: secondary\n            }, {\n              action: SUBMIT\n              icon: send\n              label: Submit\n              type: button\n              variant: primary\n            }]\n            direction: horizontal\n            gap: sm\n            type: stack\n          }]\n          direction: vertical\n          gap: md\n          type: stack\n        })\n    }\n\n    state idle {\n      ;; Revisit re-entry: refetch without repainting the already-drawn pad.\n      INIT -> loading\n        (fetch Signature {\n          emit: { failure: SignatureLoadFailed, success: SignatureLoaded }\n        })\n      CHANGE -> idle\n        (set @entity.signatureDataUrl ?dataUrl)\n      CLEAR -> idle\n        (set @entity.signatureDataUrl \"\")\n        (render-ui main {\n          children: [{\n            content: @config.title\n            type: typography\n            variant: h3\n          }, {\n            color: muted\n            content: @config.instructions\n            type: typography\n            variant: caption\n          }, {\n            onChange: CHANGE\n            type: signature-pad\n            value: @entity.signatureDataUrl\n          }, {\n            children: [{\n              action: CLEAR\n              icon: trash\n              label: Clear\n              type: button\n              variant: secondary\n            }, {\n              action: SUBMIT\n              icon: send\n              label: Submit\n              type: button\n              variant: primary\n            }]\n            direction: horizontal\n            gap: sm\n            type: stack\n          }]\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      SUBMIT -> submitting\n        (persist create Signature ?data {\n          emit: { failure: SignatureSubmitFailed, success: SignatureSubmitted }\n        })\n        (render-ui main {\n          align: center\n          children: [{ type: spinner }, {\n            color: muted\n            content: \"Submitting your signature…\"\n            type: typography\n            variant: caption\n          }]\n          className: py-12\n          direction: vertical\n          gap: md\n          type: stack\n        })\n    }\n\n    state submitting {\n      SignatureSubmitted -> submitted\n        (render-ui main {\n          align: center\n          children: [{\n            color: success\n            name: check-circle\n            type: icon\n          }, {\n            content: \"Signature recorded. Thank you.\"\n            type: typography\n            variant: h3\n          }]\n          className: py-12\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      SignatureSubmitFailed -> idle\n        (render-ui main {\n          message: ?error\n          type: alert\n          variant: error\n        })\n    }\n\n    state submitted {\n      INIT -> idle\n        (set @entity.signatureDataUrl \"\")\n        (render-ui main {\n          children: [{\n            content: @config.title\n            type: typography\n            variant: h3\n          }, {\n            color: muted\n            content: @config.instructions\n            type: typography\n            variant: caption\n          }, {\n            onChange: CHANGE\n            type: signature-pad\n            value: @entity.signatureDataUrl\n          }, {\n            children: [{\n              action: CLEAR\n              icon: trash\n              label: Clear\n              type: button\n              variant: secondary\n            }, {\n              action: SUBMIT\n              icon: send\n              label: Submit\n              type: button\n              variant: primary\n            }]\n            direction: horizontal\n            gap: sm\n            type: stack\n          }]\n          direction: vertical\n          gap: md\n          type: stack\n        })\n    }\n\n    emits {\n      CHANGE {\n        dataUrl : string!\n      }\n        @description \"Indicates a change in the signature drawing.\"\n        @synonyms \"update, modify, alter\"\n        @tier \"presentation\"\n      SUBMIT {\n        data : @entity!\n      }\n        @description \"Signals the signature capture process is complete.\"\n        @synonyms \"done, finalized, confirmed, saved\"\n        @tier \"domain\"\n      CLEAR\n        @description \"Signals the signature pad has been cleared.\"\n        @synonyms \"reset, erase, remove\"\n        @tier \"domain\"\n      SignatureLoaded {\n        data : [Signature]\n      }\n        @description \"Indicates the signature pad is ready for use.\"\n        @synonyms \"ready, initialized, available\"\n        @tier \"domain\"\n      SignatureLoadFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates the signature data could not be loaded.\"\n        @synonyms \"load error, failed load, data error\"\n        @tier \"internal\"\n      SignatureSubmitted\n        @description \"Indicates a signature has been successfully captured and submitted.\"\n        @synonyms \"signed, finalized, completed\"\n        @tier \"domain\"\n      SignatureSubmitFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates signature submission failed.\"\n        @synonyms \"error, failure, rejected\"\n        @tier \"internal\"\n    }\n\n    listens {\n      CHANGE {\n        dataUrl : string!\n      }\n        @description \"Indicates a change in the signature drawing area.\"\n        @synonyms \"update, modify, redraw\"\n        @tier \"domain\"\n      SUBMIT {\n        data : @entity!\n      }\n        @description \"Indicates the signature capture process is complete.\"\n        @synonyms \"done, finalized, confirmed, saved\"\n        @tier \"domain\"\n      CLEAR\n        @description \"Indicates the signature area has been cleared.\"\n        @synonyms \"reset, erase, delete\"\n        @tier \"domain\"\n      SignatureLoaded {\n        data : [Signature]\n      }\n        @description \"Indicates the signature data has been successfully retrieved.\"\n        @synonyms \"loaded, fetched, retrieved, initialized\"\n        @tier \"internal\"\n      SignatureLoadFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates the signature data could not be loaded.\"\n        @synonyms \"error, failure, problem, unsuccessful\"\n        @tier \"internal\"\n      SignatureSubmitted\n        @description \"Indicates a signature has been successfully submitted.\"\n        @synonyms \"saved, finalized, confirmed\"\n        @tier \"domain\"\n      SignatureSubmitFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates signature submission failed; retry or review.\"\n        @synonyms \"error, failure, rejected, invalid\"\n        @tier \"internal\"\n    }\n\n    config {\n      title : string = \"Sign here\"\n        @label \"Pad title\"\n        @description \"Heading shown above the signature pad\"\n        @tier \"presentation\"\n      instructions : string = \"Use your finger or stylus to sign below\"\n        @label \"Instructions\"\n        @description \"Helper text shown to the signer above the pad\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/signatures/capture\" as SignatureCapturePage -> SignatureCapture\n}"
}