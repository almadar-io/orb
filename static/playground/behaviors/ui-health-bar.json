  "source": "",
  "lolo": "app ui-health-bar \"1.0.0\"\n\"HealthBar — UI factory (1:1 with the @almadar/ui health-bar pattern).\"\norbital HealthBarOrbital {\n  type HealthBarFrameAsset = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\" | \"4:1\" | \"5:3\" | \"1:2\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n  type HealthBarFillAsset = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\" | \"4:1\" | \"5:3\" | \"1:2\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n\n  entity HealthBarItem [runtime] {\n    id : string!\n  }\n\n  trait HealthBarRender -> @rebindable HealthBarItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          current: @config.current\n          max: @config.max\n          format: @config.format\n          level: @config.level\n          showLabel: @config.showLabel\n          labelSuffix: @config.labelSuffix\n          size: @config.size\n          className: @config.className\n          animated: @config.animated\n          frameAsset: @config.frameAsset\n          fillAsset: @config.fillAsset\n          type: health-bar\n        })\n    }\n\n    config {\n      current : number = 3\n        @label \"Current\"\n        @description \"Current value\"\n        @tier \"presentation\"\n      max : number = 5\n        @label \"Max\"\n        @description \"Maximum value\"\n        @tier \"presentation\"\n      format : \"hearts\" | \"bar\" | \"numeric\" | \"progress\" = hearts\n        @label \"Format\"\n        @description \"Display format. - `hearts` / `bar` / `numeric` — health display - `progress` — XP / generic progress bar with optional level badge and value label\"\n        @tier \"presentation\"\n      level : number\n        @label \"Level\"\n        @description \"Current level — shown as 'Lv.N' badge when format='progress'\"\n        @tier \"presentation\"\n      showLabel : boolean = true\n        @label \"Show Label\"\n        @description \"Show value label below bar when format='progress'\"\n        @tier \"presentation\"\n      labelSuffix : string\n        @label \"Label Suffix\"\n        @description \"Label suffix shown next to the value (e.g. 'XP') when showLabel=true\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Size variant\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      animated : boolean = true\n        @label \"Animated\"\n        @description \"Animation on change\"\n        @tier \"presentation\"\n      frameAsset : HealthBarFrameAsset\n        @label \"Frame Asset\"\n        @description \"Sprite image used as the bar track/frame border for bar/progress formats. Falls back to CSS rounded bg-muted.\"\n        @tier \"presentation\"\n      fillAsset : HealthBarFillAsset\n        @label \"Fill Asset\"\n        @description \"Sprite image tiled across the filled portion of bar/progress formats. Falls back to CSS color gradient.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/health-bar\" as HealthBarPage -> HealthBarRender\n}\n"
}