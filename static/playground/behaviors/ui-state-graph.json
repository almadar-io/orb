{
  "name": "ui-state-graph",
  "description": "StateGraph — UI factory (1:1 with the @almadar/ui state-graph pattern).",
  "level": "molecule",
  "topic": "ui/game/2d",
  "schema": {
    "name": "ui-state-graph",
    "version": "1.0.0",
    "description": "StateGraph — UI factory (1:1 with the @almadar/ui state-graph pattern).",
    "orbitals": [
      {
        "name": "StateGraphOrbital",
        "entity": {
          "name": "StateGraphItem",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            }
          ]
        },
        "traits": [
          {
            "name": "StateGraphRender",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": []
            },
            "category": "interaction",
            "linkedEntity": "StateGraphItem",
            "emits": [
              {
                "event": "NODE_CLICK",
                "description": "Emits UI:{nodeClickEvent} with { stateId } when a node is clicked.",
                "tier": "essential",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "id",
                    "type": "string"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "NODE_CLICK",
                  "name": "Node Click",
                  "description": "Emits UI:{nodeClickEvent} with { stateId } when a node is clicked.",
                  "tier": "essential",
                  "payloadSchema": [
                    {
                      "name": "id",
                      "type": "string"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "render-ui",
                      "main",
                      {
                        "transitions": [],
                        "type": "state-graph",
                        "width": 500,
                        "className": "",
                        "currentState": "Current State",
                        "initialState": "Initial State",
                        "height": 400,
                        "selectedState": "Selected State",
                        "addingFrom": "Adding From",
                        "nodeClickEvent": "NODE_CLICK",
                        "states": [
                          "list",
                          "Item",
                          "Item 2"
                        ]
                      }
                    ]
                  ]
                }
              ]
            },
            "config": {
              "addingFrom": {
                "type": "string",
                "default": "Adding From",
                "label": "Adding From",
                "description": "When set, the graph is in 'pick a target' mode from this state.",
                "tier": "presentation"
              },
              "initialState": {
                "type": "string",
                "default": "Initial State",
                "label": "Initial State",
                "description": "The machine's initial state (ring-marked).",
                "tier": "presentation"
              },
              "selectedState": {
                "type": "string",
                "default": "Selected State",
                "label": "Selected State",
                "description": "State the player has selected (first click).",
                "tier": "presentation"
              },
              "width": {
                "type": "number",
                "default": 500,
                "label": "Width",
                "description": "Graph canvas width.",
                "tier": "presentation"
              },
              "className": {
                "type": "string",
                "default": "",
                "label": "Class Name",
                "description": "className prop",
                "tier": "presentation"
              },
              "states": {
                "type": "[string]",
                "default": [
                  "Item",
                  "Item 2"
                ],
                "label": "States",
                "description": "All states in the machine (node labels).",
                "tier": "presentation",
                "items": {
                  "type": "string"
                }
              },
              "currentState": {
                "type": "string",
                "default": "Current State",
                "label": "Current State",
                "description": "State highlighted as current (test playback / initial).",
                "tier": "presentation"
              },
              "height": {
                "type": "number",
                "default": 400,
                "label": "Height",
                "description": "Graph canvas height.",
                "tier": "presentation"
              },
              "transitions": {
                "type": "[StateGraphTransitionsItem]",
                "default": [],
                "label": "Transitions",
                "description": "Player-built transitions rendered as arrows.",
                "tier": "presentation",
                "items": {
                  "type": "object",
                  "properties": {
                    "guardHint": {
                      "name": "guardHint",
                      "type": "string",
                      "required": false
                    },
                    "event": {
                      "name": "event",
                      "type": "string",
                      "required": true
                    },
                    "from": {
                      "name": "from",
                      "type": "string",
                      "required": true
                    },
                    "to": {
                      "name": "to",
                      "type": "string",
                      "required": true
                    }
                  }
                }
              }
            },
            "scope": "instance"
          }
        ],
        "pages": [
          {
            "name": "StateGraphPage",
            "path": "/state-graph",
            "traits": [
              {
                "ref": "StateGraphRender"
              }
            ]
          }
        ]
      }
    ],
    "_metadata": {
      "configProvenance": {
        "StateGraphOrbital": [
          {
            "trait": "StateGraphRender",
            "patternPath": "root",
            "prop": "transitions",
            "knob": "transitions"
          },
          {
            "trait": "StateGraphRender",
            "patternPath": "root",
            "prop": "width",
            "knob": "width"
          },
          {
            "trait": "StateGraphRender",
            "patternPath": "root",
            "prop": "className",
            "knob": "className"
          },
          {
            "trait": "StateGraphRender",
            "patternPath": "root",
            "prop": "currentState",
            "knob": "currentState"
          },
          {
            "trait": "StateGraphRender",
            "patternPath": "root",
            "prop": "initialState",
            "knob": "initialState"
          },
          {
            "trait": "StateGraphRender",
            "patternPath": "root",
            "prop": "height",
            "knob": "height"
          },
          {
            "trait": "StateGraphRender",
            "patternPath": "root",
            "prop": "selectedState",
            "knob": "selectedState"
          },
          {
            "trait": "StateGraphRender",
            "patternPath": "root",
            "prop": "addingFrom",
            "knob": "addingFrom"
          },
          {
            "trait": "StateGraphRender",
            "patternPath": "root",
            "prop": "states",
            "knob": "states"
          }
        ]
      }
    }
  },
  "source": "",
  "lolo": ""
}