  "source": "",
  "lolo": "app ui-state-graph \"1.0.0\"\n\"StateGraph — UI factory (1:1 with the @almadar/ui state-graph pattern).\"\norbital StateGraphOrbital {\n  type StateGraphTransitionsItem = {\n    from : string!\n    to : string!\n    event : string!\n    guardHint : string\n  }\n\n  entity StateGraphItem [runtime] {\n    id : string!\n  }\n\n  trait StateGraphRender -> @rebindable StateGraphItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          states: @config.states\n          transitions: @config.transitions\n          currentState: @config.currentState\n          selectedState: @config.selectedState\n          addingFrom: @config.addingFrom\n          initialState: @config.initialState\n          width: @config.width\n          height: @config.height\n          nodeClickEvent: @config.nodeClickEvent\n          className: @config.className\n          type: state-graph\n        })\n    }\n\n    emits {\n      @config.nodeClickEvent -> external {\n        stateId : string!\n      }\n        @description \"Emits UI:{nodeClickEvent} with { stateId } when a node is clicked.\"\n        @tier \"essential\"\n    }\n\n    config {\n      states : [string] = [\"Item\", \"Item 2\"]\n        @label \"States\"\n        @description \"All states in the machine (node labels).\"\n        @tier \"presentation\"\n      transitions : [StateGraphTransitionsItem] = []\n        @label \"Transitions\"\n        @description \"Player-built transitions rendered as arrows.\"\n        @tier \"presentation\"\n      currentState : string\n        @label \"Current State\"\n        @description \"State highlighted as current (test playback / initial).\"\n        @tier \"presentation\"\n      selectedState : string\n        @label \"Selected State\"\n        @description \"State the player has selected (first click).\"\n        @tier \"presentation\"\n      addingFrom : string\n        @label \"Adding From\"\n        @description \"When set, the graph is in 'pick a target' mode from this state.\"\n        @tier \"presentation\"\n      initialState : string\n        @label \"Initial State\"\n        @description \"The machine's initial state (ring-marked).\"\n        @tier \"presentation\"\n      width : number = 500\n        @label \"Width\"\n        @description \"Graph canvas width.\"\n        @tier \"presentation\"\n      height : number = 400\n        @label \"Height\"\n        @description \"Graph canvas height.\"\n        @tier \"presentation\"\n      nodeClickEvent : event = \"NODE_CLICK\"\n        @label \"Node Click Event\"\n        @description \"Emits UI:{nodeClickEvent} with { stateId } when a node is clicked.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/state-graph\" as StateGraphPage -> StateGraphRender\n}\n"
}