{
  "name": "std-algo-selectionsort",
  "description": "Selection-sort engine — one scan-compare or swap step per tick over a bar array on algorithm-canvas; composed by a learning orbital via `uses`.",
  "level": "atom",
  "topic": "ui/learning",
  "schema": {
    "name": "std-algo-selectionsort",
    "version": "1.0.0",
    "description": "Selection-sort engine — one scan-compare or swap step per tick over a bar array on algorithm-canvas; composed by a learning orbital via `uses`.",
    "orbitals": [
      {
        "name": "SelectionSortEngineOrbital",
        "entity": {
          "name": "SelectionScene",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "bars",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "name": "value",
                    "type": "number",
                    "required": true
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  }
                }
              }
            },
            {
              "name": "i",
              "type": "number",
              "default": 0
            },
            {
              "name": "j",
              "type": "number",
              "default": 1
            },
            {
              "name": "m",
              "type": "number",
              "default": 0
            },
            {
              "name": "scanning",
              "type": "boolean",
              "default": true
            },
            {
              "name": "done",
              "type": "boolean",
              "default": false
            },
            {
              "name": "running",
              "type": "boolean",
              "default": true
            }
          ]
        },
        "traits": [
          {
            "name": "SelectionSortSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "bars",
                "done",
                "i",
                "j",
                "m",
                "running",
                "scanning"
              ]
            },
            "category": "interaction",
            "linkedEntity": "SelectionScene",
            "emits": [
              {
                "event": "BARS_UPDATED",
                "description": "The current bar array each step — a composed listener (a mirror canvas, a readout) can subscribe; a harmless no-op standalone.",
                "synonyms": "tick, frame, step, redraw, compare, select, swap",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "bars",
                    "type": "[AlgoBar]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "BARS_UPDATED",
                  "name": "Bars Updated",
                  "description": "The current bar array each step — a composed listener (a mirror canvas, a readout) can subscribe; a harmless no-op standalone.",
                  "synonyms": "tick, frame, step, redraw, compare, select, swap",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "bars",
                      "type": "[AlgoBar]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.bars",
                      [
                        {
                          "value": 5,
                          "color": "#3b82f6",
                          "label": "5"
                        },
                        {
                          "color": "#3b82f6",
                          "label": "2",
                          "value": 2
                        },
                        {
                          "value": 8,
                          "color": "#3b82f6",
                          "label": "8"
                        },
                        {
                          "color": "#3b82f6",
                          "value": 1,
                          "label": "1"
                        },
                        {
                          "value": 9,
                          "label": "9",
                          "color": "#3b82f6"
                        },
                        {
                          "value": 3,
                          "label": "3",
                          "color": "#3b82f6"
                        },
                        {
                          "color": "#3b82f6",
                          "value": 7,
                          "label": "7"
                        },
                        {
                          "label": "4",
                          "color": "#3b82f6",
                          "value": 4
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "height": 400,
                        "type": "algorithm-canvas",
                        "bars": "@entity.bars",
                        "width": 600,
                        "backgroundColor": "#f8fafc"
                      }
                    ],
                    [
                      "emit",
                      "BARS_UPDATED",
                      {
                        "bars": "@entity.bars"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "selectionTick",
                "interval": 300,
                "guard": [
                  "and",
                  "@entity.running",
                  [
                    "not",
                    "@entity.done"
                  ]
                ],
                "effects": [
                  [
                    "set",
                    "@entity.scanning",
                    [
                      "<",
                      "@entity.j",
                      [
                        "array/len",
                        "@entity.bars"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.bars",
                    [
                      "let",
                      [
                        [
                          "a",
                          [
                            "array/nth",
                            "@entity.bars",
                            "@entity.i"
                          ]
                        ],
                        [
                          "b",
                          [
                            "array/nth",
                            "@entity.bars",
                            "@entity.m"
                          ]
                        ]
                      ],
                      [
                        "array/map",
                        "@entity.bars",
                        [
                          "object/merge",
                          "@item",
                          {
                            "value": [
                              "if",
                              [
                                "and",
                                [
                                  "not",
                                  "@entity.scanning"
                                ],
                                [
                                  "==",
                                  "@index",
                                  "@entity.i"
                                ]
                              ],
                              [
                                "object/get",
                                "@b",
                                "value"
                              ],
                              [
                                "if",
                                [
                                  "and",
                                  [
                                    "not",
                                    "@entity.scanning"
                                  ],
                                  [
                                    "==",
                                    "@index",
                                    "@entity.m"
                                  ]
                                ],
                                [
                                  "object/get",
                                  "@a",
                                  "value"
                                ],
                                [
                                  "object/get",
                                  "@item",
                                  "value"
                                ]
                              ]
                            ],
                            "color": [
                              "if",
                              [
                                "<",
                                "@index",
                                "@entity.i"
                              ],
                              "#22c55e",
                              [
                                "if",
                                [
                                  "==",
                                  "@index",
                                  "@entity.m"
                                ],
                                "#f59e0b",
                                [
                                  "if",
                                  [
                                    "==",
                                    "@index",
                                    "@entity.j"
                                  ],
                                  "#a855f7",
                                  "#3b82f6"
                                ]
                              ]
                            ]
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.m",
                    [
                      "if",
                      "@entity.scanning",
                      [
                        "if",
                        [
                          "<",
                          [
                            "object/get",
                            [
                              "array/nth",
                              "@entity.bars",
                              "@entity.j"
                            ],
                            "value"
                          ],
                          [
                            "object/get",
                            [
                              "array/nth",
                              "@entity.bars",
                              "@entity.m"
                            ],
                            "value"
                          ]
                        ],
                        "@entity.j",
                        "@entity.m"
                      ],
                      [
                        "+",
                        "@entity.i",
                        1
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.i",
                    [
                      "if",
                      "@entity.scanning",
                      "@entity.i",
                      [
                        "+",
                        "@entity.i",
                        1
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.j",
                    [
                      "if",
                      "@entity.scanning",
                      [
                        "+",
                        "@entity.j",
                        1
                      ],
                      [
                        "+",
                        "@entity.i",
                        1
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.done",
                    [
                      ">=",
                      "@entity.i",
                      [
                        "-",
                        [
                          "array/len",
                          "@entity.bars"
                        ],
                        1
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "algorithm-canvas",
                      "backgroundColor": "#f8fafc",
                      "height": 400,
                      "width": 600,
                      "bars": "@entity.bars"
                    }
                  ],
                  [
                    "emit",
                    "BARS_UPDATED",
                    {
                      "bars": "@entity.bars"
                    }
                  ]
                ]
              }
            ],
            "config": {
              "width": {
                "type": "number",
                "default": 600,
                "label": "Width",
                "description": "Canvas width in pixels.",
                "tier": "presentation"
              },
              "bars": {
                "type": "[AlgoBar]",
                "default": [
                  {
                    "value": 5,
                    "color": "#3b82f6",
                    "label": "5"
                  },
                  {
                    "color": "#3b82f6",
                    "label": "2",
                    "value": 2
                  },
                  {
                    "value": 8,
                    "color": "#3b82f6",
                    "label": "8"
                  },
                  {
                    "color": "#3b82f6",
                    "value": 1,
                    "label": "1"
                  },
                  {
                    "value": 9,
                    "label": "9",
                    "color": "#3b82f6"
                  },
                  {
                    "value": 3,
                    "label": "3",
                    "color": "#3b82f6"
                  },
                  {
                    "color": "#3b82f6",
                    "value": 7,
                    "label": "7"
                  },
                  {
                    "label": "4",
                    "color": "#3b82f6",
                    "value": 4
                  }
                ],
                "label": "Bars",
                "description": "Initial unsorted array; each bar's height is proportional to its value.",
                "tier": "domain",
                "items": {
                  "type": "object",
                  "properties": {
                    "color": {
                      "name": "color",
                      "type": "string",
                      "required": false
                    },
                    "label": {
                      "name": "label",
                      "type": "string",
                      "required": false
                    },
                    "value": {
                      "name": "value",
                      "type": "number",
                      "required": true
                    }
                  }
                }
              },
              "height": {
                "type": "number",
                "default": 400,
                "label": "Height",
                "description": "Canvas height in pixels.",
                "tier": "presentation"
              },
              "running": {
                "type": "boolean",
                "default": true,
                "label": "Running",
                "description": "When true the tick performs one scan-compare or swap step; toggle to start/pause the sort.",
                "tier": "domain"
              },
              "backgroundColor": {
                "type": "string",
                "default": "#f8fafc",
                "label": "Background Color",
                "description": "Canvas background color.",
                "tier": "presentation"
              }
            },
            "scope": "instance"
          }
        ],
        "pages": [
          {
            "name": "SelectionSortEnginePage",
            "path": "/algo-selectionsort",
            "traits": [
              {
                "ref": "SelectionSortSim"
              }
            ]
          }
        ]
      }
    ],
    "_metadata": {
      "configProvenance": {
        "SelectionSortEngineOrbital": [
          {
            "trait": "SelectionSortSim",
            "patternPath": "root",
            "prop": "height",
            "knob": "height"
          },
          {
            "trait": "SelectionSortSim",
            "patternPath": "root",
            "prop": "width",
            "knob": "width"
          },
          {
            "trait": "SelectionSortSim",
            "patternPath": "root",
            "prop": "backgroundColor",
            "knob": "backgroundColor"
          },
          {
            "trait": "SelectionSortSim",
            "patternPath": "root",
            "prop": "backgroundColor",
            "knob": "backgroundColor"
          },
          {
            "trait": "SelectionSortSim",
            "patternPath": "root",
            "prop": "height",
            "knob": "height"
          },
          {
            "trait": "SelectionSortSim",
            "patternPath": "root",
            "prop": "width",
            "knob": "width"
          }
        ]
      }
    }
  },
  "source": "",
  "lolo": ""
}