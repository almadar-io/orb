  "source": "",
  "lolo": "app std-marketing-article \"1.0.0\"\n\"Article section atom for marketing pages. Renders a centered prose block with title and rich content. Pick for about pages, mission statements, and blog-style content.\"\n;; Config-driven article section using the `article-section` marketing pattern.\n;; The atom renders immediately on INIT with no fetch required.\norbital ArticleItemOrbital {\n  uses ArticleSection from \"std/behaviors/ui-article-section\"\n\n  entity ArticleItem [runtime] {\n    id : string!\n  }\n\n  trait ArticleItemArticle = ArticleSection.traits.ArticleSectionRender -> ArticleItem {\n    config {\n      children: [{ content: @config.content, type: typography }]\n      title : string = \"Our Mission\"\n        @label \"Title\"\n        @description \"Section headline\"\n        @tier \"presentation\"\n      content : string = \"We believe building software should be as natural as describing it.\"\n        @label \"Content\"\n        @description \"Body text rendered as markdown\"\n        @tier \"presentation\"\n      maxWidth : string = lg\n        @label \"Max Width\"\n        @description \"Content width constraint\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/article\" as ArticleItemArticlePage -> ArticleItemArticle\n}"
}