  "source": "",
  "lolo": "app std-related \"1.1.0\"\n\"std-related as a Function\"\n;;\n;; Relation-rendering atom. INIT loads the full RelatedItem collection\n;; unfiltered (unchanged default). A consumer that wants the list scoped to\n;; one parent document sets `relationField` (the RelatedItem column that\n;; holds the parent key) and redirects its own \"document opened\" signal to\n;; SHOW_RELATED { key } in a `listens` override — the atom then fetches only\n;; rows whose relationField equals key. Each row is clickable: it emits\n;; SELECT_RELATED { id, name } for a parent molecule (e.g.\n;; std-related-master-detail) to drive a detail panel.\n;;\n;; Paired with std-browse via @trait.X this gives a one-line master-detail\n;; layout: hstack [ @trait.ParentList, @trait.ParentRelated ].\norbital RelatedItemOrbital {\n    type RelatedItemLoaded = Event { data : [RelatedItem] } \"Fired when RelatedItem finishes loading; payload.data holds the list\"\n\n    type RelatedItemLoadFailed = Event { error : string, code : string } \"Fired when RelatedItem fails to load\"\n\n    type ShowRelated = Event { key : string! } \"Fired to scope the related fetch to rows whose relationField equals key\"\n\n  entity RelatedItem [persistent: relateditems] {\n    id : string!\n    name : string @description \"The identifier or designation for the related item.\" @synonyms \"title, label, identifier\"\n  }\n\n  trait RelatedItemList -> @rebindable RelatedItem [interaction, collection] {\n    initial: loading\n\n    state loading {\n      INIT -> loading\n        (fetch RelatedItem {\n          emit: { failure: RelatedItemLoadFailed, success: RelatedItemLoaded }\n        })\n        (render-ui main {\n          align: center\n          children: [{ type: spinner }, {\n            color: muted\n            content: \"Loading related…\"\n            type: typography\n            variant: caption\n          }]\n          className: py-8\n          direction: vertical\n          gap: sm\n          type: stack\n        })\n      SHOW_RELATED -> loading\n        (fetch RelatedItem {\n          emit: { failure: RelatedItemLoadFailed, success: RelatedItemLoaded }\n          filter: (or [\"=\", @config.relationField, \"\"] [\"=\", (object/get @entity @config.relationField), ?key])\n        })\n        (render-ui main {\n          align: center\n          children: [{ type: spinner }, {\n            color: muted\n            content: \"Loading related…\"\n            type: typography\n            variant: caption\n          }]\n          className: py-8\n          direction: vertical\n          gap: sm\n          type: stack\n        })\n      RelatedItemLoaded -> loaded\n        (render-ui main {\n          children: [{\n            align: center\n            children: [{ name: link, type: icon }, {\n              content: @config.title\n              type: typography\n              variant: h3\n            }]\n            direction: horizontal\n            gap: sm\n            type: stack\n          }, { type: divider }, {\n            entity: (array/map ?data (fn row { id: @row.id, name: (object/get @row @config.labelField) }))\n            fields: []\n            look: @config.tableLook\n            renderItem: (fn item {\n              align: center\n              children: [{\n                content: @item.name\n                type: typography\n                variant: body\n              }, {\n                action: SELECT_RELATED\n                actionPayload: { id: @item.id, name: @item.name }\n                icon: chevron-right\n                label: Open\n                size: sm\n                type: button\n                variant: ghost\n              }]\n              direction: horizontal\n              gap: xs\n              justify: between\n              type: stack\n            })\n            type: data-list\n          }]\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      RelatedItemLoadFailed -> error\n        (render-ui main {\n          align: center\n          children: [{\n            color: error\n            name: alert-triangle\n            type: icon\n          }, {\n            content: \"Failed to load related\"\n            type: typography\n            variant: body\n          }, {\n            color: muted\n            content: ?error\n            type: typography\n            variant: caption\n          }, {\n            action: RETRY\n            icon: rotate-ccw\n            label: Retry\n            type: button\n            variant: ghost\n          }]\n          className: py-8\n          direction: vertical\n          gap: sm\n          type: stack\n        })\n    }\n\n    state loaded {\n      INIT -> loading\n        (fetch RelatedItem {\n          emit: { failure: RelatedItemLoadFailed, success: RelatedItemLoaded }\n        })\n        (render-ui main { type: spinner })\n      SELECT_RELATED -> loaded\n        (set @entity.id ?id)\n      SHOW_RELATED -> loading\n        (fetch RelatedItem {\n          emit: { failure: RelatedItemLoadFailed, success: RelatedItemLoaded }\n          filter: (or [\"=\", @config.relationField, \"\"] [\"=\", (object/get @entity @config.relationField), ?key])\n        })\n        (render-ui main { type: spinner })\n    }\n\n    state error {\n      INIT -> loading\n        (fetch RelatedItem {\n          emit: { failure: RelatedItemLoadFailed, success: RelatedItemLoaded }\n        })\n        (render-ui main { type: spinner })\n      ;; the error screen's Retry button: INIT is lifecycle-only and the bus never\n      ;; delivers it, so the affordance must target a first-class user event\n      RETRY -> loading\n        (fetch RelatedItem {\n          emit: { failure: RelatedItemLoadFailed, success: RelatedItemLoaded }\n        })\n        (render-ui main { type: spinner })\n      SHOW_RELATED -> loading\n        (fetch RelatedItem {\n          emit: { failure: RelatedItemLoadFailed, success: RelatedItemLoaded }\n          filter: (or [\"=\", @config.relationField, \"\"] [\"=\", (object/get @entity @config.relationField), ?key])\n        })\n        (render-ui main { type: spinner })\n    }\n\n    emits {\n      RelatedItemLoaded\n        @description \"Signals that related items have been successfully loaded.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"domain\"\n      RelatedItemLoadFailed\n        @description \"Indicates failure to load related items.\"\n        @synonyms \"error, failure, problem, unsuccessful\"\n        @tier \"internal\"\n      SELECT_RELATED -> external {\n        id : string!\n        name : string\n      }\n        @description \"Signals a related item was selected to drive a detail view.\"\n        @synonyms \"select, choose, open, view\"\n        @tier \"domain\"\n    }\n\n    listens {\n      SELECT_RELATED {\n        id : string!\n        name : string\n      }\n        @description \"A related item was selected; the atom records it as the active row.\"\n        @synonyms \"select, choose, open, view\"\n        @tier \"domain\"\n      RelatedItemLoadFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates failure to load related items.\"\n        @synonyms \"error, failure, problem, unsuccessful\"\n        @tier \"internal\"\n      SHOW_RELATED {\n        key : string!\n      }\n        @description \"Scopes the related fetch to rows whose relationField equals key.\"\n        @synonyms \"scope, filter, focus, target\"\n        @tier \"domain\"\n    }\n\n    config {\n      title : string = Related\n        @label \"Section title\"\n        @description \"Heading shown above the related list.\"\n        @tier \"presentation\"\n      labelField : string = name\n        @label \"Which field labels each related row?\"\n        @description \"Name of the field on the (rebound) related row rendered as the row label and carried as SELECT_RELATED's name — set it to `title` (etc.) whenever the bound entity labels rows differently. The rows are mapped through this at render time, because a trait-level `fields {}` rename is declaration-only on the runtime path and every populated row used to render a blank label.\"\n        @tier \"presentation\"\n      relationField : string = \"\"\n        @label \"Relation field\"\n        @description \"RelatedItem field compared against SHOW_RELATED's key to scope the fetch to one parent document; empty renders the full unfiltered collection (default).\"\n        @tier \"domain\"\n      tableLook : \"dense\" | \"spacious\" | \"striped\" | \"borderless\" | \"card-rows\" = dense\n        @label \"Table look\"\n        @description \"Layer 2 visual treatment for the data table rendered by this atom.\"\n        @tier \"presentation\"\n    }\n  }\n\n  ;; consumer: parent molecule (e.g. std-related-master-detail) listens for SELECT_RELATED to drive a detail panel; a\n  ;; per-document scope forwards its \"opened\" event to SHOW_RELATED { key } via a listens override on relationField\n  page \"/related\" as Related -> RelatedItemList\n}"
}