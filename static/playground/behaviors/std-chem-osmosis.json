            "ticks": [
              {
                "name": "osmosisTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "set",
                    "@entity.atoms",
                    [
                      "array/map",
                      "@entity.atoms",
                      [
                        "fn",
                        "a",
                        [
                          "let",
                          [
                            [
                              "r",
                              [
                                "object/get",
                                "@a",
                                "radius"
                              ]
                            ],
                            [
                              "mx",
                              [
                                "/",
                                600,
                                2
                              ]
                            ],
                            [
                              "isWater",
                              [
                                "=",
                                [
                                  "object/get",
                                  "@a",
                                  "element"
                                ],
                                "W"
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "bias",
                                [
                                  "if",
                                  "@isWater",
                                  0.4,
                                  0
                                ]
                              ],
                              [
                                "loX",
                                [
                                  "if",
                                  "@isWater",
                                  "@r",
                                  [
                                    "+",
                                    "@mx",
                                    "@r"
                                  ]
                                ]
                              ],
                              [
                                "ny",
                                [
                                  "math/clamp",
                                  [
                                    "+",
                                    [
                                      "object/get",
                                      "@a",
                                      "y"
                                    ],
                                    [
                                      "-",
                                      [
                                        "*",
                                        [
                                          "math/random"
                                        ],
                                        6
                                      ],
                                      3
                                    ]
                                  ],
                                  "@r",
                                  [
                                    "-",
                                    400,
                                    "@r"
                                  ]
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "nx",
                                  [
                                    "math/clamp",
                                    [
                                      "+",
                                      [
                                        "+",
                                        [
                                          "object/get",
                                          "@a",
                                          "x"
                                        ],
                                        [
                                          "-",
                                          [
                                            "*",
                                            [
                                              "math/random"
                                            ],
                                            6
                                          ],
                                          3
                                        ]
                                      ],
                                      "@bias"
                                    ],
                                    "@loX",
                                    [
                                      "-",
                                      600,
                                      "@r"
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "object/merge",
                                "@a",
                                {
                                  "y": "@ny",
                                  "x": "@nx"
                                }
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
