  "source": "",
  "lolo": "app ui-floating-toolbar \"1.0.0\"\n\"FloatingToolbar — UI factory (1:1 with the @almadar/ui floating-toolbar pattern).\"\norbital FloatingToolbarOrbital {\n  type FloatingToolbarItemsItem = {\n    id : string!\n    icon : icon!\n    label : string!\n    event : string\n    action : string\n    actionPayload : Map string scalar\n    active : boolean\n    disabled : boolean\n    testId : string\n  }\n\n  entity FloatingToolbarItem [runtime] {\n    id : string!\n  }\n\n  trait FloatingToolbarRender -> @rebindable FloatingToolbarItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          items: @config.items\n          position: @config.position\n          children: @config.children\n          className: @config.className\n          type: floating-toolbar\n        })\n    }\n\n    config {\n      items : [FloatingToolbarItemsItem] = [{ id: \"Id\", icon: \"circle\", label: \"Label\", action: \"Action\", active: false, disabled: false, testId: \"Test Id\" }, { id: \"Id 2\", icon: \"circle\", label: \"Label 2\", action: \"Action 2\", active: true, disabled: true, testId: \"Test Id 2\" }]\n        @label \"Items\"\n        @description \"Tool items rendered as icon buttons\"\n        @tier \"presentation\"\n      position : \"bottom-center\" | \"bottom-left\" | \"bottom-right\" | \"top-center\" | \"top-left\" | \"top-right\" = \"bottom-center\"\n        @label \"Position\"\n        @description \"Strip position within the app frame.\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Custom cells appended after the items, separated by a divider\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes on the positioned root\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/floating-toolbar\" as FloatingToolbarPage -> FloatingToolbarRender\n}\n"
}