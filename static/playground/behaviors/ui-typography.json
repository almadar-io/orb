  "source": "",
  "lolo": "app ui-typography \"1.0.0\"\n\"Typography — UI factory (1:1 with the @almadar/ui typography pattern).\"\norbital TypographyOrbital {\n  entity TypographyItem [runtime] {\n    id : string!\n  }\n\n  trait TypographyRender -> @rebindable TypographyItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          variant: @config.variant\n          level: @config.level\n          color: @config.color\n          align: @config.align\n          weight: @config.weight\n          size: @config.size\n          truncate: @config.truncate\n          overflow: @config.overflow\n          className: @config.className\n          style: @config.style\n          format: @config.format\n          content: @config.content\n          children: @config.children\n          type: typography\n        })\n    }\n\n    config {\n      variant : \"h1\" | \"h2\" | \"h3\" | \"h4\" | \"h5\" | \"h6\" | \"heading\" | \"subheading\" | \"body1\" | \"body2\" | \"body\" | \"caption\" | \"overline\" | \"small\" | \"large\" | \"label\" = h1\n        @label \"Variant\"\n        @description \"Typography variant\"\n        @tier \"presentation\"\n      level : number\n        @label \"Level\"\n        @description \"Heading level (1-6) - alternative to variant for headings\"\n        @tier \"presentation\"\n      color : \"primary\" | \"secondary\" | \"muted\" | \"error\" | \"success\" | \"warning\" | \"inherit\" = primary\n        @label \"Color\"\n        @description \"Text color\"\n        @tier \"presentation\"\n      align : \"left\" | \"center\" | \"right\" = left\n        @label \"Align\"\n        @description \"Text alignment\"\n        @tier \"presentation\"\n      weight : \"none\" | \"light\" | \"normal\" | \"medium\" | \"semibold\" | \"bold\" = none\n        @label \"Weight\"\n        @description \"Font weight override — `none` = no override, the variant's baked weight applies\"\n        @tier \"presentation\"\n      size : \"none\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" | \"3xl\" = none\n        @label \"Size\"\n        @description \"Font size override\"\n        @tier \"presentation\"\n      truncate : boolean = false\n        @label \"Truncate\"\n        @description \"Truncate with ellipsis (single line)\"\n        @tier \"presentation\"\n      overflow : \"visible\" | \"hidden\" | \"wrap\" | \"clamp-2\" | \"clamp-3\" = visible\n        @label \"Overflow\"\n        @description \"Overflow handling mode\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n      style : Map string string = {}\n        @label \"Style\"\n        @description \"Inline style\"\n        @tier \"presentation\"\n      format : \"none\" | \"date\" | \"time\" | \"datetime\" | \"number\" | \"currency\" | \"percent\" = none\n        @label \"Format\"\n        @description \"Value formatting applied to string/number/Date content — `none` (the default) renders content as-is. Covers the raw-ISO-date class: a bound datetime renders human-readable via `format='date'|'time'|'datetime'`.\"\n        @tier \"presentation\"\n      content : node\n        @label \"Content\"\n        @description \"Text content (alternative to children)\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Children elements\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/typography\" as TypographyPage -> TypographyRender\n}\n"
}