  "source": "",
  "lolo": "app ui-law-reference-tooltip \"1.0.0\"\n\"LawReferenceTooltip — UI factory (1:1 with the @almadar/ui law-reference-tooltip pattern).\"\norbital LawReferenceTooltipOrbital {\n  type LawReferenceTooltipReference = {\n    law : string!\n    lawName : string\n    article : string!\n    clause : string\n    link : string\n  }\n\n  entity LawReferenceTooltipItem [runtime] {\n    id : string!\n  }\n\n  trait LawReferenceTooltipRender -> @rebindable LawReferenceTooltipItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          reference: @config.reference\n          children: @config.children\n          position: @config.position\n          className: @config.className\n          type: law-reference-tooltip\n        })\n    }\n\n    config {\n      reference : LawReferenceTooltipReference = { law: \"Law\", lawName: \"Law Name\", article: \"Article\", clause: \"Clause\", link: \"Link\" }\n        @label \"Reference\"\n        @description \"The law reference to display\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Children element that triggers the tooltip\"\n        @tier \"presentation\"\n      position : \"top\" | \"bottom\" | \"left\" | \"right\" = top\n        @label \"Position\"\n        @description \"Tooltip position\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/law-reference-tooltip\" as LawReferenceTooltipPage -> LawReferenceTooltipRender\n}\n"
}