  "source": "",
  "lolo": "app ui-filter-group \"1.0.0\"\n\"FilterGroup — a panel of filter controls that narrows a collection by field values. — UI factory (1:1 with the @almadar/ui filter-group pattern).\"\n;; @capabilities \"search refinement panel, facet filters, admin list filters, records filter sidebar, filter chips panel\"\norbital FilterGroupOrbital {\n  type FilterGroupFiltersItem = {\n    field : string!\n    label : string!\n    filterType : \"text\" | \"select\" | \"toggle\" | \"checkbox\" | \"date\" | \"daterange\" | \"date-range\" | \"numberrange\" | \"number-range\"\n    type : \"text\" | \"select\" | \"toggle\" | \"checkbox\" | \"date\" | \"daterange\" | \"date-range\" | \"numberrange\" | \"number-range\"\n    options : [string]\n    min : number\n    max : number\n    step : number\n  }\n\n  entity FilterGroupItem [runtime] {\n    id : string!\n  }\n\n  trait FilterGroupRender -> @rebindable FilterGroupItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (fetch FilterGroupItem {})\n        (render-ui main {\n          entity: FilterGroupItem\n          filters: @config.filters\n          onFilterChange: @config.onFilterChange\n          onClearAll: @config.onClearAll\n          className: @config.className\n          variant: @config.variant\n          showIcon: @config.showIcon\n          query: @config.query\n          isLoading: @config.isLoading\n          look: @config.look\n          event: @config.event\n          clearEvent: @config.clearEvent\n          type: filter-group\n        })\n    }\n\n    emits {\n      @config.onFilterChange -> external {\n        field : string\n        value : string\n      }\n        @description \"Callback when a filter changes - for EntityStore integration\"\n        @tier \"essential\"\n      @config.onClearAll -> external {\n        id : string\n      }\n        @description \"Callback to clear all filters\"\n        @tier \"essential\"\n      @config.event -> external {\n        id : string\n      }\n        @description \"Declarative filter event — emits UI:{event} via eventBus on filter change (alongside canonical UI:FILTER)\"\n        @tier \"essential\"\n      @config.clearEvent -> external {\n        id : string\n      }\n        @description \"Declarative clear event — emits UI:{clearEvent} via eventBus on clear-all (alongside canonical UI:CLEAR_FILTERS)\"\n        @tier \"essential\"\n    }\n\n    config {\n      filters : [FilterGroupFiltersItem] = [{ field: \"Field\", label: \"Label\", filterType: text, type: text, options: [\"Item\", \"Item 2\"], min: 1, max: 1, step: 1 }, { field: \"Field 2\", label: \"Label 2\", filterType: select, type: select, options: [\"Item\", \"Item 2\"], min: 2, max: 2, step: 2 }]\n        @label \"Filters\"\n        @description \"Filter definitions from schema\"\n        @tier \"presentation\"\n      onFilterChange : string = \"FILTER_CHANGE\"\n        @label \"On Filter Change\"\n        @description \"Callback when a filter changes - for EntityStore integration\"\n        @tier \"presentation\"\n      onClearAll : string = \"CLEAR_ALL\"\n        @label \"On Clear All\"\n        @description \"Callback to clear all filters\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      variant : \"default\" | \"compact\" | \"pills\" | \"vertical\" = default\n        @label \"Variant\"\n        @description \"Variant style\"\n        @tier \"presentation\"\n      showIcon : boolean = true\n        @label \"Show Icon\"\n        @description \"Show filter icon\"\n        @tier \"presentation\"\n      query : string\n        @label \"Query\"\n        @description \"Query singleton binding for state management. When provided, syncs filter state with the query singleton. Example: '@TaskQuery'\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      look : \"toolbar\" | \"chips\" | \"pills\" | \"popover-trigger\" | \"inline-column-header\" = toolbar\n        @label \"Look\"\n        @description \"Layer 2 visual treatment — orthogonal to the semantic variant.\"\n        @tier \"presentation\"\n      event : string = \"EVENT\"\n        @label \"Event\"\n        @description \"Declarative filter event — emits UI:{event} via eventBus on filter change (alongside canonical UI:FILTER)\"\n        @tier \"presentation\"\n      clearEvent : string = \"CLEAR\"\n        @label \"Clear Event\"\n        @description \"Declarative clear event — emits UI:{clearEvent} via eventBus on clear-all (alongside canonical UI:CLEAR_FILTERS)\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/filter-group\" as FilterGroupPage -> FilterGroupRender\n}\n"
}