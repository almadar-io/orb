  "source": "",
  "lolo": "app ui-connection-block \"1.0.0\"\n\"ConnectionBlock — UI factory (1:1 with the @almadar/ui connection-block pattern).\"\norbital ConnectionBlockOrbital {\n  entity ConnectionBlockItem [runtime] {\n    id : string!\n  }\n\n  trait ConnectionBlockRender -> @rebindable ConnectionBlockItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          content: @config.content\n          className: @config.className\n          type: connection-block\n        })\n    }\n\n    config {\n      content : string = \"\"\n        @label \"Content\"\n        @description \"Markdown content summarising what the learner already knows\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/connection-block\" as ConnectionBlockPage -> ConnectionBlockRender\n}\n"
