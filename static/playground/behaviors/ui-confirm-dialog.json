  "source": "",
  "lolo": "app ui-confirm-dialog \"1.0.0\"\n\"ConfirmDialog — UI factory (1:1 with the @almadar/ui confirm-dialog pattern).\"\norbital ConfirmDialogOrbital {\n  type ConfirmDialogError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity ConfirmDialogItem [runtime] {\n    id : string!\n  }\n\n  trait ConfirmDialogRender -> @rebindable ConfirmDialogItem [interaction, instance] {\n    initial: closed\n\n    state closed {\n      INIT -> closed\n        (render-ui main {\n          label: \"Open Confirm-dialog\"\n          action: OPEN\n          type: button\n        })\n      OPEN -> open\n        (render-ui modal {\n          isOpen: @config.isOpen\n          onClose: @config.onClose\n          onConfirm: @config.onConfirm\n          title: @config.title\n          message: @config.message\n          description: @config.description\n          confirmText: @config.confirmText\n          confirmLabel: @config.confirmLabel\n          cancelText: @config.cancelText\n          cancelLabel: @config.cancelLabel\n          variant: @config.variant\n          size: @config.size\n          isLoading: @config.isLoading\n          error: @config.error\n          className: @config.className\n          type: confirm-dialog\n        })\n    }\n\n    state open {\n      CLOSE -> closed\n        (render-ui modal null)\n        (render-ui main {\n          label: \"Open Confirm-dialog\"\n          action: OPEN\n          type: button\n        })\n    }\n\n    emits {\n      @config.onClose -> external { }\n        @description \"Callback when dialog is closed (injected by slot wrapper)\"\n        @tier \"essential\"\n      @config.onConfirm -> external { }\n        @description \"Callback when action is confirmed (injected by slot wrapper)\"\n        @tier \"essential\"\n      OPEN -> external {\n        id : string\n      }\n        @description \"Open the Confirm-dialog.\"\n        @tier \"essential\"\n    }\n\n    config {\n      isOpen : boolean = true\n        @label \"Is Open\"\n        @description \"Whether the dialog is open (defaults to true when rendered by slot wrapper)\"\n        @tier \"presentation\"\n      onClose : event = \"CLOSE\"\n        @label \"On Close\"\n        @description \"Callback when dialog is closed (injected by slot wrapper)\"\n        @tier \"presentation\"\n      onConfirm : event = \"CONFIRM\"\n        @label \"On Confirm\"\n        @description \"Callback when action is confirmed (injected by slot wrapper)\"\n        @tier \"presentation\"\n      title : string = \"\"\n        @label \"Title\"\n        @description \"Dialog title\"\n        @tier \"presentation\"\n      message : node\n        @label \"Message\"\n        @description \"Dialog message/description\"\n        @tier \"presentation\"\n      description : node\n        @label \"Description\"\n        @description \"Alias for message (schema compatibility)\"\n        @tier \"presentation\"\n      confirmText : string\n        @label \"Confirm Text\"\n        @description \"Confirm button text\"\n        @tier \"presentation\"\n      confirmLabel : string\n        @label \"Confirm Label\"\n        @description \"Alias for confirmText (schema compatibility)\"\n        @tier \"presentation\"\n      cancelText : string\n        @label \"Cancel Text\"\n        @description \"Cancel button text\"\n        @tier \"presentation\"\n      cancelLabel : string\n        @label \"Cancel Label\"\n        @description \"Alias for cancelText (schema compatibility)\"\n        @tier \"presentation\"\n      variant : \"danger\" | \"warning\" | \"info\" | \"default\" = danger\n        @label \"Variant\"\n        @description \"Dialog variant\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" | \"xl\" | \"full\" = sm\n        @label \"Size\"\n        @description \"Dialog size\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state for confirm button\"\n        @tier \"presentation\"\n      error : ConfirmDialogError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/confirm-dialog\" as ConfirmDialogPage -> ConfirmDialogRender\n}\n"
}