  "source": "",
  "lolo": "app ui-empty-state \"1.0.0\"\n\"EmptyState — UI factory (1:1 with the @almadar/ui empty-state pattern).\"\norbital EmptyStateOrbital {\n  entity EmptyStateItem [runtime] {\n    id : string!\n  }\n\n  trait EmptyStateRender -> @rebindable EmptyStateItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          icon: @config.icon\n          title: @config.title\n          message: @config.message\n          description: @config.description\n          actionLabel: @config.actionLabel\n          onAction: @config.onAction\n          className: @config.className\n          destructive: @config.destructive\n          variant: @config.variant\n          actionEvent: @config.actionEvent\n          look: @config.look\n          type: empty-state\n        })\n    }\n\n    emits {\n      @config.onAction -> external { }\n        @description \"onAction prop\"\n        @tier \"essential\"\n    }\n\n    config {\n      icon : icon\n        @label \"Icon\"\n        @description \"Icon to display. Accepts either: - A Lucide icon component (LucideIcon) - A string icon name (e.g., 'check-circle', 'x-circle')\"\n        @tier \"presentation\"\n      title : string\n        @label \"Title\"\n        @description \"Primary text to display - use title or message (message is alias for backwards compat)\"\n        @tier \"presentation\"\n      message : string\n        @label \"Message\"\n        @description \"Alias for title - used by schema patterns\"\n        @tier \"presentation\"\n      description : string\n        @label \"Description\"\n        @description \"description prop\"\n        @tier \"presentation\"\n      actionLabel : string\n        @label \"Action Label\"\n        @description \"actionLabel prop\"\n        @tier \"presentation\"\n      onAction : event = \"ACTION\"\n        @label \"On Action\"\n        @description \"onAction prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      destructive : boolean\n        @label \"Destructive\"\n        @description \"Destructive styling for confirmation dialogs\"\n        @tier \"presentation\"\n      variant : \"default\" | \"success\" | \"error\" | \"warning\" | \"info\" = default\n        @label \"Variant\"\n        @description \"Variant for color styling\"\n        @tier \"presentation\"\n      actionEvent : event = \"ACTION\"\n        @label \"Action Event\"\n        @description \"Declarative action event — emits UI:{actionEvent} via eventBus when action button is clicked\"\n        @tier \"presentation\"\n      look : \"illustrated\" | \"icon-only\" | \"text-only\" | \"mascot\" = \"icon-only\"\n        @label \"Look\"\n        @description \"Layer 2 visual treatment — orthogonal to the semantic variant (which carries status color).\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/empty-state\" as EmptyStatePage -> EmptyStateRender\n}\n"
