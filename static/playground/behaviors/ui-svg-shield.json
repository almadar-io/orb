  "source": "",
  "lolo": "app ui-svg-shield \"1.0.0\"\n\"SvgShield — UI factory (1:1 with the @almadar/ui svg-shield pattern).\"\norbital SvgShieldOrbital {\n  entity SvgShieldItem [runtime] {\n    id : string!\n  }\n\n  trait SvgShieldRender -> @rebindable SvgShieldItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          x: @config.x\n          y: @config.y\n          size: @config.size\n          variant: @config.variant\n          color: @config.color\n          opacity: @config.opacity\n          className: @config.className\n          asRoot: @config.asRoot\n          width: @config.width\n          height: @config.height\n          type: svg-shield\n        })\n    }\n\n    config {\n      x : number = 50\n        @label \"X\"\n        @description \"x prop\"\n        @tier \"presentation\"\n      y : number = 50\n        @label \"Y\"\n        @description \"y prop\"\n        @tier \"presentation\"\n      size : number = 1\n        @label \"Size\"\n        @description \"size prop\"\n        @tier \"presentation\"\n      variant : \"outline\" | \"filled\" | \"check\" = outline\n        @label \"Variant\"\n        @description \"variant prop\"\n        @tier \"presentation\"\n      color : string = \"var(--color-primary)\"\n        @label \"Color\"\n        @description \"color prop\"\n        @tier \"presentation\"\n      opacity : number = 1\n        @label \"Opacity\"\n        @description \"opacity prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      asRoot : boolean = true\n        @label \"As Root\"\n        @description \"When true (default), wraps in a standalone <svg> so the shape is visible without a parent SVG context.\"\n        @tier \"presentation\"\n      width : number = 100\n        @label \"Width\"\n        @description \"width prop\"\n        @tier \"presentation\"\n      height : number = 100\n        @label \"Height\"\n        @description \"height prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/svg-shield\" as SvgShieldPage -> SvgShieldRender\n}\n"
}