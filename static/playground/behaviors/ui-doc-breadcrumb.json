  "source": "",
  "lolo": "app ui-doc-breadcrumb \"1.0.0\"\n\"DocBreadcrumb — UI factory (1:1 with the @almadar/ui doc-breadcrumb pattern).\"\norbital DocBreadcrumbOrbital {\n  type DocBreadcrumbItemsItem = {\n    label : string!\n    href : string\n  }\n\n  entity DocBreadcrumbItem [runtime] {\n    id : string!\n  }\n\n  trait DocBreadcrumbRender -> @rebindable DocBreadcrumbItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          items: @config.items\n          className: @config.className\n          type: doc-breadcrumb\n        })\n    }\n\n    config {\n      items : [DocBreadcrumbItemsItem] = [{ label: \"Label\", href: \"Href\" }, { label: \"Label 2\", href: \"Href 2\" }]\n        @label \"Items\"\n        @description \"Breadcrumb path items, last item is treated as current page\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/doc-breadcrumb\" as DocBreadcrumbPage -> DocBreadcrumbRender\n}\n"
