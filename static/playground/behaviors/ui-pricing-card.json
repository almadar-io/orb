  "source": "",
  "lolo": "app ui-pricing-card \"1.0.0\"\n\"PricingCard — a single pricing-tier card with price, billing period, feature list, and call-to-action. — UI factory (1:1 with the @almadar/ui pricing-card pattern).\"\n;; @capabilities \"pricing tier, plan card, subscription tier, plan comparison card, price plan\"\norbital PricingCardOrbital {\n  type PricingCardAction = {\n    label : string!\n    href : string!\n  }\n\n  entity PricingCardItem [runtime] {\n    id : string!\n  }\n\n  trait PricingCardRender -> @rebindable PricingCardItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          name: @config.name\n          price: @config.price\n          description: @config.description\n          features: @config.features\n          action: @config.action\n          highlighted: @config.highlighted\n          badge: @config.badge\n          className: @config.className\n          type: pricing-card\n        })\n    }\n\n    config {\n      name : string = \"\"\n        @label \"Name\"\n        @description \"name prop\"\n        @tier \"presentation\"\n      price : string = \"\"\n        @label \"Price\"\n        @description \"price prop\"\n        @tier \"presentation\"\n      description : string\n        @label \"Description\"\n        @description \"description prop\"\n        @tier \"presentation\"\n      features : [string] = [\"Item\", \"Item 2\"]\n        @label \"Features\"\n        @description \"features prop\"\n        @tier \"presentation\"\n      action : PricingCardAction = { label: \"Label\", href: \"Href\" }\n        @label \"Action\"\n        @description \"action prop\"\n        @tier \"presentation\"\n      highlighted : boolean = false\n        @label \"Highlighted\"\n        @description \"highlighted prop\"\n        @tier \"presentation\"\n      badge : string\n        @label \"Badge\"\n        @description \"badge prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/pricing-card\" as PricingCardPage -> PricingCardRender\n}\n"
}