  "source": "",
  "lolo": "app ui-atlas-panel \"1.0.0\"\n\"AtlasPanel — UI factory (1:1 with the @almadar/ui atlas-panel pattern).\"\norbital AtlasPanelOrbital {\n  type AtlasPanelAsset = {\n    url : string\n    atlas : string\n    sprite : string\n    name : string\n    category : string\n  }\n\n  entity AtlasPanelItem [runtime] {\n    id : string!\n  }\n\n  trait AtlasPanelRender -> @rebindable AtlasPanelItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          asset: @config.asset\n          borderSlice: @config.borderSlice\n          borderWidth: @config.borderWidth\n          mode: @config.mode\n          className: @config.className\n          style: @config.style\n          children: @config.children\n          type: atlas-panel\n        })\n    }\n\n    config {\n      asset : AtlasPanelAsset\n        @label \"Asset\"\n        @description \"asset prop\"\n        @tier \"presentation\"\n      borderSlice : number = 16\n        @label \"Border Slice\"\n        @description \"Border thickness (source pixels) for the 9-slice cut.\"\n        @tier \"presentation\"\n      borderWidth : number = 16\n        @label \"Border Width\"\n        @description \"Rendered border width in CSS px.\"\n        @tier \"presentation\"\n      mode : \"nineSlice\" | \"repeat\" = nineSlice\n        @label \"Mode\"\n        @description \"'nineSlice' scales edges crisp (panels/buttons); 'repeat' tiles the slice (pattern fills).\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      style : Map string string = {}\n        @label \"Style\"\n        @description \"style prop\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"children prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/atlas-panel\" as AtlasPanelPage -> AtlasPanelRender\n}\n"
}