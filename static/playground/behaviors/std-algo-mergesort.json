                          "color": "#3b82f6"
                        },
                        {
                          "color": "#3b82f6",
                          "label": "3",
                          "value": 3
                        },
                        {
                          "label": "7",
                          "value": 7,
                          "color": "#3b82f6"
                        },
                        {
                          "color": "#3b82f6",
                          "label": "4",
                          "value": 4
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.aux",
                      [
                        {
                          "color": "#3b82f6",
                          "label": "5",
                          "value": 5
                        },
                        {
                          "color": "#3b82f6",
                          "label": "2",
                          "value": 2
                        },
                        {
                          "label": "8",
                          "value": 8,
