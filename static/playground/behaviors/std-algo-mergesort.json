                              "value": 4
                            }
                          ]
                        ]
                      ]
                    ],
                    [
                      "set",
                      "@entity.k",
                      0
                    ],
                    [
                      "set",
                      "@entity.done",
                      false
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "width": 600,
                        "height": 400,
                        "bars": "@entity.bars",
                        "type": "algorithm-canvas",
                        "backgroundColor": "#f8fafc"
                      }
                    ],
                    [
                      "emit",
                      "BARS_UPDATED",
                      {
                        "bars": "@entity.bars"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "mergeTick",
                "interval": 350,
                "guard": [
                  "and",
                  "@entity.running",
                  [
                    "not",
                    "@entity.done"
                  ]
                ],
                "effects": [
                  [
                    "set",
                    "@entity.curMid",
                    [
                      "math/min",
                      [
                        "+",
                        "@entity.lo",
                        "@entity.width"
                      ],
                      "@entity.n"
                    ]
                  ],
                  [
                    "set",
                    "@entity.curHi",
                    [
                      "math/min",
                      [
                        "+",
                        "@entity.lo",
                        [
                          "*",
                          2,
                          "@entity.width"
                        ]
                      ],
                      "@entity.n"
                    ]
                  ],
                  [
                    "set",
                    "@entity.copying",
                    [
                      "and",
                      [
                        "<",
                        "@entity.width",
                        "@entity.n"
                      ],
                      [
                        "<",
                        "@entity.k",
                        "@entity.curHi"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.takeLeft",
                    [
                      "and",
                      "@entity.copying",
                      [
                        "and",
                        [
                          "<",
                          "@entity.i",
                          "@entity.curMid"
                        ],
                        [
                          "or",
                          [
                            ">=",
                            "@entity.j",
                            "@entity.curHi"
                          ],
                          [
                            "<=",
                            [
                              "object/get",
                              [
                                "array/nth",
                                "@entity.aux",
                                [
                                  "math/min",
                                  "@entity.i",
                                  [
                                    "math/max",
                                    0,
                                    [
                                      "-",
                                      "@entity.curMid",
                                      1
                                    ]
                                  ]
                                ]
                              ],
                              "value"
                            ],
                            [
                              "object/get",
                              [
                                "array/nth",
                                "@entity.aux",
                                [
                                  "math/min",
                                  "@entity.j",
                                  [
                                    "math/max",
                                    0,
                                    [
                                      "-",
                                      "@entity.curHi",
                                      1
                                    ]
                                  ]
                                ]
                              ],
                              "value"
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.srcVal",
                    [
                      "if",
                      "@entity.copying",
                      [
                        "if",
                        "@entity.takeLeft",
                        [
                          "object/get",
                          [
                            "array/nth",
                            "@entity.aux",
                            "@entity.i"
                          ],
                          "value"
                        ],
                        [
                          "object/get",
                          [
                            "array/nth",
                            "@entity.aux",
                            "@entity.j"
                          ],
                          "value"
                        ]
                      ],
                      0
                    ]
                  ],
                  [
                    "set",
                    "@entity.advancing",
                    [
                      "and",
                      [
                        "<",
                        "@entity.width",
                        "@entity.n"
                      ],
                      [
                        "not",
                        "@entity.copying"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.nextLo",
                    [
                      "+",
                      "@entity.lo",
                      [
                        "*",
                        2,
                        "@entity.width"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.moreMerges",
                    [
                      "and",
                      "@entity.advancing",
                      [
                        "<",
                        "@entity.nextLo",
                        "@entity.n"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.levelEnd",
                    [
                      "and",
                      "@entity.advancing",
                      [
                        ">=",
                        "@entity.nextLo",
                        "@entity.n"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.newWidth",
                    [
                      "*",
                      2,
                      "@entity.width"
                    ]
                  ],
                  [
                    "set",
                    "@entity.moreLevels",
                    [
                      "and",
                      "@entity.levelEnd",
                      [
                        "<",
                        "@entity.newWidth",
                        "@entity.n"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.bars",
                    [
                      "array/map",
                      "@entity.bars",
                      [
                        "object/merge",
                        "@item",
                        {
                          "value": [
                            "if",
                            [
                              "and",
                              "@entity.copying",
                              [
                                "==",
                                "@index",
                                "@entity.k"
                              ]
                            ],
                            "@entity.srcVal",
                            [
                              "object/get",
                              "@item",
                              "value"
                            ]
                          ],
                          "color": [
                            "if",
                            [
                              "and",
                              "@entity.levelEnd",
                              [
                                "not",
                                "@entity.moreLevels"
                              ]
                            ],
                            "#22c55e",
                            [
                              "if",
                              "@entity.copying",
                              [
                                "if",
                                [
                                  "==",
                                  "@index",
                                  "@entity.k"
                                ],
                                "#f59e0b",
                                [
                                  "if",
                                  [
                                    "and",
                                    [
                                      ">=",
                                      "@index",
                                      "@entity.lo"
                                    ],
                                    [
                                      "<",
                                      "@index",
                                      "@entity.curHi"
                                    ]
                                  ],
                                  "#fbbf24",
                                  "#3b82f6"
                                ]
                              ],
                              "#3b82f6"
                            ]
                          ]
                        }
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.lo",
                    [
                      "if",
                      "@entity.moreMerges",
                      "@entity.nextLo",
                      [
                        "if",
                        "@entity.levelEnd",
                        0,
                        "@entity.lo"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.i",
                    [
                      "if",
                      "@entity.copying",
                      [
                        "if",
                        "@entity.takeLeft",
                        [
                          "+",
                          "@entity.i",
                          1
                        ],
                        "@entity.i"
                      ],
                      [
                        "if",
                        "@entity.moreMerges",
                        "@entity.nextLo",
                        [
                          "if",
                          "@entity.levelEnd",
                          0,
                          "@entity.i"
                        ]
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.j",
                    [
                      "if",
                      "@entity.copying",
                      [
                        "if",
                        "@entity.takeLeft",
                        "@entity.j",
                        [
                          "+",
                          "@entity.j",
                          1
                        ]
                      ],
                      [
                        "if",
                        "@entity.moreMerges",
                        [
                          "math/min",
                          [
                            "+",
                            "@entity.nextLo",
                            "@entity.width"
                          ],
                          "@entity.n"
                        ],
                        [
                          "if",
                          "@entity.levelEnd",
                          [
                            "math/min",
                            "@entity.newWidth",
                            "@entity.n"
                          ],
                          "@entity.j"
                        ]
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.k",
                    [
                      "if",
                      "@entity.copying",
                      [
                        "+",
                        "@entity.k",
                        1
                      ],
                      [
                        "if",
                        "@entity.moreMerges",
                        "@entity.nextLo",
                        [
                          "if",
                          "@entity.levelEnd",
                          0,
                          "@entity.k"
                        ]
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.aux",
                    [
                      "if",
                      "@entity.moreLevels",
                      "@entity.bars",
                      "@entity.aux"
                    ]
                  ],
                  [
                    "set",
                    "@entity.width",
                    [
                      "if",
                      "@entity.levelEnd",
                      "@entity.newWidth",
                      "@entity.width"
                    ]
                  ],
                  [
                    "set",
                    "@entity.done",
                    [
                      "and",
                      "@entity.levelEnd",
                      [
                        "not",
                        "@entity.moreLevels"
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "backgroundColor": "#f8fafc",
                      "height": 400,
                      "bars": "@entity.bars",
                      "type": "algorithm-canvas",
                      "width": 600
                    }
                  ],
                  [
                    "emit",
                    "BARS_UPDATED",
                    {
                      "bars": "@entity.bars"
                    }
                  ]
                ]
              }
            ],
            "config": {
              "backgroundColor": {
                "type": "string",
                "default": "#f8fafc",
