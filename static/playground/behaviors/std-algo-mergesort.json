                      "type": "[AlgoBar]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.bars",
                      [
                        {
                          "color": "#3b82f6",
                          "label": "5",
                          "value": 5
                        },
                        {
                          "color": "#3b82f6",
