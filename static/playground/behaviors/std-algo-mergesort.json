                        },
                        {
                          "color": "#3b82f6",
                          "label": "1",
                          "value": 1
                        },
                        {
                          "value": 9,
                          "label": "9",
                          "color": "#3b82f6"
                        },
                        {
                          "color": "#3b82f6",
                          "label": "3",
                          "value": 3
                        },
                        {
                          "label": "7",
                          "value": 7,
                          "color": "#3b82f6"
                        },
                        {
                          "color": "#3b82f6",
                          "label": "4",
                          "value": 4
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.n",
                      [
                        "array/len",
                        [
                          {
                            "color": "#3b82f6",
                            "label": "5",
                            "value": 5
                          },
                          {
                            "color": "#3b82f6",
                            "label": "2",
                            "value": 2
                          },
                          {
                            "label": "8",
                            "value": 8,
                            "color": "#3b82f6"
                          },
                          {
                            "color": "#3b82f6",
                            "label": "1",
                            "value": 1
                          },
                          {
                            "value": 9,
                            "label": "9",
                            "color": "#3b82f6"
                          },
                          {
                            "color": "#3b82f6",
                            "label": "3",
                            "value": 3
                          },
                          {
                            "label": "7",
                            "value": 7,
                            "color": "#3b82f6"
                          },
                          {
                            "color": "#3b82f6",
                            "label": "4",
                            "value": 4
                          }
                        ]
                      ]
                    ],
                    [
                      "set",
                      "@entity.width",
                      1
                    ],
                    [
                      "set",
                      "@entity.lo",
                      0
                    ],
                    [
                      "set",
                      "@entity.i",
                      0
                    ],
                    [
                      "set",
                      "@entity.j",
                      [
                        "math/min",
                        1,
                        [
                          "array/len",
                          [
                            {
                              "color": "#3b82f6",
                              "label": "5",
                              "value": 5
                            },
                            {
                              "color": "#3b82f6",
                              "label": "2",
                              "value": 2
                            },
                            {
                              "label": "8",
                              "value": 8,
                              "color": "#3b82f6"
                            },
                            {
                              "color": "#3b82f6",
                              "label": "1",
                              "value": 1
                            },
                            {
                              "value": 9,
                              "label": "9",
                              "color": "#3b82f6"
                            },
                            {
                              "color": "#3b82f6",
                              "label": "3",
                              "value": 3
                            },
                            {
                              "label": "7",
                              "value": 7,
