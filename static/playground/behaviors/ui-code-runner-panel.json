  "source": "",
  "lolo": "app ui-code-runner-panel \"1.0.0\"\n\"CodeRunnerPanel — UI factory (1:1 with the @almadar/ui code-runner-panel pattern).\"\norbital CodeRunnerPanelOrbital {\n  entity CodeRunnerPanelItem [runtime] {\n    id : string!\n  }\n\n  trait CodeRunnerPanelRender -> @rebindable CodeRunnerPanelItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          code: @config.code\n          language: @config.language\n          runnable: @config.runnable\n          runEvent: @config.runEvent\n          className: @config.className\n          type: code-runner-panel\n        })\n    }\n\n    config {\n      code : string = \"\"\n        @label \"Code\"\n        @description \"Initial code content\"\n        @tier \"presentation\"\n      language : string = \"\"\n        @label \"Language\"\n        @description \"Programming language for syntax highlighting\"\n        @tier \"presentation\"\n      runnable : boolean = true\n        @label \"Runnable\"\n        @description \"Whether the panel allows running (false = read-only code block)\"\n        @tier \"presentation\"\n      runEvent : string = \"RUN_CODE\"\n        @label \"Run Event\"\n        @description \"Event name to emit on run (emitted as `UI:<runEvent>`). Defaults to 'RUN_CODE'.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/code-runner-panel\" as CodeRunnerPanelPage -> CodeRunnerPanelRender\n}\n"
}