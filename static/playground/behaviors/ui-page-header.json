  "source": "",
  "lolo": "app ui-page-header \"1.0.0\"\n\"PageHeader — UI factory (1:1 with the @almadar/ui page-header pattern).\"\norbital PageHeaderOrbital {\n  type PageHeaderBreadcrumbsItem = {\n    label : string!\n    href : string\n  }\n  type PageHeaderStatus = {\n    label : string!\n    variant : \"default\" | \"success\" | \"warning\" | \"danger\" | \"info\"\n  }\n  type PageHeaderActionsItem = {\n    label : string!\n    navigatesTo : string\n    event : event\n    variant : \"primary\" | \"secondary\" | \"ghost\" | \"danger\"\n    icon : icon\n    loading : boolean\n    disabled : boolean\n  }\n  type PageHeaderError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type PageHeaderTabsItem = {\n    label : string!\n    value : string!\n    count : number\n  }\n\n  entity PageHeaderItem [runtime] {\n    id : string!\n  }\n\n  trait PageHeaderRender -> @rebindable PageHeaderItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          title: @config.title\n          subtitle: @config.subtitle\n          showBack: @config.showBack\n          backEvent: @config.backEvent\n          breadcrumbs: @config.breadcrumbs\n          status: @config.status\n          actions: @config.actions\n          isLoading: @config.isLoading\n          error: @config.error\n          tabs: @config.tabs\n          activeTab: @config.activeTab\n          onTabChange: @config.onTabChange\n          children: @config.children\n          className: @config.className\n          type: page-header\n        })\n    }\n\n    emits {\n      @config.backEvent -> external { }\n        @description \"Event to emit when back is clicked (default: BACK)\"\n        @tier \"essential\"\n      @config.onTabChange -> external {\n        value : string\n      }\n        @description \"onTabChange prop\"\n        @tier \"essential\"\n    }\n\n    config {\n      title : string\n        @label \"Title\"\n        @description \"Page title - accepts string or number from generated code accessing dynamic entity data\"\n        @tier \"presentation\"\n      subtitle : string\n        @label \"Subtitle\"\n        @description \"Optional subtitle/description\"\n        @tier \"presentation\"\n      showBack : boolean = false\n        @label \"Show Back\"\n        @description \"Show back button\"\n        @tier \"presentation\"\n      backEvent : event = \"BACK\"\n        @label \"Back Event\"\n        @description \"Event to emit when back is clicked (default: BACK)\"\n        @tier \"presentation\"\n      breadcrumbs : [PageHeaderBreadcrumbsItem] = []\n        @label \"Breadcrumbs\"\n        @description \"Breadcrumbs\"\n        @tier \"presentation\"\n      status : PageHeaderStatus\n        @label \"Status\"\n        @description \"Status badge — a bare string (an entity's status field bound directly, e.g. `status: @entity.status`) renders as a default-variant badge\"\n        @tier \"presentation\"\n      actions : [PageHeaderActionsItem] = []\n        @label \"Actions\"\n        @description \"Actions array - first action with variant='primary' (or first action) is the main action\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : PageHeaderError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      tabs : [PageHeaderTabsItem] = []\n        @label \"Tabs\"\n        @description \"Tabs for sub-navigation\"\n        @tier \"presentation\"\n      activeTab : string\n        @label \"Active Tab\"\n        @description \"activeTab prop\"\n        @tier \"presentation\"\n      onTabChange : event = \"TAB_CHANGE\"\n        @label \"On Tab Change\"\n        @description \"onTabChange prop\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Custom content in the header\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/page-header\" as PageHeaderPage -> PageHeaderRender\n}\n"
}