  "lolo": "app ui-module-card \"1.0.0\"\n\"ModuleCard — a card summarizing one course module or lesson with progress and entry point. — UI factory (1:1 with the @almadar/ui module-card pattern).\"\n;; @capabilities \"course module card, lesson card, curriculum unit card, learning-path step card\"\norbital ModuleCardOrbital {\n  type ModuleCardData = {\n    orbitalName : string!\n    entityName : string!\n    persistence : string!\n    fields : [ModuleCardDataFieldsItem]!\n    traits : [ModuleCardDataTraitsItem]!\n    pages : [ModuleCardDataPagesItem]!\n    traitDetails : Map string ModuleCardDataTraitDetailsValue!\n    externalLinks : [ModuleCardDataExternalLinksItem]!\n  }\n  type ModuleCardDataFieldsItem = {\n    name : string!\n    type : string!\n    required : boolean!\n    hasDefault : boolean!\n  }\n  type ModuleCardDataTraitsItem = {\n    name : string!\n    stateCount : number!\n    eventCount : number!\n    transitionCount : number!\n    emits : [string]!\n    listens : [string]!\n  }\n  type ModuleCardDataPagesItem = {\n    name : string!\n    route : string!\n  }\n  type ModuleCardDataTraitDetailsValue = {\n    name : string!\n    linkedEntity : string!\n    states : [ModuleCardDataTraitDetailsValueStatesItem]!\n    transitions : [ModuleCardDataTraitDetailsValueTransitionsItem]!\n    emittedEvents : [string]!\n    listenedEvents : [string]!\n  }\n  type ModuleCardDataTraitDetailsValueStatesItem = {\n    name : string!\n    isInitial : boolean!\n    isTerminal : boolean!\n  }\n  type ModuleCardDataTraitDetailsValueTransitionsItem = {\n    from : string!\n    to : string!\n    event : string!\n    guard : SExpr!\n    effects : [ModuleCardDataTraitDetailsValueTransitionsItemEffectsItem]!\n    index : number!\n  }\n  type ModuleCardDataTraitDetailsValueTransitionsItemEffectsItem = {\n    type : string!\n    args : [SExpr]!\n  }\n  type ModuleCardDataExternalLinksItem = {\n    targetOrbital : string!\n    eventName : string!\n    direction : string!\n    traitName : string!\n  }\n\n  entity ModuleCardItem [runtime] {\n    id : string!\n  }\n\n  trait ModuleCardRender -> @rebindable ModuleCardItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          data: @config.data\n          type: module-card\n        })\n    }\n\n    config {\n      data : ModuleCardData = { orbitalName: \"Orbital Name\", entityName: \"Entity Name\", persistence: \"Persistence\", fields: [{ name: \"Name\", type: \"Type\", required: false, hasDefault: false }, { name: \"Name 2\", type: \"Type 2\", required: true, hasDefault: true }], traits: [{ name: \"Name\", stateCount: 1, eventCount: 1, transitionCount: 1, emits: [\"Item\", \"Item 2\"], listens: [\"Item\", \"Item 2\"] }, { name: \"Name 2\", stateCount: 2, eventCount: 2, transitionCount: 2, emits: [\"Item\", \"Item 2\"], listens: [\"Item\", \"Item 2\"] }], pages: [{ name: \"Name\", route: \"Route\" }, { name: \"Name 2\", route: \"Route 2\" }], traitDetails: {}, externalLinks: [{ targetOrbital: \"Target Orbital\", eventName: \"Event Name\", direction: \"Direction\", traitName: \"Trait Name\" }, { targetOrbital: \"Target Orbital 2\", eventName: \"Event Name 2\", direction: \"Direction 2\", traitName: \"Trait Name 2\" }] }\n        @label \"Data\"\n        @description \"data prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/module-card\" as ModuleCardPage -> ModuleCardRender\n}\n"
}