  "lolo": "app ui-module-card \"1.0.0\"\n\"ModuleCard — a card summarizing one course module or lesson with progress and entry point. — UI factory (1:1 with the @almadar/ui module-card pattern).\"\n;; @capabilities \"course module card, lesson card, curriculum unit card, learning-path step card\"\norbital ModuleCardOrbital {\n  entity ModuleCardItem [runtime] {\n    id : string!\n  }\n\n  trait ModuleCardRender -> @rebindable ModuleCardItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          data: @config.data\n          type: module-card\n        })\n    }\n\n    config {\n      data : object = {}\n        @label \"Data\"\n        @description \"data prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/module-card\" as ModuleCardPage -> ModuleCardRender\n}\n"
