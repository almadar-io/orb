  "source": "",
  "lolo": "app std-tabs \"2.1.0\"\n\"std-tabs — embeddable tab-navigation atom. Renders a tabs strip from @config.tabs ([{id, label, icon?, badge?, content?}]); clicking a tab updates @entity.activeTab so only the matching @trait.X content shows. Events remap at the call site for routing, persistence, analytics.\"\ntype TabSpec = { id : string, label : string!, value : string, icon : string }\norbital TabsItemOrbital {\n    type TabSpec = { id : string!, label : string!, icon : string, badge : string, content : trait }\n\n  entity TabsItem [runtime] {\n    id : string!\n    activeTab : string @description \"The currently selected tab's identifier.\" @synonyms \"selection, currentTab, highlightedTab\" = \"\"\n    items : [TabSpec] @description \"A collection of tab specifications defining the tab structure.\" @synonyms \"tabs, tab list, tab definitions\" = []\n  }\n\n  trait TabsItemTabs -> @rebindable TabsItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.items @config.tabs)\n        (set @entity.activeTab @config.defaultTab)\n        (render-ui main @config.bodyContent)\n      TAB_CHANGED -> idle\n        (set @entity.items @config.tabs)\n        (set @entity.activeTab ?tabId)\n        (render-ui main @config.bodyContent)\n    }\n\n    emits {\n      TAB_CHANGED -> external {\n        tabId : string!\n      }\n        @description \"Signals a tab selection has occurred.\"\n        @synonyms \"selected, activated, switched\"\n        @tier \"domain\"\n    }\n\n    listens {\n      TAB_CHANGED {\n        tabId : string!\n      }\n        @description \"A tab selection has occurred.\"\n        @synonyms \"selected, activated, switched\"\n        @tier \"domain\"\n    }\n\n    config {\n      tabs : [TabSpec] = [{\n        icon: info\n        id: overview\n        label: Overview\n      }, {\n        icon: list\n        id: details\n        label: Details\n      }, {\n        icon: settings\n        id: settings\n        label: Settings\n      }]\n        @label \"Tabs\"\n        @description \"Tab entries with id, label, icon, badge, and optional content trait\"\n        @tier \"presentation\"\n      defaultTab : string = overview\n        @label \"Default tab\"\n        @description \"Tab id selected on first render\"\n        @tier \"presentation\"\n      variant : \"default\" | \"pills\" | \"underline\" = default\n        @label \"Tab style\"\n        @description \"Visual style of the tab strip\"\n        @tier \"presentation\"\n      orientation : \"horizontal\" | \"vertical\" = horizontal\n        @label \"Orientation\"\n        @description \"Horizontal strip or vertical rail layout\"\n        @tier \"presentation\"\n      bodyContent : render-ui = {\n        activeTab: @entity.activeTab\n        items: @entity.items\n        orientation: @config.orientation\n        tabChangeEvent: TAB_CHANGED\n        type: tabs\n        variant: @config.variant\n      }\n        @label \"Body content tree\"\n        @description \"Render-ui SExpr rendered for the tabs surface. Default is the canonical tabs pattern bound to @entity.items / @entity.activeTab. Layer 3 variants override this with their own tree (segmented-pill bar, vertical sidebar rail, etc.) while inheriting the same trait, state machine, emits, and listens.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/tabsitems\" as TabsItemTabsPage -> TabsItemTabs\n}"
