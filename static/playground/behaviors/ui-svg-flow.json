  "source": "",
  "lolo": "app ui-svg-flow \"1.0.0\"\n\"SvgFlow — UI factory (1:1 with the @almadar/ui svg-flow pattern).\"\norbital SvgFlowOrbital {\n  entity SvgFlowItem [runtime] {\n    id : string!\n  }\n\n  trait SvgFlowRender -> @rebindable SvgFlowItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          points: @config.points\n          color: @config.color\n          strokeWidth: @config.strokeWidth\n          animated: @config.animated\n          opacity: @config.opacity\n          className: @config.className\n          asRoot: @config.asRoot\n          width: @config.width\n          height: @config.height\n          type: svg-flow\n        })\n    }\n\n    config {\n      points : [[number]] = []\n        @label \"Points\"\n        @description \"points prop\"\n        @tier \"presentation\"\n      color : string = \"var(--color-primary)\"\n        @label \"Color\"\n        @description \"color prop\"\n        @tier \"presentation\"\n      strokeWidth : number = 1.5\n        @label \"Stroke Width\"\n        @description \"strokeWidth prop\"\n        @tier \"presentation\"\n      animated : boolean = false\n        @label \"Animated\"\n        @description \"animated prop\"\n        @tier \"presentation\"\n      opacity : number = 1\n        @label \"Opacity\"\n        @description \"opacity prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      asRoot : boolean = true\n        @label \"As Root\"\n        @description \"When true (default), wraps in a standalone <svg> so the shape is visible without a parent SVG context.\"\n        @tier \"presentation\"\n      width : number = 100\n        @label \"Width\"\n        @description \"width prop\"\n        @tier \"presentation\"\n      height : number = 100\n        @label \"Height\"\n        @description \"height prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/svg-flow\" as SvgFlowPage -> SvgFlowRender\n}\n"
}