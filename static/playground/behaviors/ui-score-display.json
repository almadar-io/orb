  "source": "",
  "lolo": "app ui-score-display \"1.0.0\"\n\"ScoreDisplay — UI factory (1:1 with the @almadar/ui score-display pattern).\"\norbital ScoreDisplayOrbital {\n  type ScoreDisplayAssetUrl = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n\n  entity ScoreDisplayItem [runtime] {\n    id : string!\n  }\n\n  trait ScoreDisplayRender -> @rebindable ScoreDisplayItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          assetUrl: @config.assetUrl\n          value: @config.value\n          score: @config.score\n          label: @config.label\n          icon: @config.icon\n          size: @config.size\n          className: @config.className\n          locale: @config.locale\n          type: score-display\n        })\n    }\n\n    config {\n      assetUrl : ScoreDisplayAssetUrl\n        @label \"Asset Url\"\n        @description \"Sprite asset — takes precedence over icon when provided\"\n        @tier \"presentation\"\n      value : number = 1\n        @label \"Value\"\n        @description \"Current score value\"\n        @tier \"presentation\"\n      score : number\n        @label \"Score\"\n        @description \"Alias for value — common schema binding name\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Label to display before score\"\n        @tier \"presentation\"\n      icon : icon\n        @label \"Icon\"\n        @description \"Icon component or emoji\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" | \"xl\" = md\n        @label \"Size\"\n        @description \"Size variant\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      locale : string = \"en-US\"\n        @label \"Locale\"\n        @description \"Number formatting locale\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/score-display\" as ScoreDisplayPage -> ScoreDisplayRender\n}\n"
}