  "lolo": "app ui-master-detail-layout \"1.0.0\"\n\"MasterDetailLayout — UI factory (1:1 with the @almadar/ui master-detail-layout pattern).\"\norbital MasterDetailLayoutOrbital {\n  entity MasterDetailLayoutItem [runtime] {\n    id : string!\n  }\n\n  trait MasterDetailLayoutRender -> @rebindable MasterDetailLayoutItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          master: @config.master\n          detail: @config.detail\n          emptyDetail: @config.emptyDetail\n          hasSelection: @config.hasSelection\n          masterWidth: @config.masterWidth\n          className: @config.className\n          masterClassName: @config.masterClassName\n          detailClassName: @config.detailClassName\n          type: master-detail-layout\n        })\n    }\n\n    config {\n      master : node\n        @label \"Master\"\n        @description \"Master panel content (usually a list)\"\n        @tier \"presentation\"\n      detail : node\n        @label \"Detail\"\n        @description \"Detail panel content\"\n        @tier \"presentation\"\n      emptyDetail : node\n        @label \"Empty Detail\"\n        @description \"Content shown when nothing is selected\"\n        @tier \"presentation\"\n      hasSelection : boolean = false\n        @label \"Has Selection\"\n        @description \"Whether an item is currently selected\"\n        @tier \"presentation\"\n      masterWidth : string = \"350px\"\n        @label \"Master Width\"\n        @description \"Width of master panel (e.g., '350px', '30%')\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      masterClassName : string\n        @label \"Master Class Name\"\n        @description \"Class for master pane\"\n        @tier \"presentation\"\n      detailClassName : string\n        @label \"Detail Class Name\"\n        @description \"Class for detail pane\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/master-detail-layout\" as MasterDetailLayoutPage -> MasterDetailLayoutRender\n}\n"
