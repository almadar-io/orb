  "source": "",
  "lolo": "app ui-rich-block-editor \"1.0.0\"\n\"RichBlockEditor — UI factory (1:1 with the @almadar/ui rich-block-editor pattern).\"\norbital RichBlockEditorOrbital {\n    type RichBlockEditorLoaded = Event { data : [RichBlockEditorItem] } \"RichBlockEditor rows finished loading; payload.data holds the collection\"\n\n  entity RichBlockEditorItem [runtime] {\n    id : string!\n  }\n\n  trait RichBlockEditorRender -> @rebindable RichBlockEditorItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (fetch RichBlockEditorItem { emit: { success: RichBlockEditorLoaded } })\n        (render-ui main {\n          initialBlocks: @entity\n          onChange: @config.onChange\n          changeEvent: @config.changeEvent\n          readOnly: @config.readOnly\n          placeholder: @config.placeholder\n          enableBlocks: @config.enableBlocks\n          showToolbar: @config.showToolbar\n          className: @config.className\n          type: rich-block-editor\n        })\n      RichBlockEditorLoaded -> idle\n        (render-ui main {\n          initialBlocks: @payload.data\n          onChange: @config.onChange\n          changeEvent: @config.changeEvent\n          readOnly: @config.readOnly\n          placeholder: @config.placeholder\n          enableBlocks: @config.enableBlocks\n          showToolbar: @config.showToolbar\n          className: @config.className\n          type: rich-block-editor\n        })\n    }\n\n    emits {\n      @config.onChange -> external {\n        blocks : [object]\n      }\n        @description \"onChange prop\"\n        @tier \"essential\"\n      RichBlockEditorLoaded\n        @description \"RichBlockEditor rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      onChange : string = \"CHANGE\"\n        @label \"On Change\"\n        @description \"onChange prop\"\n        @tier \"presentation\"\n      changeEvent : string = \"CHANGE\"\n        @label \"Change Event\"\n        @description \"changeEvent prop\"\n        @tier \"presentation\"\n      readOnly : boolean = false\n        @label \"Read Only\"\n        @description \"readOnly prop\"\n        @tier \"presentation\"\n      placeholder : string\n        @label \"Placeholder\"\n        @description \"placeholder prop\"\n        @tier \"presentation\"\n      enableBlocks : boolean = true\n        @label \"Enable Blocks\"\n        @description \"Opt-in to the Notion-style block authoring chrome (insert toolbar, per-row +/menu gutter, turn-into menu). Off by default: the editor renders as a plain rich text surface that edits block content inline without any add-block affordances.\"\n        @tier \"presentation\"\n      showToolbar : boolean = true\n        @label \"Show Toolbar\"\n        @description \"showToolbar prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/rich-block-editor\" as RichBlockEditorPage -> RichBlockEditorRender\n}\n"
