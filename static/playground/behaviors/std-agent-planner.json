  "source": "",
  "lolo": "app std-agent-planner \"1.0.0\"\n\"Agent planner molecule — recall memories, then generate a plan from the prompt + recalled context.\"\n\ntype MemoryRecord = { id: string!, content: string!, category: string!, strength: number }\n\norbital AgentPlannerOrbital {\n\n  entity PlannerPlan [runtime] {\n    prompt : string = \"\"\n    memories : [MemoryRecord] = []\n    plan : string = \"\"\n    status : \"idle\" | \"planning\" | \"planned\" = idle\n  }\n\n  trait PlannerExecution -> PlannerPlan [lifecycle, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.prompt \"\")\n        (set @entity.memories [])\n        (set @entity.plan \"\")\n        (set @entity.status idle)\n      PLAN -> recalling\n        (set @entity.prompt ?prompt)\n        (memory/recall @entity.prompt { emit: { success: MEMORIES_RECALLED, failure: RECALL_FAILED } })\n    }\n\n    state recalling {\n      MEMORIES_RECALLED -> planning\n        (set @entity.memories ?result)\n        (llm/generate @entity.prompt { emit: { success: PLAN_GENERATED, failure: PLAN_GENERATION_FAILED } })\n      RECALL_FAILED -> planning\n        (set @entity.memories [])\n        (llm/generate @entity.prompt { emit: { success: PLAN_GENERATED, failure: PLAN_GENERATION_FAILED } })\n    }\n\n    state planning {\n      PLAN_GENERATED -> planned\n        (set @entity.plan ?result)\n        (set @entity.status planned)\n        (emit PLANNED { plan: @entity.plan, memoryCount: @entity.memories })\n      PLAN_GENERATION_FAILED -> planned\n        (set @entity.plan \"\")\n        (set @entity.status planned)\n        (emit PLANNED { plan: @entity.plan, memoryCount: @entity.memories })\n    }\n\n    state planned {\n      INIT -> planned\n        (set @entity.status planned)\n      RESET -> idle\n        (set @entity.plan \"\")\n        (set @entity.memories [])\n        (set @entity.prompt \"\")\n        (set @entity.status idle)\n    }\n\n    emits {\n      PLANNED {\n        plan : string!\n        memoryCount : number!\n      }\n      MEMORIES_RECALLED {\n        result : [MemoryRecord]!\n      }\n      PLAN_GENERATED {\n        result : string!\n      }\n    }\n\n    listens {\n      PLAN {\n        prompt : string!\n      }\n    }\n  }\n\n  trait PlannerListener -> PlannerPlan [lifecycle, instance] {\n    initial: waiting\n\n    state waiting {\n      INIT -> waiting\n        (set @entity.status idle)\n      PLANNED -> ready\n        (set @entity.status planned)\n    }\n\n    state ready {\n      INIT -> ready\n        (set @entity.status planned)\n      RESET -> waiting\n        (set @entity.status idle)\n    }\n\n    listens {\n      PlannerExecution.PLANNED -> PLANNED\n      RESET\n    }\n  }\n\n  page \"/agent-planner\" as AgentPlannerPage -> PlannerExecution, PlannerListener\n}\n"
}