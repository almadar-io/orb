  "source": "",
  "lolo": "app std-agent-completion \"1.0.0\"\n\"Wraps llm/generate — takes a prompt, returns generated text.\"\norbital AgentCompletionOrbital {\n\n  entity Completion [runtime] {\n    prompt : string = \"\"\n    response : string = \"\"\n    status : \"idle\" | \"done\" = idle\n  }\n\n  trait CompletionGeneration -> Completion [lifecycle, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.prompt \"\")\n        (set @entity.response \"\")\n        (set @entity.status idle)\n      GENERATE -> generating\n        (set @entity.prompt ?prompt)\n        (llm/generate @entity.prompt { emit: { success: GENERATED, failure: GENERATION_FAILED } })\n    }\n\n    state generating {\n      GENERATED -> done\n        (set @entity.response ?result)\n        (set @entity.status done)\n        (emit COMPLETED { response: @entity.response })\n      GENERATION_FAILED -> done\n        (set @entity.response \"\")\n        (set @entity.status done)\n    }\n\n    state done {\n      INIT -> done\n        (set @entity.status done)\n      RESET -> idle\n        (set @entity.response \"\")\n        (set @entity.prompt \"\")\n        (set @entity.status idle)\n    }\n\n    emits {\n      COMPLETED {\n        response : string!\n      }\n      GENERATED {\n        result : string!\n      }\n    }\n\n    listens {\n      GENERATE {\n        prompt : string!\n      }\n    }\n  }\n\n  trait CompletionReady -> Completion [lifecycle, instance] {\n    initial: waiting\n\n    state waiting {\n      INIT -> waiting\n        (set @entity.status idle)\n      COMPLETED -> ready\n        (set @entity.status done)\n    }\n\n    state ready {\n      INIT -> ready\n        (set @entity.status done)\n      RESET -> waiting\n        (set @entity.status idle)\n    }\n\n    listens {\n      CompletionGeneration.COMPLETED -> COMPLETED\n      RESET\n    }\n  }\n\n  page \"/agent-completion\" as AgentCompletionPage -> CompletionGeneration, CompletionReady\n}\n"
}