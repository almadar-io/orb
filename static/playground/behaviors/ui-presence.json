  "source": "",
  "lolo": "app ui-presence \"1.0.0\"\n\"Presence — UI factory (1:1 with the @almadar/ui presence pattern).\"\norbital PresenceOrbital {\n  entity PresenceItem [runtime] {\n    id : string!\n  }\n\n  trait PresenceRender -> @rebindable PresenceItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          show: @config.show\n          className: @config.className\n          children: @config.children\n          type: presence\n        })\n    }\n\n    config {\n      show : boolean = false\n        @label \"Show\"\n        @description \"When false, the exit animation runs, then children unmount.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"children prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/presence\" as PresencePage -> PresenceRender\n}\n"
