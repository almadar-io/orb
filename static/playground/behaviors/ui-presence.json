  "source": "",
  "lolo": "app ui-presence \"1.0.0\"\n\"Presence — UI factory (1:1 with the @almadar/ui presence pattern).\"\n;; @pattern \"presence\"\norbital PresenceOrbital {\n  entity PresenceItem [runtime] {\n    id : string!\n  }\n\n  trait PresenceRender -> @rebindable PresenceItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          animation: @config.animation\n          animate: @config.animate\n          onExited: @config.onExited\n          show: @config.show\n          className: @config.className\n          children: @config.children\n          type: presence\n        })\n    }\n\n    emits {\n      @config.onExited -> external { }\n        @description \"Fired after the exit animation completes (before unmount).\"\n        @tier \"essential\"\n    }\n\n    config {\n      animation : \"modal\" | \"overlay\" | \"slide-up\" | \"drawer\" | \"popover\" | \"toast\" | \"fade\" | \"page\" = modal\n        @label \"Animation\"\n        @description \"Which motion preset to use (maps to `animate-<name>-in/out`).\"\n        @tier \"presentation\"\n      animate : boolean\n        @label \"Animate\"\n        @description \"Per-instance opt-out. Global opt-out is `--motion-enable` / reduced-motion. @default true\"\n        @tier \"presentation\"\n      onExited : event = \"EXITED\"\n        @label \"On Exited\"\n        @description \"Fired after the exit animation completes (before unmount).\"\n        @tier \"presentation\"\n      show : boolean = false\n        @label \"Show\"\n        @description \"When false, the exit animation runs, then children unmount.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"children prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/presence\" as PresencePage -> PresenceRender\n}\n"
}