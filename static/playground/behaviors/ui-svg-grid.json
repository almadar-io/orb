  "source": "",
  "lolo": "app ui-svg-grid \"1.0.0\"\n\"SvgGrid — UI factory (1:1 with the @almadar/ui svg-grid pattern).\"\norbital SvgGridOrbital {\n  entity SvgGridItem [runtime] {\n    id : string!\n  }\n\n  trait SvgGridRender -> @rebindable SvgGridItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          x: @config.x\n          y: @config.y\n          cols: @config.cols\n          rows: @config.rows\n          spacing: @config.spacing\n          nodeRadius: @config.nodeRadius\n          color: @config.color\n          opacity: @config.opacity\n          className: @config.className\n          highlights: @config.highlights\n          asRoot: @config.asRoot\n          width: @config.width\n          height: @config.height\n          type: svg-grid\n        })\n    }\n\n    config {\n      x : number = 10\n        @label \"X\"\n        @description \"x prop\"\n        @tier \"presentation\"\n      y : number = 10\n        @label \"Y\"\n        @description \"y prop\"\n        @tier \"presentation\"\n      cols : number = 4\n        @label \"Cols\"\n        @description \"cols prop\"\n        @tier \"presentation\"\n      rows : number = 3\n        @label \"Rows\"\n        @description \"rows prop\"\n        @tier \"presentation\"\n      spacing : number = 20\n        @label \"Spacing\"\n        @description \"spacing prop\"\n        @tier \"presentation\"\n      nodeRadius : number = 3\n        @label \"Node Radius\"\n        @description \"nodeRadius prop\"\n        @tier \"presentation\"\n      color : string = \"var(--color-primary)\"\n        @label \"Color\"\n        @description \"color prop\"\n        @tier \"presentation\"\n      opacity : number = 1\n        @label \"Opacity\"\n        @description \"opacity prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      highlights : [number] = []\n        @label \"Highlights\"\n        @description \"highlights prop\"\n        @tier \"presentation\"\n      asRoot : boolean = true\n        @label \"As Root\"\n        @description \"When true (default), wraps in a standalone <svg> so the shape is visible without a parent SVG context.\"\n        @tier \"presentation\"\n      width : number = 100\n        @label \"Width\"\n        @description \"width prop\"\n        @tier \"presentation\"\n      height : number = 100\n        @label \"Height\"\n        @description \"height prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/svg-grid\" as SvgGridPage -> SvgGridRender\n}\n"
