  "source": "",
  "lolo": "app ui-marketing-footer \"1.0.0\"\n\"MarketingFooter — UI factory (1:1 with the @almadar/ui marketing-footer pattern).\"\norbital MarketingFooterOrbital {\n  type MarketingFooterColumnsItem = {\n    title : string!\n    items : [MarketingFooterColumnsItemItemsItem]!\n  }\n  type MarketingFooterColumnsItemItemsItem = {\n    label : string!\n    href : string!\n  }\n  type MarketingFooterLogo = {\n    src : asset!\n    alt : string!\n    href : string\n  }\n\n  entity MarketingFooterItem [runtime] {\n    id : string!\n  }\n\n  trait MarketingFooterRender -> @rebindable MarketingFooterItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          columns: @config.columns\n          copyright: @config.copyright\n          logo: @config.logo\n          className: @config.className\n          type: marketing-footer\n        })\n    }\n\n    config {\n      columns : [MarketingFooterColumnsItem] = [{ title: \"Title\", items: [{ label: \"Label\", href: \"Href\" }, { label: \"Label 2\", href: \"Href 2\" }] }, { title: \"Title 2\", items: [{ label: \"Label\", href: \"Href\" }, { label: \"Label 2\", href: \"Href 2\" }] }]\n        @label \"Columns\"\n        @description \"columns prop\"\n        @tier \"presentation\"\n      copyright : string\n        @label \"Copyright\"\n        @description \"copyright prop\"\n        @tier \"presentation\"\n      logo : MarketingFooterLogo\n        @label \"Logo\"\n        @description \"logo prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/marketing-footer\" as MarketingFooterPage -> MarketingFooterRender\n}\n"
}