  "source": "",
  "lolo": "app ui-svg-lobe \"1.0.0\"\n\"SvgLobe — UI factory (1:1 with the @almadar/ui svg-lobe pattern).\"\norbital SvgLobeOrbital {\n  entity SvgLobeItem [runtime] {\n    id : string!\n  }\n\n  trait SvgLobeRender -> @rebindable SvgLobeItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          cx: @config.cx\n          cy: @config.cy\n          rx: @config.rx\n          ry: @config.ry\n          rotation: @config.rotation\n          shells: @config.shells\n          color: @config.color\n          opacity: @config.opacity\n          className: @config.className\n          asRoot: @config.asRoot\n          width: @config.width\n          height: @config.height\n          type: svg-lobe\n        })\n    }\n\n    config {\n      cx : number = 50\n        @label \"Cx\"\n        @description \"cx prop\"\n        @tier \"presentation\"\n      cy : number = 50\n        @label \"Cy\"\n        @description \"cy prop\"\n        @tier \"presentation\"\n      rx : number = 14\n        @label \"Rx\"\n        @description \"rx prop\"\n        @tier \"presentation\"\n      ry : number = 20\n        @label \"Ry\"\n        @description \"ry prop\"\n        @tier \"presentation\"\n      rotation : number = 0\n        @label \"Rotation\"\n        @description \"rotation prop\"\n        @tier \"presentation\"\n      shells : number = 2\n        @label \"Shells\"\n        @description \"shells prop\"\n        @tier \"presentation\"\n      color : string = \"var(--color-primary)\"\n        @label \"Color\"\n        @description \"color prop\"\n        @tier \"presentation\"\n      opacity : number = 1\n        @label \"Opacity\"\n        @description \"opacity prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      asRoot : boolean = true\n        @label \"As Root\"\n        @description \"When true (default), wraps in a standalone <svg> so the shape is visible without a parent SVG context.\"\n        @tier \"presentation\"\n      width : number = 100\n        @label \"Width\"\n        @description \"width prop\"\n        @tier \"presentation\"\n      height : number = 100\n        @label \"Height\"\n        @description \"height prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/svg-lobe\" as SvgLobePage -> SvgLobeRender\n}\n"
}