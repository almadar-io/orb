  "source": "",
  "lolo": "app ui-geometric-pattern \"1.0.0\"\n\"GeometricPattern — UI factory (1:1 with the @almadar/ui geometric-pattern pattern).\"\n;; @pattern \"geometric-pattern\"\norbital GeometricPatternOrbital {\n  entity GeometricPatternItem [runtime] {\n    id : string!\n  }\n\n  trait GeometricPatternRender -> @rebindable GeometricPatternItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          variant: @config.variant\n          mode: @config.mode\n          opacity: @config.opacity\n          color: @config.color\n          scale: @config.scale\n          strokeWidth: @config.strokeWidth\n          children: @config.children\n          className: @config.className\n          type: geometric-pattern\n        })\n    }\n\n    config {\n      variant : \"star8\" | \"star6\" | \"khatam\" | \"star10\" | \"star12\" | \"rosette-double\" | \"rosette-filled\" | \"seigaiha\" | \"greek-key\" | \"celtic-knot\" | \"kolam\" | \"arch\" | \"arabesque-vine\" | \"arabesque-net\" = star8\n        @label \"Variant\"\n        @description \"Which geometric tile design\"\n        @tier \"presentation\"\n      mode : \"background\" | \"left\" | \"right\" | \"dual\" | \"around\" | \"frame\" = background\n        @label \"Mode\"\n        @description \"Layout mode\"\n        @tier \"presentation\"\n      opacity : number = 0.06\n        @label \"Opacity\"\n        @description \"Overall opacity (default: 0.06)\"\n        @tier \"presentation\"\n      color : string = \"var(--color-primary)\"\n        @label \"Color\"\n        @description \"Stroke color passed to PatternTile\"\n        @tier \"presentation\"\n      scale : number = 1\n        @label \"Scale\"\n        @description \"Tile scale multiplier (default: 1)\"\n        @tier \"presentation\"\n      strokeWidth : number = 0.5\n        @label \"Stroke Width\"\n        @description \"Stroke width passed to PatternTile\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Content to wrap (used in frame mode)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/geometric-pattern\" as GeometricPatternPage -> GeometricPatternRender\n}\n"
}