            "ticks": [
              {
                "name": "reactionTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "set",
                    "@entity.phase",
                    [
                      "+",
                      "@entity.phase",
                      4
                    ]
                  ],
                  [
                    "set",
                    "@entity.atoms",
                    [
                      "array/map",
                      "@entity.atoms",
                      [
                        "fn",
                        "a",
                        [
                          "let",
                          [
                            [
                              "t",
                              [
                                "/",
                                [
                                  "math/abs",
                                  [
                                    "-",
                                    [
                                      "math/mod",
                                      "@entity.phase",
                                      200
                                    ],
                                    [
                                      "/",
                                      200,
                                      2
                                    ]
                                  ]
                                ],
                                [
                                  "/",
                                  200,
                                  2
                                ]
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "nx",
                                [
                                  "+",
                                  [
                                    "object/get",
                                    "@a",
                                    "home"
                                  ],
                                  [
                                    "*",
                                    [
                                      "-",
                                      [
                                        "/",
                                        600,
                                        2
                                      ],
                                      [
                                        "object/get",
                                        "@a",
                                        "home"
                                      ]
                                    ],
                                    "@t"
                                  ]
                                ]
                              ]
                            ],
                            [
                              "object/merge",
                              "@a",
                              {
                                "x": "@nx"
                              }
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "height": 400,
                      "width": 600,
                      "type": "chemistry-canvas",
                      "bonds": [
                        {
                          "color": "#94a3b8",
                          "from": "a1",
                          "type": "single",
                          "to": "b1"
                        },
                        {
                          "color": "#94a3b8",
                          "to": "b2",
                          "from": "a2",
                          "type": "single"
                        },
                        {
                          "from": "a3",
                          "type": "single",
                          "color": "#94a3b8",
                          "to": "b3"
                        },
                        {
                          "type": "single",
