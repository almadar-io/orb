{
  "name": "std-algo-quicksort",
  "description": "Iterative quicksort engine — one Lomuto micro-step per tick over a bar array on algorithm-canvas, driven by an explicit range stack; composed by a learning orbital via `uses`.",
  "level": "atom",
  "topic": "ui/learning",
  "schema": {
    "name": "std-algo-quicksort",
    "version": "1.0.0",
    "description": "Iterative quicksort engine — one Lomuto micro-step per tick over a bar array on algorithm-canvas, driven by an explicit range stack; composed by a learning orbital via `uses`.",
    "orbitals": [
      {
        "name": "QuickSortEngineOrbital",
        "entity": {
          "name": "QuickScene",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "bars",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "name": "value",
                    "type": "number",
                    "required": true
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  }
                }
              }
            },
            {
              "name": "stack",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "hi": {
                    "name": "hi",
                    "type": "number",
                    "required": true
                  },
                  "lo": {
                    "name": "lo",
                    "type": "number",
                    "required": true
                  }
                }
              }
            },
            {
              "name": "lo",
              "type": "number",
              "default": 0
            },
            {
              "name": "hi",
              "type": "number",
              "default": 0
            },
            {
              "name": "pivot",
              "type": "number",
              "default": 0
            },
            {
              "name": "si",
              "type": "number",
              "default": 0
            },
            {
              "name": "j",
              "type": "number",
              "default": 0
            },
            {
              "name": "active",
              "type": "boolean",
              "default": false
            },
            {
              "name": "done",
              "type": "boolean",
              "default": false
            },
            {
              "name": "running",
              "type": "boolean",
              "default": true
            },
            {
              "name": "sEmpty",
              "type": "boolean",
              "default": false
            },
            {
              "name": "topLo",
              "type": "number",
              "default": 0
            },
            {
              "name": "topHi",
              "type": "number",
              "default": 0
            },
            {
              "name": "cmpLess",
              "type": "boolean",
              "default": false
            },
            {
              "name": "doSwap",
              "type": "boolean",
              "default": false
            },
            {
              "name": "swapA",
              "type": "number",
              "default": 0
            },
            {
              "name": "swapB",
              "type": "number",
              "default": 0
            }
          ]
        },
        "traits": [
          {
            "name": "QuickSortSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "active",
                "bars",
                "cmpLess",
                "doSwap",
                "done",
                "hi",
                "j",
                "lo",
                "pivot",
                "running",
                "sEmpty",
                "si",
                "stack",
                "swapA",
                "swapB",
                "topHi",
                "topLo"
              ]
            },
            "category": "interaction",
            "linkedEntity": "QuickScene",
            "emits": [
              {
                "event": "BARS_UPDATED",
                "description": "The current bar array each step — a composed listener (a mirror canvas, a readout) can subscribe; a harmless no-op standalone.",
                "synonyms": "tick, frame, step, redraw, compare, swap, partition, pivot",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "bars",
                    "type": "[AlgoBar]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "BARS_UPDATED",
                  "name": "Bars Updated",
                  "description": "The current bar array each step — a composed listener (a mirror canvas, a readout) can subscribe; a harmless no-op standalone.",
                  "synonyms": "tick, frame, step, redraw, compare, swap, partition, pivot",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "bars",
                      "type": "[AlgoBar]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.bars",
                      [
                        {
                          "value": 5,
                          "color": "#3b82f6",
                          "label": "5"
                        },
                        {
                          "value": 2,
                          "color": "#3b82f6",
                          "label": "2"
                        },
                        {
                          "value": 8,
                          "label": "8",
                          "color": "#3b82f6"
                        },
                        {
                          "label": "1",
                          "value": 1,
                          "color": "#3b82f6"
                        },
                        {
                          "label": "9",
                          "color": "#3b82f6",
                          "value": 9
                        },
                        {
                          "color": "#3b82f6",
                          "value": 3,
                          "label": "3"
                        },
                        {
                          "color": "#3b82f6",
                          "value": 7,
                          "label": "7"
                        },
                        {
                          "color": "#3b82f6",
                          "label": "4",
                          "value": 4
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.stack",
                      [
                        {
                          "lo": 0,
                          "hi": [
                            "-",
                            [
                              "array/len",
                              [
                                {
                                  "value": 5,
                                  "color": "#3b82f6",
                                  "label": "5"
                                },
                                {
                                  "value": 2,
                                  "color": "#3b82f6",
                                  "label": "2"
                                },
                                {
                                  "value": 8,
                                  "label": "8",
                                  "color": "#3b82f6"
                                },
                                {
                                  "label": "1",
                                  "value": 1,
                                  "color": "#3b82f6"
                                },
                                {
                                  "label": "9",
                                  "color": "#3b82f6",
                                  "value": 9
                                },
                                {
                                  "color": "#3b82f6",
                                  "value": 3,
                                  "label": "3"
                                },
                                {
                                  "color": "#3b82f6",
                                  "value": 7,
                                  "label": "7"
                                },
                                {
                                  "color": "#3b82f6",
                                  "label": "4",
                                  "value": 4
                                }
                              ]
                            ],
                            1
                          ]
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.lo",
                      0
                    ],
                    [
                      "set",
                      "@entity.hi",
                      0
                    ],
                    [
                      "set",
                      "@entity.pivot",
                      0
                    ],
                    [
                      "set",
                      "@entity.si",
                      0
                    ],
                    [
                      "set",
                      "@entity.j",
                      0
                    ],
                    [
                      "set",
                      "@entity.active",
                      false
                    ],
                    [
                      "set",
                      "@entity.done",
                      false
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "bars": "@entity.bars",
                        "width": 600,
                        "height": 400,
                        "type": "algorithm-canvas",
                        "backgroundColor": "#f8fafc"
                      }
                    ],
                    [
                      "emit",
                      "BARS_UPDATED",
                      {
                        "bars": "@entity.bars"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "quickTick",
                "interval": 350,
                "guard": [
                  "and",
                  "@entity.running",
                  [
                    "not",
                    "@entity.done"
                  ]
                ],
                "effects": [
                  [
                    "set",
                    "@entity.sEmpty",
                    [
                      "==",
                      [
                        "array/len",
                        "@entity.stack"
                      ],
                      0
                    ]
                  ],
                  [
                    "set",
                    "@entity.topLo",
                    [
                      "if",
                      "@entity.sEmpty",
                      0,
                      [
                        "object/get",
                        [
                          "array/last",
                          "@entity.stack"
                        ],
                        "lo"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.topHi",
                    [
                      "if",
                      "@entity.sEmpty",
                      0,
                      [
                        "object/get",
                        [
                          "array/last",
                          "@entity.stack"
                        ],
                        "hi"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.cmpLess",
                    [
                      "<",
                      [
                        "object/get",
                        [
                          "array/nth",
                          "@entity.bars",
                          "@entity.j"
                        ],
                        "value"
                      ],
                      "@entity.pivot"
                    ]
                  ],
                  [
                    "set",
                    "@entity.doSwap",
                    [
                      "and",
                      "@entity.active",
                      [
                        "or",
                        [
                          "==",
                          "@entity.j",
                          "@entity.hi"
                        ],
                        "@entity.cmpLess"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.swapA",
                    "@entity.si"
                  ],
                  [
                    "set",
                    "@entity.swapB",
                    [
                      "if",
                      [
                        "==",
                        "@entity.j",
                        "@entity.hi"
                      ],
                      "@entity.hi",
                      "@entity.j"
                    ]
                  ],
                  [
                    "set",
                    "@entity.bars",
                    [
                      "array/map",
                      "@entity.bars",
                      [
                        "object/merge",
                        "@item",
                        {
                          "value": [
                            "if",
                            [
                              "and",
                              "@entity.doSwap",
                              [
                                "==",
                                "@index",
                                "@entity.swapA"
                              ]
                            ],
                            [
                              "object/get",
                              [
                                "array/nth",
                                "@entity.bars",
                                "@entity.swapB"
                              ],
                              "value"
                            ],
                            [
                              "if",
                              [
                                "and",
                                "@entity.doSwap",
                                [
                                  "==",
                                  "@index",
                                  "@entity.swapB"
                                ]
                              ],
                              [
                                "object/get",
                                [
                                  "array/nth",
                                  "@entity.bars",
                                  "@entity.swapA"
                                ],
                                "value"
                              ],
                              [
                                "object/get",
                                "@item",
                                "value"
                              ]
                            ]
                          ],
                          "color": [
                            "if",
                            [
                              "and",
                              [
                                "not",
                                "@entity.active"
                              ],
                              "@entity.sEmpty"
                            ],
                            "#22c55e",
                            [
                              "if",
                              [
                                "and",
                                "@entity.active",
                                [
                                  ">=",
                                  "@index",
                                  "@entity.lo"
                                ],
                                [
                                  "<=",
                                  "@index",
                                  "@entity.hi"
                                ]
                              ],
                              [
                                "if",
                                [
                                  "==",
                                  "@index",
                                  "@entity.hi"
                                ],
                                "#a855f7",
                                [
                                  "if",
                                  [
                                    "==",
                                    "@index",
                                    "@entity.j"
                                  ],
                                  "#f59e0b",
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@index",
                                      "@entity.si"
                                    ],
                                    "#fbbf24",
                                    "#3b82f6"
                                  ]
                                ]
                              ],
                              "#3b82f6"
                            ]
                          ]
                        }
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.stack",
                    [
                      "if",
                      [
                        "and",
                        "@entity.active",
                        [
                          "==",
                          "@entity.j",
                          "@entity.hi"
                        ]
                      ],
                      [
                        "array/append",
                        [
                          "array/append",
                          "@entity.stack",
                          {
                            "lo": "@entity.lo",
                            "hi": [
                              "-",
                              "@entity.si",
                              1
                            ]
                          }
                        ],
                        {
                          "hi": "@entity.hi",
                          "lo": [
                            "+",
                            "@entity.si",
                            1
                          ]
                        }
                      ],
                      [
                        "if",
                        [
                          "and",
                          [
                            "not",
                            "@entity.active"
                          ],
                          [
                            "not",
                            "@entity.sEmpty"
                          ]
                        ],
                        [
                          "array/dropLast",
                          "@entity.stack",
                          1
                        ],
                        "@entity.stack"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.lo",
                    [
                      "if",
                      "@entity.active",
                      "@entity.lo",
                      [
                        "if",
                        "@entity.sEmpty",
                        "@entity.lo",
                        "@entity.topLo"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.hi",
                    [
                      "if",
                      "@entity.active",
                      "@entity.hi",
                      [
                        "if",
                        "@entity.sEmpty",
                        "@entity.hi",
                        "@entity.topHi"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.pivot",
                    [
                      "if",
                      "@entity.active",
                      "@entity.pivot",
                      [
                        "if",
                        [
                          "and",
                          [
                            "not",
                            "@entity.sEmpty"
                          ],
                          [
                            "<",
                            "@entity.topLo",
                            "@entity.topHi"
                          ]
                        ],
                        [
                          "object/get",
                          [
                            "array/nth",
                            "@entity.bars",
                            "@entity.topHi"
                          ],
                          "value"
                        ],
                        "@entity.pivot"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.si",
                    [
                      "if",
                      "@entity.active",
                      [
                        "if",
                        [
                          "==",
                          "@entity.j",
                          "@entity.hi"
                        ],
                        "@entity.si",
                        [
                          "if",
                          "@entity.cmpLess",
                          [
                            "+",
                            "@entity.si",
                            1
                          ],
                          "@entity.si"
                        ]
                      ],
                      [
                        "if",
                        [
                          "and",
                          [
                            "not",
                            "@entity.sEmpty"
                          ],
                          [
                            "<",
                            "@entity.topLo",
                            "@entity.topHi"
                          ]
                        ],
                        "@entity.topLo",
                        "@entity.si"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.j",
                    [
                      "if",
                      "@entity.active",
                      [
                        "if",
                        [
                          "==",
                          "@entity.j",
                          "@entity.hi"
                        ],
                        "@entity.j",
                        [
                          "+",
                          "@entity.j",
                          1
                        ]
                      ],
                      [
                        "if",
                        [
                          "and",
                          [
                            "not",
                            "@entity.sEmpty"
                          ],
                          [
                            "<",
                            "@entity.topLo",
                            "@entity.topHi"
                          ]
                        ],
                        "@entity.topLo",
                        "@entity.j"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.done",
                    [
                      "and",
                      [
                        "not",
                        "@entity.active"
                      ],
                      "@entity.sEmpty"
                    ]
                  ],
                  [
                    "set",
                    "@entity.active",
                    [
                      "if",
                      "@entity.active",
                      [
                        "if",
                        [
                          "==",
                          "@entity.j",
                          "@entity.hi"
                        ],
                        false,
                        true
                      ],
                      [
                        "if",
                        "@entity.sEmpty",
                        false,
                        [
                          "<",
                          "@entity.topLo",
                          "@entity.topHi"
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "backgroundColor": "#f8fafc",
                      "type": "algorithm-canvas",
                      "width": 600,
                      "bars": "@entity.bars",
                      "height": 400
                    }
                  ],
                  [
                    "emit",
                    "BARS_UPDATED",
                    {
                      "bars": "@entity.bars"
                    }
                  ]
                ]
              }
            ],
            "config": {
              "backgroundColor": {
                "type": "string",
                "default": "#f8fafc",
                "label": "Background Color",
                "description": "Canvas background color.",
                "tier": "presentation"
              },
              "bars": {
                "type": "[AlgoBar]",
                "default": [
                  {
                    "value": 5,
                    "color": "#3b82f6",
                    "label": "5"
                  },
                  {
                    "value": 2,
                    "color": "#3b82f6",
                    "label": "2"
                  },
                  {
                    "value": 8,
                    "label": "8",
