                  },
                  {
                    "color": "#3b82f6",
                    "value": 3,
                    "label": "3"
                  },
                  {
                    "color": "#3b82f6",
                    "value": 7,
                    "label": "7"
                  },
                  {
                    "color": "#3b82f6",
                    "label": "4",
                    "value": 4
                  }
                ],
                "label": "Bars",
                "description": "Initial unsorted array; each bar's height is proportional to its value.",
                "tier": "domain",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "name": "value",
                      "type": "number",
                      "required": true
                    },
                    "label": {
                      "name": "label",
                      "type": "string",
                      "required": false
                    },
                    "color": {
                      "name": "color",
                      "type": "string",
                      "required": false
                    }
                  }
                }
              },
              "width": {
                "type": "number",
                "default": 600,
                "label": "Width",
                "description": "Canvas width in pixels.",
                "tier": "presentation"
              },
              "running": {
                "type": "boolean",
                "default": true,
                "label": "Running",
                "description": "When true the tick performs one partition micro-step; toggle to start/pause the sort.",
                "tier": "domain"
              },
              "height": {
                "type": "number",
                "default": 400,
                "label": "Height",
                "description": "Canvas height in pixels.",
                "tier": "presentation"
              }
            },
            "scope": "instance"
          }
        ],
        "pages": [
          {
            "name": "QuickSortEnginePage",
            "path": "/algo-quicksort",
            "traits": [
