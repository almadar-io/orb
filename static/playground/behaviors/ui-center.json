  "source": "",
  "lolo": "app ui-center \"1.0.0\"\n\"Center — UI factory (1:1 with the @almadar/ui center pattern).\"\norbital CenterOrbital {\n  entity CenterItem [runtime] {\n    id : string!\n  }\n\n  trait CenterRender -> @rebindable CenterItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          inline: @config.inline\n          horizontal: @config.horizontal\n          vertical: @config.vertical\n          minHeight: @config.minHeight\n          fullHeight: @config.fullHeight\n          fullWidth: @config.fullWidth\n          className: @config.className\n          style: @config.style\n          children: @config.children\n          type: center\n        })\n    }\n\n    config {\n      inline : boolean = false\n        @label \"Inline\"\n        @description \"Center inline (width fits content) vs block (full width)\"\n        @tier \"presentation\"\n      horizontal : boolean = true\n        @label \"Horizontal\"\n        @description \"Center only horizontally\"\n        @tier \"presentation\"\n      vertical : boolean = true\n        @label \"Vertical\"\n        @description \"Center only vertically\"\n        @tier \"presentation\"\n      minHeight : scalar\n        @label \"Min Height\"\n        @description \"Minimum height (useful for vertical centering)\"\n        @tier \"presentation\"\n      fullHeight : boolean = false\n        @label \"Full Height\"\n        @description \"Fill available height\"\n        @tier \"presentation\"\n      fullWidth : boolean = false\n        @label \"Full Width\"\n        @description \"Fill available width\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Custom class name\"\n        @tier \"presentation\"\n      style : Map string string = {}\n        @label \"Style\"\n        @description \"Inline styles\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Children elements\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/center\" as CenterPage -> CenterRender\n}\n"
}