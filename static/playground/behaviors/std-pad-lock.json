  "lolo": "app std-pad-lock \"1.0.0\"\n\"Headless pad-lock mechanic: floor pads that light when the player steps on them, completing a set when every pad is lit. Listens BODY_MOVED and lights any unlit live pad the player's rect touches (|dx| <= reachX, |dy| <= reachY of the pad center); a lit pad stays lit. Pads may carry a group number (grp 0 = ungrouped, always live): when groups are used, only pads of the lowest uncompleted group are live — pads of later groups refuse to light until the current group finishes, so one sum must be finished before the next. When a group completes the trait emits PAD_GROUP_COMPLETED once for it (first newly completed group reports; the shared entity carries the rest); when every pad in the set is lit it stamps completed and emits PAD_SET_COMPLETED once. The lowest uncompleted group is stamped on the shared entity as currentGrp so boards can pulse exactly the live pads (0 = no group open / ungrouped pads). RESTART unlights every pad and resets the set. Renders nothing; boards draw the pads and read lit from the shared entity (the render authority).\"\norbital PadLockOrbital {\n  type PadLock = {\n    id : string!\n    x : number!\n    y : number!\n    grp : number!\n    lit : boolean\n  }\n\n  entity PadLockData [runtime, shared] {\n    id : string!\n    pads : [PadLock] = []\n    groupsDone : [number] = []\n    currentGrp : number = 0\n    completed : boolean = false\n  }\n\n  trait PadLock -> @rebindable PadLockData [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.pads (array/map @config.pads (fn p (object/merge @p { lit: false }))))\n        (set @entity.groupsDone [])\n        (set @entity.currentGrp 0)\n        (set @entity.completed false)\n\n      BODY_MOVED -> active when @config.running\n        (let ((grpIds (array/reduce (array/map (array/filter @entity.pads (fn p (> (object/get @p grp) 0))) (fn p (object/get @p grp))) [] (fn acc g (if (> (array/len (array/filter @acc (fn x (== @x @g)))) 0) @acc (array/append @acc @g))))))\n        (let ((openGrps (array/filter @grpIds (fn g (< (array/len (array/filter @entity.pads (fn p (and (== (object/get @p grp) @g) (== (object/get @p lit) true))))) (array/len (array/filter @entity.pads (fn p (== (object/get @p grp) @g)))))))))\n        (let ((currentGrp (array/reduce @openGrps 9999 (fn acc g (math/min @acc @g)))))\n        (let ((newPads (array/map @entity.pads (fn p\n          (object/merge @p { lit: (or (object/get @p lit) (and (or (== (object/get @p grp) 0) (== (object/get @p grp) @currentGrp)) (and (<= (math/abs (- @payload.x (object/get @p x))) @config.reachX) (<= (math/abs (- @payload.y (object/get @p y))) @config.reachY)))) })))))\n        (let ((doneNow (array/filter @grpIds (fn g (== (array/len (array/filter @newPads (fn p (and (== (object/get @p grp) @g) (== (object/get @p lit) true))))) (array/len (array/filter @newPads (fn p (== (object/get @p grp) @g)))))))))\n        (let ((newlyGrp (array/filter @doneNow (fn g (== (array/len (array/filter @entity.groupsDone (fn d (== @d @g)))) 0)))))\n        (do\n          (set @entity.pads @newPads)\n          (set @entity.currentGrp (if (== @currentGrp 9999) 0 @currentGrp))\n          (if (> (array/len @newlyGrp) 0)\n            (do\n              (set @entity.groupsDone @doneNow)\n              (emit PAD_GROUP_COMPLETED { grp: (array/first @newlyGrp) }))\n            null)\n          (if (and (== @entity.completed false) (== (array/len (array/filter @newPads (fn p (== (object/get @p lit) false)))) 0))\n            (do\n              (set @entity.completed true)\n              (emit PAD_SET_COMPLETED {}))\n            null))))))))\n\n      RESTART -> active\n        (set @entity.pads (array/map @config.pads (fn p (object/merge @p { lit: false }))))\n        (set @entity.groupsDone [])\n        (set @entity.currentGrp 0)\n        (set @entity.completed false)\n    }\n\n    emits {\n      PAD_GROUP_COMPLETED -> external {\n        grp : number!\n      }\n        @description \"Every pad of one group is lit; fires once per group, in group order — later groups stay dead until the lowest uncompleted group finishes. Boards layer a small fx and unlock the next group's pads.\"\n        @tier \"domain\"\n      PAD_SET_COMPLETED -> external {\n      }\n        @description \"Every pad in the set is lit; fires once per run. Boards layer the treasure fx and spill the bonus reward.\"\n        @tier \"domain\"\n    }\n\n    listens {\n      BODY_MOVED { x : number!, y : number!, vx : number!, vy : number!, grounded : boolean!, skating : boolean!, speed : number! }\n      RESTART { id : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, BODY_MOVED lights touched live pads and reports group/set completion; toggle to freeze every pad as-is.\"\n        @tier \"domain\"\n      pads : [PadLock] = []\n        @label \"Pads\"\n        @description \"One row per floor pad: id, center (x, y in world units), and grp (0 = ungrouped, always live; N = live only while it is the lowest uncompleted group). lit is stamped at runtime.\"\n        @tier \"domain\"\n      reachX : number = 0.7\n        @label \"Reach X\"\n        @description \"Horizontal tolerance (world units) around a pad's center when testing player contact (approximates the body's half-width plus a step).\"\n        @tier \"domain\"\n      reachY : number = 1.2\n        @label \"Reach Y\"\n        @description \"Vertical tolerance (world units) around a pad's center when testing player contact (covers skating over the surface the pad sits on).\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/pad-lock\" as PadLockPage -> PadLock\n}\n"
}