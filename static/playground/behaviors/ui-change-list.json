  "source": "",
  "lolo": "app ui-change-list \"1.0.0\"\n\"The plain-language changes in one version (added / modified / removed). — UI factory (1:1 with the @almadar/ui change-list pattern).\"\n;; @capabilities \"change summary, what changed, version changes, diff summary, release notes list, modification list\"\n;; @pattern \"change-list\"\norbital ChangeListOrbital {\n  type ChangeListChangesItem = {\n    type : \"added\" | \"modified\" | \"removed\"!\n    title : string!\n    description : string\n    before : string\n    after : string\n  }\n\n  entity ChangeListItem [runtime] {\n    id : string!\n  }\n\n  trait ChangeListRender -> @rebindable ChangeListItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          changes: @config.changes\n          inspectEvent: @config.inspectEvent\n          className: @config.className\n          type: change-list\n        })\n    }\n\n    emits {\n      @config.inspectEvent -> external {\n        title : string!\n        type : \"added\" | \"modified\" | \"removed\"!\n      }\n        @description \"Emitted by a change's Inspect button. Payload: { title, type }.\"\n        @tier \"essential\"\n    }\n\n    config {\n      changes : [ChangeListChangesItem] = [{ type: added, title: \"Title\", description: \"Description\", before: \"Before\", after: \"After\" }, { type: modified, title: \"Title 2\", description: \"Description 2\", before: \"Before 2\", after: \"After 2\" }]\n        @label \"Changes\"\n        @description \"The changes. Accepts a typed list or a render-ui payload binding.\"\n        @tier \"presentation\"\n      inspectEvent : event = \"INSPECT\"\n        @label \"Inspect Event\"\n        @description \"Emitted by a change's Inspect button. Payload: { title, type }.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/change-list\" as ChangeListPage -> ChangeListRender\n}\n"
}