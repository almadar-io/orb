  "source": "",
  "lolo": "app ui-atlas-image \"1.0.0\"\n\"AtlasImage — UI factory (1:1 with the @almadar/ui atlas-image pattern).\"\norbital AtlasImageOrbital {\n  type AtlasImageAsset = {\n    name : string\n    category : string\n  }\n\n  entity AtlasImageItem [runtime] {\n    id : string!\n  }\n\n  trait AtlasImageRender -> @rebindable AtlasImageItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          asset: @config.asset\n          size: @config.size\n          width: @config.width\n          height: @config.height\n          fill: @config.fill\n          fit: @config.fit\n          alt: @config.alt\n          className: @config.className\n          style: @config.style\n          type: atlas-image\n        })\n    }\n\n    config {\n      asset : AtlasImageAsset\n        @label \"Asset\"\n        @description \"asset prop\"\n        @tier \"presentation\"\n      size : number\n        @label \"Size\"\n        @description \"Square pixel size (icon usage). Ignored when `fill`.\"\n        @tier \"presentation\"\n      width : number\n        @label \"Width\"\n        @description \"width prop\"\n        @tier \"presentation\"\n      height : number\n        @label \"Height\"\n        @description \"height prop\"\n        @tier \"presentation\"\n      fill : boolean = false\n        @label \"Fill\"\n        @description \"Absolutely fill the nearest positioned ancestor (background usage).\"\n        @tier \"presentation\"\n      fit : \"contain\" | \"cover\" | \"fill\" = contain\n        @label \"Fit\"\n        @description \"fit prop\"\n        @tier \"presentation\"\n      alt : string\n        @label \"Alt\"\n        @description \"alt prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      style : Map string string = {}\n        @label \"Style\"\n        @description \"style prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/atlas-image\" as AtlasImagePage -> AtlasImageRender\n}\n"
}