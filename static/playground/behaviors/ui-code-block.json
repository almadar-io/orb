  "source": "",
  "lolo": "app ui-code-block \"1.0.0\"\n\"CodeBlock — UI factory (1:1 with the @almadar/ui code-block pattern).\"\norbital CodeBlockOrbital {\n  type CodeBlockDiffItem = {\n    type : \"added\" | \"removed\" | \"unchanged\" | \"context\"!\n    beforeLineNumber : number\n    afterLineNumber : number\n    content : string!\n  }\n  type CodeBlockFilesItem = {\n    label : string!\n    code : string!\n    language : \"text\" | \"json\" | \"javascript\" | \"js\" | \"typescript\" | \"ts\" | \"jsx\" | \"tsx\" | \"css\" | \"markdown\" | \"md\" | \"bash\" | \"shell\" | \"sh\" | \"yaml\" | \"yml\" | \"rust\" | \"python\" | \"py\" | \"sql\" | \"diff\" | \"toml\" | \"go\" | \"graphql\" | \"html\" | \"xml\" | \"clojure\" | \"clj\" | \"edn\" | \"haskell\" | \"hs\" | \"lisp\" | \"scheme\" | \"scala\" | \"elixir\" | \"ex\" | \"exs\" | \"erlang\" | \"erl\" | \"elm\" | \"fsharp\" | \"fs\" | \"fsx\" | \"ocaml\" | \"ml\" | \"java\" | \"c\" | \"cpp\" | \"c++\" | \"cc\" | \"cxx\" | \"hpp\" | \"h\" | \"csharp\" | \"cs\" | \"objectivec\" | \"objc\" | \"php\" | \"ruby\" | \"rb\" | \"swift\" | \"kotlin\" | \"kt\" | \"lua\" | \"r\" | \"dart\" | \"julia\" | \"fortran\" | \"f90\" | \"f95\" | \"perl\" | \"pl\" | \"powershell\" | \"ps1\" | \"makefile\" | \"make\" | \"nginx\" | \"ini\" | \"orb\" | \"lolo\"\n  }\n  type CodeBlockActionsItem = {\n    label : string!\n    event : string\n    navigatesTo : string\n    variant : \"primary\" | \"secondary\" | \"ghost\"\n  }\n  type CodeBlockError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity CodeBlockItem [runtime] {\n    id : string!\n    code : string\n  }\n\n  trait CodeBlockRender -> @rebindable CodeBlockItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.code @config.code)\n        (render-ui main {\n          code: @entity.code\n          language: @config.language\n          showCopyButton: @config.showCopyButton\n          showLanguageBadge: @config.showLanguageBadge\n          maxHeight: @config.maxHeight\n          foldable: @config.foldable\n          className: @config.className\n          editable: @config.editable\n          onChange: @config.onChange\n          title: @config.title\n          mode: @config.mode\n          diff: @config.diff\n          oldValue: @config.oldValue\n          newValue: @config.newValue\n          showLineNumbers: @config.showLineNumbers\n          wordWrap: @config.wordWrap\n          files: @config.files\n          actions: @config.actions\n          isLoading: @config.isLoading\n          error: @config.error\n          showCopy: @config.showCopy\n          type: code-block\n        })\n      CHANGE -> idle\n        (set @entity.code ?code)\n        (render-ui main {\n          code: @entity.code\n          language: @config.language\n          showCopyButton: @config.showCopyButton\n          showLanguageBadge: @config.showLanguageBadge\n          maxHeight: @config.maxHeight\n          foldable: @config.foldable\n          className: @config.className\n          editable: @config.editable\n          onChange: @config.onChange\n          title: @config.title\n          mode: @config.mode\n          diff: @config.diff\n          oldValue: @config.oldValue\n          newValue: @config.newValue\n          showLineNumbers: @config.showLineNumbers\n          wordWrap: @config.wordWrap\n          files: @config.files\n          actions: @config.actions\n          isLoading: @config.isLoading\n          error: @config.error\n          showCopy: @config.showCopy\n          type: code-block\n        })\n    }\n\n    emits {\n      @config.onChange -> external {\n        code : string\n      }\n        @description \"GAP-51: called with the new code on every keystroke when `editable === true`. Consumers should debounce + parse downstream — `CodeBlock` does not.\"\n        @tier \"essential\"\n    }\n\n    listens {\n      CHANGE {\n        code : string\n      }\n    }\n\n    config {\n      code : string\n        @label \"Code\"\n        @description \"The code content to display\"\n        @tier \"presentation\"\n      language : string = text\n        @label \"Language\"\n        @description \"Programming language for syntax highlighting (any Prism id; loaded on demand if not pre-registered)\"\n        @tier \"presentation\"\n      showCopyButton : boolean = true\n        @label \"Show Copy Button\"\n        @description \"Show the copy button\"\n        @tier \"presentation\"\n      showLanguageBadge : boolean = true\n        @label \"Show Language Badge\"\n        @description \"Show the language badge\"\n        @tier \"presentation\"\n      maxHeight : string = \"60vh\"\n        @label \"Max Height\"\n        @description \"Maximum height before scrolling\"\n        @tier \"presentation\"\n      foldable : boolean\n        @label \"Foldable\"\n        @description \"Enable brace-based code folding of multi-line `{}`/`[]` blocks (default: true).\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      editable : boolean = false\n        @label \"Editable\"\n        @description \"When true, render an editable surface that composes a transparent `Textarea` over a Prism-highlighted overlay. The overlay re-tokenizes on each keystroke (driven from a local mirror of the textarea value), so users see syntax-highlighted code while still being able to type. Folding is skipped in editable mode. History: GAP-51 first-cut shipped plain (no-highlighting) editable text; GAP-77 (2026-04-12) added the Prism overlay layer. Default: false (existing read-only behavior unchanged).\"\n        @tier \"presentation\"\n      onChange : event = \"CHANGE\"\n        @label \"On Change\"\n        @description \"GAP-51: called with the new code on every keystroke when `editable === true`. Consumers should debounce + parse downstream — `CodeBlock` does not.\"\n        @tier \"presentation\"\n      title : string\n        @label \"Title\"\n        @description \"── Viewer props (absorbed from CodeViewer / DocCodeBlock) ────────────────\"\n        @tier \"presentation\"\n      mode : \"code\" | \"diff\" = code\n        @label \"Mode\"\n        @description \"Diff or plain-code display mode\"\n        @tier \"presentation\"\n      diff : [CodeBlockDiffItem] = []\n        @label \"Diff\"\n        @description \"Pre-computed diff lines\"\n        @tier \"presentation\"\n      oldValue : string\n        @label \"Old Value\"\n        @description \"Old source text — generates diff when combined with newValue\"\n        @tier \"presentation\"\n      newValue : string\n        @label \"New Value\"\n        @description \"New source text — generates diff when combined with oldValue\"\n        @tier \"presentation\"\n      showLineNumbers : boolean = false\n        @label \"Show Line Numbers\"\n        @description \"Show line numbers in code / diff mode\"\n        @tier \"presentation\"\n      wordWrap : boolean = false\n        @label \"Word Wrap\"\n        @description \"Enable word-wrap in code / diff mode\"\n        @tier \"presentation\"\n      files : [CodeBlockFilesItem] = []\n        @label \"Files\"\n        @description \"Multiple files shown as tabs\"\n        @tier \"presentation\"\n      actions : [CodeBlockActionsItem] = []\n        @label \"Actions\"\n        @description \"Action badges in the toolbar\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state\"\n        @tier \"presentation\"\n      error : CodeBlockError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      showCopy : boolean\n        @label \"Show Copy\"\n        @description \"Show copy button (viewer alias for showCopyButton)\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/code-block\" as CodeBlockPage -> CodeBlockRender\n}\n"
}