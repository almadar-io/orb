  "source": "",
  "lolo": "app ui-draw-text \"1.0.0\"\n\"DrawText — UI factory (1:1 with the @almadar/ui draw-text pattern).\"\norbital DrawTextOrbital {\n  type DrawTextPosition = {\n    x : number!\n    y : number!\n    z : number\n  }\n\n  entity DrawTextItem [runtime] {\n    id : string!\n  }\n\n  trait DrawTextRender -> @rebindable DrawTextItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          text: @config.text\n          position: @config.position\n          anchor: @config.anchor\n          offsetX: @config.offsetX\n          offsetY: @config.offsetY\n          color: @config.color\n          font: @config.font\n          align: @config.align\n          baseline: @config.baseline\n          opacity: @config.opacity\n          type: draw-text\n        })\n    }\n\n    config {\n      text : string = \"\"\n        @label \"Text\"\n        @description \"text prop\"\n        @tier \"presentation\"\n      position : DrawTextPosition = { x: 1, y: 1, z: 1 }\n        @label \"Position\"\n        @description \"Logical scene position; the projector maps it to pixels / world.\"\n        @tier \"presentation\"\n      anchor : \"top-left\" | \"ground\" | \"center\" = \"top-left\"\n        @label \"Anchor\"\n        @description \"anchor prop\"\n        @tier \"presentation\"\n      offsetX : number\n        @label \"Offset X\"\n        @description \"offsetX prop\"\n        @tier \"presentation\"\n      offsetY : number\n        @label \"Offset Y\"\n        @description \"offsetY prop\"\n        @tier \"presentation\"\n      color : string = \"\"\n        @label \"Color\"\n        @description \"color prop\"\n        @tier \"presentation\"\n      font : string\n        @label \"Font\"\n        @description \"font prop\"\n        @tier \"presentation\"\n      align : \"center\" | \"end\" | \"left\" | \"right\" | \"start\" = center\n        @label \"Align\"\n        @description \"align prop\"\n        @tier \"presentation\"\n      baseline : \"alphabetic\" | \"bottom\" | \"hanging\" | \"ideographic\" | \"middle\" | \"top\" = alphabetic\n        @label \"Baseline\"\n        @description \"baseline prop\"\n        @tier \"presentation\"\n      opacity : number\n        @label \"Opacity\"\n        @description \"opacity prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/draw-text\" as DrawTextPage -> DrawTextRender\n}\n"
}