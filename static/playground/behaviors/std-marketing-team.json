  "source": "",
  "lolo": "app std-marketing-team \"1.0.0\"\n\"Team grid atom for marketing pages. Renders a responsive grid of team member cards with avatars, names, roles, and bios. Pick for about pages and company culture sections.\"\n;; Config-driven team grid using the `team-organism` marketing pattern.\n;; Members are declared as an array of { name, nameAr, role, bio, avatar } objects.\n;; The atom renders immediately on INIT with no fetch required.\norbital TeamItemOrbital {\n    type TeamMemberCard = { id : string!, name : string!, nameAr : string, role : string!, bio : string!, avatar : string }\n\n  uses TeamOrganism from \"std/behaviors/ui-team-organism\"\n\n  entity TeamItem [runtime] {\n    id : string!\n    members : [TeamMemberCard] @description \"An array of team member card objects.\" @synonyms \"team, people, staff, personnel\" = []\n  }\n\n  trait TeamItemTeam = TeamOrganism.traits.TeamOrganismRender -> TeamItem {\n    config {\n      members : [TeamMemberCard] = [{\n        avatar: \"\"\n        bio: \"Former VP Engineering at BigTech. Obsessed with developer experience.\"\n        id: \"1\"\n        name: \"Jane Doe\"\n        nameAr: \"\"\n        role: CEO\n      }, {\n        avatar: \"\"\n        bio: \"Built distributed systems at scale for a decade.\"\n        id: \"2\"\n        name: \"John Smith\"\n        nameAr: \"\"\n        role: CTO\n      }, {\n        avatar: \"\"\n        bio: \"Believes great design is invisible.\"\n        id: \"3\"\n        name: \"Alice Chen\"\n        nameAr: \"\"\n        role: \"Head of Design\"\n      }]\n        @label \"Team Members\"\n        @description \"Array of team member cards\"\n        @tier \"presentation\"\n      columns : number = 3\n        @label \"Columns\"\n        @description \"Number of grid columns\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/team\" as TeamItemTeamPage -> TeamItemTeam\n}"
}