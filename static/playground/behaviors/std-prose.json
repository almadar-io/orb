  "lolo": "app std-prose \"1.0.0\"\n\"std-prose — a block of long-form text at a comfortable reading width: optional eyebrow, heading and meta line (date, author), then markdown body with headings, lists, links and code blocks. Supports right-to-left text. Pick for articles, blog posts, about and mission pages, policy text and install notes.\"\norbital ProseOrbital {\n\n  entity ProseView [runtime] {\n    id : string!\n  }\n\n  trait ProseRender -> @rebindable ProseView [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          type: box\n          paddingY: xl\n          bg: (if (== @config.surface muted) muted transparent)\n          fullWidth: true\n          dir: @config.direction\n          children: [{\n            type: container\n            size: md\n            maxWidth: md\n            padding: lg\n            children: [{\n              type: stack\n              direction: vertical\n              gap: md\n              children: [{\n                type: badge\n                label: @config.eyebrow\n                variant: primary\n              }, {\n                type: typography\n                content: @config.heading\n                variant: h2\n                weight: bold\n                className: (if (== @config.heading \"\") hidden \"tracking-tight text-balance\")\n              }, {\n                type: typography\n                content: @config.meta\n                variant: caption\n                color: muted\n                className: (if (== @config.meta \"\") hidden \"\")\n              }, {\n                type: markdown-content\n                content: @config.body\n                direction: @config.direction\n              }]\n            }]\n          }]\n        })\n    }\n\n    config {\n      eyebrow : string = \"\"\n        @label \"Eyebrow\"\n        @description \"Small badge above the heading; empty hides it\"\n        @tier \"presentation\"\n      heading : string = \"\"\n        @label \"Heading\"\n        @description \"Empty hides it\"\n        @synonyms \"title\"\n        @tier \"presentation\"\n      meta : string = \"\"\n        @label \"Meta line\"\n        @description \"Date, author or reading time under the heading; empty hides it\"\n        @synonyms \"byline, date, author\"\n        @tier \"presentation\"\n      body : string = \"Write the text here in **markdown**.\"\n        @label \"Body\"\n        @description \"Markdown text\"\n        @synonyms \"content, article, text, copy\"\n        @tier \"presentation\"\n      direction : \"ltr\" | \"rtl\" = ltr\n        @label \"Text direction\"\n        @tier \"presentation\"\n      surface : \"plain\" | \"muted\" = plain\n        @label \"Surface\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/prose\" as ProsePage -> ProseRender\n}\n"
}