  "source": "",
  "lolo": "app ui-content-renderer \"1.0.0\"\n\"ContentRenderer — UI factory (1:1 with the @almadar/ui content-renderer pattern).\"\norbital ContentRendererOrbital {\n  type ContentRendererError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type ContentRendererSegmentsItem = {\n    type : \"markdown\"!\n    content : string!\n  }\n\n  entity ContentRendererItem [runtime] {\n    id : string!\n  }\n\n  trait ContentRendererRender -> @rebindable ContentRendererItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          content: @config.content\n          segments: @config.segments\n          direction: @config.direction\n          type: content-renderer\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : ContentRendererError\n        @label \"Error\"\n        @description \"Error state (UiError)\"\n        @tier \"presentation\"\n      sortBy : string\n        @label \"Sort By\"\n        @description \"Current sort field\"\n        @tier \"presentation\"\n      sortDirection : \"asc\" | \"desc\" = asc\n        @label \"Sort Direction\"\n        @description \"Current sort direction\"\n        @tier \"presentation\"\n      searchValue : string\n        @label \"Search Value\"\n        @description \"Current search query value\"\n        @tier \"presentation\"\n      pageProp : number\n        @label \"Page\"\n        @description \"Current page number\"\n        @synonyms \"page\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Number of items per page\"\n        @tier \"presentation\"\n      totalCount : number\n        @label \"Total Count\"\n        @description \"Total number of items\"\n        @tier \"presentation\"\n      activeFilters : Map string string = {}\n        @label \"Active Filters\"\n        @description \"Active filters\"\n        @tier \"presentation\"\n      selectedIds : [string] = []\n        @label \"Selected Ids\"\n        @description \"Currently selected item IDs\"\n        @tier \"presentation\"\n      content : string\n        @label \"Content\"\n        @description \"Raw content string — auto-parsed into segments\"\n        @tier \"presentation\"\n      segments : [ContentRendererSegmentsItem] = []\n        @label \"Segments\"\n        @description \"Pre-parsed segments (overrides content)\"\n        @tier \"presentation\"\n      direction : \"rtl\" | \"ltr\" = rtl\n        @label \"Direction\"\n        @description \"Text direction for markdown\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/content-renderer\" as ContentRendererPage -> ContentRendererRender\n}\n"
}