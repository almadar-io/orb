  "lolo": "app std-area-fill \"1.0.0\"\n\"Headless area-fill mechanic: the player paints area under a curve by moving through a fill region. Listens BODY_MOVED and, per fill, accumulates height(x) × |dx| while the player is inside the fill's x-range (the per-tick step is clamped to 0.5 world units — the physical per-tick maximum — so teleports and respawns paint nothing) — height is linear interpolation of the config curve samples above the fill's baseline (the platformer body's leftSamp/rightSamp idiom). rateMode picks the rate: \\\"area\\\" (height × |dx|, default — fills fastest where the curve is tallest), \\\"speed\\\" (|dx| only, flat rate), or \\\"ride\\\" (|dx| only while the move reports skating — walking the same distance paints nothing). When a fill's filled reaches its target it flips reported and emits AREA_FILLED once (the shared entity carries the rest); each fill also stamps a frontier (x0 + span × min(1, filled/target)) so boards can shade the painted region left-to-right as the gauge grows. RESTART resets every fill. Renders nothing; boards shade the painted region and read filled/frontier from the shared entity (the render authority).\"\norbital AreaFillOrbital {\n  type AreaFillSample = {\n    x : number!\n    y : number!\n  }\n  type AreaFill = {\n    id : string!\n    x0 : number!\n    x1 : number!\n    baseline : number!\n    target : number!\n    rateMode : string\n    hint : string\n    samples : [AreaFillSample]!\n    filled : number\n    frontier : number\n    reported : boolean\n  }\n\n  entity AreaFillData [runtime, shared] {\n    id : string!\n    fills : [AreaFill] = []\n    lastX : number = 0\n  }\n\n  trait AreaFill -> @rebindable AreaFillData [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.fills (array/map @config.fills (fn f (object/merge @f { filled: 0, frontier: (object/get @f x0), reported: false }))))\n        (set @entity.lastX 0)\n\n      BODY_MOVED -> active when @config.running\n        (let ((adx (math/abs (- @payload.x @entity.lastX))))\n        (set @entity.fills (array/map @entity.fills (fn f\n          (let ((inside (and (>= @payload.x (object/get @f x0)) (<= @payload.x (object/get @f x1)))))\n          (let ((leftSamp (array/last (array/filter (object/get @f samples) (fn s (<= (object/get @s x) @payload.x))))))\n          (let ((rightSamp (array/first (array/filter (object/get @f samples) (fn s (> (object/get @s x) @payload.x))))))\n          (let ((h (if (or (== @leftSamp null) (== @rightSamp null)) 0\n                     (- (+ (object/get @leftSamp y) (* (/ (- (object/get @rightSamp y) (object/get @leftSamp y)) (- (object/get @rightSamp x) (object/get @leftSamp x))) (- @payload.x (object/get @leftSamp x)))) (object/get @f baseline)))))\n          (let ((step (math/min @adx 0.5)))\n          (let ((rate (if @inside\n                        (if (== (object/get @f rateMode) \"ride\") (if @payload.skating @step 0)\n                          (if (== (object/get @f rateMode) \"speed\") @step\n                            (* @step @h)))\n                        0)))\n          (let ((newFilled (+ (object/get @f filled) @rate)))\n            (object/merge @f { filled: @newFilled, frontier: (+ (object/get @f x0) (* (- (object/get @f x1) (object/get @f x0)) (math/min 1 (/ @newFilled (object/get @f target))))) }))))))))))))\n        (set @entity.lastX @payload.x)\n        (let ((newly (array/filter @entity.fills (fn f (and (>= (object/get @f filled) (object/get @f target)) (== (object/get @f reported) false))))))\n        (if (> (array/len @newly) 0)\n          (do\n            (set @entity.fills (array/map @entity.fills (fn f (if (== (object/get @f id) (object/get (array/first @newly) id)) (object/merge @f { reported: true }) @f))))\n            (emit AREA_FILLED { id: (object/get (array/first @newly) id), x: @payload.x, y: @payload.y }))\n          null))\n\n      RESTART -> active\n        (set @entity.fills (array/map @config.fills (fn f (object/merge @f { filled: 0, frontier: (object/get @f x0), reported: false }))))\n        (set @entity.lastX 0)\n    }\n\n    emits {\n      AREA_FILLED -> external {\n        id : string!\n        x : number!\n        y : number!\n      }\n        @description \"A fill's painted area reached its target (x, y = the player's position at completion, for burst placement). When several fills complete on one move, the first reports and the shared entity carries the rest.\"\n        @tier \"domain\"\n    }\n\n    listens {\n      BODY_MOVED { x : number!, y : number!, vx : number!, vy : number!, grounded : boolean!, skating : boolean!, speed : number! }\n      RESTART { id : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, BODY_MOVED paints every fill the player moves through; toggle to freeze every fill as-is.\"\n        @tier \"domain\"\n      fills : [AreaFill] = []\n        @label \"Fills\"\n        @description \"One row per fill region: id, x-range (x0..x1 in world units), baseline the height is measured from, target area, rateMode (area | speed | ride — default area), optional hint, and the curve samples to interpolate. filled/frontier/reported are stamped at runtime.\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/area-fill\" as AreaFillPage -> AreaFill\n}\n"
}