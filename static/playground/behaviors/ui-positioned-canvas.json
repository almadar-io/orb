  "source": "",
  "lolo": "app ui-positioned-canvas \"1.0.0\"\n\"PositionedCanvas — UI factory (1:1 with the @almadar/ui positioned-canvas pattern).\"\norbital PositionedCanvasOrbital {\n    type PositionedCanvasLoaded = Event { data : [PositionedCanvasItem] } \"PositionedCanvas rows finished loading; payload.data holds the collection\"\n\n  entity PositionedCanvasItem [runtime] {\n    id : string!\n    label : string = \"Label\"\n    x : number = 1\n    y : number = 1\n    capacity : number = 1\n    partySize : number = 1\n    serverName : string = \"Server Name\"\n    status : \"empty\" | \"seated\" | \"ordered\" | \"awaiting-bill\" | \"cleaning\" = empty\n    shape : \"round\" | \"rectangle\" | \"square\" = round\n  }\n\n  trait PositionedCanvasRender -> @rebindable PositionedCanvasItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle when @config.selfFetch\n        (fetch PositionedCanvasItem { emit: { success: PositionedCanvasLoaded } })\n        (render-ui main {\n          items: @entity\n          width: @config.width\n          height: @config.height\n          selectedId: @config.selectedId\n          editable: @config.editable\n          onSelect: @config.onSelect\n          onMove: @config.onMove\n          selectEvent: @config.selectEvent\n          moveEvent: @config.moveEvent\n          className: @config.className\n          type: positioned-canvas\n        })\n      INIT -> idle when (not @config.selfFetch)\n        (render-ui main {\n          items: @entity\n          width: @config.width\n          height: @config.height\n          selectedId: @config.selectedId\n          editable: @config.editable\n          onSelect: @config.onSelect\n          onMove: @config.onMove\n          selectEvent: @config.selectEvent\n          moveEvent: @config.moveEvent\n          className: @config.className\n          type: positioned-canvas\n        })\n      PositionedCanvasLoaded -> idle\n        (render-ui main {\n          items: @payload.data\n          width: @config.width\n          height: @config.height\n          selectedId: @config.selectedId\n          editable: @config.editable\n          onSelect: @config.onSelect\n          onMove: @config.onMove\n          selectEvent: @config.selectEvent\n          moveEvent: @config.moveEvent\n          className: @config.className\n          type: positioned-canvas\n        })\n    }\n\n    emits {\n      @config.onSelect -> external {\n        id : string\n      }\n        @description \"onSelect prop\"\n        @tier \"essential\"\n      @config.onMove -> external {\n        id : string\n        x : number\n        y : number\n      }\n        @description \"onMove prop\"\n        @tier \"essential\"\n      PositionedCanvasLoaded\n        @description \"PositionedCanvas rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      width : number = 800\n        @label \"Width\"\n        @description \"width prop\"\n        @tier \"presentation\"\n      height : number = 600\n        @label \"Height\"\n        @description \"height prop\"\n        @tier \"presentation\"\n      selectedId : string\n        @label \"Selected Id\"\n        @description \"selectedId prop\"\n        @tier \"presentation\"\n      editable : boolean = false\n        @label \"Editable\"\n        @description \"editable prop\"\n        @tier \"presentation\"\n      onSelect : event = \"SELECT\"\n        @label \"On Select\"\n        @description \"onSelect prop\"\n        @tier \"presentation\"\n      onMove : event = \"MOVE\"\n        @label \"On Move\"\n        @description \"onMove prop\"\n        @tier \"presentation\"\n      selectEvent : event = \"SELECT\"\n        @label \"Select Event\"\n        @description \"selectEvent prop\"\n        @tier \"presentation\"\n      moveEvent : event = \"MOVE\"\n        @label \"Move Event\"\n        @description \"moveEvent prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      selfFetch : boolean = true\n        @label \"Fetch its own rows on mount?\"\n        @description \"true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/positioned-canvas\" as PositionedCanvasPage -> PositionedCanvasRender\n}\n"
}