  "source": "",
  "lolo": "app ui-pull-to-refresh \"1.0.0\"\n\"PullToRefresh — UI factory (1:1 with the @almadar/ui pull-to-refresh pattern).\"\norbital PullToRefreshOrbital {\n  entity PullToRefreshItem [runtime] {\n    id : string!\n  }\n\n  trait PullToRefreshRender -> @rebindable PullToRefreshItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          refreshEvent: @config.refreshEvent\n          refreshPayload: @config.refreshPayload\n          threshold: @config.threshold\n          children: @config.children\n          className: @config.className\n          type: pull-to-refresh\n        })\n    }\n\n    emits {\n      @config.refreshEvent -> external { }\n        @description \"Event name to emit on refresh (emitted as UI:{refreshEvent})\"\n        @tier \"essential\"\n    }\n\n    config {\n      refreshEvent : event = \"REFRESH\"\n        @label \"Refresh Event\"\n        @description \"Event name to emit on refresh (emitted as UI:{refreshEvent})\"\n        @tier \"presentation\"\n      refreshPayload : @payload @config.refreshEvent\n        @label \"Refresh Payload\"\n        @description \"Payload to include with the refresh event\"\n        @tier \"presentation\"\n      threshold : number = 60\n        @label \"Threshold\"\n        @description \"Pull distance threshold to trigger refresh in px (default: 60)\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Content to wrap\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/pull-to-refresh\" as PullToRefreshPage -> PullToRefreshRender\n}\n"
