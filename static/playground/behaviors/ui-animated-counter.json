  "source": "",
  "lolo": "app ui-animated-counter \"1.0.0\"\n\"AnimatedCounter — UI factory (1:1 with the @almadar/ui animated-counter pattern).\"\n;; @pattern \"animated-counter\"\norbital AnimatedCounterOrbital {\n  entity AnimatedCounterItem [runtime] {\n    id : string!\n  }\n\n  trait AnimatedCounterRender -> @rebindable AnimatedCounterItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          value: @config.value\n          label: @config.label\n          duration: @config.duration\n          prefix: @config.prefix\n          suffix: @config.suffix\n          format: @config.format\n          className: @config.className\n          type: animated-counter\n        })\n    }\n\n    config {\n      value : scalar = \"\"\n        @label \"Value\"\n        @description \"Target value. Strings may carry display affixes (e.g. '500+', '99.9%', '$1.2M').\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Label displayed below the number\"\n        @tier \"presentation\"\n      duration : number = 1500\n        @label \"Duration\"\n        @description \"Animation duration in ms\"\n        @tier \"presentation\"\n      prefix : string\n        @label \"Prefix\"\n        @description \"Text displayed before the number\"\n        @tier \"presentation\"\n      suffix : string\n        @label \"Suffix\"\n        @description \"Text displayed after the number\"\n        @tier \"presentation\"\n      format : string\n        @label \"Format\"\n        @description \"'number' (locale grouping), 'currency' ($x.xx), 'percent' (rounded %). Unset keeps the value's own decimals.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/animated-counter\" as AnimatedCounterPage -> AnimatedCounterRender\n}\n"
}