  "source": "",
  "lolo": "app ui-sparkline \"1.0.0\"\n\"Sparkline — UI factory (1:1 with the @almadar/ui sparkline pattern).\"\norbital SparklineOrbital {\n  entity SparklineItem [runtime] {\n    id : string!\n  }\n\n  trait SparklineRender -> @rebindable SparklineItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          data: @config.data\n          color: @config.color\n          width: @config.width\n          height: @config.height\n          strokeWidth: @config.strokeWidth\n          fill: @config.fill\n          className: @config.className\n          type: sparkline\n        })\n    }\n\n    config {\n      data : [number] = [1, 2]\n        @label \"Data\"\n        @description \"Numeric series to plot. Length < 2 renders nothing.\"\n        @tier \"presentation\"\n      color : \"auto\" | \"primary\" | \"success\" | \"warning\" | \"error\" | \"info\" | \"muted\" = auto\n        @label \"Color\"\n        @description \"Stroke color. `auto` (default): success when the series trends up (last ≥ first), error when it trends down.\"\n        @tier \"presentation\"\n      width : number = 80\n        @label \"Width\"\n        @description \"SVG width in px. Default 80.\"\n        @tier \"presentation\"\n      height : number = 32\n        @label \"Height\"\n        @description \"SVG height in px. Default 32.\"\n        @tier \"presentation\"\n      strokeWidth : number = 2\n        @label \"Stroke Width\"\n        @description \"Stroke width in px. Default 2.\"\n        @tier \"presentation\"\n      fill : boolean = false\n        @label \"Fill\"\n        @description \"Fill the area under the line with the stroke color at low opacity.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/sparkline\" as SparklinePage -> SparklineRender\n}\n"
}