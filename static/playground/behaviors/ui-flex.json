  "source": "",
  "lolo": "app ui-flex \"1.0.0\"\n\"Flex — UI factory (1:1 with the @almadar/ui flex pattern).\"\norbital FlexOrbital {\n  entity FlexItem [runtime] {\n    id : string!\n  }\n\n  trait FlexRender -> @rebindable FlexItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          direction: @config.direction\n          wrap: @config.wrap\n          align: @config.align\n          justify: @config.justify\n          gap: @config.gap\n          inline: @config.inline\n          grow: @config.grow\n          shrink: @config.shrink\n          basis: @config.basis\n          className: @config.className\n          children: @config.children\n          type: flex\n        })\n    }\n\n    config {\n      direction : \"row\" | \"row-reverse\" | \"col\" | \"col-reverse\" = row\n        @label \"Direction\"\n        @description \"Flex direction\"\n        @tier \"presentation\"\n      wrap : \"nowrap\" | \"wrap\" | \"wrap-reverse\" = nowrap\n        @label \"Wrap\"\n        @description \"Flex wrap\"\n        @tier \"presentation\"\n      align : \"start\" | \"center\" | \"end\" | \"stretch\" | \"baseline\" = stretch\n        @label \"Align\"\n        @description \"Align items\"\n        @tier \"presentation\"\n      justify : \"start\" | \"center\" | \"end\" | \"between\" | \"around\" | \"evenly\" = start\n        @label \"Justify\"\n        @description \"Justify content\"\n        @tier \"presentation\"\n      gap : \"none\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" = none\n        @label \"Gap\"\n        @description \"Gap between items\"\n        @tier \"presentation\"\n      inline : boolean = false\n        @label \"Inline\"\n        @description \"Inline flex\"\n        @tier \"presentation\"\n      grow : scalar\n        @label \"Grow\"\n        @description \"Flex grow\"\n        @tier \"presentation\"\n      shrink : scalar\n        @label \"Shrink\"\n        @description \"Flex shrink\"\n        @tier \"presentation\"\n      basis : scalar\n        @label \"Basis\"\n        @description \"Flex basis\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Custom class name\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Children elements\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/flex\" as FlexPage -> FlexRender\n}\n"
}