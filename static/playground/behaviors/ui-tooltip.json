  "source": "",
  "lolo": "app ui-tooltip \"1.0.0\"\n\"Tooltip — UI factory (1:1 with the @almadar/ui tooltip pattern).\"\norbital TooltipOrbital {\n  entity TooltipItem [runtime] {\n    id : string!\n  }\n\n  trait TooltipRender -> @rebindable TooltipItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          content: @config.content\n          children: @config.children\n          position: @config.position\n          delay: @config.delay\n          hideDelay: @config.hideDelay\n          showArrow: @config.showArrow\n          className: @config.className\n          type: tooltip\n        })\n    }\n\n    config {\n      content : node\n        @label \"Content\"\n        @description \"Tooltip content\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Tooltip trigger element (ReactElement or ReactNode that will be wrapped in span)\"\n        @tier \"presentation\"\n      position : \"top\" | \"bottom\" | \"left\" | \"right\" = top\n        @label \"Position\"\n        @description \"Tooltip position\"\n        @tier \"presentation\"\n      delay : number = 200\n        @label \"Delay\"\n        @description \"Show delay in milliseconds\"\n        @tier \"presentation\"\n      hideDelay : number = 0\n        @label \"Hide Delay\"\n        @description \"Hide delay in milliseconds\"\n        @tier \"presentation\"\n      showArrow : boolean = true\n        @label \"Show Arrow\"\n        @description \"Show arrow\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/tooltip\" as TooltipPage -> TooltipRender\n}\n"
}