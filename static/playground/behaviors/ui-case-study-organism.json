  "lolo": "app ui-case-study-organism \"1.0.0\"\n\"CaseStudyOrganism — UI factory (1:1 with the @almadar/ui case-study-organism pattern).\"\norbital CaseStudyOrganismOrbital {\n    type CaseStudyOrganismLoaded = Event { data : [CaseStudyOrganismItem] } \"CaseStudyOrganism rows finished loading; payload.data holds the collection\"\n  type CaseStudyOrganismError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity CaseStudyOrganismItem [runtime] {\n    id : string!\n    title : string = \"Title\"\n    description : string = \"Description\"\n    category : string = \"Category\"\n    categoryColor : string = \"Category Color\"\n    href : string = \"Href\"\n    linkLabel : string = \"Link Label\"\n  }\n\n  trait CaseStudyOrganismRender -> @rebindable CaseStudyOrganismItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (fetch CaseStudyOrganismItem { emit: { success: CaseStudyOrganismLoaded } })\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          heading: @config.heading\n          subtitle: @config.subtitle\n          type: case-study-organism\n        })\n      CaseStudyOrganismLoaded -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @payload.data\n          heading: @config.heading\n          subtitle: @config.subtitle\n          type: case-study-organism\n        })\n    }\n\n    emits {\n      CaseStudyOrganismLoaded\n        @description \"CaseStudyOrganism rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : CaseStudyOrganismError\n        @label \"Error\"\n        @description \"Error state (UiError)\"\n        @tier \"presentation\"\n      sortBy : string\n        @label \"Sort By\"\n        @description \"Current sort field\"\n        @tier \"presentation\"\n      sortDirection : \"asc\" | \"desc\" = asc\n        @label \"Sort Direction\"\n        @description \"Current sort direction\"\n        @tier \"presentation\"\n      searchValue : string\n        @label \"Search Value\"\n        @description \"Current search query value\"\n        @tier \"presentation\"\n      pageProp : number\n        @label \"Page\"\n        @description \"Current page number\"\n        @synonyms \"page\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Number of items per page\"\n        @tier \"presentation\"\n      totalCount : number\n        @label \"Total Count\"\n        @description \"Total number of items\"\n        @tier \"presentation\"\n      activeFilters : Map string string = {}\n        @label \"Active Filters\"\n        @description \"Active filters\"\n        @tier \"presentation\"\n      selectedIds : [string] = []\n        @label \"Selected Ids\"\n        @description \"Currently selected item IDs\"\n        @tier \"presentation\"\n      heading : string\n        @label \"Heading\"\n        @description \"heading prop\"\n        @tier \"presentation\"\n      subtitle : string\n        @label \"Subtitle\"\n        @description \"subtitle prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/case-study-organism\" as CaseStudyOrganismPage -> CaseStudyOrganismRender\n}\n"
