  "source": "",
  "lolo": "app ui-matrix-question \"1.0.0\"\n\"MatrixQuestion — UI factory (1:1 with the @almadar/ui matrix-question pattern).\"\norbital MatrixQuestionOrbital {\n  type MatrixQuestionRowsItem = {\n    id : string!\n    label : string!\n  }\n  type MatrixQuestionColumnsItem = {\n    value : string!\n    label : string!\n  }\n\n  entity MatrixQuestionItem [runtime] {\n    id : string!\n  }\n\n  trait MatrixQuestionRender -> @rebindable MatrixQuestionItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          title: @config.title\n          rows: @config.rows\n          columns: @config.columns\n          values: @config.values\n          onChange: @config.onChange\n          changeEvent: @config.changeEvent\n          disabled: @config.disabled\n          size: @config.size\n          className: @config.className\n          type: matrix-question\n        })\n    }\n\n    emits {\n      @config.onChange -> external {\n        rowId : string\n        value : number\n      }\n        @description \"Change handler invoked with rowId and selected column value\"\n        @tier \"essential\"\n    }\n\n    config {\n      title : string\n        @label \"Title\"\n        @description \"Optional title rendered above the matrix\"\n        @tier \"presentation\"\n      rows : [MatrixQuestionRowsItem] = [{ id: \"Id\", label: \"Label\" }, { id: \"Id 2\", label: \"Label 2\" }]\n        @label \"Rows\"\n        @description \"Question rows\"\n        @tier \"presentation\"\n      columns : [MatrixQuestionColumnsItem] = []\n        @label \"Columns\"\n        @description \"Column definitions; defaults to 5-point Likert\"\n        @tier \"presentation\"\n      values : Map string string = {}\n        @label \"Values\"\n        @description \"Selected value per row, keyed by rowId\"\n        @tier \"presentation\"\n      onChange : event = \"CHANGE\"\n        @label \"On Change\"\n        @description \"Change handler invoked with rowId and selected column value\"\n        @tier \"presentation\"\n      changeEvent : event = \"CHANGE\"\n        @label \"Change Event\"\n        @description \"Event name dispatched via event bus when a row's value changes. Payload: { rowId, value }\"\n        @tier \"presentation\"\n      disabled : boolean = false\n        @label \"Disabled\"\n        @description \"Disable all inputs\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" = md\n        @label \"Size\"\n        @description \"Visual size\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/matrix-question\" as MatrixQuestionPage -> MatrixQuestionRender\n}\n"
}