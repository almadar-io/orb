  "source": "",
  "lolo": "app ui-showcase-card \"1.0.0\"\n\"ShowcaseCard — UI factory (1:1 with the @almadar/ui showcase-card pattern).\"\norbital ShowcaseCardOrbital {\n  type ShowcaseCardImage = {\n    src : asset!\n    alt : string!\n  }\n\n  entity ShowcaseCardItem [runtime] {\n    id : string!\n  }\n\n  trait ShowcaseCardRender -> @rebindable ShowcaseCardItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          title: @config.title\n          description: @config.description\n          image: @config.image\n          href: @config.href\n          badge: @config.badge\n          accentColor: @config.accentColor\n          className: @config.className\n          type: showcase-card\n        })\n    }\n\n    config {\n      title : string = \"\"\n        @label \"Title\"\n        @description \"title prop\"\n        @tier \"presentation\"\n      description : string\n        @label \"Description\"\n        @description \"description prop\"\n        @tier \"presentation\"\n      image : ShowcaseCardImage = { src: \"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png\", alt: \"Alt\" }\n        @label \"Image\"\n        @description \"image prop\"\n        @tier \"presentation\"\n      href : string\n        @label \"Href\"\n        @description \"href prop\"\n        @tier \"presentation\"\n      badge : string\n        @label \"Badge\"\n        @description \"badge prop\"\n        @tier \"presentation\"\n      accentColor : string\n        @label \"Accent Color\"\n        @description \"accentColor prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/showcase-card\" as ShowcaseCardPage -> ShowcaseCardRender\n}\n"
}