  "source": "",
  "lolo": "app ui-signature-pad \"1.0.0\"\n\"SignaturePad — a draw-to-sign canvas that captures a handwritten signature or initials. — UI factory (1:1 with the @almadar/ui signature-pad pattern).\"\n;; @capabilities \"e-signature capture, sign-here field, consent signature, initial-here field, wet-signature substitute\"\norbital SignaturePadOrbital {\n  type SignaturePadError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity SignaturePadItem [runtime] {\n    id : string!\n  }\n\n  trait SignaturePadRender -> @rebindable SignaturePadItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          label: @config.label\n          helperText: @config.helperText\n          strokeColor: @config.strokeColor\n          strokeWidth: @config.strokeWidth\n          height: @config.height\n          readOnly: @config.readOnly\n          value: @config.value\n          onChange: @config.onChange\n          signEvent: @config.signEvent\n          clearEvent: @config.clearEvent\n          isLoading: @config.isLoading\n          error: @config.error\n          className: @config.className\n          type: signature-pad\n        })\n    }\n\n    emits {\n      @config.onChange -> external {\n        dataUrl : string\n      }\n        @description \"Callback when signature changes\"\n        @tier \"essential\"\n      @config.signEvent -> external {\n        signature : string!\n      }\n        @description \"Event to emit on sign\"\n        @tier \"essential\"\n      @config.clearEvent -> external {\n        id : string\n      }\n        @description \"Event to emit on clear\"\n        @tier \"essential\"\n    }\n\n    config {\n      label : string\n        @label \"Label\"\n        @description \"Label above the pad\"\n        @tier \"presentation\"\n      helperText : string\n        @label \"Helper Text\"\n        @description \"Helper text\"\n        @tier \"presentation\"\n      strokeColor : string\n        @label \"Stroke Color\"\n        @description \"Stroke color\"\n        @tier \"presentation\"\n      strokeWidth : number = 2\n        @label \"Stroke Width\"\n        @description \"Stroke width\"\n        @tier \"presentation\"\n      height : number = 200\n        @label \"Height\"\n        @description \"Pad height\"\n        @tier \"presentation\"\n      readOnly : boolean = false\n        @label \"Read Only\"\n        @description \"Whether the pad is read-only\"\n        @tier \"presentation\"\n      value : string\n        @label \"Value\"\n        @description \"Existing signature image URL\"\n        @tier \"presentation\"\n      onChange : event = \"CHANGE\"\n        @label \"On Change\"\n        @description \"Callback when signature changes\"\n        @tier \"presentation\"\n      signEvent : event = \"SIGN\"\n        @label \"Sign Event\"\n        @description \"Event to emit on sign\"\n        @tier \"presentation\"\n      clearEvent : event = \"CLEAR\"\n        @label \"Clear Event\"\n        @description \"Event to emit on clear\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state\"\n        @tier \"presentation\"\n      error : SignaturePadError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/signature-pad\" as SignaturePadPage -> SignaturePadRender\n}\n"
}