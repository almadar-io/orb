                    "required": false
                  },
                  "y": {
                    "name": "y",
                    "type": "number",
                    "required": true
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
                  "id": {
                    "name": "id",
                    "type": "string",
                    "required": false
                  },
                  "vx": {
                    "name": "vx",
                    "type": "number",
                    "required": false
                  },
                  "vy": {
                    "name": "vy",
                    "type": "number",
                    "required": false
                  },
                  "radius": {
                    "name": "radius",
                    "type": "number",
                    "required": false
                  },
                  "x": {
                    "name": "x",
                    "type": "number",
                    "required": true
                  },
                  "fy": {
                    "name": "fy",
                    "type": "number",
                    "required": false
                  },
