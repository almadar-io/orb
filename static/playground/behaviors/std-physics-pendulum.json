        },
        "traits": [
          {
            "name": "PendulumSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "bodies",
                "running"
              ]
            },
            "category": "interaction",
            "linkedEntity": "PendulumState",
            "emits": [
              {
                "event": "BODIES_UPDATED",
                "description": "The current scene each tick — a composed listener (graph, readout, mirror canvas) can subscribe; a harmless no-op when the atom runs standalone.",
                "synonyms": "tick, frame, step, redraw",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "bodies",
                    "type": "[PendulumBody]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "BODIES_UPDATED",
                  "name": "Bodies Updated",
                  "description": "The current scene each tick — a composed listener (graph, readout, mirror canvas) can subscribe; a harmless no-op when the atom runs standalone.",
                  "synonyms": "tick, frame, step, redraw",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "bodies",
                      "type": "[PendulumBody]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.bodies",
                      [
                        {
                          "color": "#334155",
                          "vx": 0,
                          "y": 70,
                          "label": "",
                          "x": 300,
                          "radius": 6,
                          "fx": 0,
                          "vy": 0,
                          "fy": 0,
                          "id": "pivot"
                        },
                        {
                          "id": "bob",
                          "fy": 0,
                          "fx": 0,
                          "vy": 0,
                          "label": "",
                          "color": "#2563eb",
                          "radius": 18,
                          "vx": 0,
                          "x": 450,
                          "y": 110
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "backgroundColor": "#f8fafc",
                        "width": 600,
                        "bodies": "@entity.bodies",
                        "type": "physics-canvas",
                        "showForces": false,
                        "velocityScale": 5,
                        "constraints": [
                          {
                            "color": "#94a3b8",
                            "from": "pivot",
                            "to": "bob"
                          }
                        ],
                        "height": 400,
                        "showVelocity": true
                      }
                    ],
                    [
                      "emit",
                      "BODIES_UPDATED",
                      {
                        "bodies": "@entity.bodies"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "pendulumTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "set",
                    "@entity.bodies",
                    [
                      "array/map",
                      "@entity.bodies",
                      [
                        "fn",
                        "b",
                        [
                          "if",
                          [
                            "=",
                            [
                              "object/get",
                              "@b",
                              "id"
                            ],
                            "pivot"
                          ],
                          "@b",
                          [
                            "let",
                            [
                              [
                                "nvy",
                                [
                                  "*",
                                  [
                                    "+",
                                    [
                                      "object/get",
                                      "@b",
                                      "vy"
                                    ],
                                    0.5
                                  ],
                                  0.995
                                ]
                              ],
                              [
                                "nvx",
                                [
                                  "*",
                                  [
                                    "object/get",
                                    "@b",
                                    "vx"
                                  ],
                                  0.995
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "px",
                                  [
                                    "+",
                                    [
                                      "object/get",
                                      "@b",
                                      "x"
                                    ],
                                    "@nvx"
                                  ]
                                ],
                                [
                                  "py",
                                  [
                                    "+",
                                    [
                                      "object/get",
                                      "@b",
                                      "y"
                                    ],
                                    "@nvy"
                                  ]
                                ]
                              ],
                              [
                                "let",
                                [
                                  [
                                    "dx",
                                    [
                                      "-",
                                      "@px",
                                      300
                                    ]
                                  ],
                                  [
                                    "dy",
                                    [
                                      "-",
                                      "@py",
                                      70
                                    ]
                                  ]
                                ],
                                [
                                  "let",
                                  [
                                    [
                                      "dist",
                                      [
                                        "math/sqrt",
                                        [
                                          "+",
                                          [
                                            "*",
                                            "@dx",
                                            "@dx"
                                          ],
                                          [
                                            "*",
                                            "@dy",
                                            "@dy"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "let",
                                    [
                                      [
                                        "s",
                                        [
                                          "/",
                                          170,
                                          "@dist"
                                        ]
                                      ]
                                    ],
                                    [
                                      "let",
                                      [
                                        [
                                          "cxp",
                                          [
                                            "+",
                                            300,
                                            [
                                              "*",
                                              "@dx",
                                              "@s"
                                            ]
                                          ]
                                        ],
                                        [
                                          "cyp",
                                          [
                                            "+",
                                            70,
                                            [
                                              "*",
                                              "@dy",
                                              "@s"
                                            ]
                                          ]
                                        ]
                                      ],
                                      [
                                        "object/merge",
                                        "@b",
                                        {
                                          "vx": [
                                            "-",
                                            "@cxp",
                                            [
                                              "object/get",
                                              "@b",
                                              "x"
                                            ]
                                          ],
                                          "vy": [
                                            "-",
                                            "@cyp",
                                            [
                                              "object/get",
                                              "@b",
                                              "y"
                                            ]
                                          ],
                                          "x": "@cxp",
                                          "y": "@cyp"
                                        }
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "constraints": [
                        {
                          "color": "#94a3b8",
                          "from": "pivot",
                          "to": "bob"
                        }
                      ],
                      "height": 400,
                      "showVelocity": true,
                      "type": "physics-canvas",
                      "width": 600,
                      "backgroundColor": "#f8fafc",
                      "showForces": false,
                      "bodies": "@entity.bodies",
                      "velocityScale": 5
                    }
                  ],
                  [
                    "emit",
                    "BODIES_UPDATED",
                    {
                      "bodies": "@entity.bodies"
                    }
                  ]
                ]
              }
            ],
            "config": {
              "backgroundColor": {
                "type": "string",
                "default": "#f8fafc",
                "label": "Background Color",
                "description": "Canvas background color.",
                "tier": "presentation"
              },
              "gravity": {
                "type": "number",
                "default": 0.5,
                "label": "Gravity",
                "description": "Downward acceleration added to the bob's vy every tick before the length projection.",
                "tier": "domain"
