  "schema": {
    "name": "std-physics-pendulum",
    "version": "1.0.0",
    "description": "Pendulum engine — swings a bob about a fixed pivot via rigid-length projection; renders physics-canvas via uses.",
    "orbitals": [
      {
        "name": "PendulumEngineOrbital",
        "entity": {
          "name": "PendulumState",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "bodies",
              "type": "array",
              "items": {
