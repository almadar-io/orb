  "source": "",
  "lolo": "app ui-textarea \"1.0.0\"\n\"Textarea — UI factory (1:1 with the @almadar/ui textarea pattern).\"\norbital TextareaOrbital {\n  entity TextareaItem [runtime] {\n    id : string!\n  }\n\n  trait TextareaRender -> @rebindable TextareaItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          placeholder: @config.placeholder\n          rows: @config.rows\n          action: @config.action\n          error: @config.error\n          onChange: @config.onChange\n          type: textarea\n        })\n    }\n\n    emits {\n      @config.action -> external { }\n        @description \"Declarative event name for trait dispatch\"\n        @tier \"essential\"\n      @config.onChange -> external { }\n        @description \"onChange handler or declarative event key for trait dispatch\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes applied to the root element.\"\n        @tier \"presentation\"\n      placeholder : string\n        @label \"Placeholder\"\n        @description \"Placeholder text\"\n        @tier \"presentation\"\n      rows : number\n        @label \"Rows\"\n        @description \"Number of visible rows\"\n        @tier \"presentation\"\n      action : event = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event name for trait dispatch\"\n        @tier \"presentation\"\n      error : string\n        @label \"Error\"\n        @description \"Error message\"\n        @tier \"presentation\"\n      onChange : event = \"CHANGE\"\n        @label \"On Change\"\n        @description \"onChange handler or declarative event key for trait dispatch\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/textarea\" as TextareaPage -> TextareaRender\n}\n"
}