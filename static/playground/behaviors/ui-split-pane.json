  "source": "",
  "lolo": "app ui-split-pane \"1.0.0\"\n\"SplitPane — UI factory (1:1 with the @almadar/ui split-pane pattern).\"\norbital SplitPaneOrbital {\n  entity SplitPaneItem [runtime] {\n    id : string!\n    ratio : number @intrinsic\n  }\n\n  trait SplitPaneRender -> @rebindable SplitPaneItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.ratio @config.ratio)\n        (render-ui main {\n          direction: @config.direction\n          ratio: @entity.ratio\n          minSize: @config.minSize\n          resizable: @config.resizable\n          left: @config.left\n          right: @config.right\n          className: @config.className\n          leftClassName: @config.leftClassName\n          rightClassName: @config.rightClassName\n          onRatioChange: @config.onRatioChange\n          type: split-pane\n        })\n      RATIO_CHANGE -> idle\n        (set @entity.ratio ?ratio)\n        (render-ui main {\n          direction: @config.direction\n          ratio: @entity.ratio\n          minSize: @config.minSize\n          resizable: @config.resizable\n          left: @config.left\n          right: @config.right\n          className: @config.className\n          leftClassName: @config.leftClassName\n          rightClassName: @config.rightClassName\n          onRatioChange: @config.onRatioChange\n          type: split-pane\n        })\n    }\n\n    emits {\n      @config.onRatioChange -> external {\n        ratio : number\n      }\n        @description \"Called with the new ratio while dragging. Providing this makes `ratio` controlled — the rendered split always tracks the prop instead of internal state, mirroring a controlled input. Omit for uncontrolled (self-tracked) behavior.\"\n        @tier \"essential\"\n    }\n\n    listens {\n      RATIO_CHANGE {\n        ratio : number\n      }\n    }\n\n    config {\n      direction : \"horizontal\" | \"vertical\" = horizontal\n        @label \"Direction\"\n        @description \"Direction of the split\"\n        @tier \"presentation\"\n      ratio : number\n        @label \"Ratio\"\n        @description \"Initial ratio (0-100, percentage of first pane)\"\n        @tier \"presentation\"\n      minSize : number = 100\n        @label \"Min Size\"\n        @description \"Minimum size of either pane in pixels\"\n        @tier \"presentation\"\n      resizable : boolean = true\n        @label \"Resizable\"\n        @description \"Allow user resizing\"\n        @tier \"presentation\"\n      left : node = []\n        @label \"Left\"\n        @description \"Content for the left/top pane\"\n        @tier \"presentation\"\n      right : node = []\n        @label \"Right\"\n        @description \"Content for the right/bottom pane\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      leftClassName : string\n        @label \"Left Class Name\"\n        @description \"Class for left/top pane\"\n        @tier \"presentation\"\n      rightClassName : string\n        @label \"Right Class Name\"\n        @description \"Class for right/bottom pane\"\n        @tier \"presentation\"\n      onRatioChange : event = \"RATIO_CHANGE\"\n        @label \"On Ratio Change\"\n        @description \"Called with the new ratio while dragging. Providing this makes `ratio` controlled — the rendered split always tracks the prop instead of internal state, mirroring a controlled input. Omit for uncontrolled (self-tracked) behavior.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/split-pane\" as SplitPanePage -> SplitPaneRender\n}\n"
}