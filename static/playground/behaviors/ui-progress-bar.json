  "source": "",
  "lolo": "app ui-progress-bar \"1.0.0\"\n\"ProgressBar — UI factory (1:1 with the @almadar/ui progress-bar pattern).\"\norbital ProgressBarOrbital {\n  entity ProgressBarItem [runtime] {\n    id : string!\n  }\n\n  trait ProgressBarRender -> @rebindable ProgressBarItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          value: @config.value\n          max: @config.max\n          progressType: @config.progressType\n          variant: @config.variant\n          color: @config.color\n          showPercentage: @config.showPercentage\n          showLabel: @config.showLabel\n          label: @config.label\n          size: @config.size\n          steps: @config.steps\n          className: @config.className\n          type: progress-bar\n        })\n    }\n\n    config {\n      value : number = 1\n        @label \"Value\"\n        @description \"Progress value (0-100)\"\n        @tier \"presentation\"\n      max : number = 100\n        @label \"Max\"\n        @description \"Maximum value (for calculating percentage)\"\n        @tier \"presentation\"\n      progressType : \"linear\" | \"circular\" | \"stepped\" = linear\n        @label \"Progress Type\"\n        @description \"Type of the progress bar (linear, circular, stepped)\"\n        @tier \"presentation\"\n      variant : \"default\" | \"primary\" | \"success\" | \"warning\" | \"error\" | \"danger\" = primary\n        @label \"Variant\"\n        @description \"Variant/color of the progress bar\"\n        @tier \"presentation\"\n      color : \"default\" | \"primary\" | \"success\" | \"warning\" | \"error\" | \"danger\" = default\n        @label \"Color\"\n        @description \"Color variant (alias for variant)\"\n        @tier \"presentation\"\n      showPercentage : boolean = false\n        @label \"Show Percentage\"\n        @description \"Show percentage text\"\n        @tier \"presentation\"\n      showLabel : boolean = false\n        @label \"Show Label\"\n        @description \"Alias for showPercentage (pattern compatibility)\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Label text\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Size (for circular variant)\"\n        @tier \"presentation\"\n      steps : number = 5\n        @label \"Steps\"\n        @description \"Number of steps (for stepped variant)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/progress-bar\" as ProgressBarPage -> ProgressBarRender\n}\n"
}