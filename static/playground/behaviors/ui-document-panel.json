  "source": "",
  "lolo": "app ui-document-panel \"1.0.0\"\n\"DocumentPanel — a record rendered as one continuous document: editable title over the rich-text body, editing controls tucked into the header corner. — UI factory (1:1 with the @almadar/ui document-panel pattern).\"\n;; @capabilities \"document page, note editor, wiki page, article editor, writing surface, rich text document, content editing canvas\"\norbital DocumentPanelOrbital {\n  type DocumentPanelActionsItem = {\n    label : string!\n    event : event\n    icon : icon\n    variant : \"primary\" | \"secondary\" | \"ghost\" | \"danger\"\n  }\n\n  entity DocumentPanelItem [runtime] {\n    id : string!\n    title : string @intrinsic\n    value : string @intrinsic\n  }\n\n  trait DocumentPanelRender -> @rebindable DocumentPanelItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.title @config.title)\n        (set @entity.value @config.value)\n        (render-ui main {\n          title: @entity.title\n          subtitle: @config.subtitle\n          coverImage: @config.coverImage\n          icon: @config.icon\n          value: @entity.value\n          actions: @config.actions\n          maxInlineActions: @config.maxInlineActions\n          editing: @config.editing\n          titleCommitEvent: @config.titleCommitEvent\n          contentChangeEvent: @config.contentChangeEvent\n          editEvent: @config.editEvent\n          doneEvent: @config.doneEvent\n          editLabel: @config.editLabel\n          doneLabel: @config.doneLabel\n          autosaveHint: @config.autosaveHint\n          placeholder: @config.placeholder\n          className: @config.className\n          type: document-panel\n        })\n      TITLE_COMMIT -> idle\n        (set @entity.title ?title)\n        (render-ui main {\n          title: @entity.title\n          subtitle: @config.subtitle\n          coverImage: @config.coverImage\n          icon: @config.icon\n          value: @entity.value\n          actions: @config.actions\n          maxInlineActions: @config.maxInlineActions\n          editing: @config.editing\n          titleCommitEvent: @config.titleCommitEvent\n          contentChangeEvent: @config.contentChangeEvent\n          editEvent: @config.editEvent\n          doneEvent: @config.doneEvent\n          editLabel: @config.editLabel\n          doneLabel: @config.doneLabel\n          autosaveHint: @config.autosaveHint\n          placeholder: @config.placeholder\n          className: @config.className\n          type: document-panel\n        })\n      CONTENT_CHANGE -> idle\n        (set @entity.value ?value)\n        (render-ui main {\n          title: @entity.title\n          subtitle: @config.subtitle\n          coverImage: @config.coverImage\n          icon: @config.icon\n          value: @entity.value\n          actions: @config.actions\n          maxInlineActions: @config.maxInlineActions\n          editing: @config.editing\n          titleCommitEvent: @config.titleCommitEvent\n          contentChangeEvent: @config.contentChangeEvent\n          editEvent: @config.editEvent\n          doneEvent: @config.doneEvent\n          editLabel: @config.editLabel\n          doneLabel: @config.doneLabel\n          autosaveHint: @config.autosaveHint\n          placeholder: @config.placeholder\n          className: @config.className\n          type: document-panel\n        })\n    }\n\n    emits {\n      @config.titleCommitEvent -> external {\n        title : string!\n        id : string!\n      }\n        @description \"Emitted when the title commits: { title, id }\"\n        @tier \"essential\"\n      @config.contentChangeEvent -> external {\n        value : string!\n      }\n        @description \"Forwarded to the embedded RichTextEditor's autosave stream: { value }\"\n        @tier \"essential\"\n      @config.editEvent -> external {\n        id : string!\n      }\n        @description \"Emitted by the header Edit affordance and a click on the read body: { id }\"\n        @tier \"essential\"\n      @config.doneEvent -> external {\n        id : string!\n      }\n        @description \"Emitted by the Done button that ends the editing session: { id }\"\n        @tier \"essential\"\n    }\n\n    listens {\n      TITLE_COMMIT {\n        title : string!\n        id : string!\n      }\n      CONTENT_CHANGE {\n        value : string!\n      }\n    }\n\n    config {\n      title : string\n        @label \"Title\"\n        @description \"Document title (falls back to 'Untitled' for a blank draft)\"\n        @tier \"presentation\"\n      subtitle : string\n        @label \"Subtitle\"\n        @description \"Muted byline under the title; hidden when empty\"\n        @tier \"presentation\"\n      coverImage : string\n        @label \"Cover Image\"\n        @description \"Cover/hero image URL painted as a full-bleed banner above the header row (Notion/article-hero shape); hidden when empty\"\n        @tier \"presentation\"\n      icon : icon\n        @label \"Icon\"\n        @description \"Document icon rendered beside the title (a file glyph, a domain icon); hidden when empty\"\n        @tier \"presentation\"\n      value : string\n        @label \"Value\"\n        @description \"The document body as rich-text HTML\"\n        @tier \"presentation\"\n      actions : [DocumentPanelActionsItem] = []\n        @label \"Actions\"\n        @description \"Header actions (settings, history, …). At most one explicit primary stays inline; the rest live under a single '⋯' menu — the title owns its row.\"\n        @tier \"presentation\"\n      maxInlineActions : number\n        @label \"Max Inline Actions\"\n        @description \"0 collapses even the primary action into the menu\"\n        @tier \"presentation\"\n      editing : boolean = false\n        @label \"Editing\"\n        @description \"false = read surface with click-to-edit body; true = live editor\"\n        @tier \"presentation\"\n      titleCommitEvent : event = \"TITLE_COMMIT\"\n        @label \"Title Commit Event\"\n        @description \"Emitted when the title commits: { title, id }\"\n        @tier \"presentation\"\n      contentChangeEvent : event = \"CONTENT_CHANGE\"\n        @label \"Content Change Event\"\n        @description \"Forwarded to the embedded RichTextEditor's autosave stream: { value }\"\n        @tier \"presentation\"\n      editEvent : event = \"EDIT\"\n        @label \"Edit Event\"\n        @description \"Emitted by the header Edit affordance and a click on the read body: { id }\"\n        @tier \"presentation\"\n      doneEvent : event = \"DONE\"\n        @label \"Done Event\"\n        @description \"Emitted by the Done button that ends the editing session: { id }\"\n        @tier \"presentation\"\n      editLabel : string\n        @label \"Edit Label\"\n        @description \"editLabel prop\"\n        @tier \"presentation\"\n      doneLabel : string\n        @label \"Done Label\"\n        @description \"doneLabel prop\"\n        @tier \"presentation\"\n      autosaveHint : string\n        @label \"Autosave Hint\"\n        @description \"Muted caption beside Done telling the author work persists on its own\"\n        @tier \"presentation\"\n      placeholder : string\n        @label \"Placeholder\"\n        @description \"Placeholder for an empty body\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/document-panel\" as DocumentPanelPage -> DocumentPanelRender\n}\n"
}