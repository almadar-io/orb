  "source": "",
  "lolo": "app ui-team-organism \"1.0.0\"\n\"TeamOrganism — UI factory (1:1 with the @almadar/ui team-organism pattern).\"\norbital TeamOrganismOrbital {\n    type TeamOrganismLoaded = Event { data : [TeamOrganismItem] } \"TeamOrganism rows finished loading; payload.data holds the collection\"\n  type TeamOrganismError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity TeamOrganismItem [runtime] {\n    id : string!\n    name : string = \"Name\"\n    nameAr : string = \"Name Ar\"\n    role : string = \"Role\"\n    bio : string = \"Bio\"\n    avatar : asset = \"https://almadar-kflow-assets.web.app/shared/ui-visual-novel-board/default/portraits/guide.png\"\n  }\n\n  trait TeamOrganismRender -> @rebindable TeamOrganismItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle when @config.selfFetch\n        (fetch TeamOrganismItem { emit: { success: TeamOrganismLoaded } })\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          heading: @config.heading\n          subtitle: @config.subtitle\n          type: team-organism\n        })\n      INIT -> idle when (not @config.selfFetch)\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          heading: @config.heading\n          subtitle: @config.subtitle\n          type: team-organism\n        })\n      TeamOrganismLoaded -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @payload.data\n          heading: @config.heading\n          subtitle: @config.subtitle\n          type: team-organism\n        })\n    }\n\n    emits {\n      TeamOrganismLoaded\n        @description \"TeamOrganism rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : TeamOrganismError\n        @label \"Error\"\n        @description \"Error state (UiError)\"\n        @tier \"presentation\"\n      sortBy : string\n        @label \"Sort By\"\n        @description \"Current sort field\"\n        @tier \"presentation\"\n      sortDirection : \"asc\" | \"desc\" = asc\n        @label \"Sort Direction\"\n        @description \"Current sort direction\"\n        @tier \"presentation\"\n      searchValue : string\n        @label \"Search Value\"\n        @description \"Current search query value\"\n        @tier \"presentation\"\n      pageProp : number\n        @label \"Page\"\n        @description \"Current page number\"\n        @synonyms \"page\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Number of items per page\"\n        @tier \"presentation\"\n      totalCount : number\n        @label \"Total Count\"\n        @description \"Total number of items\"\n        @tier \"presentation\"\n      activeFilters : Map string string = {}\n        @label \"Active Filters\"\n        @description \"Active filters\"\n        @tier \"presentation\"\n      selectedIds : [string] = []\n        @label \"Selected Ids\"\n        @description \"Currently selected item IDs\"\n        @tier \"presentation\"\n      heading : string\n        @label \"Heading\"\n        @description \"heading prop\"\n        @tier \"presentation\"\n      subtitle : string\n        @label \"Subtitle\"\n        @description \"subtitle prop\"\n        @tier \"presentation\"\n      selfFetch : boolean = true\n        @label \"Fetch its own rows on mount?\"\n        @description \"true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/team-organism\" as TeamOrganismPage -> TeamOrganismRender\n}\n"
}