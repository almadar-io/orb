  "source": "",
  "lolo": "app ui-entity-cards \"1.0.0\"\n\"EntityCards — UI factory (1:1 with the @almadar/ui entity-cards pattern).\"\norbital EntityCardsOrbital {\n    type EntityCardsLoaded = Event { data : [EntityCardsItem] } \"EntityCards rows finished loading; payload.data holds the collection\"\n  type EntityCardsError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type EntityCardsFieldsItem = {\n    key : string\n    header : string\n    name : string\n    label : string\n  }\n  type EntityCardsColumnsItem = {\n    key : string\n    header : string\n    name : string\n    label : string\n  }\n  type EntityCardsItemActionsItem = {\n    label : string!\n    event : string\n    navigatesTo : string\n    action : string\n    placement : \"card\" | \"footer\" | \"row\"\n    variant : \"primary\" | \"secondary\" | \"ghost\" | \"danger\"\n  }\n\n  entity EntityCardsItem [runtime] {\n    id : string!\n  }\n\n  trait EntityCardsRender -> @rebindable EntityCardsItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (fetch EntityCardsItem { emit: { success: EntityCardsLoaded } })\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          minCardWidth: @config.minCardWidth\n          maxCols: @config.maxCols\n          gap: @config.gap\n          alignItems: @config.alignItems\n          children: @config.children\n          fields: @config.fields\n          fieldNames: @config.fieldNames\n          columns: @config.columns\n          itemActions: @config.itemActions\n          showTotal: @config.showTotal\n          showAvatar: @config.showAvatar\n          variant: @config.variant\n          imageField: @config.imageField\n          type: entity-cards\n        })\n      EntityCardsLoaded -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @payload.data\n          minCardWidth: @config.minCardWidth\n          maxCols: @config.maxCols\n          gap: @config.gap\n          alignItems: @config.alignItems\n          children: @config.children\n          fields: @config.fields\n          fieldNames: @config.fieldNames\n          columns: @config.columns\n          itemActions: @config.itemActions\n          showTotal: @config.showTotal\n          showAvatar: @config.showAvatar\n          variant: @config.variant\n          imageField: @config.imageField\n          type: entity-cards\n        })\n    }\n\n    emits {\n      VIEW -> external {\n        id : string\n      }\n        @description \"User opened a record from the list.\"\n        @tier \"essential\"\n      EntityCardsLoaded\n        @description \"EntityCards rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : EntityCardsError\n        @label \"Error\"\n        @description \"Error state (UiError)\"\n        @tier \"presentation\"\n      sortBy : string\n        @label \"Sort By\"\n        @description \"Current sort field\"\n        @tier \"presentation\"\n      sortDirection : \"asc\" | \"desc\" = asc\n        @label \"Sort Direction\"\n        @description \"Current sort direction\"\n        @tier \"presentation\"\n      searchValue : string\n        @label \"Search Value\"\n        @description \"Current search query value\"\n        @tier \"presentation\"\n      pageProp : number\n        @label \"Page\"\n        @description \"Current page number\"\n        @synonyms \"page\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Number of items per page\"\n        @tier \"presentation\"\n      totalCount : number\n        @label \"Total Count\"\n        @description \"Total number of items\"\n        @tier \"presentation\"\n      activeFilters : Map string string = {}\n        @label \"Active Filters\"\n        @description \"Active filters\"\n        @tier \"presentation\"\n      selectedIds : [string] = []\n        @label \"Selected Ids\"\n        @description \"Currently selected item IDs\"\n        @tier \"presentation\"\n      minCardWidth : number = 280\n        @label \"Min Card Width\"\n        @description \"Minimum width of each card (default: 280px)\"\n        @tier \"presentation\"\n      maxCols : number\n        @label \"Max Cols\"\n        @description \"Maximum number of columns\"\n        @tier \"presentation\"\n      gap : \"none\" | \"sm\" | \"md\" | \"lg\" | \"xl\" = md\n        @label \"Gap\"\n        @description \"Gap between cards\"\n        @tier \"presentation\"\n      alignItems : \"start\" | \"center\" | \"end\" | \"stretch\" = stretch\n        @label \"Align Items\"\n        @description \"Align cards vertically in their cells\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Children elements (cards) - optional when using entity prop\"\n        @tier \"presentation\"\n      fields : [EntityCardsFieldsItem] = [{ key: \"Key\", header: \"Header\", name: \"Name\", label: \"Label\" }, { key: \"Key 2\", header: \"Header 2\", name: \"Name 2\", label: \"Label 2\" }]\n        @label \"Fields\"\n        @description \"Fields to display - required for schema-driven rendering\"\n        @tier \"presentation\"\n      fieldNames : [string] = []\n        @label \"Field Names\"\n        @description \"Alias for fields - backwards compatibility\"\n        @tier \"presentation\"\n      columns : [EntityCardsColumnsItem] = []\n        @label \"Columns\"\n        @description \"Alias for fields - backwards compatibility\"\n        @tier \"presentation\"\n      itemActions : [EntityCardsItemActionsItem] = [{ event: VIEW, label: View, variant: ghost }]\n        @label \"Item Actions\"\n        @description \"Actions for each card item (schema-driven)\"\n        @tier \"presentation\"\n      showTotal : boolean = true\n        @label \"Show Total\"\n        @description \"Show total count in pagination\"\n        @tier \"presentation\"\n      showAvatar : boolean\n        @label \"Show Avatar\"\n        @description \"Show avatar/image field on cards\"\n        @tier \"presentation\"\n      variant : string\n        @label \"Variant\"\n        @description \"Visual variant for the card grid\"\n        @tier \"presentation\"\n      imageField : string\n        @label \"Image Field\"\n        @description \"Entity field name containing an image URL to display as card thumbnail\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/entity-cards\" as EntityCardsPage -> EntityCardsRender\n}\n"
}