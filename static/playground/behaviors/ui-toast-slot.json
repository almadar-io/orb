  "source": "",
  "lolo": "app ui-toast-slot \"1.0.0\"\n\"ToastSlot — UI factory (1:1 with the @almadar/ui toast-slot pattern).\"\norbital ToastSlotOrbital {\n  type ToastSlotError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity ToastSlotItem [runtime] {\n    id : string!\n  }\n\n  trait ToastSlotRender -> @rebindable ToastSlotItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (fetch ToastSlotItem {})\n        (render-ui main {\n          children: @config.children\n          variant: @config.variant\n          title: @config.title\n          duration: @config.duration\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          entity: ToastSlotItem\n          sourceTrait: @config.sourceTrait\n          type: toast-slot\n        })\n    }\n\n    config {\n      children : node\n        @label \"Children\"\n        @description \"Content to display in the toast (message or ReactNode)\"\n        @tier \"presentation\"\n      variant : \"success\" | \"error\" | \"info\" | \"warning\" = success\n        @label \"Variant\"\n        @description \"Toast variant\"\n        @tier \"presentation\"\n      title : string\n        @label \"Title\"\n        @description \"Toast title\"\n        @tier \"presentation\"\n      duration : number = 5000\n        @label \"Duration\"\n        @description \"Auto-dismiss duration in ms (0 = no auto-dismiss)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Custom class name\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : ToastSlotError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      sourceTrait : string\n        @label \"Source Trait\"\n        @description \"Source trait name for qualified event emission\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/toast-slot\" as ToastSlotPage -> ToastSlotRender\n}\n"
}