  "source": "",
  "lolo": "app std-marketing-cta \"1.0.0\"\n\"Call-to-action banner atom for marketing pages. Renders a high-conversion CTA section with title, subtitle, and action buttons. Pick for conversion points at the end of pages or between sections.\"\n;; Config-driven CTA banner using the `cta-banner` marketing pattern.\n;; The atom emits CTA_PRIMARY and CTA_SECONDARY when buttons are clicked.\norbital CTAItemOrbital {\n  entity CTAItem [runtime] {\n    id : string!\n  }\n\n  trait CTAItemCTA -> CTAItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          align: @config.align\n          background: @config.background\n          primaryAction: { href: @config.primaryActionHref, label: @config.primaryActionLabel }\n          secondaryAction: { href: @config.secondaryActionHref, label: @config.secondaryActionLabel }\n          subtitle: @config.subtitle\n          title: @config.title\n          type: cta-banner\n        })\n      CTA_PRIMARY -> idle\n        (emit CTA_PRIMARY { href: @config.primaryActionHref })\n      CTA_SECONDARY -> idle\n        (emit CTA_SECONDARY { href: @config.secondaryActionHref })\n    }\n\n    emits {\n      CTA_PRIMARY -> external {\n        href : string\n      }\n        @description \"Signals the primary call-to-action has been triggered.\"\n        @synonyms \"click, select, submit, activate\"\n        @tier \"domain\"\n      CTA_SECONDARY -> external {\n        href : string\n      }\n        @description \"Signals a secondary call to action was triggered.\"\n        @synonyms \"secondary action, alternate button, second click\"\n        @tier \"domain\"\n    }\n\n    listens {\n      CTA_PRIMARY {\n        href : string\n      }\n        @description \"Primary action button was clicked.\"\n        @synonyms \"click, select, submit, activate\"\n        @tier \"domain\"\n      CTA_SECONDARY {\n        href : string\n      }\n        @description \"A secondary action button was clicked.\"\n        @synonyms \"clicked, pressed, selected, activated\"\n        @tier \"domain\"\n    }\n\n    config {\n      title : string = \"Ready to get started?\"\n        @label \"Title\"\n        @description \"Banner headline\"\n        @tier \"presentation\"\n      subtitle : string = \"Join thousands of teams shipping faster.\"\n        @label \"Subtitle\"\n        @description \"Supporting text below the title\"\n        @tier \"presentation\"\n      primaryActionLabel : string = \"Get Started\"\n        @label \"Primary Action Label\"\n        @tier \"presentation\"\n      primaryActionHref : string = \"#\"\n        @label \"Primary Action Link\"\n        @tier \"presentation\"\n      secondaryActionLabel : string = \"Learn More\"\n        @label \"Secondary Action Label\"\n        @tier \"presentation\"\n      secondaryActionHref : string = \"\"\n        @label \"Secondary Action Link\"\n        @tier \"presentation\"\n      background : string = primary\n        @label \"Background\"\n        @description \"default, alt, dark, gradient, or primary\"\n        @tier \"presentation\"\n      align : string = center\n        @label \"Alignment\"\n        @description \"center or left\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/cta\" as CTAItemCTAPage -> CTAItemCTA\n}\n"
}