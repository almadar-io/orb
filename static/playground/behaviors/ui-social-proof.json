  "source": "",
  "lolo": "app ui-social-proof \"1.0.0\"\n\"SocialProof — UI factory (1:1 with the @almadar/ui social-proof pattern).\"\norbital SocialProofOrbital {\n  type SocialProofItemsItem = {\n    logo : string\n    name : string!\n    quote : string\n  }\n\n  entity SocialProofItem [runtime] {\n    id : string!\n  }\n\n  trait SocialProofRender -> @rebindable SocialProofItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          items: @config.items\n          variant: @config.variant\n          className: @config.className\n          type: social-proof\n        })\n    }\n\n    config {\n      items : [SocialProofItemsItem] = [{ logo: \"Logo\", name: \"Name\", quote: \"Quote\" }, { logo: \"Logo 2\", name: \"Name 2\", quote: \"Quote 2\" }]\n        @label \"Items\"\n        @description \"List of social proof items\"\n        @tier \"presentation\"\n      variant : \"logos\" | \"quotes\" | \"badges\" = logos\n        @label \"Variant\"\n        @description \"Display variant\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/social-proof\" as SocialProofPage -> SocialProofRender\n}\n"
