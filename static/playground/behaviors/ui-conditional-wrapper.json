  "source": "",
  "lolo": "app ui-conditional-wrapper \"1.0.0\"\n\"ConditionalWrapper — UI factory (1:1 with the @almadar/ui conditional-wrapper pattern).\"\norbital ConditionalWrapperOrbital {\n  type ConditionalWrapperContext = {\n    formValues : Map string ControlValue!\n    globalVariables : Map string ControlValue!\n    localVariables : Map string ControlValue\n    entity : Map string ControlValue\n  }\n  type ControlValue = string | number | boolean | [string] | FileValue\n  type FileValue = {\n    name : string!\n    url : string!\n    mimeType : string!\n    sizeBytes : number!\n  }\n\n  entity ConditionalWrapperItem [runtime] {\n    id : string!\n  }\n\n  trait ConditionalWrapperRender -> @rebindable ConditionalWrapperItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          condition: @config.condition\n          context: @config.context\n          children: @config.children\n          fallback: @config.fallback\n          animate: @config.animate\n          type: conditional-wrapper\n        })\n    }\n\n    config {\n      condition : SExpr\n        @label \"Condition\"\n        @description \"The S-expression condition to evaluate\"\n        @tier \"presentation\"\n      context : ConditionalWrapperContext = { formValues: {}, globalVariables: {} }\n        @label \"Context\"\n        @description \"Context for evaluating the condition\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Children to render when condition is true (or when no condition is provided)\"\n        @tier \"presentation\"\n      fallback : node\n        @label \"Fallback\"\n        @description \"Optional fallback to render when condition is false\"\n        @tier \"presentation\"\n      animate : boolean = false\n        @label \"Animate\"\n        @description \"Whether to animate the transition (uses CSS transitions)\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/conditional-wrapper\" as ConditionalWrapperPage -> ConditionalWrapperRender\n}\n"
}