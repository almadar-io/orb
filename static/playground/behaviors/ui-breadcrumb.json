  "source": "",
  "lolo": "app ui-breadcrumb \"1.0.0\"\n\"Breadcrumb — UI factory (1:1 with the @almadar/ui breadcrumb pattern).\"\norbital BreadcrumbOrbital {\n  type BreadcrumbItemsItem = {\n    label : string!\n    href : string\n    path : string\n    icon : icon\n    isCurrent : boolean\n    event : event\n  }\n\n  entity BreadcrumbItem [runtime] {\n    id : string!\n  }\n\n  trait BreadcrumbRender -> @rebindable BreadcrumbItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          items: @config.items\n          fromNavStack: @config.fromNavStack\n          itemEvent: @config.itemEvent\n          separator: @config.separator\n          maxItems: @config.maxItems\n          className: @config.className\n          type: breadcrumb\n        })\n    }\n\n    emits {\n      @config.itemEvent -> external {\n        label : string!\n        href : string\n        index : number!\n      }\n        @description \"Event emitted when a non-current crumb is clicked, with payload `{ label, href, index }` — the trait handles it with `(navigate ?href)`. Without it, stack crumbs navigate directly.\"\n        @tier \"essential\"\n    }\n\n    config {\n      items : [BreadcrumbItemsItem] = []\n        @label \"Items\"\n        @description \"Breadcrumb items. Omit together with `fromNavStack` to render the orbital-scoped navigation stack instead of an authored trail.\"\n        @tier \"presentation\"\n      fromNavStack : boolean = false\n        @label \"From Nav Stack\"\n        @description \"Render the current orbital's navigation stack (NavStackProvider) as the trail: one crumb per visited/declared level, last entry current. The stack is client-session state both execution paths maintain; outside a provider this renders nothing.\"\n        @tier \"presentation\"\n      itemEvent : event = \"ITEM\"\n        @label \"Item Event\"\n        @description \"Event emitted when a non-current crumb is clicked, with payload `{ label, href, index }` — the trait handles it with `(navigate ?href)`. Without it, stack crumbs navigate directly.\"\n        @tier \"presentation\"\n      separator : icon\n        @label \"Separator\"\n        @description \"Separator icon (canonical kebab-case name or LucideIcon component)\"\n        @tier \"presentation\"\n      maxItems : number\n        @label \"Max Items\"\n        @description \"Maximum items to show (truncates with ellipsis)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/breadcrumb\" as BreadcrumbPage -> BreadcrumbRender\n}\n"
}