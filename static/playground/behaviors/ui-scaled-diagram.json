  "lolo": "app ui-scaled-diagram \"1.0.0\"\n\"ScaledDiagram — UI factory (1:1 with the @almadar/ui scaled-diagram pattern).\"\norbital ScaledDiagramOrbital {\n  entity ScaledDiagramItem [runtime] {\n    id : string!\n  }\n\n  trait ScaledDiagramRender -> @rebindable ScaledDiagramItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          children: @config.children\n          className: @config.className\n          type: scaled-diagram\n        })\n    }\n\n    config {\n      children : node\n        @label \"Children\"\n        @description \"children prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/scaled-diagram\" as ScaledDiagramPage -> ScaledDiagramRender\n}\n"
