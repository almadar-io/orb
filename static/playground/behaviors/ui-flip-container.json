  "source": "",
  "lolo": "app ui-flip-container \"1.0.0\"\n\"FlipContainer — UI factory (1:1 with the @almadar/ui flip-container pattern).\"\norbital FlipContainerOrbital {\n  entity FlipContainerItem [runtime] {\n    id : string!\n  }\n\n  trait FlipContainerRender -> @rebindable FlipContainerItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          flipped: @config.flipped\n          className: @config.className\n          children: @config.children\n          onClick: @config.onClick\n          type: flip-container\n        })\n    }\n\n    emits {\n      @config.onClick -> external { }\n        @description \"Click handler on the outer wrapper\"\n        @tier \"essential\"\n    }\n\n    config {\n      flipped : boolean = false\n        @label \"Flipped\"\n        @description \"Whether the container is flipped (rotateY 180deg)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Optional className for the outer wrapper\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"The two face elements (front and back)\"\n        @tier \"presentation\"\n      onClick : event = \"CLICK\"\n        @label \"On Click\"\n        @description \"Click handler on the outer wrapper\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/flip-container\" as FlipContainerPage -> FlipContainerRender\n}\n"
}