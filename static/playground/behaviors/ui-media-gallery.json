  "lolo": "app ui-media-gallery \"1.0.0\"\n\"MediaGallery — UI factory (1:1 with the @almadar/ui media-gallery pattern).\"\norbital MediaGalleryOrbital {\n    type MediaGalleryLoaded = Event { data : [MediaGalleryItem] } \"MediaGallery rows finished loading; payload.data holds the collection\"\n  type MediaGalleryError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type MediaGalleryItemsItem = {\n    id : string\n    src : asset\n    alt : string\n    thumbnail : asset\n    mediaType : \"image\" | \"video\"\n    caption : string\n    fileSize : string\n  }\n  type MediaGalleryActionsItem = {\n    label : string!\n    event : event\n    navigatesTo : string\n    variant : \"primary\" | \"secondary\" | \"ghost\"\n  }\n\n  entity MediaGalleryItem [runtime] {\n    id : string!\n  }\n\n  trait MediaGalleryRender -> @rebindable MediaGalleryItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle when @config.selfFetch\n        (fetch MediaGalleryItem { emit: { success: MediaGalleryLoaded } })\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          title: @config.title\n          items: @config.items\n          columns: @config.columns\n          selectable: @config.selectable\n          selectedItems: @config.selectedItems\n          selectionEvent: @config.selectionEvent\n          showUpload: @config.showUpload\n          actions: @config.actions\n          aspectRatio: @config.aspectRatio\n          type: media-gallery\n        })\n      INIT -> idle when (not @config.selfFetch)\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          title: @config.title\n          items: @config.items\n          columns: @config.columns\n          selectable: @config.selectable\n          selectedItems: @config.selectedItems\n          selectionEvent: @config.selectionEvent\n          showUpload: @config.showUpload\n          actions: @config.actions\n          aspectRatio: @config.aspectRatio\n          type: media-gallery\n        })\n      MediaGalleryLoaded -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @payload.data\n          title: @config.title\n          items: @config.items\n          columns: @config.columns\n          selectable: @config.selectable\n          selectedItems: @config.selectedItems\n          selectionEvent: @config.selectionEvent\n          showUpload: @config.showUpload\n          actions: @config.actions\n          aspectRatio: @config.aspectRatio\n          type: media-gallery\n        })\n    }\n\n    emits {\n      @config.selectionEvent -> external {\n        selection : [string]!\n      }\n        @description \"Event name emitted when selection changes (emitted as UI:{selectionEvent})\"\n        @tier \"essential\"\n      MediaGalleryLoaded\n        @description \"MediaGallery rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : MediaGalleryError\n        @label \"Error\"\n        @description \"Error state (UiError)\"\n        @tier \"presentation\"\n      sortBy : string\n        @label \"Sort By\"\n        @description \"Current sort field\"\n        @tier \"presentation\"\n      sortDirection : \"asc\" | \"desc\" = asc\n        @label \"Sort Direction\"\n        @description \"Current sort direction\"\n        @tier \"presentation\"\n      searchValue : string\n        @label \"Search Value\"\n        @description \"Current search query value\"\n        @tier \"presentation\"\n      pageProp : number\n        @label \"Page\"\n        @description \"Current page number\"\n        @synonyms \"page\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Number of items per page\"\n        @tier \"presentation\"\n      totalCount : number\n        @label \"Total Count\"\n        @description \"Total number of items\"\n        @tier \"presentation\"\n      activeFilters : Map string string = {}\n        @label \"Active Filters\"\n        @description \"Active filters\"\n        @tier \"presentation\"\n      selectedIds : [string] = []\n        @label \"Selected Ids\"\n        @description \"Currently selected item IDs\"\n        @tier \"presentation\"\n      title : string\n        @label \"Title\"\n        @description \"Gallery title\"\n        @tier \"presentation\"\n      items : [MediaGalleryItemsItem] = []\n        @label \"Items\"\n        @description \"Media items\"\n        @tier \"presentation\"\n      columns : number = 3\n        @label \"Columns\"\n        @description \"Column count\"\n        @tier \"presentation\"\n      selectable : boolean = false\n        @label \"Selectable\"\n        @description \"Enable item selection\"\n        @tier \"presentation\"\n      selectedItems : [string] = []\n        @label \"Selected Items\"\n        @description \"Selected item IDs\"\n        @tier \"presentation\"\n      selectionEvent : event = \"SELECTION\"\n        @label \"Selection Event\"\n        @description \"Event name emitted when selection changes (emitted as UI:{selectionEvent})\"\n        @tier \"presentation\"\n      showUpload : boolean = false\n        @label \"Show Upload\"\n        @description \"Show upload button\"\n        @tier \"presentation\"\n      actions : [MediaGalleryActionsItem] = []\n        @label \"Actions\"\n        @description \"Actions\"\n        @tier \"presentation\"\n      aspectRatio : \"square\" | \"landscape\" | \"portrait\" = square\n        @label \"Aspect Ratio\"\n        @description \"Aspect ratio for thumbnails\"\n        @tier \"presentation\"\n      selfFetch : boolean = true\n        @label \"Fetch its own rows on mount?\"\n        @description \"true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/media-gallery\" as MediaGalleryPage -> MediaGalleryRender\n}\n"
}