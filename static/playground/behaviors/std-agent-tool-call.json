  "source": "",
  "lolo": "app std-agent-tool-call \"1.0.0\"\n\"Wraps llm/call-tools — takes messages + tools, returns tool-call result.\"\n\ntype LlmToolCall = { id: string!, type: \"function\", function: { name: string!, arguments: string! } }\n;; JSON Schema is recursive (@almadar/core JsonSchema: properties/items/$defs self-reference)\n;; and .lolo has no recursive-JSON type; this deliberately partial shape declares only the\n;; always-scalar top-level keys and leaves the recursive keys undeclared (honest, not checked).\ntype LlmToolSchema = { type: string, description: string }\ntype LlmMessage = { role: string!, content: string!, toolCalls: [LlmToolCall], toolCallId: string }\ntype LlmToolDef = { name: string!, description: string!, schema: LlmToolSchema }\n\norbital AgentToolCallOrbital {\n\n  entity ToolCall [runtime] {\n    messages : [LlmMessage] = []\n    tools : [LlmToolDef] = []\n    response : string = \"\"\n    status : \"idle\" | \"done\" = idle\n  }\n\n  trait ToolCallExecution -> ToolCall [lifecycle, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.messages [])\n        (set @entity.tools [])\n        (set @entity.response \"\")\n        (set @entity.status idle)\n      CALL_TOOLS -> calling\n        (set @entity.messages ?messages)\n        (set @entity.tools ?tools)\n        (llm/call-tools @entity.messages @entity.tools { emit: { success: TOOLS_CALLED, failure: TOOLS_FAILED } })\n    }\n\n    state calling {\n      TOOLS_CALLED -> done\n        (set @entity.response ?result)\n        (set @entity.status done)\n      TOOLS_FAILED -> done\n        (set @entity.response \"\")\n        (set @entity.status done)\n    }\n\n    state done {\n      INIT -> done\n        (set @entity.status done)\n      RESET -> idle\n        (set @entity.response \"\")\n        (set @entity.messages [])\n        (set @entity.tools [])\n        (set @entity.status idle)\n    }\n\n    emits {\n      TOOLS_CALLED {\n        result : string!\n      }\n    }\n\n    listens {\n      CALL_TOOLS {\n        messages : [LlmMessage]!\n        tools : [LlmToolDef]!\n      }\n    }\n  }\n\n  trait ToolCallReady -> ToolCall [lifecycle, instance] {\n    initial: waiting\n\n    state waiting {\n      INIT -> waiting\n        (set @entity.status idle)\n      TOOLS_CALLED -> ready\n        (set @entity.status done)\n    }\n\n    state ready {\n      INIT -> ready\n        (set @entity.status done)\n      RESET -> waiting\n        (set @entity.status idle)\n    }\n\n    listens {\n      ToolCallExecution.TOOLS_CALLED -> TOOLS_CALLED\n      RESET\n    }\n  }\n\n  page \"/agent-tool-call\" as AgentToolCallPage -> ToolCallExecution, ToolCallReady\n}\n"
}