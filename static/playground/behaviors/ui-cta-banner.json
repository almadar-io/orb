  "source": "",
  "lolo": "app ui-cta-banner \"1.0.0\"\n\"CtaBanner — UI factory (1:1 with the @almadar/ui cta-banner pattern).\"\norbital CtaBannerOrbital {\n  type CtaBannerPrimaryAction = {\n    label : string!\n    href : string!\n  }\n  type CtaBannerSecondaryAction = {\n    label : string!\n    href : string!\n  }\n\n  entity CtaBannerItem [runtime] {\n    id : string!\n  }\n\n  trait CtaBannerRender -> @rebindable CtaBannerItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          title: @config.title\n          subtitle: @config.subtitle\n          primaryAction: @config.primaryAction\n          secondaryAction: @config.secondaryAction\n          background: @config.background\n          align: @config.align\n          className: @config.className\n          type: cta-banner\n        })\n    }\n\n    config {\n      title : string = \"\"\n        @label \"Title\"\n        @description \"Banner headline\"\n        @tier \"presentation\"\n      subtitle : string\n        @label \"Subtitle\"\n        @description \"Supporting text below the title\"\n        @tier \"presentation\"\n      primaryAction : CtaBannerPrimaryAction\n        @label \"Primary Action\"\n        @description \"Primary action button config\"\n        @tier \"presentation\"\n      secondaryAction : CtaBannerSecondaryAction\n        @label \"Secondary Action\"\n        @description \"Secondary action button config\"\n        @tier \"presentation\"\n      background : \"default\" | \"alt\" | \"dark\" | \"gradient\" | \"primary\" = alt\n        @label \"Background\"\n        @description \"Background style\"\n        @tier \"presentation\"\n      align : \"center\" | \"left\" = center\n        @label \"Align\"\n        @description \"Content alignment\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/cta-banner\" as CtaBannerPage -> CtaBannerRender\n}\n"
}