  "source": "",
  "lolo": "app ui-map-view \"1.0.0\"\n\"MapView — UI factory (1:1 with the @almadar/ui map-view pattern).\"\norbital MapViewOrbital {\n  type MapViewMarkersItem = {\n    id : string!\n    lat : number!\n    lng : number!\n    label : string\n    category : string\n  }\n  type MapViewRoutesItem = {\n    id : string!\n    waypoints : [MapViewRoutesItemWaypointsItem]!\n    color : string\n    weight : number\n    opacity : number\n    dashArray : string\n    label : string\n  }\n  type MapViewRoutesItemWaypointsItem = {\n    lat : number!\n    lng : number!\n  }\n  type MapViewMARKERCLICKMarker = {\n    id : string!\n    lat : number!\n    lng : number!\n    label : string\n    category : string\n  }\n\n  entity MapViewItem [runtime] {\n    id : string!\n  }\n\n  trait MapViewRender -> @rebindable MapViewItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          markers: @config.markers\n          routes: @config.routes\n          centerLat: @config.centerLat\n          centerLng: @config.centerLng\n          zoom: @config.zoom\n          height: @config.height\n          onMarkerClick: @config.onMarkerClick\n          onMapClick: @config.onMapClick\n          mapClickEvent: @config.mapClickEvent\n          markerClickEvent: @config.markerClickEvent\n          showClickedPin: @config.showClickedPin\n          className: @config.className\n          showAttribution: @config.showAttribution\n          type: map-view\n        })\n    }\n\n    emits {\n      @config.onMarkerClick -> external {\n        marker : MapViewMARKERCLICKMarker\n        id : string!\n        lat : number!\n        lng : number!\n        label : string\n        category : string\n      }\n        @description \"Callback when a marker is clicked (programmatic use)\"\n        @tier \"essential\"\n      @config.onMapClick -> external {\n        lat : number\n        lng : number\n        latitude : number!\n        longitude : number!\n      }\n        @description \"Callback when the map is clicked (programmatic use)\"\n        @tier \"essential\"\n    }\n\n    config {\n      markers : [MapViewMarkersItem] = []\n        @label \"Markers\"\n        @description \"Array of markers to display\"\n        @tier \"presentation\"\n      routes : [MapViewRoutesItem] = []\n        @label \"Routes\"\n        @description \"Routes (polylines with optional popups) drawn over the tile layer\"\n        @tier \"presentation\"\n      centerLat : number = 51.505\n        @label \"Center Lat\"\n        @description \"Map center latitude\"\n        @tier \"presentation\"\n      centerLng : number = -0.09\n        @label \"Center Lng\"\n        @description \"Map center longitude\"\n        @tier \"presentation\"\n      zoom : number = 13\n        @label \"Zoom\"\n        @description \"Zoom level (1-18, default 13)\"\n        @tier \"presentation\"\n      height : string = \"400px\"\n        @label \"Height\"\n        @description \"Height of the map container (default '400px')\"\n        @tier \"presentation\"\n      onMarkerClick : event = \"MARKER_CLICK\"\n        @label \"On Marker Click\"\n        @description \"Callback when a marker is clicked (programmatic use)\"\n        @tier \"presentation\"\n      onMapClick : event = \"MAP_CLICK\"\n        @label \"On Map Click\"\n        @description \"Callback when the map is clicked (programmatic use)\"\n        @tier \"presentation\"\n      mapClickEvent : event = \"MAP_CLICK\"\n        @label \"Map Click Event\"\n        @description \"Event name dispatched via event bus when the map is clicked. Payload: { latitude, longitude }\"\n        @tier \"presentation\"\n      markerClickEvent : event = \"MARKER_CLICK\"\n        @label \"Marker Click Event\"\n        @description \"Event name dispatched via event bus when a marker is clicked. Payload: full MapMarkerData spread.\"\n        @tier \"presentation\"\n      showClickedPin : boolean = false\n        @label \"Show Clicked Pin\"\n        @description \"Whether to show a pin at the clicked location\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      showAttribution : boolean = true\n        @label \"Show Attribution\"\n        @description \"Show attribution (default true)\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/map-view\" as MapViewPage -> MapViewRender\n}\n"
}