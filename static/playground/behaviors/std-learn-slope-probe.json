                                "rightSamp",
                                [
                                  "array/first",
                                  [
                                    "array/filter",
                                    [],
                                    [
                                      "fn",
                                      "s",
                                      [
                                        ">",
                                        [
                                          "object/get",
                                          "@s",
                                          "x"
                                        ],
                                        "@payload.x"
