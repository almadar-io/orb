                                                    "@s",
                                                    "x"
                                                  ],
                                                  [
                                                    "-",
                                                    "@payload.x",
                                                    1.5
                                                  ]
                                                ],
                                                [
                                                  "<=",
                                                  [
                                                    "object/get",
                                                    "@s",
                                                    "x"
                                                  ],
                                                  [
                                                    "+",
                                                    "@payload.x",
                                                    1.5
                                                  ]
                                                ]
                                              ]
                                            ]
                                          ]
