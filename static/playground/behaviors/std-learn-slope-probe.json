                          ]
                        ]
                      ],
                      [
                        "let",
                        [
                          [
                            "inRange",
                            [
                              "and",
                              "@on",
                              [
                                "and",
                                [
                                  ">=",
                                  "@payload.x",
                                  [
                                    "object/get",
                                    [
                                      "array/first",
                                      []
                                    ],
                                    "x"
                                  ]
                                ],
