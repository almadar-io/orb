                  "event": "BODY_MOVED",
                  "eventId": "evt_01M0PCKHE13WYBS0FD96E41N8P",
                  "guard": true,
                  "effects": [
                    [
                      "let",
                      [
                        [
                          "on",
                          [
                            "and",
                            "@payload.skating",
                            [
                              ">",
                              [
