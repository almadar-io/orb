                                ]
                              ],
                              [
                                "let",
                                [
                                  [
                                    "curveY",
                                    [
                                      "if",
                                      [
                                        "==",
                                        "@rightSamp",
                                        null
                                      ],
                                      [
                                        "object/get",
                                        "@leftSamp",
                                        "y"
                                      ],
                                      [
                                        "+",
                                        [
                                          "object/get",
                                          "@leftSamp",
                                          "y"
                                        ],
                                        [
                                          "*",
                                          "@slope",
