                                            "@curveY",
                                            "@dy"
                                          ]
                                        ],
                                        [
                                          "set",
                                          "@entity.triAx",
                                          "@payload.x"
                                        ],
                                        [
                                          "set",
                                          "@entity.triAy",
                                          "@curveY"
                                        ],
                                        [
                                          "set",
                                          "@entity.triBx",
                                          [
                                            "+",
                                            "@payload.x",
                                            1
                                          ]
                                        ],
                                        [
                                          "set",
                                          "@entity.triBy",
                                          "@curveY"
                                        ],
                                        [
                                          "set",
                                          "@entity.triCx",
                                          [
                                            "+",
                                            "@payload.x",
                                            1
                                          ]
                                        ],
