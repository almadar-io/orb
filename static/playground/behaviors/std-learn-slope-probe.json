                                        ],
                                        [
                                          "set",
                                          "@entity.y",
                                          "@curveY"
                                        ],
                                        [
                                          "set",
                                          "@entity.slope",
                                          "@slope"
                                        ],
                                        [
                                          "set",
                                          "@entity.tax",
                                          [
