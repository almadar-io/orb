  "source": "",
  "lolo": "app ui-icon \"1.0.0\"\n\"Icon — UI factory (1:1 with the @almadar/ui icon pattern).\"\norbital IconOrbital {\n  entity IconItem [runtime] {\n    id : string!\n  }\n\n  trait IconRender -> @rebindable IconItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          icon: @config.icon\n          name: @config.name\n          size: @config.size\n          color: @config.color\n          animation: @config.animation\n          className: @config.className\n          strokeWidth: @config.strokeWidth\n          style: @config.style\n          type: icon\n        })\n    }\n\n    config {\n      icon : icon\n        @label \"Icon\"\n        @description \"Lucide icon component (preferred for type-safe usage), OR a canonical kebab-case icon name string — a string is treated exactly like `name` so trait/factory authors can pass an icon by name through the `icon` prop.\"\n        @tier \"presentation\"\n      name : string\n        @label \"Name\"\n        @description \"Icon name as string (resolved from iconMap)\"\n        @tier \"presentation\"\n      size : \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" = md\n        @label \"Size\"\n        @description \"Size of the icon\"\n        @tier \"presentation\"\n      color : \"primary\" | \"secondary\" | \"success\" | \"warning\" | \"error\" | \"muted\" = primary\n        @label \"Color\"\n        @description \"Semantic palette token or an arbitrary Tailwind color class.\"\n        @tier \"presentation\"\n      animation : \"spin\" | \"pulse\" | \"none\" = none\n        @label \"Animation\"\n        @description \"Animation type\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      strokeWidth : number\n        @label \"Stroke Width\"\n        @description \"Icon stroke width - uses theme default if not specified\"\n        @tier \"presentation\"\n      style : Map string string = {}\n        @label \"Style\"\n        @description \"Inline style\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/icon\" as IconPage -> IconRender\n}\n"
}