  "source": "",
  "lolo": "app ui-date-range-picker \"1.0.0\"\n\"DateRangePicker — UI factory (1:1 with the @almadar/ui date-range-picker pattern).\"\norbital DateRangePickerOrbital {\n  type DateRangePickerPresetsItem = {\n    label : string!\n    value : string!\n  }\n  type DateRangePickerCHANGERange = {\n    from : string!\n    to : string!\n  }\n\n  entity DateRangePickerItem [runtime] {\n    id : string!\n    fromProp : string\n    toProp : string\n  }\n\n  trait DateRangePickerRender -> @rebindable DateRangePickerItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.fromProp @config.fromProp)\n        (set @entity.toProp @config.toProp)\n        (render-ui main {\n          from: @entity.fromProp\n          to: @entity.toProp\n          event: @config.event\n          onChange: @config.onChange\n          presets: @config.presets\n          fromLabel: @config.fromLabel\n          toLabel: @config.toLabel\n          className: @config.className\n          type: date-range-picker\n        })\n      EVENT -> idle\n        (set @entity.fromProp ?from)\n        (set @entity.toProp ?to)\n        (render-ui main {\n          from: @entity.fromProp\n          to: @entity.toProp\n          event: @config.event\n          onChange: @config.onChange\n          presets: @config.presets\n          fromLabel: @config.fromLabel\n          toLabel: @config.toLabel\n          className: @config.className\n          type: date-range-picker\n        })\n    }\n\n    emits {\n      @config.event -> external {\n        from : string!\n        to : string!\n      }\n        @description \"Event name emitted as `UI:{event}` with payload `{ from, to }`. Optional — when omitted, only the `onChange` callback fires.\"\n        @tier \"essential\"\n      @config.onChange -> external {\n        range : DateRangePickerCHANGERange\n      }\n        @description \"Callback fired alongside the bus emit.\"\n        @tier \"essential\"\n    }\n\n    listens {\n      EVENT {\n        from : string!\n        to : string!\n      }\n    }\n\n    config {\n      fromProp : string\n        @label \"From\"\n        @description \"Controlled `from` (ISO date YYYY-MM-DD).\"\n        @synonyms \"from\"\n        @tier \"presentation\"\n      toProp : string\n        @label \"To\"\n        @description \"Controlled `to` (ISO date YYYY-MM-DD).\"\n        @synonyms \"to\"\n        @tier \"presentation\"\n      event : event = \"EVENT\"\n        @label \"Event\"\n        @description \"Event name emitted as `UI:{event}` with payload `{ from, to }`. Optional — when omitted, only the `onChange` callback fires.\"\n        @tier \"presentation\"\n      onChange : event = \"CHANGE\"\n        @label \"On Change\"\n        @description \"Callback fired alongside the bus emit.\"\n        @tier \"presentation\"\n      presets : [DateRangePickerPresetsItem] = []\n        @label \"Presets\"\n        @description \"Preset shortcuts. Defaults to the standard finance set (Last 7d / Last 30d / This Month / This Quarter / YTD). Pass an empty array to hide presets entirely.\"\n        @tier \"presentation\"\n      fromLabel : string = From\n        @label \"From Label\"\n        @description \"From-input label.\"\n        @tier \"presentation\"\n      toLabel : string = To\n        @label \"To Label\"\n        @description \"To-input label.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/date-range-picker\" as DateRangePickerPage -> DateRangePickerRender\n}\n"
}