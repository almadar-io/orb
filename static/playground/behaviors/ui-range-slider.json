  "source": "",
  "lolo": "app ui-range-slider \"1.0.0\"\n\"RangeSlider — UI factory (1:1 with the @almadar/ui range-slider pattern).\"\norbital RangeSliderOrbital {\n  entity RangeSliderItem [runtime] {\n    id : string!\n    value : number = 0\n  }\n\n  trait RangeSliderRender -> @rebindable RangeSliderItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.value @config.value)\n        (render-ui main {\n          className: @config.className\n          min: @config.min\n          max: @config.max\n          value: @entity.value\n          step: @config.step\n          showTooltip: @config.showTooltip\n          showTicks: @config.showTicks\n          buffered: @config.buffered\n          size: @config.size\n          disabled: @config.disabled\n          action: @config.action\n          actionPayload: @config.actionPayload\n          onChange: @config.onChange\n          type: range-slider\n        })\n      ACTION -> idle\n        (set @entity.value ?value)\n        (render-ui main {\n          className: @config.className\n          min: @config.min\n          max: @config.max\n          value: @entity.value\n          step: @config.step\n          showTooltip: @config.showTooltip\n          showTicks: @config.showTicks\n          buffered: @config.buffered\n          size: @config.size\n          disabled: @config.disabled\n          action: @config.action\n          actionPayload: @config.actionPayload\n          onChange: @config.onChange\n          type: range-slider\n        })\n      CHANGE -> idle\n        (set @entity.value ?value)\n        (render-ui main {\n          className: @config.className\n          min: @config.min\n          max: @config.max\n          value: @entity.value\n          step: @config.step\n          showTooltip: @config.showTooltip\n          showTicks: @config.showTicks\n          buffered: @config.buffered\n          size: @config.size\n          disabled: @config.disabled\n          action: @config.action\n          actionPayload: @config.actionPayload\n          onChange: @config.onChange\n          type: range-slider\n        })\n    }\n\n    emits {\n      @config.action -> external {\n        value : number!\n      }\n        @description \"Declarative event name for value changes\"\n        @tier \"essential\"\n      @config.onChange -> external {\n        value : number\n      }\n        @description \"Direct onChange callback\"\n        @tier \"essential\"\n    }\n\n    listens {\n      ACTION {\n        value : number!\n      }\n      CHANGE {\n        value : number\n      }\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes applied to the root element.\"\n        @tier \"presentation\"\n      min : number = 0\n        @label \"Min\"\n        @description \"Minimum value\"\n        @tier \"presentation\"\n      max : number = 100\n        @label \"Max\"\n        @description \"Maximum value\"\n        @tier \"presentation\"\n      value : number = 0\n        @label \"Value\"\n        @description \"Current value\"\n        @tier \"presentation\"\n      step : number = 1\n        @label \"Step\"\n        @description \"Step increment\"\n        @tier \"presentation\"\n      showTooltip : boolean = false\n        @label \"Show Tooltip\"\n        @description \"Show tooltip with current value on drag\"\n        @tier \"presentation\"\n      showTicks : boolean = false\n        @label \"Show Ticks\"\n        @description \"Show tick marks at step intervals\"\n        @tier \"presentation\"\n      buffered : number\n        @label \"Buffered\"\n        @description \"Buffered range (0-100), for media seek bars\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Slider size\"\n        @tier \"presentation\"\n      disabled : boolean = false\n        @label \"Disabled\"\n        @description \"Disabled state\"\n        @tier \"presentation\"\n      action : event = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event name for value changes\"\n        @tier \"presentation\"\n      actionPayload : @payload @config.action\n        @label \"Action Payload\"\n        @description \"Payload to include with the action event\"\n        @tier \"presentation\"\n      onChange : event = \"CHANGE\"\n        @label \"On Change\"\n        @description \"Direct onChange callback\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/range-slider\" as RangeSliderPage -> RangeSliderRender\n}\n"
}