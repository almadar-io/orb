                "label": "Width",
                "description": "Canvas width in pixels.",
                "tier": "presentation"
              }
            },
            "scope": "instance"
          }
        ],
        "pages": [
          {
            "name": "HeapSortEnginePage",
            "path": "/algo-heapsort",
            "traits": [
