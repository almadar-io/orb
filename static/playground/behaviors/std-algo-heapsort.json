                    "value": 7
                  },
                  {
                    "value": 4,
                    "color": "#3b82f6",
                    "label": "4"
                  }
                ],
                "label": "Bars",
                "description": "Initial unsorted array; each bar's height is proportional to its value.",
                "tier": "domain",
                "items": {
                  "type": "object",
                  "properties": {
                    "color": {
                      "name": "color",
                      "type": "string",
                      "required": false
                    },
                    "label": {
                      "name": "label",
                      "type": "string",
                      "required": false
                    },
                    "value": {
