              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "BARS_UPDATED",
                  "name": "Bars Updated",
                  "description": "The current bar array each step — a composed listener (a mirror canvas, a readout) can subscribe; a harmless no-op standalone.",
                  "synonyms": "tick, frame, step, redraw, compare, swap, sift, heapify, extract",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "bars",
                      "type": "[AlgoBar]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.bars",
                      [
                        {
                          "value": 5,
                          "label": "5",
                          "color": "#3b82f6"
                        },
                        {
                          "value": 2,
                          "color": "#3b82f6",
                          "label": "2"
                        },
                        {
                          "label": "8",
                          "value": 8,
                          "color": "#3b82f6"
                        },
                        {
                          "color": "#3b82f6",
                          "label": "1",
                          "value": 1
                        },
                        {
                          "color": "#3b82f6",
                          "value": 9,
                          "label": "9"
                        },
                        {
                          "color": "#3b82f6",
                          "value": 3,
                          "label": "3"
                        },
                        {
                          "label": "7",
                          "color": "#3b82f6",
                          "value": 7
                        },
                        {
                          "value": 4,
                          "color": "#3b82f6",
                          "label": "4"
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.heapSize",
                      [
                        "array/len",
                        [
                          {
                            "value": 5,
                            "label": "5",
                            "color": "#3b82f6"
                          },
                          {
                            "value": 2,
                            "color": "#3b82f6",
                            "label": "2"
                          },
                          {
                            "label": "8",
                            "value": 8,
                            "color": "#3b82f6"
                          },
                          {
                            "color": "#3b82f6",
                            "label": "1",
                            "value": 1
                          },
                          {
                            "color": "#3b82f6",
                            "value": 9,
                            "label": "9"
                          },
                          {
                            "color": "#3b82f6",
                            "value": 3,
                            "label": "3"
                          },
                          {
                            "label": "7",
                            "color": "#3b82f6",
                            "value": 7
                          },
                          {
                            "value": 4,
                            "color": "#3b82f6",
                            "label": "4"
                          }
                        ]
                      ]
                    ],
                    [
                      "set",
                      "@entity.phase",
                      0
                    ],
                    [
                      "set",
                      "@entity.origin",
                      [
                        "-",
                        [
                          "math/floor",
                          [
                            "/",
                            [
                              "array/len",
                              [
                                {
                                  "value": 5,
                                  "label": "5",
                                  "color": "#3b82f6"
                                },
                                {
                                  "value": 2,
                                  "color": "#3b82f6",
                                  "label": "2"
                                },
                                {
                                  "label": "8",
                                  "value": 8,
                                  "color": "#3b82f6"
                                },
                                {
                                  "color": "#3b82f6",
                                  "label": "1",
                                  "value": 1
                                },
                                {
                                  "color": "#3b82f6",
                                  "value": 9,
                                  "label": "9"
                                },
                                {
                                  "color": "#3b82f6",
                                  "value": 3,
                                  "label": "3"
                                },
                                {
                                  "label": "7",
                                  "color": "#3b82f6",
                                  "value": 7
                                },
                                {
                                  "value": 4,
                                  "color": "#3b82f6",
                                  "label": "4"
                                }
                              ]
                            ],
                            2
                          ]
                        ],
                        1
                      ]
                    ],
                    [
                      "set",
                      "@entity.root",
                      [
                        "-",
                        [
                          "math/floor",
                          [
                            "/",
                            [
                              "array/len",
                              [
                                {
                                  "value": 5,
                                  "label": "5",
                                  "color": "#3b82f6"
                                },
                                {
                                  "value": 2,
                                  "color": "#3b82f6",
                                  "label": "2"
                                },
                                {
                                  "label": "8",
                                  "value": 8,
                                  "color": "#3b82f6"
                                },
                                {
                                  "color": "#3b82f6",
                                  "label": "1",
                                  "value": 1
                                },
                                {
                                  "color": "#3b82f6",
                                  "value": 9,
                                  "label": "9"
                                },
                                {
                                  "color": "#3b82f6",
                                  "value": 3,
                                  "label": "3"
                                },
                                {
                                  "label": "7",
                                  "color": "#3b82f6",
                                  "value": 7
                                },
                                {
                                  "value": 4,
                                  "color": "#3b82f6",
                                  "label": "4"
                                }
                              ]
                            ],
                            2
                          ]
                        ],
                        1
                      ]
                    ],
                    [
                      "set",
                      "@entity.done",
                      false
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "type": "algorithm-canvas",
                        "width": 600,
                        "bars": "@entity.bars",
                        "height": 400,
                        "backgroundColor": "#f8fafc"
                      }
                    ],
                    [
                      "emit",
                      "BARS_UPDATED",
                      {
                        "bars": "@entity.bars"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "heapTick",
                "interval": 350,
                "guard": [
                  "and",
                  "@entity.running",
                  [
                    "not",
                    "@entity.done"
                  ]
                ],
                "effects": [
                  [
                    "set",
                    "@entity.largest",
                    [
                      "let",
                      [
                        [
                          "lc",
                          [
                            "+",
                            [
                              "*",
                              2,
                              "@entity.root"
                            ],
                            1
                          ]
                        ],
                        [
                          "rc",
                          [
                            "+",
                            [
                              "*",
                              2,
                              "@entity.root"
                            ],
                            2
                          ]
                        ]
                      ],
                      [
                        "let",
                        [
                          [
                            "afterL",
                            [
                              "if",
                              [
                                "and",
                                [
                                  "<",
                                  "lc",
                                  "@entity.heapSize"
                                ],
                                [
                                  ">",
                                  [
                                    "object/get",
                                    [
                                      "array/nth",
                                      "@entity.bars",
                                      "lc"
                                    ],
                                    "value"
                                  ],
                                  [
                                    "object/get",
                                    [
                                      "array/nth",
                                      "@entity.bars",
                                      "@entity.root"
                                    ],
                                    "value"
                                  ]
                                ]
                              ],
                              "lc",
                              "@entity.root"
                            ]
                          ]
                        ],
                        [
                          "if",
                          [
                            "and",
                            [
                              "<",
                              "rc",
                              "@entity.heapSize"
                            ],
                            [
                              ">",
                              [
                                "object/get",
                                [
                                  "array/nth",
                                  "@entity.bars",
                                  "rc"
                                ],
                                "value"
                              ],
                              [
                                "object/get",
                                [
                                  "array/nth",
                                  "@entity.bars",
                                  "afterL"
                                ],
                                "value"
                              ]
                            ]
                          ],
                          "rc",
                          "afterL"
                        ]
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.willSwap",
                    [
                      "not",
                      [
                        "==",
                        "@entity.largest",
                        "@entity.root"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.buildMore",
                    [
                      "and",
                      [
                        "not",
                        "@entity.willSwap"
                      ],
                      [
                        "==",
                        "@entity.phase",
                        0
                      ],
                      [
                        ">=",
                        "@entity.origin",
                        1
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.buildDone",
                    [
                      "and",
                      [
                        "not",
                        "@entity.willSwap"
                      ],
                      [
                        "==",
                        "@entity.phase",
                        0
                      ],
                      [
                        "==",
                        "@entity.origin",
                        0
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.sortExtract",
                    [
                      "and",
                      [
                        "not",
                        "@entity.willSwap"
                      ],
                      [
                        "==",
                        "@entity.phase",
                        1
                      ],
                      [
                        ">",
                        "@entity.heapSize",
                        1
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.finished",
                    [
                      "and",
                      [
                        "not",
                        "@entity.willSwap"
                      ],
                      [
                        "==",
                        "@entity.phase",
                        1
                      ],
                      [
                        "<=",
                        "@entity.heapSize",
                        1
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.doSwap",
                    [
                      "or",
                      "@entity.willSwap",
                      [
                        "or",
                        "@entity.buildDone",
                        "@entity.sortExtract"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.swapA",
                    [
                      "if",
                      "@entity.willSwap",
                      "@entity.root",
                      0
                    ]
                  ],
                  [
                    "set",
                    "@entity.swapB",
                    [
                      "if",
                      "@entity.willSwap",
                      "@entity.largest",
                      [
                        "-",
                        "@entity.heapSize",
                        1
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.bars",
                    [
                      "array/map",
                      "@entity.bars",
                      [
                        "object/merge",
                        "@item",
                        {
                          "value": [
                            "if",
                            [
                              "and",
                              "@entity.doSwap",
                              [
                                "==",
                                "@index",
                                "@entity.swapA"
                              ]
                            ],
                            [
                              "object/get",
                              [
                                "array/nth",
                                "@entity.bars",
                                "@entity.swapB"
                              ],
                              "value"
                            ],
                            [
                              "if",
                              [
                                "and",
                                "@entity.doSwap",
                                [
                                  "==",
                                  "@index",
                                  "@entity.swapB"
                                ]
                              ],
                              [
                                "object/get",
                                [
                                  "array/nth",
                                  "@entity.bars",
                                  "@entity.swapA"
                                ],
                                "value"
                              ],
                              [
                                "object/get",
                                "@item",
                                "value"
                              ]
                            ]
                          ],
                          "color": [
                            "if",
                            "@entity.finished",
                            "#22c55e",
                            [
                              "if",
                              [
                                ">=",
                                "@index",
                                "@entity.heapSize"
                              ],
                              "#22c55e",
                              [
                                "if",
                                [
                                  "==",
                                  "@index",
                                  "@entity.root"
                                ],
                                "#f59e0b",
                                [
                                  "if",
                                  [
                                    "and",
                                    "@entity.willSwap",
                                    [
                                      "==",
                                      "@index",
                                      "@entity.largest"
                                    ]
                                  ],
                                  "#fbbf24",
                                  "#3b82f6"
                                ]
                              ]
                            ]
                          ]
                        }
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.root",
                    [
                      "if",
                      "@entity.willSwap",
                      "@entity.largest",
                      [
                        "if",
                        "@entity.buildMore",
                        [
                          "-",
                          "@entity.origin",
                          1
                        ],
                        [
                          "if",
                          "@entity.buildDone",
                          0,
                          [
                            "if",
                            "@entity.sortExtract",
                            0,
                            "@entity.root"
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.origin",
                    [
                      "if",
                      "@entity.buildMore",
                      [
                        "-",
                        "@entity.origin",
                        1
                      ],
                      "@entity.origin"
                    ]
                  ],
                  [
                    "set",
                    "@entity.phase",
                    [
                      "if",
                      [
                        "and",
                        [
                          "==",
                          "@entity.phase",
                          0
                        ],
                        [
                          "not",
                          "@entity.buildDone"
                        ]
                      ],
                      0,
                      1
                    ]
                  ],
                  [
                    "set",
                    "@entity.heapSize",
                    [
                      "if",
                      [
                        "or",
                        "@entity.buildDone",
                        "@entity.sortExtract"
                      ],
                      [
                        "-",
                        "@entity.heapSize",
                        1
                      ],
                      "@entity.heapSize"
                    ]
                  ],
                  [
                    "set",
                    "@entity.done",
                    "@entity.finished"
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "algorithm-canvas",
                      "bars": "@entity.bars",
                      "width": 600,
                      "backgroundColor": "#f8fafc",
                      "height": 400
                    }
                  ],
                  [
                    "emit",
                    "BARS_UPDATED",
                    {
                      "bars": "@entity.bars"
                    }
                  ]
                ]
              }
            ],
            "config": {
              "height": {
                "type": "number",
                "default": 400,
                "label": "Height",
                "description": "Canvas height in pixels.",
                "tier": "presentation"
              },
              "running": {
                "type": "boolean",
                "default": true,
                "label": "Running",
                "description": "When true the tick performs one sift/extract micro-step; toggle to start/pause the sort.",
                "tier": "domain"
              },
              "bars": {
