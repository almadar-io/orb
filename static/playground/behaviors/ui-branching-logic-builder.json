  "lolo": "app ui-branching-logic-builder \"1.0.0\"\n\"BranchingLogicBuilder — UI factory (1:1 with the @almadar/ui branching-logic-builder pattern).\"\norbital BranchingLogicBuilderOrbital {\n  type BranchingLogicBuilderQuestionsItem = {\n    id : string!\n    label : string!\n    optionValues : [string]\n  }\n  type BranchingLogicBuilderRulesItem = {\n    id : string!\n    sourceQuestionId : string!\n    operator : \"equals\" | \"not-equals\" | \"contains\" | \"in\"!\n    value : string!\n    targetQuestionId : string!\n  }\n  type BranchingLogicBuilderRULESCHANGERulesItem = {\n    id : string!\n    sourceQuestionId : string!\n    operator : \"equals\" | \"not-equals\" | \"contains\" | \"in\"!\n    value : string!\n    targetQuestionId : string!\n  }\n\n  entity BranchingLogicBuilderItem [runtime] {\n    id : string!\n  }\n\n  trait BranchingLogicBuilderRender -> @rebindable BranchingLogicBuilderItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          questions: @config.questions\n          rules: @config.rules\n          onRulesChange: @config.onRulesChange\n          rulesChangeEvent: @config.rulesChangeEvent\n          readOnly: @config.readOnly\n          className: @config.className\n          type: branching-logic-builder\n        })\n    }\n\n    emits {\n      @config.onRulesChange -> external {\n        rules : [BranchingLogicBuilderRULESCHANGERulesItem]\n      }\n        @description \"onRulesChange prop\"\n        @tier \"essential\"\n    }\n\n    config {\n      questions : [BranchingLogicBuilderQuestionsItem] = [{ id: \"Id\", label: \"Label\", optionValues: [\"Item\", \"Item 2\"] }, { id: \"Id 2\", label: \"Label 2\", optionValues: [\"Item\", \"Item 2\"] }]\n        @label \"Questions\"\n        @description \"questions prop\"\n        @tier \"presentation\"\n      rules : [BranchingLogicBuilderRulesItem] = [{ id: \"Id\", sourceQuestionId: \"Source Question Id\", operator: equals, value: \"Value\", targetQuestionId: \"Target Question Id\" }, { id: \"Id 2\", sourceQuestionId: \"Source Question Id 2\", operator: \"not-equals\", value: \"Value 2\", targetQuestionId: \"Target Question Id 2\" }]\n        @label \"Rules\"\n        @description \"Rules. Accepts either a typed array (direct consumers) or the runtime payload shape from a render-ui binding (`@payload.data`). Narrowed to `[]` internally when the value isn't an array.\"\n        @tier \"presentation\"\n      onRulesChange : event = \"RULES_CHANGE\"\n        @label \"On Rules Change\"\n        @description \"onRulesChange prop\"\n        @tier \"presentation\"\n      rulesChangeEvent : event = \"RULES_CHANGE\"\n        @label \"Rules Change Event\"\n        @description \"Event name dispatched via event bus when rules change. Payload: `{ rules }`.\"\n        @tier \"presentation\"\n      readOnly : boolean = false\n        @label \"Read Only\"\n        @description \"readOnly prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/branching-logic-builder\" as BranchingLogicBuilderPage -> BranchingLogicBuilderRender\n}\n"
}