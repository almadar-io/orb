  "source": "",
  "lolo": "app ui-day-cell \"1.0.0\"\n\"DayCell — UI factory (1:1 with the @almadar/ui day-cell pattern).\"\norbital DayCellOrbital {\n  entity DayCellItem [runtime] {\n    id : string!\n  }\n\n  trait DayCellRender -> @rebindable DayCellItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          date: @config.date\n          isToday: @config.isToday\n          onClick: @config.onClick\n          className: @config.className\n          type: day-cell\n        })\n    }\n\n    emits {\n      @config.onClick -> external {\n        date : date\n      }\n        @description \"Called when the day is clicked\"\n        @tier \"essential\"\n    }\n\n    config {\n      date : date = \"2024-01-01\"\n        @label \"Date\"\n        @description \"The date this cell represents. Optional at the dynamic render edge: an unbound `@config.date` arrives as `undefined`, so the cell falls back to today.\"\n        @tier \"presentation\"\n      isToday : boolean = false\n        @label \"Is Today\"\n        @description \"Whether this date is today\"\n        @tier \"presentation\"\n      onClick : event = \"CLICK\"\n        @label \"On Click\"\n        @description \"Called when the day is clicked\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/day-cell\" as DayCellPage -> DayCellRender\n}\n"
}