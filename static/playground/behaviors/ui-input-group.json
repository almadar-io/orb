  "source": "",
  "lolo": "app ui-input-group \"1.0.0\"\n\"InputGroup — UI factory (1:1 with the @almadar/ui input-group pattern).\"\norbital InputGroupOrbital {\n  type InputGroupOptionsItem = {\n    value : string!\n    label : string!\n  }\n\n  entity InputGroupItem [runtime] {\n    id : string!\n    value : string\n  }\n\n  trait InputGroupRender -> @rebindable InputGroupItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.value @config.value)\n        (render-ui main {\n          className: @config.className\n          placeholder: @config.placeholder\n          value: @entity.value\n          disabled: @config.disabled\n          action: @config.action\n          inputType: @config.inputType\n          label: @config.label\n          helperText: @config.helperText\n          error: @config.error\n          leftIcon: @config.leftIcon\n          rightIcon: @config.rightIcon\n          clearable: @config.clearable\n          onClear: @config.onClear\n          options: @config.options\n          rows: @config.rows\n          onChange: @config.onChange\n          leftAddon: @config.leftAddon\n          rightAddon: @config.rightAddon\n          type: input-group\n        })\n      ACTION -> idle\n        (set @entity.value ?value)\n        (render-ui main {\n          className: @config.className\n          placeholder: @config.placeholder\n          value: @entity.value\n          disabled: @config.disabled\n          action: @config.action\n          inputType: @config.inputType\n          label: @config.label\n          helperText: @config.helperText\n          error: @config.error\n          leftIcon: @config.leftIcon\n          rightIcon: @config.rightIcon\n          clearable: @config.clearable\n          onClear: @config.onClear\n          options: @config.options\n          rows: @config.rows\n          onChange: @config.onChange\n          leftAddon: @config.leftAddon\n          rightAddon: @config.rightAddon\n          type: input-group\n        })\n    }\n\n    emits {\n      @config.action -> external {\n        value : match @config.inputType {\n          \"number\" -> number\n          _ -> string\n        }!\n      }\n        @description \"Declarative event name for trait dispatch.\"\n        @tier \"essential\"\n      @config.onClear -> external { }\n        @description \"Callback or declarative event key when clear button is clicked\"\n        @tier \"essential\"\n      @config.onChange -> external { }\n        @description \"onChange handler or declarative event key for trait dispatch\"\n        @tier \"essential\"\n    }\n\n    listens {\n      ACTION {\n        value : match @config.inputType {\n          \"number\" -> number\n          _ -> string\n        }!\n      }\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      placeholder : string\n        @label \"Placeholder\"\n        @description \"Placeholder text\"\n        @tier \"presentation\"\n      value : string\n        @label \"Value\"\n        @description \"Current value\"\n        @tier \"presentation\"\n      disabled : boolean\n        @label \"Disabled\"\n        @description \"Whether input is disabled\"\n        @tier \"presentation\"\n      action : event = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event name for trait dispatch.\"\n        @tier \"presentation\"\n      inputType : \"text\" | \"email\" | \"password\" | \"number\" | \"tel\" | \"url\" | \"search\" | \"date\" | \"datetime-local\" | \"time\" | \"checkbox\" | \"select\" | \"textarea\" = text\n        @label \"Input Type\"\n        @description \"Input type — selects the field's data mode. Use 'password' for masked credentials / secret / passphrase entry (there is no separate password pattern); 'email', 'tel', 'url', 'number', 'search', 'date', and 'time' for their respective values; and 'select' / 'textarea' for choice and multi-line entry in addition to the standard single-line types.\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"label prop\"\n        @tier \"presentation\"\n      helperText : string\n        @label \"Helper Text\"\n        @description \"helperText prop\"\n        @tier \"presentation\"\n      error : string\n        @label \"Error\"\n        @description \"error prop\"\n        @tier \"presentation\"\n      leftIcon : icon\n        @label \"Left Icon\"\n        @description \"leftIcon prop\"\n        @tier \"presentation\"\n      rightIcon : icon\n        @label \"Right Icon\"\n        @description \"rightIcon prop\"\n        @tier \"presentation\"\n      clearable : boolean\n        @label \"Clearable\"\n        @description \"Show clear button when input has value\"\n        @tier \"presentation\"\n      onClear : event = \"CLEAR\"\n        @label \"On Clear\"\n        @description \"Callback or declarative event key when clear button is clicked\"\n        @tier \"presentation\"\n      options : [InputGroupOptionsItem] = []\n        @label \"Options\"\n        @description \"Options for select type\"\n        @tier \"presentation\"\n      rows : number\n        @label \"Rows\"\n        @description \"Rows for textarea type\"\n        @tier \"presentation\"\n      onChange : event = \"CHANGE\"\n        @label \"On Change\"\n        @description \"onChange handler or declarative event key for trait dispatch\"\n        @tier \"presentation\"\n      leftAddon : node\n        @label \"Left Addon\"\n        @description \"Left addon (icon, button, or text)\"\n        @tier \"presentation\"\n      rightAddon : node\n        @label \"Right Addon\"\n        @description \"Right addon (icon, button, or text)\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/input-group\" as InputGroupPage -> InputGroupRender\n}\n"
}