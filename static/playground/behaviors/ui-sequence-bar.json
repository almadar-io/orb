  "source": "",
  "lolo": "app ui-sequence-bar \"1.0.0\"\n\"SequenceBar — UI factory (1:1 with the @almadar/ui sequence-bar pattern).\"\norbital SequenceBarOrbital {\n  type SequenceBarSlotsItem = {\n    id : string!\n    name : string!\n    category : string!\n    description : string\n    iconEmoji : string\n    iconUrl : SequenceBarSlotsItemIconUrl\n    stateMachine : object\n  }\n  type SequenceBarSlotsItemIconUrl = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n  type SequenceBarCategoryColorsValue = {\n    bg : string!\n    border : string!\n  }\n  type SequenceBarSLOTDROPItem = {\n    id : string!\n    name : string!\n    category : string!\n    description : string\n    iconEmoji : string\n    iconUrl : SequenceBarSLOTDROPItemIconUrl\n    stateMachine : object\n  }\n  type SequenceBarSLOTDROPItemIconUrl = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n\n  entity SequenceBarItem [runtime] {\n    id : string!\n  }\n\n  trait SequenceBarRender -> @rebindable SequenceBarItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          slots: @config.slots\n          maxSlots: @config.maxSlots\n          onSlotDrop: @config.onSlotDrop\n          onSlotRemove: @config.onSlotRemove\n          slotDropEvent: @config.slotDropEvent\n          slotRemoveEvent: @config.slotRemoveEvent\n          playing: @config.playing\n          currentStep: @config.currentStep\n          categoryColors: @config.categoryColors\n          slotFeedback: @config.slotFeedback\n          size: @config.size\n          className: @config.className\n          type: sequence-bar\n        })\n    }\n\n    emits {\n      @config.onSlotDrop -> external {\n        index : number\n        item : SequenceBarSLOTDROPItem\n        slotNumber : number!\n        itemId : string!\n      }\n        @description \"Called when an item is dropped into slot at index (callback path)\"\n        @tier \"essential\"\n      @config.onSlotRemove -> external {\n        index : number\n        slotNumber : number!\n      }\n        @description \"Called when a slot is cleared (callback path)\"\n        @tier \"essential\"\n    }\n\n    config {\n      slots : [SequenceBarSlotsItem] = [{ id: \"Id\", name: \"Name\", category: \"Category\", description: \"Description\", iconEmoji: \"Icon Emoji\", iconUrl: { url: \"https://almadar-kflow-assets.web.app/shared/ui-battle-board/default/ui/star.png\", role: \"ui\", category: \"iconUrl\", animations: [\"static\"], style: \"pixel\", dimension: \"2d\", aspect: \"1:1\", name: \"iconUrl\", thumbnailUrl: \"\" } }, { id: \"Id 2\", name: \"Name 2\", category: \"Category 2\", description: \"Description 2\", iconEmoji: \"Icon Emoji 2\", iconUrl: { url: \"https://almadar-kflow-assets.web.app/shared/ui-battle-board/default/ui/star.png\", role: \"ui\", category: \"iconUrl\", animations: [\"static\"], style: \"pixel\", dimension: \"2d\", aspect: \"1:1\", name: \"iconUrl\", thumbnailUrl: \"\" } }]\n        @label \"Slots\"\n        @description \"The current sequence (sparse — undefined means empty slot)\"\n        @tier \"presentation\"\n      maxSlots : number = 1\n        @label \"Max Slots\"\n        @description \"Max number of slots\"\n        @tier \"presentation\"\n      onSlotDrop : event = \"SLOT_DROP\"\n        @label \"On Slot Drop\"\n        @description \"Called when an item is dropped into slot at index (callback path)\"\n        @tier \"presentation\"\n      onSlotRemove : event = \"SLOT_REMOVE\"\n        @label \"On Slot Remove\"\n        @description \"Called when a slot is cleared (callback path)\"\n        @tier \"presentation\"\n      slotDropEvent : event = \"SLOT_DROP\"\n        @label \"Slot Drop Event\"\n        @description \"Emits UI:{slotDropEvent} with { slotNumber, itemId } when an item is dropped (declarative path)\"\n        @tier \"presentation\"\n      slotRemoveEvent : event = \"SLOT_REMOVE\"\n        @label \"Slot Remove Event\"\n        @description \"Emits UI:{slotRemoveEvent} with { slotNumber } when a slot is cleared (declarative path)\"\n        @tier \"presentation\"\n      playing : boolean = false\n        @label \"Playing\"\n        @description \"Whether the sequence is currently playing (disable interaction)\"\n        @tier \"presentation\"\n      currentStep : number = -1\n        @label \"Current Step\"\n        @description \"Current step index during playback (-1 = not playing)\"\n        @tier \"presentation\"\n      categoryColors : Map string SequenceBarCategoryColorsValue = {}\n        @label \"Category Colors\"\n        @description \"Category → color mapping\"\n        @tier \"presentation\"\n      slotFeedback : [\"correct\" | \"wrong\"] = []\n        @label \"Slot Feedback\"\n        @description \"Per-slot correctness feedback shown after a failed attempt\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = lg\n        @label \"Size\"\n        @description \"Size variant\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/sequence-bar\" as SequenceBarPage -> SequenceBarRender\n}\n"
}