  "source": "",
  "lolo": "app ui-split-section \"1.0.0\"\n\"SplitSection — UI factory (1:1 with the @almadar/ui split-section pattern).\"\norbital SplitSectionOrbital {\n  type SplitSectionImage = {\n    src : asset!\n    alt : string!\n  }\n\n  entity SplitSectionItem [runtime] {\n    id : string!\n  }\n\n  trait SplitSectionRender -> @rebindable SplitSectionItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          title: @config.title\n          description: @config.description\n          bullets: @config.bullets\n          image: @config.image\n          imagePosition: @config.imagePosition\n          background: @config.background\n          children: @config.children\n          className: @config.className\n          type: split-section\n        })\n    }\n\n    config {\n      title : string = \"\"\n        @label \"Title\"\n        @description \"title prop\"\n        @tier \"presentation\"\n      description : node = []\n        @label \"Description\"\n        @description \"description prop\"\n        @tier \"presentation\"\n      bullets : [string] = []\n        @label \"Bullets\"\n        @description \"bullets prop\"\n        @tier \"presentation\"\n      image : SplitSectionImage\n        @label \"Image\"\n        @description \"image prop\"\n        @tier \"presentation\"\n      imagePosition : \"left\" | \"right\" = right\n        @label \"Image Position\"\n        @description \"imagePosition prop\"\n        @tier \"presentation\"\n      background : \"default\" | \"alt\" = default\n        @label \"Background\"\n        @description \"background prop\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"children prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/split-section\" as SplitSectionPage -> SplitSectionRender\n}\n"
}