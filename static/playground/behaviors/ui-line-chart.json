  "source": "",
  "lolo": "app ui-line-chart \"1.0.0\"\n\"LineChart — UI factory (1:1 with the @almadar/ui line-chart pattern).\"\norbital LineChartOrbital {\n  type LineChartDataItem = {\n    date : date\n    value : number!\n    label : string\n  }\n\n  entity LineChartItem [runtime] {\n    id : string!\n  }\n\n  trait LineChartRender -> @rebindable LineChartItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          data: @config.data\n          width: @config.width\n          height: @config.height\n          showGrid: @config.showGrid\n          showValues: @config.showValues\n          showArea: @config.showArea\n          lineColor: @config.lineColor\n          areaColor: @config.areaColor\n          className: @config.className\n          type: line-chart\n        })\n    }\n\n    config {\n      data : [LineChartDataItem] = [{ date: \"2024-01-01\", value: 1, label: \"Label\" }, { date: \"2024-01-01\", value: 2, label: \"Label 2\" }]\n        @label \"Data\"\n        @description \"Data points to plot\"\n        @tier \"presentation\"\n      width : number = 400\n        @label \"Width\"\n        @description \"SVG viewBox width\"\n        @tier \"presentation\"\n      height : number = 200\n        @label \"Height\"\n        @description \"SVG viewBox height\"\n        @tier \"presentation\"\n      showGrid : boolean = true\n        @label \"Show Grid\"\n        @description \"Show horizontal grid lines at 25/50/75%\"\n        @tier \"presentation\"\n      showValues : boolean = false\n        @label \"Show Values\"\n        @description \"Show value labels near data points\"\n        @tier \"presentation\"\n      showArea : boolean = true\n        @label \"Show Area\"\n        @description \"Fill area under line with gradient\"\n        @tier \"presentation\"\n      lineColor : string = \"var(--color-primary)\"\n        @label \"Line Color\"\n        @description \"Line stroke color\"\n        @tier \"presentation\"\n      areaColor : string = \"var(--color-primary)\"\n        @label \"Area Color\"\n        @description \"Area fill color (used for gradient)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/line-chart\" as LineChartPage -> LineChartRender\n}\n"
}