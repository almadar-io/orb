  "source": "",
  "lolo": "app ui-game-icon \"1.0.0\"\n\"GameIcon — UI factory (1:1 with the @almadar/ui game-icon pattern).\"\norbital GameIconOrbital {\n  type GameIconAssetUrl = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n\n  entity GameIconItem [runtime] {\n    id : string!\n  }\n\n  trait GameIconRender -> @rebindable GameIconItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          assetUrl: @config.assetUrl\n          icon: @config.icon\n          size: @config.size\n          alt: @config.alt\n          className: @config.className\n          type: game-icon\n        })\n    }\n\n    config {\n      assetUrl : GameIconAssetUrl\n        @label \"Asset Url\"\n        @description \"Asset — when url is present, renders an img (Asset-primary).\"\n        @tier \"presentation\"\n      icon : icon = \"circle\"\n        @label \"Icon\"\n        @description \"Lucide component or kebab-case icon name (fallback when no assetUrl).\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Pixel size or named variant.\"\n        @tier \"presentation\"\n      alt : string\n        @label \"Alt\"\n        @description \"Alt text for the img (defaults to assetUrl.category).\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/game-icon\" as GameIconPage -> GameIconRender\n}\n"
}