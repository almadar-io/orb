{
  "name": "std-bio-foodweb",
  "description": "Food-web / ecosystem engine — five trophic species whose radii breathe at staggered phases (trophic lag) on biology-canvas.",
  "level": "atom",
  "topic": "ui/learning",
  "schema": {
    "name": "std-bio-foodweb",
    "version": "1.0.0",
    "description": "Food-web / ecosystem engine — five trophic species whose radii breathe at staggered phases (trophic lag) on biology-canvas.",
    "orbitals": [
      {
        "name": "BioFoodwebEngineOrbital",
        "entity": {
          "name": "BioFoodwebState",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "phase",
              "type": "number",
              "default": 0
            },
            {
              "name": "nodes",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "name": "kind",
                    "type": "string",
                    "required": false,
                    "values": [
                      "cell",
                      "organelle",
                      "molecule",
                      "organism"
                    ]
                  },
                  "id": {
                    "name": "id",
                    "type": "string",
                    "required": false
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "radius": {
                    "name": "radius",
                    "type": "number",
                    "required": false
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
                  "y": {
                    "name": "y",
                    "type": "number",
                    "required": true
                  },
                  "x": {
                    "name": "x",
                    "type": "number",
                    "required": true
                  }
                }
              }
            },
            {
              "name": "running",
              "type": "boolean",
              "default": false
            }
          ]
        },
        "traits": [
          {
            "name": "BioFoodwebSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "nodes",
                "phase",
                "running"
              ]
            },
            "category": "interaction",
            "linkedEntity": "BioFoodwebState",
            "emits": [
              {
                "event": "POPULATION_UPDATED",
                "description": "The current food-web scene each tick — a composed listener (readout, graph) can subscribe; a harmless no-op when the atom runs standalone.",
                "synonyms": "tick, frame, step, redraw",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "nodes",
                    "type": "[BioNode]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "POPULATION_UPDATED",
                  "name": "Population Updated",
                  "description": "The current food-web scene each tick — a composed listener (readout, graph) can subscribe; a harmless no-op when the atom runs standalone.",
                  "synonyms": "tick, frame, step, redraw",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "nodes",
                      "type": "[BioNode]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.phase",
                      0
                    ],
                    [
                      "set",
                      "@entity.nodes",
                      [
                        {
                          "id": "grass",
                          "label": "Grass",
                          "y": 340,
                          "radius": 20,
                          "kind": "organism",
                          "x": 300,
                          "color": "#16a34a"
                        },
                        {
                          "id": "rabbit",
                          "label": "Rabbit",
                          "kind": "organism",
                          "x": 180,
                          "y": 220,
                          "radius": 18,
                          "color": "#a16207"
                        },
                        {
                          "color": "#0891b2",
                          "id": "insect",
                          "kind": "organism",
                          "x": 420,
                          "label": "Insect",
                          "radius": 14,
                          "y": 220
                        },
                        {
                          "y": 90,
                          "id": "fox",
                          "color": "#dc2626",
                          "label": "Fox",
                          "x": 220,
                          "kind": "organism",
                          "radius": 20
                        },
                        {
                          "kind": "organism",
                          "radius": 22,
                          "y": 60,
                          "label": "Hawk",
                          "color": "#7c3aed",
                          "x": 400,
                          "id": "hawk"
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "edges": [
                          {
                            "label": "eats",
                            "color": "#94a3b8",
                            "to": "grass",
                            "from": "rabbit"
                          },
                          {
                            "to": "grass",
                            "from": "insect",
                            "color": "#94a3b8",
                            "label": "eats"
                          },
                          {
                            "to": "rabbit",
                            "label": "eats",
                            "from": "fox",
                            "color": "#94a3b8"
                          },
                          {
                            "from": "fox",
                            "label": "eats",
                            "to": "insect",
                            "color": "#94a3b8"
                          },
                          {
                            "from": "hawk",
                            "label": "eats",
                            "to": "fox",
                            "color": "#94a3b8"
                          }
                        ],
                        "width": 600,
                        "backgroundColor": "#f0fdf4",
                        "nodes": "@entity.nodes",
                        "type": "biology-canvas",
                        "height": 400
                      }
                    ],
                    [
                      "emit",
                      "POPULATION_UPDATED",
                      {
                        "nodes": "@entity.nodes"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "foodwebTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "set",
                    "@entity.phase",
                    [
                      "+",
                      "@entity.phase",
                      3
                    ]
                  ],
                  [
                    "set",
                    "@entity.nodes",
                    [
                      "array/map",
                      "@entity.nodes",
                      [
                        "fn",
                        "n",
                        [
                          "let",
                          [
                            [
                              "off",
                              [
                                "if",
                                [
                                  "=",
                                  [
                                    "object/get",
                                    "@n",
                                    "id"
                                  ],
                                  "grass"
                                ],
                                0,
                                [
                                  "if",
                                  [
                                    "=",
                                    [
                                      "object/get",
                                      "@n",
                                      "id"
                                    ],
                                    "rabbit"
                                  ],
                                  48,
                                  [
                                    "if",
                                    [
                                      "=",
                                      [
                                        "object/get",
                                        "@n",
                                        "id"
                                      ],
                                      "insect"
                                    ],
                                    96,
                                    [
                                      "if",
                                      [
                                        "=",
                                        [
                                          "object/get",
                                          "@n",
                                          "id"
                                        ],
                                        "fox"
                                      ],
                                      144,
                                      192
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "tw",
                                [
                                  "math/abs",
                                  [
                                    "-",
                                    [
                                      "math/mod",
                                      [
                                        "+",
                                        "@entity.phase",
                                        "@off"
                                      ],
                                      240
                                    ],
                                    120
                                  ]
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "nr",
                                  [
                                    "+",
                                    12,
                                    [
                                      "*",
                                      "@tw",
                                      0.2
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "object/merge",
                                "@n",
                                {
                                  "radius": "@nr"
                                }
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "nodes": "@entity.nodes",
                      "backgroundColor": "#f0fdf4",
                      "height": 400,
                      "type": "biology-canvas",
                      "width": 600,
                      "edges": [
                        {
                          "label": "eats",
                          "color": "#94a3b8",
                          "to": "grass",
                          "from": "rabbit"
                        },
                        {
                          "to": "grass",
                          "from": "insect",
                          "color": "#94a3b8",
                          "label": "eats"
                        },
                        {
                          "to": "rabbit",
                          "label": "eats",
                          "from": "fox",
                          "color": "#94a3b8"
                        },
                        {
                          "from": "fox",
                          "label": "eats",
                          "to": "insect",
                          "color": "#94a3b8"
                        },
                        {
                          "from": "hawk",
                          "label": "eats",
                          "to": "fox",
                          "color": "#94a3b8"
                        }
                      ]
                    }
                  ],
                  [
                    "emit",
                    "POPULATION_UPDATED",
                    {
                      "nodes": "@entity.nodes"
                    }
                  ]
                ]
              }
            ],
            "config": {
