  "source": "",
  "lolo": "app ui-step-flow \"1.0.0\"\n\"StepFlow — UI factory (1:1 with the @almadar/ui step-flow pattern).\"\norbital StepFlowOrbital {\n  type StepFlowStepsItem = {\n    number : number\n    title : string!\n    description : string!\n    icon : icon\n  }\n\n  entity StepFlowItem [runtime] {\n    id : string!\n  }\n\n  trait StepFlowRender -> @rebindable StepFlowItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          steps: @config.steps\n          orientation: @config.orientation\n          showConnectors: @config.showConnectors\n          className: @config.className\n          type: step-flow\n        })\n    }\n\n    config {\n      steps : [StepFlowStepsItem] = [{ number: 1, title: \"Title\", description: \"Description\", icon: \"circle\" }, { number: 2, title: \"Title 2\", description: \"Description 2\", icon: \"circle\" }]\n        @label \"Steps\"\n        @description \"steps prop\"\n        @tier \"presentation\"\n      orientation : \"horizontal\" | \"vertical\" = horizontal\n        @label \"Orientation\"\n        @description \"orientation prop\"\n        @tier \"presentation\"\n      showConnectors : boolean = true\n        @label \"Show Connectors\"\n        @description \"showConnectors prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/step-flow\" as StepFlowPage -> StepFlowRender\n}\n"
}