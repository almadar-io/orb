  "source": "",
  "lolo": "app ui-bloom-quiz-block \"1.0.0\"\n\"BloomQuizBlock — UI factory (1:1 with the @almadar/ui bloom-quiz-block pattern).\"\norbital BloomQuizBlockOrbital {\n  entity BloomQuizBlockItem [runtime] {\n    id : string!\n  }\n\n  trait BloomQuizBlockRender -> @rebindable BloomQuizBlockItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          level: @config.level\n          question: @config.question\n          answer: @config.answer\n          index: @config.index\n          isAnswered: @config.isAnswered\n          answerEvent: @config.answerEvent\n          className: @config.className\n          type: bloom-quiz-block\n        })\n    }\n\n    config {\n      level : \"remember\" | \"understand\" | \"apply\" | \"analyze\" | \"evaluate\" | \"create\" = remember\n        @label \"Level\"\n        @description \"level prop\"\n        @tier \"presentation\"\n      question : string = \"\"\n        @label \"Question\"\n        @description \"question prop\"\n        @tier \"presentation\"\n      answer : string = \"\"\n        @label \"Answer\"\n        @description \"answer prop\"\n        @tier \"presentation\"\n      index : number\n        @label \"Index\"\n        @description \"Zero-based index (used in the emitted event payload)\"\n        @tier \"presentation\"\n      isAnswered : boolean\n        @label \"Is Answered\"\n        @description \"Whether the learner has already answered\"\n        @tier \"presentation\"\n      answerEvent : string = \"ANSWER_BLOOM\"\n        @label \"Answer Event\"\n        @description \"Event name emitted on first reveal (as `UI:<answerEvent>`). Defaults to 'ANSWER_BLOOM'.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/bloom-quiz-block\" as BloomQuizBlockPage -> BloomQuizBlockRender\n}\n"
}