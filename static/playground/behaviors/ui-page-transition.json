  "source": "",
  "lolo": "app ui-page-transition \"1.0.0\"\n\"PageTransition — UI factory (1:1 with the @almadar/ui page-transition pattern).\"\norbital PageTransitionOrbital {\n  entity PageTransitionItem [runtime] {\n    id : string!\n  }\n\n  trait PageTransitionRender -> @rebindable PageTransitionItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          locationKey: @config.locationKey\n          children: @config.children\n          className: @config.className\n          type: page-transition\n        })\n    }\n\n    config {\n      locationKey : string = \"\"\n        @label \"Location Key\"\n        @description \"Value that changes on navigation (e.g. `location.pathname`).\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"children prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/page-transition\" as PageTransitionPage -> PageTransitionRender\n}\n"
