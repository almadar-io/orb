  "source": "",
  "lolo": "app ui-stat-card \"1.0.0\"\n\"StatCard — UI factory (1:1 with the @almadar/ui stat-card pattern).\"\norbital StatCardOrbital {\n    type StatCardLoaded = Event { data : [StatCardItem] } \"StatCard rows finished loading; payload.data holds the collection\"\n  type StatCardError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type StatCardAction = {\n    label : string!\n    event : string\n    navigatesTo : string\n  }\n  type StatCardMetricsItem = {\n    field : string\n    label : string!\n    value : string\n    icon : icon\n    format : string\n  }\n\n  entity StatCardItem [runtime] {\n    id : string!\n  }\n\n  trait StatCardRender -> @rebindable StatCardItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle when @config.selfFetch\n        (fetch StatCardItem { emit: { success: StatCardLoaded } })\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          label: @config.label\n          title: @config.title\n          value: @config.value\n          previousValue: @config.previousValue\n          currentValue: @config.currentValue\n          trend: @config.trend\n          trendDirection: @config.trendDirection\n          invertTrend: @config.invertTrend\n          icon: @config.icon\n          iconBg: @config.iconBg\n          iconColor: @config.iconColor\n          subtitle: @config.subtitle\n          action: @config.action\n          metrics: @config.metrics\n          compact: @config.compact\n          sparklineData: @config.sparklineData\n          type: stat-card\n        })\n      INIT -> idle when (not @config.selfFetch)\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          label: @config.label\n          title: @config.title\n          value: @config.value\n          previousValue: @config.previousValue\n          currentValue: @config.currentValue\n          trend: @config.trend\n          trendDirection: @config.trendDirection\n          invertTrend: @config.invertTrend\n          icon: @config.icon\n          iconBg: @config.iconBg\n          iconColor: @config.iconColor\n          subtitle: @config.subtitle\n          action: @config.action\n          metrics: @config.metrics\n          compact: @config.compact\n          sparklineData: @config.sparklineData\n          type: stat-card\n        })\n      StatCardLoaded -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @payload.data\n          label: @config.label\n          title: @config.title\n          value: @config.value\n          previousValue: @config.previousValue\n          currentValue: @config.currentValue\n          trend: @config.trend\n          trendDirection: @config.trendDirection\n          invertTrend: @config.invertTrend\n          icon: @config.icon\n          iconBg: @config.iconBg\n          iconColor: @config.iconColor\n          subtitle: @config.subtitle\n          action: @config.action\n          metrics: @config.metrics\n          compact: @config.compact\n          sparklineData: @config.sparklineData\n          type: stat-card\n        })\n    }\n\n    emits {\n      StatCardLoaded\n        @description \"StatCard rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : StatCardError\n        @label \"Error\"\n        @description \"Error state (UiError)\"\n        @tier \"presentation\"\n      sortBy : string\n        @label \"Sort By\"\n        @description \"Current sort field\"\n        @tier \"presentation\"\n      sortDirection : \"asc\" | \"desc\" = asc\n        @label \"Sort Direction\"\n        @description \"Current sort direction\"\n        @tier \"presentation\"\n      searchValue : string\n        @label \"Search Value\"\n        @description \"Current search query value\"\n        @tier \"presentation\"\n      pageProp : number\n        @label \"Page\"\n        @description \"Current page number\"\n        @synonyms \"page\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Number of items per page\"\n        @tier \"presentation\"\n      totalCount : number\n        @label \"Total Count\"\n        @description \"Total number of items\"\n        @tier \"presentation\"\n      activeFilters : Map string string = {}\n        @label \"Active Filters\"\n        @description \"Active filters\"\n        @tier \"presentation\"\n      selectedIds : [string] = []\n        @label \"Selected Ids\"\n        @description \"Currently selected item IDs\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Main label\"\n        @tier \"presentation\"\n      title : string\n        @label \"Title\"\n        @description \"Title (alias for label)\"\n        @tier \"presentation\"\n      value : [string] = []\n        @label \"Value\"\n        @description \"Primary value - accepts array from generated code (will use first element or length)\"\n        @tier \"presentation\"\n      previousValue : number\n        @label \"Previous Value\"\n        @description \"Previous value for comparison\"\n        @tier \"presentation\"\n      currentValue : number\n        @label \"Current Value\"\n        @description \"Current value as number for trend calculation\"\n        @tier \"presentation\"\n      trend : number\n        @label \"Trend\"\n        @description \"Manual trend percentage (overrides calculation)\"\n        @tier \"presentation\"\n      trendDirection : \"up\" | \"down\" | \"neutral\" = up\n        @label \"Trend Direction\"\n        @description \"Trend direction (overrides calculation)\"\n        @tier \"presentation\"\n      invertTrend : boolean = false\n        @label \"Invert Trend\"\n        @description \"Whether up is good (green) or bad (red)\"\n        @tier \"presentation\"\n      icon : icon\n        @label \"Icon\"\n        @description \"Icon to display (Lucide component or icon name string)\"\n        @tier \"presentation\"\n      iconBg : string = \"bg-muted\"\n        @label \"Icon Bg\"\n        @description \"Icon background color\"\n        @tier \"presentation\"\n      iconColor : string = \"text-foreground\"\n        @label \"Icon Color\"\n        @description \"Icon color\"\n        @tier \"presentation\"\n      subtitle : string\n        @label \"Subtitle\"\n        @description \"Subtitle or description\"\n        @tier \"presentation\"\n      action : StatCardAction\n        @label \"Action\"\n        @description \"Action button\"\n        @tier \"presentation\"\n      metrics : [StatCardMetricsItem] = []\n        @label \"Metrics\"\n        @description \"Metrics to display (schema format) - accepts readonly for compatibility with generated const arrays\"\n        @tier \"presentation\"\n      compact : boolean\n        @label \"Compact\"\n        @description \"Compact display mode\"\n        @tier \"presentation\"\n      sparklineData : [number] = []\n        @label \"Sparkline Data\"\n        @description \"Sparkline data points for an inline trend chart\"\n        @tier \"presentation\"\n      selfFetch : boolean = true\n        @label \"Fetch its own rows on mount?\"\n        @description \"true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/stat-card\" as StatCardPage -> StatCardRender\n}\n"
}