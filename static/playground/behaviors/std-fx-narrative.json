  "source": "",
  "lolo": "app std-fx-narrative \"1.0.0\"\n\"Headless pedagogy→fx translator for game boards and learning shells: turns high-level narrative events into big transient screen-space or world-space text effects consumed by std-fx-particles / fx-overlay. Levels emit NARRATE { text, style } and get a correctly styled, centered (or positioned) floating text burst without hand-rolling particle structs. Tutorials emit TUTORIAL_SHOW and the atom forwards SHOW to a composed std-tutorial-overlay trait. Renders nothing; centralizes the FX vocabulary so every level's teaching text looks and behaves the same. Corresponds to the design-sheet field(s): feedback.\"\n\norbital FxNarrativeOrbital {\n  type NarrativeCue = {\n    text : string!\n    style : \"hint\" | \"fact\" | \"warn\" | \"celebrate\"\n    x : number\n    y : number\n    ttl : number\n    space : \"screen\" | \"world\"\n  }\n\n  type FxParticle = {\n    id : string!\n    type : string!\n    x : number!\n    z : number\n    y : number\n    message : string\n    ttl : number!\n    maxTtl : number\n    bornAt : number\n    space : string\n    effect : string\n    color : string\n    size : number\n    vx : number\n    vy : number\n    vz : number\n    particleCount : number\n  }\n\n  type StyleDef = {\n    color : string!\n    size : number!\n    ttl : number!\n    effect : string!\n  }\n\n  entity FxNarrativeData [runtime, shared] {\n    id : string!\n    seq : number = 0\n    lastText : string = \"\"\n  }\n\n  trait FxNarrative -> @rebindable FxNarrativeData [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.seq 0)\n        (set @entity.lastText \"\")\n\n      NARRATE -> active when @config.running\n        (let ((styleKey (if (== (object/get @payload style) null) \"fact\" (object/get @payload style)))\n              (styleDef (object/get @config.styles @styleKey))\n              (ttl (if (== (object/get @payload ttl) null) (object/get @styleDef ttl) (object/get @payload ttl)))\n              (x (if (== (object/get @payload x) null) 0.5 (object/get @payload x)))\n              (y (if (== (object/get @payload y) null) 0.25 (object/get @payload y)))\n              (space (if (== (object/get @payload space) null) \"world\" (object/get @payload space)))\n              (text (object/get @payload text)))\n          (do\n            (set @entity.seq (+ @entity.seq 1))\n            (set @entity.lastText @text)\n            (emit BURST { particles: [ {\n              id: (str/concat \"narrative-\" @entity.seq),\n              type: \"narrative\",\n              x: @x,\n              z: @y,\n              y: 0,\n              message: @text,\n              ttl: @ttl,\n              maxTtl: @ttl,\n              bornAt: (time/now),\n              space: @space,\n              effect: (object/get @styleDef effect),\n              color: (object/get @styleDef color),\n              size: (object/get @styleDef size),\n              vx: 0,\n              vy: 0,\n              vz: 0,\n              particleCount: 1\n            } ] })))\n\n      TUTORIAL_SHOW -> active when @config.running\n        (emit SHOW { id: \"tutorial\" })\n    }\n\n    emits {\n      BURST -> external {\n        particles : [FxParticle]\n      }\n        @description \"Styled floating-text particle batch for std-fx-particles / fx-overlay.\"\n        @tier \"domain\"\n      SHOW -> external {\n        id : string\n      }\n        @description \"Forwarded to a composed std-tutorial-overlay to open the tutorial modal.\"\n        @tier \"domain\"\n    }\n\n    listens {\n      NARRATE { text : string!, style : \"hint\" | \"fact\" | \"warn\" | \"celebrate\", x : number, y : number, ttl : number, space : \"screen\" | \"world\" }\n      TUTORIAL_SHOW { text : string, title : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When false all narrative events are ignored.\"\n        @tier \"domain\"\n      styles : Map string StyleDef = {\n        \"fact\": { color: \"#38bdf8\", size: 0.7, ttl: 3, effect: \"float-text\" },\n        \"hint\": { color: \"#a78bfa\", size: 0.6, ttl: 2, effect: \"float-text\" },\n        \"warn\": { color: \"#f87171\", size: 0.6, ttl: 1.5, effect: \"shake\" },\n        \"celebrate\": { color: \"#facc15\", size: 0.9, ttl: 3, effect: \"sparkle\" }\n      }\n        @label \"Styles\"\n        @description \"Map of narrative style to color, size, ttl, and effect. Override per game theme.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/fx-narrative\" as FxNarrativePage -> FxNarrative\n}\n"
}