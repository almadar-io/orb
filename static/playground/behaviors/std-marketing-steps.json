  "source": "",
  "lolo": "app std-marketing-steps \"1.0.0\"\n\"Step flow atom for marketing pages. Renders numbered steps horizontally or vertically. Pick for how-it-works sections and onboarding explainers.\"\n;; Config-driven step flow using the `step-flow-organism` marketing pattern.\n;; Steps are declared as an array of { number, title, description, icon } objects.\n;; The atom renders immediately on INIT with no fetch required.\ntype StepCard = { id : string!, number : number, title : string!, description : string!, icon : string }\norbital StepItemOrbital {\n  uses StepFlowOrganism from \"std/behaviors/ui-step-flow-organism\"\n\n  entity StepSectionItem [runtime] {\n    id : string!\n    steps : [StepCard] @description \"An ordered list of individual step components.\" @synonyms \"items, sequence, stages\" = []\n  }\n\n  trait StepSectionItemSteps = StepFlowOrganism.traits.StepFlowOrganismRender -> StepSectionItem {\n    config {\n      orientation: @config.orientation\n      steps : [StepCard] = [{\n        description: \"Describe your app in natural language.\"\n        icon: pen-tool\n        id: \"1\"\n        number: 1\n        title: Design\n      }, {\n        description: \"Almadar generates the full stack automatically.\"\n        icon: hammer\n        id: \"2\"\n        number: 2\n        title: Build\n      }, {\n        description: \"Deploy to production with one click.\"\n        icon: rocket\n        id: \"3\"\n        number: 3\n        title: Ship\n      }]\n        @label \"Steps\"\n        @description \"Array of step items\"\n        @tier \"presentation\"\n      orientation : string = horizontal\n        @label \"Orientation\"\n        @description \"horizontal or vertical\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/steps\" as StepSectionItemStepsPage -> StepSectionItemSteps\n}"
}