  "source": "",
  "lolo": "app ui-action-tile \"1.0.0\"\n\"ActionTile — UI factory (1:1 with the @almadar/ui action-tile pattern).\"\norbital ActionTileOrbital {\n  type ActionTileError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type ActionTileAction = {\n    id : string!\n    name : string!\n    category : string!\n    description : string\n    iconEmoji : string\n    iconUrl : ActionTileActionIconUrl\n    stateMachine : ActionTileActionStateMachine\n  }\n  type ActionTileActionIconUrl = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\" | \"4:1\" | \"5:3\" | \"1:2\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n  type ActionTileActionStateMachine = {\n    name : string!\n    states : [string]!\n    currentState : string!\n    transitions : [ActionTileActionStateMachineTransitionsItem]!\n    description : string\n  }\n  type ActionTileActionStateMachineTransitionsItem = {\n    from : string!\n    to : string!\n    event : string!\n    guardHint : string\n  }\n  type ActionTileCategoryColorsValue = {\n    bg : string!\n    border : string!\n  }\n\n  entity ActionTileItem [runtime] {\n    id : string!\n  }\n\n  trait ActionTileRender -> @rebindable ActionTileItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          action: @config.action\n          size: @config.size\n          disabled: @config.disabled\n          categoryColors: @config.categoryColors\n          type: action-tile\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : ActionTileError\n        @label \"Error\"\n        @description \"Error state (UiError)\"\n        @tier \"presentation\"\n      sortBy : string\n        @label \"Sort By\"\n        @description \"Current sort field\"\n        @tier \"presentation\"\n      sortDirection : \"asc\" | \"desc\" = asc\n        @label \"Sort Direction\"\n        @description \"Current sort direction\"\n        @tier \"presentation\"\n      searchValue : string\n        @label \"Search Value\"\n        @description \"Current search query value\"\n        @tier \"presentation\"\n      pageProp : number\n        @label \"Page\"\n        @description \"Current page number\"\n        @synonyms \"page\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Number of items per page\"\n        @tier \"presentation\"\n      totalCount : number\n        @label \"Total Count\"\n        @description \"Total number of items\"\n        @tier \"presentation\"\n      activeFilters : Map string string = {}\n        @label \"Active Filters\"\n        @description \"Active filters\"\n        @tier \"presentation\"\n      selectedIds : [string] = []\n        @label \"Selected Ids\"\n        @description \"Currently selected item IDs\"\n        @tier \"presentation\"\n      action : ActionTileAction = { id: \"Id\", name: \"Name\", category: \"Category\", description: \"Description\", iconEmoji: \"Icon Emoji\", iconUrl: { url: \"https://almadar-kflow-assets.web.app/shared/ui-battle-board/default/ui/star.png\", role: \"ui\", category: \"iconUrl\", animations: [\"static\"], style: \"pixel\", dimension: \"2d\", aspect: \"1:1\", name: \"iconUrl\", thumbnailUrl: \"\" }, stateMachine: { name: \"Name\", states: [\"Item\", \"Item 2\"], currentState: \"Current State\", transitions: [{ from: \"From\", to: \"To\", event: \"Event\", guardHint: \"Guard Hint\" }, { from: \"From 2\", to: \"To 2\", event: \"Event 2\", guardHint: \"Guard Hint 2\" }], description: \"Description\" } }\n        @label \"Action\"\n        @description \"The action data\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Size variant\"\n        @tier \"presentation\"\n      disabled : boolean = false\n        @label \"Disabled\"\n        @description \"Whether the tile is disabled / already used\"\n        @tier \"presentation\"\n      categoryColors : Map string ActionTileCategoryColorsValue = {}\n        @label \"Category Colors\"\n        @description \"Category → color mapping\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/action-tile\" as ActionTilePage -> ActionTileRender\n}\n"
}