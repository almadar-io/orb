  "source": "",
  "lolo": "app ui-doc-toc \"1.0.0\"\n\"DocToc — UI factory (1:1 with the @almadar/ui doc-toc pattern).\"\norbital DocTocOrbital {\n  type DocTocItemsItem = {\n    id : string!\n    label : string!\n    level : number!\n  }\n\n  entity DocTocItem [runtime] {\n    id : string!\n  }\n\n  trait DocTocRender -> @rebindable DocTocItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          items: @config.items\n          activeId: @config.activeId\n          className: @config.className\n          type: doc-toc\n        })\n    }\n\n    config {\n      items : [DocTocItemsItem] = [{ id: \"Id\", label: \"Label\", level: 1 }, { id: \"Id 2\", label: \"Label 2\", level: 2 }]\n        @label \"Items\"\n        @description \"Table of contents items\"\n        @tier \"presentation\"\n      activeId : string\n        @label \"Active Id\"\n        @description \"Currently active section id\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/doc-toc\" as DocTocPage -> DocTocRender\n}\n"
}