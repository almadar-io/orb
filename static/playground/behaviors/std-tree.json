  "source": "",
  "lolo": "app std-tree \"1.0.0\"\n\"std-tree — generic hierarchical node browser. Fetches a flat TreeNode collection and renders it through file-tree's flat `items` mode (parentId-nested at render time by the component, not the .lolo); OPEN_NODE is the external handoff for a selected node's id. Rebindable: pass `fields` at the call site to retarget it at any parent-pointer entity (categories, org units, comment threads).\"\norbital TreeNodeOrbital {\n    type TreeNodeLoaded = Event { data : [TreeNode] } \"Fired when the tree node collection finishes loading\"\n\n    type TreeNodeLoadFailed = Event { error : string, code : string } \"Fired when the tree node collection fails to load\"\n\n  entity TreeNode [persistent: treenodes] {\n    id : string!\n    name : string! @description \"The descriptive label for this node.\" @synonyms \"label, title, text\"\n    parentId : string @description \"Reference to the parent node in the hierarchy; empty marks a root.\" @synonyms \"parent, superior, ancestor\" = \"\"\n    icon : string @description \"Icon name shown beside the node.\" @synonyms \"glyph, symbol, pictogram\" = \"\"\n    createdAt : string\n  }\n\n  trait TreeBrowse -> @rebindable TreeNode [interaction, collection] {\n    initial: loading\n\n    state loading {\n      INIT -> loading\n        (fetch TreeNode {\n          emit: { failure: TreeNodeLoadFailed, success: TreeNodeLoaded }\n        })\n        (render-ui main {\n          align: center\n          children: [{ type: spinner }, {\n            color: muted\n            content: \"Loading tree…\"\n            type: typography\n            variant: caption\n          }]\n          className: py-12\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      TreeNodeLoaded -> browsing\n        (render-ui main {\n          children: [{\n            align: center\n            children: [{ name: list-tree, type: icon }, {\n              content: @config.title\n              type: typography\n              variant: h3\n            }, {\n              label: (array/len ?data)\n              size: sm\n              type: badge\n              variant: neutral\n            }]\n            direction: horizontal\n            gap: sm\n            type: stack\n          }, { type: divider }, {\n            items: (array/map ?data (fn row {\n              icon: @row.icon\n              id: @row.id\n              label: @row.name\n              parentId: @row.parentId\n            }))\n            onNodeSelect: OPEN_NODE\n            type: file-tree\n          }]\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      TreeNodeLoadFailed -> error\n        (render-ui main {\n          align: center\n          children: [{\n            color: error\n            name: alert-triangle\n            type: icon\n          }, {\n            content: \"Failed to load tree\"\n            type: typography\n            variant: body\n          }, {\n            color: muted\n            content: ?error\n            type: typography\n            variant: caption\n          }, {\n            action: RETRY\n            icon: rotate-ccw\n            label: Retry\n            type: button\n            variant: ghost\n          }]\n          className: py-8\n          direction: vertical\n          gap: sm\n          type: stack\n        })\n    }\n\n    state browsing {\n      INIT -> loading\n        (fetch TreeNode {\n          emit: { failure: TreeNodeLoadFailed, success: TreeNodeLoaded }\n        })\n        (render-ui main {\n          align: center\n          children: [{ type: spinner }, {\n            color: muted\n            content: \"Loading tree…\"\n            type: typography\n            variant: caption\n          }]\n          className: py-12\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      OPEN_NODE -> browsing\n        (set @entity.id ?id)\n      TreeNodeLoaded -> browsing\n        (render-ui main {\n          children: [{\n            align: center\n            children: [{ name: list-tree, type: icon }, {\n              content: @config.title\n              type: typography\n              variant: h3\n            }, {\n              label: (array/len ?data)\n              size: sm\n              type: badge\n              variant: neutral\n            }]\n            direction: horizontal\n            gap: sm\n            type: stack\n          }, { type: divider }, {\n            items: (array/map ?data (fn row {\n              icon: @row.icon\n              id: @row.id\n              label: @row.name\n              parentId: @row.parentId\n            }))\n            onNodeSelect: OPEN_NODE\n            type: file-tree\n          }]\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      TreeNodeLoadFailed -> error\n        (render-ui main {\n          align: center\n          children: [{\n            color: error\n            name: alert-triangle\n            type: icon\n          }, {\n            content: \"Failed to load tree\"\n            type: typography\n            variant: body\n          }, {\n            color: muted\n            content: ?error\n            type: typography\n            variant: caption\n          }, {\n            action: RETRY\n            icon: rotate-ccw\n            label: Retry\n            type: button\n            variant: ghost\n          }]\n          className: py-8\n          direction: vertical\n          gap: sm\n          type: stack\n        })\n    }\n\n    state error {\n      INIT -> loading\n        (fetch TreeNode {\n          emit: { failure: TreeNodeLoadFailed, success: TreeNodeLoaded }\n        })\n        (render-ui main { type: spinner })\n      ;; the error screen's Retry button: INIT is lifecycle-only and the bus never\n      ;; delivers it, so the affordance must target a first-class user event\n      RETRY -> loading\n        (fetch TreeNode {\n          emit: { failure: TreeNodeLoadFailed, success: TreeNodeLoaded }\n        })\n        (render-ui main { type: spinner })\n    }\n\n    emits {\n      OPEN_NODE {\n        id : string!\n      }\n        @description \"Signals a tree node has been selected for external handoff.\"\n        @synonyms \"select, choose, open, activate\"\n        @tier \"domain\"\n      TreeNodeLoaded {\n        data : [TreeNode]\n      }\n        @description \"Indicates the tree node collection has been successfully retrieved.\"\n        @synonyms \"loaded, fetched, retrieved, ready\"\n        @tier \"domain\"\n      TreeNodeLoadFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates a failure to load the tree node collection.\"\n        @synonyms \"error, failed, problem, unsuccessful\"\n        @tier \"internal\"\n    }\n\n    listens {\n      OPEN_NODE {\n        id : string!\n      }\n        @description \"A tree node was selected for external handoff.\"\n        @synonyms \"select, choose, open, activate\"\n        @tier \"domain\"\n      TreeNodeLoaded {\n        data : [TreeNode]\n      }\n        @description \"Indicates the tree node collection has been successfully retrieved.\"\n        @synonyms \"loaded, fetched, retrieved, ready\"\n        @tier \"domain\"\n      TreeNodeLoadFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates a failure to load the tree node collection.\"\n        @synonyms \"error, failed, problem, unsuccessful\"\n        @tier \"internal\"\n    }\n\n    config {\n      title : string = Tree\n        @label \"Section title\"\n        @description \"Heading shown above the tree\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/tree\" as TreePage -> TreeBrowse\n}\n"
}