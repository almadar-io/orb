  "source": "",
  "lolo": "app ui-service-catalog \"1.0.0\"\n\"ServiceCatalog — UI factory (1:1 with the @almadar/ui service-catalog pattern).\"\norbital ServiceCatalogOrbital {\n  type ServiceCatalogServicesItem = {\n    name : string!\n    layer : string!\n    layerColor : string\n  }\n\n  entity ServiceCatalogItem [runtime] {\n    id : string!\n  }\n\n  trait ServiceCatalogRender -> @rebindable ServiceCatalogItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          services: @config.services\n          className: @config.className\n          type: service-catalog\n        })\n    }\n\n    config {\n      services : [ServiceCatalogServicesItem] = [{ name: \"Name\", layer: \"Layer\", layerColor: \"Layer Color\" }, { name: \"Name 2\", layer: \"Layer 2\", layerColor: \"Layer Color 2\" }]\n        @label \"Services\"\n        @description \"List of services to display\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/service-catalog\" as ServiceCatalogPage -> ServiceCatalogRender\n}\n"
}