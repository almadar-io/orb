  "source": "",
  "lolo": "app ui-radio \"1.0.0\"\n\"Radio — UI factory (1:1 with the @almadar/ui radio pattern).\"\norbital RadioOrbital {\n  entity RadioItem [runtime] {\n    id : string!\n    value : string\n  }\n\n  trait RadioRender -> @rebindable RadioItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.value @config.value)\n        (render-ui main {\n          className: @config.className\n          options: @config.options\n          value: @entity.value\n          action: @config.action\n          label: @config.label\n          helperText: @config.helperText\n          error: @config.error\n          size: @config.size\n          type: radio\n        })\n      ACTION -> idle\n        (set @entity.value ?value)\n        (render-ui main {\n          className: @config.className\n          options: @config.options\n          value: @entity.value\n          action: @config.action\n          label: @config.label\n          helperText: @config.helperText\n          error: @config.error\n          size: @config.size\n          type: radio\n        })\n    }\n\n    emits {\n      @config.action -> external {\n        value : string!\n      }\n        @description \"Declarative event name for trait dispatch\"\n        @tier \"essential\"\n    }\n\n    listens {\n      ACTION {\n        value : string!\n      }\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes applied to the root element.\"\n        @tier \"presentation\"\n      options : [string] = []\n        @label \"Options\"\n        @description \"Radio options (string array or SelectOption array)\"\n        @tier \"presentation\"\n      value : string\n        @label \"Value\"\n        @description \"Current selected value\"\n        @tier \"presentation\"\n      action : event = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event name for trait dispatch\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Label text displayed next to the radio button\"\n        @tier \"presentation\"\n      helperText : string\n        @label \"Helper Text\"\n        @description \"Helper text displayed below the radio button\"\n        @tier \"presentation\"\n      error : string\n        @label \"Error\"\n        @description \"Error message displayed below the radio button\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Size of the radio button\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/radio\" as RadioPage -> RadioRender\n}\n"
}