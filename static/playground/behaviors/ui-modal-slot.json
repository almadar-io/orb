  "source": "",
  "lolo": "app ui-modal-slot \"1.0.0\"\n\"ModalSlot — UI factory (1:1 with the @almadar/ui modal-slot pattern).\"\norbital ModalSlotOrbital {\n  type ModalSlotError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity ModalSlotItem [runtime] {\n    id : string!\n  }\n\n  trait ModalSlotRender -> @rebindable ModalSlotItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (fetch ModalSlotItem {})\n        (render-ui main {\n          children: @config.children\n          title: @config.title\n          size: @config.size\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          entity: ModalSlotItem\n          sourceTrait: @config.sourceTrait\n          type: modal-slot\n        })\n    }\n\n    config {\n      children : node\n        @label \"Children\"\n        @description \"Content to display in the modal\"\n        @tier \"presentation\"\n      title : string\n        @label \"Title\"\n        @description \"Override modal title (extracted from children if not provided)\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" | \"xl\" | \"full\" = md\n        @label \"Size\"\n        @description \"Modal size\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Custom class name\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : ModalSlotError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      sourceTrait : string\n        @label \"Source Trait\"\n        @description \"Source trait name for qualified event emission\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/modal-slot\" as ModalSlotPage -> ModalSlotRender\n}\n"
}