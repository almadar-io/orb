  "source": "",
  "lolo": "app ui-game-menu \"1.0.0\"\n\"GameMenu — UI factory (1:1 with the @almadar/ui game-menu pattern).\"\norbital GameMenuOrbital {\n  type GameMenuOptionsItem = {\n    id : string\n    label : string!\n    event : event\n    navigatesTo : string\n    variant : \"primary\" | \"secondary\" | \"ghost\"\n    disabled : boolean\n    subLabel : string\n  }\n  type GameMenuMenuItemsItem = {\n    id : string\n    label : string!\n    event : event\n    navigatesTo : string\n    variant : \"primary\" | \"secondary\" | \"ghost\"\n    disabled : boolean\n    subLabel : string\n  }\n  type GameMenuLogo = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n  type GameMenuSELECTOption = {\n    id : string\n    label : string!\n    event : string\n    navigatesTo : string\n    variant : \"primary\" | \"secondary\" | \"ghost\"\n    disabled : boolean\n    subLabel : string\n  }\n\n  entity GameMenuItem [runtime] {\n    id : string!\n  }\n\n  trait GameMenuRender -> @rebindable GameMenuItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          title: @config.title\n          subtitle: @config.subtitle\n          options: @config.options\n          menuItems: @config.menuItems\n          onSelect: @config.onSelect\n          background: @config.background\n          logo: @config.logo\n          className: @config.className\n          type: game-menu\n        })\n    }\n\n    emits {\n      @config.onSelect -> external {\n        option : GameMenuSELECTOption\n      }\n        @description \"Called when an option is selected (legacy callback, prefer event bus)\"\n        @tier \"essential\"\n    }\n\n    config {\n      title : string = \"Epic Quest\"\n        @label \"Title\"\n        @description \"Menu title\"\n        @tier \"presentation\"\n      subtitle : string\n        @label \"Subtitle\"\n        @description \"Optional subtitle or version\"\n        @tier \"presentation\"\n      options : [GameMenuOptionsItem] = []\n        @label \"Options\"\n        @description \"Menu options - accepts readonly for compatibility with generated const arrays\"\n        @tier \"presentation\"\n      menuItems : [GameMenuMenuItemsItem] = []\n        @label \"Menu Items\"\n        @description \"Alias for options (schema compatibility)\"\n        @tier \"presentation\"\n      onSelect : event = \"SELECT\"\n        @label \"On Select\"\n        @description \"Called when an option is selected (legacy callback, prefer event bus)\"\n        @tier \"presentation\"\n      background : string\n        @label \"Background\"\n        @description \"Background image or gradient\"\n        @tier \"presentation\"\n      logo : GameMenuLogo\n        @label \"Logo\"\n        @description \"Logo asset\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/game-menu\" as GameMenuPage -> GameMenuRender\n}\n"
}