  "source": "",
  "lolo": "app std-status-lifecycle-control \"1.0.0\"\n\"Status lifecycle control — infra molecule pairing std-status-lifecycle's StatusMachine, which deliberately surfaces no UI of its own. Pure presentational: shows the current status and one button per legal next move (config.transitions filtered on config.currentStatus), emitting ChangeStatusRequested with the picked move's id/from/to on click. Driven entirely by config (currentStatus/recordId/transitions) rather than a bound entity, so a host embeds it inline at the record it's viewing (currentStatus={@entity.status} recordId={@entity.id} transitions matching the paired StatusMachine's own config.transitions) and points that StatusMachine's `listens` at this trait's emit (`<Composer>.ChangeStatusRequested -> ChangeStatusRequested`) instead of at a dead declared-only event.\"\n;; @exposure both\norbital StatusLifecycleControlOrbital {\n  uses Badge from \"std/behaviors/ui-badge\"\n\n    type TransitionSpec = { from : string!, to : string!, event : string, label : string }\n\n    type ChangeStatusRequested = Event { id : string, from : string, to : string } \"The viewer picked a legal next status. Point the paired StatusMachine's listens at this trait (e.g. `<Composer>.ChangeStatusRequested -> ChangeStatusRequested`) — same payload shape the atom's own ChangeStatusRequested listen already expects.\"\n\n  entity StatusControlItem [runtime] {\n    id : string!\n  }\n\n  trait StatusLifecycleControl -> @rebindable StatusControlItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          align: center\n          children: [<Badge.traits.BadgeRender linkedEntity={StatusControlItem} label={@config.currentStatus} variant={neutral} />, {\n            children: (array/map (array/filter @config.transitions (fn t (== (object/get @t from) @config.currentStatus))) (fn t {\n              action: TRANSITION_REQUESTED\n              actionPayload: { to: (object/get @t to) }\n              label: (object/get @t label)\n              type: button\n              variant: secondary\n            }))\n            direction: horizontal\n            gap: sm\n            type: stack\n          }]\n          direction: horizontal\n          gap: md\n          type: stack\n        })\n      TRANSITION_REQUESTED -> idle\n        (emit ChangeStatusRequested { id: @config.recordId, from: @config.currentStatus, to: ?to })\n    }\n\n    emits {\n      ChangeStatusRequested -> external {\n        id : string\n        from : string\n        to : string\n      }\n        @description \"Fired when the viewer picks a legal next status from the control.\"\n        @synonyms \"status change, workflow transition, stage change\"\n        @tier \"primary\"\n      TRANSITION_REQUESTED {\n        to : string\n      }\n        @description \"A legal-transition button was clicked.\"\n        @synonyms \"transition clicked, move selected\"\n        @tier \"internal\"\n    }\n\n    listens {\n      TRANSITION_REQUESTED {\n        to : string\n      }\n        @description \"A legal-transition button was clicked.\"\n        @synonyms \"transition clicked, move selected\"\n        @tier \"internal\"\n    }\n\n    config {\n      recordId : string = \"\"\n        @label \"Record id\"\n        @description \"id of the record whose status this control changes. Forward the host entity's id at the embed site (e.g. recordId={@entity.id}).\"\n        @tier \"internal\"\n      currentStatus : string = \"\"\n        @label \"Current status\"\n        @description \"The record's current status, shown as a badge and used to compute which transitions are legal. Forward the host entity's status field at the embed site (e.g. currentStatus={@entity.status}).\"\n        @tier \"internal\"\n      transitions : [TransitionSpec] = []\n        @label \"Which status moves are allowed?\"\n        @description \"Legal transitions as { from, to, event, label } — pass the SAME table given to the paired StatusMachine trait's config.transitions so the rendered buttons never offer a move the atom would reject.\"\n        @synonyms \"edges, allowed moves, status flow, workflow transitions\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/status-lifecycle-control\" as StatusLifecycleControlPage -> StatusLifecycleControl\n}\n"
