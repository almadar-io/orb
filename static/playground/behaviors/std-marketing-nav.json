  "source": "",
  "lolo": "app std-marketing-nav \"1.0.0\"\n\"Marketing navigation atom for marketing pages. Renders a sticky header with brand logo and nav links. Pick for site-wide navigation on static pages.\"\n;; Config-driven navigation using the `header` marketing pattern.\n;; Items are declared as an array of { label, href } objects.\n;; The atom emits NAV_CLICK when a link is clicked.\norbital NavItemOrbital {\n    type NavLink = { label : string!, href : string! }\n\n  entity NavItem [runtime] {\n    id : string!\n  }\n\n  trait NavItemNav -> NavItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          actions: {\n            label: @config.primaryActionLabel\n            type: button\n            variant: primary\n          }\n          brandName: @config.brandName\n          logoSrc: @config.logoSrc\n          navigationItems: @config.items\n          type: header\n        })\n      NAV_CLICK -> idle\n        (emit NAV_CLICK { href: ?href, label: ?label })\n    }\n\n    emits {\n      NAV_CLICK -> external {\n        href : string\n        label : string\n      }\n        @description \"Indicates a navigation link was selected.\"\n        @synonyms \"select, choose, activate\"\n        @tier \"domain\"\n    }\n\n    listens {\n      NAV_CLICK {\n        href : string\n        label : string\n      }\n        @description \"A navigation link was selected.\"\n        @synonyms \"select, choose, activate\"\n        @tier \"domain\"\n    }\n\n    config {\n      brandName : string = Almadar\n        @label \"Brand Name\"\n        @tier \"presentation\"\n      logoSrc : string = \"\"\n        @label \"Logo Source\"\n        @tier \"presentation\"\n      items : [NavLink] = [{\n        href: \"#product\"\n        label: Product\n      }, {\n        href: \"#pricing\"\n        label: Pricing\n      }, {\n        href: \"#about\"\n        label: About\n      }, {\n        href: \"#docs\"\n        label: Docs\n      }]\n        @label \"Navigation Items\"\n        @description \"Array of nav links\"\n        @tier \"presentation\"\n      primaryActionLabel : string = \"Get Started\"\n        @label \"Primary Action Label\"\n        @tier \"presentation\"\n      primaryActionHref : string = \"#\"\n        @label \"Primary Action Link\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/nav\" as NavItemNavPage -> NavItemNav\n}"
}