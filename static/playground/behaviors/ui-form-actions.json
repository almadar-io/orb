  "source": "",
  "lolo": "app ui-form-actions \"1.0.0\"\n\"FormActions — UI factory (1:1 with the @almadar/ui form-actions pattern).\"\norbital FormActionsOrbital {\n  type FormActionsPrimary = {\n    label : string!\n    actionType : string\n    event : string\n    navigatesTo : string\n    variant : string\n  }\n  type FormActionsSecondaryItem = {\n    label : string!\n    actionType : string\n    event : string\n    navigatesTo : string\n    variant : string\n  }\n  type FormActionsFiltersItem = {\n    field : string!\n    label : string!\n    filterType : \"text\" | \"select\" | \"toggle\" | \"checkbox\" | \"date\" | \"daterange\" | \"date-range\" | \"numberrange\" | \"number-range\"\n    type : \"text\" | \"select\" | \"toggle\" | \"checkbox\" | \"date\" | \"daterange\" | \"date-range\" | \"numberrange\" | \"number-range\"\n    options : [string]\n    min : number\n    max : number\n    step : number\n  }\n\n  entity FormActionsItem [runtime] {\n    id : string!\n  }\n\n  trait FormActionsRender -> @rebindable FormActionsItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (fetch FormActionsItem {})\n        (render-ui main {\n          children: @config.children\n          primary: @config.primary\n          secondary: @config.secondary\n          variant: @config.variant\n          orientation: @config.orientation\n          className: @config.className\n          entity: FormActionsItem\n          filters: @config.filters\n          look: @config.look\n          type: form-actions\n        })\n    }\n\n    config {\n      children : node\n        @label \"Children\"\n        @description \"Button group content (Button components) - use this OR primary/secondary\"\n        @tier \"presentation\"\n      primary : FormActionsPrimary\n        @label \"Primary\"\n        @description \"Primary action button config (for form-actions pattern) Accepts Readonly for compatibility with generated const objects\"\n        @tier \"presentation\"\n      secondary : [FormActionsSecondaryItem] = []\n        @label \"Secondary\"\n        @description \"Secondary action buttons config (for form-actions pattern) Accepts readonly array for compatibility with generated const arrays\"\n        @tier \"presentation\"\n      variant : \"default\" | \"segmented\" | \"toggle\" = default\n        @label \"Variant\"\n        @description \"Visual variant\"\n        @tier \"presentation\"\n      orientation : \"horizontal\" | \"vertical\" = horizontal\n        @label \"Orientation\"\n        @description \"Orientation\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      filters : [FormActionsFiltersItem] = []\n        @label \"Filters\"\n        @description \"Filter definitions for filter-group pattern\"\n        @tier \"presentation\"\n      look : \"right-aligned-buttons\" | \"floating-bar\" | \"inline-row\" | \"dropdown-menu\" | \"command-palette-trigger\" = \"right-aligned-buttons\"\n        @label \"Look\"\n        @description \"Layer 2 visual treatment for the action-cluster (form-actions) pattern.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/form-actions\" as FormActionsPage -> FormActionsRender\n}\n"
