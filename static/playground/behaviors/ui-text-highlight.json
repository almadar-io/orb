  "source": "",
  "lolo": "app ui-text-highlight \"1.0.0\"\n\"TextHighlight — UI factory (1:1 with the @almadar/ui text-highlight pattern).\"\norbital TextHighlightOrbital {\n  entity TextHighlightItem [runtime] {\n    id : string!\n  }\n\n  trait TextHighlightRender -> @rebindable TextHighlightItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          highlightType: @config.highlightType\n          isActive: @config.isActive\n          onClick: @config.onClick\n          onMouseEnter: @config.onMouseEnter\n          onMouseLeave: @config.onMouseLeave\n          annotationId: @config.annotationId\n          className: @config.className\n          children: @config.children\n          action: @config.action\n          hoverEvent: @config.hoverEvent\n          type: text-highlight\n        })\n    }\n\n    emits {\n      @config.onClick -> external {\n        id : string\n      }\n        @description \"Callback when highlight is clicked\"\n        @tier \"essential\"\n      @config.onMouseEnter -> external {\n        id : string\n      }\n        @description \"Callback when highlight is hovered\"\n        @tier \"essential\"\n      @config.onMouseLeave -> external {\n        id : string\n      }\n        @description \"Callback when hover ends\"\n        @tier \"essential\"\n      @config.action -> external {\n        id : string\n      }\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"essential\"\n      @config.hoverEvent -> external {\n        id : string\n      }\n        @description \"Declarative hover event — emits UI:{hoverEvent} with { hovered: true/false }\"\n        @tier \"essential\"\n    }\n\n    config {\n      highlightType : \"question\" | \"note\" = question\n        @label \"Highlight Type\"\n        @description \"Type of highlight (determines color)\"\n        @tier \"presentation\"\n      isActive : boolean = false\n        @label \"Is Active\"\n        @description \"Whether the highlight is currently active/focused\"\n        @tier \"presentation\"\n      onClick : event = \"CLICK\"\n        @label \"On Click\"\n        @description \"Callback when highlight is clicked\"\n        @tier \"presentation\"\n      onMouseEnter : event = \"MOUSE_ENTER\"\n        @label \"On Mouse Enter\"\n        @description \"Callback when highlight is hovered\"\n        @tier \"presentation\"\n      onMouseLeave : event = \"MOUSE_LEAVE\"\n        @label \"On Mouse Leave\"\n        @description \"Callback when hover ends\"\n        @tier \"presentation\"\n      annotationId : string\n        @label \"Annotation Id\"\n        @description \"Unique ID for the annotation\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Highlighted text content\"\n        @tier \"presentation\"\n      action : event = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"presentation\"\n      hoverEvent : event = \"HOVER\"\n        @label \"Hover Event\"\n        @description \"Declarative hover event — emits UI:{hoverEvent} with { hovered: true/false }\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/text-highlight\" as TextHighlightPage -> TextHighlightRender\n}\n"
}