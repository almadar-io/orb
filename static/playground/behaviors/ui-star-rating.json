  "source": "",
  "lolo": "app ui-star-rating \"1.0.0\"\n\"StarRating — UI factory (1:1 with the @almadar/ui star-rating pattern).\"\norbital StarRatingOrbital {\n  entity StarRatingItem [runtime] {\n    id : string!\n    value : number = 0\n  }\n\n  trait StarRatingRender -> @rebindable StarRatingItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.value @config.value)\n        (render-ui main {\n          value: @entity.value\n          max: @config.max\n          readOnly: @config.readOnly\n          precision: @config.precision\n          size: @config.size\n          action: @config.action\n          actionPayload: @config.actionPayload\n          onChange: @config.onChange\n          className: @config.className\n          label: @config.label\n          type: star-rating\n        })\n      ACTION -> idle\n        (set @entity.value ?value)\n        (render-ui main {\n          value: @entity.value\n          max: @config.max\n          readOnly: @config.readOnly\n          precision: @config.precision\n          size: @config.size\n          action: @config.action\n          actionPayload: @config.actionPayload\n          onChange: @config.onChange\n          className: @config.className\n          label: @config.label\n          type: star-rating\n        })\n      CHANGE -> idle\n        (set @entity.value ?value)\n        (render-ui main {\n          value: @entity.value\n          max: @config.max\n          readOnly: @config.readOnly\n          precision: @config.precision\n          size: @config.size\n          action: @config.action\n          actionPayload: @config.actionPayload\n          onChange: @config.onChange\n          className: @config.className\n          label: @config.label\n          type: star-rating\n        })\n    }\n\n    emits {\n      @config.action -> external {\n        value : number!\n      }\n        @description \"Declarative event name for rating changes\"\n        @tier \"essential\"\n      @config.onChange -> external {\n        value : number\n      }\n        @description \"Direct onChange callback\"\n        @tier \"essential\"\n    }\n\n    listens {\n      ACTION {\n        value : number!\n      }\n      CHANGE {\n        value : number\n      }\n    }\n\n    config {\n      value : number = 0\n        @label \"Value\"\n        @description \"Current rating value\"\n        @tier \"presentation\"\n      max : number = 5\n        @label \"Max\"\n        @description \"Maximum number of stars\"\n        @tier \"presentation\"\n      readOnly : boolean = false\n        @label \"Read Only\"\n        @description \"Read-only display mode\"\n        @tier \"presentation\"\n      precision : \"full\" | \"half\" = full\n        @label \"Precision\"\n        @description \"Full or half-star precision\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Star size\"\n        @tier \"presentation\"\n      action : event = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event name for rating changes\"\n        @tier \"presentation\"\n      actionPayload : @payload @config.action\n        @label \"Action Payload\"\n        @description \"Payload to include with the action event\"\n        @tier \"presentation\"\n      onChange : event = \"CHANGE\"\n        @label \"On Change\"\n        @description \"Direct onChange callback\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Accessible label\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/star-rating\" as StarRatingPage -> StarRatingRender\n}\n"
}