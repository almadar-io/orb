  "source": "",
  "lolo": "app ui-tag-cloud \"1.0.0\"\n\"TagCloud — UI factory (1:1 with the @almadar/ui tag-cloud pattern).\"\norbital TagCloudOrbital {\n  type TagCloudTagsItem = {\n    label : string!\n    href : string\n    variant : string\n  }\n\n  entity TagCloudItem [runtime] {\n    id : string!\n  }\n\n  trait TagCloudRender -> @rebindable TagCloudItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          tags: @config.tags\n          variant: @config.variant\n          className: @config.className\n          type: tag-cloud\n        })\n    }\n\n    config {\n      tags : [TagCloudTagsItem] = [{ label: \"Label\", href: \"Href\", variant: \"Variant\" }, { label: \"Label 2\", href: \"Href 2\", variant: \"Variant 2\" }]\n        @label \"Tags\"\n        @description \"tags prop\"\n        @tier \"presentation\"\n      variant : \"default\" | \"primary\" | \"accent\" = default\n        @label \"Variant\"\n        @description \"variant prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/tag-cloud\" as TagCloudPage -> TagCloudRender\n}\n"
}