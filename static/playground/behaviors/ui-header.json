  "source": "",
  "lolo": "app ui-header \"1.0.0\"\n\"Header — UI factory (1:1 with the @almadar/ui header pattern).\"\norbital HeaderOrbital {\n  type HeaderNavigationItemsItem = {\n    label : string!\n    href : string\n    icon : icon\n    badge : string\n    active : boolean\n  }\n  type HeaderUserAvatar = {\n    src : asset\n    alt : string\n    initials : string\n  }\n  type HeaderError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity HeaderItem [runtime] {\n    id : string!\n  }\n\n  trait HeaderRender -> @rebindable HeaderItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          logo: @config.logo\n          logoSrc: @config.logoSrc\n          brandName: @config.brandName\n          navigationItems: @config.navigationItems\n          showMenuToggle: @config.showMenuToggle\n          isMenuOpen: @config.isMenuOpen\n          onMenuToggle: @config.onMenuToggle\n          showSearch: @config.showSearch\n          searchPlaceholder: @config.searchPlaceholder\n          onSearch: @config.onSearch\n          userAvatar: @config.userAvatar\n          userName: @config.userName\n          onUserClick: @config.onUserClick\n          actions: @config.actions\n          sticky: @config.sticky\n          variant: @config.variant\n          look: @config.look\n          onLogoClick: @config.onLogoClick\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          type: header\n        })\n    }\n\n    emits {\n      @config.onMenuToggle -> external { }\n        @description \"Menu toggle callback\"\n        @tier \"essential\"\n      @config.onSearch -> external {\n        value : string\n      }\n        @description \"Search callback\"\n        @tier \"essential\"\n      @config.onUserClick -> external { }\n        @description \"Callback when user avatar is clicked\"\n        @tier \"essential\"\n      @config.onLogoClick -> external { }\n        @description \"Callback when logo/brand is clicked\"\n        @tier \"essential\"\n    }\n\n    config {\n      logo : node\n        @label \"Logo\"\n        @description \"Logo/Brand content\"\n        @tier \"presentation\"\n      logoSrc : asset = \"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png\"\n        @label \"Logo Src\"\n        @description \"Logo image source\"\n        @tier \"presentation\"\n      brandName : string = KFlow\n        @label \"Brand Name\"\n        @description \"Brand/App name\"\n        @tier \"presentation\"\n      navigationItems : [HeaderNavigationItemsItem] = []\n        @label \"Navigation Items\"\n        @description \"Navigation items (for desktop header variant)\"\n        @tier \"presentation\"\n      showMenuToggle : boolean = true\n        @label \"Show Menu Toggle\"\n        @description \"Show menu toggle button\"\n        @tier \"presentation\"\n      isMenuOpen : boolean = false\n        @label \"Is Menu Open\"\n        @description \"Is menu open (for toggle icon)\"\n        @tier \"presentation\"\n      onMenuToggle : event = \"MENU_TOGGLE\"\n        @label \"On Menu Toggle\"\n        @description \"Menu toggle callback\"\n        @tier \"presentation\"\n      showSearch : boolean = false\n        @label \"Show Search\"\n        @description \"Show search input\"\n        @tier \"presentation\"\n      searchPlaceholder : string\n        @label \"Search Placeholder\"\n        @description \"Search placeholder\"\n        @tier \"presentation\"\n      onSearch : event = \"SEARCH\"\n        @label \"On Search\"\n        @description \"Search callback\"\n        @tier \"presentation\"\n      userAvatar : HeaderUserAvatar\n        @label \"User Avatar\"\n        @description \"User avatar configuration\"\n        @tier \"presentation\"\n      userName : string\n        @label \"User Name\"\n        @description \"User name (display name or email)\"\n        @tier \"presentation\"\n      onUserClick : event = \"USER_CLICK\"\n        @label \"On User Click\"\n        @description \"Callback when user avatar is clicked\"\n        @tier \"presentation\"\n      actions : node\n        @label \"Actions\"\n        @description \"Action buttons (right side)\"\n        @tier \"presentation\"\n      sticky : boolean = true\n        @label \"Sticky\"\n        @description \"Sticky header\"\n        @tier \"presentation\"\n      variant : \"mobile\" | \"desktop\" = mobile\n        @label \"Variant\"\n        @description \"Variant - mobile shows menu toggle, desktop shows full nav\"\n        @tier \"presentation\"\n      look : \"hero\" | \"compact-bar\" | \"breadcrumb\" | \"contextual\" | \"editorial-banner\" = \"compact-bar\"\n        @label \"Look\"\n        @description \"Layer 2 visual treatment — orthogonal to the structural variant (which currently flips mobile vs desktop).\"\n        @tier \"presentation\"\n      onLogoClick : event = \"LOGO_CLICK\"\n        @label \"On Logo Click\"\n        @description \"Callback when logo/brand is clicked\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator (closed circuit)\"\n        @tier \"presentation\"\n      error : HeaderError\n        @label \"Error\"\n        @description \"Error state (closed circuit)\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/header\" as HeaderPage -> HeaderRender\n}\n"
}