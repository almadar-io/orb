{
  "name": "std-algo-twopointer",
  "description": "Two-pointer engine — one left/right pair-sum step per tick over a sorted bar array on algorithm-canvas; composed via `uses`.",
  "level": "atom",
  "topic": "ui/learning",
  "schema": {
    "name": "std-algo-twopointer",
    "version": "1.0.0",
    "description": "Two-pointer engine — one left/right pair-sum step per tick over a sorted bar array on algorithm-canvas; composed via `uses`.",
    "orbitals": [
      {
        "name": "TwoPointerEngineOrbital",
        "entity": {
          "name": "TwoPointerScene",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "bars",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "name": "value",
                    "type": "number",
                    "required": true
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  }
                }
              }
            },
            {
              "name": "pointers",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "index": {
                    "name": "index",
                    "type": "number",
                    "required": true
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  }
                }
              }
            },
            {
              "name": "left",
              "type": "number",
              "default": 0
            },
            {
              "name": "right",
              "type": "number",
              "default": 0
            },
            {
              "name": "sum",
              "type": "number",
              "default": 0
            },
            {
              "name": "found",
              "type": "boolean",
              "default": false
            },
            {
              "name": "done",
              "type": "boolean",
              "default": false
            },
            {
              "name": "running",
              "type": "boolean",
              "default": true
            }
          ]
        },
        "traits": [
          {
            "name": "TwoPointerSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "bars",
                "done",
                "found",
                "left",
                "pointers",
                "right",
                "running",
                "sum"
              ]
            },
            "category": "interaction",
            "linkedEntity": "TwoPointerScene",
            "emits": [
              {
                "event": "PAIR_UPDATED",
                "description": "The current bars + left/right cursors each step — a composed listener (a mirror canvas, a readout) can subscribe; a harmless no-op standalone.",
                "synonyms": "tick, frame, step, converge, pair, sum",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "bars",
                    "type": "[AlgoBar]"
                  },
                  {
                    "name": "pointers",
                    "type": "[AlgoPointer]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "PAIR_UPDATED",
                  "name": "Pair Updated",
                  "description": "The current bars + left/right cursors each step — a composed listener (a mirror canvas, a readout) can subscribe; a harmless no-op standalone.",
                  "synonyms": "tick, frame, step, converge, pair, sum",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "bars",
                      "type": "[AlgoBar]"
                    },
                    {
                      "name": "pointers",
                      "type": "[AlgoPointer]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.bars",
                      [
                        {
                          "color": "#3b82f6",
                          "value": 1,
                          "label": "1"
                        },
                        {
                          "color": "#3b82f6",
                          "label": "3",
                          "value": 3
                        },
                        {
                          "label": "5",
                          "color": "#3b82f6",
                          "value": 5
                        },
                        {
                          "color": "#3b82f6",
                          "label": "7",
                          "value": 7
                        },
                        {
                          "value": 9,
                          "label": "9",
                          "color": "#3b82f6"
                        },
                        {
                          "color": "#3b82f6",
                          "value": 11,
                          "label": "11"
                        },
                        {
                          "label": "13",
                          "value": 13,
                          "color": "#3b82f6"
                        },
                        {
                          "label": "15",
                          "color": "#3b82f6",
                          "value": 15
                        },
                        {
                          "label": "17",
                          "value": 17,
                          "color": "#3b82f6"
                        },
                        {
                          "value": 19,
                          "label": "19",
                          "color": "#3b82f6"
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.left",
                      0
                    ],
                    [
                      "set",
                      "@entity.right",
                      [
                        "-",
                        [
                          "array/len",
                          [
                            {
                              "color": "#3b82f6",
                              "value": 1,
                              "label": "1"
                            },
                            {
                              "color": "#3b82f6",
                              "label": "3",
                              "value": 3
                            },
                            {
                              "label": "5",
                              "color": "#3b82f6",
                              "value": 5
                            },
                            {
                              "color": "#3b82f6",
                              "label": "7",
                              "value": 7
                            },
                            {
                              "value": 9,
                              "label": "9",
                              "color": "#3b82f6"
                            },
                            {
                              "color": "#3b82f6",
                              "value": 11,
                              "label": "11"
                            },
                            {
                              "label": "13",
                              "value": 13,
                              "color": "#3b82f6"
                            },
                            {
                              "label": "15",
                              "color": "#3b82f6",
                              "value": 15
                            },
                            {
                              "label": "17",
                              "value": 17,
                              "color": "#3b82f6"
                            },
                            {
                              "value": 19,
                              "label": "19",
                              "color": "#3b82f6"
                            }
                          ]
                        ],
                        1
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "set",
                      "@entity.pointers",
                      [
                        {
                          "label": "left",
                          "color": "#2563eb",
                          "index": "@entity.left"
                        },
                        {
                          "index": "@entity.right",
                          "label": "right",
                          "color": "#dc2626"
                        }
                      ]
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "backgroundColor": "#f8fafc",
                        "height": 400,
                        "pointers": "@entity.pointers",
                        "bars": "@entity.bars",
                        "type": "algorithm-canvas",
                        "width": 600
                      }
                    ],
                    [
                      "emit",
                      "PAIR_UPDATED",
                      {
                        "pointers": "@entity.pointers",
                        "bars": "@entity.bars"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "twoPointerTick",
                "interval": 350,
                "guard": [
                  "and",
                  "@entity.running",
                  [
                    "not",
                    "@entity.done"
                  ]
                ],
                "effects": [
                  [
                    "set",
                    "@entity.sum",
                    [
                      "+",
                      [
                        "object/get",
                        [
                          "array/nth",
                          "@entity.bars",
                          "@entity.left"
                        ],
                        "value"
                      ],
                      [
                        "object/get",
                        [
                          "array/nth",
                          "@entity.bars",
                          "@entity.right"
                        ],
                        "value"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.found",
                    [
                      "==",
                      "@entity.sum",
                      24
                    ]
                  ],
                  [
                    "set",
                    "@entity.left",
                    [
                      "if",
                      [
                        "and",
                        [
                          "not",
                          "@entity.found"
                        ],
                        [
                          "<",
                          "@entity.sum",
                          24
                        ]
                      ],
                      [
                        "+",
                        "@entity.left",
                        1
                      ],
                      "@entity.left"
                    ]
                  ],
                  [
                    "set",
                    "@entity.right",
                    [
                      "if",
                      [
                        "and",
                        [
                          "not",
                          "@entity.found"
                        ],
                        [
                          ">",
                          "@entity.sum",
                          24
                        ]
                      ],
                      [
                        "-",
                        "@entity.right",
                        1
                      ],
                      "@entity.right"
                    ]
                  ],
                  [
                    "set",
                    "@entity.done",
                    [
                      "or",
                      "@entity.found",
                      [
                        ">=",
                        "@entity.left",
                        "@entity.right"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.bars",
                    [
                      "array/map",
                      "@entity.bars",
                      [
                        "object/merge",
                        "@item",
                        {
                          "color": [
                            "if",
                            [
                              "or",
                              [
                                "<",
                                "@index",
                                "@entity.left"
                              ],
                              [
                                ">",
                                "@index",
                                "@entity.right"
                              ]
                            ],
                            "#cbd5e1",
                            [
                              "if",
                              [
                                "or",
                                [
                                  "==",
                                  "@index",
                                  "@entity.left"
                                ],
                                [
                                  "==",
                                  "@index",
                                  "@entity.right"
                                ]
                              ],
                              [
                                "if",
                                "@entity.found",
                                "#22c55e",
                                "#f59e0b"
                              ],
                              "#3b82f6"
                            ]
                          ]
                        }
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.pointers",
                    [
                      {
                        "index": "@entity.left",
                        "label": "left",
                        "color": "#2563eb"
                      },
                      {
                        "index": "@entity.right",
                        "label": "right",
                        "color": "#dc2626"
                      }
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "backgroundColor": "#f8fafc",
                      "height": 400,
                      "type": "algorithm-canvas",
                      "pointers": "@entity.pointers",
                      "width": 600,
                      "bars": "@entity.bars"
                    }
                  ],
                  [
                    "emit",
                    "PAIR_UPDATED",
                    {
                      "pointers": "@entity.pointers",
                      "bars": "@entity.bars"
                    }
                  ]
                ]
              }
            ],
            "config": {
              "height": {
                "type": "number",
                "default": 400,
                "label": "Height",
                "description": "Canvas height in pixels.",
                "tier": "presentation"
              },
              "bars": {
                "type": "[AlgoBar]",
                "default": [
                  {
                    "color": "#3b82f6",
                    "value": 1,
                    "label": "1"
                  },
                  {
                    "color": "#3b82f6",
                    "label": "3",
                    "value": 3
                  },
                  {
                    "label": "5",
                    "color": "#3b82f6",
                    "value": 5
                  },
                  {
                    "color": "#3b82f6",
                    "label": "7",
                    "value": 7
                  },
                  {
                    "value": 9,
                    "label": "9",
                    "color": "#3b82f6"
                  },
                  {
                    "color": "#3b82f6",
                    "value": 11,
                    "label": "11"
                  },
                  {
                    "label": "13",
                    "value": 13,
                    "color": "#3b82f6"
                  },
                  {
                    "label": "15",
                    "color": "#3b82f6",
                    "value": 15
                  },
                  {
                    "label": "17",
                    "value": 17,
                    "color": "#3b82f6"
                  },
                  {
                    "value": 19,
                    "label": "19",
                    "color": "#3b82f6"
                  }
                ],
                "label": "Bars",
                "description": "Initial sorted array; each bar's height is proportional to its value.",
                "tier": "domain",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "name": "value",
                      "type": "number",
                      "required": true
                    },
                    "color": {
                      "name": "color",
                      "type": "string",
                      "required": false
                    },
                    "label": {
                      "name": "label",
                      "type": "string",
                      "required": false
                    }
                  }
                }
              },
              "width": {
                "type": "number",
                "default": 600,
                "label": "Width",
                "description": "Canvas width in pixels.",
                "tier": "presentation"
              },
              "running": {
                "type": "boolean",
                "default": true,
                "label": "Running",
                "description": "When true the tick performs one pair-sum step; toggle to start/pause the scan.",
                "tier": "domain"
              },
              "target": {
                "type": "number",
                "default": 24,
                "label": "Target",
                "description": "The pair sum being searched for in the sorted array.",
                "tier": "domain"
              },
              "backgroundColor": {
                "type": "string",
                "default": "#f8fafc",
                "label": "Background Color",
                "description": "Canvas background color.",
                "tier": "presentation"
              }
            },
            "scope": "instance"
          }
        ],
        "pages": [
          {
            "name": "TwoPointerEnginePage",
            "path": "/algo-twopointer",
            "traits": [
              {
                "ref": "TwoPointerSim"
              }
            ]
          }
        ]
      }
    ],
    "_metadata": {
      "configProvenance": {
        "TwoPointerEngineOrbital": [
