  "source": "",
  "lolo": "app ui-svg-stack \"1.0.0\"\n\"SvgStack — UI factory (1:1 with the @almadar/ui svg-stack pattern).\"\norbital SvgStackOrbital {\n  entity SvgStackItem [runtime] {\n    id : string!\n  }\n\n  trait SvgStackRender -> @rebindable SvgStackItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          x: @config.x\n          y: @config.y\n          layers: @config.layers\n          width: @config.width\n          height: @config.height\n          color: @config.color\n          opacity: @config.opacity\n          className: @config.className\n          labels: @config.labels\n          asRoot: @config.asRoot\n          svgWidth: @config.svgWidth\n          svgHeight: @config.svgHeight\n          type: svg-stack\n        })\n    }\n\n    config {\n      x : number = 10\n        @label \"X\"\n        @description \"x prop\"\n        @tier \"presentation\"\n      y : number = 40\n        @label \"Y\"\n        @description \"y prop\"\n        @tier \"presentation\"\n      layers : number\n        @label \"Layers\"\n        @description \"layers prop\"\n        @tier \"presentation\"\n      width : number = 60\n        @label \"Width\"\n        @description \"width prop\"\n        @tier \"presentation\"\n      height : number = 40\n        @label \"Height\"\n        @description \"height prop\"\n        @tier \"presentation\"\n      color : string = \"var(--color-primary)\"\n        @label \"Color\"\n        @description \"color prop\"\n        @tier \"presentation\"\n      opacity : number = 1\n        @label \"Opacity\"\n        @description \"opacity prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      labels : [string] = []\n        @label \"Labels\"\n        @description \"labels prop\"\n        @tier \"presentation\"\n      asRoot : boolean = true\n        @label \"As Root\"\n        @description \"When true (default), wraps in a standalone <svg> so the shape is visible without a parent SVG context.\"\n        @tier \"presentation\"\n      svgWidth : number = 90\n        @label \"Svg Width\"\n        @description \"svgWidth prop\"\n        @tier \"presentation\"\n      svgHeight : number = 80\n        @label \"Svg Height\"\n        @description \"svgHeight prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/svg-stack\" as SvgStackPage -> SvgStackRender\n}\n"
}