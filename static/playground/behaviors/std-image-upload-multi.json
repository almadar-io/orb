  "source": "",
  "lolo": "app std-image-upload-multi \"1.0.0\"\n\"std-image-upload-multi — multi-image upload with drop zone, gallery preview, and per-batch progress.\"\norbital UploadedImageOrbital {\n    type UploadedImageLoaded = Event { data : [UploadedImage] } \"Fired when the uploaded-image collection finishes loading\"\n\n    type UploadedImageLoadFailed = Event { error : string, code : string } \"Fired when the uploaded-image collection fails to load\"\n\n    type UploadedImageCreated = Event { row : UploadedImage } \"Fired after a new uploaded image persists successfully\"\n\n    type UploadedImageDeleted = Event { id : string! } \"Fired after an uploaded image is removed\"\n\n  entity UploadedImage [persistent: uploadedimages] {\n    id : string!\n    url : url! @description \"The accessible address for retrieving the image data.\" @synonyms \"link, path, address\"\n    name : string @description \"The filename or identifier for the uploaded image.\" @synonyms \"filename, originalName, identifier\"\n    sizeBytes : number @description \"The file size in bytes.\" @synonyms \"length, filesize, bytes\"\n    mimeType : string @description \"The file's internet media type.\" @synonyms \"type, format, media type\"\n    width : number @description \"The image's width in pixels.\" @synonyms \"imageWidth, pixelWidth\"\n    height : number @description \"The vertical dimension of the image, in pixels.\" @synonyms \"vertical, y, dimension\"\n    parentId : string @description \"Identifier of the parent resource this image belongs to.\" @synonyms \"parent, reference, source\"\n    parentType : string @description \"Identifies the type of the parent entity.\" @synonyms \"parent, type, category\"\n    uploadedAt : datetime @description \"Timestamp indicating when the image was uploaded.\" @synonyms \"date, timestamp, upload time\"\n  }\n\n  trait UploadedImageUpload -> UploadedImage [interaction, collection] {\n    initial: loading\n\n    state loading {\n      INIT -> loading\n        (fetch UploadedImage {\n          emit: { failure: UploadedImageLoadFailed, success: UploadedImageLoaded }\n        })\n        (render-ui main {\n          align: center\n          children: [{ type: spinner }, {\n            color: muted\n            content: \"Loading images…\"\n            type: typography\n            variant: caption\n          }]\n          className: py-12\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      UploadedImageLoaded -> browsing\n        (render-ui main {\n          children: [{\n            align: center\n            children: [{ name: image-plus, type: icon }, {\n              content: @config.title\n              type: typography\n              variant: h3\n            }]\n            direction: horizontal\n            gap: sm\n            type: stack\n          }, { type: divider }, {\n            accept: @config.accept\n            action: UPLOAD\n            description: \"or click to browse\"\n            icon: image-plus\n            label: \"Drop images here\"\n            maxFiles: @config.maxImages\n            maxSize: @config.maxBytesPerImage\n            type: upload-drop-zone\n          }, { entity: ?data, type: media-gallery }]\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      UploadedImageLoadFailed -> error\n        (render-ui main {\n          message: ?error\n          type: alert\n          variant: error\n        })\n    }\n\n    state browsing {\n      INIT -> loading\n        (fetch UploadedImage {\n          emit: { failure: UploadedImageLoadFailed, success: UploadedImageLoaded }\n        })\n        (render-ui main {\n          align: center\n          children: [{ type: spinner }, {\n            color: muted\n            content: \"Loading images…\"\n            type: typography\n            variant: caption\n          }]\n          className: py-12\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      UPLOAD -> uploading\n        (persist create UploadedImage ?files {\n          emit: { failure: UploadedImageUploadFailed, success: UploadedImageCreated }\n        })\n        (render-ui main {\n          align: center\n          children: [{\n            content: \"Uploading images…\"\n            type: typography\n            variant: h3\n          }, {\n            max: 100\n            progressType: linear\n            type: progress-bar\n            value: 0\n          }]\n          className: py-12\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      DELETE -> browsing\n        (persist delete UploadedImage ?id {\n          emit: { failure: UploadedImageDeleteFailed, success: UploadedImageDeleted }\n        })\n      UploadedImageDeleted -> loading\n        (fetch UploadedImage {\n          emit: { failure: UploadedImageLoadFailed, success: UploadedImageLoaded }\n        })\n      UploadedImageDeleteFailed -> error\n        (render-ui main {\n          message: ?error\n          type: alert\n          variant: error\n        })\n    }\n\n    state uploading {\n      UploadedImageCreated -> loading\n        (fetch UploadedImage {\n          emit: { failure: UploadedImageLoadFailed, success: UploadedImageLoaded }\n        })\n        (render-ui main {\n          align: center\n          children: [{\n            color: success\n            name: check-circle\n            type: icon\n          }, {\n            content: \"Upload complete\"\n            type: typography\n            variant: h3\n          }]\n          className: py-12\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      UploadedImageUploadFailed -> error\n        (render-ui main {\n          message: ?error\n          type: alert\n          variant: error\n        })\n    }\n\n    state error {\n      UploadedImageLoaded -> browsing\n        (render-ui main {\n          children: [{\n            align: center\n            children: [{ name: image-plus, type: icon }, {\n              content: @config.title\n              type: typography\n              variant: h3\n            }]\n            direction: horizontal\n            gap: sm\n            type: stack\n          }, { type: divider }, {\n            accept: @config.accept\n            action: UPLOAD\n            description: \"or click to browse\"\n            icon: image-plus\n            label: \"Drop images here\"\n            maxFiles: @config.maxImages\n            maxSize: @config.maxBytesPerImage\n            type: upload-drop-zone\n          }, { entity: ?data, type: media-gallery }]\n          direction: vertical\n          gap: md\n          type: stack\n        })\n    }\n\n    emits {\n      UPLOAD {\n        files : object!\n      }\n        @description \"Signals that an image upload process has begun.\"\n        @synonyms \"start, initiate, begin\"\n        @tier \"domain\"\n      UploadedImageLoaded {\n        data : [UploadedImage]\n      }\n        @description \"Signals a single image has finished loading.\"\n        @synonyms \"loaded, received, parsed\"\n        @tier \"domain\"\n      UploadedImageLoadFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates an image failed to load during the upload process.\"\n        @synonyms \"error, failure, problem, unsuccessful\"\n        @tier \"internal\"\n      UploadedImageCreated {\n        row : UploadedImage\n      }\n        @description \"A new image has been successfully uploaded.\"\n        @synonyms \"added, new, received\"\n        @tier \"domain\"\n      UploadedImageUploadFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates a single image upload encountered an error.\"\n        @synonyms \"error, failure, problem, rejected\"\n        @tier \"internal\"\n      UploadedImageDeleted {\n        id : string!\n      }\n        @description \"Signals an image has been removed from the upload queue.\"\n        @synonyms \"removed, discarded, taken out\"\n        @tier \"presentation\"\n      UploadedImageDeleteFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates an image deletion operation failed.\"\n        @synonyms \"failed delete, deletion error\"\n        @tier \"internal\"\n    }\n\n    listens {\n      UPLOAD {\n        files : object!\n      }\n        @description \"Indicates a file upload has begun.\"\n        @synonyms \"start, begin, initiate\"\n        @tier \"domain\"\n      DELETE {\n        id : string!\n      }\n        @description \"Indicates a selected image has been removed.\"\n        @synonyms \"remove, discard, clear\"\n        @tier \"presentation\"\n      UploadedImageLoaded {\n        data : [UploadedImage]\n      }\n        @description \"Indicates a single image has been successfully loaded.\"\n        @synonyms \"loaded, received, processed\"\n        @tier \"domain\"\n      UploadedImageLoadFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates an image failed to load during the upload process.\"\n        @synonyms \"error, failure, problem, unsuccessful\"\n        @tier \"internal\"\n      UploadedImageCreated {\n        row : UploadedImage\n      }\n        @description \"A new image has been successfully uploaded.\"\n        @synonyms \"added, received, new image\"\n        @tier \"domain\"\n      UploadedImageUploadFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates an image upload operation encountered an error.\"\n        @synonyms \"error, failure, problem, rejected\"\n        @tier \"internal\"\n      UploadedImageDeleted {\n        id : string!\n      }\n        @description \"An image has been removed from the upload queue.\"\n        @synonyms \"removed, discarded, taken out\"\n        @tier \"presentation\"\n      UploadedImageDeleteFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates an image deletion operation failed.\"\n        @synonyms \"error, failure, problem, unsuccessful\"\n        @tier \"internal\"\n    }\n\n    config {\n      title : string = \"Upload Images\"\n        @label \"Section title\"\n        @description \"Heading shown above the upload zone\"\n        @tier \"presentation\"\n      maxImages : number = 10\n        @label \"Max images\"\n        @description \"Maximum number of images accepted per upload batch\"\n        @tier \"domain\"\n      maxBytesPerImage : number = 10485760\n        @label \"Size limit (bytes)\"\n        @description \"Per-image upload size cap\"\n        @tier \"domain\"\n      accept : string = \"image/*\"\n        @label \"MIME filter\"\n        @description \"Browser accept filter for the file picker\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/uploadedimages/upload\" as UploadedImageUploadPage -> UploadedImageUpload\n}"
}