  "source": "",
  "lolo": "app ui-gantt \"1.0.0\"\n\"Gantt — view-only task schedule rendering rows as bars on a day axis. — UI factory (1:1 with the @almadar/ui gantt pattern).\"\n;; @capabilities \"gantt chart, project timeline, schedule view, task bars, dependency arrows, roadmap, milestone plan\"\norbital GanttOrbital {\n    type GanttLoaded = Event { data : [GanttItem] } \"Gantt rows finished loading; payload.data holds the collection\"\n  type GanttLinksItem = {\n    from : string!\n    to : string!\n  }\n  type GanttError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity GanttItem [runtime] {\n    id : string!\n  }\n\n  trait GanttRender -> @rebindable GanttItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle when @config.selfFetch\n        (fetch GanttItem { emit: { success: GanttLoaded } })\n        (render-ui main {\n          tasks: @entity\n          links: @config.links\n          titleField: @config.titleField\n          startField: @config.startField\n          endField: @config.endField\n          durationField: @config.durationField\n          statusField: @config.statusField\n          groupField: @config.groupField\n          rangeStart: @config.rangeStart\n          rangeEnd: @config.rangeEnd\n          showToday: @config.showToday\n          dayWidth: @config.dayWidth\n          barClickEvent: @config.barClickEvent\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          type: gantt\n        })\n      INIT -> idle when (not @config.selfFetch)\n        (render-ui main {\n          tasks: @entity\n          links: @config.links\n          titleField: @config.titleField\n          startField: @config.startField\n          endField: @config.endField\n          durationField: @config.durationField\n          statusField: @config.statusField\n          groupField: @config.groupField\n          rangeStart: @config.rangeStart\n          rangeEnd: @config.rangeEnd\n          showToday: @config.showToday\n          dayWidth: @config.dayWidth\n          barClickEvent: @config.barClickEvent\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          type: gantt\n        })\n      GanttLoaded -> idle\n        (render-ui main {\n          tasks: @payload.data\n          links: @config.links\n          titleField: @config.titleField\n          startField: @config.startField\n          endField: @config.endField\n          durationField: @config.durationField\n          statusField: @config.statusField\n          groupField: @config.groupField\n          rangeStart: @config.rangeStart\n          rangeEnd: @config.rangeEnd\n          showToday: @config.showToday\n          dayWidth: @config.dayWidth\n          barClickEvent: @config.barClickEvent\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          type: gantt\n        })\n    }\n\n    emits {\n      @config.barClickEvent -> external {\n        id : string!\n      }\n        @description \"Event emitted when a bar is clicked: UI:{barClickEvent} with { id }\"\n        @tier \"essential\"\n      GanttLoaded\n        @description \"Gantt rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      links : [GanttLinksItem] = []\n        @label \"Links\"\n        @description \"Dependency arrows between task ids\"\n        @tier \"presentation\"\n      titleField : string = title\n        @label \"Title Field\"\n        @description \"Row field holding the bar label. Defaults to `title`.\"\n        @tier \"presentation\"\n      startField : string = start\n        @label \"Start Field\"\n        @description \"Row field holding the start timestamp (ISO or epoch). Defaults to `start`.\"\n        @tier \"presentation\"\n      endField : string = end\n        @label \"End Field\"\n        @description \"Row field holding the end timestamp (ISO or epoch). Defaults to `end`. When absent, `durationField` (days) is used instead.\"\n        @tier \"presentation\"\n      durationField : string\n        @label \"Duration Field\"\n        @description \"Row field holding the task length in days, used when the row has no end.\"\n        @tier \"presentation\"\n      statusField : string = status\n        @label \"Status Field\"\n        @description \"Row field holding the bar status (drives bar colour). Defaults to `status`.\"\n        @tier \"presentation\"\n      groupField : string\n        @label \"Group Field\"\n        @description \"Row field rows are grouped under header rows by. Empty (default) = flat list.\"\n        @tier \"presentation\"\n      rangeStart : date = \"2024-01-01\"\n        @label \"Range Start\"\n        @description \"First visible day (ISO or Date). Defaults to 2 days before the earliest task.\"\n        @tier \"presentation\"\n      rangeEnd : date = \"2024-01-01\"\n        @label \"Range End\"\n        @description \"Last visible day (ISO or Date). Defaults to 2 days after the latest task end.\"\n        @tier \"presentation\"\n      showToday : boolean = true\n        @label \"Show Today\"\n        @description \"Paint the today marker line when today falls inside the range (default true).\"\n        @tier \"presentation\"\n      dayWidth : number = 28\n        @label \"Day Width\"\n        @description \"Pixels per day on the axis (default 28)\"\n        @tier \"presentation\"\n      barClickEvent : event = \"BAR_CLICK\"\n        @label \"Bar Click Event\"\n        @description \"Event emitted when a bar is clicked: UI:{barClickEvent} with { id }\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state\"\n        @tier \"presentation\"\n      error : GanttError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      selfFetch : boolean = true\n        @label \"Fetch its own rows on mount?\"\n        @description \"true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/gantt\" as GanttPage -> GanttRender\n}\n"
}