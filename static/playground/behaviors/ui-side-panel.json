  "source": "",
  "lolo": "app ui-side-panel \"1.0.0\"\n\"SidePanel — UI factory (1:1 with the @almadar/ui side-panel pattern).\"\norbital SidePanelOrbital {\n  entity SidePanelItem [runtime] {\n    id : string!\n  }\n\n  trait SidePanelRender -> @rebindable SidePanelItem [interaction, instance] {\n    initial: closed\n\n    state closed {\n      INIT -> closed\n        (render-ui main {\n          label: \"Open Side-panel\"\n          action: OPEN\n          type: button\n        })\n      OPEN -> open\n        (render-ui drawer {\n          title: @config.title\n          children: @config.children\n          isOpen: @config.isOpen\n          onClose: @config.onClose\n          width: @config.width\n          position: @config.position\n          showOverlay: @config.showOverlay\n          className: @config.className\n          closeEvent: @config.closeEvent\n          type: side-panel\n        })\n    }\n\n    state open {\n      CLOSE -> closed\n        (render-ui drawer null)\n        (render-ui main {\n          label: \"Open Side-panel\"\n          action: OPEN\n          type: button\n        })\n    }\n\n    emits {\n      @config.onClose -> external { }\n        @description \"On close handler\"\n        @tier \"essential\"\n      OPEN -> external {\n        id : string\n      }\n        @description \"Open the Side-panel.\"\n        @tier \"essential\"\n    }\n\n    config {\n      title : string = \"\"\n        @label \"Title\"\n        @description \"Panel title\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Panel content\"\n        @tier \"presentation\"\n      isOpen : boolean = false\n        @label \"Is Open\"\n        @description \"Is panel open\"\n        @tier \"presentation\"\n      onClose : event = \"CLOSE\"\n        @label \"On Close\"\n        @description \"On close handler\"\n        @tier \"presentation\"\n      width : string = \"w-full sm:w-96\"\n        @label \"Width\"\n        @description \"Panel width as Tailwind class string. Default fills the viewport on mobile and snaps to `w-96` (384 px) at `sm:` and above so phones don't lose content to a fixed 384 px column. Consumers passing a custom value should include a `w-full` mobile fallback in the same string (e.g. `'w-full sm:w-[480px]'`) — Tailwind's JIT can't see dynamically-concatenated class names.\"\n        @tier \"presentation\"\n      position : \"left\" | \"right\" = right\n        @label \"Position\"\n        @description \"Panel position\"\n        @tier \"presentation\"\n      showOverlay : boolean = true\n        @label \"Show Overlay\"\n        @description \"Show overlay on mobile\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      closeEvent : event = \"CLOSE\"\n        @label \"Close Event\"\n        @description \"Declarative close event — emits UI:{closeEvent} via eventBus when panel should close\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/side-panel\" as SidePanelPage -> SidePanelRender\n}\n"
}