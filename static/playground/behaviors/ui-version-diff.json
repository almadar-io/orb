  "source": "",
  "lolo": "app ui-version-diff \"1.0.0\"\n\"VersionDiff — UI factory (1:1 with the @almadar/ui version-diff pattern).\"\norbital VersionDiffOrbital {\n  type VersionDiffRevisionsItem = {\n    id : string!\n    label : string!\n    author : string\n    timestamp : string\n    content : string!\n  }\n\n  entity VersionDiffItem [runtime] {\n    id : string!\n  }\n\n  trait VersionDiffRender -> @rebindable VersionDiffItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          revisions: @config.revisions\n          beforeId: @config.beforeId\n          afterId: @config.afterId\n          view: @config.view\n          onSelectBefore: @config.onSelectBefore\n          onSelectAfter: @config.onSelectAfter\n          onRevert: @config.onRevert\n          selectBeforeEvent: @config.selectBeforeEvent\n          selectAfterEvent: @config.selectAfterEvent\n          revertEvent: @config.revertEvent\n          language: @config.language\n          className: @config.className\n          type: version-diff\n        })\n    }\n\n    emits {\n      @config.onSelectBefore -> external {\n        id : string\n      }\n        @description \"Called when the user picks a different 'before' revision.\"\n        @tier \"essential\"\n      @config.onSelectAfter -> external {\n        id : string\n      }\n        @description \"Called when the user picks a different 'after' revision.\"\n        @tier \"essential\"\n      @config.onRevert -> external {\n        id : string\n      }\n        @description \"Called when the user clicks the revert button (passes the 'before' id).\"\n        @tier \"essential\"\n    }\n\n    config {\n      revisions : [VersionDiffRevisionsItem] = [{ id: \"Id\", label: \"Label\", author: \"Author\", timestamp: \"Timestamp\", content: \"Content\" }, { id: \"Id 2\", label: \"Label 2\", author: \"Author 2\", timestamp: \"Timestamp 2\", content: \"Content 2\" }]\n        @label \"Revisions\"\n        @description \"All available revisions (at least 2). Accepts either a typed array (direct consumers) or the runtime payload shape from a render-ui binding (`@payload.revisions`). Narrowed to `[]` internally when the value isn't an array.\"\n        @tier \"presentation\"\n      beforeId : string\n        @label \"Before Id\"\n        @description \"Currently selected 'before' revision id.\"\n        @tier \"presentation\"\n      afterId : string\n        @label \"After Id\"\n        @description \"Currently selected 'after' revision id.\"\n        @tier \"presentation\"\n      view : \"side-by-side\" | \"inline\" = \"side-by-side\"\n        @label \"View\"\n        @description \"Display mode.\"\n        @tier \"presentation\"\n      onSelectBefore : event = \"SELECT_BEFORE\"\n        @label \"On Select Before\"\n        @description \"Called when the user picks a different 'before' revision.\"\n        @tier \"presentation\"\n      onSelectAfter : event = \"SELECT_AFTER\"\n        @label \"On Select After\"\n        @description \"Called when the user picks a different 'after' revision.\"\n        @tier \"presentation\"\n      onRevert : event = \"REVERT\"\n        @label \"On Revert\"\n        @description \"Called when the user clicks the revert button (passes the 'before' id).\"\n        @tier \"presentation\"\n      selectBeforeEvent : event = \"SELECT_BEFORE\"\n        @label \"Select Before Event\"\n        @description \"Event name dispatched via event bus when the 'before' revision changes. Payload: { id }.\"\n        @tier \"presentation\"\n      selectAfterEvent : event = \"SELECT_AFTER\"\n        @label \"Select After Event\"\n        @description \"Event name dispatched via event bus when the 'after' revision changes. Payload: { id }.\"\n        @tier \"presentation\"\n      revertEvent : event = \"REVERT\"\n        @label \"Revert Event\"\n        @description \"Event name dispatched via event bus when the user clicks revert. Payload: { id }.\"\n        @tier \"presentation\"\n      language : string\n        @label \"Language\"\n        @description \"Language label (informational).\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/version-diff\" as VersionDiffPage -> VersionDiffRender\n}\n"
}