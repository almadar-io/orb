  "source": "",
  "lolo": "app ui-box \"1.0.0\"\n\"Box — UI factory (1:1 with the @almadar/ui box pattern).\"\norbital BoxOrbital {\n  entity BoxItem [runtime] {\n    id : string!\n  }\n\n  trait BoxRender -> @rebindable BoxItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          padding: @config.padding\n          paddingX: @config.paddingX\n          paddingY: @config.paddingY\n          margin: @config.margin\n          marginX: @config.marginX\n          marginY: @config.marginY\n          bg: @config.bg\n          border: @config.border\n          rounded: @config.rounded\n          shadow: @config.shadow\n          display: @config.display\n          fullWidth: @config.fullWidth\n          fullHeight: @config.fullHeight\n          overflow: @config.overflow\n          position: @config.position\n          action: @config.action\n          actionPayload: @config.actionPayload\n          hoverEvent: @config.hoverEvent\n          tapReveal: @config.tapReveal\n          maxWidth: @config.maxWidth\n          children: @config.children\n          type: box\n        })\n    }\n\n    emits {\n      @config.action -> external { }\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"essential\"\n      @config.hoverEvent -> external {\n        hovered : boolean!\n      }\n        @description \"Declarative hover event — emits UI:{hoverEvent} with { hovered: true/false } on mouseEnter/mouseLeave\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes applied to the root element.\"\n        @tier \"presentation\"\n      padding : \"none\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" = none\n        @label \"Padding\"\n        @description \"Padding on all sides\"\n        @tier \"presentation\"\n      paddingX : \"none\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" = none\n        @label \"Padding X\"\n        @description \"Horizontal padding (overrides padding for x-axis)\"\n        @tier \"presentation\"\n      paddingY : \"none\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" = none\n        @label \"Padding Y\"\n        @description \"Vertical padding (overrides padding for y-axis)\"\n        @tier \"presentation\"\n      margin : \"none\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" | \"auto\" = none\n        @label \"Margin\"\n        @description \"Margin on all sides\"\n        @tier \"presentation\"\n      marginX : \"none\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" | \"auto\" = none\n        @label \"Margin X\"\n        @description \"Horizontal margin\"\n        @tier \"presentation\"\n      marginY : \"none\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" | \"auto\" = none\n        @label \"Margin Y\"\n        @description \"Vertical margin\"\n        @tier \"presentation\"\n      bg : \"transparent\" | \"primary\" | \"secondary\" | \"muted\" | \"accent\" | \"surface\" | \"overlay\" = transparent\n        @label \"Bg\"\n        @description \"Background color\"\n        @tier \"presentation\"\n      border : boolean = false\n        @label \"Border\"\n        @description \"Show border\"\n        @tier \"presentation\"\n      rounded : \"none\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" | \"full\" = none\n        @label \"Rounded\"\n        @description \"Border radius\"\n        @tier \"presentation\"\n      shadow : \"none\" | \"sm\" | \"md\" | \"lg\" | \"xl\" = none\n        @label \"Shadow\"\n        @description \"Box shadow\"\n        @tier \"presentation\"\n      display : \"block\" | \"inline\" | \"inline-block\" | \"flex\" | \"inline-flex\" | \"grid\" = block\n        @label \"Display\"\n        @description \"Display type\"\n        @tier \"presentation\"\n      fullWidth : boolean = false\n        @label \"Full Width\"\n        @description \"Fill available width\"\n        @tier \"presentation\"\n      fullHeight : boolean = false\n        @label \"Full Height\"\n        @description \"Fill available height\"\n        @tier \"presentation\"\n      overflow : \"auto\" | \"hidden\" | \"visible\" | \"scroll\" = auto\n        @label \"Overflow\"\n        @description \"Overflow behavior\"\n        @tier \"presentation\"\n      position : \"relative\" | \"absolute\" | \"fixed\" | \"sticky\" = relative\n        @label \"Position\"\n        @description \"Position\"\n        @tier \"presentation\"\n      action : event = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"presentation\"\n      actionPayload : @payload @config.action\n        @label \"Action Payload\"\n        @description \"Payload to include with the action event\"\n        @tier \"presentation\"\n      hoverEvent : event = \"HOVER\"\n        @label \"Hover Event\"\n        @description \"Declarative hover event — emits UI:{hoverEvent} with { hovered: true/false } on mouseEnter/mouseLeave\"\n        @tier \"presentation\"\n      tapReveal : boolean = true\n        @label \"Tap Reveal\"\n        @description \"When true (default), a touch/pen tap also fires `hoverEvent` (toggling hovered) so hover-only reveals work on touch.\"\n        @tier \"presentation\"\n      maxWidth : string\n        @label \"Max Width\"\n        @description \"Maximum width (CSS value, e.g., '550px', '80rem')\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Children elements\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/box\" as BoxPage -> BoxRender\n}\n"
}