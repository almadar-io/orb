  "lolo": "app ui-entity-list \"1.0.0\"\n\"EntityList — UI factory (1:1 with the @almadar/ui entity-list pattern).\"\norbital EntityListOrbital {\n    type EntityListLoaded = Event { data : [EntityListItem] } \"EntityList rows finished loading; payload.data holds the collection\"\n  type EntityListError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type EntityListFieldsItem = {\n    key : string\n    header : string\n    name : string\n    label : string\n  }\n  type EntityListItemActionsItem = {\n    label : string!\n    event : event\n    navigatesTo : string\n    placement : string\n    variant : \"primary\" | \"secondary\" | \"ghost\" | \"danger\" | \"default\"\n  }\n\n  entity EntityListItem [runtime] {\n    id : string!\n  }\n\n  trait EntityListRender -> @rebindable EntityListItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle when @config.selfFetch\n        (fetch EntityListItem { emit: { success: EntityListLoaded } })\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          entityType: @config.entityType\n          selectable: @config.selectable\n          itemActions: @config.itemActions\n          showDividers: @config.showDividers\n          variant: @config.variant\n          emptyMessage: @config.emptyMessage\n          children: @config.children\n          fields: @config.fields\n          fieldNames: @config.fieldNames\n          type: entity-list\n        })\n      INIT -> idle when (not @config.selfFetch)\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          entityType: @config.entityType\n          selectable: @config.selectable\n          itemActions: @config.itemActions\n          showDividers: @config.showDividers\n          variant: @config.variant\n          emptyMessage: @config.emptyMessage\n          children: @config.children\n          fields: @config.fields\n          fieldNames: @config.fieldNames\n          type: entity-list\n        })\n      EntityListLoaded -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @payload.data\n          entityType: @config.entityType\n          selectable: @config.selectable\n          itemActions: @config.itemActions\n          showDividers: @config.showDividers\n          variant: @config.variant\n          emptyMessage: @config.emptyMessage\n          children: @config.children\n          fields: @config.fields\n          fieldNames: @config.fieldNames\n          type: entity-list\n        })\n    }\n\n    emits {\n      ITEM_ACTIONS -> external { }\n        @description \"Item actions - schema-driven or function-based\"\n        @tier \"essential\"\n      VIEW -> external {\n        id : string!\n        row : @entity!\n      }\n        @description \"User opened a record from the list.\"\n        @tier \"essential\"\n      EntityListLoaded\n        @description \"EntityList rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : EntityListError\n        @label \"Error\"\n        @description \"Error state (UiError)\"\n        @tier \"presentation\"\n      sortBy : string\n        @label \"Sort By\"\n        @description \"Current sort field\"\n        @tier \"presentation\"\n      sortDirection : \"asc\" | \"desc\" = asc\n        @label \"Sort Direction\"\n        @description \"Current sort direction\"\n        @tier \"presentation\"\n      searchValue : string\n        @label \"Search Value\"\n        @description \"Current search query value\"\n        @tier \"presentation\"\n      pageProp : number\n        @label \"Page\"\n        @description \"Current page number\"\n        @synonyms \"page\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Number of items per page\"\n        @tier \"presentation\"\n      totalCount : number\n        @label \"Total Count\"\n        @description \"Total number of items\"\n        @tier \"presentation\"\n      activeFilters : Map string string = {}\n        @label \"Active Filters\"\n        @description \"Active filters\"\n        @tier \"presentation\"\n      selectedIds : [string] = []\n        @label \"Selected Ids\"\n        @description \"Currently selected item IDs\"\n        @tier \"presentation\"\n      entityType : string\n        @label \"Entity Type\"\n        @description \"Entity type name for display\"\n        @tier \"presentation\"\n      selectable : boolean = false\n        @label \"Selectable\"\n        @description \"selectable prop\"\n        @tier \"presentation\"\n      itemActions : [EntityListItemActionsItem] = [{ event: VIEW, label: View, variant: ghost }]\n        @label \"Item Actions\"\n        @description \"Item actions - schema-driven or function-based\"\n        @tier \"presentation\"\n      showDividers : boolean\n        @label \"Show Dividers\"\n        @description \"showDividers prop\"\n        @tier \"presentation\"\n      variant : \"default\" | \"card\" = default\n        @label \"Variant\"\n        @description \"variant prop\"\n        @tier \"presentation\"\n      emptyMessage : string\n        @label \"Empty Message\"\n        @description \"emptyMessage prop\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"children prop\"\n        @tier \"presentation\"\n      fields : [EntityListFieldsItem] = [{ key: \"Key\", header: \"Header\", name: \"Name\", label: \"Label\" }, { key: \"Key 2\", header: \"Header 2\", name: \"Name 2\", label: \"Label 2\" }]\n        @label \"Fields\"\n        @description \"Fields to display - accepts string[] or {key, header}[] for unified interface\"\n        @tier \"presentation\"\n      fieldNames : [string] = []\n        @label \"Field Names\"\n        @description \"Alias for fields - backwards compatibility\"\n        @tier \"presentation\"\n      selfFetch : boolean = true\n        @label \"Fetch its own rows on mount?\"\n        @description \"true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/entity-list\" as EntityListPage -> EntityListRender\n}\n"
}