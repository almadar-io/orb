  "source": "",
  "lolo": "app ui-action-palette \"1.0.0\"\n\"ActionPalette — UI factory (1:1 with the @almadar/ui action-palette pattern).\"\n;; @pattern \"action-palette\"\norbital ActionPaletteOrbital {\n  type ActionPaletteActionsItem = {\n    id : string!\n    name : string!\n    category : string!\n    description : string\n    iconEmoji : string\n    iconUrl : ActionPaletteActionsItemIconUrl\n    stateMachine : ActionPaletteActionsItemStateMachine\n  }\n  type ActionPaletteActionsItemIconUrl = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\" | \"4:1\" | \"5:3\" | \"1:2\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n  type ActionPaletteActionsItemStateMachine = {\n    name : string!\n    states : [string]!\n    currentState : string!\n    transitions : [ActionPaletteActionsItemStateMachineTransitionsItem]!\n    description : string\n  }\n  type ActionPaletteActionsItemStateMachineTransitionsItem = {\n    from : string!\n    to : string!\n    event : string!\n    guardHint : string\n  }\n  type ActionPaletteCategoryColorsValue = {\n    bg : string!\n    border : string!\n  }\n\n  entity ActionPaletteItem [runtime] {\n    id : string!\n  }\n\n  trait ActionPaletteRender -> @rebindable ActionPaletteItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          actions: @config.actions\n          usedActionIds: @config.usedActionIds\n          allowDuplicates: @config.allowDuplicates\n          categoryColors: @config.categoryColors\n          size: @config.size\n          label: @config.label\n          className: @config.className\n          enter: @config.enter\n          enterDelay: @config.enterDelay\n          skeleton: @config.skeleton\n          aria-label: @config.ariaLabel\n          aria-labelledby: @config.ariaLabelledby\n          aria-describedby: @config.ariaDescribedby\n          aria-live: @config.ariaLive\n          aria-current: @config.ariaCurrent\n          aria-pressed: @config.ariaPressed\n          aria-expanded: @config.ariaExpanded\n          aria-selected: @config.ariaSelected\n          aria-hidden: @config.ariaHidden\n          aria-busy: @config.ariaBusy\n          role: @config.role\n          lang: @config.lang\n          dir: @config.dir\n          tabIndex: @config.tabIndex\n          type: action-palette\n        })\n    }\n\n    config {\n      actions : [ActionPaletteActionsItem] = [{ id: \"Id\", name: \"Name\", category: \"Category\", description: \"Description\", iconEmoji: \"Icon Emoji\", iconUrl: { url: \"https://almadar-kflow-assets.web.app/shared/ui-battle-board/default/ui/star.png\", role: \"ui\", category: \"iconUrl\", animations: [\"static\"], style: \"pixel\", dimension: \"2d\", aspect: \"1:1\", name: \"iconUrl\", thumbnailUrl: \"\" }, stateMachine: { name: \"Name\", states: [\"Item\", \"Item 2\"], currentState: \"Current State\", transitions: [{ from: \"From\", to: \"To\", event: \"Event\", guardHint: \"Guard Hint\" }, { from: \"From 2\", to: \"To 2\", event: \"Event 2\", guardHint: \"Guard Hint 2\" }], description: \"Description\" } }, { id: \"Id 2\", name: \"Name 2\", category: \"Category 2\", description: \"Description 2\", iconEmoji: \"Icon Emoji 2\", iconUrl: { url: \"https://almadar-kflow-assets.web.app/shared/ui-battle-board/default/ui/star.png\", role: \"ui\", category: \"iconUrl\", animations: [\"static\"], style: \"pixel\", dimension: \"2d\", aspect: \"1:1\", name: \"iconUrl\", thumbnailUrl: \"\" }, stateMachine: { name: \"Name 2\", states: [\"Item\", \"Item 2\"], currentState: \"Current State 2\", transitions: [{ from: \"From\", to: \"To\", event: \"Event\", guardHint: \"Guard Hint\" }, { from: \"From 2\", to: \"To 2\", event: \"Event 2\", guardHint: \"Guard Hint 2\" }], description: \"Description 2\" } }]\n        @label \"Actions\"\n        @description \"Available actions\"\n        @tier \"presentation\"\n      usedActionIds : [string] = []\n        @label \"Used Action Ids\"\n        @description \"IDs of actions that are already used (shown as disabled)\"\n        @tier \"presentation\"\n      allowDuplicates : boolean = true\n        @label \"Allow Duplicates\"\n        @description \"Whether each action can be used multiple times\"\n        @tier \"presentation\"\n      categoryColors : Map string ActionPaletteCategoryColorsValue = {}\n        @label \"Category Colors\"\n        @description \"Category → color mapping\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Size variant\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Label above the palette\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      enter : \"none\" | \"fade\" | \"rise\" | \"scale\" | \"slide\"\n        @label \"Enter\"\n        @description \"How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out.\"\n        @tier \"presentation\"\n      enterDelay : number\n        @label \"Enter Delay\"\n        @description \"Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating.\"\n        @tier \"presentation\"\n      skeleton : \"header\" | \"table\" | \"list\" | \"grid\" | \"detail\" | \"stats\" | \"form\" | \"card\" | \"text\" | \"none\"\n        @label \"Skeleton\"\n        @description \"Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`.\"\n        @tier \"presentation\"\n      ariaLabel : string\n        @label \"Aria-label\"\n        @description \"Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control).\"\n        @synonyms \"aria-label\"\n        @tier \"presentation\"\n      ariaLabelledby : string\n        @label \"Aria-labelledby\"\n        @description \"Id of the element whose text names this one.\"\n        @synonyms \"aria-labelledby\"\n        @tier \"presentation\"\n      ariaDescribedby : string\n        @label \"Aria-describedby\"\n        @description \"Id of the element whose text describes this one (help text, error).\"\n        @synonyms \"aria-describedby\"\n        @tier \"presentation\"\n      ariaLive : \"off\" | \"polite\" | \"assertive\"\n        @label \"Aria-live\"\n        @description \"Announce changes to this region: polite waits for a pause, assertive interrupts.\"\n        @synonyms \"aria-live\"\n        @tier \"presentation\"\n      ariaCurrent : \"page\" | \"step\" | \"location\" | \"date\" | \"time\" | \"true\" | \"false\"\n        @label \"Aria-current\"\n        @description \"Marks the current item in a set: the current page, step, location, date or time.\"\n        @synonyms \"aria-current\"\n        @tier \"presentation\"\n      ariaPressed : \"true\" | \"false\" | \"mixed\"\n        @label \"Aria-pressed\"\n        @description \"Toggle-button state.\"\n        @synonyms \"aria-pressed\"\n        @tier \"presentation\"\n      ariaExpanded : boolean\n        @label \"Aria-expanded\"\n        @description \"Whether the element it controls is expanded.\"\n        @synonyms \"aria-expanded\"\n        @tier \"presentation\"\n      ariaSelected : boolean\n        @label \"Aria-selected\"\n        @description \"Whether this item is selected (tabs, options, grid cells).\"\n        @synonyms \"aria-selected\"\n        @tier \"presentation\"\n      ariaHidden : boolean\n        @label \"Aria-hidden\"\n        @description \"Hide from assistive technology (decorative content only).\"\n        @synonyms \"aria-hidden\"\n        @tier \"presentation\"\n      ariaBusy : boolean\n        @label \"Aria-busy\"\n        @description \"This region is updating; assistive technology waits before announcing it.\"\n        @synonyms \"aria-busy\"\n        @tier \"presentation\"\n      role : \"alert\" | \"alertdialog\" | \"application\" | \"article\" | \"banner\" | \"blockquote\" | \"button\" | \"caption\" | \"cell\" | \"checkbox\" | \"code\" | \"columnheader\" | \"combobox\" | \"complementary\" | \"contentinfo\" | \"definition\" | \"deletion\" | \"dialog\" | \"document\" | \"emphasis\" | \"feed\" | \"figure\" | \"form\" | \"generic\" | \"grid\" | \"gridcell\" | \"group\" | \"heading\" | \"img\" | \"insertion\" | \"link\" | \"list\" | \"listbox\" | \"listitem\" | \"log\" | \"main\" | \"marquee\" | \"math\" | \"menu\" | \"menubar\" | \"menuitem\" | \"menuitemcheckbox\" | \"menuitemradio\" | \"meter\" | \"navigation\" | \"none\" | \"note\" | \"option\" | \"paragraph\" | \"presentation\" | \"progressbar\" | \"radio\" | \"radiogroup\" | \"region\" | \"row\" | \"rowgroup\" | \"rowheader\" | \"scrollbar\" | \"search\" | \"searchbox\" | \"separator\" | \"slider\" | \"spinbutton\" | \"status\" | \"strong\" | \"subscript\" | \"superscript\" | \"switch\" | \"tab\" | \"table\" | \"tablist\" | \"tabpanel\" | \"term\" | \"textbox\" | \"time\" | \"timer\" | \"toolbar\" | \"tooltip\" | \"tree\" | \"treegrid\" | \"treeitem\"\n        @label \"Role\"\n        @description \"WAI-ARIA role when the element's native semantics don't describe it.\"\n        @tier \"presentation\"\n      lang : string\n        @label \"Lang\"\n        @description \"Language of this element's content (BCP 47, e.g. ar, sl, en).\"\n        @tier \"presentation\"\n      dir : \"ltr\" | \"rtl\" | \"auto\"\n        @label \"Dir\"\n        @description \"Text direction of this element's content.\"\n        @tier \"presentation\"\n      tabIndex : number\n        @label \"Tab Index\"\n        @description \"0 puts the element in the Tab order; -1 makes it focusable only programmatically.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/action-palette\" as ActionPalettePage -> ActionPaletteRender\n}\n"
}