    "_metadata": {
      "configProvenance": {
        "AudioCueOrbital": [
          {
            "knob": "baseUrl",
            "patternPath": "root",
            "prop": "baseUrl",
            "trait": "AudioCue"
          },
          {
            "knob": "manifest",
            "patternPath": "root",
            "prop": "manifest",
            "trait": "AudioCue"
          }
        ]
      }
    },
