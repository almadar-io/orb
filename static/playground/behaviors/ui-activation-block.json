  "source": "",
  "lolo": "app ui-activation-block \"1.0.0\"\n\"ActivationBlock — UI factory (1:1 with the @almadar/ui activation-block pattern).\"\norbital ActivationBlockOrbital {\n  entity ActivationBlockItem [runtime] {\n    id : string!\n  }\n\n  trait ActivationBlockRender -> @rebindable ActivationBlockItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          question: @config.question\n          savedResponse: @config.savedResponse\n          saveEvent: @config.saveEvent\n          className: @config.className\n          type: activation-block\n        })\n    }\n\n    config {\n      question : string = \"\"\n        @label \"Question\"\n        @description \"The prior-knowledge question\"\n        @tier \"presentation\"\n      savedResponse : string\n        @label \"Saved Response\"\n        @description \"Pre-filled response from saved state\"\n        @tier \"presentation\"\n      saveEvent : string = \"SAVE_ACTIVATION\"\n        @label \"Save Event\"\n        @description \"Event name emitted on save/skip (as `UI:<saveEvent>`). Defaults to 'SAVE_ACTIVATION'.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/activation-block\" as ActivationBlockPage -> ActivationBlockRender\n}\n"
}