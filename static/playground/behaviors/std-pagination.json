  "source": "",
  "lolo": "app std-pagination \"1.0.0\"\n\"std-pagination — single primitive: pagination control. PAGE accepts the Pagination component's `{page}` emit; ITEMS_LOADED accepts an upstream `{data:[ObjectSpec]}` payload and derives totalPages = ceil(len/pageSize). Molecules wire `BrowseItemLoaded -> ITEMS_LOADED` to keep it in lockstep with the data hub.\"\ntype ObjectSpec = { id : string, label : string, value : string }\norbital PagedItemOrbital {\n    type PagedItemLoaded = Event { data : [PagedItem] } \"Fired after the PagedItem entity is fetched on INIT; carries the seeded instance(s) so client-side @entity.currentPage / .totalPages bindings resolve before any user interaction.\"\n\n  entity PagedItem [runtime] {\n    id : string!\n    currentPage : number @description \"The current page number being displayed.\" @synonyms \"page, current, index\" = 1\n    totalPages : number @description \"The total number of pages available.\" @synonyms \"page count, total pages, number of pages\" = 1\n  }\n\n  trait PagedItemPagination -> PagedItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.currentPage 1)\n        (set @entity.totalPages 1)\n        (fetch PagedItem {\n          emit: { success: PagedItemLoaded }\n        })\n        (render-ui main {\n          currentPage: @entity.currentPage\n          pageChangeEvent: @config.event\n          showPageSize: false\n          totalPages: @entity.totalPages\n          type: pagination\n        })\n      PagedItemLoaded -> idle\n        (render-ui main {\n          currentPage: @entity.currentPage\n          pageChangeEvent: @config.event\n          showPageSize: false\n          totalPages: @entity.totalPages\n          type: pagination\n        })\n      PAGE -> idle\n        (set @entity.currentPage ?page)\n        (render-ui main {\n          currentPage: @entity.currentPage\n          pageChangeEvent: @config.event\n          showPageSize: false\n          totalPages: @entity.totalPages\n          type: pagination\n        })\n      ITEMS_LOADED -> idle\n        (set @entity.totalPages (math/ceil [\"/\", ?totalCount, @config.pageSize]))\n        (render-ui main {\n          currentPage: @entity.currentPage\n          pageChangeEvent: @config.event\n          showPageSize: false\n          totalPages: @entity.totalPages\n          type: pagination\n        })\n    }\n\n    emits {\n      PAGE {\n        page : number!\n      }\n        @description \"Indicates a change in the currently displayed page.\"\n        @synonyms \"page-change, navigate, go-to\"\n        @tier \"domain\"\n      PagedItemLoaded {\n        data : [PagedItem]\n      }\n        @description \"Indicates a single item has been loaded within a paginated view.\"\n        @synonyms \"item-loaded, data-received, entry-loaded\"\n        @tier \"domain\"\n    }\n\n    listens {\n      PAGE {\n        page : number!\n      }\n        @description \"Indicates the user has selected a different page.\"\n        @synonyms \"page-change, navigate, jump\"\n        @tier \"domain\"\n      ITEMS_LOADED {\n        data : [ObjectSpec]\n        totalCount : number\n      }\n        @description \"Data has been loaded and pagination limits updated.\"\n        @synonyms \"data-ready, content-loaded, refresh\"\n        @tier \"domain\"\n      PagedItemLoaded {\n        data : [PagedItem]\n      }\n        @description \"Indicates a single item has been loaded within a paginated set.\"\n        @synonyms \"item-loaded, data-received, entry-loaded\"\n        @tier \"domain\"\n    }\n\n    config {\n      pageSize : number = 10\n        @label \"Page size\"\n        @description \"Rows per page used to derive total page count\"\n        @tier \"presentation\"\n      event : event = PAGE\n        @label \"Page-change event\"\n        @description \"Event emitted when the user picks a new page\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/pageditems/paginated\" as PagedItemPaginationPage -> PagedItemPagination\n}\n"
}