            "ticks": [
              {
                "name": "numberlineTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "let",
                    [
                      [
                        "nphase",
                        [
                          "+",
                          "@entity.phase",
                          3
                        ]
                      ]
                    ],
                    [
                      "let",
                      [
                        [
                          "pos",
                          [
                            "-",
                            [
                              "math/mod",
                              [
                                "math/round",
                                [
                                  "/",
                                  "@nphase",
                                  10
                                ]
                              ],
                              19
                            ],
                            9
                          ]
                        ]
                      ],
                      [
                        "do",
                        [
                          "set",
                          "@entity.phase",
                          "@nphase"
                        ],
                        [
                          "set",
                          "@entity.points",
                          [
                            "array/map",
                            "@entity.points",
                            [
                              "fn",
                              "p",
                              [
                                "if",
                                [
                                  "=",
                                  [
                                    "object/get",
                                    "@p",
                                    "label"
                                  ],
                                  "n"
                                ],
                                [
                                  "object/merge",
                                  "@p",
                                  {
                                    "x": "@pos"
                                  }
                                ],
                                "@p"
                              ]
                            ]
                          ]
                        ],
                        [
