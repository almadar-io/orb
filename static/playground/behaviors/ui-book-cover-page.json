  "source": "",
  "lolo": "app ui-book-cover-page \"1.0.0\"\n\"BookCoverPage — UI factory (1:1 with the @almadar/ui book-cover-page pattern).\"\norbital BookCoverPageOrbital {\n  entity BookCoverPageItem [runtime] {\n    id : string!\n  }\n\n  trait BookCoverPageRender -> @rebindable BookCoverPageItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          title: @config.title\n          subtitle: @config.subtitle\n          author: @config.author\n          coverImageUrl: @config.coverImageUrl\n          direction: @config.direction\n          type: book-cover-page\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      title : string = \"\"\n        @label \"Title\"\n        @description \"title prop\"\n        @tier \"presentation\"\n      subtitle : string\n        @label \"Subtitle\"\n        @description \"subtitle prop\"\n        @tier \"presentation\"\n      author : string\n        @label \"Author\"\n        @description \"author prop\"\n        @tier \"presentation\"\n      coverImageUrl : asset = \"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png\"\n        @label \"Cover Image Url\"\n        @description \"coverImageUrl prop\"\n        @tier \"presentation\"\n      direction : \"rtl\" | \"ltr\" = rtl\n        @label \"Direction\"\n        @description \"direction prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/book-cover-page\" as BookCoverPagePage -> BookCoverPageRender\n}\n"
}