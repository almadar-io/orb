  "source": "",
  "lolo": "app ui-reply-tree \"1.0.0\"\n\"ReplyTree — UI factory (1:1 with the @almadar/ui reply-tree pattern).\"\norbital ReplyTreeOrbital {\n    type ReplyTreeLoaded = Event { data : [ReplyTreeItem] } \"ReplyTree rows finished loading; payload.data holds the collection\"\n\n  entity ReplyTreeItem [runtime] {\n    id : string!\n    authorName : string = \"Author Name\"\n    content : string = \"Content\"\n    authorAvatarUrl : string = \"Author Avatar Url\"\n    postedAt : string = \"Posted At\"\n    voteCount : number = 1\n    userVote : \"up\" | \"down\" | \"none\" = up\n    collapsed : boolean = false\n    replies : [opaque] = []\n  }\n\n  trait ReplyTreeRender -> @rebindable ReplyTreeItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle when @config.selfFetch\n        (fetch ReplyTreeItem { emit: { success: ReplyTreeLoaded } })\n        (render-ui main {\n          nodes: @entity\n          maxDepth: @config.maxDepth\n          onVote: @config.onVote\n          onReply: @config.onReply\n          onFlag: @config.onFlag\n          onContinueThread: @config.onContinueThread\n          voteEvent: @config.voteEvent\n          replyEvent: @config.replyEvent\n          flagEvent: @config.flagEvent\n          continueThreadEvent: @config.continueThreadEvent\n          showActions: @config.showActions\n          className: @config.className\n          type: reply-tree\n        })\n      INIT -> idle when (not @config.selfFetch)\n        (render-ui main {\n          nodes: @entity\n          maxDepth: @config.maxDepth\n          onVote: @config.onVote\n          onReply: @config.onReply\n          onFlag: @config.onFlag\n          onContinueThread: @config.onContinueThread\n          voteEvent: @config.voteEvent\n          replyEvent: @config.replyEvent\n          flagEvent: @config.flagEvent\n          continueThreadEvent: @config.continueThreadEvent\n          showActions: @config.showActions\n          className: @config.className\n          type: reply-tree\n        })\n      ReplyTreeLoaded -> idle\n        (render-ui main {\n          nodes: @payload.data\n          maxDepth: @config.maxDepth\n          onVote: @config.onVote\n          onReply: @config.onReply\n          onFlag: @config.onFlag\n          onContinueThread: @config.onContinueThread\n          voteEvent: @config.voteEvent\n          replyEvent: @config.replyEvent\n          flagEvent: @config.flagEvent\n          continueThreadEvent: @config.continueThreadEvent\n          showActions: @config.showActions\n          className: @config.className\n          type: reply-tree\n        })\n    }\n\n    emits {\n      @config.onVote -> external {\n        nodeId : string\n        vote : string\n      }\n        @description \"onVote prop\"\n        @tier \"essential\"\n      @config.onReply -> external {\n        parentNodeId : string\n        content : string!\n      }\n        @description \"onReply prop\"\n        @tier \"essential\"\n      @config.onFlag -> external {\n        nodeId : string\n      }\n        @description \"onFlag prop\"\n        @tier \"essential\"\n      @config.onContinueThread -> external {\n        nodeId : string\n      }\n        @description \"onContinueThread prop\"\n        @tier \"essential\"\n      ReplyTreeLoaded\n        @description \"ReplyTree rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      maxDepth : number = 6\n        @label \"Max Depth\"\n        @description \"maxDepth prop\"\n        @tier \"presentation\"\n      onVote : event = \"VOTE\"\n        @label \"On Vote\"\n        @description \"onVote prop\"\n        @tier \"presentation\"\n      onReply : event = \"REPLY\"\n        @label \"On Reply\"\n        @description \"onReply prop\"\n        @tier \"presentation\"\n      onFlag : event = \"FLAG\"\n        @label \"On Flag\"\n        @description \"onFlag prop\"\n        @tier \"presentation\"\n      onContinueThread : event = \"CONTINUE_THREAD\"\n        @label \"On Continue Thread\"\n        @description \"onContinueThread prop\"\n        @tier \"presentation\"\n      voteEvent : event = \"VOTE\"\n        @label \"Vote Event\"\n        @description \"voteEvent prop\"\n        @tier \"presentation\"\n      replyEvent : event = \"REPLY\"\n        @label \"Reply Event\"\n        @description \"replyEvent prop\"\n        @tier \"presentation\"\n      flagEvent : event = \"FLAG\"\n        @label \"Flag Event\"\n        @description \"flagEvent prop\"\n        @tier \"presentation\"\n      continueThreadEvent : event = \"CONTINUE_THREAD\"\n        @label \"Continue Thread Event\"\n        @description \"continueThreadEvent prop\"\n        @tier \"presentation\"\n      showActions : boolean = true\n        @label \"Show Actions\"\n        @description \"showActions prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      selfFetch : boolean = true\n        @label \"Fetch its own rows on mount?\"\n        @description \"true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/reply-tree\" as ReplyTreePage -> ReplyTreeRender\n}\n"
}