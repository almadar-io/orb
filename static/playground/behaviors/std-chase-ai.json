  "source": "",
  "lolo": "app std-chase-ai \"1.0.0\"\n\"Headless chase-AI mechanic: enemies damage adjacent targets, else step toward the nearest target respecting tile passability and occupancy.\"\norbital ChaseAiOrbital {\n  type Unit = {\n    id : string!\n    position : { x : number!  y : number! }\n    x : number\n    y : number\n    z : number\n    team : string\n    health : number\n    maxHealth : number\n    unitType : string\n  }\n  type Tile = {\n    id : string\n    x : number!\n    y : number!\n    passable : boolean\n  }\n  type Fx = {\n    id : string!\n    type : string!\n    x : number!\n    z : number\n    y : number\n    message : string\n    ttl : number!\n  }\n\n  entity ChaseState [runtime, shared] {\n    id : string!\n    units : [Unit]\n  }\n\n  trait ChaseAi -> @rebindable ChaseState [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.units @config.units)\n    }\n\n    ticks {\n      chaseTick every 1s\n        when @config.running\n        (emit BURST { particles: (array/map (array/filter @entity.units (fn u (and (and (== @u.team \"player\") (> @u.health 0)) (> (array/len (array/filter @entity.units (fn e (and (and (== @e.team \"enemy\") (> @e.health 0)) (== (grid/manhattan-distance (object/get @e position) (object/get @u position)) 1))))) 0)))) (fn u { id: (str/concat \"fx-ai-\" @u.id), type: \"hit\", x: (object/get (object/get @u position) x), z: (object/get (object/get @u position) y), message: \"-1\", ttl: 3 })) })\n        (set @entity.units (array/map @entity.units (fn u (if (and (== @u.team \"player\") (> @u.health 0)) (if (> (array/len (array/filter @entity.units (fn e (and (and (== @e.team \"enemy\") (> @e.health 0)) (== (grid/manhattan-distance (object/get @e position) (object/get @u position)) 1))))) 0) (object/merge @u { health: (math/max 0 (- @u.health 1)) }) @u) @u))))\n        (set @entity.units (array/map @entity.units (fn u (if (and (== @u.team \"enemy\") (> @u.health 0)) (if (== (array/len (array/filter @entity.units (fn p (and (and (== @p.team \"player\") (> @p.health 0)) (== (grid/manhattan-distance (object/get @u position) (object/get @p position)) 1))))) 0) (let ((target (array/reduce (array/filter @entity.units (fn p (and (== @p.team \"player\") (> @p.health 0)))) null (fn nearest p (if (or (== @nearest null) (< (grid/manhattan-distance (object/get @p position) (object/get @u position)) (grid/manhattan-distance (object/get @nearest position) (object/get @u position)))) @p @nearest))))) (if (== @target null) @u (let ((nextX (math/clamp (+ (object/get (object/get @u position) x) (math/sign (- (object/get (object/get @target position) x) (object/get (object/get @u position) x)))) 0 (- @config.gridWidth 1))) (nextY (math/clamp (+ (object/get (object/get @u position) y) (math/sign (- (object/get (object/get @target position) y) (object/get (object/get @u position) y)))) 0 (- @config.gridHeight 1)))) (if (and (grid/in-bounds { x: @nextX, y: @nextY } @config.gridWidth @config.gridHeight) (and (== (object/get (array/find @config.tiles (fn t (and (== (object/get @t x) @nextX) (== (object/get @t y) @nextY)))) passable) true) (== (array/len (array/filter @entity.units (fn o (and (!= @o.id @u.id) (and (> @o.health 0) (and (== (object/get (object/get @o position) x) @nextX) (== (object/get (object/get @o position) y) @nextY))))))) 0))) (object/merge @u { position: { x: @nextX, y: @nextY } }) @u)))) @u) @u))))\n        (emit UNITS_CHANGED { playersAlive: (array/len (array/filter @entity.units (fn u (and (== @u.team \"player\") (> @u.health 0))))), enemiesAlive: (array/len (array/filter @entity.units (fn u (and (== @u.team \"enemy\") (> @u.health 0))))) })\n    }\n\n    emits {\n      BURST -> external {\n        particles : [Fx]\n      }\n        @description \"Fired each tick a target takes adjacency damage, carrying summarized hit particles\"\n        @tier \"domain\"\n      UNITS_CHANGED -> external {\n        playersAlive : number\n        enemiesAlive : number\n      }\n        @description \"Live team survivor counts after this tick's combat; a round-flow listener decides win/lose\"\n        @tier \"domain\"\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true the chase tick runs; toggle to freeze the mechanic\"\n        @tier \"domain\"\n      units : [Unit] = []\n        @label \"Initial Units\"\n        @description \"Seed units (players and enemies) present before the first tick\"\n        @tier \"domain\"\n      tiles : [Tile] = []\n        @label \"Initial Tiles\"\n        @description \"Seed grid tiles used for passability checks during movement\"\n        @tier \"presentation\"\n      gridWidth : number = 12\n        @label \"Grid Width\"\n        @description \"Grid column count clamping enemy movement bounds\"\n        @tier \"presentation\"\n      gridHeight : number = 12\n        @label \"Grid Height\"\n        @description \"Grid row count clamping enemy movement bounds\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/chase-ai\" as ChaseAiPage -> ChaseAi\n}\n"
}