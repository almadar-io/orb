{
  "name": "std-algo-slidingwindow",
  "description": "Sliding-window engine — one fixed-size window slide per tick tracking the max-sum window on algorithm-canvas; composed via `uses`.",
  "level": "atom",
  "topic": "ui/learning",
  "schema": {
    "name": "std-algo-slidingwindow",
    "version": "1.0.0",
    "description": "Sliding-window engine — one fixed-size window slide per tick tracking the max-sum window on algorithm-canvas; composed via `uses`.",
    "orbitals": [
      {
        "name": "SlidingWindowEngineOrbital",
        "entity": {
          "name": "SlidingWindowScene",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "bars",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "name": "value",
                    "type": "number",
                    "required": true
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  }
                }
              }
            },
            {
              "name": "pointers",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
                  "index": {
                    "name": "index",
                    "type": "number",
                    "required": true
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  }
                }
              }
            },
            {
              "name": "l",
              "type": "number",
              "default": 0
            },
            {
              "name": "r",
              "type": "number",
              "default": 0
            },
            {
              "name": "bestL",
              "type": "number",
              "default": 0
            },
            {
              "name": "bestSum",
              "type": "number",
              "default": 0
            },
            {
              "name": "winSum",
              "type": "number",
              "default": 0
            },
            {
              "name": "done",
              "type": "boolean",
              "default": false
            },
            {
              "name": "running",
              "type": "boolean",
              "default": true
            }
          ]
        },
        "traits": [
          {
            "name": "SlidingWindowSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "bars",
                "bestL",
                "bestSum",
                "done",
                "l",
                "pointers",
                "r",
                "running",
                "winSum"
              ]
            },
            "category": "interaction",
            "linkedEntity": "SlidingWindowScene",
            "emits": [
              {
                "event": "WINDOW_UPDATED",
                "description": "The current bars + window L/R cursors each step — a composed listener (a mirror canvas, a readout) can subscribe; a harmless no-op standalone.",
                "synonyms": "tick, frame, step, slide, window, max",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "bars",
                    "type": "[AlgoBar]"
                  },
                  {
                    "name": "pointers",
                    "type": "[AlgoPointer]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "WINDOW_UPDATED",
                  "name": "Window Updated",
                  "description": "The current bars + window L/R cursors each step — a composed listener (a mirror canvas, a readout) can subscribe; a harmless no-op standalone.",
                  "synonyms": "tick, frame, step, slide, window, max",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "bars",
                      "type": "[AlgoBar]"
                    },
                    {
                      "name": "pointers",
                      "type": "[AlgoPointer]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.bars",
                      [
                        {
                          "value": 3,
                          "color": "#3b82f6",
                          "label": "3"
                        },
                        {
                          "color": "#3b82f6",
                          "label": "1",
                          "value": 1
                        },
                        {
                          "label": "4",
                          "color": "#3b82f6",
                          "value": 4
                        },
                        {
                          "label": "1",
                          "color": "#3b82f6",
                          "value": 1
                        },
                        {
                          "color": "#3b82f6",
                          "label": "5",
                          "value": 5
                        },
                        {
                          "label": "9",
                          "value": 9,
                          "color": "#3b82f6"
                        },
                        {
                          "label": "2",
                          "color": "#3b82f6",
                          "value": 2
                        },
                        {
                          "color": "#3b82f6",
                          "label": "6",
                          "value": 6
                        },
                        {
                          "value": 5,
                          "color": "#3b82f6",
                          "label": "5"
                        },
                        {
                          "color": "#3b82f6",
                          "label": "3",
                          "value": 3
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.l",
                      0
                    ],
                    [
                      "set",
                      "@entity.bestL",
                      0
                    ],
                    [
                      "set",
                      "@entity.bestSum",
                      [
                        "array/sum",
                        [
                          "array/slice",
                          [
                            {
                              "value": 3,
                              "color": "#3b82f6",
                              "label": "3"
                            },
                            {
                              "color": "#3b82f6",
                              "label": "1",
                              "value": 1
                            },
                            {
                              "label": "4",
                              "color": "#3b82f6",
                              "value": 4
                            },
                            {
                              "label": "1",
                              "color": "#3b82f6",
                              "value": 1
                            },
                            {
                              "color": "#3b82f6",
                              "label": "5",
                              "value": 5
                            },
                            {
                              "label": "9",
                              "value": 9,
                              "color": "#3b82f6"
                            },
                            {
                              "label": "2",
                              "color": "#3b82f6",
                              "value": 2
                            },
                            {
                              "color": "#3b82f6",
                              "label": "6",
                              "value": 6
                            },
                            {
                              "value": 5,
                              "color": "#3b82f6",
                              "label": "5"
                            },
                            {
                              "color": "#3b82f6",
                              "label": "3",
                              "value": 3
                            }
                          ],
                          0,
                          3
                        ],
                        "value"
                      ]
                    ],
                    [
                      "set",
                      "@entity.r",
                      [
                        "-",
                        3,
                        1
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "set",
                      "@entity.pointers",
                      [
                        {
                          "label": "L",
                          "index": "@entity.l",
                          "color": "#f59e0b"
                        },
                        {
                          "index": "@entity.r",
                          "label": "R",
                          "color": "#f59e0b"
                        }
                      ]
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "width": 600,
                        "backgroundColor": "#f8fafc",
                        "bars": "@entity.bars",
                        "height": 400,
                        "type": "algorithm-canvas",
                        "pointers": "@entity.pointers"
                      }
                    ],
                    [
                      "emit",
                      "WINDOW_UPDATED",
                      {
                        "pointers": "@entity.pointers",
                        "bars": "@entity.bars"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "windowTick",
                "interval": 350,
                "guard": [
                  "and",
                  "@entity.running",
                  [
                    "not",
                    "@entity.done"
                  ]
                ],
                "effects": [
                  [
                    "set",
                    "@entity.l",
                    [
                      "+",
                      "@entity.l",
                      1
                    ]
                  ],
                  [
                    "set",
                    "@entity.winSum",
                    [
                      "array/sum",
                      [
                        "array/slice",
                        "@entity.bars",
                        "@entity.l",
                        [
                          "+",
                          "@entity.l",
                          3
                        ]
                      ],
                      "value"
                    ]
                  ],
                  [
                    "set",
                    "@entity.bestL",
                    [
                      "if",
                      [
                        ">",
                        "@entity.winSum",
                        "@entity.bestSum"
                      ],
                      "@entity.l",
                      "@entity.bestL"
                    ]
                  ],
                  [
                    "set",
                    "@entity.bestSum",
                    [
                      "if",
                      [
                        ">",
                        "@entity.winSum",
                        "@entity.bestSum"
                      ],
                      "@entity.winSum",
                      "@entity.bestSum"
                    ]
                  ],
                  [
                    "set",
                    "@entity.r",
                    [
                      "+",
                      "@entity.l",
                      [
                        "-",
                        3,
                        1
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.done",
                    [
                      ">=",
                      "@entity.l",
                      [
                        "-",
                        [
                          "array/len",
                          "@entity.bars"
                        ],
                        3
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.bars",
                    [
                      "array/map",
                      "@entity.bars",
                      [
                        "object/merge",
                        "@item",
                        {
                          "color": [
                            "if",
                            [
                              "and",
                              [
                                ">=",
                                "@index",
                                "@entity.bestL"
                              ],
                              [
                                "<",
                                "@index",
                                [
                                  "+",
                                  "@entity.bestL",
                                  3
                                ]
                              ]
                            ],
                            "#22c55e",
                            [
                              "if",
                              [
                                "and",
                                [
                                  ">=",
                                  "@index",
                                  "@entity.l"
                                ],
                                [
                                  "<",
                                  "@index",
                                  [
                                    "+",
                                    "@entity.l",
                                    3
                                  ]
                                ]
                              ],
                              "#f59e0b",
                              "#3b82f6"
                            ]
                          ]
                        }
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.pointers",
                    [
                      {
                        "label": "L",
                        "color": "#f59e0b",
                        "index": "@entity.l"
                      },
                      {
                        "color": "#f59e0b",
                        "index": "@entity.r",
                        "label": "R"
                      }
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "height": 400,
                      "backgroundColor": "#f8fafc",
                      "bars": "@entity.bars",
                      "pointers": "@entity.pointers",
                      "width": 600,
                      "type": "algorithm-canvas"
                    }
                  ],
                  [
                    "emit",
                    "WINDOW_UPDATED",
                    {
                      "bars": "@entity.bars",
                      "pointers": "@entity.pointers"
                    }
                  ]
                ]
              }
            ],
            "config": {
              "k": {
                "type": "number",
                "default": 3,
                "label": "Window Size",
                "description": "The fixed number of adjacent bars in each window.",
                "tier": "domain"
              },
              "width": {
                "type": "number",
                "default": 600,
                "label": "Width",
                "description": "Canvas width in pixels.",
                "tier": "presentation"
              },
              "bars": {
                "type": "[AlgoBar]",
                "default": [
                  {
                    "value": 3,
                    "color": "#3b82f6",
                    "label": "3"
                  },
                  {
                    "color": "#3b82f6",
                    "label": "1",
                    "value": 1
                  },
                  {
                    "label": "4",
                    "color": "#3b82f6",
                    "value": 4
                  },
                  {
                    "label": "1",
                    "color": "#3b82f6",
                    "value": 1
                  },
                  {
                    "color": "#3b82f6",
                    "label": "5",
                    "value": 5
                  },
                  {
                    "label": "9",
                    "value": 9,
                    "color": "#3b82f6"
                  },
                  {
                    "label": "2",
                    "color": "#3b82f6",
                    "value": 2
                  },
                  {
                    "color": "#3b82f6",
                    "label": "6",
                    "value": 6
                  },
                  {
                    "value": 5,
                    "color": "#3b82f6",
                    "label": "5"
                  },
                  {
                    "color": "#3b82f6",
                    "label": "3",
                    "value": 3
                  }
                ],
                "label": "Bars",
                "description": "Initial unsorted array; each bar's height is proportional to its value.",
                "tier": "domain",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "name": "label",
                      "type": "string",
                      "required": false
                    },
                    "color": {
                      "name": "color",
                      "type": "string",
                      "required": false
                    },
                    "value": {
                      "name": "value",
                      "type": "number",
                      "required": true
                    }
                  }
                }
              },
              "backgroundColor": {
                "type": "string",
                "default": "#f8fafc",
                "label": "Background Color",
                "description": "Canvas background color.",
                "tier": "presentation"
              },
              "height": {
                "type": "number",
                "default": 400,
                "label": "Height",
                "description": "Canvas height in pixels.",
                "tier": "presentation"
              },
              "running": {
                "type": "boolean",
                "default": true,
                "label": "Running",
                "description": "When true the tick slides the window one position; toggle to start/pause the scan.",
                "tier": "domain"
              }
            },
            "scope": "instance"
          }
        ],
        "pages": [
          {
            "name": "SlidingWindowEnginePage",
            "path": "/algo-slidingwindow",
            "traits": [
              {
                "ref": "SlidingWindowSim"
              }
            ]
          }
        ]
      }
    ],
    "_metadata": {
      "configProvenance": {
        "SlidingWindowEngineOrbital": [
          {
            "trait": "SlidingWindowSim",
            "patternPath": "root",
            "prop": "width",
            "knob": "width"
          },
          {
            "trait": "SlidingWindowSim",
            "patternPath": "root",
            "prop": "backgroundColor",
            "knob": "backgroundColor"
          },
          {
            "trait": "SlidingWindowSim",
            "patternPath": "root",
            "prop": "height",
