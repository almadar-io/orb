                    "value": 9
                  },
                  {
                    "value": 11,
                    "color": "#3b82f6",
                    "label": "11"
                  },
                  {
                    "color": "#3b82f6",
                    "label": "13",
                    "value": 13
                  },
                  {
                    "color": "#3b82f6",
                    "label": "15",
                    "value": 15
                  },
                  {
                    "value": 17,
                    "label": "17",
                    "color": "#3b82f6"
                  },
                  {
                    "color": "#3b82f6",
                    "label": "19",
                    "value": 19
                  }
                ],
                "label": "Bars",
                "description": "Initial sorted array; each bar's height is proportional to its value.",
                "tier": "domain",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "name": "value",
                      "type": "number",
                      "required": true
                    },
                    "color": {
                      "name": "color",
                      "type": "string",
                      "required": false
                    },
                    "label": {
                      "name": "label",
                      "type": "string",
                      "required": false
                    }
                  }
                }
              },
              "height": {
                "type": "number",
                "default": 400,
                "label": "Height",
                "description": "Canvas height in pixels.",
                "tier": "presentation"
              },
              "target": {
                "type": "number",
                "default": 15,
                "label": "Target",
                "description": "The value being searched for in the sorted array.",
                "tier": "domain"
              },
              "running": {
                "type": "boolean",
                "default": true,
                "label": "Running",
                "description": "When true the tick performs one narrowing step; toggle to start/pause the search.",
                "tier": "domain"
              },
              "width": {
                "type": "number",
                "default": 600,
                "label": "Width",
                "description": "Canvas width in pixels.",
                "tier": "presentation"
              },
              "backgroundColor": {
                "type": "string",
                "default": "#f8fafc",
                "label": "Background Color",
                "description": "Canvas background color.",
                "tier": "presentation"
              }
            },
            "scope": "instance"
          }
        ],
        "pages": [
          {
            "name": "BinarySearchEnginePage",
            "path": "/algo-binarysearch",
            "traits": [
              {
                "ref": "BinarySearchSim"
              }
            ]
          }
        ]
      }
    ],
    "_metadata": {
      "configProvenance": {
        "BinarySearchEngineOrbital": [
