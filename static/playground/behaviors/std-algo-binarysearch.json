{
  "name": "std-algo-binarysearch",
  "description": "Binary-search engine — one lo/hi/mid narrowing step per tick over a sorted bar array on algorithm-canvas; composed via `uses`.",
  "level": "atom",
  "topic": "ui/learning",
  "schema": {
    "name": "std-algo-binarysearch",
    "version": "1.0.0",
    "description": "Binary-search engine — one lo/hi/mid narrowing step per tick over a sorted bar array on algorithm-canvas; composed via `uses`.",
    "orbitals": [
      {
        "name": "BinarySearchEngineOrbital",
        "entity": {
          "name": "BinarySearchScene",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "bars",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
                  "value": {
                    "name": "value",
                    "type": "number",
                    "required": true
                  }
                }
              }
            },
            {
              "name": "pointers",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "index": {
                    "name": "index",
                    "type": "number",
                    "required": true
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  }
                }
              }
            },
            {
              "name": "lo",
              "type": "number",
              "default": 0
            },
            {
              "name": "hi",
              "type": "number",
              "default": 0
            },
            {
              "name": "mid",
              "type": "number",
              "default": 0
            },
            {
              "name": "cur",
              "type": "number",
              "default": 0
            },
            {
              "name": "found",
              "type": "boolean",
              "default": false
            },
            {
              "name": "done",
              "type": "boolean",
              "default": false
            },
            {
              "name": "running",
              "type": "boolean",
              "default": true
            }
          ]
        },
        "traits": [
          {
            "name": "BinarySearchSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "bars",
                "cur",
                "done",
                "found",
                "hi",
                "lo",
                "mid",
                "pointers",
                "running"
              ]
            },
            "category": "interaction",
            "linkedEntity": "BinarySearchScene",
            "emits": [
              {
                "event": "RANGE_UPDATED",
                "description": "The current bars + lo/hi/mid cursors each step — a composed listener (a mirror canvas, a readout) can subscribe; a harmless no-op standalone.",
                "synonyms": "tick, frame, step, narrow, compare, search",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "bars",
                    "type": "[AlgoBar]"
                  },
                  {
                    "name": "pointers",
                    "type": "[AlgoPointer]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "RANGE_UPDATED",
                  "name": "Range Updated",
                  "description": "The current bars + lo/hi/mid cursors each step — a composed listener (a mirror canvas, a readout) can subscribe; a harmless no-op standalone.",
                  "synonyms": "tick, frame, step, narrow, compare, search",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "bars",
                      "type": "[AlgoBar]"
                    },
                    {
                      "name": "pointers",
                      "type": "[AlgoPointer]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.bars",
                      [
                        {
                          "label": "1",
                          "color": "#3b82f6",
                          "value": 1
                        },
                        {
                          "value": 3,
                          "label": "3",
                          "color": "#3b82f6"
                        },
                        {
                          "label": "5",
                          "value": 5,
                          "color": "#3b82f6"
                        },
                        {
                          "label": "7",
                          "value": 7,
                          "color": "#3b82f6"
                        },
                        {
                          "color": "#3b82f6",
                          "label": "9",
                          "value": 9
                        },
                        {
                          "value": 11,
                          "color": "#3b82f6",
                          "label": "11"
                        },
                        {
                          "color": "#3b82f6",
                          "label": "13",
                          "value": 13
                        },
                        {
                          "color": "#3b82f6",
                          "label": "15",
                          "value": 15
                        },
                        {
                          "value": 17,
                          "label": "17",
                          "color": "#3b82f6"
                        },
                        {
                          "color": "#3b82f6",
                          "label": "19",
                          "value": 19
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.lo",
                      0
                    ],
                    [
                      "set",
                      "@entity.hi",
                      [
                        "-",
                        [
                          "array/len",
                          [
                            {
                              "label": "1",
                              "color": "#3b82f6",
                              "value": 1
                            },
                            {
                              "value": 3,
                              "label": "3",
                              "color": "#3b82f6"
                            },
                            {
                              "label": "5",
                              "value": 5,
                              "color": "#3b82f6"
                            },
                            {
                              "label": "7",
                              "value": 7,
                              "color": "#3b82f6"
                            },
                            {
                              "color": "#3b82f6",
                              "label": "9",
                              "value": 9
                            },
                            {
                              "value": 11,
                              "color": "#3b82f6",
                              "label": "11"
                            },
                            {
                              "color": "#3b82f6",
                              "label": "13",
                              "value": 13
                            },
                            {
                              "color": "#3b82f6",
                              "label": "15",
                              "value": 15
                            },
                            {
                              "value": 17,
                              "label": "17",
                              "color": "#3b82f6"
                            },
                            {
                              "color": "#3b82f6",
                              "label": "19",
                              "value": 19
                            }
                          ]
                        ],
                        1
                      ]
                    ],
                    [
                      "set",
                      "@entity.mid",
                      [
                        "math/floor",
                        [
                          "/",
                          [
                            "-",
                            [
                              "array/len",
                              [
                                {
                                  "label": "1",
                                  "color": "#3b82f6",
                                  "value": 1
                                },
                                {
                                  "value": 3,
                                  "label": "3",
                                  "color": "#3b82f6"
                                },
                                {
                                  "label": "5",
                                  "value": 5,
                                  "color": "#3b82f6"
                                },
                                {
                                  "label": "7",
                                  "value": 7,
                                  "color": "#3b82f6"
                                },
                                {
                                  "color": "#3b82f6",
                                  "label": "9",
                                  "value": 9
                                },
                                {
                                  "value": 11,
                                  "color": "#3b82f6",
                                  "label": "11"
                                },
                                {
                                  "color": "#3b82f6",
                                  "label": "13",
                                  "value": 13
                                },
                                {
                                  "color": "#3b82f6",
                                  "label": "15",
                                  "value": 15
                                },
                                {
                                  "value": 17,
                                  "label": "17",
                                  "color": "#3b82f6"
                                },
                                {
                                  "color": "#3b82f6",
                                  "label": "19",
                                  "value": 19
                                }
                              ]
                            ],
                            1
                          ],
                          2
                        ]
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "set",
                      "@entity.pointers",
                      [
                        {
                          "label": "lo",
                          "color": "#2563eb",
                          "index": "@entity.lo"
                        },
                        {
                          "index": "@entity.hi",
                          "label": "hi",
                          "color": "#dc2626"
                        },
                        {
                          "color": "#f59e0b",
                          "label": "mid",
                          "index": "@entity.mid"
                        }
                      ]
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "pointers": "@entity.pointers",
                        "backgroundColor": "#f8fafc",
                        "type": "algorithm-canvas",
                        "bars": "@entity.bars",
                        "height": 400,
                        "width": 600
                      }
                    ],
                    [
                      "emit",
                      "RANGE_UPDATED",
                      {
                        "bars": "@entity.bars",
                        "pointers": "@entity.pointers"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "binaryTick",
                "interval": 350,
                "guard": [
                  "and",
                  "@entity.running",
                  [
                    "not",
                    "@entity.done"
                  ]
                ],
                "effects": [
                  [
                    "set",
                    "@entity.cur",
                    [
                      "object/get",
                      [
                        "array/nth",
                        "@entity.bars",
                        "@entity.mid"
                      ],
                      "value"
                    ]
                  ],
                  [
                    "set",
                    "@entity.lo",
                    [
                      "if",
                      [
                        "<",
                        "@entity.cur",
                        15
                      ],
                      [
                        "+",
                        "@entity.mid",
                        1
                      ],
                      "@entity.lo"
                    ]
                  ],
                  [
                    "set",
                    "@entity.hi",
                    [
                      "if",
                      [
                        ">",
                        "@entity.cur",
                        15
                      ],
                      [
                        "-",
                        "@entity.mid",
                        1
                      ],
                      "@entity.hi"
                    ]
                  ],
                  [
                    "set",
                    "@entity.found",
                    [
                      "==",
                      "@entity.cur",
                      15
                    ]
                  ],
                  [
                    "set",
                    "@entity.done",
                    [
                      "or",
                      "@entity.found",
                      [
                        ">",
                        "@entity.lo",
                        "@entity.hi"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.mid",
                    [
                      "if",
                      "@entity.done",
                      "@entity.mid",
                      [
                        "math/floor",
                        [
                          "/",
                          [
                            "+",
                            "@entity.lo",
                            "@entity.hi"
                          ],
                          2
                        ]
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.bars",
                    [
                      "array/map",
                      "@entity.bars",
                      [
                        "object/merge",
                        "@item",
                        {
                          "color": [
                            "if",
                            [
                              "or",
                              [
                                "<",
                                "@index",
                                "@entity.lo"
                              ],
                              [
                                ">",
                                "@index",
                                "@entity.hi"
                              ]
                            ],
                            "#cbd5e1",
                            [
                              "if",
                              [
                                "==",
                                "@index",
                                "@entity.mid"
                              ],
                              [
                                "if",
                                "@entity.found",
                                "#22c55e",
                                "#f59e0b"
                              ],
                              "#3b82f6"
                            ]
                          ]
                        }
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.pointers",
                    [
                      {
                        "color": "#2563eb",
                        "index": "@entity.lo",
                        "label": "lo"
                      },
                      {
                        "index": "@entity.hi",
                        "label": "hi",
                        "color": "#dc2626"
                      },
                      {
                        "color": "#f59e0b",
                        "label": "mid",
                        "index": "@entity.mid"
                      }
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "bars": "@entity.bars",
                      "type": "algorithm-canvas",
                      "height": 400,
                      "backgroundColor": "#f8fafc",
                      "width": 600,
                      "pointers": "@entity.pointers"
                    }
                  ],
                  [
                    "emit",
                    "RANGE_UPDATED",
                    {
                      "pointers": "@entity.pointers",
                      "bars": "@entity.bars"
                    }
                  ]
                ]
              }
            ],
            "config": {
              "bars": {
                "type": "[AlgoBar]",
                "default": [
                  {
                    "label": "1",
                    "color": "#3b82f6",
                    "value": 1
                  },
                  {
                    "value": 3,
                    "label": "3",
                    "color": "#3b82f6"
                  },
                  {
                    "label": "5",
                    "value": 5,
