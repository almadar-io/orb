  "source": "",
  "lolo": "app ui-accordion \"1.0.0\"\n\"Accordion — UI factory (1:1 with the @almadar/ui accordion pattern).\"\norbital AccordionOrbital {\n  type AccordionItemsItem = {\n    id : string\n    header : node\n    title : node\n    content : node!\n    disabled : boolean\n    defaultOpen : boolean\n  }\n\n  entity AccordionItem [runtime] {\n    id : string!\n  }\n\n  trait AccordionRender -> @rebindable AccordionItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          items: @config.items\n          multiple: @config.multiple\n          defaultOpenItems: @config.defaultOpenItems\n          defaultOpen: @config.defaultOpen\n          openItems: @config.openItems\n          onItemToggle: @config.onItemToggle\n          className: @config.className\n          toggleEvent: @config.toggleEvent\n          type: accordion\n        })\n    }\n\n    emits {\n      @config.onItemToggle -> external {\n        itemId : string\n        isOpen : boolean\n      }\n        @description \"Callback when item opens/closes\"\n        @tier \"essential\"\n      @config.toggleEvent -> external {\n        itemId : string!\n        isOpen : boolean!\n      }\n        @description \"Declarative toggle event — emits UI:{toggleEvent} with { itemId, isOpen }\"\n        @tier \"essential\"\n    }\n\n    config {\n      items : [AccordionItemsItem] = [{ id: \"Id\", header: \"Header\", title: \"Title\", content: \"Content\", disabled: false, defaultOpen: false }, { id: \"Id 2\", header: \"Header 2\", title: \"Title 2\", content: \"Content 2\", disabled: true, defaultOpen: true }]\n        @label \"Items\"\n        @description \"Accordion items\"\n        @tier \"presentation\"\n      multiple : boolean = false\n        @label \"Multiple\"\n        @description \"Allow multiple items open at once\"\n        @tier \"presentation\"\n      defaultOpenItems : [string] = []\n        @label \"Default Open Items\"\n        @description \"Default open items (IDs)\"\n        @tier \"presentation\"\n      defaultOpen : [number] = []\n        @label \"Default Open\"\n        @description \"Default open items by index (pattern compatibility)\"\n        @tier \"presentation\"\n      openItems : [string] = []\n        @label \"Open Items\"\n        @description \"Controlled open items (IDs)\"\n        @tier \"presentation\"\n      onItemToggle : event = \"ITEM_TOGGLE\"\n        @label \"On Item Toggle\"\n        @description \"Callback when item opens/closes\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      toggleEvent : event = \"TOGGLE\"\n        @label \"Toggle Event\"\n        @description \"Declarative toggle event — emits UI:{toggleEvent} with { itemId, isOpen }\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/accordion\" as AccordionPage -> AccordionRender\n}\n"
}