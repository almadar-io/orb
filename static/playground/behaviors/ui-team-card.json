  "source": "",
  "lolo": "app ui-team-card \"1.0.0\"\n\"TeamCard — UI factory (1:1 with the @almadar/ui team-card pattern).\"\norbital TeamCardOrbital {\n  entity TeamCardItem [runtime] {\n    id : string!\n  }\n\n  trait TeamCardRender -> @rebindable TeamCardItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          name: @config.name\n          nameAr: @config.nameAr\n          role: @config.role\n          bio: @config.bio\n          avatar: @config.avatar\n          className: @config.className\n          type: team-card\n        })\n    }\n\n    config {\n      name : string = \"\"\n        @label \"Name\"\n        @description \"name prop\"\n        @tier \"presentation\"\n      nameAr : string\n        @label \"Name Ar\"\n        @description \"nameAr prop\"\n        @tier \"presentation\"\n      role : string = \"\"\n        @label \"Role\"\n        @description \"role prop\"\n        @tier \"presentation\"\n      bio : string = \"\"\n        @label \"Bio\"\n        @description \"bio prop\"\n        @tier \"presentation\"\n      avatar : asset\n        @label \"Avatar\"\n        @description \"avatar prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/team-card\" as TeamCardPage -> TeamCardRender\n}\n"
}