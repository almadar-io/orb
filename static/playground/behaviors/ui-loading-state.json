  "source": "",
  "lolo": "app ui-loading-state \"1.0.0\"\n\"LoadingState — UI factory (1:1 with the @almadar/ui loading-state pattern).\"\norbital LoadingStateOrbital {\n  entity LoadingStateItem [runtime] {\n    id : string!\n  }\n\n  trait LoadingStateRender -> @rebindable LoadingStateItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          title: @config.title\n          message: @config.message\n          className: @config.className\n          fullPage: @config.fullPage\n          type: loading-state\n        })\n    }\n\n    config {\n      title : string\n        @label \"Title\"\n        @description \"title prop\"\n        @tier \"presentation\"\n      message : string\n        @label \"Message\"\n        @description \"message prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      fullPage : boolean = false\n        @label \"Full Page\"\n        @description \"Center over the whole viewport (fix: inset-0 overlay) instead of inline.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/loading-state\" as LoadingStatePage -> LoadingStateRender\n}\n"
}