  "source": "",
  "lolo": "app std-search \"1.0.0\"\n\"std-search — single primitive: search-input. Owns a SearchResult runtime entity; SEARCH persists @payload.searchTerm (matching SearchInput's emit shape) so cross-trait listeners can route it into data atoms (Browse REFETCH_QUERY).\"\norbital SearchResultOrbital {\n  entity SearchResult [runtime] {\n    id : string!\n    searchTerm : string @description \"The text entered by the user in the search field.\" @synonyms \"query, search term, input, text\"\n  }\n\n  trait SearchResultSearch -> @rebindable SearchResult [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          event: @config.event\n          placeholder: @config.placeholder\n          type: search-input\n        })\n      SEARCH -> idle\n        (set @entity.searchTerm ?searchTerm)\n        (render-ui main {\n          event: @config.event\n          placeholder: @config.placeholder\n          type: search-input\n        })\n    }\n\n    emits {\n      SEARCH -> external {\n        searchTerm : string!\n      }\n        @description \"Initiates a search operation based on the input term.\"\n        @synonyms \"query, lookup, find\"\n        @tier \"domain\"\n    }\n\n    listens {\n      SEARCH {\n        searchTerm : string!\n      }\n        @description \"A search query has been submitted and persisted.\"\n        @synonyms \"query, request, lookup\"\n        @tier \"domain\"\n    }\n\n    config {\n      placeholder : string = \"Search…\"\n        @label \"Placeholder text\"\n        @description \"Hint text shown inside the empty search input\"\n        @tier \"presentation\"\n      event : string = SEARCH\n        @label \"Search event\"\n        @description \"Event emitted when the user submits a query\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/searchresults/search\" as SearchResultSearchPage -> SearchResultSearch\n}\n"
}