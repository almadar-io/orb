  "source": "",
  "lolo": "app ui-tabbed-container \"1.0.0\"\n\"TabbedContainer — UI factory (1:1 with the @almadar/ui tabbed-container pattern).\"\norbital TabbedContainerOrbital {\n  type TabbedContainerTabsItem = {\n    id : string!\n    label : string!\n    content : node\n    sectionId : string\n    badge : string\n    disabled : boolean\n  }\n\n  entity TabbedContainerItem [runtime] {\n    id : string!\n  }\n\n  trait TabbedContainerRender -> @rebindable TabbedContainerItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          tabs: @config.tabs\n          defaultTab: @config.defaultTab\n          activeTab: @config.activeTab\n          onTabChange: @config.onTabChange\n          position: @config.position\n          className: @config.className\n          type: tabbed-container\n        })\n    }\n\n    emits {\n      @config.onTabChange -> external {\n        tabId : string\n      }\n        @description \"Callback when tab changes\"\n        @tier \"essential\"\n    }\n\n    config {\n      tabs : [TabbedContainerTabsItem] = [{ id: \"Id\", label: \"Label\", content: \"Content\", sectionId: \"Section Id\", badge: \"Badge\", disabled: false }, { id: \"Id 2\", label: \"Label 2\", content: \"Content 2\", sectionId: \"Section Id 2\", badge: \"Badge 2\", disabled: true }]\n        @label \"Tabs\"\n        @description \"Tab definitions\"\n        @tier \"presentation\"\n      defaultTab : string\n        @label \"Default Tab\"\n        @description \"Default active tab ID\"\n        @tier \"presentation\"\n      activeTab : string\n        @label \"Active Tab\"\n        @description \"Controlled active tab\"\n        @tier \"presentation\"\n      onTabChange : event = \"TAB_CHANGE\"\n        @label \"On Tab Change\"\n        @description \"Callback when tab changes\"\n        @tier \"presentation\"\n      position : \"top\" | \"left\" = top\n        @label \"Position\"\n        @description \"Tab position\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/tabbed-container\" as TabbedContainerPage -> TabbedContainerRender\n}\n"
}