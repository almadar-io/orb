  "source": "",
  "lolo": "app ui-marketing-stat-card \"1.0.0\"\n\"MarketingStatCard — a single number-highlight card pairing a large value with a label and trend delta. — UI factory (1:1 with the @almadar/ui marketing-stat-card pattern).\"\n;; @capabilities \"KPI card, metric tile, dashboard stat card, number card, big-number widget, stat highlight, key metric callout\"\norbital MarketingStatCardOrbital {\n  entity MarketingStatCardItem [runtime] {\n    id : string!\n  }\n\n  trait MarketingStatCardRender -> @rebindable MarketingStatCardItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          value: @config.value\n          label: @config.label\n          size: @config.size\n          className: @config.className\n          type: marketing-stat-card\n        })\n    }\n\n    config {\n      value : string = \"\"\n        @label \"Value\"\n        @description \"The stat value to display prominently\"\n        @tier \"presentation\"\n      label : string = \"\"\n        @label \"Label\"\n        @description \"Label describing the value\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Size of the value text\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/marketing-stat-card\" as MarketingStatCardPage -> MarketingStatCardRender\n}\n"
}