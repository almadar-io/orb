  "source": "",
  "lolo": "app std-hero-nav \"1.0.0\"\n\"Headless single-hero navigation authority: the SOLE writer of units + movesLeft on objective boards. Applies a budget-limited MOVE intent (steps the hero one tile, spends a move, emits HERO_STEPPED) and an optional WANDER intent (random step for neutral NPCs). Renders nothing.\"\norbital HeroNavOrbital {\n  type Unit = {\n    id : string!\n    position : { x : number!  y : number! }\n    x : number\n    y : number\n    z : number\n    team : string\n    health : number\n    maxHealth : number\n    unitType : string\n  }\n  type Tile = {\n    id : string\n    x : number!\n    y : number!\n    passable : boolean\n  }\n\n  entity HeroNavData [runtime, shared] {\n    id : string!\n    units : [Unit]\n    tiles : [Tile]\n    movesLeft : number = 0\n  }\n\n  trait HeroNav -> @rebindable HeroNavData [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.units @config.units)\n        (set @entity.tiles (if (> (array/len @config.tiles) 0) @config.tiles (array/flatten (array/map (array/range 0 @config.gridHeight) (fn gy (array/map (array/range 0 @config.gridWidth) (fn gx { id: (str/concat \"t-\" @gx \"-\" @gy), x: @gx, y: @gy, passable: true })))))))\n        (set @entity.movesLeft @config.moveBudget)\n\n      MOVE -> active when (and @config.running (> @entity.movesLeft 0))\n        (set @entity.units (array/map @entity.units (fn u (if (== @u.id @payload.unitId) (object/merge @u { position: { x: @payload.x, y: @payload.y } }) @u))))\n        (set @entity.movesLeft (- @entity.movesLeft 1))\n        (emit HERO_STEPPED { unitId: @payload.unitId, x: @payload.x, z: @payload.y, movesLeft: @entity.movesLeft })\n\n      WANDER -> active when @config.running\n        (set @entity.units (array/map @entity.units (fn u (if (== @u.team \"neutral\") (let ((cell (object/get @u position)) (dir (math/floor (* (math/random) 4)))) (let ((nc (if (== @dir 0) { x: (+ (object/get @cell x) 1), y: (object/get @cell y) } (if (== @dir 1) { x: (- (object/get @cell x) 1), y: (object/get @cell y) } (if (== @dir 2) { x: (object/get @cell x), y: (+ (object/get @cell y) 1) } { x: (object/get @cell x), y: (- (object/get @cell y) 1) }))))) (if (and (grid/in-bounds @nc @config.gridWidth @config.gridHeight) (and (== (object/get (array/find @entity.tiles (fn t (and (== (object/get @t x) (object/get @nc x)) (== (object/get @t y) (object/get @nc y))))) passable) true) (== (array/len (array/filter @entity.units (fn o (and (!= @o.id @u.id) (and (== (object/get (object/get @o position) x) (object/get @nc x)) (== (object/get (object/get @o position) y) (object/get @nc y))))))) 0))) (object/merge @u { position: @nc }) @u))) @u))))\n\n      RESTART -> active\n        (set @entity.units @config.units)\n        (set @entity.movesLeft @config.moveBudget)\n    }\n\n    emits {\n      HERO_STEPPED -> external {\n        unitId : string!\n        x : number!\n        z : number!\n        movesLeft : number!\n      }\n        @description \"Hero moved onto tile (x,z) with movesLeft remaining; objective mechanics listen to score progress and round-flow to decide win/lose\"\n        @tier \"domain\"\n    }\n\n    listens {\n      MOVE { unitId : string, x : number, y : number }\n      WANDER { tick : number }\n      RESTART { id : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, MOVE/WANDER intents are applied; toggle to freeze the board\"\n        @tier \"domain\"\n      units : [Unit] = []\n        @label \"Initial Units\"\n        @description \"Seed roster: the player hero plus any neutral NPCs\"\n        @tier \"domain\"\n      tiles : [Tile] = []\n        @label \"Tiles\"\n        @description \"Grid tiles used for passability checks (auto-generated all-passable when empty)\"\n        @tier \"presentation\"\n      gridWidth : number = 12\n        @label \"Grid Width\"\n        @description \"Grid column count clamping move + wander bounds\"\n        @tier \"presentation\"\n      gridHeight : number = 12\n        @label \"Grid Height\"\n        @description \"Grid row count clamping move + wander bounds\"\n        @tier \"presentation\"\n      moveBudget : number = 45\n        @label \"Move Budget\"\n        @description \"Moves the hero may spend before the round is lost if objectives remain\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/hero-nav\" as HeroNavPage -> HeroNav\n}\n"
}