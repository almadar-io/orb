  "source": "",
  "lolo": "app ui-trend-indicator \"1.0.0\"\n\"TrendIndicator — UI factory (1:1 with the @almadar/ui trend-indicator pattern).\"\norbital TrendIndicatorOrbital {\n  entity TrendIndicatorItem [runtime] {\n    id : string!\n  }\n\n  trait TrendIndicatorRender -> @rebindable TrendIndicatorItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          value: @config.value\n          direction: @config.direction\n          showValue: @config.showValue\n          invert: @config.invert\n          label: @config.label\n          size: @config.size\n          type: trend-indicator\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes applied to the root element.\"\n        @tier \"presentation\"\n      value : number\n        @label \"Value\"\n        @description \"Numeric value to display (e.g., 12.5 for +12.5%)\"\n        @tier \"presentation\"\n      direction : \"up\" | \"down\" | \"flat\" = up\n        @label \"Direction\"\n        @description \"Override automatic direction detection (positive=up, negative=down, zero=flat)\"\n        @tier \"presentation\"\n      showValue : boolean = true\n        @label \"Show Value\"\n        @description \"Show the formatted value text next to the arrow\"\n        @tier \"presentation\"\n      invert : boolean = false\n        @label \"Invert\"\n        @description \"Invert color logic (for metrics where down is good, e.g., error rate, bounce rate)\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Accessible label override\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Size of the indicator\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/trend-indicator\" as TrendIndicatorPage -> TrendIndicatorRender\n}\n"
}