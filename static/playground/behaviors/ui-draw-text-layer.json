  "source": "",
  "lolo": "app ui-draw-text-layer \"1.0.0\"\n\"DrawTextLayer — UI factory (1:1 with the @almadar/ui draw-text-layer pattern).\"\norbital DrawTextLayerOrbital {\n  type DrawTextLayerItemsItem = {\n    type : json!\n    text : string!\n    position : DrawTextLayerItemsItemPosition!\n    anchor : object\n    offsetX : number\n    offsetY : number\n    color : string!\n    font : string\n    align : \"center\" | \"end\" | \"left\" | \"right\" | \"start\"\n    baseline : \"alphabetic\" | \"bottom\" | \"hanging\" | \"ideographic\" | \"middle\" | \"top\"\n    opacity : number\n  }\n  type DrawTextLayerItemsItemPosition = {\n    x : number!\n    y : number!\n    z : number\n  }\n\n  entity DrawTextLayerItem [runtime] {\n    id : string!\n  }\n\n  trait DrawTextLayerRender -> @rebindable DrawTextLayerItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          items: @config.items\n          type: draw-text-layer\n        })\n    }\n\n    config {\n      items : [DrawTextLayerItemsItem] = [{ type: \"Type\", text: \"Text\", position: { x: 1, y: 1, z: 1 }, offsetX: 1, offsetY: 1, color: \"Color\", font: \"Font\", align: center, baseline: alphabetic, opacity: 1 }, { type: \"Type 2\", text: \"Text 2\", position: { x: 2, y: 2, z: 2 }, offsetX: 2, offsetY: 2, color: \"Color 2\", font: \"Font 2\", align: end, baseline: bottom, opacity: 2 }]\n        @label \"Items\"\n        @description \"items prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/draw-text-layer\" as DrawTextLayerPage -> DrawTextLayerRender\n}\n"
}