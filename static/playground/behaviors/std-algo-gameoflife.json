            "ticks": [
              {
                "name": "lifeTick",
                "interval": 500,
                "guard": "@entity.running",
                "effects": [
                  [
                    "set",
                    "@entity.cells",
                    [
                      "array/map",
                      "@entity.cells",
                      [
                        "let",
                        [
                          [
                            "r",
                            [
                              "object/get",
                              "@item",
                              "row"
                            ]
                          ],
                          [
                            "c",
                            [
                              "object/get",
                              "@item",
                              "col"
                            ]
                          ],
                          [
                            "self",
                            [
                              "object/get",
                              "@item",
                              "value"
                            ]
                          ]
                        ],
                        [
                          "let",
                          [
                            [
                              "live",
                              [
                                "array/len",
                                [
                                  "array/filter",
                                  "@entity.cells",
                                  [
                                    "and",
                                    [
                                      "<=",
                                      [
                                        "math/abs",
                                        [
                                          "-",
                                          [
                                            "object/get",
                                            "@item",
                                            "row"
                                          ],
                                          "@r"
                                        ]
                                      ],
                                      1
                                    ],
                                    [
                                      "and",
                                      [
                                        "<=",
                                        [
                                          "math/abs",
                                          [
                                            "-",
                                            [
                                              "object/get",
                                              "@item",
                                              "col"
                                            ],
                                            "@c"
                                          ]
                                        ],
                                        1
                                      ],
                                      [
                                        "and",
                                        [
                                          "==",
                                          [
                                            "object/get",
                                            "@item",
                                            "value"
                                          ],
                                          1
                                        ],
                                        [
                                          "not",
                                          [
                                            "and",
                                            [
                                              "==",
                                              [
                                                "object/get",
                                                "@item",
                                                "row"
                                              ],
                                              "@r"
                                            ],
                                            [
                                              "==",
                                              [
                                                "object/get",
                                                "@item",
                                                "col"
                                              ],
                                              "@c"
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "next",
                                [
                                  "if",
                                  [
                                    "==",
                                    "@self",
                                    1
                                  ],
                                  [
                                    "if",
                                    [
                                      "or",
                                      [
                                        "==",
                                        "@live",
                                        2
                                      ],
                                      [
                                        "==",
                                        "@live",
                                        3
                                      ]
                                    ],
                                    1,
                                    0
                                  ],
                                  [
                                    "if",
                                    [
                                      "==",
                                      "@live",
                                      3
                                    ],
                                    1,
                                    0
                                  ]
                                ]
                              ]
                            ],
                            [
                              "object/merge",
                              "@item",
                              {
                                "value": "@next",
                                "color": [
                                  "if",
                                  [
                                    "==",
                                    "@next",
                                    1
                                  ],
                                  "#22c55e",
                                  "#1e293b"
                                ]
                              }
                            ]
                          ]
                        ]
                      ]
