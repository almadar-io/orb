  "source": "",
  "lolo": "app ui-tabs \"1.0.0\"\n\"Tabs — UI factory (1:1 with the @almadar/ui tabs pattern).\"\norbital TabsOrbital {\n  type TabsItemsItem = {\n    id : string\n    value : string\n    label : string!\n    content : node\n    icon : icon\n    iconAsset : TabsItemsItemIconAsset\n    badge : string\n    disabled : boolean\n    event : event\n    active : boolean\n  }\n  type TabsItemsItemIconAsset = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n  type TabsTabsItem = {\n    id : string\n    value : string\n    label : string!\n    content : node\n    icon : icon\n    iconAsset : TabsTabsItemIconAsset\n    badge : string\n    disabled : boolean\n    event : event\n    active : boolean\n  }\n  type TabsTabsItemIconAsset = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n\n  entity TabsItem [runtime] {\n    id : string!\n  }\n\n  trait TabsRender -> @rebindable TabsItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          items: @config.items\n          tabs: @config.tabs\n          defaultActiveTab: @config.defaultActiveTab\n          activeTab: @config.activeTab\n          onTabChange: @config.onTabChange\n          tabChangeEvent: @config.tabChangeEvent\n          variant: @config.variant\n          orientation: @config.orientation\n          className: @config.className\n          type: tabs\n        })\n    }\n\n    emits {\n      @config.onTabChange -> external {\n        tabId : string\n      }\n        @description \"Callback when tab changes\"\n        @tier \"essential\"\n    }\n\n    config {\n      items : [TabsItemsItem] = []\n        @label \"Items\"\n        @description \"Tab items\"\n        @tier \"presentation\"\n      tabs : [TabsTabsItem] = []\n        @label \"Tabs\"\n        @description \"Tab items (alias for items - used by generated code)\"\n        @tier \"presentation\"\n      defaultActiveTab : string\n        @label \"Default Active Tab\"\n        @description \"Default active tab ID\"\n        @tier \"presentation\"\n      activeTab : string\n        @label \"Active Tab\"\n        @description \"Controlled active tab ID\"\n        @tier \"presentation\"\n      onTabChange : event = \"TAB_CHANGE\"\n        @label \"On Tab Change\"\n        @description \"Callback when tab changes\"\n        @tier \"presentation\"\n      tabChangeEvent : event = \"TAB_CHANGE\"\n        @label \"Tab Change Event\"\n        @description \"Declarative tab change event — emits UI:{tabChangeEvent} with { tabId }\"\n        @tier \"presentation\"\n      variant : \"default\" | \"pills\" | \"underline\" = default\n        @label \"Variant\"\n        @description \"Tab variant\"\n        @tier \"presentation\"\n      orientation : \"horizontal\" | \"vertical\" = horizontal\n        @label \"Orientation\"\n        @description \"Tab orientation\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/tabs\" as TabsPage -> TabsRender\n}\n"
}