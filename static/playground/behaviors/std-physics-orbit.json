  "level": "atom",
  "topic": "ui/learning",
  "schema": {
    "name": "std-physics-orbit",
    "version": "1.0.0",
    "description": "Orbital-motion engine — integrates bodies under inverse-square gravity toward a fixed central mass every tick and renders a physics-canvas via `uses`.",
    "orbitals": [
      {
        "name": "OrbitEngineOrbital",
        "entity": {
          "name": "OrbitState",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "bodies",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "name": "id",
                    "type": "string",
                    "required": false
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
                  "fx": {
                    "name": "fx",
                    "type": "number",
                    "required": false
                  },
                  "radius": {
                    "name": "radius",
                    "type": "number",
                    "required": false
                  },
                  "vx": {
                    "name": "vx",
                    "type": "number",
                    "required": false
                  },
                  "vy": {
                    "name": "vy",
                    "type": "number",
                    "required": false
                  },
                  "x": {
                    "name": "x",
                    "type": "number",
                    "required": true
                  },
                  "y": {
                    "name": "y",
                    "type": "number",
                    "required": true
                  },
                  "fy": {
                    "name": "fy",
                    "type": "number",
                    "required": false
                  }
                }
              }
            },
            {
              "name": "running",
              "type": "boolean",
              "default": false
            }
          ]
        },
        "traits": [
          {
            "name": "OrbitSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "bodies",
                "running"
              ]
            },
            "category": "interaction",
            "linkedEntity": "OrbitState",
            "emits": [
              {
                "event": "BODIES_UPDATED",
                "description": "The current scene each tick — a composed listener (graph, readout, mirror canvas) can subscribe; a harmless no-op when the atom runs standalone.",
                "synonyms": "tick, frame, step, redraw",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "bodies",
                    "type": "[OrbitBody]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "BODIES_UPDATED",
                  "name": "Bodies Updated",
                  "description": "The current scene each tick — a composed listener (graph, readout, mirror canvas) can subscribe; a harmless no-op when the atom runs standalone.",
                  "synonyms": "tick, frame, step, redraw",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "bodies",
                      "type": "[OrbitBody]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.bodies",
                      [
                        {
                          "radius": 20,
                          "label": "",
                          "vx": 0,
                          "color": "#f59e0b",
                          "fx": 0,
                          "x": 300,
                          "vy": 0,
                          "y": 200,
                          "id": "sun",
                          "fy": 0
                        },
                        {
                          "color": "#2563eb",
                          "vy": 0,
                          "label": "",
                          "id": "planet-a",
                          "radius": 10,
                          "x": 300,
                          "fx": 0,
                          "fy": 0,
                          "vx": 2.24,
                          "y": 80
                        },
                        {
                          "vx": 0,
                          "vy": 1.88,
                          "label": "",
                          "id": "planet-b",
                          "x": 470,
                          "radius": 8,
                          "y": 200,
                          "color": "#16a34a",
                          "fx": 0,
                          "fy": 0
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "height": 400,
                        "backgroundColor": "#f8fafc",
                        "type": "physics-canvas",
                        "velocityScale": 14,
                        "showForces": false,
                        "bodies": "@entity.bodies",
                        "showVelocity": true,
                        "width": 600
                      }
                    ],
                    [
                      "emit",
                      "BODIES_UPDATED",
                      {
                        "bodies": "@entity.bodies"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "orbitTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "set",
                    "@entity.bodies",
                    [
                      "array/map",
                      "@entity.bodies",
                      [
                        "fn",
                        "b",
                        [
                          "if",
                          [
                            "=",
                            [
                              "object/get",
                              "@b",
                              "id"
                            ],
                            "sun"
                          ],
                          "@b",
                          [
                            "let",
                            [
                              [
                                "dx",
                                [
                                  "-",
                                  300,
                                  [
                                    "object/get",
                                    "@b",
                                    "x"
                                  ]
                                ]
                              ],
                              [
                                "dy",
                                [
                                  "-",
                                  200,
                                  [
                                    "object/get",
                                    "@b",
                                    "y"
                                  ]
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "dist",
                                  [
                                    "math/sqrt",
                                    [
                                      "+",
                                      [
                                        "*",
                                        "@dx",
                                        "@dx"
                                      ],
                                      [
                                        "*",
                                        "@dy",
                                        "@dy"
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "let",
                                [
                                  [
                                    "distSafe",
                                    [
                                      "math/max",
                                      "@dist",
                                      6
                                    ]
                                  ]
                                ],
                                [
                                  "let",
                                  [
                                    [
                                      "invCube",
                                      [
                                        "/",
                                        600,
                                        [
                                          "*",
                                          "@distSafe",
                                          [
                                            "*",
                                            "@distSafe",
                                            "@distSafe"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "let",
                                    [
                                      [
                                        "ax",
                                        [
                                          "*",
                                          "@invCube",
                                          "@dx"
                                        ]
                                      ],
                                      [
                                        "ay",
                                        [
                                          "*",
                                          "@invCube",
                                          "@dy"
                                        ]
                                      ]
                                    ],
                                    [
                                      "let",
                                      [
                                        [
                                          "nvx",
                                          [
                                            "+",
                                            [
                                              "object/get",
                                              "@b",
                                              "vx"
                                            ],
                                            "@ax"
                                          ]
                                        ],
                                        [
                                          "nvy",
                                          [
                                            "+",
                                            [
                                              "object/get",
                                              "@b",
                                              "vy"
                                            ],
                                            "@ay"
                                          ]
                                        ]
                                      ],
                                      [
                                        "let",
                                        [
                                          [
                                            "nx",
                                            [
                                              "+",
                                              [
                                                "object/get",
                                                "@b",
                                                "x"
                                              ],
                                              "@nvx"
                                            ]
                                          ],
                                          [
                                            "ny",
                                            [
                                              "+",
                                              [
                                                "object/get",
                                                "@b",
                                                "y"
                                              ],
                                              "@nvy"
                                            ]
                                          ]
                                        ],
                                        [
                                          "object/merge",
                                          "@b",
                                          {
                                            "x": "@nx",
                                            "y": "@ny",
                                            "vy": "@nvy",
                                            "vx": "@nvx"
                                          }
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "backgroundColor": "#f8fafc",
                      "height": 400,
                      "type": "physics-canvas",
                      "bodies": "@entity.bodies",
                      "showVelocity": true,
                      "velocityScale": 14,
                      "showForces": false,
                      "width": 600
                    }
                  ],
                  [
                    "emit",
                    "BODIES_UPDATED",
                    {
                      "bodies": "@entity.bodies"
                    }
                  ]
                ]
              }
            ],
            "config": {
              "bodies": {
                "type": "[OrbitBody]",
                "default": [
                  {
                    "radius": 20,
                    "label": "",
                    "vx": 0,
                    "color": "#f59e0b",
                    "fx": 0,
                    "x": 300,
                    "vy": 0,
                    "y": 200,
                    "id": "sun",
                    "fy": 0
                  },
                  {
                    "color": "#2563eb",
                    "vy": 0,
                    "label": "",
                    "id": "planet-a",
                    "radius": 10,
