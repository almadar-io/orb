  "source": "",
  "lolo": "app std-marketing-features \"1.0.0\"\n\"Feature grid atom for marketing pages. Renders a responsive grid of feature cards with icons, titles, descriptions, and optional links. Pick for product capability showcases and benefit sections.\"\n;; Config-driven feature grid using the `feature-grid` marketing pattern.\n;; Items are declared as an array of { icon, title, description, href, linkLabel } objects.\n;; The atom emits FEATURE_CLICK when a card with an href is clicked.\norbital FeatureItemOrbital {\n    type FeatureCard = { icon : string, title : string!, description : string!, href : string, linkLabel : string }\n\n  entity FeatureItem [runtime] {\n    id : string!\n  }\n\n  trait FeatureItemFeatures -> FeatureItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          columns: @config.columns\n          gap: @config.gap\n          items: @config.items\n          type: feature-grid\n        })\n      FEATURE_CLICK -> idle\n        (emit FEATURE_CLICK { id: ?id, title: ?title })\n    }\n\n    emits {\n      FEATURE_CLICK -> external {\n        id : string\n        title : string\n      }\n        @description \"A feature card was selected or activated.\"\n        @synonyms \"select, activate, tap, choose\"\n        @tier \"domain\"\n    }\n\n    listens {\n      FEATURE_CLICK {\n        id : string\n        title : string\n      }\n        @description \"A feature card was selected by the user.\"\n        @synonyms \"select, choose, tap\"\n        @tier \"domain\"\n    }\n\n    config {\n      items : [FeatureCard] = [{\n        description: \"Build and deploy in minutes, not months.\"\n        href: \"\"\n        icon: zap\n        linkLabel: \"Learn more\"\n        title: \"Lightning Fast\"\n      }, {\n        description: \"SOC-2 compliant with end-to-end encryption.\"\n        href: \"\"\n        icon: shield\n        linkLabel: \"Learn more\"\n        title: \"Enterprise Secure\"\n      }, {\n        description: \"Plug in any service, any data source, any UI pattern.\"\n        href: \"\"\n        icon: puzzle\n        linkLabel: \"Learn more\"\n        title: \"Infinitely Extensible\"\n      }]\n        @label \"Feature Items\"\n        @description \"Array of feature cards\"\n        @tier \"presentation\"\n      columns : number = 3\n        @label \"Columns\"\n        @description \"Number of grid columns\"\n        @tier \"presentation\"\n      gap : string = lg\n        @label \"Gap\"\n        @description \"Spacing between cards\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/features\" as FeatureItemFeaturesPage -> FeatureItemFeatures\n}\n"
}