  "source": "",
  "lolo": "app ui-hero-organism \"1.0.0\"\n\"HeroOrganism — UI factory (1:1 with the @almadar/ui hero-organism pattern).\"\norbital HeroOrganismOrbital {\n    type HeroOrganismLoaded = Event { data : [HeroOrganismItem] } \"HeroOrganism rows finished loading; payload.data holds the collection\"\n  type HeroOrganismError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type HeroOrganismPrimaryAction = {\n    label : string\n    href : string\n  }\n  type HeroOrganismSecondaryAction = {\n    label : string\n    href : string\n  }\n  type HeroOrganismImage = {\n    src : asset\n    alt : string\n  }\n\n  entity HeroOrganismItem [runtime] {\n    id : string!\n    title : string = \"Title\"\n    tag : string = \"Tag\"\n    titleAccent : string = \"Title Accent\"\n    subtitle : string = \"Subtitle\"\n    primaryAction : HeroOrganismPrimaryAction = { label: \"Label\", href: \"Href\" }\n    secondaryAction : HeroOrganismSecondaryAction = { label: \"Label\", href: \"Href\" }\n    installCommand : string = \"Install Command\"\n    image : HeroOrganismImage = { src: \"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png\", alt: \"Alt\" }\n    imagePosition : \"below\" | \"right\" | \"background\" = below\n    background : \"dark\" | \"gradient\" | \"subtle\" = dark\n  }\n\n  trait HeroOrganismRender -> @rebindable HeroOrganismItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle when @config.selfFetch\n        (fetch HeroOrganismItem { emit: { success: HeroOrganismLoaded } })\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          children: @config.children\n          type: hero-organism\n        })\n      INIT -> idle when (not @config.selfFetch)\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          children: @config.children\n          type: hero-organism\n        })\n      HeroOrganismLoaded -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @payload.data\n          children: @config.children\n          type: hero-organism\n        })\n    }\n\n    emits {\n      HeroOrganismLoaded\n        @description \"HeroOrganism rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : HeroOrganismError\n        @label \"Error\"\n        @description \"Error state (UiError)\"\n        @tier \"presentation\"\n      sortBy : string\n        @label \"Sort By\"\n        @description \"Current sort field\"\n        @tier \"presentation\"\n      sortDirection : \"asc\" | \"desc\" = asc\n        @label \"Sort Direction\"\n        @description \"Current sort direction\"\n        @tier \"presentation\"\n      searchValue : string\n        @label \"Search Value\"\n        @description \"Current search query value\"\n        @tier \"presentation\"\n      pageProp : number\n        @label \"Page\"\n        @description \"Current page number\"\n        @synonyms \"page\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Number of items per page\"\n        @tier \"presentation\"\n      totalCount : number\n        @label \"Total Count\"\n        @description \"Total number of items\"\n        @tier \"presentation\"\n      activeFilters : Map string string = {}\n        @label \"Active Filters\"\n        @description \"Active filters\"\n        @tier \"presentation\"\n      selectedIds : [string] = []\n        @label \"Selected Ids\"\n        @description \"Currently selected item IDs\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"children prop\"\n        @tier \"presentation\"\n      selfFetch : boolean = true\n        @label \"Fetch its own rows on mount?\"\n        @description \"true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/hero-organism\" as HeroOrganismPage -> HeroOrganismRender\n}\n"
}