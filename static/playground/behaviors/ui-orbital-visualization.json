  "source": "",
  "lolo": "app ui-orbital-visualization \"1.0.0\"\n\"OrbitalVisualization — UI factory (1:1 with the @almadar/ui orbital-visualization pattern).\"\norbital OrbitalVisualizationOrbital {\n  type OrbitalVisualizationSchema = {\n    dataEntities : [Map string scalar]\n    ui : OrbitalVisualizationSchemaUi\n    traits : [Map string scalar]\n  }\n  type OrbitalVisualizationSchemaUi = {\n    pages : [OrbitalVisualizationSchemaUiPagesItem]\n  }\n  type OrbitalVisualizationSchemaUiPagesItem = {\n    sections : [Map string scalar]\n  }\n  type OrbitalVisualizationError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity OrbitalVisualizationItem [runtime] {\n    id : string!\n  }\n\n  trait OrbitalVisualizationRender -> @rebindable OrbitalVisualizationItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          schema: @config.schema\n          complexity: @config.complexity\n          size: @config.size\n          showLabel: @config.showLabel\n          animated: @config.animated\n          onClick: @config.onClick\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          type: orbital-visualization\n        })\n    }\n\n    emits {\n      @config.onClick -> external { }\n        @description \"Click handler\"\n        @tier \"essential\"\n    }\n\n    config {\n      schema : OrbitalVisualizationSchema\n        @label \"Schema\"\n        @description \"Full KFlow schema object\"\n        @tier \"presentation\"\n      complexity : number\n        @label \"Complexity\"\n        @description \"Direct complexity override (1-100+)\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" | \"xl\" = md\n        @label \"Size\"\n        @description \"Size of the visualization\"\n        @tier \"presentation\"\n      showLabel : boolean = true\n        @label \"Show Label\"\n        @description \"Show complexity label\"\n        @tier \"presentation\"\n      animated : boolean = true\n        @label \"Animated\"\n        @description \"Animation enabled\"\n        @tier \"presentation\"\n      onClick : event = \"CLICK\"\n        @label \"On Click\"\n        @description \"Click handler\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : OrbitalVisualizationError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/orbital-visualization\" as OrbitalVisualizationPage -> OrbitalVisualizationRender\n}\n"
