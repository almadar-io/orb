  "source": "",
  "lolo": "app ui-progress-dots \"1.0.0\"\n\"ProgressDots — UI factory (1:1 with the @almadar/ui progress-dots pattern).\"\norbital ProgressDotsOrbital {\n  entity ProgressDotsItem [runtime] {\n    id : string!\n  }\n\n  trait ProgressDotsRender -> @rebindable ProgressDotsItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          count: @config.count\n          currentIndex: @config.currentIndex\n          onDotClick: @config.onDotClick\n          className: @config.className\n          size: @config.size\n          type: progress-dots\n        })\n    }\n\n    emits {\n      @config.onDotClick -> external {\n        index : number\n      }\n        @description \"Callback when a dot is clicked\"\n        @tier \"essential\"\n    }\n\n    config {\n      count : number = 1\n        @label \"Count\"\n        @description \"Total number of dots\"\n        @tier \"presentation\"\n      currentIndex : number = 1\n        @label \"Current Index\"\n        @description \"Current active index (0-based)\"\n        @tier \"presentation\"\n      onDotClick : event = \"DOT_CLICK\"\n        @label \"On Dot Click\"\n        @description \"Callback when a dot is clicked\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Dot size\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/progress-dots\" as ProgressDotsPage -> ProgressDotsRender\n}\n"
}