  "source": "",
  "lolo": "app ui-grid \"1.0.0\"\n\"Grid — UI factory (1:1 with the @almadar/ui grid pattern).\"\norbital GridOrbital {\n  entity GridItem [runtime] {\n    id : string!\n  }\n\n  trait GridRender -> @rebindable GridItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          cols: @config.cols\n          rows: @config.rows\n          gap: @config.gap\n          rowGap: @config.rowGap\n          colGap: @config.colGap\n          alignItems: @config.alignItems\n          justifyItems: @config.justifyItems\n          flow: @config.flow\n          className: @config.className\n          style: @config.style\n          children: @config.children\n          type: grid\n        })\n    }\n\n    config {\n      cols : \"none\"\n        @label \"Cols\"\n        @description \"Number of columns (can be responsive object)\"\n        @tier \"presentation\"\n      rows : number\n        @label \"Rows\"\n        @description \"Number of rows\"\n        @tier \"presentation\"\n      gap : \"none\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" = md\n        @label \"Gap\"\n        @description \"Gap between items\"\n        @tier \"presentation\"\n      rowGap : \"none\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" = none\n        @label \"Row Gap\"\n        @description \"Row gap (overrides gap for rows)\"\n        @tier \"presentation\"\n      colGap : \"none\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" = none\n        @label \"Col Gap\"\n        @description \"Column gap (overrides gap for columns)\"\n        @tier \"presentation\"\n      alignItems : \"start\" | \"center\" | \"end\" | \"stretch\" | \"baseline\" = start\n        @label \"Align Items\"\n        @description \"Align items on block axis\"\n        @tier \"presentation\"\n      justifyItems : \"start\" | \"center\" | \"end\" | \"stretch\" = start\n        @label \"Justify Items\"\n        @description \"Justify items on inline axis\"\n        @tier \"presentation\"\n      flow : \"row\" | \"col\" | \"row-dense\" | \"col-dense\" = row\n        @label \"Flow\"\n        @description \"Auto-flow direction\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Custom class name\"\n        @tier \"presentation\"\n      style : Map string string = {}\n        @label \"Style\"\n        @description \"Inline styles\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Children elements\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/grid\" as GridPage -> GridRender\n}\n"
