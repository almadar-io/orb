  "source": "",
  "lolo": "app std-agent-context \"1.0.0\"\n\"Wraps llm/token-count + llm/compact — context window management.\"\norbital AgentContextOrbital {\n\n  entity ContextWindow [runtime] {\n    tokenCount : number = 0\n    beforeTokens : number = 0\n    afterTokens : number = 0\n    status : \"idle\" | \"counted\" | \"compacted\" = idle\n  }\n\n  trait ContextCounter -> ContextWindow [lifecycle, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.tokenCount 0)\n        (set @entity.status idle)\n      COUNT -> counting\n        (set @entity.status idle)\n        (llm/token-count { emit: { success: TOKEN_COUNTED, failure: COUNT_FAILED } })\n    }\n\n    state counting {\n      TOKEN_COUNTED -> counted\n        (set @entity.tokenCount ?result)\n        (set @entity.status counted)\n        (emit COUNTED { tokenCount: @entity.tokenCount })\n      COUNT_FAILED -> idle\n        (set @entity.tokenCount 0)\n        (set @entity.status idle)\n    }\n\n    state counted {\n      INIT -> counted\n        (set @entity.status counted)\n      RESET -> idle\n        (set @entity.tokenCount 0)\n        (set @entity.status idle)\n    }\n\n    emits {\n      COUNTED {\n        tokenCount : number!\n      }\n      TOKEN_COUNTED {\n        result : number!\n      }\n    }\n\n    listens {\n      COUNT\n    }\n  }\n\n  trait ContextCompactor -> ContextWindow [lifecycle, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.beforeTokens 0)\n        (set @entity.afterTokens 0)\n        (set @entity.status idle)\n      COMPACT -> counting_before\n        (set @entity.status idle)\n        (llm/token-count { emit: { success: BEFORE_COUNTED, failure: COMPACT_COUNT_FAILED } })\n    }\n\n    state counting_before {\n      BEFORE_COUNTED -> compacting\n        (set @entity.beforeTokens ?result)\n        (llm/compact { emit: { success: COMPACTED_OK, failure: COMPACT_FAILED } })\n      COMPACT_COUNT_FAILED -> idle\n        (set @entity.beforeTokens 0)\n        (set @entity.afterTokens 0)\n        (set @entity.status idle)\n    }\n\n    state compacting {\n      COMPACTED_OK -> counting_after\n        (llm/token-count { emit: { success: AFTER_COUNTED, failure: COMPACT_COUNT_FAILED } })\n      COMPACT_FAILED -> idle\n        (set @entity.beforeTokens 0)\n        (set @entity.afterTokens 0)\n        (set @entity.status idle)\n    }\n\n    state counting_after {\n      AFTER_COUNTED -> compacted\n        (set @entity.afterTokens ?result)\n        (set @entity.status compacted)\n        (emit COMPACTED { before: @entity.beforeTokens, after: @entity.afterTokens })\n      COMPACT_COUNT_FAILED -> idle\n        (set @entity.beforeTokens 0)\n        (set @entity.afterTokens 0)\n        (set @entity.status idle)\n    }\n\n    state compacted {\n      INIT -> compacted\n        (set @entity.status compacted)\n      RESET -> idle\n        (set @entity.beforeTokens 0)\n        (set @entity.afterTokens 0)\n        (set @entity.status idle)\n    }\n\n    emits {\n      COMPACTED {\n        before : number!\n        after : number!\n      }\n      BEFORE_COUNTED {\n        result : number!\n      }\n      AFTER_COUNTED {\n        result : number!\n      }\n    }\n\n    listens {\n      COMPACT\n    }\n  }\n\n  trait ContextListener -> ContextWindow [lifecycle, instance] {\n    initial: waiting\n\n    state waiting {\n      INIT -> waiting\n        (set @entity.status idle)\n      COUNTED -> active\n        (set @entity.status counted)\n      COMPACTED -> active\n        (set @entity.status compacted)\n      RESET -> waiting\n        (set @entity.status idle)\n    }\n\n    state active {\n      INIT -> active\n        (set @entity.status idle)\n      RESET -> waiting\n        (set @entity.status idle)\n    }\n\n    listens {\n      ContextCounter.COUNTED -> COUNTED\n      ContextCompactor.COMPACTED -> COMPACTED\n      RESET\n    }\n  }\n\n  page \"/agent-context\" as AgentContextPage -> ContextCounter, ContextCompactor, ContextListener\n}\n"
}