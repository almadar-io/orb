  "source": "",
  "lolo": "app std-agent-context \"2.0.0\"\n\"std-agent-context — keeps what an in-app assistant sends the model bounded. COMPACT { messages } passes a conversation of at most `keepMessages` turns straight through as COMPACTED; a longer one has its older turns summarized with `call-service llm summarize` into one leading note and keeps the last `keepMessages` turns verbatim. If summarizing fails, the older turns are dropped and the recent ones still go through, with a visible warning — a summarizer outage never blocks the assistant. Headless. Nothing is persisted: the conversation itself lives in std-agent-session.\"\n\ntype AgentChatMessage = {\n  role : \"user\" | \"assistant\"\n  content : string!\n}\n\norbital AgentContextOrbital {\n  type ContextSummarized = Event { summary : string, keyPoints : [string] } \"Fired when the older turns have been summarized\"\n  type ContextSummarizeFailed = Event { error : string } \"Fired when summarizing fails\"\n\n  entity AgentContextWindow [runtime] {\n    id : string!\n    pendingMessages : [AgentChatMessage] @description \"The conversation being compacted.\" = []\n    lastSize : number @description \"Turns in the last conversation compacted.\" @synonyms \"size, length\" = 0\n  }\n\n  trait AgentContextCompactor -> AgentContextWindow [interaction] {\n    config {\n      keepMessages : number = 12\n        @label \"Turns kept verbatim\"\n        @description \"The most recent turns sent to the model word for word; older turns are summarized.\"\n        @synonyms \"window, history length, context size\"\n        @tier \"policy\"\n    }\n    initial: ready\n\n    state ready {\n      INIT -> ready\n        (set @entity.lastSize 0)\n      COMPACT -> ready when (<= (array/len ?messages) @config.keepMessages)\n        (set @entity.lastSize (array/len ?messages))\n        (emit COMPACTED { messages: ?messages })\n      COMPACT -> summarizing when (> (array/len ?messages) @config.keepMessages)\n        (set @entity.lastSize (array/len ?messages))\n        (set @entity.pendingMessages ?messages)\n        (call-service llm summarize {\n          text: (str/join (array/map (array/dropLast ?messages @config.keepMessages) (fn item (str/concat @item.role \": \" @item.content))) \"\\n\")\n        } {\n          emit: { failure: ContextSummarizeFailed, success: ContextSummarized }\n        })\n    }\n\n    state summarizing {\n      ContextSummarized -> ready\n        (emit COMPACTED {\n          messages: (array/prepend (array/takeLast @entity.pendingMessages @config.keepMessages) { role: assistant, content: (str/concat \"Earlier in this conversation: \" ?summary) })\n        })\n      ContextSummarizeFailed -> ready\n        (emit COMPACTED { messages: (array/takeLast @entity.pendingMessages @config.keepMessages) })\n        (render-ui toast {\n          message: ?error\n          type: alert\n          variant: warning\n        })\n    }\n\n    emits {\n      COMPACTED -> external {\n        messages : [AgentChatMessage]!\n      }\n        @description \"The conversation, bounded: recent turns verbatim, older turns as one summary note.\"\n        @synonyms \"compacted, trimmed, bounded\"\n        @tier \"domain\"\n      ContextSummarized -> internal {\n        summary : string\n        keyPoints : [string]\n      }\n        @tier \"internal\"\n      ContextSummarizeFailed -> internal {\n        error : string\n      }\n        @tier \"internal\"\n    }\n\n    listens {\n      COMPACT {\n        messages : [AgentChatMessage]!\n      }\n        @description \"Bound this conversation for the model.\"\n    }\n  }\n\n  page \"/agent-context\" as AgentContextPage -> AgentContextCompactor\n}\n"
}