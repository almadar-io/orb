  "source": "",
  "lolo": "app ui-spinner \"1.0.0\"\n\"Spinner — UI factory (1:1 with the @almadar/ui spinner pattern).\"\norbital SpinnerOrbital {\n  entity SpinnerItem [runtime] {\n    id : string!\n  }\n\n  trait SpinnerRender -> @rebindable SpinnerItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          size: @config.size\n          overlay: @config.overlay\n          type: spinner\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes applied to the root element.\"\n        @tier \"presentation\"\n      size : \"xs\" | \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"size prop\"\n        @tier \"presentation\"\n      overlay : boolean\n        @label \"Overlay\"\n        @description \"Renders a centered overlay backdrop instead of inline.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/spinner\" as SpinnerPage -> SpinnerRender\n}\n"
}