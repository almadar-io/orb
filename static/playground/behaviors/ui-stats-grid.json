  "source": "",
  "lolo": "app ui-stats-grid \"1.0.0\"\n\"StatsGrid — UI factory (1:1 with the @almadar/ui stats-grid pattern).\"\norbital StatsGridOrbital {\n  type StatsGridStatsItem = {\n    value : string!\n    label : string!\n  }\n\n  entity StatsGridItem [runtime] {\n    id : string!\n  }\n\n  trait StatsGridRender -> @rebindable StatsGridItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          stats: @config.stats\n          columns: @config.columns\n          className: @config.className\n          type: stats-grid\n        })\n    }\n\n    config {\n      stats : [StatsGridStatsItem] = [{ value: \"Value\", label: \"Label\" }, { value: \"Value 2\", label: \"Label 2\" }]\n        @label \"Stats\"\n        @description \"stats prop\"\n        @tier \"presentation\"\n      columns : number = 3\n        @label \"Columns\"\n        @description \"columns prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/stats-grid\" as StatsGridPage -> StatsGridRender\n}\n"
}