  "source": "",
  "lolo": "app ui-article-section \"1.0.0\"\n\"ArticleSection — UI factory (1:1 with the @almadar/ui article-section pattern).\"\norbital ArticleSectionOrbital {\n  entity ArticleSectionItem [runtime] {\n    id : string!\n  }\n\n  trait ArticleSectionRender -> @rebindable ArticleSectionItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          title: @config.title\n          children: @config.children\n          maxWidth: @config.maxWidth\n          className: @config.className\n          type: article-section\n        })\n    }\n\n    config {\n      title : string = \"\"\n        @label \"Title\"\n        @description \"Section title\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Section content\"\n        @tier \"presentation\"\n      maxWidth : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Max Width\"\n        @description \"Maximum width constraint\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/article-section\" as ArticleSectionPage -> ArticleSectionRender\n}\n"
}