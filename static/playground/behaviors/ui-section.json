  "source": "",
  "lolo": "app ui-section \"1.0.0\"\n\"Section — UI factory (1:1 with the @almadar/ui section pattern).\"\norbital SectionOrbital {\n  type SectionError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity SectionItem [runtime] {\n    id : string!\n  }\n\n  trait SectionRender -> @rebindable SectionItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          title: @config.title\n          description: @config.description\n          action: @config.action\n          padding: @config.padding\n          variant: @config.variant\n          divider: @config.divider\n          className: @config.className\n          children: @config.children\n          headerClassName: @config.headerClassName\n          contentClassName: @config.contentClassName\n          isLoading: @config.isLoading\n          error: @config.error\n          type: section\n        })\n    }\n\n    config {\n      title : string\n        @label \"Title\"\n        @description \"Section title\"\n        @tier \"presentation\"\n      description : string\n        @label \"Description\"\n        @description \"Section subtitle/description\"\n        @tier \"presentation\"\n      action : node\n        @label \"Action\"\n        @description \"Action element (e.g., button, link)\"\n        @tier \"presentation\"\n      padding : \"none\" | \"sm\" | \"md\" | \"lg\" | \"xl\" = md\n        @label \"Padding\"\n        @description \"Padding amount\"\n        @tier \"presentation\"\n      variant : \"default\" | \"card\" | \"bordered\" | \"filled\" = default\n        @label \"Variant\"\n        @description \"Visual variant\"\n        @tier \"presentation\"\n      divider : boolean = false\n        @label \"Divider\"\n        @description \"Show divider below header\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Custom class name\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Children elements\"\n        @tier \"presentation\"\n      headerClassName : string\n        @label \"Header Class Name\"\n        @description \"Header custom class name\"\n        @tier \"presentation\"\n      contentClassName : string\n        @label \"Content Class Name\"\n        @description \"Content custom class name\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : SectionError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/section\" as SectionPage -> SectionRender\n}\n"
}