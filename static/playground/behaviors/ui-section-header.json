  "source": "",
  "lolo": "app ui-section-header \"1.0.0\"\n\"SectionHeader — UI factory (1:1 with the @almadar/ui section-header pattern).\"\norbital SectionHeaderOrbital {\n  entity SectionHeaderItem [runtime] {\n    id : string!\n  }\n\n  trait SectionHeaderRender -> @rebindable SectionHeaderItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          title: @config.title\n          subtitle: @config.subtitle\n          align: @config.align\n          level: @config.level\n          className: @config.className\n          type: section-header\n        })\n    }\n\n    config {\n      title : string = \"\"\n        @label \"Title\"\n        @description \"Section title text\"\n        @tier \"presentation\"\n      subtitle : string\n        @label \"Subtitle\"\n        @description \"Optional subtitle text\"\n        @tier \"presentation\"\n      align : \"center\" | \"left\" | \"right\" = center\n        @label \"Align\"\n        @description \"Text alignment\"\n        @tier \"presentation\"\n      level : number = 2\n        @label \"Level\"\n        @description \"Heading level (1, 2, or 3)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/section-header\" as SectionHeaderPage -> SectionHeaderRender\n}\n"
}