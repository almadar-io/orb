  "source": "",
  "lolo": "app std-marketing-pricing \"1.0.0\"\n\"Pricing grid atom for marketing pages. Renders tiered pricing cards with plans, features, and CTAs. Pick for SaaS pricing pages and subscription showcases.\"\n;; Config-driven pricing grid using the `pricing-grid` marketing pattern.\n;; Plans are declared as an array of { name, price, description, features, action, highlighted, badge } objects.\n;; The atom emits PLAN_SELECT when a plan's action button is clicked.\norbital PricingItemOrbital {\n    type PricingPlan = { name : string!, price : string!, description : string, features : [string]!, action : { label : string!, href : string! }!, highlighted : boolean, badge : string }\n\n  entity PricingItem [runtime] {\n    id : string!\n  }\n\n  trait PricingItemPricing -> PricingItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main { plans: @config.plans, type: pricing-grid })\n      PLAN_SELECT -> idle\n        (emit PLAN_SELECT { href: ?href, plan: ?plan })\n    }\n\n    emits {\n      PLAN_SELECT -> external {\n        plan : string\n        href : string\n      }\n        @description \"Indicates a pricing plan has been chosen.\"\n        @synonyms \"select, choose, pick, activate\"\n        @tier \"domain\"\n    }\n\n    listens {\n      PLAN_SELECT {\n        plan : string\n        href : string\n      }\n        @description \"A pricing plan has been chosen by the user.\"\n        @synonyms \"select, choose, activate, subscribe\"\n        @tier \"domain\"\n    }\n\n    config {\n      plans : [PricingPlan] = [{\n        action: {\n          href: \"#\"\n          label: \"Get Started\"\n        }\n        badge: \"\"\n        description: \"For individuals and small projects.\"\n        features: [\"1 project\", \"Community support\", \"Basic analytics\"]\n        highlighted: false\n        name: Starter\n        price: \"$0\"\n      }, {\n        action: {\n          href: \"#\"\n          label: \"Start Trial\"\n        }\n        badge: \"Most Popular\"\n        description: \"For growing teams that need more power.\"\n        features: [\"Unlimited projects\", \"Priority support\", \"Advanced analytics\", \"Custom domains\"]\n        highlighted: true\n        name: Pro\n        price: \"$49\"\n      }, {\n        action: {\n          href: \"#\"\n          label: \"Contact Sales\"\n        }\n        badge: \"\"\n        description: \"For organizations with advanced needs.\"\n        features: [\"Dedicated infra\", \"SLA guarantee\", \"SSO & SAML\", \"Audit logs\", \"Custom contracts\"]\n        highlighted: false\n        name: Enterprise\n        price: Custom\n      }]\n        @label \"Pricing Plans\"\n        @description \"Array of pricing tiers\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/pricing\" as PricingItemPricingPage -> PricingItemPricing\n}"
}