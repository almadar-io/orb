  "level": "atom",
  "topic": "ui/learning",
  "schema": {
    "name": "std-bio-cell",
    "version": "1.0.0",
    "description": "Eukaryotic cell-structure engine — a large steady nucleus ringed by organelles whose radii breathe at staggered phases on biology-canvas.",
    "orbitals": [
      {
        "name": "BioCellEngineOrbital",
        "entity": {
          "name": "BioCellState",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "phase",
              "type": "number",
              "default": 0
            },
            {
              "name": "nodes",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "radius": {
                    "name": "radius",
                    "type": "number",
                    "required": false
                  },
                  "y": {
                    "name": "y",
                    "type": "number",
                    "required": true
                  },
                  "x": {
                    "name": "x",
                    "type": "number",
                    "required": true
                  },
                  "id": {
                    "name": "id",
                    "type": "string",
                    "required": false
                  },
                  "kind": {
                    "name": "kind",
                    "type": "string",
                    "required": false,
                    "values": [
                      "cell",
                      "organelle",
                      "molecule",
                      "organism"
                    ]
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  }
                }
              }
            },
            {
              "name": "running",
              "type": "boolean",
              "default": false
            }
          ]
        },
        "traits": [
          {
            "name": "BioCellSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "nodes",
                "phase",
                "running"
              ]
            },
            "category": "interaction",
            "linkedEntity": "BioCellState",
            "emits": [
              {
                "event": "CELL_UPDATED",
                "description": "The current cell scene each tick — a composed listener (readout, graph) can subscribe; a harmless no-op when the atom runs standalone.",
                "synonyms": "tick, frame, step, redraw",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "nodes",
                    "type": "[BioNode]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "CELL_UPDATED",
                  "name": "Cell Updated",
                  "description": "The current cell scene each tick — a composed listener (readout, graph) can subscribe; a harmless no-op when the atom runs standalone.",
                  "synonyms": "tick, frame, step, redraw",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "nodes",
                      "type": "[BioNode]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.phase",
                      0
                    ],
                    [
                      "set",
                      "@entity.nodes",
                      [
                        {
                          "color": "#2563eb",
                          "label": "Nucleus",
                          "id": "nucleus",
                          "radius": 34,
                          "kind": "cell",
                          "x": 300,
                          "y": 200
                        },
                        {
                          "id": "mitochondria",
                          "kind": "organelle",
                          "color": "#dc2626",
                          "radius": 14,
                          "y": 120,
                          "label": "Mitochondria",
                          "x": 170
                        },
                        {
                          "kind": "organelle",
                          "radius": 14,
                          "label": "Ribosome",
                          "x": 440,
                          "y": 120,
                          "color": "#f59e0b",
                          "id": "ribosome"
                        },
                        {
                          "label": "Golgi",
                          "y": 290,
                          "color": "#7c3aed",
                          "id": "golgi",
                          "kind": "organelle",
                          "radius": 14,
                          "x": 150
                        },
                        {
                          "x": 450,
                          "id": "vacuole",
                          "label": "Vacuole",
                          "kind": "organelle",
                          "color": "#0891b2",
                          "radius": 14,
                          "y": 290
                        },
                        {
                          "kind": "organelle",
                          "x": 300,
                          "radius": 14,
                          "y": 330,
                          "color": "#16a34a",
                          "label": "Chloroplast",
                          "id": "chloroplast"
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "edges": [
                          {
                            "color": "#e2e8f0",
                            "to": "nucleus",
                            "from": "mitochondria",
                            "label": ""
                          },
                          {
                            "label": "",
                            "color": "#e2e8f0",
                            "from": "ribosome",
                            "to": "nucleus"
                          },
                          {
                            "from": "golgi",
                            "label": "",
                            "to": "nucleus",
                            "color": "#e2e8f0"
                          },
                          {
                            "label": "",
                            "color": "#e2e8f0",
                            "from": "vacuole",
                            "to": "nucleus"
                          },
                          {
                            "to": "nucleus",
                            "color": "#e2e8f0",
                            "label": "",
                            "from": "chloroplast"
                          }
                        ],
                        "height": 400,
                        "type": "biology-canvas",
                        "width": 600,
                        "nodes": "@entity.nodes",
                        "backgroundColor": "#f0fdf4"
                      }
                    ],
                    [
                      "emit",
                      "CELL_UPDATED",
                      {
                        "nodes": "@entity.nodes"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "cellTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "set",
                    "@entity.phase",
                    [
                      "+",
                      "@entity.phase",
                      3
                    ]
                  ],
                  [
                    "set",
                    "@entity.nodes",
                    [
                      "array/map",
                      "@entity.nodes",
                      [
                        "fn",
                        "n",
                        [
                          "if",
                          [
                            "=",
                            [
                              "object/get",
                              "@n",
                              "kind"
                            ],
                            "cell"
                          ],
                          "@n",
                          [
                            "let",
                            [
                              [
                                "off",
                                [
                                  "if",
                                  [
                                    "=",
                                    [
                                      "object/get",
                                      "@n",
                                      "id"
                                    ],
                                    "mitochondria"
                                  ],
                                  0,
                                  [
                                    "if",
                                    [
                                      "=",
                                      [
                                        "object/get",
                                        "@n",
                                        "id"
                                      ],
                                      "ribosome"
                                    ],
                                    40,
                                    [
                                      "if",
                                      [
                                        "=",
                                        [
                                          "object/get",
                                          "@n",
                                          "id"
                                        ],
                                        "golgi"
                                      ],
                                      80,
                                      [
                                        "if",
                                        [
                                          "=",
                                          [
                                            "object/get",
                                            "@n",
                                            "id"
                                          ],
                                          "vacuole"
                                        ],
                                        120,
                                        160
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "tw",
                                  [
                                    "math/abs",
                                    [
                                      "-",
                                      [
                                        "math/mod",
                                        [
                                          "+",
                                          "@entity.phase",
                                          "@off"
                                        ],
                                        240
                                      ],
                                      120
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "let",
                                [
                                  [
                                    "nr",
                                    [
                                      "+",
                                      12,
                                      [
                                        "*",
                                        "@tw",
                                        0.05
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "object/merge",
                                  "@n",
                                  {
                                    "radius": "@nr"
                                  }
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "nodes": "@entity.nodes",
                      "backgroundColor": "#f0fdf4",
                      "edges": [
                        {
                          "color": "#e2e8f0",
                          "to": "nucleus",
                          "from": "mitochondria",
                          "label": ""
                        },
                        {
                          "label": "",
                          "color": "#e2e8f0",
                          "from": "ribosome",
                          "to": "nucleus"
                        },
                        {
                          "from": "golgi",
                          "label": "",
                          "to": "nucleus",
                          "color": "#e2e8f0"
                        },
                        {
                          "label": "",
                          "color": "#e2e8f0",
                          "from": "vacuole",
                          "to": "nucleus"
                        },
                        {
                          "to": "nucleus",
                          "color": "#e2e8f0",
                          "label": "",
                          "from": "chloroplast"
                        }
                      ],
                      "width": 600,
                      "type": "biology-canvas",
                      "height": 400
                    }
                  ],
                  [
                    "emit",
                    "CELL_UPDATED",
                    {
                      "nodes": "@entity.nodes"
                    }
                  ]
                ]
              }
            ],
            "config": {
