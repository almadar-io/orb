  "source": "",
  "lolo": "app ui-repeatable-form-section \"1.0.0\"\n\"RepeatableFormSection — a form section that repeats a fixed group of fields, letting the user add or remove entries. — UI factory (1:1 with the @almadar/ui repeatable-form-section pattern).\"\n;; @capabilities \"dynamic line items, repeatable field group, add/remove entry rows, multi-entry form block\"\norbital RepeatableFormSectionOrbital {\n  type RepeatableFormSectionItemsItem = {\n    id : string!\n    addedInState : string\n    addedAt : string\n  }\n\n  entity RepeatableFormSectionItem [runtime] {\n    id : string!\n  }\n\n  trait RepeatableFormSectionRender -> @rebindable RepeatableFormSectionItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          sectionType: @config.sectionType\n          title: @config.title\n          items: @config.items\n          renderItem: (fn item { content: (object/get @item @config.itemLabelField \"\"), type: typography })\n          minItems: @config.minItems\n          maxItems: @config.maxItems\n          allowReorder: @config.allowReorder\n          addLabel: @config.addLabel\n          emptyMessage: @config.emptyMessage\n          readOnly: @config.readOnly\n          className: @config.className\n          onAdd: @config.onAdd\n          onRemove: @config.onRemove\n          onReorder: @config.onReorder\n          trackAddedInState: @config.trackAddedInState\n          currentState: @config.currentState\n          showAuditInfo: @config.showAuditInfo\n          type: repeatable-form-section\n        })\n    }\n\n    emits {\n      @config.onAdd -> external { }\n        @description \"Add handler\"\n        @tier \"essential\"\n      @config.onRemove -> external {\n        itemId : string\n        index : number\n      }\n        @description \"Remove handler\"\n        @tier \"essential\"\n      @config.onReorder -> external {\n        fromIndex : number\n        toIndex : number\n      }\n        @description \"Reorder handler\"\n        @tier \"essential\"\n    }\n\n    config {\n      sectionType : string = \"\"\n        @label \"Section Type\"\n        @description \"Section type identifier\"\n        @tier \"presentation\"\n      title : string = \"\"\n        @label \"Title\"\n        @description \"Section title\"\n        @tier \"presentation\"\n      items : [RepeatableFormSectionItemsItem] = [{ id: \"Id\", addedInState: \"Added In State\", addedAt: \"Added At\" }, { id: \"Id 2\", addedInState: \"Added In State 2\", addedAt: \"Added At 2\" }]\n        @label \"Items\"\n        @description \"Items in the section\"\n        @tier \"presentation\"\n      itemLabelField : string = \"id\"\n        @label \"Item label field\"\n        @description \"Row field rendered as each item's label (defaults to id).\"\n        @tier \"presentation\"\n      minItems : number = 0\n        @label \"Min Items\"\n        @description \"Minimum items required\"\n        @tier \"presentation\"\n      maxItems : number\n        @label \"Max Items\"\n        @description \"Maximum items allowed\"\n        @tier \"presentation\"\n      allowReorder : boolean = false\n        @label \"Allow Reorder\"\n        @description \"Allow reordering\"\n        @tier \"presentation\"\n      addLabel : string\n        @label \"Add Label\"\n        @description \"Add button label\"\n        @tier \"presentation\"\n      emptyMessage : string\n        @label \"Empty Message\"\n        @description \"Empty state message\"\n        @tier \"presentation\"\n      readOnly : boolean = false\n        @label \"Read Only\"\n        @description \"Read-only mode\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      onAdd : event = \"ADD\"\n        @label \"On Add\"\n        @description \"Add handler\"\n        @tier \"presentation\"\n      onRemove : event = \"REMOVE\"\n        @label \"On Remove\"\n        @description \"Remove handler\"\n        @tier \"presentation\"\n      onReorder : event = \"REORDER\"\n        @label \"On Reorder\"\n        @description \"Reorder handler\"\n        @tier \"presentation\"\n      trackAddedInState : boolean = false\n        @label \"Track Added In State\"\n        @description \"Inspection-specific enhancements\"\n        @tier \"presentation\"\n      currentState : string\n        @label \"Current State\"\n        @description \"Current inspection state (used when trackAddedInState is true)\"\n        @tier \"presentation\"\n      showAuditInfo : boolean = false\n        @label \"Show Audit Info\"\n        @description \"Show audit metadata (addedInState, addedAt)\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/repeatable-form-section\" as RepeatableFormSectionPage -> RepeatableFormSectionRender\n}\n"
}