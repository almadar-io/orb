  "source": "",
  "lolo": "app std-pickup \"1.0.0\"\n\"Headless side-view collectible authority — the platformer twin of grid std-gather. Listens BODY_MOVED and, when the player touches an uncollected feature (|dx| <= reachX, |dy| <= reachY of the feature center — the coef-pad touch idiom minus the grounded requirement, so airborne pickups work), stamps it collected on the shared entity and emits PICKED once per item (id, kind, position, glyph, message) plus COLLECT{total} with the running count (the event std-gate-lock already consumes). When every feature is collected it emits PICKUP_SET_COMPLETED once. RESTART re-arms every feature and zeroes the count. kind is board-defined vocabulary (star, boost, …) — this atom reports, boards judge. Renders nothing; boards draw the features and read collected from the shared entity.\"\norbital PickupOrbital {\n  type PickupFeature = {\n    id : string!\n    x : number!\n    y : number!\n    kind : string!\n    glyph : string\n    message : string\n    collected : boolean\n  }\n\n  entity PickupData [runtime, shared] {\n    id : string!\n    pickups : [PickupFeature] = []\n    pickupCompleted : boolean = false\n    total : number = 0\n  }\n\n  trait Pickup -> @rebindable PickupData [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.pickups (array/map @config.features (fn f (object/merge @f { collected: false }))))\n        (set @entity.pickupCompleted false)\n        (set @entity.total 0)\n\n      BODY_MOVED -> active when @config.running\n        (let ((touch (array/filter @entity.pickups (fn f\n          (and (== (object/get @f collected) false)\n            (and (<= (math/abs (- @payload.x (object/get @f x))) @config.reachX)\n              (<= (math/abs (- @payload.y (object/get @f y))) @config.reachY)))))))\n        (if (> (array/len @touch) 0)\n          (let ((f (array/first @touch)))\n          (let ((remaining (array/len (array/filter @entity.pickups (fn c (and (== (object/get @c collected) false) (!= (object/get @c id) (object/get @f id))))))))\n          (do\n            (set @entity.pickups (array/map @entity.pickups (fn c (if (== (object/get @c id) (object/get @f id)) (object/merge @c { collected: true }) @c))))\n            (set @entity.total (+ @entity.total 1))\n            (emit PICKED { id: (object/get @f id), kind: (object/get @f kind), x: (object/get @f x), y: (object/get @f y), glyph: (object/get @f glyph), message: (object/get @f message) })\n            (emit COLLECT { total: @entity.total })\n            (if (and (== @entity.pickupCompleted false) (== @remaining 0))\n              (do\n                (set @entity.pickupCompleted true)\n                (emit PICKUP_SET_COMPLETED {}))\n              null))))\n          null))\n\n      RESTART -> active\n        (set @entity.pickups (array/map @config.features (fn f (object/merge @f { collected: false }))))\n        (set @entity.pickupCompleted false)\n        (set @entity.total 0)\n    }\n\n    emits {\n      PICKED -> external {\n        id : string!\n        kind : string!\n        x : number!\n        y : number!\n        glyph : string\n        message : string\n      }\n        @description \"The player touched an uncollected feature; carries the feature identity, board-defined kind (star, boost, …), position and display glyph/message. Fires once per feature per run.\"\n        @tier \"domain\"\n      COLLECT -> external {\n        total : number!\n      }\n        @description \"Running count of collected features after this pickup — the event std-gate-lock consumes to count openings.\"\n        @tier \"domain\"\n      PICKUP_SET_COMPLETED -> external {\n      }\n        @description \"Every feature in the set is collected; fires once per run.\"\n        @tier \"domain\"\n    }\n\n    listens {\n      BODY_MOVED { x : number!, y : number!, vx : number!, vy : number!, grounded : boolean!, skating : boolean!, speed : number! }\n      RESTART { id : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, BODY_MOVED collects touched features; toggle to freeze the set as-is.\"\n        @tier \"domain\"\n      features : [PickupFeature] = []\n        @label \"Features\"\n        @description \"One row per collectible: id, center (x, y in world units), board-defined kind (star, boost, …), display glyph and message floated on pickup. collected is stamped at runtime.\"\n        @tier \"domain\"\n      reachX : number = 0.7\n        @label \"Reach X\"\n        @description \"Horizontal tolerance (world units) around a feature's center when testing player contact.\"\n        @tier \"domain\"\n      reachY : number = 1.2\n        @label \"Reach Y\"\n        @description \"Vertical tolerance (world units) around a feature's center when testing player contact; generous values catch fly-through pickups.\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/pickup\" as PickupPage -> Pickup\n}\n"
}