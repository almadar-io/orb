  "source": "",
  "lolo": "app std-tutorial-autodemo \"1.0.0\"\n\"Generic scripted input-replay atom: the demo half of a tutorial. Holds one or more named cue scripts (each an ordered list of { at, event, arg } rows where at is a millisecond offset and event is LEFT/RIGHT/JUMP/STOP); listens for TUTORIAL_DEMO_START { demoId } (from std-tutorial-overlay's demoId step) and plays the matching script on a 32ms clock, emitting the semantic DEMO_LEFT / DEMO_RIGHT / DEMO_JUMP / DEMO_STOP events the host board maps onto its own movement. TUTORIAL_DEMO_STOP, DEMO_CANCEL (real user input), or exhausting the cue list end the demo and emit DEMO_STOP so the character stops moving. Renders a small Demo badge while playing. Domain-agnostic: the demo never emits board events (OW_*, etc.) — the organism maps DEMO_* to its own steering, so a demo cannot self-cancel through the board's input path.\"\norbital TutorialAutoDemoOrbital {\n  type DemoCue = {\n    at : number!\n    event : string!\n    arg : number\n  }\n  type DemoScript = {\n    id : string!\n    cues : [DemoCue]!\n  }\n\n  entity AutoDemoData [runtime] {\n    id : string!\n    playing : boolean = false\n    scriptId : string = \"\"\n    elapsed : number = 0\n    cueIndex : number = 0\n  }\n\n  trait AutoDemo -> @rebindable AutoDemoData [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui hud-top null)\n\n      TUTORIAL_DEMO_START -> playing\n        (set @entity.scriptId @payload.demoId)\n        (set @entity.elapsed 0)\n        (set @entity.cueIndex 0)\n        (set @entity.playing true)\n        (render-ui hud-top {\n          type: badge\n          label: \"Demo\"\n          variant: \"info\"\n        })\n\n      TUTORIAL_DEMO_STOP -> idle\n        (render-ui hud-top null)\n\n      DEMO_CANCEL -> idle\n        (render-ui hud-top null)\n    }\n\n    state playing {\n      TUTORIAL_DEMO_START -> playing\n        (set @entity.scriptId @payload.demoId)\n        (set @entity.elapsed 0)\n        (set @entity.cueIndex 0)\n        (render-ui hud-top {\n          type: badge\n          label: \"Demo\"\n          variant: \"info\"\n        })\n\n      TUTORIAL_DEMO_STOP -> idle\n        (set @entity.playing false)\n        (render-ui hud-top null)\n        (emit DEMO_STOP {})\n\n      DEMO_CANCEL -> idle\n        (set @entity.playing false)\n        (render-ui hud-top null)\n        (emit DEMO_STOP {})\n    }\n\n    ticks {\n      demoTick every 32ms when (== @entity.playing true)\n        (set @entity.elapsed (+ @entity.elapsed 32))\n        (let ((scriptMatch (array/filter @config.scripts (fn s (== (object/get @s id) @entity.scriptId)))))\n        (let ((cueList (if (> (array/len @scriptMatch) 0) (object/get (array/first @scriptMatch) cues []) [])))\n        (let ((cue (if (< @entity.cueIndex (array/len @cueList)) (array/nth @cueList @entity.cueIndex) { at: 999999, event: \"\" })))\n        (do\n          (if (<= (object/get @cue at 0) @entity.elapsed)\n            (do\n              (set @entity.cueIndex (+ @entity.cueIndex 1))\n              (if (== (object/get @cue event \"\") \"LEFT\") (emit DEMO_LEFT {}) null)\n              (if (== (object/get @cue event \"\") \"RIGHT\") (emit DEMO_RIGHT {}) null)\n              (if (== (object/get @cue event \"\") \"JUMP\") (emit DEMO_JUMP {}) null)\n              (if (== (object/get @cue event \"\") \"STOP\") (emit DEMO_STOP {}) null))\n            null)\n          (if (>= @entity.cueIndex (array/len @cueList))\n            (do\n              (set @entity.playing false)\n              (render-ui hud-top null)\n              (emit DEMO_STOP {}))\n            null)))))\n    }\n\n    listens {\n      TUTORIAL_DEMO_START {\n        demoId : string!\n      }\n        @description \"A tutorial step carrying a demoId was shown (std-tutorial-overlay); begin playing the cue script whose id matches demoId.\"\n        @tier \"domain\"\n      TUTORIAL_DEMO_STOP {\n      }\n        @description \"The tutorial left a demo step or was dismissed; stop the demo and release control.\"\n        @tier \"domain\"\n      DEMO_CANCEL {\n      }\n        @description \"Real user input was received by the host board; stop the demo immediately and hand control back to the player.\"\n        @tier \"domain\"\n    }\n\n    emits {\n      DEMO_LEFT -> external {\n      }\n        @description \"Scripted run-left cue; the host board maps this to its own steer-left.\"\n        @tier \"domain\"\n      DEMO_RIGHT -> external {\n      }\n        @description \"Scripted run-right cue; the host board maps this to its own steer-right.\"\n        @tier \"domain\"\n      DEMO_JUMP -> external {\n      }\n        @description \"Scripted jump cue; the host board maps this to its own jump.\"\n        @tier \"domain\"\n      DEMO_STOP -> external {\n      }\n        @description \"Scripted stop cue (or demo end/cancel); the host board maps this to stop movement.\"\n        @tier \"domain\"\n    }\n\n    config {\n      scripts : [DemoScript] = []\n        @label \"Scripts\"\n        @description \"Named cue scripts keyed by the tutorial step's demoId; each cue fires its event after `at` milliseconds of the demo clock.\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/tutorial-autodemo\" as TutorialAutoDemoPage -> AutoDemo\n}\n"
}