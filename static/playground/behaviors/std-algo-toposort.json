                    "type": "string",
                    "required": false
                  }
                }
              }
            },
            {
              "name": "edges",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "to": {
                    "name": "to",
                    "type": "string",
                    "required": true
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
                  "from": {
                    "name": "from",
                    "type": "string",
                    "required": true
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  }
                }
              }
            },
            {
              "name": "order",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
