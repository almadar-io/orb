              "default": true
            }
          ]
        },
        "traits": [
          {
            "name": "ToposortSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "cur",
                "done",
                "edges",
                "nodes",
                "order",
                "ready",
                "running"
              ]
            },
            "category": "interaction",
            "linkedEntity": "ToposortScene",
            "emits": [
              {
                "event": "NODES_UPDATED",
                "description": "The graph each step — a composed listener can subscribe; a harmless no-op standalone.",
                "synonyms": "tick, frame, step, emit, order, sort",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "nodes",
                    "type": "[GraphNode]"
                  },
                  {
                    "name": "edges",
                    "type": "[GraphEdge]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "NODES_UPDATED",
                  "name": "Nodes Updated",
                  "description": "The graph each step — a composed listener can subscribe; a harmless no-op standalone.",
                  "synonyms": "tick, frame, step, emit, order, sort",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "nodes",
                      "type": "[GraphNode]"
                    },
                    {
                      "name": "edges",
                      "type": "[GraphEdge]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.nodes",
                      [
                        {
                          "x": 150,
                          "id": "A",
                          "kind": "cell",
                          "y": 60,
                          "color": "#cbd5e1",
                          "label": "A",
                          "radius": 20
                        },
                        {
                          "radius": 20,
                          "x": 450,
                          "kind": "cell",
                          "y": 60,
                          "label": "B",
                          "color": "#cbd5e1",
                          "id": "B"
                        },
                        {
                          "x": 300,
                          "y": 170,
                          "id": "C",
                          "color": "#cbd5e1",
                          "kind": "cell",
                          "radius": 20,
                          "label": "C"
                        },
                        {
                          "color": "#cbd5e1",
                          "label": "D",
                          "radius": 20,
                          "x": 180,
                          "kind": "cell",
                          "y": 270,
                          "id": "D"
                        },
                        {
                          "id": "E",
                          "kind": "cell",
                          "color": "#cbd5e1",
                          "label": "E",
                          "radius": 20,
                          "x": 420,
                          "y": 270
                        },
                        {
                          "color": "#cbd5e1",
                          "label": "F",
                          "id": "F",
                          "kind": "cell",
                          "radius": 20,
                          "x": 300,
                          "y": 360
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.edges",
                      [
                        {
                          "from": "A",
                          "label": "",
                          "color": "#9ca3af",
                          "to": "C"
                        },
                        {
                          "color": "#9ca3af",
                          "from": "B",
                          "label": "",
                          "to": "C"
                        },
                        {
                          "from": "C",
                          "color": "#9ca3af",
                          "label": "",
                          "to": "D"
                        },
                        {
                          "from": "C",
                          "color": "#9ca3af",
                          "label": "",
                          "to": "E"
                        },
                        {
                          "color": "#9ca3af",
                          "from": "D",
                          "label": "",
                          "to": "F"
                        },
                        {
                          "from": "E",
                          "color": "#9ca3af",
                          "label": "",
                          "to": "F"
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "set",
                      "@entity.order",
                      []
                    ],
                    [
                      "set",
                      "@entity.ready",
                      []
                    ],
                    [
                      "set",
                      "@entity.cur",
                      ""
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "edges": "@entity.edges",
                        "backgroundColor": "#f8fafc",
                        "height": 400,
                        "nodes": "@entity.nodes",
                        "type": "biology-canvas",
                        "width": 600
                      }
                    ],
                    [
                      "emit",
                      "NODES_UPDATED",
                      {
                        "nodes": "@entity.nodes",
                        "edges": "@entity.edges"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "topoTick",
                "interval": 400,
                "guard": [
                  "and",
                  "@entity.running",
                  [
                    "not",
                    "@entity.done"
                  ]
                ],
                "effects": [
                  [
                    "set",
                    "@entity.ready",
                    [
                      "array/map",
                      [
                        "array/filter",
                        "@entity.nodes",
                        [
                          "let",
                          [
                            [
                              "nid",
                              [
                                "object/get",
                                "@item",
                                "id"
                              ]
                            ]
                          ],
                          [
                            "and",
                            [
                              "not",
                              [
                                "array/includes",
                                "@entity.order",
                                "@nid"
                              ]
                            ],
                            [
                              "==",
                              [
                                "array/len",
                                [
                                  "array/filter",
                                  [
                                    "array/map",
                                    [
                                      "array/filter",
                                      "@entity.edges",
                                      [
                                        "==",
                                        [
                                          "object/get",
                                          "@item",
                                          "to"
                                        ],
                                        "@nid"
                                      ]
                                    ],
                                    [
                                      "object/get",
                                      "@item",
                                      "from"
                                    ]
                                  ],
                                  [
                                    "not",
                                    [
                                      "array/includes",
                                      "@entity.order",
                                      "@item"
                                    ]
                                  ]
                                ]
                              ],
                              0
                            ]
                          ]
                        ]
                      ],
                      [
                        "object/get",
                        "@item",
                        "id"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.cur",
                    [
                      "array/first",
                      "@entity.ready"
                    ]
                  ],
                  [
                    "set",
                    "@entity.order",
                    [
                      "array/append",
                      "@entity.order",
                      "@entity.cur"
                    ]
                  ],
                  [
                    "set",
                    "@entity.done",
                    [
                      "==",
                      [
                        "array/len",
                        "@entity.order"
                      ],
                      [
                        "array/len",
                        "@entity.nodes"
                      ]
                    ]
                  ],
                  [
                    "set",
                    "@entity.nodes",
                    [
                      "array/map",
                      "@entity.nodes",
                      [
                        "object/merge",
                        "@item",
                        {
                          "color": [
                            "if",
                            [
                              "array/includes",
                              "@entity.order",
                              [
                                "object/get",
                                "@item",
                                "id"
                              ]
                            ],
                            "#22c55e",
                            [
                              "if",
                              [
                                "array/includes",
                                "@entity.ready",
                                [
                                  "object/get",
                                  "@item",
                                  "id"
                                ]
                              ],
                              "#f59e0b",
                              "#cbd5e1"
                            ]
                          ]
                        }
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "type": "biology-canvas",
                      "backgroundColor": "#f8fafc",
                      "edges": "@entity.edges",
                      "height": 400,
                      "width": 600,
                      "nodes": "@entity.nodes"
                    }
                  ],
                  [
                    "emit",
                    "NODES_UPDATED",
                    {
                      "nodes": "@entity.nodes",
                      "edges": "@entity.edges"
                    }
                  ]
                ]
              }
            ],
            "config": {
              "backgroundColor": {
                "type": "string",
                "default": "#f8fafc",
                "label": "Background Color",
                "description": "Canvas background color.",
                "tier": "presentation"
              },
              "nodes": {
