  "source": "",
  "lolo": "app ui-top-nav-item \"1.0.0\"\n\"TopNavItem — UI factory (1:1 with the @almadar/ui top-nav-item pattern).\"\n;; @pattern \"top-nav-item\"\norbital TopNavItemOrbital {\n  type TopNavItemItem = {\n    label : string!\n    href : string\n    icon : icon\n    badge : string\n    active : boolean\n    children : [TopNavItemItem]\n  }\n\n  entity TopNavItemItem [runtime] {\n    id : string!\n  }\n\n  trait TopNavItemRender -> @rebindable TopNavItemItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          item: @config.item\n          activeHref: @config.activeHref\n          tone: @config.tone\n          className: @config.className\n          type: top-nav-item\n        })\n    }\n\n    config {\n      item : TopNavItemItem = { label: \"Label\", href: \"Href\", icon: \"circle\", badge: \"Badge\", active: false, children: [] }\n        @label \"Item\"\n        @description \"item prop\"\n        @tier \"presentation\"\n      activeHref : string\n        @label \"Active Href\"\n        @description \"The href of the active page, used to mark the item (or its parent) active.\"\n        @tier \"presentation\"\n      tone : \"solid\" | \"soft\" = solid\n        @label \"Tone\"\n        @description \"Active styling: `solid` fills with the primary colour (dashboard top bar); `soft` tints it (site header).\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/top-nav-item\" as TopNavItemPage -> TopNavItemRender\n}\n"
}