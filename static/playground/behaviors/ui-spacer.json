  "source": "",
  "lolo": "app ui-spacer \"1.0.0\"\n\"Spacer — UI factory (1:1 with the @almadar/ui spacer pattern).\"\norbital SpacerOrbital {\n  entity SpacerItem [runtime] {\n    id : string!\n  }\n\n  trait SpacerRender -> @rebindable SpacerItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          size: @config.size\n          axis: @config.axis\n          className: @config.className\n          type: spacer\n        })\n    }\n\n    config {\n      size : \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" | \"auto\" = auto\n        @label \"Size\"\n        @description \"Fixed size (auto = flex grow)\"\n        @tier \"presentation\"\n      axis : \"horizontal\" | \"vertical\" = horizontal\n        @label \"Axis\"\n        @description \"Orientation (for fixed sizes)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Custom class name\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/spacer\" as SpacerPage -> SpacerRender\n}\n"
}