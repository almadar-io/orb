  "source": "",
  "lolo": "app std-filter \"1.0.0\"\n\"std-filter — single primitive: filter-group. Owns a FilterTarget runtime entity; every FILTER transition persists field/value so cross-trait listeners can route the latest selection into data atoms.\"\ntype FilterSpec = { field : string!, label : string!, filterType : \"text\" | \"select\" | \"toggle\" | \"checkbox\" | \"date\" | \"daterange\" | \"date-range\" | \"numberrange\" | \"number-range\", options : [string], min : number, max : number, step : number }\norbital FilterTargetOrbital {\n  entity FilterTarget [runtime] {\n    id : string!\n    field : string @description \"The name of the data field being filtered.\" @synonyms \"attribute, property, key\"\n    value : string @description \"The data associated with the filter criterion.\" @synonyms \"data, criterion, content\"\n  }\n\n  trait FilterTargetFilter -> @rebindable FilterTarget [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (fetch FilterTarget {})\n        (render-ui main {\n          entity: FilterTarget\n          event: @config.event\n          filters: @config.filters\n          look: @config.filterBarLook\n          type: filter-group\n        })\n      FILTER -> idle\n        (set @entity.field ?field)\n        (set @entity.value ?value)\n        (render-ui main {\n          entity: FilterTarget\n          event: @config.event\n          filters: @config.filters\n          look: @config.filterBarLook\n          type: filter-group\n        })\n      CLEAR_FILTERS -> idle\n        (set @entity.field \"\")\n        (set @entity.value \"\")\n        (emit FILTER {\n          entity: FilterTarget\n          field: \"\"\n          value: \"\"\n        })\n        (render-ui main {\n          entity: FilterTarget\n          event: @config.event\n          filters: @config.filters\n          look: @config.filterBarLook\n          type: filter-group\n        })\n    }\n\n    emits {\n      FILTER {\n        entity : string!\n        field : string!\n        value : string!\n        query : string\n      }\n        @description \"Signals a filter has been applied or changed.\"\n        @synonyms \"apply, update, change, refine\"\n        @tier \"domain\"\n    }\n\n    listens {\n      FILTER {\n        entity : string!\n        field : string!\n        value : string!\n        query : string\n      }\n        @description \"A filter condition has been applied or modified.\"\n        @synonyms \"apply, update, change, set\"\n        @tier \"domain\"\n      CLEAR_FILTERS\n        @description \"Resets the filter selection to its initial state.\"\n        @synonyms \"reset, clear, remove, undo\"\n        @tier \"domain\"\n    }\n\n    config {\n      filters : [FilterSpec] = [{\n        field: status\n        filterType: select\n        label: Status\n        options: (active inactive pending)\n      }]\n        @label \"Filter controls\"\n        @description \"Field, label, control type, and options for each filter input. numberrange renders a min/max slider pair (bounded by min/max/step) and emits one FILTER per side as `<field>_min` / `<field>_max`, mirroring daterange's `<field>_from` / `<field>_to` convention.\"\n        @synonyms \"numeric range, price range, min max, slider filter, range filter, threshold filter\"\n        @tier \"presentation\"\n      event : event = FILTER\n        @label \"Filter event\"\n        @description \"Event emitted when the user changes a filter selection\"\n        @tier \"internal\"\n      filterBarLook : \"toolbar\" | \"chips\" | \"pills\" | \"popover-trigger\" | \"inline-column-header\" = toolbar\n        @label \"Filter bar look\"\n        @description \"Layer 2 visual treatment for the filter bar.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/filtertargets\" as FilterTargetFilterPage -> FilterTargetFilter\n}"
}