  "source": "",
  "lolo": "app std-agent-builder \"1.0.0\"\n\"Agent builder organism — plan, build, validate, fix a single orbital end-to-end.\"\n\ntype OrbitalSpec = { orbitalName: string!, organism: string!, method: string!, deltaPrompt: string! }\n\norbital AgentBuilderOrbital {\n\n  entity BuilderProcess [runtime] {\n    request : string = \"\"\n    plan : string = \"\"\n    orbitalName : string = \"\"\n    spec : OrbitalSpec = {}\n    validationResult : string = \"\"\n    fixPrompt : string = \"\"\n    status : \"idle\" | \"done\" = idle\n  }\n\n  trait BuilderPipeline -> BuilderProcess [lifecycle, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.request \"\")\n        (set @entity.plan \"\")\n        (set @entity.orbitalName \"\")\n        (set @entity.validationResult \"\")\n        (set @entity.fixPrompt \"\")\n        (set @entity.status idle)\n      START -> planning\n        (set @entity.request ?request)\n        (set @entity.orbitalName ?orbitalName)\n        (llm/generate @entity.request { emit: { success: PLANNED, failure: PLAN_FAILED } })\n    }\n\n    state planning {\n      PLANNED -> done\n        (set @entity.plan ?result)\n        (behavior/instantiate @entity.orbitalName @entity.plan)\n        (validate/validate @entity.orbitalName)\n        (set @entity.status done)\n        (emit BUILD_COMPLETE { orbitalName: @entity.orbitalName, plan: @entity.plan })\n      PLAN_FAILED -> done\n        (set @entity.plan \"\")\n        (behavior/instantiate @entity.orbitalName @entity.plan)\n        (validate/validate @entity.orbitalName)\n        (set @entity.status done)\n        (emit BUILD_COMPLETE { orbitalName: @entity.orbitalName, plan: @entity.plan })\n    }\n\n    state done {\n      INIT -> done\n        (set @entity.status done)\n      RESET -> idle\n        (set @entity.request \"\")\n        (set @entity.plan \"\")\n        (set @entity.orbitalName \"\")\n        (set @entity.validationResult \"\")\n        (set @entity.fixPrompt \"\")\n        (set @entity.status idle)\n    }\n\n    emits {\n      BUILD_COMPLETE {\n        orbitalName : string!\n        plan : string!\n      }\n      PLANNED {\n        result : string!\n      }\n    }\n\n    listens {\n      START {\n        request : string!\n        orbitalName : string!\n      }\n      RETRY\n    }\n  }\n\n  trait BuilderListener -> BuilderProcess [lifecycle, instance] {\n    initial: waiting\n\n    state waiting {\n      INIT -> waiting\n        (set @entity.status idle)\n      BUILD_COMPLETE -> resolved\n        (set @entity.status done)\n    }\n\n    state resolved {\n      INIT -> resolved\n        (set @entity.status done)\n      RESET -> waiting\n        (set @entity.status idle)\n    }\n\n    listens {\n      BuilderPipeline.BUILD_COMPLETE -> BUILD_COMPLETE\n      RESET\n    }\n  }\n\n  page \"/agent-builder\" as AgentBuilderPage -> BuilderPipeline, BuilderListener\n}\n"
}