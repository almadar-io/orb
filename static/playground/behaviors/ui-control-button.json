  "source": "",
  "lolo": "app ui-control-button \"1.0.0\"\n\"ControlButton — UI factory (1:1 with the @almadar/ui control-button pattern).\"\norbital ControlButtonOrbital {\n  type ControlButtonAssetUrl = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n\n  entity ControlButtonItem [runtime] {\n    id : string!\n  }\n\n  trait ControlButtonRender -> @rebindable ControlButtonItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          assetUrl: @config.assetUrl\n          label: @config.label\n          icon: @config.icon\n          size: @config.size\n          shape: @config.shape\n          variant: @config.variant\n          onPress: @config.onPress\n          onRelease: @config.onRelease\n          pressEvent: @config.pressEvent\n          releaseEvent: @config.releaseEvent\n          pressed: @config.pressed\n          disabled: @config.disabled\n          className: @config.className\n          type: control-button\n        })\n    }\n\n    emits {\n      @config.onPress -> external {\n        id : string\n      }\n        @description \"Called when button is pressed\"\n        @tier \"essential\"\n      @config.onRelease -> external {\n        id : string\n      }\n        @description \"Called when button is released\"\n        @tier \"essential\"\n    }\n\n    config {\n      assetUrl : ControlButtonAssetUrl\n        @label \"Asset Url\"\n        @description \"Sprite asset — takes precedence over icon when provided\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Button label text\"\n        @tier \"presentation\"\n      icon : icon\n        @label \"Icon\"\n        @description \"Icon component or emoji\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" | \"xl\" = md\n        @label \"Size\"\n        @description \"Size variant\"\n        @tier \"presentation\"\n      shape : \"circle\" | \"rounded\" | \"square\" = circle\n        @label \"Shape\"\n        @description \"Shape variant\"\n        @tier \"presentation\"\n      variant : \"primary\" | \"secondary\" | \"ghost\" = secondary\n        @label \"Variant\"\n        @description \"Visual variant\"\n        @tier \"presentation\"\n      onPress : string = \"PRESS\"\n        @label \"On Press\"\n        @description \"Called when button is pressed\"\n        @tier \"presentation\"\n      onRelease : string = \"RELEASE\"\n        @label \"On Release\"\n        @description \"Called when button is released\"\n        @tier \"presentation\"\n      pressEvent : string = \"PRESS\"\n        @label \"Press Event\"\n        @description \"Declarative event name emitted on press via useEventBus\"\n        @tier \"presentation\"\n      releaseEvent : string = \"RELEASE\"\n        @label \"Release Event\"\n        @description \"Declarative event name emitted on release via useEventBus\"\n        @tier \"presentation\"\n      pressed : boolean\n        @label \"Pressed\"\n        @description \"Whether the button is currently pressed\"\n        @tier \"presentation\"\n      disabled : boolean\n        @label \"Disabled\"\n        @description \"Whether the button is disabled\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/control-button\" as ControlButtonPage -> ControlButtonRender\n}\n"
}