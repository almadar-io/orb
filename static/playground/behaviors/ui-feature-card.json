  "source": "",
  "lolo": "app ui-feature-card \"1.0.0\"\n\"FeatureCard — an icon-led card pairing a title and description to call out a single product feature. — UI factory (1:1 with the @almadar/ui feature-card pattern).\"\n;; @capabilities \"feature highlight, benefit callout, product capability card, feature-grid tile\"\norbital FeatureCardOrbital {\n  entity FeatureCardItem [runtime] {\n    id : string!\n  }\n\n  trait FeatureCardRender -> @rebindable FeatureCardItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          icon: @config.icon\n          title: @config.title\n          description: @config.description\n          href: @config.href\n          linkLabel: @config.linkLabel\n          variant: @config.variant\n          size: @config.size\n          className: @config.className\n          type: feature-card\n        })\n    }\n\n    config {\n      icon : icon\n        @label \"Icon\"\n        @description \"icon prop\"\n        @tier \"presentation\"\n      title : string = \"\"\n        @label \"Title\"\n        @description \"Feature title\"\n        @tier \"presentation\"\n      description : string = \"\"\n        @label \"Description\"\n        @description \"Feature description\"\n        @tier \"presentation\"\n      href : string\n        @label \"Href\"\n        @description \"Optional link URL\"\n        @tier \"presentation\"\n      linkLabel : string = \"Learn more\"\n        @label \"Link Label\"\n        @description \"Label for the link button\"\n        @tier \"presentation\"\n      variant : \"default\" | \"bordered\" | \"elevated\" | \"interactive\" = bordered\n        @label \"Variant\"\n        @description \"Card visual variant\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Card size affecting icon and spacing\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/feature-card\" as FeatureCardPage -> FeatureCardRender\n}\n"
}