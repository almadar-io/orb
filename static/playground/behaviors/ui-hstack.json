  "source": "",
  "lolo": "app ui-hstack \"1.0.0\"\n\"Hstack — UI factory (1:1 with the @almadar/ui hstack pattern).\"\norbital HstackOrbital {\n  entity HstackItem [runtime] {\n    id : string!\n  }\n\n  trait HstackRender -> @rebindable HstackItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          gap: @config.gap\n          align: @config.align\n          justify: @config.justify\n          wrap: @config.wrap\n          reverse: @config.reverse\n          flex: @config.flex\n          className: @config.className\n          style: @config.style\n          children: @config.children\n          role: @config.role\n          tabIndex: @config.tabIndex\n          action: @config.action\n          actionPayload: @config.actionPayload\n          responsive: @config.responsive\n          type: hstack\n        })\n    }\n\n    emits {\n      @config.action -> external {\n        id : string\n      }\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"essential\"\n    }\n\n    config {\n      gap : \"none\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" = md\n        @label \"Gap\"\n        @description \"Gap between children\"\n        @tier \"presentation\"\n      align : \"start\" | \"center\" | \"end\" | \"stretch\" | \"baseline\" = stretch\n        @label \"Align\"\n        @description \"Align items on the cross axis\"\n        @tier \"presentation\"\n      justify : \"start\" | \"center\" | \"end\" | \"between\" | \"around\" | \"evenly\" = start\n        @label \"Justify\"\n        @description \"Justify items on the main axis\"\n        @tier \"presentation\"\n      wrap : boolean = false\n        @label \"Wrap\"\n        @description \"Allow items to wrap\"\n        @tier \"presentation\"\n      reverse : boolean = false\n        @label \"Reverse\"\n        @description \"Reverse the order of children\"\n        @tier \"presentation\"\n      flex : boolean = false\n        @label \"Flex\"\n        @description \"Fill available space (flex: 1)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Custom class name\"\n        @tier \"presentation\"\n      style : Map string string = {}\n        @label \"Style\"\n        @description \"Inline styles\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Children elements\"\n        @tier \"presentation\"\n      role : string\n        @label \"Role\"\n        @description \"Role for accessibility\"\n        @tier \"presentation\"\n      tabIndex : number\n        @label \"Tab Index\"\n        @description \"Tab index for focus management\"\n        @tier \"presentation\"\n      action : string = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"presentation\"\n      actionPayload : json = {}\n        @label \"Action Payload\"\n        @description \"Payload to include with the action event\"\n        @tier \"presentation\"\n      responsive : boolean = false\n        @label \"Responsive\"\n        @description \"When true, horizontal stacks flip to vertical below the md breakpoint (768px)\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/hstack\" as HstackPage -> HstackRender\n}\n"
