  "source": "",
  "lolo": "app ui-gradient-divider \"1.0.0\"\n\"GradientDivider — UI factory (1:1 with the @almadar/ui gradient-divider pattern).\"\norbital GradientDividerOrbital {\n  entity GradientDividerItem [runtime] {\n    id : string!\n  }\n\n  trait GradientDividerRender -> @rebindable GradientDividerItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          color: @config.color\n          className: @config.className\n          type: gradient-divider\n        })\n    }\n\n    config {\n      color : string\n        @label \"Color\"\n        @description \"Semantic palette token or a raw CSS color value. Defaults to 'primary'.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/gradient-divider\" as GradientDividerPage -> GradientDividerRender\n}\n"
