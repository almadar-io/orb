  "source": "",
  "lolo": "app ui-menu \"1.0.0\"\n\"Menu — UI factory (1:1 with the @almadar/ui menu pattern).\"\norbital MenuOrbital {\n  type MenuItemsItem = {\n    id : string\n    label : string!\n    icon : icon\n    badge : string\n    disabled : boolean\n    event : event\n    url : string\n    variant : \"default\" | \"danger\"\n    subMenu : [MenuItemsItem]\n  }\n\n  entity MenuItem [runtime] {\n    id : string!\n  }\n\n  trait MenuRender -> @rebindable MenuItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          trigger: @config.trigger\n          items: @config.items\n          position: @config.position\n          className: @config.className\n          header: @config.header\n          footer: @config.footer\n          type: menu\n        })\n    }\n\n    config {\n      trigger : node\n        @label \"Trigger\"\n        @description \"Menu trigger element\"\n        @tier \"presentation\"\n      items : [MenuItemsItem] = [{ id: \"Id\", label: \"Label\", icon: \"circle\", badge: \"Badge\", disabled: false, url: \"Url\", variant: default, subMenu: [] }, { id: \"Id 2\", label: \"Label 2\", icon: \"circle\", badge: \"Badge 2\", disabled: true, url: \"Url 2\", variant: danger, subMenu: [] }]\n        @label \"Items\"\n        @description \"Menu items\"\n        @tier \"presentation\"\n      position : \"top-left\" | \"top-right\" | \"bottom-left\" | \"bottom-right\" | \"top-start\" | \"top-end\" | \"bottom-start\" | \"bottom-end\" = \"bottom-left\"\n        @label \"Position\"\n        @description \"Menu position\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      header : node\n        @label \"Header\"\n        @description \"Optional slot rendered above the items.\"\n        @tier \"presentation\"\n      footer : node\n        @label \"Footer\"\n        @description \"Optional slot rendered below the items.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/menu\" as MenuPage -> MenuRender\n}\n"
}