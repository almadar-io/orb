  "source": "",
  "lolo": "app ui-qr-scanner \"1.0.0\"\n\"QrScanner — UI factory (1:1 with the @almadar/ui qr-scanner pattern).\"\norbital QrScannerOrbital {\n  type QrScannerSCANResult = {\n    text : string!\n    format : string!\n    timestamp : number!\n  }\n\n  entity QrScannerItem [runtime] {\n    id : string!\n  }\n\n  trait QrScannerRender -> @rebindable QrScannerItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          onScan: @config.onScan\n          scanEvent: @config.scanEvent\n          facingMode: @config.facingMode\n          paused: @config.paused\n          showOverlay: @config.showOverlay\n          showCameraControls: @config.showCameraControls\n          fallback: @config.fallback\n          className: @config.className\n          type: qr-scanner\n        })\n    }\n\n    emits {\n      @config.onScan -> external {\n        result : QrScannerSCANResult\n        text : string!\n        format : string!\n        timestamp : number!\n      }\n        @description \"onScan prop\"\n        @tier \"essential\"\n    }\n\n    config {\n      onScan : event = \"SCAN\"\n        @label \"On Scan\"\n        @description \"onScan prop\"\n        @tier \"presentation\"\n      scanEvent : event = \"SCAN\"\n        @label \"Scan Event\"\n        @description \"scanEvent prop\"\n        @tier \"presentation\"\n      facingMode : \"environment\" | \"user\" = environment\n        @label \"Facing Mode\"\n        @description \"facingMode prop\"\n        @tier \"presentation\"\n      paused : boolean = false\n        @label \"Paused\"\n        @description \"paused prop\"\n        @tier \"presentation\"\n      showOverlay : boolean = true\n        @label \"Show Overlay\"\n        @description \"showOverlay prop\"\n        @tier \"presentation\"\n      showCameraControls : boolean = true\n        @label \"Show Camera Controls\"\n        @description \"showCameraControls prop\"\n        @tier \"presentation\"\n      fallback : node\n        @label \"Fallback\"\n        @description \"fallback prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/qr-scanner\" as QrScannerPage -> QrScannerRender\n}\n"
}