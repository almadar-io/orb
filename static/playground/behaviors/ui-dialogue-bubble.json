  "source": "",
  "lolo": "app ui-dialogue-bubble \"1.0.0\"\n\"DialogueBubble — UI factory (1:1 with the @almadar/ui dialogue-bubble pattern).\"\norbital DialogueBubbleOrbital {\n  type DialogueBubblePortrait = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n\n  entity DialogueBubbleItem [runtime] {\n    id : string!\n  }\n\n  trait DialogueBubbleRender -> @rebindable DialogueBubbleItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          speaker: @config.speaker\n          text: @config.text\n          portrait: @config.portrait\n          position: @config.position\n          mood: @config.mood\n          revealedChars: @config.revealedChars\n          className: @config.className\n          type: dialogue-bubble\n        })\n    }\n\n    config {\n      speaker : string = Hero\n        @label \"Speaker\"\n        @description \"Speaker name displayed at the top\"\n        @tier \"presentation\"\n      text : string = \"The dungeon awaits. Choose your path wisely.\"\n        @label \"Text\"\n        @description \"Dialogue text content\"\n        @tier \"presentation\"\n      portrait : DialogueBubblePortrait\n        @label \"Portrait\"\n        @description \"Speaker portrait asset\"\n        @tier \"presentation\"\n      position : \"top\" | \"bottom\" = bottom\n        @label \"Position\"\n        @description \"Position of the bubble on screen\"\n        @tier \"presentation\"\n      mood : \"neutral\" | \"happy\" | \"concerned\" | \"angry\" = neutral\n        @label \"Mood\"\n        @description \"Speaker mood — drives a portrait-ring accent; LOLO sets this per dialogue node/transition.\"\n        @tier \"presentation\"\n      revealedChars : number\n        @label \"Revealed Chars\"\n        @description \"Number of `text` characters to reveal (typewriter effect). Omit to show the full string — LOLO drives this from `@entity.revealedChars` via a tick, incrementing it until it reaches `text.length`.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/dialogue-bubble\" as DialogueBubblePage -> DialogueBubbleRender\n}\n"
}