  "source": "",
  "lolo": "app std-agent-trace \"2.0.0\"\n\"std-agent-trace — the persisted record of what an in-app assistant did. Each REPLIED (from std-agent-tool-loop) stores one AgentRun row: the reply, every tool step (which input or entity, the arguments, whether it took effect and why not), the tokens and the model calls; each REPLY_FAILED stores a failed run with its error. The record verification grades and later optimisation reads, in one format for tests and production. AgentTraceRecorder is headless; AgentRunBrowse is the run list. Rows carry ownerId (the real @user); the binding organism scopes @read.\"\n\ntype AgentStep = {\n  kind : \"input\" | \"read\" | \"invalid\"\n  target : string!\n  args : string!\n  ok : boolean!\n  detail : string\n}\ntype AgentUsage = {\n  promptTokens : number!\n  completionTokens : number!\n  totalTokens : number!\n  modelCalls : number!\n}\n\norbital AgentTraceOrbital {\n  type AgentRunsLoaded = Event { data : [AgentRun] } \"Fired when the run record finishes loading\"\n  type AgentRunsLoadFailed = Event { error : string, code : string } \"Fired when the run record fails to load\"\n\n  entity AgentRun [persistent: agentRuns] {\n    id : string!\n    ownerId : string! @description \"Whose request this run answered (the real @user). The binding organism scopes @read to it.\" @synonyms \"user, owner, account\"\n    outcome : \"answered\" | \"failed\" @description \"Whether the assistant answered.\" @synonyms \"result, status\" = answered\n    reply : string @description \"What the assistant said.\" @synonyms \"answer, response\" = \"\"\n    error : string @description \"Why the run failed.\" = \"\"\n    steps : [AgentStep] @description \"Every tool use, in order.\" @synonyms \"actions, tool calls, trace\" = []\n    promptTokens : number @description \"Tokens sent to the model.\" = 0\n    completionTokens : number @description \"Tokens the model produced.\" = 0\n    totalTokens : number @description \"All tokens for the run.\" = 0\n    modelCalls : number @description \"Model round-trips.\" @synonyms \"turns, calls\" = 0\n    recordedAt : number @description \"When the run finished (ms).\" @synonyms \"time, timestamp\" = 0\n  }\n\n  trait AgentTraceRecorder -> @rebindable AgentRun [lifecycle] {\n    initial: recording\n\n    state recording {\n      INIT -> recording\n        (set @entity.outcome answered)\n      REPLIED -> recording\n        (persist create AgentRun {\n          ownerId: @user.id\n          outcome: answered\n          reply: ?reply\n          steps: ?steps\n          promptTokens: ?usage.promptTokens\n          completionTokens: ?usage.completionTokens\n          totalTokens: ?usage.totalTokens\n          modelCalls: ?usage.modelCalls\n          recordedAt: @now\n        } {\n          emit: { success: RUN_RECORDED }\n        })\n      REPLY_FAILED -> recording\n        (persist create AgentRun {\n          ownerId: @user.id\n          outcome: failed\n          error: ?error\n          recordedAt: @now\n        } {\n          emit: { success: RUN_RECORDED }\n        })\n      RUN_RECORDED -> recording\n        (set @entity.outcome answered)\n    }\n\n    emits {\n      RUN_RECORDED -> external\n        @description \"A run was recorded — payload is the created AgentRun row itself.\"\n        @synonyms \"recorded, logged, traced\"\n        @tier \"domain\"\n    }\n\n    listens {\n      REPLIED {\n        reply : string!\n        steps : [AgentStep]!\n        usage : AgentUsage!\n      }\n        @description \"Record an answered run.\"\n      REPLY_FAILED {\n        error : string!\n      }\n        @description \"Record a failed run.\"\n    }\n  }\n\n  trait AgentRunBrowse -> @rebindable AgentRun [interaction, collection] {\n    initial: browsing\n\n    state browsing {\n      INIT -> browsing\n        (fetch AgentRun {\n          emit: { failure: AgentRunsLoadFailed, success: AgentRunsLoaded }\n        })\n        (render-ui main { type: skeleton, variant: list, rows: 6 })\n      AgentRunsLoaded -> browsing\n        (render-ui main {\n          emptyTitle: \"No runs yet\"\n          entity: (array/sort ?data recordedAt desc)\n          fields: []\n          gap: sm\n          renderItem: (fn item {\n            children: [{\n              label: @item.outcome\n              size: sm\n              type: badge\n              variant: neutral\n            }, {\n              content: @item.reply\n              type: typography\n              variant: body\n            }, {\n              content: (str/concat @item.modelCalls \" model calls, \" @item.totalTokens \" tokens\")\n              type: typography\n              variant: caption\n            }]\n            direction: vertical\n            gap: xs\n            type: stack\n          })\n          type: data-list\n        })\n      AgentRunsLoadFailed -> browsing\n        (render-ui main {\n          message: ?error\n          type: alert\n          variant: error\n        })\n      RUN_RECORDED -> browsing\n        (fetch AgentRun {\n          emit: { failure: AgentRunsLoadFailed, success: AgentRunsLoaded }\n        })\n    }\n\n    emits {\n      AgentRunsLoaded {\n        data : [AgentRun]\n      }\n        @description \"The run record finished loading.\"\n        @tier \"internal\"\n      AgentRunsLoadFailed {\n        error : string\n        code : string\n      }\n        @tier \"internal\"\n    }\n\n    listens {\n      AgentTraceRecorder.RUN_RECORDED -> RUN_RECORDED\n    }\n  }\n\n  page \"/agent-trace\" as AgentTracePage -> AgentRunBrowse, AgentTraceRecorder\n}\n"
}