  "source": "",
  "lolo": "app std-agent-trace \"1.0.0\"\n\"Wraps trace/emit + trace/log — observability for agent loops.\"\norbital AgentTraceOrbital {\n\n  entity AgentTrace [runtime] {\n    event : string = \"\"\n    level : string = \"info\"\n    message : string = \"\"\n  }\n\n  trait TraceEmitter -> AgentTrace [lifecycle, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.event \"\")\n        (set @entity.level \"info\")\n        (set @entity.message \"\")\n      EMIT_TRACE -> idle\n        (set @entity.event ?event)\n        (trace/emit @entity.event)\n        (emit TRACED)\n      LOG_TRACE -> idle\n        (set @entity.level ?level)\n        (set @entity.message ?message)\n        (trace/log @entity.level @entity.message)\n        (emit TRACED)\n    }\n\n    emits {\n      TRACED\n    }\n\n    listens {\n      EMIT_TRACE {\n        event : string!\n      }\n      LOG_TRACE {\n        level : string!\n        message : string!\n      }\n    }\n  }\n\n  trait TraceListener -> AgentTrace [lifecycle, instance] {\n    initial: ready\n\n    state ready {\n      INIT -> ready\n        (set @entity.event \"\")\n        (set @entity.level \"info\")\n        (set @entity.message \"\")\n      TRACED -> ready\n        (set @entity.event \"\")\n        (set @entity.message \"\")\n    }\n\n    listens {\n      TraceEmitter.TRACED -> TRACED\n    }\n  }\n\n  page \"/agent-trace\" as AgentTracePage -> TraceEmitter, TraceListener\n}\n"
}