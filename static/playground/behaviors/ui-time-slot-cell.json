  "source": "",
  "lolo": "app ui-time-slot-cell \"1.0.0\"\n\"TimeSlotCell — UI factory (1:1 with the @almadar/ui time-slot-cell pattern).\"\norbital TimeSlotCellOrbital {\n  entity TimeSlotCellItem [runtime] {\n    id : string!\n    time : string = \"\"\n  }\n\n  trait TimeSlotCellRender -> @rebindable TimeSlotCellItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.time @config.time)\n        (render-ui main {\n          time: @entity.time\n          onClick: @config.onClick\n          className: @config.className\n          children: @config.children\n          isOccupied: @config.isOccupied\n          type: time-slot-cell\n        })\n      CLICK -> idle\n        (set @entity.time ?time)\n        (render-ui main {\n          time: @entity.time\n          onClick: @config.onClick\n          className: @config.className\n          children: @config.children\n          isOccupied: @config.isOccupied\n          type: time-slot-cell\n        })\n    }\n\n    emits {\n      @config.onClick -> external {\n        time : string\n      }\n        @description \"Called when the slot is clicked\"\n        @tier \"essential\"\n    }\n\n    listens {\n      CLICK {\n        time : string\n      }\n    }\n\n    config {\n      time : string = \"\"\n        @label \"Time\"\n        @description \"Time label for this slot (e.g. '09:00')\"\n        @tier \"presentation\"\n      onClick : event = \"CLICK\"\n        @label \"On Click\"\n        @description \"Called when the slot is clicked\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Event content placed inside the slot\"\n        @tier \"presentation\"\n      isOccupied : boolean = false\n        @label \"Is Occupied\"\n        @description \"Whether this slot contains an event\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/time-slot-cell\" as TimeSlotCellPage -> TimeSlotCellRender\n}\n"
}