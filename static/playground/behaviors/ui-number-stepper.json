  "source": "",
  "lolo": "app ui-number-stepper \"1.0.0\"\n\"NumberStepper — UI factory (1:1 with the @almadar/ui number-stepper pattern).\"\norbital NumberStepperOrbital {\n  entity NumberStepperItem [runtime] {\n    id : string!\n    value : number = 0\n  }\n\n  trait NumberStepperRender -> @rebindable NumberStepperItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.value @config.value)\n        (render-ui main {\n          value: @entity.value\n          min: @config.min\n          max: @config.max\n          step: @config.step\n          size: @config.size\n          disabled: @config.disabled\n          onChange: @config.onChange\n          action: @config.action\n          actionPayload: @config.actionPayload\n          className: @config.className\n          label: @config.label\n          type: number-stepper\n        })\n      CHANGE -> idle\n        (set @entity.value ?value)\n        (render-ui main {\n          value: @entity.value\n          min: @config.min\n          max: @config.max\n          step: @config.step\n          size: @config.size\n          disabled: @config.disabled\n          onChange: @config.onChange\n          action: @config.action\n          actionPayload: @config.actionPayload\n          className: @config.className\n          label: @config.label\n          type: number-stepper\n        })\n      ACTION -> idle\n        (set @entity.value ?value)\n        (render-ui main {\n          value: @entity.value\n          min: @config.min\n          max: @config.max\n          step: @config.step\n          size: @config.size\n          disabled: @config.disabled\n          onChange: @config.onChange\n          action: @config.action\n          actionPayload: @config.actionPayload\n          className: @config.className\n          label: @config.label\n          type: number-stepper\n        })\n    }\n\n    emits {\n      @config.onChange -> external {\n        value : number\n      }\n        @description \"Direct onChange callback\"\n        @tier \"essential\"\n      @config.action -> external {\n        value : number!\n      }\n        @description \"Declarative event name for value changes\"\n        @tier \"essential\"\n    }\n\n    listens {\n      CHANGE {\n        value : number\n      }\n      ACTION {\n        value : number!\n      }\n    }\n\n    config {\n      value : number = 0\n        @label \"Value\"\n        @description \"Current value\"\n        @tier \"presentation\"\n      min : number\n        @label \"Min\"\n        @description \"Minimum value\"\n        @tier \"presentation\"\n      max : number\n        @label \"Max\"\n        @description \"Maximum value\"\n        @tier \"presentation\"\n      step : number = 1\n        @label \"Step\"\n        @description \"Step increment\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Size variant\"\n        @tier \"presentation\"\n      disabled : boolean = false\n        @label \"Disabled\"\n        @description \"Disabled state\"\n        @tier \"presentation\"\n      onChange : event = \"CHANGE\"\n        @label \"On Change\"\n        @description \"Direct onChange callback\"\n        @tier \"presentation\"\n      action : event = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event name for value changes\"\n        @tier \"presentation\"\n      actionPayload : @payload @config.action\n        @label \"Action Payload\"\n        @description \"Payload to include with the action event\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Accessible label\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/number-stepper\" as NumberStepperPage -> NumberStepperRender\n}\n"
}