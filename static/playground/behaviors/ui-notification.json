  "source": "",
  "lolo": "app ui-notification \"1.0.0\"\n\"Notification — UI factory (1:1 with the @almadar/ui notification pattern).\"\norbital NotificationOrbital {\n  entity NotificationItem [runtime] {\n    id : string!\n  }\n\n  trait NotificationRender -> @rebindable NotificationItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          variant: @config.variant\n          message: @config.message\n          title: @config.title\n          duration: @config.duration\n          dismissible: @config.dismissible\n          onDismiss: @config.onDismiss\n          actionLabel: @config.actionLabel\n          onAction: @config.onAction\n          badge: @config.badge\n          className: @config.className\n          dismissEvent: @config.dismissEvent\n          actionEvent: @config.actionEvent\n          type: notification\n        })\n    }\n\n    emits {\n      @config.onDismiss -> external { }\n        @description \"Callback when toast is dismissed\"\n        @tier \"essential\"\n      @config.onAction -> external { }\n        @description \"Action button click handler\"\n        @tier \"essential\"\n    }\n\n    config {\n      variant : \"success\" | \"error\" | \"info\" | \"warning\" = info\n        @label \"Variant\"\n        @description \"Toast variant\"\n        @tier \"presentation\"\n      message : string = \"\"\n        @label \"Message\"\n        @description \"Toast message\"\n        @tier \"presentation\"\n      title : string\n        @label \"Title\"\n        @description \"Toast title (optional)\"\n        @tier \"presentation\"\n      duration : number = 5000\n        @label \"Duration\"\n        @description \"Auto-dismiss duration in milliseconds (0 = no auto-dismiss)\"\n        @tier \"presentation\"\n      dismissible : boolean = true\n        @label \"Dismissible\"\n        @description \"Show dismiss button\"\n        @tier \"presentation\"\n      onDismiss : event = \"DISMISS\"\n        @label \"On Dismiss\"\n        @description \"Callback when toast is dismissed\"\n        @tier \"presentation\"\n      actionLabel : string\n        @label \"Action Label\"\n        @description \"Action button label\"\n        @tier \"presentation\"\n      onAction : event = \"ACTION\"\n        @label \"On Action\"\n        @description \"Action button click handler\"\n        @tier \"presentation\"\n      badge : string\n        @label \"Badge\"\n        @description \"Badge count (optional)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      dismissEvent : event = \"DISMISS\"\n        @label \"Dismiss Event\"\n        @description \"Declarative dismiss event — emits UI:{dismissEvent} via eventBus when toast is dismissed\"\n        @tier \"presentation\"\n      actionEvent : event = \"ACTION\"\n        @label \"Action Event\"\n        @description \"Declarative action event — emits UI:{actionEvent} via eventBus when action button is clicked\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/notification\" as NotificationPage -> NotificationRender\n}\n"
}