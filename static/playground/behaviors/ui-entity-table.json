  "lolo": "app ui-entity-table \"1.0.0\"\n\"EntityTable — UI factory (1:1 with the @almadar/ui entity-table pattern).\"\norbital EntityTableOrbital {\n    type EntityTableLoaded = Event { data : [EntityTableItem] } \"EntityTable rows finished loading; payload.data holds the collection\"\n  type EntityTableError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type EntityTableFieldsItem = {\n    key : string\n    header : string\n    name : string\n    label : string\n    width : string\n    sortable : boolean\n  }\n  type EntityTableColumnsItem = {\n    key : string\n    header : string\n    name : string\n    label : string\n    width : string\n    sortable : boolean\n  }\n  type EntityTableItemActionsItem = {\n    label : string!\n    event : string\n    navigatesTo : string\n    action : string\n    placement : \"row\" | \"bulk\"\n    icon : icon\n    variant : \"default\" | \"primary\" | \"secondary\" | \"ghost\" | \"danger\"\n  }\n  type EntityTableEmptyAction = {\n    label : string!\n    event : string\n  }\n  type EntityTableRowActionsItem = {\n    label : string!\n    icon : icon\n    variant : \"default\" | \"danger\"\n    event : string\n  }\n  type EntityTableBulkActionsItem = {\n    label : string!\n    icon : icon\n    variant : \"default\" | \"danger\"\n    event : string\n  }\n\n  entity EntityTableItem [runtime] {\n    id : string!\n  }\n\n  trait EntityTableRender -> @rebindable EntityTableItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (fetch EntityTableItem { emit: { success: EntityTableLoaded } })\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          fields: @config.fields\n          columns: @config.columns\n          itemActions: @config.itemActions\n          emptyIcon: @config.emptyIcon\n          emptyTitle: @config.emptyTitle\n          emptyDescription: @config.emptyDescription\n          emptyAction: @config.emptyAction\n          selectable: @config.selectable\n          searchable: @config.searchable\n          searchPlaceholder: @config.searchPlaceholder\n          rowActions: @config.rowActions\n          bulkActions: @config.bulkActions\n          headerActions: @config.headerActions\n          showTotal: @config.showTotal\n          look: @config.look\n          type: entity-table\n        })\n      EntityTableLoaded -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @payload.data\n          fields: @config.fields\n          columns: @config.columns\n          itemActions: @config.itemActions\n          emptyIcon: @config.emptyIcon\n          emptyTitle: @config.emptyTitle\n          emptyDescription: @config.emptyDescription\n          emptyAction: @config.emptyAction\n          selectable: @config.selectable\n          searchable: @config.searchable\n          searchPlaceholder: @config.searchPlaceholder\n          rowActions: @config.rowActions\n          bulkActions: @config.bulkActions\n          headerActions: @config.headerActions\n          showTotal: @config.showTotal\n          look: @config.look\n          type: entity-table\n        })\n    }\n\n    emits {\n      VIEW -> external {\n        id : string\n      }\n        @description \"User opened a record from the list.\"\n        @tier \"essential\"\n      EntityTableLoaded\n        @description \"EntityTable rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : EntityTableError\n        @label \"Error\"\n        @description \"Error state (UiError)\"\n        @tier \"presentation\"\n      sortBy : string\n        @label \"Sort By\"\n        @description \"Current sort field\"\n        @tier \"presentation\"\n      sortDirection : \"asc\" | \"desc\" = asc\n        @label \"Sort Direction\"\n        @description \"Current sort direction\"\n        @tier \"presentation\"\n      searchValue : string\n        @label \"Search Value\"\n        @description \"Current search query value\"\n        @tier \"presentation\"\n      pageProp : number\n        @label \"Page\"\n        @description \"Current page number\"\n        @synonyms \"page\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Number of items per page\"\n        @tier \"presentation\"\n      totalCount : number\n        @label \"Total Count\"\n        @description \"Total number of items\"\n        @tier \"presentation\"\n      activeFilters : Map string string = {}\n        @label \"Active Filters\"\n        @description \"Active filters\"\n        @tier \"presentation\"\n      selectedIds : [string] = []\n        @label \"Selected Ids\"\n        @description \"Currently selected item IDs\"\n        @tier \"presentation\"\n      fields : [EntityTableFieldsItem] = [{ key: \"Key\", header: \"Header\", name: \"Name\", label: \"Label\", width: \"Width\", sortable: false }, { key: \"Key 2\", header: \"Header 2\", name: \"Name 2\", label: \"Label 2\", width: \"Width 2\", sortable: true }]\n        @label \"Fields\"\n        @description \"Fields to display - accepts string[] or Column[] for unified interface. Alias for columns\"\n        @tier \"presentation\"\n      columns : [EntityTableColumnsItem] = []\n        @label \"Columns\"\n        @description \"Columns can be Column objects or simple string field names\"\n        @tier \"presentation\"\n      itemActions : [EntityTableItemActionsItem] = [{ event: VIEW, label: View, variant: ghost }]\n        @label \"Item Actions\"\n        @description \"Item actions from generated code - maps to rowActions\"\n        @tier \"presentation\"\n      emptyIcon : icon\n        @label \"Empty Icon\"\n        @description \"emptyIcon prop\"\n        @tier \"presentation\"\n      emptyTitle : string\n        @label \"Empty Title\"\n        @description \"emptyTitle prop\"\n        @tier \"presentation\"\n      emptyDescription : string\n        @label \"Empty Description\"\n        @description \"emptyDescription prop\"\n        @tier \"presentation\"\n      emptyAction : EntityTableEmptyAction\n        @label \"Empty Action\"\n        @description \"emptyAction prop\"\n        @tier \"presentation\"\n      selectable : boolean = false\n        @label \"Selectable\"\n        @description \"Selection\"\n        @tier \"presentation\"\n      searchable : boolean = false\n        @label \"Searchable\"\n        @description \"Search\"\n        @tier \"presentation\"\n      searchPlaceholder : string\n        @label \"Search Placeholder\"\n        @description \"searchPlaceholder prop\"\n        @tier \"presentation\"\n      rowActions : [EntityTableRowActionsItem] = []\n        @label \"Row Actions\"\n        @description \"Row actions\"\n        @tier \"presentation\"\n      bulkActions : [EntityTableBulkActionsItem] = []\n        @label \"Bulk Actions\"\n        @description \"Bulk actions\"\n        @tier \"presentation\"\n      headerActions : node\n        @label \"Header Actions\"\n        @description \"Header actions\"\n        @tier \"presentation\"\n      showTotal : boolean = true\n        @label \"Show Total\"\n        @description \"Show total count in pagination\"\n        @tier \"presentation\"\n      look : \"dense\" | \"spacious\" | \"striped\" | \"borderless\" | \"card-rows\" = dense\n        @label \"Look\"\n        @description \"Layer 2 visual treatment — orthogonal to the semantic variant.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/entity-table\" as EntityTablePage -> EntityTableRender\n}\n"
