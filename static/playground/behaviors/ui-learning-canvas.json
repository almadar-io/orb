  "source": "",
  "lolo": "app ui-learning-canvas \"1.0.0\"\n\"LearningCanvas — UI factory (1:1 with the @almadar/ui learning-canvas pattern).\"\norbital LearningCanvasOrbital {\n  type LearningCanvasShapesItem = {\n    type : \"line\" | \"arrow\" | \"circle\" | \"ellipse\" | \"rect\" | \"polygon\" | \"path\" | \"text\" | \"axis\" | \"grid\" | \"venn-region\"!\n    id : string\n    x : number\n    y : number\n    x1 : number\n    y1 : number\n    x2 : number\n    y2 : number\n    radius : number\n    width : number\n    height : number\n    points : [LearningCanvasShapesItemPointsItem]\n    path : string\n    text : string\n    label : string\n    fontSize : number\n    align : \"left\" | \"center\" | \"right\"\n    axis : \"x\" | \"y\"\n    min : number\n    max : number\n    step : number\n    color : string\n    fill : string\n    lineWidth : number\n    opacity : number\n    startAngle : number\n    endAngle : number\n    dash : \"dashed\" | \"dotted\"\n    inside : [string]\n    outside : [string]\n  }\n  type LearningCanvasShapesItemPointsItem = {\n    x : number!\n    y : number!\n  }\n  type LearningCanvasReadoutsItem = {\n    label : string!\n    value : string!\n    color : string\n  }\n  type LearningCanvasTracesItem = {\n    x : number\n    y : number\n    width : number\n    height : number\n    series : [LearningCanvasTracesItemSeriesItem]!\n    xLabel : string\n    yLabel : string\n    frameColor : string\n    backgroundColor : string\n    backgroundOpacity : number\n  }\n  type LearningCanvasTracesItemSeriesItem = {\n    samples : [LearningCanvasTracesItemSeriesItemSamplesItem]!\n    color : string\n    label : string\n  }\n  type LearningCanvasTracesItemSeriesItemSamplesItem = {\n    x : number!\n    y : number!\n  }\n  type LearningCanvasError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type LearningCanvasSHAPECLICKPayload = {\n    id : string\n    type : string\n    index : number!\n  }\n  type LearningCanvasSHAPEHOVERPayload = {\n    id : string\n    type : string\n    index : number!\n  }\n\n  entity LearningCanvasItem [runtime] {\n    id : string!\n  }\n\n  trait LearningCanvasRender -> @rebindable LearningCanvasItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          width: @config.width\n          height: @config.height\n          backgroundColor: @config.backgroundColor\n          shapes: @config.shapes\n          readouts: @config.readouts\n          traces: @config.traces\n          interactive: @config.interactive\n          animate: @config.animate\n          onShapeClick: @config.onShapeClick\n          onShapeHover: @config.onShapeHover\n          isLoading: @config.isLoading\n          error: @config.error\n          type: learning-canvas\n        })\n      UPDATE -> idle\n        (render-ui main {\n          className: @config.className\n          width: @config.width\n          height: @config.height\n          backgroundColor: @config.backgroundColor\n          shapes: @payload.shapes\n          readouts: @payload.readouts\n          traces: @payload.traces\n          interactive: @config.interactive\n          animate: @config.animate\n          onShapeClick: @config.onShapeClick\n          onShapeHover: @config.onShapeHover\n          isLoading: @config.isLoading\n          error: @config.error\n          type: learning-canvas\n        })\n    }\n\n    emits {\n      @config.onShapeClick -> external {\n        payload : LearningCanvasSHAPECLICKPayload\n      }\n        @description \"Clicked shape payload: { id?, type?, index }.\"\n        @tier \"essential\"\n      @config.onShapeHover -> external {\n        payload : LearningCanvasSHAPEHOVERPayload\n      }\n        @description \"Hovered shape payload: { id?, type?, index }.\"\n        @tier \"essential\"\n    }\n\n    listens {\n      UPDATE {\n        shapes : [LearningCanvasShapesItem]\n        readouts : [LearningCanvasReadoutsItem]\n        traces : [LearningCanvasTracesItem]\n      }\n        @description \"Live scene update; payload carries the current drawable state.\"\n        @synonyms \"tick, redraw, animate, frame\"\n        @tier \"domain\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes.\"\n        @tier \"presentation\"\n      width : number = 600\n        @label \"Width\"\n        @description \"Canvas width in CSS pixels.\"\n        @tier \"presentation\"\n      height : number = 400\n        @label \"Height\"\n        @description \"Canvas height in CSS pixels.\"\n        @tier \"presentation\"\n      backgroundColor : string\n        @label \"Background Color\"\n        @description \"Background color (default transparent).\"\n        @tier \"presentation\"\n      shapes : [LearningCanvasShapesItem] = []\n        @label \"Shapes\"\n        @description \"Declarative shapes to draw.\"\n        @tier \"presentation\"\n      readouts : [LearningCanvasReadoutsItem] = []\n        @label \"Readouts\"\n        @description \"Top-right status chip row (live measurements, scores, counters).\"\n        @synonyms \"chips, stats, measurements\"\n        @tier \"presentation\"\n      traces : [LearningCanvasTracesItem] = []\n        @label \"Traces\"\n        @description \"Inset sparkline panels stacked from the bottom-right corner.\"\n        @synonyms \"sparkline, time series, history plot\"\n        @tier \"presentation\"\n      interactive : boolean = false\n        @label \"Interactive\"\n        @description \"Enable pointer interaction (click/hover).\"\n        @tier \"presentation\"\n      animate : boolean = false\n        @label \"Animate\"\n        @description \"Enable continuous redraw loop.\"\n        @tier \"presentation\"\n      onShapeClick : event = \"SHAPE_CLICK\"\n        @label \"On Shape Click\"\n        @description \"Clicked shape payload: { id?, type?, index }.\"\n        @tier \"presentation\"\n      onShapeHover : event = \"SHAPE_HOVER\"\n        @label \"On Shape Hover\"\n        @description \"Hovered shape payload: { id?, type?, index }.\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state.\"\n        @tier \"presentation\"\n      error : LearningCanvasError\n        @label \"Error\"\n        @description \"Error state.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/learning-canvas\" as LearningCanvasPage -> LearningCanvasRender\n}\n"
}