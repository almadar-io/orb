  "source": "",
  "lolo": "app std-marketing-footer \"1.0.0\"\n\"Marketing footer atom for marketing pages. Renders a full footer with link columns, logo, and copyright. Pick for every marketing page bottom.\"\n;; Config-driven footer using the `marketing-footer` marketing pattern.\n;; Columns are declared as an array of { title, items: [{ label, href }] } objects.\n;; The atom renders immediately on INIT with no fetch required.\norbital FooterItemOrbital {\n    type FooterLink = { label : string!, href : string! }\n\n  type FooterColumn = { title : string!, items : [FooterLink] }\n\n  type FooterLogo = { alt : string, href : string, src : string }\n\n  uses MarketingFooter from \"std/behaviors/ui-marketing-footer\"\n\n  entity FooterItem [runtime] {\n    id : string!\n  }\n\n  trait FooterItemFooter = MarketingFooter.traits.MarketingFooterRender -> FooterItem {\n    config {\n      columns : [FooterColumn] = [{\n        items: [{\n          href: \"#\"\n          label: Features\n        }, {\n          href: \"#\"\n          label: Pricing\n        }, {\n          href: \"#\"\n          label: Changelog\n        }]\n        title: Product\n      }, {\n        items: [{\n          href: \"#\"\n          label: About\n        }, {\n          href: \"#\"\n          label: Careers\n        }, {\n          href: \"#\"\n          label: Blog\n        }]\n        title: Company\n      }, {\n        items: [{\n          href: \"#\"\n          label: Docs\n        }, {\n          href: \"#\"\n          label: Community\n        }, {\n          href: \"#\"\n          label: Support\n        }]\n        title: Resources\n      }]\n        @label \"Footer Columns\"\n        @description \"Array of link column groups\"\n        @tier \"presentation\"\n      copyright : string = \"© 2026 Almadar. All rights reserved.\"\n        @label \"Copyright\"\n        @tier \"presentation\"\n      logo : FooterLogo = { alt: \"\", href: \"/\", src: \"\" }\n        @label \"Logo\"\n        @description \"Logo image with link and alt text\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/footer\" as FooterItemFooterPage -> FooterItemFooter\n}"
}