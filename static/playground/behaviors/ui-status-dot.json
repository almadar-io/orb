  "source": "",
  "lolo": "app ui-status-dot \"1.0.0\"\n\"StatusDot — UI factory (1:1 with the @almadar/ui status-dot pattern).\"\norbital StatusDotOrbital {\n  entity StatusDotItem [runtime] {\n    id : string!\n  }\n\n  trait StatusDotRender -> @rebindable StatusDotItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          status: @config.status\n          pulse: @config.pulse\n          size: @config.size\n          label: @config.label\n          type: status-dot\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes applied to the root element.\"\n        @tier \"presentation\"\n      status : \"online\" | \"offline\" | \"away\" | \"busy\" | \"warning\" | \"critical\" = offline\n        @label \"Status\"\n        @description \"Status determines the dot color\"\n        @tier \"presentation\"\n      pulse : boolean = false\n        @label \"Pulse\"\n        @description \"Enable pulse animation for active/critical states\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Dot size\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Accessible label (rendered as sr-only text)\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/status-dot\" as StatusDotPage -> StatusDotRender\n}\n"
}