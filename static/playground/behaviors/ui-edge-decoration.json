  "source": "",
  "lolo": "app ui-edge-decoration \"1.0.0\"\n\"EdgeDecoration — UI factory (1:1 with the @almadar/ui edge-decoration pattern).\"\norbital EdgeDecorationOrbital {\n  entity EdgeDecorationItem [runtime] {\n    id : string!\n  }\n\n  trait EdgeDecorationRender -> @rebindable EdgeDecorationItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          variant: @config.variant\n          side: @config.side\n          opacity: @config.opacity\n          color: @config.color\n          strokeWidth: @config.strokeWidth\n          width: @config.width\n          className: @config.className\n          type: edge-decoration\n        })\n    }\n\n    config {\n      variant : \"arch\" | \"vine\" | \"lattice\" = arch\n        @label \"Variant\"\n        @description \"Which decorative element\"\n        @tier \"presentation\"\n      side : \"left\" | \"right\" | \"both\" = both\n        @label \"Side\"\n        @description \"Which side(s) to place the decoration\"\n        @tier \"presentation\"\n      opacity : number = 0.15\n        @label \"Opacity\"\n        @description \"Overall opacity (default: 0.15)\"\n        @tier \"presentation\"\n      color : \"primary\" | \"secondary\" | \"success\" | \"warning\" | \"error\" | \"muted\" = primary\n        @label \"Color\"\n        @description \"Semantic palette token or a raw CSS color value for the stroke.\"\n        @tier \"presentation\"\n      strokeWidth : number = 0.5\n        @label \"Stroke Width\"\n        @description \"Stroke width\"\n        @tier \"presentation\"\n      width : number = 15\n        @label \"Width\"\n        @description \"Width of the decoration area as percentage of container (default: 15)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/edge-decoration\" as EdgeDecorationPage -> EdgeDecorationRender\n}\n"
}