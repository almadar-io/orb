  "source": "",
  "lolo": "app ui-draw-sprite \"1.0.0\"\n\"DrawSprite — UI factory (1:1 with the @almadar/ui draw-sprite pattern).\"\norbital DrawSpriteOrbital {\n  type DrawSpritePosition = {\n    x : number!\n    y : number!\n    z : number\n  }\n  type DrawSpriteAsset = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n  type DrawSpriteFrame = {\n    x : number!\n    y : number!\n    w : number!\n    h : number!\n  }\n  type DrawSpriteShadow = {\n    color : string!\n    blur : number!\n  }\n\n  entity DrawSpriteItem [runtime] {\n    id : string!\n  }\n\n  trait DrawSpriteRender -> @rebindable DrawSpriteItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          position: @config.position\n          asset: @config.asset\n          anchor: @config.anchor\n          width: @config.width\n          height: @config.height\n          frame: @config.frame\n          animation: @config.animation\n          loop: @config.loop\n          clockMs: @config.clockMs\n          flipX: @config.flipX\n          rotation: @config.rotation\n          opacity: @config.opacity\n          shadow: @config.shadow\n          type: draw-sprite\n        })\n    }\n\n    config {\n      position : DrawSpritePosition = { x: 1, y: 1, z: 1 }\n        @label \"Position\"\n        @description \"Logical scene position; the projector maps it to pixels / world.\"\n        @tier \"presentation\"\n      asset : DrawSpriteAsset\n        @label \"Asset\"\n        @description \"The image / atlas reference to blit.\"\n        @tier \"presentation\"\n      anchor : \"top-left\" | \"ground\" | \"center\" = \"top-left\"\n        @label \"Anchor\"\n        @description \"How the sprite aligns to its projected position. Default `'top-left'`.\"\n        @tier \"presentation\"\n      width : number\n        @label \"Width\"\n        @description \"Draw width in world units (fractions of `projector.tileWidth`). Omitted → one cell on tile grids (`flat`/`iso`/`hex`); native source px on `free`/`side`.\"\n        @tier \"presentation\"\n      height : number\n        @label \"Height\"\n        @description \"Draw height in world units (fractions of `projector.tileWidth`). Omitted → one cell on tile grids (`flat`/`iso`/`hex`); native source px on `free`/`side`.\"\n        @tier \"presentation\"\n      frame : DrawSpriteFrame\n        @label \"Frame\"\n        @description \"Explicit atlas sub-rect override (px); omitted → resolved from `asset.atlas`/`asset.sprite`.\"\n        @tier \"presentation\"\n      animation : string\n        @label \"Animation\"\n        @description \"Animation to play. 3D backend: a named GLB clip (matched case-insensitively). 2D painter: when `asset.atlas` resolves to a `SpriteSheetAtlas` manifest, the canonical row of that name (idle/walk/attack/hit/death) plays off the host paint clock; an explicit `frame` rect overrides.\"\n        @tier \"presentation\"\n      loop : boolean\n        @label \"Loop\"\n        @description \"Override the sheet row's loop flag. The paint clock is wall-time, so one-shot rows hold their final frame — preview pages set `true` to cycle attack/hit/death continuously.\"\n        @tier \"presentation\"\n      clockMs : number\n        @label \"Clock Ms\"\n        @description \"Animation clock override in ms (e.g. an fx entry's age since spawn). Omitted → the host paint clock; one-shot rows anchored to wall-time would otherwise sit on their final frame.\"\n        @tier \"presentation\"\n      flipX : boolean\n        @label \"Flip X\"\n        @description \"Mirror horizontally (facing).\"\n        @tier \"presentation\"\n      rotation : number\n        @label \"Rotation\"\n        @description \"Rotation in radians about the sprite's center.\"\n        @tier \"presentation\"\n      opacity : number\n        @label \"Opacity\"\n        @description \"0..1 opacity.\"\n        @tier \"presentation\"\n      shadow : DrawSpriteShadow\n        @label \"Shadow\"\n        @description \"Drop shadow (e.g. a team-colored glow).\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/draw-sprite\" as DrawSpritePage -> DrawSpriteRender\n}\n"
}