  "source": "",
  "lolo": "app ui-state-machine-view \"1.0.0\"\n\"StateMachineView — UI factory (1:1 with the @almadar/ui state-machine-view pattern).\"\norbital StateMachineViewOrbital {\n  type StateMachineViewError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity StateMachineViewItem [runtime] {\n    id : string!\n  }\n\n  trait StateMachineViewRender -> @rebindable StateMachineViewItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          type: state-machine-view\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : StateMachineViewError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/state-machine-view\" as StateMachineViewPage -> StateMachineViewRender\n}\n"
}