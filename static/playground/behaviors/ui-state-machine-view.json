  "source": "",
  "lolo": "app ui-state-machine-view \"1.0.0\"\n\"StateMachineView — UI factory (1:1 with the @almadar/ui state-machine-view pattern).\"\n;; @pattern \"state-machine-view\"\norbital StateMachineViewOrbital {\n  type StateMachineViewTrait = {\n    name : string!\n    linkedEntity : string!\n    states : [StateMachineViewTraitStatesItem]!\n    transitions : [StateMachineViewTraitTransitionsItem]!\n    emittedEvents : [string]!\n    listenedEvents : [string]!\n  }\n  type StateMachineViewTraitStatesItem = {\n    name : string!\n    isInitial : boolean\n    isTerminal : boolean\n  }\n  type StateMachineViewTraitTransitionsItem = {\n    from : string!\n    to : string!\n    event : string!\n    guard : SExpr\n    effects : [StateMachineViewTraitTransitionsItemEffectsItem]!\n    index : number!\n  }\n  type StateMachineViewTraitTransitionsItemEffectsItem = {\n    type : string!\n    args : [SExpr]!\n  }\n  type StateMachineViewError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type StateMachineViewTRANSITIONCLICKTransition = {\n    index : number!\n    event : string!\n    from : string!\n    to : string!\n  }\n\n  entity StateMachineViewItem [runtime] {\n    id : string!\n  }\n\n  trait StateMachineViewRender -> @rebindable StateMachineViewItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          activeState: @config.activeState\n          activeTransition: @config.activeTransition\n          visitedStates: @config.visitedStates\n          stateClickEvent: @config.stateClickEvent\n          transitionClickEvent: @config.transitionClickEvent\n          onTransitionClick: @config.onTransitionClick\n          selectedState: @config.selectedState\n          pendingSourceState: @config.pendingSourceState\n          nodeShape: @config.nodeShape\n          entityFields: @config.entityFields\n          direction: @config.direction\n          showHeader: @config.showHeader\n          className: @config.className\n          trait: @config.traitProp\n          isLoading: @config.isLoading\n          error: @config.error\n          type: state-machine-view\n        })\n    }\n\n    emits {\n      @config.stateClickEvent -> external {\n        stateId : string!\n      }\n        @description \"Emits UI:{stateClickEvent} with { stateId } when a state is clicked.\"\n        @tier \"essential\"\n      @config.transitionClickEvent -> external {\n        index : number!\n        event : string!\n        from : string!\n        to : string!\n        transition : StateMachineViewTRANSITIONCLICKTransition\n      }\n        @description \"Emits UI:{transitionClickEvent} with { index, event, from, to } when a transition label is clicked.\"\n        @tier \"essential\"\n    }\n\n    config {\n      activeState : string\n        @label \"Active State\"\n        @description \"State execution is currently in.\"\n        @tier \"presentation\"\n      activeTransition : number\n        @label \"Active Transition\"\n        @description \"`index` of the transition that just fired.\"\n        @tier \"presentation\"\n      visitedStates : [string] = []\n        @label \"Visited States\"\n        @description \"States already passed through, in order.\"\n        @tier \"presentation\"\n      stateClickEvent : event = \"STATE_CLICK\"\n        @label \"State Click Event\"\n        @description \"Emits UI:{stateClickEvent} with { stateId } when a state is clicked.\"\n        @tier \"presentation\"\n      transitionClickEvent : event = \"TRANSITION_CLICK\"\n        @label \"Transition Click Event\"\n        @description \"Emits UI:{transitionClickEvent} with { index, event, from, to } when a transition label is clicked.\"\n        @tier \"presentation\"\n      onTransitionClick : event = \"TRANSITION_CLICK\"\n        @label \"On Transition Click\"\n        @description \"Direct transition-click callback, for React hosts (e.g. a canvas node).\"\n        @tier \"presentation\"\n      selectedState : string\n        @label \"Selected State\"\n        @description \"State picked in an editor (first click).\"\n        @tier \"presentation\"\n      pendingSourceState : string\n        @label \"Pending Source State\"\n        @description \"Source of a transition being drawn — the next state click picks its target.\"\n        @tier \"presentation\"\n      nodeShape : \"pill\" | \"gear\" = pill\n        @label \"Node Shape\"\n        @description \"Node silhouette. @default 'pill'\"\n        @tier \"presentation\"\n      entityFields : [string] = []\n        @label \"Entity Fields\"\n        @description \"Entity field names listed in the header.\"\n        @tier \"presentation\"\n      direction : \"ltr\" | \"rtl\" = ltr\n        @label \"Direction\"\n        @description \"Flow direction. @default 'ltr'\"\n        @tier \"presentation\"\n      showHeader : boolean\n        @label \"Show Header\"\n        @description \"Show the trait header (name, entity, listens/emits). @default true\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      traitProp : StateMachineViewTrait\n        @label \"Trait\"\n        @description \"The trait to draw (see `parseTraitLevel` / `traitLevelFromTrait`).\"\n        @synonyms \"trait\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : StateMachineViewError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/state-machine-view\" as StateMachineViewPage -> StateMachineViewRender\n}\n"
}