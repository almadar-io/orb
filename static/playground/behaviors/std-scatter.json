  "source": "",
  "lolo": "app std-scatter \"1.0.0\"\n\"std-scatter — embeddable scatter / bubble chart atom. ITEMS_LOADED maps @payload.data into {x,y,label,size,color} points using configured fields (no aggregation step — distinct from std-graphs). Drop into a dashboard alongside std-stats / std-graphs for two-numeric correlation views.\"\ntype ObjectSpec = { id : string, label : string, value : string }\norbital ScatterItemOrbital {\n    type ScatterPoint = { x : number!, y : number!, label : string, size : number, color : string }\n\n  entity ScatterItem [runtime] {\n    id : string!\n    points : [ScatterPoint] @description \"An array of data points for the scatter chart.\" @synonyms \"data, values, records\" = []\n  }\n\n  trait ScatterItemPlot -> ScatterItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.points [{\n          color: \"\"\n          label: A\n          size: 8\n          x: 12\n          y: 24\n        }, {\n          color: \"\"\n          label: B\n          size: 6\n          x: 28\n          y: 42\n        }, {\n          color: \"\"\n          label: C\n          size: 10\n          x: 45\n          y: 18\n        }, {\n          color: \"\"\n          label: D\n          size: 7\n          x: 60\n          y: 55\n        }, {\n          color: \"\"\n          label: E\n          size: 9\n          x: 78\n          y: 38\n        }])\n        (render-ui main {\n          chartType: scatter\n          drillEvent: @config.drillEvent\n          height: @config.height\n          scatterData: @entity.points\n          subtitle: @config.subtitle\n          title: @config.title\n          type: chart\n        })\n      ;; Pre-seed with a small sample so standalone previews render\n      ;; something visible. ITEMS_LOADED replaces this with real data.\n      ITEMS_LOADED -> idle\n        (set @entity.points (array/map ?data (fn row {\n          color: (object/get @row @config.colorField \"\")\n          label: (object/get @row @config.labelField \"\")\n          size: (object/get @row @config.sizeField 5)\n          x: (object/get @row @config.xField 0)\n          y: (object/get @row @config.yField 0)\n        })))\n        (render-ui main {\n          chartType: scatter\n          drillEvent: @config.drillEvent\n          height: @config.height\n          scatterData: @entity.points\n          subtitle: @config.subtitle\n          title: @config.title\n          type: chart\n        })\n    }\n\n    listens {\n      ITEMS_LOADED {\n        data : [ObjectSpec]\n        totalCount : number\n      }\n        @description \"Data has been received and is ready for visualization.\"\n        @synonyms \"data-ready, data-available, loaded\"\n        @tier \"domain\"\n    }\n\n    config {\n      xField : string = x\n        @label \"X-axis field\"\n        @description \"Entity field mapped to the horizontal axis\"\n        @tier \"presentation\"\n      yField : string = y\n        @label \"Y-axis field\"\n        @description \"Entity field mapped to the vertical axis\"\n        @tier \"presentation\"\n      labelField : string = \"\"\n        @label \"Label field\"\n        @description \"Field used as the point label tooltip (blank = none)\"\n        @tier \"presentation\"\n      sizeField : string = \"\"\n        @label \"Size field\"\n        @description \"Numeric field that scales bubble size (blank = uniform)\"\n        @tier \"presentation\"\n      colorField : string = \"\"\n        @label \"Color field\"\n        @description \"Field used to color-code points (blank = single color)\"\n        @tier \"presentation\"\n      title : string = Correlation\n        @label \"Title\"\n        @description \"Heading shown above the chart\"\n        @tier \"presentation\"\n      subtitle : string = \"x vs y\"\n        @label \"Subtitle\"\n        @description \"Secondary line below the title\"\n        @tier \"presentation\"\n      height : number = 280\n        @label \"Chart height\"\n        @description \"Pixel height of the rendered scatter plot\"\n        @tier \"presentation\"\n      drillEvent : event = \"\"\n        @label \"Drill event\"\n        @description \"Event emitted when the user clicks a data point\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/scatteritems\" as ScatterItemPlotPage -> ScatterItemPlot\n}"
