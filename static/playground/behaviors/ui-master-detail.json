  "source": "",
  "lolo": "app ui-master-detail \"1.0.0\"\n\"MasterDetail — UI factory (1:1 with the @almadar/ui master-detail pattern).\"\norbital MasterDetailOrbital {\n    type MasterDetailLoaded = Event { data : [MasterDetailItem] } \"MasterDetail rows finished loading; payload.data holds the collection\"\n  type MasterDetailError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity MasterDetailItem [runtime] {\n    id : string!\n  }\n\n  trait MasterDetailRender -> @rebindable MasterDetailItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle when @config.selfFetch\n        (fetch MasterDetailItem { emit: { success: MasterDetailLoaded } })\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          masterFields: @config.masterFields\n          detailFields: @config.detailFields\n          loading: @config.loading\n          type: master-detail\n        })\n      INIT -> idle when (not @config.selfFetch)\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @entity\n          masterFields: @config.masterFields\n          detailFields: @config.detailFields\n          loading: @config.loading\n          type: master-detail\n        })\n      MasterDetailLoaded -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          entity: @payload.data\n          masterFields: @config.masterFields\n          detailFields: @config.detailFields\n          loading: @config.loading\n          type: master-detail\n        })\n    }\n\n    emits {\n      MasterDetailLoaded\n        @description \"MasterDetail rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : MasterDetailError\n        @label \"Error\"\n        @description \"Error state (UiError)\"\n        @tier \"presentation\"\n      sortBy : string\n        @label \"Sort By\"\n        @description \"Current sort field\"\n        @tier \"presentation\"\n      sortDirection : \"asc\" | \"desc\" = asc\n        @label \"Sort Direction\"\n        @description \"Current sort direction\"\n        @tier \"presentation\"\n      searchValue : string\n        @label \"Search Value\"\n        @description \"Current search query value\"\n        @tier \"presentation\"\n      pageProp : number\n        @label \"Page\"\n        @description \"Current page number\"\n        @synonyms \"page\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Number of items per page\"\n        @tier \"presentation\"\n      totalCount : number\n        @label \"Total Count\"\n        @description \"Total number of items\"\n        @tier \"presentation\"\n      activeFilters : Map string string = {}\n        @label \"Active Filters\"\n        @description \"Active filters\"\n        @tier \"presentation\"\n      selectedIds : [string] = []\n        @label \"Selected Ids\"\n        @description \"Currently selected item IDs\"\n        @tier \"presentation\"\n      masterFields : [string] = [\"Item\", \"Item 2\"]\n        @label \"Master Fields\"\n        @description \"Fields to show in the master list (maps to DataTable columns)\"\n        @tier \"presentation\"\n      detailFields : [string] = []\n        @label \"Detail Fields\"\n        @description \"Fields for detail view (passed through but typically handled by separate render_ui)\"\n        @tier \"presentation\"\n      loading : boolean\n        @label \"Loading\"\n        @description \"Loading state (alias for isLoading)\"\n        @tier \"presentation\"\n      selfFetch : boolean = true\n        @label \"Fetch its own rows on mount?\"\n        @description \"true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/master-detail\" as MasterDetailPage -> MasterDetailRender\n}\n"
}