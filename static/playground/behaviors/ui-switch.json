  "source": "",
  "lolo": "app ui-switch \"1.0.0\"\n\"Switch — UI factory (1:1 with the @almadar/ui switch pattern).\"\norbital SwitchOrbital {\n  entity SwitchItem [runtime] {\n    id : string!\n    checked : boolean\n  }\n\n  trait SwitchRender -> @rebindable SwitchItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.checked @config.checked)\n        (render-ui main {\n          checked: @entity.checked\n          defaultChecked: @config.defaultChecked\n          onChange: @config.onChange\n          disabled: @config.disabled\n          label: @config.label\n          name: @config.name\n          className: @config.className\n          type: switch\n        })\n      CHANGE -> idle\n        (set @entity.checked ?checked)\n        (render-ui main {\n          checked: @entity.checked\n          defaultChecked: @config.defaultChecked\n          onChange: @config.onChange\n          disabled: @config.disabled\n          label: @config.label\n          name: @config.name\n          className: @config.className\n          type: switch\n        })\n    }\n\n    emits {\n      @config.onChange -> external {\n        checked : boolean\n      }\n        @description \"onChange prop\"\n        @tier \"essential\"\n    }\n\n    listens {\n      CHANGE {\n        checked : boolean\n      }\n    }\n\n    config {\n      checked : boolean\n        @label \"Checked\"\n        @description \"checked prop\"\n        @tier \"presentation\"\n      defaultChecked : boolean = false\n        @label \"Default Checked\"\n        @description \"defaultChecked prop\"\n        @tier \"presentation\"\n      onChange : event = \"CHANGE\"\n        @label \"On Change\"\n        @description \"onChange prop\"\n        @tier \"presentation\"\n      disabled : boolean = false\n        @label \"Disabled\"\n        @description \"disabled prop\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"label prop\"\n        @tier \"presentation\"\n      name : string\n        @label \"Name\"\n        @description \"name prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/switch\" as SwitchPage -> SwitchRender\n}\n"
