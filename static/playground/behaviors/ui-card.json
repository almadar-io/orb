  "source": "",
  "lolo": "app ui-card \"1.0.0\"\n\"Card — UI factory (1:1 with the @almadar/ui card pattern).\"\norbital CardOrbital {\n  entity CardItem [runtime] {\n    id : string!\n  }\n\n  trait CardRender -> @rebindable CardItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          variant: @config.variant\n          padding: @config.padding\n          title: @config.title\n          subtitle: @config.subtitle\n          shadow: @config.shadow\n          look: @config.look\n          children: @config.children\n          action: @config.action\n          loading: @config.loading\n          type: card\n        })\n    }\n\n    emits {\n      @config.action -> external {\n        id : string\n      }\n        @description \"Declarative event key emitted on click for trait dispatch\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes applied to the root element.\"\n        @tier \"presentation\"\n      variant : \"default\" | \"bordered\" | \"elevated\" | \"interactive\" = bordered\n        @label \"Variant\"\n        @description \"variant prop\"\n        @tier \"presentation\"\n      padding : \"none\" | \"sm\" | \"md\" | \"lg\" = md\n        @label \"Padding\"\n        @description \"padding prop\"\n        @tier \"presentation\"\n      title : string\n        @label \"Title\"\n        @description \"Card title - renders in header if provided\"\n        @tier \"presentation\"\n      subtitle : string\n        @label \"Subtitle\"\n        @description \"Card subtitle - renders below title\"\n        @tier \"presentation\"\n      shadow : \"none\" | \"sm\" | \"md\" | \"lg\" = none\n        @label \"Shadow\"\n        @description \"Shadow size override\"\n        @tier \"presentation\"\n      look : \"elevated\" | \"flat-bordered\" | \"borderless-divider\" | \"ticket\" | \"invoice\" | \"chip\" | \"tile-image-first\" = elevated\n        @label \"Look\"\n        @description \"Layer 2 visual treatment — orthogonal to the semantic variant.\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Card content\"\n        @tier \"presentation\"\n      action : event = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event key emitted on click for trait dispatch\"\n        @tier \"presentation\"\n      loading : boolean\n        @label \"Loading\"\n        @description \"Shows a skeleton/spinner overlay while true.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/card\" as CardPage -> CardRender\n}\n"
}