  "lolo": "app ui-book-table-of-contents \"1.0.0\"\n\"BookTableOfContents — UI factory (1:1 with the @almadar/ui book-table-of-contents pattern).\"\norbital BookTableOfContentsOrbital {\n    type BookTableOfContentsLoaded = Event { data : [BookTableOfContentsItem] } \"BookTableOfContents rows finished loading; payload.data holds the collection\"\n\n  entity BookTableOfContentsItem [runtime] {\n    id : string!\n  }\n\n  trait BookTableOfContentsRender -> @rebindable BookTableOfContentsItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (fetch BookTableOfContentsItem { emit: { success: BookTableOfContentsLoaded } })\n        (render-ui main {\n          className: @config.className\n          parts: @entity\n          currentChapterId: @config.currentChapterId\n          direction: @config.direction\n          type: book-table-of-contents\n        })\n      BookTableOfContentsLoaded -> idle\n        (render-ui main {\n          className: @config.className\n          parts: @payload.data\n          currentChapterId: @config.currentChapterId\n          direction: @config.direction\n          type: book-table-of-contents\n        })\n    }\n\n    emits {\n      BookTableOfContentsLoaded\n        @description \"BookTableOfContents rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      currentChapterId : string\n        @label \"Current Chapter Id\"\n        @description \"currentChapterId prop\"\n        @tier \"presentation\"\n      direction : \"rtl\" | \"ltr\" = rtl\n        @label \"Direction\"\n        @description \"direction prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/book-table-of-contents\" as BookTableOfContentsPage -> BookTableOfContentsRender\n}\n"
