  "source": "",
  "lolo": "app ui-overlay \"1.0.0\"\n\"Overlay — UI factory (1:1 with the @almadar/ui overlay pattern).\"\norbital OverlayOrbital {\n  entity OverlayItem [runtime] {\n    id : string!\n  }\n\n  trait OverlayRender -> @rebindable OverlayItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          isVisible: @config.isVisible\n          className: @config.className\n          blur: @config.blur\n          action: @config.action\n          type: overlay\n        })\n    }\n\n    emits {\n      @config.action -> external { }\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"essential\"\n    }\n\n    config {\n      isVisible : boolean = true\n        @label \"Is Visible\"\n        @description \"isVisible prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      blur : boolean = false\n        @label \"Blur\"\n        @description \"blur prop\"\n        @tier \"presentation\"\n      action : event = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/overlay\" as OverlayPage -> OverlayRender\n}\n"
}