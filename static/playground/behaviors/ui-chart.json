  "source": "",
  "lolo": "app ui-chart \"1.0.0\"\n\"Chart — UI factory (1:1 with the @almadar/ui chart pattern).\"\norbital ChartOrbital {\n  type ChartSeriesItem = {\n    name : string!\n    data : [ChartSeriesItemDataItem]!\n    color : string\n    dashed : boolean\n  }\n  type ChartSeriesItemDataItem = {\n    label : string!\n    value : number!\n    color : string\n  }\n  type ChartDataItem = {\n    label : string!\n    value : number!\n    color : string\n  }\n  type ChartScatterDataItem = {\n    x : number!\n    y : number!\n    label : string\n    size : number\n    color : string\n  }\n  type ChartActionsItem = {\n    label : string!\n    event : string\n    navigatesTo : string\n    variant : \"primary\" | \"secondary\" | \"ghost\"\n  }\n  type ChartError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity ChartItem [runtime] {\n    id : string!\n  }\n\n  trait ChartRender -> @rebindable ChartItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          title: @config.title\n          subtitle: @config.subtitle\n          chartType: @config.chartType\n          look: @config.look\n          series: @config.series\n          data: @config.data\n          scatterData: @config.scatterData\n          height: @config.height\n          showLegend: @config.showLegend\n          showValues: @config.showValues\n          stack: @config.stack\n          timeAxis: @config.timeAxis\n          drillEvent: @config.drillEvent\n          actions: @config.actions\n          isLoading: @config.isLoading\n          error: @config.error\n          className: @config.className\n          type: chart\n        })\n    }\n\n    config {\n      title : string\n        @label \"Title\"\n        @description \"Chart title\"\n        @tier \"presentation\"\n      subtitle : string\n        @label \"Subtitle\"\n        @description \"Chart subtitle / description\"\n        @tier \"presentation\"\n      chartType : \"bar\" | \"line\" | \"pie\" | \"area\" | \"donut\" | \"scatter\" | \"histogram\" = bar\n        @label \"Chart Type\"\n        @description \"Chart type (legacy alias for `look`).\"\n        @synonyms \"chart style, graph type, bar chart, line chart, pie chart, area chart, donut chart, scatter plot, histogram\"\n        @tier \"domain\"\n      look : \"bar-vertical\" | \"bar-horizontal\" | \"line\" | \"area\" | \"pie\" | \"donut\" | \"scatter\" | \"histogram\" = \"bar-vertical\"\n        @label \"Look\"\n        @description \"Layer 2 visual treatment — drives the chart sub-renderer (bar / line / pie / etc.).\"\n        @synonyms \"chart style, render style, visual treatment\"\n        @tier \"presentation\"\n      series : [ChartSeriesItem] = []\n        @label \"Series\"\n        @description \"Multi-series data\"\n        @tier \"presentation\"\n      data : [ChartDataItem] = []\n        @label \"Data\"\n        @description \"Simple single-series shorthand (bar/line/pie/area/donut/histogram)\"\n        @tier \"presentation\"\n      scatterData : [ChartScatterDataItem] = []\n        @label \"Scatter Data\"\n        @description \"Raw {x,y} points for scatter\"\n        @tier \"presentation\"\n      height : number = 200\n        @label \"Height\"\n        @description \"Chart height in px\"\n        @tier \"presentation\"\n      showLegend : boolean = true\n        @label \"Show Legend\"\n        @description \"Show legend\"\n        @tier \"presentation\"\n      showValues : boolean = false\n        @label \"Show Values\"\n        @description \"Show values on chart\"\n        @tier \"presentation\"\n      stack : \"none\" | \"stack\" | \"normalize\" = none\n        @label \"Stack\"\n        @description \"Stack mode for bar / area\"\n        @tier \"presentation\"\n      timeAxis : boolean = false\n        @label \"Time Axis\"\n        @description \"Format X-axis labels as time (ISO date in → 'Mar 2026'-style label out)\"\n        @tier \"presentation\"\n      drillEvent : string\n        @label \"Drill Event\"\n        @description \"Event name emitted as `UI:{drillEvent}` with `{ label, value, seriesLabel? }` on data-point click\"\n        @tier \"presentation\"\n      actions : [ChartActionsItem] = []\n        @label \"Actions\"\n        @description \"Top-level chart actions (export, refresh, etc.)\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state\"\n        @tier \"presentation\"\n      error : ChartError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/chart\" as ChartPage -> ChartRender\n}\n"
}