  "source": "",
  "lolo": "app ui-chat-bar \"1.0.0\"\n\"ChatBar — UI factory (1:1 with the @almadar/ui chat-bar pattern).\"\norbital ChatBarOrbital {\n  type ChatBarError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity ChatBarItem [runtime] {\n    id : string!\n  }\n\n  trait ChatBarRender -> @rebindable ChatBarItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          status: @config.status\n          activeGate: @config.activeGate\n          jepaValidity: @config.jepaValidity\n          placeholder: @config.placeholder\n          context: @config.context\n          type: chat-bar\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : ChatBarError\n        @label \"Error\"\n        @description \"Error state (UiError)\"\n        @tier \"presentation\"\n      sortBy : string\n        @label \"Sort By\"\n        @description \"Current sort field\"\n        @tier \"presentation\"\n      sortDirection : \"asc\" | \"desc\" = asc\n        @label \"Sort Direction\"\n        @description \"Current sort direction\"\n        @tier \"presentation\"\n      searchValue : string\n        @label \"Search Value\"\n        @description \"Current search query value\"\n        @tier \"presentation\"\n      pageProp : number\n        @label \"Page\"\n        @description \"Current page number\"\n        @synonyms \"page\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Number of items per page\"\n        @tier \"presentation\"\n      totalCount : number\n        @label \"Total Count\"\n        @description \"Total number of items\"\n        @tier \"presentation\"\n      activeFilters : Map string string = {}\n        @label \"Active Filters\"\n        @description \"Active filters\"\n        @tier \"presentation\"\n      selectedIds : [string] = []\n        @label \"Selected Ids\"\n        @description \"Currently selected item IDs\"\n        @tier \"presentation\"\n      status : \"idle\" | \"running\" | \"paused\" | \"complete\" | \"error\" = idle\n        @label \"Status\"\n        @description \"Pipeline status\"\n        @tier \"presentation\"\n      activeGate : string\n        @label \"Active Gate\"\n        @description \"Currently active gate label, e.g. 'Gate 2: State machines'\"\n        @tier \"presentation\"\n      jepaValidity : number\n        @label \"Jepa Validity\"\n        @description \"JEPA validity probability 0-1\"\n        @tier \"presentation\"\n      placeholder : string\n        @label \"Placeholder\"\n        @description \"Input placeholder text\"\n        @tier \"presentation\"\n      context : string\n        @label \"Context\"\n        @description \"Agent context description\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/chat-bar\" as ChatBarPage -> ChatBarRender\n}\n"
}