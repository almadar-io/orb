{
  "name": "std-physics-collision",
  "description": "Elastic-collision engine — equal-mass circles exchange velocity along the collision normal and bounce off walls.",
  "level": "atom",
  "topic": "ui/learning",
  "schema": {
    "name": "std-physics-collision",
    "version": "1.0.0",
    "description": "Elastic-collision engine — equal-mass circles exchange velocity along the collision normal and bounce off walls.",
    "orbitals": [
      {
        "name": "CollisionEngineOrbital",
        "entity": {
          "name": "CollisionState",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "bodies",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "y": {
                    "name": "y",
                    "type": "number",
                    "required": true
                  },
                  "x": {
                    "name": "x",
                    "type": "number",
                    "required": true
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
                  "id": {
                    "name": "id",
                    "type": "string",
                    "required": false
                  },
                  "vx": {
                    "name": "vx",
                    "type": "number",
                    "required": false
                  },
                  "radius": {
                    "name": "radius",
                    "type": "number",
                    "required": false
                  },
                  "fx": {
                    "name": "fx",
                    "type": "number",
                    "required": false
                  },
                  "fy": {
                    "name": "fy",
                    "type": "number",
                    "required": false
                  },
                  "vy": {
                    "name": "vy",
                    "type": "number",
                    "required": false
                  }
                }
              }
            },
            {
              "name": "running",
              "type": "boolean",
              "default": false
            }
          ]
        },
        "traits": [
          {
            "name": "CollisionSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "bodies",
                "running"
              ]
            },
            "category": "interaction",
            "linkedEntity": "CollisionState",
            "emits": [
              {
                "event": "BODIES_UPDATED",
                "description": "The current scene each tick — a composed listener (graph, readout, mirror canvas) can subscribe; a harmless no-op when the atom runs standalone.",
                "synonyms": "tick, frame, step, redraw",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "bodies",
                    "type": "[CollisionBody]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "BODIES_UPDATED",
                  "name": "Bodies Updated",
                  "description": "The current scene each tick — a composed listener (graph, readout, mirror canvas) can subscribe; a harmless no-op when the atom runs standalone.",
                  "synonyms": "tick, frame, step, redraw",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "bodies",
                      "type": "[CollisionBody]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.bodies",
                      [
                        {
                          "fy": 0,
                          "y": 200,
                          "radius": 16,
                          "fx": 0,
                          "id": "ball-a",
                          "x": 80,
                          "color": "#2563eb",
                          "vx": 5,
                          "vy": 0,
                          "label": "A"
                        },
                        {
                          "y": 200,
                          "color": "#16a34a",
                          "fy": 0,
                          "radius": 16,
                          "vy": 0,
                          "id": "ball-b",
                          "fx": 0,
                          "label": "B",
                          "vx": -5,
                          "x": 520
                        },
                        {
                          "x": 300,
                          "color": "#dc2626",
                          "fx": 0,
                          "id": "ball-c",
                          "vy": 4,
                          "fy": 0,
                          "label": "C",
                          "y": 90,
                          "radius": 16,
                          "vx": 0
                        },
                        {
                          "color": "#f59e0b",
                          "label": "D",
                          "fx": 0,
                          "id": "ball-d",
                          "radius": 16,
                          "vx": 0,
                          "fy": 0,
                          "vy": -4,
                          "x": 300,
                          "y": 320
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "type": "physics-canvas",
                        "height": 400,
                        "width": 600,
                        "showForces": false,
                        "bodies": "@entity.bodies",
                        "velocityScale": 10,
                        "backgroundColor": "#f8fafc",
                        "showVelocity": true
                      }
                    ],
                    [
                      "emit",
                      "BODIES_UPDATED",
                      {
                        "bodies": "@entity.bodies"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "collisionTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "set",
                    "@entity.bodies",
                    [
                      "array/map",
                      "@entity.bodies",
                      [
                        "fn",
                        "b",
                        [
                          "let",
                          [
                            [
                              "r",
                              [
                                "object/get",
                                "@b",
                                "radius"
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "cv",
                                [
                                  "array/reduce",
                                  "@entity.bodies",
                                  [
                                    "fn",
                                    [
                                      "acc",
                                      "o"
                                    ],
                                    [
                                      "if",
                                      [
                                        "=",
                                        [
                                          "object/get",
                                          "@o",
                                          "id"
                                        ],
                                        [
                                          "object/get",
                                          "@b",
                                          "id"
                                        ]
                                      ],
                                      "@acc",
                                      [
                                        "let",
                                        [
                                          [
                                            "dx",
                                            [
                                              "-",
                                              [
                                                "object/get",
                                                "@o",
                                                "x"
                                              ],
                                              [
                                                "object/get",
                                                "@b",
                                                "x"
                                              ]
                                            ]
                                          ],
                                          [
                                            "dy",
                                            [
                                              "-",
                                              [
                                                "object/get",
                                                "@o",
                                                "y"
                                              ],
                                              [
                                                "object/get",
                                                "@b",
                                                "y"
                                              ]
                                            ]
                                          ]
                                        ],
                                        [
                                          "let",
                                          [
                                            [
                                              "dist",
                                              [
                                                "math/sqrt",
                                                [
                                                  "+",
                                                  [
                                                    "*",
                                                    "@dx",
                                                    "@dx"
                                                  ],
                                                  [
                                                    "*",
                                                    "@dy",
                                                    "@dy"
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              "sumr",
                                              [
                                                "+",
                                                [
                                                  "object/get",
                                                  "@b",
                                                  "radius"
                                                ],
                                                [
                                                  "object/get",
                                                  "@o",
                                                  "radius"
                                                ]
                                              ]
                                            ]
                                          ],
                                          [
                                            "if",
                                            [
                                              "and",
                                              [
                                                "<",
                                                "@dist",
                                                "@sumr"
                                              ],
                                              [
                                                ">",
                                                "@dist",
                                                0
                                              ]
                                            ],
                                            [
                                              "let",
                                              [
                                                [
                                                  "nx",
                                                  [
                                                    "/",
                                                    "@dx",
                                                    "@dist"
                                                  ]
                                                ],
                                                [
                                                  "ny",
                                                  [
                                                    "/",
                                                    "@dy",
                                                    "@dist"
                                                  ]
                                                ]
                                              ],
                                              [
                                                "let",
                                                [
                                                  [
                                                    "vrel",
                                                    [
                                                      "+",
                                                      [
                                                        "*",
                                                        [
                                                          "-",
                                                          [
                                                            "object/get",
                                                            "@acc",
                                                            "vx"
                                                          ],
                                                          [
                                                            "object/get",
                                                            "@o",
                                                            "vx"
                                                          ]
                                                        ],
                                                        "@nx"
                                                      ],
                                                      [
                                                        "*",
                                                        [
                                                          "-",
                                                          [
                                                            "object/get",
                                                            "@acc",
                                                            "vy"
                                                          ],
                                                          [
                                                            "object/get",
                                                            "@o",
                                                            "vy"
                                                          ]
                                                        ],
                                                        "@ny"
                                                      ]
                                                    ]
                                                  ]
                                                ],
                                                [
                                                  "if",
                                                  [
                                                    ">",
                                                    "@vrel",
                                                    0
                                                  ],
                                                  [
                                                    "object/merge",
                                                    "@acc",
                                                    {
                                                      "vy": [
                                                        "-",
                                                        [
                                                          "object/get",
                                                          "@acc",
                                                          "vy"
                                                        ],
                                                        [
                                                          "*",
                                                          "@vrel",
                                                          "@ny"
                                                        ]
                                                      ],
                                                      "vx": [
                                                        "-",
                                                        [
                                                          "object/get",
                                                          "@acc",
                                                          "vx"
                                                        ],
                                                        [
                                                          "*",
                                                          "@vrel",
                                                          "@nx"
                                                        ]
                                                      ]
                                                    }
                                                  ],
                                                  "@acc"
                                                ]
                                              ]
                                            ],
                                            "@acc"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  {
                                    "vy": [
                                      "object/get",
                                      "@b",
                                      "vy"
                                    ],
                                    "vx": [
                                      "object/get",
                                      "@b",
                                      "vx"
                                    ]
                                  }
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "bvx",
                                  [
                                    "object/get",
                                    "@cv",
                                    "vx"
                                  ]
                                ],
                                [
                                  "bvy",
                                  [
                                    "object/get",
                                    "@cv",
                                    "vy"
                                  ]
                                ]
                              ],
                              [
                                "let",
                                [
                                  [
                                    "newvx",
                                    [
                                      "if",
                                      [
                                        "or",
                                        [
                                          "<",
                                          [
                                            "+",
                                            [
                                              "object/get",
                                              "@b",
                                              "x"
                                            ],
                                            "@bvx"
                                          ],
                                          "@r"
                                        ],
                                        [
                                          ">",
                                          [
                                            "+",
                                            [
                                              "object/get",
                                              "@b",
                                              "x"
                                            ],
                                            "@bvx"
                                          ],
                                          [
                                            "-",
                                            600,
                                            "@r"
                                          ]
                                        ]
                                      ],
                                      [
                                        "*",
                                        "@bvx",
                                        -1
                                      ],
                                      "@bvx"
                                    ]
                                  ],
                                  [
                                    "newvy",
                                    [
                                      "if",
                                      [
                                        "or",
                                        [
                                          "<",
                                          [
                                            "+",
                                            [
                                              "object/get",
                                              "@b",
                                              "y"
                                            ],
                                            "@bvy"
                                          ],
                                          "@r"
                                        ],
                                        [
                                          ">",
                                          [
                                            "+",
                                            [
                                              "object/get",
                                              "@b",
                                              "y"
                                            ],
                                            "@bvy"
                                          ],
                                          [
                                            "-",
                                            400,
                                            "@r"
                                          ]
                                        ]
                                      ],
                                      [
                                        "*",
                                        "@bvy",
                                        -1
                                      ],
                                      "@bvy"
                                    ]
                                  ]
                                ],
                                [
                                  "let",
                                  [
                                    [
                                      "nx",
                                      [
                                        "math/clamp",
                                        [
                                          "+",
                                          [
                                            "object/get",
                                            "@b",
                                            "x"
                                          ],
                                          "@newvx"
                                        ],
                                        "@r",
                                        [
                                          "-",
                                          600,
                                          "@r"
                                        ]
                                      ]
                                    ],
                                    [
                                      "ny",
                                      [
                                        "math/clamp",
                                        [
                                          "+",
                                          [
                                            "object/get",
                                            "@b",
                                            "y"
                                          ],
                                          "@newvy"
                                        ],
                                        "@r",
                                        [
                                          "-",
                                          400,
                                          "@r"
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "object/merge",
                                    "@b",
                                    {
                                      "x": "@nx",
                                      "vy": "@newvy",
                                      "vx": "@newvx",
                                      "y": "@ny"
                                    }
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "height": 400,
                      "width": 600,
                      "backgroundColor": "#f8fafc",
                      "bodies": "@entity.bodies",
                      "showForces": false,
                      "type": "physics-canvas",
                      "showVelocity": true,
                      "velocityScale": 10
                    }
                  ],
                  [
                    "emit",
                    "BODIES_UPDATED",
                    {
                      "bodies": "@entity.bodies"
                    }
                  ]
                ]
              }
            ],
            "config": {
