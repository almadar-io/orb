  "source": "",
  "lolo": "app ui-avatar \"1.0.0\"\n\"Avatar — UI factory (1:1 with the @almadar/ui avatar pattern).\"\norbital AvatarOrbital {\n  entity AvatarItem [runtime] {\n    id : string!\n  }\n\n  trait AvatarRender -> @rebindable AvatarItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          src: @config.src\n          alt: @config.alt\n          name: @config.name\n          initials: @config.initials\n          icon: @config.icon\n          size: @config.size\n          status: @config.status\n          badge: @config.badge\n          className: @config.className\n          onClick: @config.onClick\n          action: @config.action\n          actionPayload: @config.actionPayload\n          type: avatar\n        })\n    }\n\n    emits {\n      @config.onClick -> external { }\n        @description \"Click handler\"\n        @tier \"essential\"\n      @config.action -> external { }\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"essential\"\n    }\n\n    config {\n      src : asset = \"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png\"\n        @label \"Src\"\n        @description \"Image source URL\"\n        @tier \"presentation\"\n      alt : string\n        @label \"Alt\"\n        @description \"Alt text for the image\"\n        @tier \"presentation\"\n      name : string\n        @label \"Name\"\n        @description \"Full name - initials will be generated automatically\"\n        @tier \"presentation\"\n      initials : string\n        @label \"Initials\"\n        @description \"Initials to display (e.g., 'JD' for John Doe) If not provided but name is, initials will be auto-generated\"\n        @tier \"presentation\"\n      icon : icon\n        @label \"Icon\"\n        @description \"Icon to display when no image or initials. Accepts a Lucide component directly, or a canonical kebab-case icon name string (resolved via `resolveIcon`) so trait/factory authors can pass an icon by name.\"\n        @tier \"presentation\"\n      size : \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" = md\n        @label \"Size\"\n        @description \"Size of the avatar\"\n        @tier \"presentation\"\n      status : \"online\" | \"offline\" | \"away\" | \"busy\" = online\n        @label \"Status\"\n        @description \"Status indicator\"\n        @tier \"presentation\"\n      badge : string\n        @label \"Badge\"\n        @description \"Badge content (e.g., notification count)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      onClick : event = \"CLICK\"\n        @label \"On Click\"\n        @description \"Click handler\"\n        @tier \"presentation\"\n      action : event = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"presentation\"\n      actionPayload : @payload @config.action\n        @label \"Action Payload\"\n        @description \"Payload to include with the action event\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/avatar\" as AvatarPage -> AvatarRender\n}\n"
}