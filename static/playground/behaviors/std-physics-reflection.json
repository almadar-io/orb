        "traits": [
          {
            "name": "ReflectionSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "bodies",
                "running"
              ]
            },
            "category": "interaction",
            "linkedEntity": "ReflectionState",
            "emits": [
              {
                "event": "BODIES_UPDATED",
                "description": "The current scene each tick — a composed listener (graph, readout, mirror canvas) can subscribe; a harmless no-op when the atom runs standalone.",
                "synonyms": "tick, frame, step, redraw",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "bodies",
                    "type": "[ReflectionBody]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "BODIES_UPDATED",
                  "name": "Bodies Updated",
                  "description": "The current scene each tick — a composed listener (graph, readout, mirror canvas) can subscribe; a harmless no-op when the atom runs standalone.",
                  "synonyms": "tick, frame, step, redraw",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "bodies",
                      "type": "[ReflectionBody]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.bodies",
                      [
                        {
                          "x": 120,
                          "fy": 0,
                          "vy": 4,
                          "id": "ray-a",
                          "color": "#f59e0b",
                          "label": "",
                          "y": 120,
                          "vx": 6,
                          "radius": 7,
                          "fx": 0
                        },
                        {
                          "label": "",
                          "vx": -5,
                          "y": 150,
                          "vy": 5,
                          "fx": 0,
                          "fy": 0,
                          "x": 480,
                          "radius": 7,
                          "color": "#2563eb",
                          "id": "ray-b"
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "showVelocity": true,
                        "velocityScale": 10,
                        "type": "physics-canvas",
                        "shapes": [
                          {
                            "lineWidth": 3,
                            "type": "line",
                            "x2": 580,
                            "y2": 380,
                            "color": "#334155",
                            "x1": 20,
                            "y1": 380
                          }
                        ],
                        "bodies": "@entity.bodies",
                        "showForces": false,
                        "height": 400,
                        "width": 600,
                        "backgroundColor": "#f8fafc"
                      }
                    ],
                    [
                      "emit",
                      "BODIES_UPDATED",
                      {
                        "bodies": "@entity.bodies"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "reflectionTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "set",
                    "@entity.bodies",
                    [
                      "array/map",
                      "@entity.bodies",
                      [
                        "fn",
                        "b",
                        [
                          "let",
                          [
                            [
                              "r",
                              [
                                "object/get",
                                "@b",
                                "radius"
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "nvx0",
                                [
                                  "object/get",
                                  "@b",
                                  "vx"
                                ]
                              ],
                              [
                                "nvy0",
                                [
                                  "object/get",
                                  "@b",
                                  "vy"
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "hitx",
                                  [
                                    "or",
                                    [
                                      "<",
                                      [
                                        "+",
                                        [
                                          "object/get",
                                          "@b",
                                          "x"
                                        ],
                                        "@nvx0"
                                      ],
                                      "@r"
                                    ],
                                    [
                                      ">",
                                      [
                                        "+",
                                        [
                                          "object/get",
                                          "@b",
                                          "x"
                                        ],
                                        "@nvx0"
                                      ],
                                      [
                                        "-",
                                        600,
                                        "@r"
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "hity",
                                  [
                                    "or",
                                    [
                                      "<",
                                      [
                                        "+",
                                        [
                                          "object/get",
                                          "@b",
                                          "y"
                                        ],
                                        "@nvy0"
                                      ],
                                      "@r"
                                    ],
                                    [
                                      ">",
                                      [
                                        "+",
                                        [
                                          "object/get",
                                          "@b",
                                          "y"
                                        ],
                                        "@nvy0"
                                      ],
                                      [
                                        "-",
                                        400,
                                        "@r"
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "let",
                                [
                                  [
                                    "nvx",
                                    [
                                      "if",
                                      "@hitx",
                                      [
                                        "*",
                                        "@nvx0",
                                        -1
                                      ],
                                      "@nvx0"
                                    ]
                                  ],
                                  [
                                    "nvy",
                                    [
                                      "if",
                                      "@hity",
                                      [
                                        "*",
                                        "@nvy0",
                                        -1
                                      ],
                                      "@nvy0"
                                    ]
                                  ]
                                ],
                                [
                                  "let",
                                  [
                                    [
                                      "nx",
                                      [
                                        "math/clamp",
                                        [
                                          "+",
                                          [
                                            "object/get",
                                            "@b",
                                            "x"
                                          ],
                                          "@nvx"
                                        ],
                                        "@r",
                                        [
                                          "-",
                                          600,
                                          "@r"
                                        ]
                                      ]
                                    ],
                                    [
                                      "ny",
                                      [
                                        "math/clamp",
                                        [
                                          "+",
                                          [
                                            "object/get",
                                            "@b",
                                            "y"
                                          ],
                                          "@nvy"
                                        ],
                                        "@r",
                                        [
                                          "-",
                                          400,
                                          "@r"
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "object/merge",
                                    "@b",
                                    {
                                      "vy": "@nvy",
                                      "vx": "@nvx",
                                      "x": "@nx",
                                      "y": "@ny"
                                    }
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "bodies": "@entity.bodies",
                      "showVelocity": true,
                      "backgroundColor": "#f8fafc",
                      "velocityScale": 10,
                      "width": 600,
                      "shapes": [
                        {
                          "lineWidth": 3,
                          "type": "line",
                          "x2": 580,
                          "y2": 380,
                          "color": "#334155",
                          "x1": 20,
                          "y1": 380
                        }
                      ],
                      "height": 400,
                      "showForces": false,
                      "type": "physics-canvas"
                    }
                  ],
                  [
                    "emit",
                    "BODIES_UPDATED",
                    {
                      "bodies": "@entity.bodies"
                    }
                  ]
                ]
