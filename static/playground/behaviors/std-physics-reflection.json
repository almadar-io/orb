                    "name": "fy",
                    "type": "number",
                    "required": false
                  },
                  "id": {
                    "name": "id",
                    "type": "string",
                    "required": false
                  },
                  "radius": {
                    "name": "radius",
                    "type": "number",
                    "required": false
                  },
                  "vx": {
                    "name": "vx",
                    "type": "number",
                    "required": false
                  },
                  "x": {
                    "name": "x",
                    "type": "number",
                    "required": true
                  },
                  "y": {
                    "name": "y",
                    "type": "number",
                    "required": true
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
