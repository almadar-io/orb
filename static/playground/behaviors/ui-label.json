  "source": "",
  "lolo": "app ui-label \"1.0.0\"\n\"Label — UI factory (1:1 with the @almadar/ui label pattern).\"\norbital LabelOrbital {\n  entity LabelItem [runtime] {\n    id : string!\n  }\n\n  trait LabelRender -> @rebindable LabelItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          text: @config.text\n          htmlFor: @config.htmlFor\n          required: @config.required\n          type: label\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes applied to the root element.\"\n        @tier \"presentation\"\n      text : string\n        @label \"Text\"\n        @description \"Label text content\"\n        @tier \"presentation\"\n      htmlFor : string\n        @label \"Html For\"\n        @description \"Associated input element ID\"\n        @tier \"presentation\"\n      required : boolean\n        @label \"Required\"\n        @description \"Show required indicator\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/label\" as LabelPage -> LabelRender\n}\n"
