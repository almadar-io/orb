  "source": "",
  "lolo": "app ui-typewriter-text \"1.0.0\"\n\"TypewriterText — UI factory (1:1 with the @almadar/ui typewriter-text pattern).\"\norbital TypewriterTextOrbital {\n  entity TypewriterTextItem [runtime] {\n    id : string!\n  }\n\n  trait TypewriterTextRender -> @rebindable TypewriterTextItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          text: @config.text\n          speed: @config.speed\n          startDelay: @config.startDelay\n          className: @config.className\n          onComplete: @config.onComplete\n          type: typewriter-text\n        })\n    }\n\n    emits {\n      @config.onComplete -> external {\n        id : string\n      }\n        @description \"Called when the entire text has been revealed\"\n        @tier \"essential\"\n    }\n\n    config {\n      text : string = \"\"\n        @label \"Text\"\n        @description \"The full text to reveal\"\n        @tier \"presentation\"\n      speed : number = 40\n        @label \"Speed\"\n        @description \"Milliseconds per character\"\n        @tier \"presentation\"\n      startDelay : number = 0\n        @label \"Start Delay\"\n        @description \"Delay before typing starts (ms)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n      onComplete : event = \"COMPLETE\"\n        @label \"On Complete\"\n        @description \"Called when the entire text has been revealed\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/typewriter-text\" as TypewriterTextPage -> TypewriterTextRender\n}\n"
}