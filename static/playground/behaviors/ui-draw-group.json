  "source": "",
  "lolo": "app ui-draw-group \"1.0.0\"\n\"DrawGroup — UI factory (1:1 with the @almadar/ui draw-group pattern).\"\norbital DrawGroupOrbital {\n  type DrawGroupPosition = {\n    x : number!\n    y : number!\n    z : number\n  }\n  type DrawGroupAnimation = {\n    durationMs : number!\n    loop : boolean\n    keyframes : [DrawGroupAnimationKeyframesItem]!\n  }\n  type DrawGroupAnimationKeyframesItem = {\n    at : number!\n    offsetX : number\n    offsetY : number\n    offsetZ : number\n    rotateX : number\n    rotateY : number\n    rotateZ : number\n    scale : number\n    opacity : number\n    emissiveIntensity : number\n    color : string\n    emissive : string\n  }\n\n  entity DrawGroupItem [runtime] {\n    id : string!\n  }\n\n  trait DrawGroupRender -> @rebindable DrawGroupItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          position: @config.position\n          scale: @config.scale\n          rotate: @config.rotate\n          rotation: @config.rotation\n          bone: @config.bone\n          skeleton: @config.skeleton\n          animation: @config.animation\n          opacity: @config.opacity\n          clip: @config.clip\n          items: @config.items\n          type: draw-group\n        })\n    }\n\n    config {\n      position : DrawGroupPosition = { x: 1, y: 1, z: 1 }\n        @label \"Position\"\n        @description \"Logical scene position; the projector maps it to pixels / world.\"\n        @tier \"presentation\"\n      scale : number\n        @label \"Scale\"\n        @description \"Uniform scale applied to the whole group.\"\n        @tier \"presentation\"\n      rotate : number\n        @label \"Rotate\"\n        @description \"Rotation in radians (painter units).\"\n        @tier \"presentation\"\n      rotation : [number] = []\n        @label \"Rotation\"\n        @description \"Euler rotation `[x, y, z]` in radians (world axes) — per-axis joint rotation for the 3D backend; a group placed at a joint with children authored joint-local IS a bone. The 2D painter applies only the in-plane `z` component, after `rotate`.\"\n        @tier \"presentation\"\n      bone : string\n        @label \"Bone\"\n        @description \"Skeleton bone name. A named group is addressable by a `draw-mesh` `skin` block (smooth skinning): the skinned mesh deforms with this group's animated transform. Names resolve within the nearest enclosing `skeleton: true` group (falling back to the canvas), so multiple instances of one rig never collide. Distinct from `id` (the hit-test handle).\"\n        @tier \"presentation\"\n      skeleton : boolean\n        @label \"Skeleton\"\n        @description \"Marks this group as a skeleton SCOPE: `bone` names and `skin` bindings in its subtree resolve against each other only — one scope per rig instance.\"\n        @tier \"presentation\"\n      animation : DrawGroupAnimation\n        @label \"Animation\"\n        @description \"Keyframe animation over the group TRANSFORM tracks (`offsetX/Y/Z` in cells, `rotateX/Y/Z` in radians, `scale`; the 2D painter also honors `opacity`) — children inherit it, so nested animated groups form a joint chain. Material tracks belong on leaf meshes.\"\n        @tier \"presentation\"\n      opacity : number\n        @label \"Opacity\"\n        @description \"0..1 opacity.\"\n        @tier \"presentation\"\n      clip : string\n        @label \"Clip\"\n        @description \"Clip the group's items to an SVG path (`d` syntax) in world units relative to the group origin — masked reveals, meters, portraits.\"\n        @tier \"presentation\"\n      items : [node] = []\n        @label \"Items\"\n        @description \"The grouped drawables, painted through the normal dispatch.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/draw-group\" as DrawGroupPage -> DrawGroupRender\n}\n"
}