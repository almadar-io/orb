            },
            "emits": [
              {
                "event": "CAMERA_MOVED",
                "eventId": "evt_01M1KT7VDHACZBVYWSJ1XT0XT4",
                "description": "Eased camera position/zoom after this tick.",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "x",
                    "type": "number",
                    "required": true
                  },
                  {
                    "name": "y",
                    "type": "number",
                    "required": true
                  },
                  {
                    "name": "zoom",
                    "type": "number",
                    "required": true
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "active",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "id": "evt_01M1KT7VDHP97MNNBCK21F9XF0",
