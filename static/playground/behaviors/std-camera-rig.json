                },
                {
                  "key": "FOLLOW",
                  "id": "evt_01M1KT7VDH27J939V4G8J199KT",
                  "name": "Follow",
                  "description": "Retarget from a moving body's position and horizontal velocity (vx drives camLead).",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "x",
                      "type": "number",
                      "required": true
                    },
                    {
                      "name": "y",
                      "type": "number",
                      "required": true
                    },
                    {
                      "name": "vx",
                      "type": "number",
                      "required": true
                    }
                  ]
                },
                {
                  "key": "CUT",
                  "id": "evt_01M1KT7VDHP8EPRYARWY431Q8A",
                  "name": "Cut",
                  "description": "Snap position and target instantly, no ease — teleports and cutscenes.",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "x",
                      "type": "number",
                      "required": true
                    },
                    {
                      "name": "y",
                      "type": "number",
                      "required": true
                    }
                  ]
                },
                {
                  "key": "SET_ZOOM",
                  "id": "evt_01M1KT7VDH7GM6FBFHVF1VJRNH",
                  "name": "Set Zoom",
                  "description": "Retarget zoom, clamped to minZoom/maxZoom.",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "zoom",
                      "type": "number",
                      "required": true
                    }
                  ]
                },
                {
                  "key": "SHAKE",
                  "id": "evt_01M1KT7VDH7EM7H3VR4949R1EX",
                  "name": "Shake",
                  "description": "Set camShake; a consumer jitters camX/camY with it at bind time — this atom never writes shake into position.",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "magnitude",
                      "type": "number",
                      "required": true
                    }
                  ]
                },
                {
                  "key": "RESTART",
                  "id": "evt_01M1KT7VDHD96YA0S3RPC9MRCC",
                  "name": "Restart",
                  "description": "Reseed position/zoom/lead/shake from config.",
                  "tier": "domain"
                },
                {
                  "key": "CAMERA_MOVED",
                  "id": "evt_01M1KT7VDHACZBVYWSJ1XT0XT4",
                  "name": "Camera Moved",
                  "description": "Eased camera position/zoom after this tick.",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "x",
                      "type": "number",
                      "required": true
                    },
                    {
                      "name": "y",
                      "type": "number",
                      "required": true
                    },
                    {
                      "name": "zoom",
                      "type": "number",
                      "required": true
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "active",
                  "to": "active",
                  "event": "INIT",
                  "eventId": "evt_01M1KT7VDHP97MNNBCK21F9XF0",
                  "effects": [
                    [
                      "set",
                      "@entity.camX",
                      0
                    ],
                    [
                      "set",
                      "@entity.camY",
                      0
                    ],
                    [
                      "set",
                      "@entity.camZoom",
                      1
                    ],
                    [
                      "set",
                      "@entity.camTargetX",
                      0
                    ],
                    [
                      "set",
                      "@entity.camTargetY",
                      0
                    ],
                    [
                      "set",
                      "@entity.camTargetZoom",
                      1
                    ],
                    [
                      "set",
                      "@entity.camLead",
                      0
                    ],
                    [
                      "set",
                      "@entity.camShake",
                      0
                    ]
                  ]
                },
                {
                  "from": "active",
                  "to": "active",
                  "event": "FOLLOW",
                  "eventId": "evt_01M1KT7VDH27J939V4G8J199KT",
                  "effects": [
                    [
                      "set",
                      "@entity.camTargetX",
                      "@payload.x"
                    ],
                    [
                      "set",
                      "@entity.camTargetY",
                      "@payload.y"
                    ],
                    [
                      "set",
                      "@entity.camLead",
                      [
                        "*",
                        "@payload.vx",
                        0
                      ]
                    ]
                  ]
                },
                {
                  "from": "active",
                  "to": "active",
                  "event": "CUT",
                  "eventId": "evt_01M1KT7VDHP8EPRYARWY431Q8A",
                  "effects": [
                    [
                      "set",
                      "@entity.camX",
                      "@payload.x"
                    ],
                    [
                      "set",
                      "@entity.camY",
                      "@payload.y"
                    ],
                    [
                      "set",
                      "@entity.camTargetX",
                      "@payload.x"
                    ],
                    [
                      "set",
                      "@entity.camTargetY",
                      "@payload.y"
                    ],
                    [
                      "set",
                      "@entity.camLead",
                      0
                    ]
                  ]
                },
                {
                  "from": "active",
                  "to": "active",
                  "event": "SET_ZOOM",
                  "eventId": "evt_01M1KT7VDH7GM6FBFHVF1VJRNH",
                  "effects": [
                    [
                      "set",
                      "@entity.camTargetZoom",
                      [
                        "math/clamp",
                        "@payload.zoom",
                        0.5,
                        3
                      ]
                    ]
                  ]
                },
                {
                  "from": "active",
                  "to": "active",
                  "event": "SHAKE",
                  "eventId": "evt_01M1KT7VDH7EM7H3VR4949R1EX",
                  "effects": [
                    [
                      "set",
                      "@entity.camShake",
                      "@payload.magnitude"
                    ]
                  ]
                },
                {
                  "from": "active",
                  "to": "active",
                  "event": "RESTART",
                  "eventId": "evt_01M1KT7VDHD96YA0S3RPC9MRCC",
                  "effects": [
                    [
                      "set",
                      "@entity.camX",
                      0
                    ],
                    [
                      "set",
                      "@entity.camY",
                      0
                    ],
                    [
                      "set",
                      "@entity.camZoom",
                      1
                    ],
                    [
                      "set",
                      "@entity.camTargetX",
                      0
                    ],
                    [
                      "set",
                      "@entity.camTargetY",
                      0
                    ],
                    [
                      "set",
                      "@entity.camTargetZoom",
                      1
                    ],
                    [
                      "set",
                      "@entity.camLead",
                      0
                    ],
                    [
                      "set",
                      "@entity.camShake",
                      0
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "camTick",
                "interval": 33,
                "guard": true,
                "effects": [
                  [
                    "do",
                    [
                      "set",
                      "@entity.camX",
                      [
                        "math/clamp",
                        [
                          "if",
                          [
                            ">",
                            [
                              "math/abs",
                              [
                                "-",
                                [
                                  "+",
                                  "@entity.camTargetX",
                                  "@entity.camLead"
                                ],
                                "@entity.camX"
                              ]
                            ],
                            0
                          ],
                          [
                            "math/lerp",
                            "@entity.camX",
                            [
                              "+",
                              "@entity.camTargetX",
                              "@entity.camLead"
                            ],
                            0.1
                          ],
                          "@entity.camX"
                        ],
                        -1000000,
                        1000000
                      ]
                    ],
                    [
                      "set",
                      "@entity.camY",
                      [
                        "math/clamp",
                        [
                          "if",
                          [
                            ">",
                            [
                              "math/abs",
                              [
                                "-",
                                "@entity.camTargetY",
                                "@entity.camY"
                              ]
                            ],
                            0
                          ],
                          [
                            "math/lerp",
                            "@entity.camY",
                            "@entity.camTargetY",
                            0.1
                          ],
                          "@entity.camY"
                        ],
                        -1000000,
                        1000000
                      ]
                    ],
                    [
                      "set",
                      "@entity.camZoom",
                      [
                        "math/clamp",
                        [
                          "math/lerp",
                          "@entity.camZoom",
                          "@entity.camTargetZoom",
                          0.1
                        ],
                        0.5,
                        3
                      ]
                    ],
                    [
                      "set",
                      "@entity.camShake",
                      [
                        "math/max",
                        0,
                        [
                          "-",
                          "@entity.camShake",
                          0.1
                        ]
                      ]
                    ]
                  ],
                  [
                    "emit",
                    "CAMERA_MOVED",
                    {
                      "zoom": "@entity.camZoom",
                      "x": "@entity.camX",
                      "y": "@entity.camY"
                    }
                  ]
                ]
              }
            ],
            "config": {
              "stiffness": {
