                "description": "World-space clamp applied to the eased camera position every tick",
                "tier": "presentation",
                "properties": {
                  "xMax": {
                    "name": "xMax",
                    "type": "number",
                    "required": true
                  },
                  "yMax": {
                    "name": "yMax",
                    "type": "number",
                    "required": true
                  },
                  "xMin": {
                    "name": "xMin",
                    "type": "number",
                    "required": true
                  },
                  "yMin": {
                    "name": "yMin",
                    "type": "number",
                    "required": true
                  }
                }
              },
              "shakeDecay": {
                "type": "number",
                "default": 0.1,
                "label": "Shake Decay",
                "description": "Amount camShake reduces toward 0 every tick",
                "tier": "presentation"
              },
              "maxZoom": {
                "type": "number",
                "default": 3,
                "label": "Max Zoom",
                "description": "Upper clamp for SET_ZOOM and the eased zoom",
                "tier": "presentation"
              },
              "lead": {
                "type": "number",
                "default": 0,
                "label": "Lead",
                "description": "Horizontal look-ahead multiplier applied to FOLLOW's vx",
                "tier": "presentation"
              },
              "deadzoneY": {
                "type": "number",
                "default": 0,
                "label": "Dead Zone Y",
                "description": "Vertical distance from target the camera tolerates without easing",
                "tier": "presentation"
              },
              "start": {
                "type": "CameraPos",
                "default": {
                  "x": 0,
                  "y": 0
                },
                "label": "Start Position",
                "description": "Initial and RESTART camera position/target",
                "tier": "domain",
                "properties": {
                  "y": {
                    "name": "y",
                    "type": "number",
                    "required": true
                  },
                  "x": {
                    "name": "x",
                    "type": "number",
                    "required": true
                  }
                }
              }
            },
            "scope": "instance"
          }
        ],
