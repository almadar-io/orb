  "source": "",
  "lolo": "app ui-image \"1.0.0\"\n\"Image — UI factory (1:1 with the @almadar/ui image pattern).\"\n;; @pattern \"image\"\norbital ImageOrbital {\n  entity ImageItem [runtime] {\n    id : string!\n  }\n\n  trait ImageRender -> @rebindable ImageItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          src: @config.src\n          alt: @config.alt\n          fit: @config.fit\n          aspect: @config.aspect\n          rounded: @config.rounded\n          bordered: @config.bordered\n          loading: @config.loading\n          className: @config.className\n          type: image\n        })\n    }\n\n    config {\n      src : asset = \"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png\"\n        @label \"Src\"\n        @description \"Image source URL\"\n        @tier \"presentation\"\n      alt : string = \"\"\n        @label \"Alt\"\n        @description \"Alternative text; empty string marks the image decorative\"\n        @tier \"presentation\"\n      fit : \"cover\" | \"contain\" | \"fill\" | \"none\" = cover\n        @label \"Fit\"\n        @description \"How the image fills its box\"\n        @tier \"presentation\"\n      aspect : \"auto\" | \"1/1\" | \"4/3\" | \"3/2\" | \"16/9\" | \"21/9\" = auto\n        @label \"Aspect\"\n        @description \"Fixed aspect ratio of the box; 'auto' keeps the image's own\"\n        @tier \"presentation\"\n      rounded : \"none\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" | \"full\" = md\n        @label \"Rounded\"\n        @description \"Corner rounding\"\n        @tier \"presentation\"\n      bordered : boolean = false\n        @label \"Bordered\"\n        @description \"Draw a subtle border around the image\"\n        @tier \"presentation\"\n      loading : \"lazy\" | \"eager\" = lazy\n        @label \"Loading\"\n        @description \"'lazy' defers off-screen images; 'eager' for above-the-fold media\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/image\" as ImagePage -> ImageRender\n}\n"
}