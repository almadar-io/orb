  "source": "",
  "lolo": "app ui-carousel \"1.0.0\"\n\"Carousel — UI factory (1:1 with the @almadar/ui carousel pattern).\"\norbital CarouselOrbital {\n  type CarouselItemsItem = {\n    id : string\n    title : string\n    image : asset\n  }\n\n  entity CarouselItem [runtime] {\n    id : string!\n  }\n\n  trait CarouselRender -> @rebindable CarouselItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          items: @config.items\n          autoPlay: @config.autoPlay\n          autoPlayInterval: @config.autoPlayInterval\n          showDots: @config.showDots\n          showArrows: @config.showArrows\n          loop: @config.loop\n          slideChangeEvent: @config.slideChangeEvent\n          slideChangePayload: @config.slideChangePayload\n          className: @config.className\n          type: carousel\n        })\n    }\n\n    emits {\n      @config.slideChangeEvent -> external {\n        index : number!\n      }\n        @description \"Declarative event name for slide change\"\n        @tier \"essential\"\n    }\n\n    config {\n      items : [CarouselItemsItem] = [{ id: \"Id\", title: \"Title\", image: \"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png\" }, { id: \"Id 2\", title: \"Title 2\", image: \"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png\" }]\n        @label \"Items\"\n        @description \"Array of items to display as slides\"\n        @tier \"presentation\"\n      autoPlay : boolean = false\n        @label \"Auto Play\"\n        @description \"Enable auto-play rotation\"\n        @tier \"presentation\"\n      autoPlayInterval : number = 5000\n        @label \"Auto Play Interval\"\n        @description \"Auto-play interval in milliseconds (default: 5000)\"\n        @tier \"presentation\"\n      showDots : boolean = true\n        @label \"Show Dots\"\n        @description \"Show dot indicators\"\n        @tier \"presentation\"\n      showArrows : boolean = true\n        @label \"Show Arrows\"\n        @description \"Show prev/next arrow buttons\"\n        @tier \"presentation\"\n      loop : boolean = false\n        @label \"Loop\"\n        @description \"Enable infinite loop\"\n        @tier \"presentation\"\n      slideChangeEvent : event = \"SLIDE_CHANGE\"\n        @label \"Slide Change Event\"\n        @description \"Declarative event name for slide change\"\n        @tier \"presentation\"\n      slideChangePayload : @payload @config.slideChangeEvent\n        @label \"Slide Change Payload\"\n        @description \"Payload to include with the slide change event\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/carousel\" as CarouselPage -> CarouselRender\n}\n"
}