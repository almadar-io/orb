  "source": "",
  "lolo": "app ui-doc-search \"1.0.0\"\n\"DocSearch — UI factory (1:1 with the @almadar/ui doc-search pattern).\"\norbital DocSearchOrbital {\n  entity DocSearchItem [runtime] {\n    id : string!\n  }\n\n  trait DocSearchRender -> @rebindable DocSearchItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          placeholder: @config.placeholder\n          className: @config.className\n          type: doc-search\n        })\n    }\n\n    config {\n      placeholder : string\n        @label \"Placeholder\"\n        @description \"Placeholder text for the input\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/doc-search\" as DocSearchPage -> DocSearchRender\n}\n"
