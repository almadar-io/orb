  "source": "",
  "lolo": "app ui-dialog \"1.0.0\"\n\"Dialog — UI factory (1:1 with the @almadar/ui dialog pattern).\"\norbital DialogOrbital {\n  entity DialogItem [runtime] {\n    id : string!\n  }\n\n  trait DialogRender -> @rebindable DialogItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          children: @config.children\n          type: dialog\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Dialog contents\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/dialog\" as DialogPage -> DialogRender\n}\n"
