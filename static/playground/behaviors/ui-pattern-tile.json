  "source": "",
  "lolo": "app ui-pattern-tile \"1.0.0\"\n\"PatternTile — UI factory (1:1 with the @almadar/ui pattern-tile pattern).\"\n;; @pattern \"pattern-tile\"\norbital PatternTileOrbital {\n  entity PatternTileItem [runtime] {\n    id : string!\n  }\n\n  trait PatternTileRender -> @rebindable PatternTileItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          variant: @config.variant\n          size: @config.size\n          color: @config.color\n          strokeWidth: @config.strokeWidth\n          className: @config.className\n          type: pattern-tile\n        })\n    }\n\n    config {\n      variant : \"star8\" | \"star6\" | \"khatam\" | \"star10\" | \"star12\" | \"rosette-double\" | \"rosette-filled\" | \"seigaiha\" | \"greek-key\" | \"celtic-knot\" | \"kolam\" | \"arch\" | \"arabesque-vine\" | \"arabesque-net\" = star8\n        @label \"Variant\"\n        @description \"Which geometric pattern to render\"\n        @tier \"presentation\"\n      size : number = 60\n        @label \"Size\"\n        @description \"Tile unit size in SVG units\"\n        @tier \"presentation\"\n      color : string = \"var(--color-primary)\"\n        @label \"Color\"\n        @description \"Stroke color (CSS variable or hex)\"\n        @tier \"presentation\"\n      strokeWidth : number = 0.5\n        @label \"Stroke Width\"\n        @description \"Line thickness\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/pattern-tile\" as PatternTilePage -> PatternTileRender\n}\n"
}