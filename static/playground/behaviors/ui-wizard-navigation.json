  "source": "",
  "lolo": "app ui-wizard-navigation \"1.0.0\"\n\"WizardNavigation — UI factory (1:1 with the @almadar/ui wizard-navigation pattern).\"\norbital WizardNavigationOrbital {\n  entity WizardNavigationItem [runtime] {\n    id : string!\n    currentStep : number = 1\n    totalSteps : number = 1\n  }\n\n  trait WizardNavigationRender -> @rebindable WizardNavigationItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.currentStep @config.currentStep)\n        (set @entity.totalSteps @config.totalSteps)\n        (render-ui main {\n          currentStep: @entity.currentStep\n          totalSteps: @entity.totalSteps\n          isValid: @config.isValid\n          showBack: @config.showBack\n          showNext: @config.showNext\n          showComplete: @config.showComplete\n          backLabel: @config.backLabel\n          nextLabel: @config.nextLabel\n          completeLabel: @config.completeLabel\n          onBack: @config.onBack\n          onNext: @config.onNext\n          onComplete: @config.onComplete\n          onBackClick: @config.onBackClick\n          onNextClick: @config.onNextClick\n          onCompleteClick: @config.onCompleteClick\n          compact: @config.compact\n          className: @config.className\n          type: wizard-navigation\n        })\n      BACK -> idle\n        (set @entity.currentStep ?currentStep)\n        (set @entity.totalSteps ?totalSteps)\n        (render-ui main {\n          currentStep: @entity.currentStep\n          totalSteps: @entity.totalSteps\n          isValid: @config.isValid\n          showBack: @config.showBack\n          showNext: @config.showNext\n          showComplete: @config.showComplete\n          backLabel: @config.backLabel\n          nextLabel: @config.nextLabel\n          completeLabel: @config.completeLabel\n          onBack: @config.onBack\n          onNext: @config.onNext\n          onComplete: @config.onComplete\n          onBackClick: @config.onBackClick\n          onNextClick: @config.onNextClick\n          onCompleteClick: @config.onCompleteClick\n          compact: @config.compact\n          className: @config.className\n          type: wizard-navigation\n        })\n      NEXT -> idle\n        (set @entity.currentStep ?currentStep)\n        (set @entity.totalSteps ?totalSteps)\n        (render-ui main {\n          currentStep: @entity.currentStep\n          totalSteps: @entity.totalSteps\n          isValid: @config.isValid\n          showBack: @config.showBack\n          showNext: @config.showNext\n          showComplete: @config.showComplete\n          backLabel: @config.backLabel\n          nextLabel: @config.nextLabel\n          completeLabel: @config.completeLabel\n          onBack: @config.onBack\n          onNext: @config.onNext\n          onComplete: @config.onComplete\n          onBackClick: @config.onBackClick\n          onNextClick: @config.onNextClick\n          onCompleteClick: @config.onCompleteClick\n          compact: @config.compact\n          className: @config.className\n          type: wizard-navigation\n        })\n      COMPLETE -> idle\n        (set @entity.currentStep ?currentStep)\n        (set @entity.totalSteps ?totalSteps)\n        (render-ui main {\n          currentStep: @entity.currentStep\n          totalSteps: @entity.totalSteps\n          isValid: @config.isValid\n          showBack: @config.showBack\n          showNext: @config.showNext\n          showComplete: @config.showComplete\n          backLabel: @config.backLabel\n          nextLabel: @config.nextLabel\n          completeLabel: @config.completeLabel\n          onBack: @config.onBack\n          onNext: @config.onNext\n          onComplete: @config.onComplete\n          onBackClick: @config.onBackClick\n          onNextClick: @config.onNextClick\n          onCompleteClick: @config.onCompleteClick\n          compact: @config.compact\n          className: @config.className\n          type: wizard-navigation\n        })\n    }\n\n    emits {\n      @config.onBack -> external {\n        currentStep : number!\n        totalSteps : number!\n      }\n        @description \"Event to emit on Back click — emits UI:{onBack} with { currentStep, totalSteps }\"\n        @tier \"essential\"\n      @config.onNext -> external {\n        currentStep : number!\n        totalSteps : number!\n      }\n        @description \"Event to emit on Next click — emits UI:{onNext} with { currentStep, totalSteps }\"\n        @tier \"essential\"\n      @config.onComplete -> external {\n        currentStep : number!\n        totalSteps : number!\n      }\n        @description \"Event to emit on Complete click — emits UI:{onComplete} with { currentStep, totalSteps }\"\n        @tier \"essential\"\n      @config.onBackClick -> external { }\n        @description \"Direct callback for Back (alternative to event)\"\n        @tier \"essential\"\n      @config.onNextClick -> external { }\n        @description \"Direct callback for Next (alternative to event)\"\n        @tier \"essential\"\n      @config.onCompleteClick -> external { }\n        @description \"Direct callback for Complete (alternative to event)\"\n        @tier \"essential\"\n    }\n\n    listens {\n      BACK {\n        currentStep : number!\n        totalSteps : number!\n      }\n      NEXT {\n        currentStep : number!\n        totalSteps : number!\n      }\n      COMPLETE {\n        currentStep : number!\n        totalSteps : number!\n      }\n    }\n\n    config {\n      currentStep : number = 1\n        @label \"Current Step\"\n        @description \"Current step index (0-based)\"\n        @tier \"presentation\"\n      totalSteps : number = 1\n        @label \"Total Steps\"\n        @description \"Total number of steps\"\n        @tier \"presentation\"\n      isValid : boolean = true\n        @label \"Is Valid\"\n        @description \"Whether the current step is valid (enables Next/Complete)\"\n        @tier \"presentation\"\n      showBack : boolean = true\n        @label \"Show Back\"\n        @description \"Show the Back button\"\n        @tier \"presentation\"\n      showNext : boolean = true\n        @label \"Show Next\"\n        @description \"Show the Next button\"\n        @tier \"presentation\"\n      showComplete : boolean = true\n        @label \"Show Complete\"\n        @description \"Show the Complete button (on last step)\"\n        @tier \"presentation\"\n      backLabel : string\n        @label \"Back Label\"\n        @description \"Custom label for Back button\"\n        @tier \"presentation\"\n      nextLabel : string\n        @label \"Next Label\"\n        @description \"Custom label for Next button\"\n        @tier \"presentation\"\n      completeLabel : string\n        @label \"Complete Label\"\n        @description \"Custom label for Complete button\"\n        @tier \"presentation\"\n      onBack : event = \"BACK\"\n        @label \"On Back\"\n        @description \"Event to emit on Back click — emits UI:{onBack} with { currentStep, totalSteps }\"\n        @tier \"presentation\"\n      onNext : event = \"NEXT\"\n        @label \"On Next\"\n        @description \"Event to emit on Next click — emits UI:{onNext} with { currentStep, totalSteps }\"\n        @tier \"presentation\"\n      onComplete : event = \"COMPLETE\"\n        @label \"On Complete\"\n        @description \"Event to emit on Complete click — emits UI:{onComplete} with { currentStep, totalSteps }\"\n        @tier \"presentation\"\n      onBackClick : event = \"BACK_CLICK\"\n        @label \"On Back Click\"\n        @description \"Direct callback for Back (alternative to event)\"\n        @tier \"presentation\"\n      onNextClick : event = \"NEXT_CLICK\"\n        @label \"On Next Click\"\n        @description \"Direct callback for Next (alternative to event)\"\n        @tier \"presentation\"\n      onCompleteClick : event = \"COMPLETE_CLICK\"\n        @label \"On Complete Click\"\n        @description \"Direct callback for Complete (alternative to event)\"\n        @tier \"presentation\"\n      compact : boolean = false\n        @label \"Compact\"\n        @description \"Compact mode (smaller padding)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/wizard-navigation\" as WizardNavigationPage -> WizardNavigationRender\n}\n"
}