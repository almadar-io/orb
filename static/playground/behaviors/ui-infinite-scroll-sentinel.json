  "source": "",
  "lolo": "app ui-infinite-scroll-sentinel \"1.0.0\"\n\"InfiniteScrollSentinel — UI factory (1:1 with the @almadar/ui infinite-scroll-sentinel pattern).\"\norbital InfiniteScrollSentinelOrbital {\n  entity InfiniteScrollSentinelItem [runtime] {\n    id : string!\n  }\n\n  trait InfiniteScrollSentinelRender -> @rebindable InfiniteScrollSentinelItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          loadMoreEvent: @config.loadMoreEvent\n          loadMorePayload: @config.loadMorePayload\n          isLoading: @config.isLoading\n          hasMore: @config.hasMore\n          threshold: @config.threshold\n          className: @config.className\n          type: infinite-scroll-sentinel\n        })\n    }\n\n    emits {\n      @config.loadMoreEvent -> external { }\n        @description \"Event name to emit when load-more is triggered (emitted as UI:{loadMoreEvent})\"\n        @tier \"essential\"\n    }\n\n    config {\n      loadMoreEvent : event = \"LOAD_MORE\"\n        @label \"Load More Event\"\n        @description \"Event name to emit when load-more is triggered (emitted as UI:{loadMoreEvent})\"\n        @tier \"presentation\"\n      loadMorePayload : @payload @config.loadMoreEvent\n        @label \"Load More Payload\"\n        @description \"Optional payload to include with the load-more event\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Whether a load operation is currently in progress\"\n        @tier \"presentation\"\n      hasMore : boolean = true\n        @label \"Has More\"\n        @description \"Whether there are more items to load\"\n        @tier \"presentation\"\n      threshold : string = \"200px\"\n        @label \"Threshold\"\n        @description \"IntersectionObserver rootMargin for early trigger\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/infinite-scroll-sentinel\" as InfiniteScrollSentinelPage -> InfiniteScrollSentinelRender\n}\n"
}