  "source": "",
  "lolo": "app ui-doc-pagination \"1.0.0\"\n\"DocPagination — UI factory (1:1 with the @almadar/ui doc-pagination pattern).\"\norbital DocPaginationOrbital {\n  type DocPaginationPrev = {\n    label : string!\n    href : string!\n    category : string\n  }\n  type DocPaginationNext = {\n    label : string!\n    href : string!\n    category : string\n  }\n\n  entity DocPaginationItem [runtime] {\n    id : string!\n  }\n\n  trait DocPaginationRender -> @rebindable DocPaginationItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          prev: @config.prev\n          next: @config.next\n          className: @config.className\n          type: doc-pagination\n        })\n    }\n\n    config {\n      prev : DocPaginationPrev\n        @label \"Prev\"\n        @description \"Previous page link\"\n        @tier \"presentation\"\n      next : DocPaginationNext\n        @label \"Next\"\n        @description \"Next page link\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/doc-pagination\" as DocPaginationPage -> DocPaginationRender\n}\n"
