                      "type": "number"
                    },
                    {
                      "name": "movesLeft",
                      "type": "number"
                    }
                  ]
                },
                {
                  "key": "RESTART",
                  "id": "evt_01KXG04TMDQ2D8YB9TF61MBJXS",
                  "name": "Restart",
                  "payloadSchema": [
                    {
                      "name": "id",
                      "type": "string"
                    }
                  ]
                },
                {
                  "key": "BURST",
                  "id": "evt_01KXG04TMDP8E9QFPSBVP6JY6F",
                  "name": "Burst",
                  "description": "Serve or starve particle burst; a fx-particles listener spawns it",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "particles",
                      "type": "[Fx]"
                    }
                  ]
                },
                {
                  "key": "SERVICE_CHANGED",
                  "id": "evt_01KXG04TMDJ0P9G6FBDZHNZE8S",
                  "name": "Service Changed",
                  "description": "Served/pending/lost counts after this step; a market-flow listener decides win/lose",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "served",
                      "type": "number",
                      "required": true
                    },
                    {
                      "name": "pending",
                      "type": "number",
                      "required": true
                    },
                    {
                      "name": "lost",
                      "type": "number",
                      "required": true
                    }
                  ]
                },
                {
                  "key": "CUSTOMER_LOST",
                  "id": "evt_01KXG04TMD18MD7G0NQ0R94SVW",
                  "name": "Customer Lost",
                  "description": "Emitted when one or more customers' patience expires in the same tick",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "count",
                      "type": "number",
                      "required": true
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "active",
                  "to": "active",
                  "event": "INIT",
                  "eventId": "evt_01KXG04TMDVJCPKE3E025GJ79M",
                  "effects": [
                    [
                      "set",
                      "@entity.customers",
                      []
                    ],
                    [
                      "set",
                      "@entity.served",
                      0
                    ],
                    [
                      "set",
                      "@entity.pending",
                      [
                        "array/len",
                        []
                      ]
                    ],
                    [
                      "set",
                      "@entity.lost",
                      0
                    ]
                  ]
                },
                {
                  "from": "active",
                  "to": "active",
                  "event": "HERO_STEPPED",
                  "eventId": "evt_01KXG04TMDT2TJJHAMSWGFACCG",
                  "guard": true,
                  "effects": [
                    [
                      "let",
                      [
                        [
                          "matched",
                          [
                            "array/filter",
                            "@entity.customers",
                            [
                              "fn",
                              "c",
                              [
                                "<=",
                                [
                                  "grid/manhattan-distance",
                                  [
                                    "object/get",
                                    "@c",
                                    "position"
                                  ],
                                  {
                                    "y": "@payload.z",
                                    "x": "@payload.x"
                                  }
                                ],
                                1
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "let",
                        [
                          [
                            "hitCount",
                            [
                              "array/len",
                              "@matched"
                            ]
                          ]
                        ],
                        [
                          "do",
                          [
                            "set",
                            "@entity.customers",
                            [
                              "array/map",
                              "@entity.customers",
                              [
                                "fn",
                                "c",
                                [
                                  "if",
                                  [
                                    "<=",
                                    [
                                      "grid/manhattan-distance",
                                      [
                                        "object/get",
                                        "@c",
                                        "position"
                                      ],
                                      {
                                        "y": "@payload.z",
                                        "x": "@payload.x"
                                      }
                                    ],
                                    1
                                  ],
                                  [
                                    "object/merge",
                                    "@c",
                                    {
                                      "patience": "@c.maxPatience"
                                    }
                                  ],
                                  "@c"
                                ]
                              ]
                            ]
                          ],
                          [
                            "set",
                            "@entity.served",
                            [
                              "+",
                              "@entity.served",
                              "@hitCount"
                            ]
                          ],
                          [
                            "emit",
                            "BURST",
                            {
                              "particles": [
                                "array/map",
                                "@matched",
                                [
                                  "fn",
                                  "c",
                                  {
                                    "ttl": 3,
                                    "id": [
                                      "str/concat",
                                      "fx-serve-",
                                      "@c.id"
                                    ],
                                    "type": "score",
                                    "x": [
                                      "object/get",
                                      [
                                        "object/get",
                                        "@c",
                                        "position"
                                      ],
                                      "x"
                                    ],
                                    "message": "+1",
                                    "z": [
                                      "object/get",
                                      [
                                        "object/get",
                                        "@c",
                                        "position"
                                      ],
                                      "y"
                                    ]
                                  }
                                ]
                              ]
                            }
                          ],
                          [
                            "emit",
                            "SERVICE_CHANGED",
                            {
                              "served": "@entity.served",
                              "lost": "@entity.lost",
                              "pending": "@entity.pending"
                            }
                          ]
                        ]
                      ]
                    ]
                  ]
                },
                {
                  "from": "active",
                  "to": "active",
                  "event": "RESTART",
                  "eventId": "evt_01KXG04TMDQ2D8YB9TF61MBJXS",
                  "effects": [
                    [
                      "set",
                      "@entity.customers",
                      []
                    ],
                    [
                      "set",
                      "@entity.served",
                      0
                    ],
                    [
                      "set",
                      "@entity.pending",
                      [
                        "array/len",
                        []
                      ]
                    ],
                    [
                      "set",
                      "@entity.lost",
                      0
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "patienceTick",
                "interval": 1000,
                "guard": true,
                "effects": [
                  [
                    "set",
                    "@entity.customers",
                    [
                      "array/map",
                      "@entity.customers",
                      [
                        "fn",
                        "c",
                        [
                          "object/merge",
                          "@c",
                          {
                            "patience": [
                              "math/clamp",
                              [
                                "-",
                                "@c.patience",
                                1
                              ],
                              0,
                              "@c.maxPatience"
                            ]
                          }
                        ]
                      ]
                    ]
                  ],
                  [
                    "let",
                    [
                      [
                        "starved",
                        [
                          "array/filter",
                          "@entity.customers",
                          [
                            "fn",
                            "c",
                            [
                              "<=",
                              "@c.patience",
                              0
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "let",
                      [
                        [
                          "starvedCount",
                          [
                            "array/len",
                            "@starved"
                          ]
                        ]
                      ],
                      [
                        "do",
                        [
                          "set",
                          "@entity.lost",
                          [
                            "+",
                            "@entity.lost",
                            "@starvedCount"
                          ]
                        ],
                        [
                          "set",
                          "@entity.customers",
                          [
                            "array/map",
                            "@entity.customers",
                            [
                              "fn",
                              "c",
                              [
                                "if",
                                [
                                  "<=",
                                  "@c.patience",
                                  0
                                ],
                                [
                                  "object/merge",
                                  "@c",
                                  {
                                    "patience": "@c.maxPatience"
                                  }
                                ],
                                "@c"
                              ]
                            ]
                          ]
                        ],
                        [
                          "if",
                          [
                            ">",
                            "@starvedCount",
                            0
                          ],
                          [
                            "emit",
                            "BURST",
                            {
                              "particles": [
                                "array/map",
                                "@starved",
                                [
                                  "fn",
                                  "c",
                                  {
                                    "id": [
                                      "str/concat",
                                      "fx-starve-",
                                      "@c.id"
                                    ],
                                    "ttl": 3,
                                    "type": "damage",
                                    "message": "-1 life",
                                    "x": [
                                      "object/get",
                                      [
                                        "object/get",
                                        "@c",
                                        "position"
                                      ],
                                      "x"
                                    ],
                                    "z": [
                                      "object/get",
                                      [
                                        "object/get",
                                        "@c",
                                        "position"
                                      ],
                                      "y"
                                    ]
                                  }
                                ]
                              ]
                            }
                          ],
                          null
                        ],
                        [
                          "if",
                          [
                            ">",
                            "@starvedCount",
                            0
                          ],
                          [
                            "emit",
                            "CUSTOMER_LOST",
                            {
                              "count": "@starvedCount"
                            }
                          ],
                          null
                        ],
                        [
                          "emit",
                          "SERVICE_CHANGED",
                          {
                            "pending": "@entity.pending",
                            "served": "@entity.served",
                            "lost": "@entity.lost"
                          }
                        ]
                      ]
                    ]
                  ]
                ]
              }
