  "lolo": "app std-patience \"1.0.0\"\n\"Headless customer-service mechanic: owns a stationary customer roster with per-customer patience. Decrements patience every tick, serves nearby customers on HERO_STEPPED (resets their patience + scores), and emits CUSTOMER_LOST when a timer expires. Never writes units.\"\norbital PatienceOrbital {\n  type Asset = {\n    url : asset\n    role : string\n    category : string\n    animations : [string]\n    style : string\n    dimension : string\n    aspect : string\n    name : string\n    thumbnailUrl : string\n  }\n  type Customer = {\n    id : string!\n    position : { x : number!  y : number! }\n    patience : number\n    maxPatience : number\n    unitType : string\n    name : string\n    team : string\n    modelUrl : Asset\n  }\n  type Fx = {\n    id : string!\n    type : string!\n    x : number!\n    z : number\n    y : number\n    message : string\n    ttl : number!\n  }\n\n  entity PatienceData [runtime, shared] {\n    id : string!\n    customers : [Customer]\n    served : number = 0\n    pending : number = 0\n    lost : number = 0\n  }\n\n  trait Patience -> @rebindable PatienceData [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.customers @config.customers)\n        (set @entity.served 0)\n        (set @entity.pending (array/len @config.customers))\n        (set @entity.lost 0)\n\n      HERO_STEPPED -> active when @config.running\n        (let ((matched (array/filter @entity.customers (fn c (<= (grid/manhattan-distance (object/get @c position) { x: @payload.x, y: @payload.z }) @config.serveRadius)))))\n        (let ((hitCount (array/len @matched)))\n        (do\n          (set @entity.customers (array/map @entity.customers (fn c (if (<= (grid/manhattan-distance (object/get @c position) { x: @payload.x, y: @payload.z }) @config.serveRadius) (object/merge @c { patience: @c.maxPatience }) @c))))\n          (set @entity.served (+ @entity.served @hitCount))\n          (emit BURST { particles: (array/map @matched (fn c { id: (str/concat \"fx-serve-\" @c.id), type: \"score\", x: (object/get (object/get @c position) x), z: (object/get (object/get @c position) y), message: \"+1\", ttl: 3 })) })\n          (emit SERVICE_CHANGED { served: @entity.served, pending: @entity.pending, lost: @entity.lost })\n        )))\n\n      RESTART -> active\n        (set @entity.customers @config.customers)\n        (set @entity.served 0)\n        (set @entity.pending (array/len @config.customers))\n        (set @entity.lost 0)\n    }\n\n    ticks {\n      patienceTick every 1000ms\n        when @config.running\n        (set @entity.customers (array/map @entity.customers (fn c (object/merge @c { patience: (math/clamp (- @c.patience 1) 0 @c.maxPatience) }))))\n        (let ((starved (array/filter @entity.customers (fn c (<= @c.patience 0)))))\n        (let ((starvedCount (array/len @starved)))\n        (do\n          (set @entity.lost (+ @entity.lost @starvedCount))\n          (set @entity.customers (array/map @entity.customers (fn c (if (<= @c.patience 0) (object/merge @c { patience: @c.maxPatience }) @c))))\n          (if (> @starvedCount 0) (emit BURST { particles: (array/map @starved (fn c { id: (str/concat \"fx-starve-\" @c.id), type: \"damage\", x: (object/get (object/get @c position) x), z: (object/get (object/get @c position) y), message: \"-1 life\", ttl: 3 })) }) null)\n          (if (> @starvedCount 0) (emit CUSTOMER_LOST { count: @starvedCount }) null)\n          (emit SERVICE_CHANGED { served: @entity.served, pending: @entity.pending, lost: @entity.lost })\n        )))\n    }\n\n    emits {\n      BURST -> external {\n        particles : [Fx]\n      }\n        @description \"Serve or starve particle burst; a fx-particles listener spawns it\"\n        @tier \"domain\"\n      SERVICE_CHANGED -> external {\n        served : number!\n        pending : number!\n        lost : number!\n      }\n        @description \"Served/pending/lost counts after this step; a market-flow listener decides win/lose\"\n        @tier \"domain\"\n      CUSTOMER_LOST -> external {\n        count : number!\n      }\n        @description \"Emitted when one or more customers' patience expires in the same tick\"\n        @tier \"domain\"\n    }\n\n    listens {\n      HERO_STEPPED { unitId : string, x : number, z : number, movesLeft : number }\n      RESTART { id : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, patience ticks down and HERO_STEPPED serves nearby customers; toggle to freeze\"\n        @tier \"domain\"\n      customers : [Customer] = []\n        @label \"Customers\"\n        @description \"Seed roster of stationary customers, each with their own position + patience/maxPatience\"\n        @tier \"domain\"\n      serveRadius : number = 1\n        @label \"Serve Radius\"\n        @description \"Manhattan distance at which a customer counts as served by the hero's last step: 0 = step onto tile, 1 = adjacent\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/patience\" as PatiencePage -> Patience\n}\n"
}