  "source": "",
  "lolo": "app std-arcade-play \"1.0.0\"\n\"Headless arcade play-economy mechanic: the SOLE writer of tokens + tickets + machines. Applies a PLAY_MACHINE intent (spends a token, rolls a pseudo-random ticket payout within a configured range, emits BURST + SCORE_CHANGED). Renders nothing.\"\norbital ArcadePlayOrbital {\n  type Machine = {\n    id : string!\n    x : number!\n    y : number!\n    type : string!\n  }\n  type Fx = {\n    id : string!\n    type : string!\n    x : number!\n    z : number\n    y : number\n    message : string\n    ttl : number!\n  }\n\n  entity ArcadePlayData [runtime, shared] {\n    id : string!\n    tokens : number = 0\n    tickets : number = 0\n    machines : [Machine] = []\n    lastRoll : number = 0\n    playCount : number = 0\n  }\n\n  trait ArcadePlay -> @rebindable ArcadePlayData [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.tokens @config.startTokens)\n        (set @entity.tickets 0)\n        (set @entity.machines @config.machines)\n        (set @entity.lastRoll 0)\n        (set @entity.playCount 0)\n\n      PLAY_MACHINE -> active when (and @config.running (and (> @entity.tokens 0) (> (array/len (array/filter @entity.machines (fn m (== @m.id @payload.machineId)))) 0)))\n        (let ((roll (math/random)))\n        (let ((payout (+ @config.minPayout (math/floor (* @roll (+ 1 (- @config.maxPayout @config.minPayout)))))))\n        (do\n          (set @entity.tokens (- @entity.tokens 1))\n          (set @entity.playCount (+ @entity.playCount 1))\n          (set @entity.lastRoll @roll)\n          (set @entity.tickets (+ @entity.tickets @payout))\n          (emit BURST { particles: (array/map (array/filter @entity.machines (fn m (== @m.id @payload.machineId))) (fn m { id: (str/concat \"fx-play-\" @entity.playCount), type: (if (> @payout 0) \"score\" \"info\"), x: @payload.x, z: @payload.z, message: (if (> @payout 0) (str/concat \"+\" @payout \" ticket(s)\") \"no luck\"), ttl: 3 })) })\n          (emit SCORE_CHANGED { tickets: @entity.tickets, tokens: @entity.tokens })\n        )))\n\n      RESTART -> active\n        (set @entity.tokens @config.startTokens)\n        (set @entity.tickets 0)\n        (set @entity.machines @config.machines)\n        (set @entity.lastRoll 0)\n        (set @entity.playCount 0)\n    }\n\n    emits {\n      BURST -> external {\n        particles : [Fx]\n      }\n        @description \"Payout (or dud) particle spawned at the played machine's tile; a fx-particles listener spawns it\"\n        @tier \"domain\"\n      SCORE_CHANGED -> external {\n        tickets : number!\n        tokens : number!\n      }\n        @description \"Tickets + tokens after this play; a flow listener decides win/lose\"\n        @tier \"domain\"\n    }\n\n    listens {\n      PLAY_MACHINE { machineId : string, x : number, z : number }\n      RESTART { id : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, PLAY_MACHINE intents are applied; toggle to freeze the economy\"\n        @tier \"domain\"\n      machines : [Machine] = []\n        @label \"Machines\"\n        @description \"Playable machine ids the PLAY_MACHINE intent is validated against\"\n        @tier \"domain\"\n      startTokens : number = 14\n        @label \"Start Tokens\"\n        @description \"Tokens the player starts with\"\n        @tier \"domain\"\n      minPayout : number = 0\n        @label \"Min Payout\"\n        @description \"Lowest ticket payout a single play can award\"\n        @tier \"domain\"\n      maxPayout : number = 1\n        @label \"Max Payout\"\n        @description \"Highest ticket payout a single play can award\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/arcade-play\" as ArcadePlayPage -> ArcadePlay\n}\n"
}