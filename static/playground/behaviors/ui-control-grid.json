  "source": "",
  "lolo": "app ui-control-grid \"1.0.0\"\n\"ControlGrid — UI factory (1:1 with the @almadar/ui control-grid pattern).\"\n;; @pattern \"control-grid\"\norbital ControlGridOrbital {\n  type ControlGridButtonsItem = {\n    id : string!\n    label : string\n    icon : icon\n    assetUrl : ControlGridButtonsItemAssetUrl\n    variant : string\n  }\n  type ControlGridButtonsItemAssetUrl = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\" | \"4:1\" | \"5:3\" | \"1:2\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n  type ControlGridDirectionAssetsValue = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\" | \"4:1\" | \"5:3\" | \"1:2\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n\n  entity ControlGridItem [runtime] {\n    id : string!\n  }\n\n  trait ControlGridRender -> @rebindable ControlGridItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          kind: @config.kind\n          buttons: @config.buttons\n          layout: @config.layout\n          includeDiagonals: @config.includeDiagonals\n          onAction: @config.onAction\n          actionEvent: @config.actionEvent\n          onDirection: @config.onDirection\n          directionEvent: @config.directionEvent\n          directionEvents: @config.directionEvents\n          directionReleaseEvents: @config.directionReleaseEvents\n          directionAssets: @config.directionAssets\n          size: @config.size\n          disabled: @config.disabled\n          visibility: @config.visibility\n          className: @config.className\n          enter: @config.enter\n          enterDelay: @config.enterDelay\n          skeleton: @config.skeleton\n          aria-label: @config.ariaLabel\n          aria-labelledby: @config.ariaLabelledby\n          aria-describedby: @config.ariaDescribedby\n          aria-live: @config.ariaLive\n          aria-current: @config.ariaCurrent\n          aria-pressed: @config.ariaPressed\n          aria-expanded: @config.ariaExpanded\n          aria-selected: @config.ariaSelected\n          aria-hidden: @config.ariaHidden\n          aria-busy: @config.ariaBusy\n          role: @config.role\n          lang: @config.lang\n          dir: @config.dir\n          tabIndex: @config.tabIndex\n          type: control-grid\n        })\n    }\n\n    emits {\n      @config.onAction -> external {\n        id : string\n        pressed : boolean\n      }\n        @description \"Called when a button/direction is pressed or released\"\n        @tier \"essential\"\n      @config.onDirection -> external {\n        direction : string\n        pressed : boolean\n      }\n        @description \"Called when a direction is pressed or released (kind='dpad' convenience overload)\"\n        @tier \"essential\"\n    }\n\n    config {\n      kind : \"dpad\" | \"actions\" = dpad\n        @label \"Kind\"\n        @description \"kind prop\"\n        @tier \"presentation\"\n      buttons : [ControlGridButtonsItem] = []\n        @label \"Buttons\"\n        @description \"action buttons (kind='actions')\"\n        @tier \"presentation\"\n      layout : \"horizontal\" | \"vertical\" | \"diamond\" = horizontal\n        @label \"Layout\"\n        @description \"Layout for kind='actions'\"\n        @tier \"presentation\"\n      includeDiagonals : boolean = false\n        @label \"Include Diagonals\"\n        @description \"Whether to include diagonal buttons (kind='dpad')\"\n        @tier \"presentation\"\n      onAction : event = \"ACTION\"\n        @label \"On Action\"\n        @description \"Called when a button/direction is pressed or released\"\n        @tier \"presentation\"\n      actionEvent : event = \"ACTION\"\n        @label \"Action Event\"\n        @description \"Event-bus event emitted with `{ id, pressed }` on press/release\"\n        @tier \"presentation\"\n      onDirection : event = \"DIRECTION\"\n        @label \"On Direction\"\n        @description \"Called when a direction is pressed or released (kind='dpad' convenience overload)\"\n        @tier \"presentation\"\n      directionEvent : event = \"DIRECTION\"\n        @label \"Direction Event\"\n        @description \"Event-bus event emitted with `{ direction, pressed }` (kind='dpad')\"\n        @tier \"presentation\"\n      directionEvents : Map string string = { item: \"INIT\" }\n        @label \"Direction Events\"\n        @description \"Per-direction PRESS → the board's SEMANTIC event (kind='dpad'), e.g. `{ left: 'LEFT', right: 'RIGHT', up: 'JUMP' }`. Lets the d-pad emit the SAME intent events as the keyboard so the FSM stays device-agnostic.\"\n        @tier \"presentation\"\n      directionReleaseEvents : Map string string = { item: \"INIT\" }\n        @label \"Direction Release Events\"\n        @description \"Per-direction RELEASE → semantic event, e.g. `{ left: 'STOP', right: 'STOP' }`. Omit a direction to ignore its release.\"\n        @tier \"presentation\"\n      directionAssets : Map string ControlGridDirectionAssetsValue = { item: { url: \"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/features/sword.png\", role: \"item\", category: \"item\", animations: [\"static\"], style: \"pixel\", dimension: \"2d\", aspect: \"1:1\", name: \"item\", thumbnailUrl: \"\" } }\n        @label \"Direction Assets\"\n        @description \"Per-direction sprite assets for kind='dpad' buttons (e.g. Kenny arrow PNGs). Falls back to arrow emoji.\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"size prop\"\n        @tier \"presentation\"\n      disabled : boolean\n        @label \"Disabled\"\n        @description \"disabled prop\"\n        @tier \"presentation\"\n      visibility : \"auto\" | \"always\" = auto\n        @label \"Visibility\"\n        @description \"'auto' (default) renders only on coarse-pointer (touch) devices; 'always' renders everywhere.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      enter : \"none\" | \"fade\" | \"rise\" | \"scale\" | \"slide\"\n        @label \"Enter\"\n        @description \"How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out.\"\n        @tier \"presentation\"\n      enterDelay : number\n        @label \"Enter Delay\"\n        @description \"Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating.\"\n        @tier \"presentation\"\n      skeleton : \"header\" | \"table\" | \"list\" | \"grid\" | \"detail\" | \"stats\" | \"form\" | \"card\" | \"text\" | \"none\"\n        @label \"Skeleton\"\n        @description \"Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`.\"\n        @tier \"presentation\"\n      ariaLabel : string\n        @label \"Aria-label\"\n        @description \"Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control).\"\n        @synonyms \"aria-label\"\n        @tier \"presentation\"\n      ariaLabelledby : string\n        @label \"Aria-labelledby\"\n        @description \"Id of the element whose text names this one.\"\n        @synonyms \"aria-labelledby\"\n        @tier \"presentation\"\n      ariaDescribedby : string\n        @label \"Aria-describedby\"\n        @description \"Id of the element whose text describes this one (help text, error).\"\n        @synonyms \"aria-describedby\"\n        @tier \"presentation\"\n      ariaLive : \"off\" | \"polite\" | \"assertive\"\n        @label \"Aria-live\"\n        @description \"Announce changes to this region: polite waits for a pause, assertive interrupts.\"\n        @synonyms \"aria-live\"\n        @tier \"presentation\"\n      ariaCurrent : \"page\" | \"step\" | \"location\" | \"date\" | \"time\" | \"true\" | \"false\"\n        @label \"Aria-current\"\n        @description \"Marks the current item in a set: the current page, step, location, date or time.\"\n        @synonyms \"aria-current\"\n        @tier \"presentation\"\n      ariaPressed : \"true\" | \"false\" | \"mixed\"\n        @label \"Aria-pressed\"\n        @description \"Toggle-button state.\"\n        @synonyms \"aria-pressed\"\n        @tier \"presentation\"\n      ariaExpanded : boolean\n        @label \"Aria-expanded\"\n        @description \"Whether the element it controls is expanded.\"\n        @synonyms \"aria-expanded\"\n        @tier \"presentation\"\n      ariaSelected : boolean\n        @label \"Aria-selected\"\n        @description \"Whether this item is selected (tabs, options, grid cells).\"\n        @synonyms \"aria-selected\"\n        @tier \"presentation\"\n      ariaHidden : boolean\n        @label \"Aria-hidden\"\n        @description \"Hide from assistive technology (decorative content only).\"\n        @synonyms \"aria-hidden\"\n        @tier \"presentation\"\n      ariaBusy : boolean\n        @label \"Aria-busy\"\n        @description \"This region is updating; assistive technology waits before announcing it.\"\n        @synonyms \"aria-busy\"\n        @tier \"presentation\"\n      role : \"alert\" | \"alertdialog\" | \"application\" | \"article\" | \"banner\" | \"blockquote\" | \"button\" | \"caption\" | \"cell\" | \"checkbox\" | \"code\" | \"columnheader\" | \"combobox\" | \"complementary\" | \"contentinfo\" | \"definition\" | \"deletion\" | \"dialog\" | \"document\" | \"emphasis\" | \"feed\" | \"figure\" | \"form\" | \"generic\" | \"grid\" | \"gridcell\" | \"group\" | \"heading\" | \"img\" | \"insertion\" | \"link\" | \"list\" | \"listbox\" | \"listitem\" | \"log\" | \"main\" | \"marquee\" | \"math\" | \"menu\" | \"menubar\" | \"menuitem\" | \"menuitemcheckbox\" | \"menuitemradio\" | \"meter\" | \"navigation\" | \"none\" | \"note\" | \"option\" | \"paragraph\" | \"presentation\" | \"progressbar\" | \"radio\" | \"radiogroup\" | \"region\" | \"row\" | \"rowgroup\" | \"rowheader\" | \"scrollbar\" | \"search\" | \"searchbox\" | \"separator\" | \"slider\" | \"spinbutton\" | \"status\" | \"strong\" | \"subscript\" | \"superscript\" | \"switch\" | \"tab\" | \"table\" | \"tablist\" | \"tabpanel\" | \"term\" | \"textbox\" | \"time\" | \"timer\" | \"toolbar\" | \"tooltip\" | \"tree\" | \"treegrid\" | \"treeitem\"\n        @label \"Role\"\n        @description \"WAI-ARIA role when the element's native semantics don't describe it.\"\n        @tier \"presentation\"\n      lang : string\n        @label \"Lang\"\n        @description \"Language of this element's content (BCP 47, e.g. ar, sl, en).\"\n        @tier \"presentation\"\n      dir : \"ltr\" | \"rtl\" | \"auto\"\n        @label \"Dir\"\n        @description \"Text direction of this element's content.\"\n        @tier \"presentation\"\n      tabIndex : number\n        @label \"Tab Index\"\n        @description \"0 puts the element in the Tab order; -1 makes it focusable only programmatically.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/control-grid\" as ControlGridPage -> ControlGridRender\n}\n"
}