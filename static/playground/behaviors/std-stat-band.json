  "source": "",
  "lolo": "app std-stat-band \"1.0.0\"\n\"std-stat-band — a band of headline figures from a config list: each item a big value (a number or short text such as '99.9%', '3x' or 'Open source') over a short label, centered in a row that wraps on small screens, under an optional heading. Display only — for figures computed from data use std-stats. Pick for 'by the numbers' strips on landing, about and product pages.\"\ntype StatBandItem = { value : string!, label : string! }\norbital StatBandOrbital {\n\n  entity StatBandView [runtime] {\n    id : string!\n  }\n\n  trait StatBandRender -> @rebindable StatBandView [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          type: box\n          paddingY: xl\n          bg: (if (== @config.surface muted) muted transparent)\n          fullWidth: true\n          children: [{\n            type: container\n            size: xl\n            maxWidth: xl\n            padding: lg\n            children: [{\n              type: stack\n              direction: vertical\n              gap: lg\n              children: [{\n                type: typography\n                content: @config.heading\n                variant: h3\n                weight: bold\n                align: center\n                className: (if (== @config.heading \"\") hidden \"tracking-tight\")\n              }, {\n                type: simple-grid\n                cols: (math/min (math/max (array/len @config.items) 1) 4)\n                gap: lg\n                children: (array/map @config.items (fn item {\n                  type: stack\n                  direction: vertical\n                  gap: xs\n                  align: center\n                  children: [{\n                    type: typography\n                    content: (object/get @item value \"\")\n                    variant: h2\n                    weight: bold\n                    align: center\n                    className: \"tracking-tight text-primary\"\n                  }, {\n                    type: typography\n                    content: (object/get @item label \"\")\n                    variant: body\n                    color: muted\n                    align: center\n                  }]\n                }))\n              }]\n            }]\n          }]\n        })\n    }\n\n    config {\n      heading : string = \"\"\n        @label \"Heading\"\n        @description \"Heading above the figures; empty hides it\"\n        @tier \"presentation\"\n      items : [StatBandItem] = [{ value: \"120+\", label: \"Building blocks\" }, { value: \"3\", label: \"Languages\" }, { value: \"99.9%\", label: \"Uptime\" }]\n        @label \"Figures\"\n        @description \"One entry per figure: value (number or short text) and label\"\n        @synonyms \"stats, numbers, metrics, kpis, by the numbers\"\n        @tier \"presentation\"\n      surface : \"plain\" | \"muted\" = plain\n        @label \"Surface\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/stat-band\" as StatBandPage -> StatBandRender\n}\n"
}