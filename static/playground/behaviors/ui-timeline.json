  "source": "",
  "lolo": "app ui-timeline \"1.0.0\"\n\"Timeline — UI factory (1:1 with the @almadar/ui timeline pattern).\"\norbital TimelineOrbital {\n    type TimelineLoaded = Event { data : [TimelineItem] } \"Timeline rows finished loading; payload.data holds the collection\"\n  type TimelineError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type TimelineItemsItem = {\n    id : string!\n    title : string!\n    description : string\n    date : string\n    status : \"complete\" | \"active\" | \"pending\" | \"error\"\n    icon : icon\n    tags : [string]\n  }\n  type TimelineItemActionsItem = {\n    label : string!\n    event : event\n    navigatesTo : string\n    variant : \"primary\" | \"secondary\" | \"ghost\"\n  }\n\n  entity TimelineItem [runtime] {\n    id : string!\n  }\n\n  trait TimelineRender -> @rebindable TimelineItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle when @config.selfFetch\n        (fetch TimelineItem { emit: { success: TimelineLoaded } })\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          entity: @entity\n          title: @config.title\n          items: @config.items\n          fields: @config.fields\n          itemActions: @config.itemActions\n          look: @config.look\n          type: timeline\n        })\n      INIT -> idle when (not @config.selfFetch)\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          entity: @entity\n          title: @config.title\n          items: @config.items\n          fields: @config.fields\n          itemActions: @config.itemActions\n          look: @config.look\n          type: timeline\n        })\n      TimelineLoaded -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          entity: @payload.data\n          title: @config.title\n          items: @config.items\n          fields: @config.fields\n          itemActions: @config.itemActions\n          look: @config.look\n          type: timeline\n        })\n    }\n\n    emits {\n      VIEW -> external {\n        id : string!\n        row : @entity!\n      }\n        @description \"User opened a record from the list.\"\n        @tier \"essential\"\n      TimelineLoaded\n        @description \"Timeline rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : TimelineError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      title : string\n        @label \"Title\"\n        @description \"Timeline title\"\n        @tier \"presentation\"\n      items : [TimelineItemsItem] = []\n        @label \"Items\"\n        @description \"Timeline items\"\n        @tier \"presentation\"\n      fields : [string] = [\"Item\", \"Item 2\"]\n        @label \"Fields\"\n        @description \"Fields to display\"\n        @tier \"presentation\"\n      itemActions : [TimelineItemActionsItem] = []\n        @label \"Item Actions\"\n        @description \"Actions per item\"\n        @tier \"presentation\"\n      look : \"vertical-compact\" | \"vertical-spacious\" | \"horizontal\" | \"swimlane\" = \"vertical-spacious\"\n        @label \"Look\"\n        @description \"Layer 2 visual treatment.\"\n        @tier \"presentation\"\n      selfFetch : boolean = true\n        @label \"Fetch its own rows on mount?\"\n        @description \"true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/timeline\" as TimelinePage -> TimelineRender\n}\n"
}