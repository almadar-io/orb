  "source": "",
  "lolo": "app std-marketing-split \"1.0.0\"\n\"Split section atom for marketing pages. Renders a two-column layout with text and image alternating sides. Pick for feature deep-dives and alternating content sections.\"\n;; Config-driven split section using the `split-section` marketing pattern.\n;; The atom renders immediately on INIT with no fetch required.\norbital SplitItemOrbital {\n  uses SplitSection from \"std/behaviors/ui-split-section\"\n\n  entity SplitItem [runtime] {\n    id : string!\n  }\n\n  trait SplitItemSplit = SplitSection.traits.SplitSectionRender -> SplitItem {\n    config {\n      background: @config.background\n      bullets: @config.bullets\n      description: @config.description\n      image: { alt: @config.imageAlt, src: @config.imageSrc }\n      imagePosition: @config.imagePosition\n      title: @config.title\n      title : string = \"Powerful under the hood\"\n        @label \"Title\"\n        @description \"Section headline\"\n        @tier \"presentation\"\n      description : string = \"Everything you need to build, deploy, and scale.\"\n        @label \"Description\"\n        @description \"Body text\"\n        @tier \"presentation\"\n      bullets : [string] = [\"Instant deployments\", Auto-scaling, \"Global CDN\"]\n        @label \"Bullets\"\n        @description \"Feature bullet points\"\n        @tier \"presentation\"\n      imageSrc : string = \"\"\n        @label \"Image Source\"\n        @tier \"presentation\"\n      imageAlt : string = \"\"\n        @label \"Image Alt Text\"\n        @tier \"presentation\"\n      imagePosition : string = right\n        @label \"Image Position\"\n        @description \"left or right\"\n        @tier \"presentation\"\n      background : string = default\n        @label \"Background\"\n        @description \"default or alt\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/split\" as SplitItemSplitPage -> SplitItemSplit\n}"
}