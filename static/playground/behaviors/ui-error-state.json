  "source": "",
  "lolo": "app ui-error-state \"1.0.0\"\n\"ErrorState — UI factory (1:1 with the @almadar/ui error-state pattern).\"\norbital ErrorStateOrbital {\n  entity ErrorStateItem [runtime] {\n    id : string!\n  }\n\n  trait ErrorStateRender -> @rebindable ErrorStateItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          title: @config.title\n          message: @config.message\n          description: @config.description\n          onRetry: @config.onRetry\n          className: @config.className\n          retryEvent: @config.retryEvent\n          type: error-state\n        })\n    }\n\n    emits {\n      @config.onRetry -> external { }\n        @description \"onRetry prop\"\n        @tier \"essential\"\n    }\n\n    config {\n      title : string\n        @label \"Title\"\n        @description \"title prop\"\n        @tier \"presentation\"\n      message : string\n        @label \"Message\"\n        @description \"Error message to display\"\n        @tier \"presentation\"\n      description : string\n        @label \"Description\"\n        @description \"Alias for message (schema compatibility)\"\n        @tier \"presentation\"\n      onRetry : event = \"RETRY\"\n        @label \"On Retry\"\n        @description \"onRetry prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      retryEvent : event = \"RETRY\"\n        @label \"Retry Event\"\n        @description \"Declarative retry event — emits UI:{retryEvent} via eventBus when retry button is clicked\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/error-state\" as ErrorStatePage -> ErrorStateRender\n}\n"
}