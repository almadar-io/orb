  "source": "",
  "lolo": "app ui-state-json-view \"1.0.0\"\n\"StateJsonView — UI factory (1:1 with the @almadar/ui state-json-view pattern).\"\norbital StateJsonViewOrbital {\n  type StateJsonViewTransitionsItem = {\n    from : string!\n    to : string!\n    event : string!\n  }\n\n  entity StateJsonViewItem [runtime] {\n    id : string!\n  }\n\n  trait StateJsonViewRender -> @rebindable StateJsonViewItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          name: @config.name\n          initialState: @config.initialState\n          states: @config.states\n          transitions: @config.transitions\n          label: @config.label\n          defaultExpanded: @config.defaultExpanded\n          className: @config.className\n          type: state-json-view\n        })\n    }\n\n    config {\n      name : string = \"\"\n        @label \"Name\"\n        @description \"Machine name\"\n        @tier \"presentation\"\n      initialState : string = \"\"\n        @label \"Initial State\"\n        @description \"Initial state\"\n        @tier \"presentation\"\n      states : [string] = [\"Item\", \"Item 2\"]\n        @label \"States\"\n        @description \"All state names\"\n        @tier \"presentation\"\n      transitions : [StateJsonViewTransitionsItem] = [{ from: \"From\", to: \"To\", event: \"Event\" }, { from: \"From 2\", to: \"To 2\", event: \"Event 2\" }]\n        @label \"Transitions\"\n        @description \"The player's wired transitions\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Header label\"\n        @tier \"presentation\"\n      defaultExpanded : boolean = false\n        @label \"Default Expanded\"\n        @description \"Whether the code block is expanded by default\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/state-json-view\" as StateJsonViewPage -> StateJsonViewRender\n}\n"
}