  "source": "",
  "lolo": "app std-date-range \"2.0.0\"\n\"std-date-range — compact calendar button (Looker / Tableau shape) that opens a popover containing the date-range-picker. Owns a DateRange runtime entity; DATE_RANGE_CHANGED persists @payload.from + @payload.to so cross-trait listeners can route the range into data atoms (Browse REFETCH_FILTER, Stats / Graphs requery).\"\norbital DateRangeOrbital {\n  entity DateRange [runtime] {\n    id : string!\n    from : string @description \"The start date of the date range.\" @synonyms \"start, beginning, initial\"\n    to : string @description \"The end date of a date range.\" @synonyms \"end date, finish date, end, final date\"\n  }\n\n  trait DateRangeFilter -> DateRange [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          children: [{\n            action: OPEN_DATE_RANGE\n            icon: calendar\n            label: @config.buttonLabel\n            size: sm\n            type: button\n            variant: secondary\n          }]\n          content: {\n            event: @config.event\n            fromLabel: @config.fromLabel\n            toLabel: @config.toLabel\n            type: date-range-picker\n          }\n          position: bottom\n          type: popover\n        })\n      OPEN_DATE_RANGE -> idle\n        (set @entity.from @entity.from)\n      DATE_RANGE_CHANGED -> idle\n        (set @entity.from ?from)\n        (set @entity.to ?to)\n        (render-ui main {\n          children: [{\n            action: OPEN_DATE_RANGE\n            icon: calendar\n            label: @config.buttonLabel\n            size: sm\n            type: button\n            variant: secondary\n          }]\n          content: {\n            event: @config.event\n            from: @entity.from\n            fromLabel: @config.fromLabel\n            to: @entity.to\n            toLabel: @config.toLabel\n            type: date-range-picker\n          }\n          position: bottom\n          type: popover\n        })\n    }\n\n    emits {\n      DATE_RANGE_CHANGED {\n        from : string!\n        to : string!\n      }\n        @description \"Signals a change in the selected date range.\"\n        @synonyms \"range-updated, date-selection, filter-change\"\n        @tier \"domain\"\n    }\n\n    listens {\n      DATE_RANGE_CHANGED {\n        from : string!\n        to : string!\n      }\n        @description \"A date range has been selected and updated.\"\n        @synonyms \"range-change, date-update, selection-complete\"\n        @tier \"domain\"\n    }\n\n    config {\n      event : event = DATE_RANGE_CHANGED\n        @label \"Change event\"\n        @description \"Event name emitted when the user picks a new range\"\n        @tier \"internal\"\n      fromLabel : string = From\n        @label \"Start-date label\"\n        @description \"Caption shown above the start-date input\"\n        @tier \"presentation\"\n      toLabel : string = To\n        @label \"End-date label\"\n        @description \"Caption shown above the end-date input\"\n        @tier \"presentation\"\n      buttonLabel : string = \"Date range\"\n        @label \"Trigger button\"\n        @description \"Text on the toolbar button that opens the popover\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/dateranges/filter\" as DateRangeFilterPage -> DateRangeFilter\n}"
}