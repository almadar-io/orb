  "source": "",
  "lolo": "app std-gold \"1.0.0\"\n\"Headless gold-economy mechanic: the SOLE writer of gold. Listens a mine-hit signal and adds a fixed yield; emits GOLD_CHANGED. Renders nothing.\"\norbital GoldOrbital {\n  entity GoldData [runtime, shared] {\n    id : string!\n    gold : number = 0\n  }\n\n  trait GoldMine -> @rebindable GoldData [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.gold @config.startGold)\n\n      MINE_HIT -> active when @config.running\n        (set @entity.gold (+ @entity.gold @config.yieldAmount))\n        (emit GOLD_CHANGED { gold: @entity.gold })\n\n      RESTART -> active\n        (set @entity.gold @config.startGold)\n    }\n\n    emits {\n      GOLD_CHANGED -> external {\n        gold : number!\n      }\n        @description \"Current gold total after a mine-hit; a HUD stat listens to display it\"\n        @tier \"domain\"\n    }\n\n    listens {\n      MINE_HIT { id : string }\n      RESTART { id : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, mine-hit signals add gold; toggle to freeze\"\n        @tier \"domain\"\n      startGold : number = 0\n        @label \"Start Gold\"\n        @description \"Gold set on INIT/RESTART\"\n        @tier \"domain\"\n      yieldAmount : number = 25\n        @label \"Yield Amount\"\n        @description \"Gold added per mine-hit signal\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/gold\" as GoldPage -> GoldMine\n}\n"
}