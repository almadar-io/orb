  "source": "",
  "lolo": "app ui-divider \"1.0.0\"\n\"Divider — UI factory (1:1 with the @almadar/ui divider pattern).\"\norbital DividerOrbital {\n  entity DividerItem [runtime] {\n    id : string!\n  }\n\n  trait DividerRender -> @rebindable DividerItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          orientation: @config.orientation\n          label: @config.label\n          variant: @config.variant\n          className: @config.className\n          type: divider\n        })\n    }\n\n    config {\n      orientation : \"horizontal\" | \"vertical\" = horizontal\n        @label \"Orientation\"\n        @description \"Orientation of the divider\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Text label to display in the divider\"\n        @tier \"presentation\"\n      variant : \"solid\" | \"dashed\" | \"dotted\" = solid\n        @label \"Variant\"\n        @description \"Line style variant\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/divider\" as DividerPage -> DividerRender\n}\n"
}