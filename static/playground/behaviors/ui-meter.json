  "source": "",
  "lolo": "app ui-meter \"1.0.0\"\n\"Meter — UI factory (1:1 with the @almadar/ui meter pattern).\"\norbital MeterOrbital {\n  type MeterThresholdsItem = {\n    value : number!\n    color : string!\n    label : string\n  }\n  type MeterActionsItem = {\n    label : string!\n    event : event\n    navigatesTo : string\n    variant : \"primary\" | \"secondary\" | \"ghost\"\n  }\n  type MeterError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity MeterItem [runtime] {\n    id : string!\n  }\n\n  trait MeterRender -> @rebindable MeterItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          value: @config.value\n          min: @config.min\n          max: @config.max\n          label: @config.label\n          unit: @config.unit\n          variant: @config.variant\n          thresholds: @config.thresholds\n          segments: @config.segments\n          showValue: @config.showValue\n          size: @config.size\n          actions: @config.actions\n          isLoading: @config.isLoading\n          error: @config.error\n          className: @config.className\n          type: meter\n        })\n    }\n\n    config {\n      value : number = 1\n        @label \"Value\"\n        @description \"Current value\"\n        @tier \"presentation\"\n      min : number = 0\n        @label \"Min\"\n        @description \"Minimum value\"\n        @tier \"presentation\"\n      max : number = 100\n        @label \"Max\"\n        @description \"Maximum value\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Display label\"\n        @tier \"presentation\"\n      unit : string\n        @label \"Unit\"\n        @description \"Unit suffix (e.g., '%', 'MB', 'credits')\"\n        @tier \"presentation\"\n      variant : \"linear\" | \"radial\" | \"segmented\" = linear\n        @label \"Variant\"\n        @description \"Display variant\"\n        @tier \"presentation\"\n      thresholds : [MeterThresholdsItem] = []\n        @label \"Thresholds\"\n        @description \"Color thresholds\"\n        @tier \"presentation\"\n      segments : number = 5\n        @label \"Segments\"\n        @description \"Number of segments (for segmented variant)\"\n        @tier \"presentation\"\n      showValue : boolean = true\n        @label \"Show Value\"\n        @description \"Show value text\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Size (for radial variant)\"\n        @tier \"presentation\"\n      actions : [MeterActionsItem] = []\n        @label \"Actions\"\n        @description \"Actions\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state\"\n        @tier \"presentation\"\n      error : MeterError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/meter\" as MeterPage -> MeterRender\n}\n"
}