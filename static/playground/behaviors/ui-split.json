  "source": "",
  "lolo": "app ui-split \"1.0.0\"\n\"Split — UI factory (1:1 with the @almadar/ui split pattern).\"\norbital SplitOrbital {\n  type SplitError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity SplitItem [runtime] {\n    id : string!\n  }\n\n  trait SplitRender -> @rebindable SplitItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          ratio: @config.ratio\n          gap: @config.gap\n          reverse: @config.reverse\n          stackOnMobile: @config.stackOnMobile\n          stackBreakpoint: @config.stackBreakpoint\n          align: @config.align\n          className: @config.className\n          leftClassName: @config.leftClassName\n          rightClassName: @config.rightClassName\n          children: @config.children\n          isLoading: @config.isLoading\n          error: @config.error\n          type: split\n        })\n    }\n\n    config {\n      ratio : \"1:1\" | \"1:2\" | \"2:1\" | \"1:3\" | \"3:1\" | \"1:4\" | \"4:1\" | \"2:3\" | \"3:2\" = \"1:1\"\n        @label \"Ratio\"\n        @description \"Size ratio between left and right panels\"\n        @tier \"presentation\"\n      gap : \"none\" | \"sm\" | \"md\" | \"lg\" | \"xl\" = md\n        @label \"Gap\"\n        @description \"Gap between panels\"\n        @tier \"presentation\"\n      reverse : boolean = false\n        @label \"Reverse\"\n        @description \"Reverse the order (right first)\"\n        @tier \"presentation\"\n      stackOnMobile : boolean = true\n        @label \"Stack On Mobile\"\n        @description \"Stack vertically on mobile\"\n        @tier \"presentation\"\n      stackBreakpoint : \"sm\" | \"md\" | \"lg\" | \"xl\" = md\n        @label \"Stack Breakpoint\"\n        @description \"Breakpoint to switch from stacked to side-by-side\"\n        @tier \"presentation\"\n      align : \"start\" | \"center\" | \"end\" | \"stretch\" = stretch\n        @label \"Align\"\n        @description \"Align items vertically\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Custom class name\"\n        @tier \"presentation\"\n      leftClassName : string\n        @label \"Left Class Name\"\n        @description \"Left/first panel class name\"\n        @tier \"presentation\"\n      rightClassName : string\n        @label \"Right Class Name\"\n        @description \"Right/second panel class name\"\n        @tier \"presentation\"\n      children : node = []\n        @label \"Children\"\n        @description \"Exactly two children: [left, right]\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : SplitError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/split\" as SplitPage -> SplitRender\n}\n"
}