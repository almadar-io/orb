  "source": "",
  "lolo": "app ui-chart-legend \"1.0.0\"\n\"ChartLegend — UI factory (1:1 with the @almadar/ui chart-legend pattern).\"\norbital ChartLegendOrbital {\n  type ChartLegendItemsItem = {\n    label : string!\n    color : string!\n  }\n\n  entity ChartLegendItem [runtime] {\n    id : string!\n  }\n\n  trait ChartLegendRender -> @rebindable ChartLegendItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          items: @config.items\n          className: @config.className\n          direction: @config.direction\n          type: chart-legend\n        })\n    }\n\n    config {\n      items : [ChartLegendItemsItem] = [{ label: \"Label\", color: \"Color\" }, { label: \"Label 2\", color: \"Color 2\" }]\n        @label \"Items\"\n        @description \"Legend items with label and color\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      direction : \"horizontal\" | \"vertical\" = horizontal\n        @label \"Direction\"\n        @description \"Layout direction\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/chart-legend\" as ChartLegendPage -> ChartLegendRender\n}\n"
}