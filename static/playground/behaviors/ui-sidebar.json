  "source": "",
  "lolo": "app ui-sidebar \"1.0.0\"\n\"Sidebar — UI factory (1:1 with the @almadar/ui sidebar pattern).\"\n;; @pattern \"sidebar\"\norbital SidebarOrbital {\n  type SidebarError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type SidebarItemsItem = {\n    id : string!\n    label : string!\n    icon : icon\n    badge : string\n    href : string\n    active : boolean\n    isActive : boolean\n    subItems : [SidebarItemsItem]\n  }\n\n  entity SidebarItem [runtime] {\n    id : string!\n    collapsed : boolean @intrinsic\n  }\n\n  trait SidebarRender -> @rebindable SidebarItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.collapsed @config.collapsed)\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          logo: @config.logo\n          logoSrc: @config.logoSrc\n          brandName: @config.brandName\n          items: @config.items\n          userSection: @config.userSection\n          footerContent: @config.footerContent\n          collapsed: @entity.collapsed\n          defaultCollapsed: @config.defaultCollapsed\n          collapseChangeEvent: @config.collapseChangeEvent\n          hideCollapseButton: @config.hideCollapseButton\n          showCloseButton: @config.showCloseButton\n          closeEvent: @config.closeEvent\n          logoClickEvent: @config.logoClickEvent\n          enter: @config.enter\n          enterDelay: @config.enterDelay\n          aria-label: @config.ariaLabel\n          aria-labelledby: @config.ariaLabelledby\n          aria-describedby: @config.ariaDescribedby\n          aria-live: @config.ariaLive\n          aria-current: @config.ariaCurrent\n          aria-pressed: @config.ariaPressed\n          aria-expanded: @config.ariaExpanded\n          aria-selected: @config.ariaSelected\n          aria-hidden: @config.ariaHidden\n          aria-busy: @config.ariaBusy\n          role: @config.role\n          lang: @config.lang\n          dir: @config.dir\n          tabIndex: @config.tabIndex\n          type: sidebar\n        })\n      COLLAPSE_CHANGE -> idle\n        (set @entity.collapsed ?collapsed)\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          logo: @config.logo\n          logoSrc: @config.logoSrc\n          brandName: @config.brandName\n          items: @config.items\n          userSection: @config.userSection\n          footerContent: @config.footerContent\n          collapsed: @entity.collapsed\n          defaultCollapsed: @config.defaultCollapsed\n          collapseChangeEvent: @config.collapseChangeEvent\n          hideCollapseButton: @config.hideCollapseButton\n          showCloseButton: @config.showCloseButton\n          closeEvent: @config.closeEvent\n          logoClickEvent: @config.logoClickEvent\n          enter: @config.enter\n          enterDelay: @config.enterDelay\n          aria-label: @config.ariaLabel\n          aria-labelledby: @config.ariaLabelledby\n          aria-describedby: @config.ariaDescribedby\n          aria-live: @config.ariaLive\n          aria-current: @config.ariaCurrent\n          aria-pressed: @config.ariaPressed\n          aria-expanded: @config.ariaExpanded\n          aria-selected: @config.ariaSelected\n          aria-hidden: @config.ariaHidden\n          aria-busy: @config.ariaBusy\n          role: @config.role\n          lang: @config.lang\n          dir: @config.dir\n          tabIndex: @config.tabIndex\n          type: sidebar\n        })\n    }\n\n    emits {\n      @config.collapseChangeEvent -> external {\n        collapsed : boolean!\n      }\n        @description \"Event emitted when collapse state changes, payload: { collapsed: boolean }\"\n        @tier \"essential\"\n      @config.closeEvent -> external { }\n        @description \"Event emitted when close button is clicked\"\n        @tier \"essential\"\n      @config.logoClickEvent -> external { }\n        @description \"Event emitted when logo/brand is clicked\"\n        @tier \"essential\"\n    }\n\n    listens {\n      COLLAPSE_CHANGE {\n        collapsed : boolean!\n      }\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : SidebarError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      logo : node\n        @label \"Logo\"\n        @description \"Logo/Brand content - can be a ReactNode or logo config\"\n        @tier \"presentation\"\n      logoSrc : asset = \"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png\"\n        @label \"Logo Src\"\n        @description \"Logo image source\"\n        @tier \"presentation\"\n      brandName : string = KFlow\n        @label \"Brand Name\"\n        @description \"Brand/App name\"\n        @tier \"presentation\"\n      items : [SidebarItemsItem] = [{ id: \"Id\", label: \"Label\", icon: \"circle\", badge: \"Badge\", href: \"Href\", active: false, isActive: false, subItems: [] }, { id: \"Id 2\", label: \"Label 2\", icon: \"circle\", badge: \"Badge 2\", href: \"Href 2\", active: true, isActive: true, subItems: [] }]\n        @label \"Items\"\n        @description \"Navigation items\"\n        @tier \"presentation\"\n      userSection : node\n        @label \"User Section\"\n        @description \"User section content\"\n        @tier \"presentation\"\n      footerContent : node\n        @label \"Footer Content\"\n        @description \"Footer content (e.g., theme toggle)\"\n        @tier \"presentation\"\n      collapsed : boolean\n        @label \"Collapsed\"\n        @description \"Collapsed state (controlled)\"\n        @tier \"presentation\"\n      defaultCollapsed : boolean = false\n        @label \"Default Collapsed\"\n        @description \"Default collapsed state\"\n        @tier \"presentation\"\n      collapseChangeEvent : event = \"COLLAPSE_CHANGE\"\n        @label \"Collapse Change Event\"\n        @description \"Event emitted when collapse state changes, payload: { collapsed: boolean }\"\n        @tier \"presentation\"\n      hideCollapseButton : boolean = false\n        @label \"Hide Collapse Button\"\n        @description \"Hide the collapse/expand button\"\n        @tier \"presentation\"\n      showCloseButton : boolean = false\n        @label \"Show Close Button\"\n        @description \"Show a close button (for mobile)\"\n        @tier \"presentation\"\n      closeEvent : event = \"CLOSE\"\n        @label \"Close Event\"\n        @description \"Event emitted when close button is clicked\"\n        @tier \"presentation\"\n      logoClickEvent : event = \"LOGO_CLICK\"\n        @label \"Logo Click Event\"\n        @description \"Event emitted when logo/brand is clicked\"\n        @tier \"presentation\"\n      enter : \"none\" | \"fade\" | \"rise\" | \"scale\" | \"slide\"\n        @label \"Enter\"\n        @description \"How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out.\"\n        @tier \"presentation\"\n      enterDelay : number\n        @label \"Enter Delay\"\n        @description \"Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating.\"\n        @tier \"presentation\"\n      ariaLabel : string\n        @label \"Aria-label\"\n        @description \"Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control).\"\n        @synonyms \"aria-label\"\n        @tier \"presentation\"\n      ariaLabelledby : string\n        @label \"Aria-labelledby\"\n        @description \"Id of the element whose text names this one.\"\n        @synonyms \"aria-labelledby\"\n        @tier \"presentation\"\n      ariaDescribedby : string\n        @label \"Aria-describedby\"\n        @description \"Id of the element whose text describes this one (help text, error).\"\n        @synonyms \"aria-describedby\"\n        @tier \"presentation\"\n      ariaLive : \"off\" | \"polite\" | \"assertive\"\n        @label \"Aria-live\"\n        @description \"Announce changes to this region: polite waits for a pause, assertive interrupts.\"\n        @synonyms \"aria-live\"\n        @tier \"presentation\"\n      ariaCurrent : \"page\" | \"step\" | \"location\" | \"date\" | \"time\" | \"true\" | \"false\"\n        @label \"Aria-current\"\n        @description \"Marks the current item in a set: the current page, step, location, date or time.\"\n        @synonyms \"aria-current\"\n        @tier \"presentation\"\n      ariaPressed : \"true\" | \"false\" | \"mixed\"\n        @label \"Aria-pressed\"\n        @description \"Toggle-button state.\"\n        @synonyms \"aria-pressed\"\n        @tier \"presentation\"\n      ariaExpanded : boolean\n        @label \"Aria-expanded\"\n        @description \"Whether the element it controls is expanded.\"\n        @synonyms \"aria-expanded\"\n        @tier \"presentation\"\n      ariaSelected : boolean\n        @label \"Aria-selected\"\n        @description \"Whether this item is selected (tabs, options, grid cells).\"\n        @synonyms \"aria-selected\"\n        @tier \"presentation\"\n      ariaHidden : boolean\n        @label \"Aria-hidden\"\n        @description \"Hide from assistive technology (decorative content only).\"\n        @synonyms \"aria-hidden\"\n        @tier \"presentation\"\n      ariaBusy : boolean\n        @label \"Aria-busy\"\n        @description \"This region is updating; assistive technology waits before announcing it.\"\n        @synonyms \"aria-busy\"\n        @tier \"presentation\"\n      role : \"alert\" | \"alertdialog\" | \"application\" | \"article\" | \"banner\" | \"blockquote\" | \"button\" | \"caption\" | \"cell\" | \"checkbox\" | \"code\" | \"columnheader\" | \"combobox\" | \"complementary\" | \"contentinfo\" | \"definition\" | \"deletion\" | \"dialog\" | \"document\" | \"emphasis\" | \"feed\" | \"figure\" | \"form\" | \"generic\" | \"grid\" | \"gridcell\" | \"group\" | \"heading\" | \"img\" | \"insertion\" | \"link\" | \"list\" | \"listbox\" | \"listitem\" | \"log\" | \"main\" | \"marquee\" | \"math\" | \"menu\" | \"menubar\" | \"menuitem\" | \"menuitemcheckbox\" | \"menuitemradio\" | \"meter\" | \"navigation\" | \"none\" | \"note\" | \"option\" | \"paragraph\" | \"presentation\" | \"progressbar\" | \"radio\" | \"radiogroup\" | \"region\" | \"row\" | \"rowgroup\" | \"rowheader\" | \"scrollbar\" | \"search\" | \"searchbox\" | \"separator\" | \"slider\" | \"spinbutton\" | \"status\" | \"strong\" | \"subscript\" | \"superscript\" | \"switch\" | \"tab\" | \"table\" | \"tablist\" | \"tabpanel\" | \"term\" | \"textbox\" | \"time\" | \"timer\" | \"toolbar\" | \"tooltip\" | \"tree\" | \"treegrid\" | \"treeitem\"\n        @label \"Role\"\n        @description \"WAI-ARIA role when the element's native semantics don't describe it.\"\n        @tier \"presentation\"\n      lang : string\n        @label \"Lang\"\n        @description \"Language of this element's content (BCP 47, e.g. ar, sl, en).\"\n        @tier \"presentation\"\n      dir : \"ltr\" | \"rtl\" | \"auto\"\n        @label \"Dir\"\n        @description \"Text direction of this element's content.\"\n        @tier \"presentation\"\n      tabIndex : number\n        @label \"Tab Index\"\n        @description \"0 puts the element in the Tab order; -1 makes it focusable only programmatically.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/sidebar\" as SidebarPage -> SidebarRender\n}\n"
}