  "source": "",
  "lolo": "app ui-sidebar \"1.0.0\"\n\"Sidebar — UI factory (1:1 with the @almadar/ui sidebar pattern).\"\norbital SidebarOrbital {\n  type SidebarError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type SidebarItemsItem = {\n    id : string!\n    label : string!\n    icon : icon\n    badge : string\n    href : string\n    active : boolean\n    isActive : boolean\n    subItems : [SidebarItemsItem]\n  }\n\n  entity SidebarItem [runtime] {\n    id : string!\n    collapsed : boolean @intrinsic\n  }\n\n  trait SidebarRender -> @rebindable SidebarItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.collapsed @config.collapsed)\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          logo: @config.logo\n          logoSrc: @config.logoSrc\n          brandName: @config.brandName\n          items: @config.items\n          userSection: @config.userSection\n          footerContent: @config.footerContent\n          collapsed: @entity.collapsed\n          defaultCollapsed: @config.defaultCollapsed\n          collapseChangeEvent: @config.collapseChangeEvent\n          hideCollapseButton: @config.hideCollapseButton\n          showCloseButton: @config.showCloseButton\n          closeEvent: @config.closeEvent\n          logoClickEvent: @config.logoClickEvent\n          type: sidebar\n        })\n      COLLAPSE_CHANGE -> idle\n        (set @entity.collapsed ?collapsed)\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          logo: @config.logo\n          logoSrc: @config.logoSrc\n          brandName: @config.brandName\n          items: @config.items\n          userSection: @config.userSection\n          footerContent: @config.footerContent\n          collapsed: @entity.collapsed\n          defaultCollapsed: @config.defaultCollapsed\n          collapseChangeEvent: @config.collapseChangeEvent\n          hideCollapseButton: @config.hideCollapseButton\n          showCloseButton: @config.showCloseButton\n          closeEvent: @config.closeEvent\n          logoClickEvent: @config.logoClickEvent\n          type: sidebar\n        })\n    }\n\n    emits {\n      @config.collapseChangeEvent -> external {\n        collapsed : boolean!\n      }\n        @description \"Event emitted when collapse state changes, payload: { collapsed: boolean }\"\n        @tier \"essential\"\n      @config.closeEvent -> external { }\n        @description \"Event emitted when close button is clicked\"\n        @tier \"essential\"\n      @config.logoClickEvent -> external { }\n        @description \"Event emitted when logo/brand is clicked\"\n        @tier \"essential\"\n    }\n\n    listens {\n      COLLAPSE_CHANGE {\n        collapsed : boolean!\n      }\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : SidebarError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      logo : node\n        @label \"Logo\"\n        @description \"Logo/Brand content - can be a ReactNode or logo config\"\n        @tier \"presentation\"\n      logoSrc : asset = \"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png\"\n        @label \"Logo Src\"\n        @description \"Logo image source\"\n        @tier \"presentation\"\n      brandName : string = KFlow\n        @label \"Brand Name\"\n        @description \"Brand/App name\"\n        @tier \"presentation\"\n      items : [SidebarItemsItem] = [{ id: \"Id\", label: \"Label\", icon: \"circle\", badge: \"Badge\", href: \"Href\", active: false, isActive: false, subItems: [] }, { id: \"Id 2\", label: \"Label 2\", icon: \"circle\", badge: \"Badge 2\", href: \"Href 2\", active: true, isActive: true, subItems: [] }]\n        @label \"Items\"\n        @description \"Navigation items\"\n        @tier \"presentation\"\n      userSection : node\n        @label \"User Section\"\n        @description \"User section content\"\n        @tier \"presentation\"\n      footerContent : node\n        @label \"Footer Content\"\n        @description \"Footer content (e.g., theme toggle)\"\n        @tier \"presentation\"\n      collapsed : boolean\n        @label \"Collapsed\"\n        @description \"Collapsed state (controlled)\"\n        @tier \"presentation\"\n      defaultCollapsed : boolean = false\n        @label \"Default Collapsed\"\n        @description \"Default collapsed state\"\n        @tier \"presentation\"\n      collapseChangeEvent : event = \"COLLAPSE_CHANGE\"\n        @label \"Collapse Change Event\"\n        @description \"Event emitted when collapse state changes, payload: { collapsed: boolean }\"\n        @tier \"presentation\"\n      hideCollapseButton : boolean = false\n        @label \"Hide Collapse Button\"\n        @description \"Hide the collapse/expand button\"\n        @tier \"presentation\"\n      showCloseButton : boolean = false\n        @label \"Show Close Button\"\n        @description \"Show a close button (for mobile)\"\n        @tier \"presentation\"\n      closeEvent : event = \"CLOSE\"\n        @label \"Close Event\"\n        @description \"Event emitted when close button is clicked\"\n        @tier \"presentation\"\n      logoClickEvent : event = \"LOGO_CLICK\"\n        @label \"Logo Click Event\"\n        @description \"Event emitted when logo/brand is clicked\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/sidebar\" as SidebarPage -> SidebarRender\n}\n"
}