  "source": "",
  "lolo": "app std-gather \"1.0.0\"\n\"Headless resource-gathering mechanic: owns features + wood + stone. Listens HERO_STEPPED and, when the hero lands on a wood/stone-type feature, increments the matching resource, removes the node, emits a BURST pickup particle, and emits RESOURCES so survival-flow can decide loss. Never writes units.\"\norbital GatherOrbital {\n  type Asset = {\n    url : asset\n    role : string\n    category : string\n    animations : [string]\n    style : string\n    variant : string\n    dimension : string\n    aspect : string\n    name : string\n    thumbnailUrl : string\n  }\n  type Feature = {\n    id : string\n    x : number!\n    y : number!\n    z : number\n    type : string!\n    assetUrl : Asset\n    color : string\n    elevation : number\n  }\n  type Fx = {\n    id : string!\n    type : string!\n    x : number!\n    z : number\n    y : number\n    message : string\n    ttl : number!\n  }\n\n  entity GatherData [runtime, shared] {\n    id : string!\n    features : [Feature]\n    wood : number = 0\n    stone : number = 0\n  }\n\n  trait Gather -> @rebindable GatherData [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.features @config.features)\n        (set @entity.wood @config.startWood)\n        (set @entity.stone @config.startStone)\n\n      HERO_STEPPED -> active when @config.running\n        (let ((matched (array/filter @entity.features (fn f (and (== (object/get @f x) @payload.x) (and (== (object/get @f y) @payload.z) (or (== (object/get @f type) @config.woodType) (== (object/get @f type) @config.stoneType))))))))\n        (let ((woodHits (array/len (array/filter @matched (fn f (== (object/get @f type) @config.woodType))))) (stoneHits (array/len (array/filter @matched (fn f (== (object/get @f type) @config.stoneType))))))\n        (do\n          (set @entity.wood (+ @entity.wood (* @config.yieldPerNode @woodHits)))\n          (set @entity.stone (+ @entity.stone (* @config.yieldPerNode @stoneHits)))\n          (set @entity.features (array/filter @entity.features (fn f (not (and (== (object/get @f x) @payload.x) (and (== (object/get @f y) @payload.z) (or (== (object/get @f type) @config.woodType) (== (object/get @f type) @config.stoneType))))))))\n          (emit BURST { particles: (array/map @matched (fn f { id: (str/concat \"fx-gather-\" (object/get @f id)), type: \"pickup\", x: (object/get @f x), z: (object/get @f y), message: (if (== (object/get @f type) @config.woodType) \"+1 wood\" \"+1 stone\"), ttl: 3 })) })\n          (emit RESOURCES { wood: @entity.wood, stone: @entity.stone, movesLeft: @payload.movesLeft })\n        )))\n\n      RESTART -> active\n        (set @entity.features @config.features)\n        (set @entity.wood @config.startWood)\n        (set @entity.stone @config.startStone)\n    }\n\n    emits {\n      BURST -> external {\n        particles : [Fx]\n      }\n        @description \"Pickup particle produced when a resource node is gathered; a fx-particles listener spawns it\"\n        @tier \"domain\"\n      RESOURCES -> external {\n        wood : number!\n        stone : number!\n        movesLeft : number!\n      }\n        @description \"Wood/stone totals and moves remaining after this step; a survival-flow listener decides loss\"\n        @tier \"domain\"\n    }\n\n    listens {\n      HERO_STEPPED { unitId : string, x : number, z : number, movesLeft : number }\n      RESTART { id : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, hero steps onto resource nodes are gathered; toggle to freeze\"\n        @tier \"domain\"\n      features : [Feature] = []\n        @label \"Features\"\n        @description \"Board features — resource nodes (matched by woodType/stoneType) plus decorations\"\n        @tier \"domain\"\n      woodType : string = \"tree\"\n        @label \"Wood Type\"\n        @description \"Feature type counted as a wood resource node\"\n        @tier \"domain\"\n      stoneType : string = \"rock\"\n        @label \"Stone Type\"\n        @description \"Feature type counted as a stone resource node\"\n        @tier \"domain\"\n      yieldPerNode : number = 1\n        @label \"Yield Per Node\"\n        @description \"Wood or stone gained per node gathered\"\n        @tier \"domain\"\n      startWood : number = 0\n        @label \"Start Wood\"\n        @description \"Wood set on INIT\"\n        @tier \"domain\"\n      startStone : number = 0\n        @label \"Start Stone\"\n        @description \"Stone set on INIT\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/gather\" as GatherPage -> Gather\n}\n"
}