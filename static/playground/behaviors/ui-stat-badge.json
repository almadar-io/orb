  "source": "",
  "lolo": "app ui-stat-badge \"1.0.0\"\n\"StatBadge — UI factory (1:1 with the @almadar/ui stat-badge pattern).\"\norbital StatBadgeOrbital {\n  type StatBadgeAssetUrl = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\" | \"4:1\" | \"5:3\" | \"1:2\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n  type StatBadgeIconUrl = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\" | \"4:1\" | \"5:3\" | \"1:2\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n\n  entity StatBadgeItem [runtime] {\n    id : string!\n  }\n\n  trait StatBadgeRender -> @rebindable StatBadgeItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          assetUrl: @config.assetUrl\n          iconUrl: @config.iconUrl\n          label: @config.label\n          value: @config.value\n          max: @config.max\n          source: @config.source\n          field: @config.field\n          format: @config.format\n          icon: @config.icon\n          size: @config.size\n          variant: @config.variant\n          className: @config.className\n          type: stat-badge\n        })\n    }\n\n    config {\n      assetUrl : StatBadgeAssetUrl\n        @label \"Asset Url\"\n        @description \"Sprite asset — takes precedence over icon when provided\"\n        @tier \"presentation\"\n      iconUrl : StatBadgeIconUrl\n        @label \"Icon Url\"\n        @description \"Asset image (board ui/ PNG); takes precedence over the Lucide icon.\"\n        @tier \"presentation\"\n      label : string = \"\"\n        @label \"Label\"\n        @description \"Stat label\"\n        @tier \"presentation\"\n      value : scalar\n        @label \"Value\"\n        @description \"Current value (defaults to 0 if not provided)\"\n        @tier \"presentation\"\n      max : number\n        @label \"Max\"\n        @description \"Maximum value (for bar/hearts format)\"\n        @tier \"presentation\"\n      source : string\n        @label \"Source\"\n        @description \"Data source entity name (for schema config)\"\n        @tier \"presentation\"\n      field : string\n        @label \"Field\"\n        @description \"Field name in the source (for schema config)\"\n        @tier \"presentation\"\n      format : string = number\n        @label \"Format\"\n        @description \"Display format\"\n        @tier \"presentation\"\n      icon : icon\n        @label \"Icon\"\n        @description \"Icon component or emoji\"\n        @tier \"presentation\"\n      size : string = md\n        @label \"Size\"\n        @description \"Size variant\"\n        @tier \"presentation\"\n      variant : string = default\n        @label \"Variant\"\n        @description \"Visual variant\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/stat-badge\" as StatBadgePage -> StatBadgeRender\n}\n"
}