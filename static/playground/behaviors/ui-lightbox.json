  "source": "",
  "lolo": "app ui-lightbox \"1.0.0\"\n\"Lightbox — UI factory (1:1 with the @almadar/ui lightbox pattern).\"\norbital LightboxOrbital {\n  type LightboxImagesItem = {\n    src : asset\n    alt : string\n    caption : string\n  }\n\n  entity LightboxItem [runtime] {\n    id : string!\n  }\n\n  trait LightboxRender -> @rebindable LightboxItem [interaction, instance] {\n    initial: closed\n\n    state closed {\n      INIT -> closed\n        (render-ui main {\n          label: \"Open Lightbox\"\n          action: OPEN\n          type: button\n        })\n      OPEN -> open\n        (render-ui overlay {\n          images: @config.images\n          currentIndex: @config.currentIndex\n          isOpen: @config.isOpen\n          showCounter: @config.showCounter\n          closeAction: @config.closeAction\n          onClose: @config.onClose\n          onIndexChange: @config.onIndexChange\n          className: @config.className\n          type: lightbox\n        })\n    }\n\n    state open {\n      CLOSE -> closed\n        (render-ui overlay null)\n        (render-ui main {\n          label: \"Open Lightbox\"\n          action: OPEN\n          type: button\n        })\n    }\n\n    emits {\n      @config.onClose -> external { }\n        @description \"Direct onClose callback\"\n        @tier \"essential\"\n      @config.onIndexChange -> external {\n        index : number\n      }\n        @description \"Direct onIndexChange callback\"\n        @tier \"essential\"\n      OPEN -> external {\n        id : string\n      }\n        @description \"Open the Lightbox.\"\n        @tier \"essential\"\n    }\n\n    config {\n      images : [LightboxImagesItem] = [{ src: \"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png\", alt: \"Alt\", caption: \"Caption\" }, { src: \"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png\", alt: \"Alt 2\", caption: \"Caption 2\" }]\n        @label \"Images\"\n        @description \"Array of images to display\"\n        @tier \"presentation\"\n      currentIndex : number = 0\n        @label \"Current Index\"\n        @description \"Current image index\"\n        @tier \"presentation\"\n      isOpen : boolean = false\n        @label \"Is Open\"\n        @description \"Whether the lightbox is open\"\n        @tier \"presentation\"\n      showCounter : boolean = true\n        @label \"Show Counter\"\n        @description \"Show image counter (e.g., '3 of 12')\"\n        @tier \"presentation\"\n      closeAction : string\n        @label \"Close Action\"\n        @description \"Declarative close event name\"\n        @tier \"presentation\"\n      onClose : event = \"CLOSE\"\n        @label \"On Close\"\n        @description \"Direct onClose callback\"\n        @tier \"presentation\"\n      onIndexChange : event = \"INDEX_CHANGE\"\n        @label \"On Index Change\"\n        @description \"Direct onIndexChange callback\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/lightbox\" as LightboxPage -> LightboxRender\n}\n"
}