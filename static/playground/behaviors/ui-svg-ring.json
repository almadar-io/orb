  "source": "",
  "lolo": "app ui-svg-ring \"1.0.0\"\n\"SvgRing — UI factory (1:1 with the @almadar/ui svg-ring pattern).\"\norbital SvgRingOrbital {\n  entity SvgRingItem [runtime] {\n    id : string!\n  }\n\n  trait SvgRingRender -> @rebindable SvgRingItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          cx: @config.cx\n          cy: @config.cy\n          r: @config.r\n          variant: @config.variant\n          color: @config.color\n          strokeWidth: @config.strokeWidth\n          opacity: @config.opacity\n          className: @config.className\n          label: @config.label\n          asRoot: @config.asRoot\n          width: @config.width\n          height: @config.height\n          type: svg-ring\n        })\n    }\n\n    config {\n      cx : number = 50\n        @label \"Cx\"\n        @description \"cx prop\"\n        @tier \"presentation\"\n      cy : number = 50\n        @label \"Cy\"\n        @description \"cy prop\"\n        @tier \"presentation\"\n      r : number = 40\n        @label \"R\"\n        @description \"r prop\"\n        @tier \"presentation\"\n      variant : \"solid\" | \"dashed\" | \"glow\" = solid\n        @label \"Variant\"\n        @description \"variant prop\"\n        @tier \"presentation\"\n      color : string = \"var(--color-primary)\"\n        @label \"Color\"\n        @description \"color prop\"\n        @tier \"presentation\"\n      strokeWidth : number = 1.5\n        @label \"Stroke Width\"\n        @description \"strokeWidth prop\"\n        @tier \"presentation\"\n      opacity : number = 1\n        @label \"Opacity\"\n        @description \"opacity prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"label prop\"\n        @tier \"presentation\"\n      asRoot : boolean = true\n        @label \"As Root\"\n        @description \"When true (default), wraps in a standalone <svg> so the shape is visible without a parent SVG context.\"\n        @tier \"presentation\"\n      width : number = 100\n        @label \"Width\"\n        @description \"width prop\"\n        @tier \"presentation\"\n      height : number = 100\n        @label \"Height\"\n        @description \"height prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/svg-ring\" as SvgRingPage -> SvgRingRender\n}\n"
}