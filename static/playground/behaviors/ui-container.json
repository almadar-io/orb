  "source": "",
  "lolo": "app ui-container \"1.0.0\"\n\"Container — UI factory (1:1 with the @almadar/ui container pattern).\"\norbital ContainerOrbital {\n  entity ContainerItem [runtime] {\n    id : string!\n  }\n\n  trait ContainerRender -> @rebindable ContainerItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          size: @config.size\n          maxWidth: @config.maxWidth\n          padding: @config.padding\n          center: @config.center\n          className: @config.className\n          children: @config.children\n          type: container\n        })\n    }\n\n    config {\n      size : \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" | \"full\" = xs\n        @label \"Size\"\n        @description \"Maximum width\"\n        @tier \"presentation\"\n      maxWidth : \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" | \"full\" = xs\n        @label \"Max Width\"\n        @description \"Alias for size (pattern compatibility)\"\n        @tier \"presentation\"\n      padding : \"none\" | \"sm\" | \"md\" | \"lg\" | \"xl\" = md\n        @label \"Padding\"\n        @description \"Horizontal padding\"\n        @tier \"presentation\"\n      center : boolean = true\n        @label \"Center\"\n        @description \"Center horizontally\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Custom class name\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Children elements\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/container\" as ContainerPage -> ContainerRender\n}\n"
}