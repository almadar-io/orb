  "source": "",
  "lolo": "app ui-option-constraint-group \"1.0.0\"\n\"OptionConstraintGroup — UI factory (1:1 with the @almadar/ui option-constraint-group pattern).\"\norbital OptionConstraintGroupOrbital {\n  type OptionConstraintGroupOptionsItem = {\n    id : string!\n    label : string!\n    priceDelta : number\n    disabled : boolean\n    outOfStock : boolean\n  }\n\n  entity OptionConstraintGroupItem [runtime] {\n    id : string!\n  }\n\n  trait OptionConstraintGroupRender -> @rebindable OptionConstraintGroupItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          groupId: @config.groupId\n          title: @config.title\n          description: @config.description\n          options: @config.options\n          selected: @config.selected\n          onChange: @config.onChange\n          changeEvent: @config.changeEvent\n          size: @config.size\n          className: @config.className\n          type: option-constraint-group\n        })\n    }\n\n    emits {\n      @config.onChange -> external {\n        selected : [string]\n      }\n        @description \"onChange prop\"\n        @tier \"essential\"\n    }\n\n    config {\n      groupId : string = \"\"\n        @label \"Group Id\"\n        @description \"groupId prop\"\n        @tier \"presentation\"\n      title : string = \"\"\n        @label \"Title\"\n        @description \"title prop\"\n        @tier \"presentation\"\n      description : string\n        @label \"Description\"\n        @description \"description prop\"\n        @tier \"presentation\"\n      options : [OptionConstraintGroupOptionsItem] = [{ id: \"Id\", label: \"Label\", priceDelta: 1, disabled: false, outOfStock: false }, { id: \"Id 2\", label: \"Label 2\", priceDelta: 2, disabled: true, outOfStock: true }]\n        @label \"Options\"\n        @description \"options prop\"\n        @tier \"presentation\"\n      selected : [string] = []\n        @label \"Selected\"\n        @description \"selected prop\"\n        @tier \"presentation\"\n      onChange : event = \"CHANGE\"\n        @label \"On Change\"\n        @description \"onChange prop\"\n        @tier \"presentation\"\n      changeEvent : event = \"CHANGE\"\n        @label \"Change Event\"\n        @description \"changeEvent prop\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" = md\n        @label \"Size\"\n        @description \"size prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/option-constraint-group\" as OptionConstraintGroupPage -> OptionConstraintGroupRender\n}\n"
}