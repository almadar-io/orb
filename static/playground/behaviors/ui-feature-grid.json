  "source": "",
  "lolo": "app ui-feature-grid \"1.0.0\"\n\"FeatureGrid — UI factory (1:1 with the @almadar/ui feature-grid pattern).\"\norbital FeatureGridOrbital {\n  type FeatureGridItemsItem = {\n    icon : icon\n    title : string!\n    description : string!\n    href : string\n    linkLabel : string\n    variant : \"default\" | \"bordered\" | \"elevated\" | \"interactive\"\n    size : \"sm\" | \"md\" | \"lg\"\n    className : string\n  }\n\n  entity FeatureGridItem [runtime] {\n    id : string!\n  }\n\n  trait FeatureGridRender -> @rebindable FeatureGridItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          items: @config.items\n          columns: @config.columns\n          gap: @config.gap\n          className: @config.className\n          type: feature-grid\n        })\n    }\n\n    config {\n      items : [FeatureGridItemsItem] = [{ icon: \"circle\", title: \"Title\", description: \"Description\", href: \"Href\", linkLabel: \"Link Label\", variant: default, size: sm, className: \"Class Name\" }, { icon: \"circle\", title: \"Title 2\", description: \"Description 2\", href: \"Href 2\", linkLabel: \"Link Label 2\", variant: bordered, size: md, className: \"Class Name 2\" }]\n        @label \"Items\"\n        @description \"Array of feature card configurations\"\n        @tier \"presentation\"\n      columns : number = 3\n        @label \"Columns\"\n        @description \"Number of grid columns\"\n        @tier \"presentation\"\n      gap : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Gap\"\n        @description \"Gap between grid items\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/feature-grid\" as FeatureGridPage -> FeatureGridRender\n}\n"
}