  "source": "",
  "lolo": "app ui-icon-button \"1.0.0\"\n\"IconButton — UI factory (1:1 with the @almadar/ui icon-button pattern).\"\n;; @pattern \"icon-button\"\norbital IconButtonOrbital {\n  type IconButtonIconAsset = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\" | \"4:1\" | \"5:3\" | \"1:2\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n\n  entity IconButtonItem [runtime] {\n    id : string!\n  }\n\n  trait IconButtonRender -> @rebindable IconButtonItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          variant: @config.variant\n          size: @config.size\n          isLoading: @config.isLoading\n          iconAsset: @config.iconAsset\n          action: @config.action\n          actionPayload: @config.actionPayload\n          disabled: @config.disabled\n          href: @config.href\n          icon: @config.icon\n          label: @config.label\n          tooltipPosition: @config.tooltipPosition\n          type: icon-button\n        })\n    }\n\n    emits {\n      @config.action -> external { }\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes applied to the root element.\"\n        @tier \"presentation\"\n      variant : \"primary\" | \"secondary\" | \"ghost\" | \"danger\" | \"success\" | \"warning\" | \"default\" | \"link\" = ghost\n        @label \"Variant\"\n        @description \"variant prop\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = sm\n        @label \"Size\"\n        @description \"size prop\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"isLoading prop\"\n        @tier \"presentation\"\n      iconAsset : IconButtonIconAsset\n        @label \"Icon Asset\"\n        @description \"Asset image rendered as the leading icon; takes precedence over icon/leftIcon when provided.\"\n        @tier \"presentation\"\n      action : event = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"presentation\"\n      actionPayload : @payload @config.action\n        @label \"Action Payload\"\n        @description \"Payload to include with the action event\"\n        @tier \"presentation\"\n      disabled : boolean\n        @label \"Disabled\"\n        @description \"Disable the button (greys out, blocks click events)\"\n        @tier \"presentation\"\n      href : string\n        @label \"Href\"\n        @description \"Makes the button a link: `#anchor` scrolls, an absolute URL loads, a path navigates in-app\"\n        @tier \"presentation\"\n      icon : icon = \"circle\"\n        @label \"Icon\"\n        @description \"icon prop\"\n        @tier \"presentation\"\n      label : string = \"\"\n        @label \"Label\"\n        @description \"What the button does — its accessible name and its tooltip.\"\n        @tier \"presentation\"\n      tooltipPosition : \"top\" | \"bottom\" | \"left\" | \"right\" = right\n        @label \"Tooltip Position\"\n        @description \"Where the tooltip opens.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/icon-button\" as IconButtonPage -> IconButtonRender\n}\n"
}