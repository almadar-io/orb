  "source": "",
  "lolo": "app ui-svg-connection \"1.0.0\"\n\"SvgConnection — UI factory (1:1 with the @almadar/ui svg-connection pattern).\"\norbital SvgConnectionOrbital {\n  entity SvgConnectionItem [runtime] {\n    id : string!\n  }\n\n  trait SvgConnectionRender -> @rebindable SvgConnectionItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          x1: @config.x1\n          y1: @config.y1\n          x2: @config.x2\n          y2: @config.y2\n          variant: @config.variant\n          color: @config.color\n          strokeWidth: @config.strokeWidth\n          opacity: @config.opacity\n          className: @config.className\n          asRoot: @config.asRoot\n          width: @config.width\n          height: @config.height\n          type: svg-connection\n        })\n    }\n\n    config {\n      x1 : number = 10\n        @label \"X1\"\n        @description \"x1 prop\"\n        @tier \"presentation\"\n      y1 : number = 50\n        @label \"Y1\"\n        @description \"y1 prop\"\n        @tier \"presentation\"\n      x2 : number = 90\n        @label \"X2\"\n        @description \"x2 prop\"\n        @tier \"presentation\"\n      y2 : number = 50\n        @label \"Y2\"\n        @description \"y2 prop\"\n        @tier \"presentation\"\n      variant : \"solid\" | \"dashed\" | \"animated\" = solid\n        @label \"Variant\"\n        @description \"variant prop\"\n        @tier \"presentation\"\n      color : string = \"var(--color-primary)\"\n        @label \"Color\"\n        @description \"color prop\"\n        @tier \"presentation\"\n      strokeWidth : number = 1.5\n        @label \"Stroke Width\"\n        @description \"strokeWidth prop\"\n        @tier \"presentation\"\n      opacity : number = 1\n        @label \"Opacity\"\n        @description \"opacity prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      asRoot : boolean = true\n        @label \"As Root\"\n        @description \"When true (default), wraps in a standalone <svg> so the shape is visible without a parent SVG context.\"\n        @tier \"presentation\"\n      width : number = 100\n        @label \"Width\"\n        @description \"width prop\"\n        @tier \"presentation\"\n      height : number = 100\n        @label \"Height\"\n        @description \"height prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/svg-connection\" as SvgConnectionPage -> SvgConnectionRender\n}\n"
}