  "source": "",
  "lolo": "app std-site-footer \"1.0.0\"\n\"std-site-footer — the footer at the bottom of a public site: brand name and tagline, columns of links, and a bottom row with the copyright line and legal links. Links follow `href` (in-app path, #anchor, or absolute URL) and each click emits FOOTER_LINK_CLICKED. Pick for marketing sites, docs portals and product websites.\"\ntype FooterLink = { label : string!, href : string! }\ntype FooterColumn = { title : string!, links : [FooterLink] }\norbital SiteFooterOrbital {\n\n  entity SiteFooterView [runtime] {\n    id : string!\n  }\n\n  trait SiteFooterRender -> @rebindable SiteFooterView [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          type: box\n          paddingY: xl\n          border: true\n          fullWidth: true\n          className: \"border-x-0 border-b-0\"\n          children: [{\n            type: container\n            size: xl\n            maxWidth: xl\n            padding: lg\n            children: [{\n              type: stack\n              direction: vertical\n              gap: xl\n              children: [{\n                type: split\n                ratio: \"1:2\"\n                gap: xl\n                children: [{\n                  type: stack\n                  direction: vertical\n                  gap: sm\n                  children: [{\n                  type: typography\n                  content: @config.brandName\n                  variant: h5\n                  weight: bold\n                }, {\n                  type: typography\n                  content: @config.tagline\n                  variant: body2\n                  color: muted\n                  className: (if (== @config.tagline \"\") hidden \"max-w-xs text-pretty\")\n                }]\n                }, {\n                  type: simple-grid\n                  cols: (math/min (math/max (array/len @config.columns) 1) 4)\n                  gap: lg\n                  children: (array/map @config.columns (fn column {\n                    type: stack\n                    direction: vertical\n                    gap: sm\n                    children: [{\n                      type: typography\n                      content: (object/get @column title \"\")\n                      variant: label\n                      weight: semibold\n                    }, {\n                      type: stack\n                      direction: vertical\n                      gap: xs\n                      align: start\n                      children: (array/map (object/get @column links []) (fn entry {\n                        type: button\n                        variant: link\n                        label: (object/get @entry label \"\")\n                        href: (object/get @entry href \"\")\n                        action: FOOTER_LINK\n                        actionPayload: { label: (object/get @entry label \"\"), href: (object/get @entry href \"\") }\n                      }))\n                    }]\n                  }))\n                }]\n              }, {\n                type: divider\n              }, {\n                type: stack\n                direction: horizontal\n                gap: md\n                wrap: true\n                align: center\n                justify: between\n                children: [{\n                  type: typography\n                  content: @config.copyright\n                  variant: caption\n                  color: muted\n                }, {\n                  type: stack\n                  direction: horizontal\n                  gap: md\n                  wrap: true\n                  children: (array/map @config.legalLinks (fn entry {\n                    type: button\n                    variant: link\n                    label: (object/get @entry label \"\")\n                    href: (object/get @entry href \"\")\n                    action: FOOTER_LINK\n                    actionPayload: { label: (object/get @entry label \"\"), href: (object/get @entry href \"\") }\n                  }))\n                }]\n              }]\n            }]\n          }]\n        })\n      FOOTER_LINK -> idle\n        (emit FOOTER_LINK_CLICKED { label: ?label, href: ?href })\n    }\n\n    emits {\n      FOOTER_LINK_CLICKED -> external {\n        label : string\n        href : string\n      }\n        @description \"A footer link was clicked; carries its label and href.\"\n        @tier \"domain\"\n    }\n\n    listens {\n      FOOTER_LINK {\n        label : string\n        href : string\n      }\n        @description \"Footer link click.\"\n        @tier \"internal\"\n    }\n\n    config {\n      brandName : string = \"Almadar\"\n        @label \"Brand name\"\n        @synonyms \"company, product name, logo text\"\n        @tier \"presentation\"\n      tagline : string = \"\"\n        @label \"Tagline\"\n        @description \"One line under the brand name; empty hides it\"\n        @tier \"presentation\"\n      columns : [FooterColumn] = [{ title: \"Product\", links: [{ label: \"Features\", href: \"/features\" }, { label: \"Pricing\", href: \"/pricing\" }] }, { title: \"Company\", links: [{ label: \"About\", href: \"/about\" }, { label: \"Blog\", href: \"/blog\" }] }]\n        @label \"Link columns\"\n        @description \"Each column: a title and its links (label + href)\"\n        @synonyms \"sitemap, footer menu, footer navigation\"\n        @tier \"presentation\"\n      copyright : string = \"© Almadar\"\n        @label \"Copyright line\"\n        @tier \"presentation\"\n      legalLinks : [FooterLink] = []\n        @label \"Legal links\"\n        @description \"Links in the bottom row, e.g. Privacy and Terms\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/site-footer\" as SiteFooterPage -> SiteFooterRender\n}\n"
}