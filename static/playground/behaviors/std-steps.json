  "source": "",
  "lolo": "app std-steps \"1.0.0\"\n\"std-steps — a numbered 'how it works' sequence from a config list: a numbered marker (or icon), a title and a short description per step, laid out as a row of columns or a vertical list, under an optional heading. Display only — for an interactive stepper use std-step-flow or std-wizard. Pick for onboarding explainers, process overviews and learning paths.\"\ntype StepItem = { title : string!, description : string, icon : string }\norbital StepsOrbital {\n\n  entity StepsView [runtime] {\n    id : string!\n  }\n\n  trait StepsRender -> @rebindable StepsView [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          type: box\n          paddingY: xl\n          bg: (if (== @config.surface muted) muted transparent)\n          fullWidth: true\n          children: [{\n            type: container\n            size: xl\n            maxWidth: xl\n            padding: lg\n            children: [{ type: stack, direction: vertical, gap: xl, children: [{\n              type: stack\n              direction: vertical\n              gap: sm\n              align: (if (== @config.alignment center) center start)\n              className: (if (== @config.heading \"\") (if (== @config.lede \"\") hidden \"\") \"\")\n              children: [{\n              type: typography\n              content: @config.heading\n              variant: h2\n              weight: bold\n              align: (if (== @config.alignment center) center left)\n              className: (if (== @config.heading \"\") hidden \"tracking-tight text-balance\")\n            }, {\n              type: typography\n              content: @config.lede\n              variant: large\n              color: muted\n              align: (if (== @config.alignment center) center left)\n              className: (if (== @config.lede \"\") hidden \"max-w-2xl text-pretty\")\n            }]\n            }, {\n              type: simple-grid\n              cols: (if (== @config.layout vertical) 1 (math/min (math/max (array/len @config.steps) 1) 4))\n              gap: lg\n              children: (array/map @config.steps (fn step {\n                type: stack\n                direction: (if (== @config.layout vertical) horizontal vertical)\n                gap: md\n                align: start\n                children: [{\n                  type: box\n                  rounded: full\n                  bg: primary\n                  className: \"flex h-10 w-10 shrink-0 items-center justify-center text-primary-foreground\"\n                  children: [{\n                    type: typography\n                    content: (if (== (object/get @step icon \"\") \"\") (str/concat \"\" (+ @index 1)) \"\")\n                    variant: label\n                    weight: bold\n                    color: inherit\n                    className: (if (== (object/get @step icon \"\") \"\") \"\" hidden)\n                  }, {\n                    type: icon\n                    name: (object/get @step icon \"\")\n                    size: sm\n                    className: (if (== (object/get @step icon \"\") \"\") hidden \"\")\n                  }]\n                }, {\n                  type: stack\n                  direction: vertical\n                  gap: xs\n                  children: [{\n                    type: typography\n                    content: (object/get @step title \"\")\n                    variant: h5\n                    weight: semibold\n                  }, {\n                    type: typography\n                    content: (object/get @step description \"\")\n                    variant: body\n                    color: muted\n                    className: (if (== (object/get @step description \"\") \"\") hidden \"text-pretty\")\n                  }]\n                }]\n              }))\n            }] }]\n          }]\n        })\n    }\n\n    config {\n      heading : string = \"\"\n        @label \"Heading\"\n        @description \"Section heading above the steps; empty hides it\"\n        @synonyms \"title\"\n        @tier \"presentation\"\n      lede : string = \"\"\n        @label \"Supporting text\"\n        @tier \"presentation\"\n      alignment : \"center\" | \"start\" = center\n        @label \"Heading alignment\"\n        @tier \"presentation\"\n      steps : [StepItem] = [{ title: \"Describe it\", description: \"Say what you want in plain words.\" }, { title: \"Review it\", description: \"Check the plan before anything is built.\" }, { title: \"Ship it\", description: \"Publish when it looks right.\" }]\n        @label \"Steps\"\n        @description \"One entry per step: title, optional description and icon (an icon replaces the step number)\"\n        @synonyms \"how it works, process, stages, phases, path\"\n        @tier \"presentation\"\n      layout : \"row\" | \"vertical\" = row\n        @label \"Layout\"\n        @description \"row = side-by-side columns, vertical = a top-to-bottom list\"\n        @tier \"presentation\"\n      surface : \"plain\" | \"muted\" = plain\n        @label \"Surface\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/steps\" as StepsPage -> StepsRender\n}\n"
}