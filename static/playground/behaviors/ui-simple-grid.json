  "source": "",
  "lolo": "app ui-simple-grid \"1.0.0\"\n\"SimpleGrid — UI factory (1:1 with the @almadar/ui simple-grid pattern).\"\norbital SimpleGridOrbital {\n  entity SimpleGridItem [runtime] {\n    id : string!\n  }\n\n  trait SimpleGridRender -> @rebindable SimpleGridItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          minChildWidth: @config.minChildWidth\n          maxCols: @config.maxCols\n          cols: @config.cols\n          gap: @config.gap\n          className: @config.className\n          children: @config.children\n          type: simple-grid\n        })\n    }\n\n    config {\n      minChildWidth : scalar = 250\n        @label \"Min Child Width\"\n        @description \"Minimum width of each child (e.g., 200, '200px', '15rem')\"\n        @tier \"presentation\"\n      maxCols : number\n        @label \"Max Cols\"\n        @description \"Maximum number of columns\"\n        @tier \"presentation\"\n      cols : number\n        @label \"Cols\"\n        @description \"Exact number of columns (disables auto-fit)\"\n        @tier \"presentation\"\n      gap : \"none\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\" = md\n        @label \"Gap\"\n        @description \"Gap between items\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Custom class name\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Children elements\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/simple-grid\" as SimpleGridPage -> SimpleGridRender\n}\n"
}