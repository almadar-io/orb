  "source": "",
  "lolo": "app std-loop-lock \"1.0.0\"\n\"Headless winding-lock mechanic: locks that open only after the player travels a full revolution around their anchor. Listens BODY_MOVED and, while the player stays within a radial band of a lock's ring, accumulates the wrapped angular delta of their position into swept (radians, signed — either direction counts); when |swept| reaches turns × 2π the lock flips unlocked and emits LOOP_UNLOCKED once. Entering the band reseeds the angle so leaving and returning never jumps the sweep; progress is kept across exits, so a revolution can be completed in stages. RESTART re-locks every lock. Renders nothing; boards draw the ring/chest and read swept from the shared entity (the render authority). Corresponds to the design-sheet field(s): challenge, rewards.\"\norbital LoopLockOrbital {\n  type LoopLock = {\n    id : string!\n    x : number!\n    y : number!\n    radius : number!\n    band : number!\n    turns : number!\n    swept : number\n    lastAngle : number\n    inside : boolean\n    unlocked : boolean\n    reported : boolean\n  }\n\n  entity LoopLockData [runtime, shared] {\n    id : string!\n    locks : [LoopLock] = []\n  }\n\n  trait LoopLock -> @rebindable LoopLockData [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.locks (array/map @config.locks (fn l (object/merge @l { swept: 0, lastAngle: 0, inside: false, unlocked: false, reported: false }))))\n\n      BODY_MOVED -> active when @config.running\n        (set @entity.locks (array/map @entity.locks (fn l\n          (let ((dx (- @payload.x (object/get @l x))) (dy (- @payload.y (object/get @l y))))\n          (let ((dist (math/hypot @dx @dy)) (ang (math/atan2 @dy @dx)))\n          (let ((in (<= (math/abs (- @dist (object/get @l radius))) (object/get @l band))))\n          (let ((d (if (and @in (== (object/get @l inside) true))\n                     (math/atan2 (math/sin (- @ang (object/get @l lastAngle))) (math/cos (- @ang (object/get @l lastAngle))))\n                     0)))\n          (let ((swept (+ (object/get @l swept) @d)))\n            (object/merge @l { inside: @in, lastAngle: (if @in @ang (object/get @l lastAngle)), swept: @swept, unlocked: (or (object/get @l unlocked) (>= (math/abs @swept) (* (object/get @l turns) 6.283185307179586))) })))))))))\n        (let ((newly (array/filter @entity.locks (fn l (and (== (object/get @l unlocked) true) (== (object/get @l reported) false))))))\n        (if (> (array/len @newly) 0)\n          (do\n            (set @entity.locks (array/map @entity.locks (fn l (if (== (object/get @l id) (object/get (array/first @newly) id)) (object/merge @l { reported: true }) @l))))\n            (emit LOOP_UNLOCKED { id: (object/get (array/first @newly) id), x: (object/get (array/first @newly) x), y: (object/get (array/first @newly) y) }))\n          null))\n\n      RESTART -> active\n        (set @entity.locks (array/map @config.locks (fn l (object/merge @l { swept: 0, lastAngle: 0, inside: false, unlocked: false, reported: false }))))\n    }\n\n    emits {\n      LOOP_UNLOCKED -> external {\n        id : string!\n        x : number!\n        y : number!\n      }\n        @description \"A lock's angular sweep reached turns × 2π and it flipped unlocked; boards layer treasure fx and rewards. When several locks open on one move, the first reports and the shared entity carries the rest.\"\n        @tier \"domain\"\n    }\n\n    listens {\n      BODY_MOVED { x : number!, y : number!, vx : number!, vy : number!, grounded : boolean!, skating : boolean!, speed : number! }\n      RESTART { id : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, BODY_MOVED accumulates angular sweep and unlocks locks; toggle to freeze every lock as-is.\"\n        @tier \"domain\"\n      locks : [LoopLock] = []\n        @label \"Locks\"\n        @description \"One row per winding lock: id, anchor (x, y in world units), ring radius, radial tolerance band, and revolutions required. swept/inside/unlocked are stamped at runtime.\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/loop-lock\" as LoopLockPage -> LoopLock\n}\n"
}