  "source": "",
  "lolo": "app ui-form-field \"1.0.0\"\n\"FormField — UI factory (1:1 with the @almadar/ui form-field pattern).\"\norbital FormFieldOrbital {\n  entity FormFieldItem [runtime] {\n    id : string!\n  }\n\n  trait FormFieldRender -> @rebindable FormFieldItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          label: @config.label\n          required: @config.required\n          error: @config.error\n          hint: @config.hint\n          className: @config.className\n          children: @config.children\n          type: form-field\n        })\n    }\n\n    config {\n      label : string = \"\"\n        @label \"Label\"\n        @description \"label prop\"\n        @tier \"presentation\"\n      required : boolean\n        @label \"Required\"\n        @description \"required prop\"\n        @tier \"presentation\"\n      error : string\n        @label \"Error\"\n        @description \"error prop\"\n        @tier \"presentation\"\n      hint : string\n        @label \"Hint\"\n        @description \"hint prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"children prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/form-field\" as FormFieldPage -> FormFieldRender\n}\n"
}