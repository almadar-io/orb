  "source": "",
  "lolo": "app ui-markdown-content \"1.0.0\"\n\"MarkdownContent — UI factory (1:1 with the @almadar/ui markdown-content pattern).\"\norbital MarkdownContentOrbital {\n  entity MarkdownContentItem [runtime] {\n    id : string!\n  }\n\n  trait MarkdownContentRender -> @rebindable MarkdownContentItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          content: @config.content\n          direction: @config.direction\n          className: @config.className\n          type: markdown-content\n        })\n    }\n\n    config {\n      content : string = \"\"\n        @label \"Content\"\n        @description \"The markdown content to render\"\n        @tier \"presentation\"\n      direction : \"ltr\" | \"rtl\" = ltr\n        @label \"Direction\"\n        @description \"Text direction (defaults to ltr; `ltr` is first so the generated config seeds it)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/markdown-content\" as MarkdownContentPage -> MarkdownContentRender\n}\n"
