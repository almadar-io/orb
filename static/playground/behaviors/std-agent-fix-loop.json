  "source": "",
  "lolo": "app std-agent-fix-loop \"1.0.0\"\n\"Agent fix-loop molecule — validate an orbital, generate a repair prompt if errors, apply fix.\"\n\ntype ValidationError = { orbitalName: string, message: string!, code: string!, severity: string }\n\norbital AgentFixLoopOrbital {\n\n  entity FixLoop [runtime] {\n    orbitalName : string = \"\"\n    errors : [ValidationError] = []\n    fixPrompt : string = \"\"\n    status : \"idle\" | \"validating\" | \"fixing\" | \"fixed\" | \"valid\" = idle\n  }\n\n  trait FixLoopExecution -> FixLoop [lifecycle, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.orbitalName \"\")\n        (set @entity.errors [])\n        (set @entity.fixPrompt \"\")\n        (set @entity.status idle)\n      VALIDATE_ORBITAL -> generating_prompt\n        (set @entity.orbitalName ?orbitalName)\n        (validate/validate @entity.orbitalName)\n        (llm/generate @entity.orbitalName { emit: { success: PROMPT_GENERATED, failure: PROMPT_GENERATION_FAILED } })\n    }\n\n    state generating_prompt {\n      PROMPT_GENERATED -> fixed\n        (set @entity.fixPrompt ?result)\n        (set @entity.status fixed)\n        (emit FIX_APPLIED { orbitalName: @entity.orbitalName, fixPrompt: @entity.fixPrompt })\n      PROMPT_GENERATION_FAILED -> fixed\n        (set @entity.fixPrompt \"\")\n        (set @entity.status fixed)\n    }\n\n    state fixed {\n      INIT -> fixed\n        (set @entity.status fixed)\n      RESET -> idle\n\n    emits {\n      FIX_APPLIED {\n        orbitalName : string!\n        fixPrompt : string!\n      }\n      PROMPT_GENERATED {\n        result : string!\n      }\n    }\n\n    listens {\n      VALIDATE_ORBITAL {\n        orbitalName : string!\n      }\n    }\n  }\n\n  trait FixLoopListener -> FixLoop [lifecycle, instance] {\n    initial: waiting\n\n    state waiting {\n      INIT -> waiting\n        (set @entity.status idle)\n      FIX_APPLIED -> resolved\n        (set @entity.status fixed)\n    }\n\n    state resolved {\n      INIT -> resolved\n        (set @entity.status fixed)\n      RESET -> waiting\n        (set @entity.status idle)\n    }\n\n    listens {\n      FixLoopExecution.FIX_APPLIED -> FIX_APPLIED\n      RESET\n    }\n  }\n\n  page \"/agent-fix-loop\" as AgentFixLoopPage -> FixLoopExecution, FixLoopListener\n}\n"
}