  "source": "",
  "lolo": "app std-agent-session \"1.0.0\"\n\"Wraps session/read-spec + session/write-spec + session/read-history — orbital session data.\"\n\ntype OrbitalSpec = { orbitalName: string, organism: string!, method: string!, deltaPrompt: string! }\ntype HistoryEntry = { role: string!, content: string!, timestamp: number }\n\norbital AgentSessionOrbital {\n\n  entity AgentSession [runtime] {\n    orbitalName : string = \"\"\n    spec : OrbitalSpec = {}\n    history : [HistoryEntry] = []\n    status : \"idle\" | \"read\" | \"written\" = idle\n  }\n\n  trait SessionReader -> AgentSession [lifecycle, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.orbitalName \"\")\n        (set @entity.spec {})\n        (set @entity.history [])\n        (set @entity.status idle)\n      READ_SPEC -> reading\n        (set @entity.orbitalName ?orbitalName)\n        (session/read-spec @entity.orbitalName { emit: { success: SPEC_LOADED, failure: SPEC_LOAD_FAILED } })\n    }\n\n    state reading {\n      SPEC_LOADED -> loadingHistory\n        (set @entity.spec ?result)\n        (session/read-history @entity.orbitalName { emit: { success: HISTORY_LOADED, failure: HISTORY_LOAD_FAILED } })\n      SPEC_LOAD_FAILED -> idle\n        (set @entity.status idle)\n    }\n\n    state loadingHistory {\n      HISTORY_LOADED -> read\n        (set @entity.history ?result)\n        (set @entity.status read)\n        (emit SPEC_READ { spec: @entity.spec, history: @entity.history })\n      HISTORY_LOAD_FAILED -> idle\n        (set @entity.status idle)\n    }\n\n    state read {\n      INIT -> read\n        (set @entity.status read)\n      RESET -> idle\n        (set @entity.spec {})\n        (set @entity.history [])\n        (set @entity.status idle)\n    }\n\n    emits {\n      SPEC_READ {\n        spec : OrbitalSpec!\n        history : [HistoryEntry]!\n      }\n      SPEC_LOADED {\n        result : OrbitalSpec!\n      }\n      HISTORY_LOADED {\n        result : [HistoryEntry]!\n      }\n    }\n\n    listens {\n      READ_SPEC {\n        orbitalName : string!\n      }\n    }\n  }\n\n  trait SessionWriter -> AgentSession [lifecycle, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.orbitalName \"\")\n        (set @entity.spec {})\n        (set @entity.status idle)\n      WRITE_SPEC -> written\n        (set @entity.orbitalName ?orbitalName)\n        (set @entity.spec ?spec)\n        (session/write-spec @entity.orbitalName @entity.spec)\n        (set @entity.status written)\n        (emit SPEC_WRITTEN { orbitalName: @entity.orbitalName })\n    }\n\n    state written {\n      INIT -> written\n        (set @entity.status written)\n      RESET -> idle\n        (set @entity.spec {})\n        (set @entity.status idle)\n    }\n\n    emits {\n      SPEC_WRITTEN {\n        orbitalName : string!\n      }\n    }\n\n    listens {\n      WRITE_SPEC {\n        orbitalName : string!\n        spec : OrbitalSpec!\n      }\n    }\n  }\n\n  trait SessionListener -> AgentSession [lifecycle, instance] {\n    initial: waiting\n\n    state waiting {\n      INIT -> waiting\n        (set @entity.status idle)\n      SPEC_READ -> active\n        (set @entity.status read)\n      SPEC_WRITTEN -> active\n        (set @entity.status written)\n      RESET -> waiting\n        (set @entity.status idle)\n    }\n\n    state active {\n      INIT -> active\n        (set @entity.status idle)\n      RESET -> waiting\n        (set @entity.status idle)\n    }\n\n    listens {\n      SessionReader.SPEC_READ -> SPEC_READ\n      SessionWriter.SPEC_WRITTEN -> SPEC_WRITTEN\n      RESET\n    }\n  }\n\n  page \"/agent-session\" as AgentSessionPage -> SessionReader, SessionWriter, SessionListener\n}\n"
}