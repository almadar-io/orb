  "source": "",
  "lolo": "app ui-pull-quote \"1.0.0\"\n\"PullQuote — UI factory (1:1 with the @almadar/ui pull-quote pattern).\"\norbital PullQuoteOrbital {\n  entity PullQuoteItem [runtime] {\n    id : string!\n  }\n\n  trait PullQuoteRender -> @rebindable PullQuoteItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          children: @config.children\n          className: @config.className\n          type: pull-quote\n        })\n    }\n\n    config {\n      children : string = \"\"\n        @label \"Children\"\n        @description \"The quote text\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/pull-quote\" as PullQuotePage -> PullQuoteRender\n}\n"
