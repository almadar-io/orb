  "source": "",
  "lolo": "app std-stat-rows \"1.0.0\"\n\"std-stat-rows — a vertical stack of stat-badge rows rendered from a config-driven list. Exemplar for dynamic collection rendering over an arbitrary container: `(array/map @entity.rows (fn item …))` sits directly in a `children:` position, so no `renderItem` pattern is needed; the map lambda binds each row's fields with `@item.<field>`.\"\n;; @capabilities \"render a list/stack of stat rows (label + value) from a config-driven array; array/map over children; per-item @item field binding\"\norbital StatRowsOrbital {\n  type StatRow = {\n    label : string!\n    value : string\n  }\n\n  entity StatRowsData [runtime] {\n    id : string!\n    rows : [StatRow]\n  }\n\n  trait StatRowsRender -> @rebindable StatRowsData [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.rows @config.rows)\n        (render-ui main {\n          type: stack\n          direction: vertical\n          gap: @config.gap\n          className: @config.className\n          children: [\n            (array/map @entity.rows (fn item {\n              type: stat-badge\n              label: @item.label\n              value: @item.value\n            }))\n          ]\n        })\n    }\n\n    config {\n      rows : [StatRow] = [{ label: \"Revenue\", value: \"$12.4k\" }, { label: \"Active users\", value: \"1,204\" }, { label: \"Churn\", value: \"1.8%\" }]\n        @label \"Rows\"\n        @description \"The stat rows to render; each row's label and value are bound inside the array/map lambda via @item.label / @item.value.\"\n        @synonyms \"stats, metrics, rows, items, list, entries\"\n        @tier \"presentation\"\n      gap : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Gap\"\n        @description \"Vertical spacing between rows.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes on the outer stack.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/stat-rows\" as StatRowsPage -> StatRowsRender\n}\n"
}