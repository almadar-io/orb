  "lolo": "app ui-form-section-header \"1.0.0\"\n\"FormSectionHeader — UI factory (1:1 with the @almadar/ui form-section-header pattern).\"\norbital FormSectionHeaderOrbital {\n  entity FormSectionHeaderItem [runtime] {\n    id : string!\n  }\n\n  trait FormSectionHeaderRender -> @rebindable FormSectionHeaderItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          title: @config.title\n          subtitle: @config.subtitle\n          isCollapsed: @config.isCollapsed\n          onToggle: @config.onToggle\n          badge: @config.badge\n          badgeVariant: @config.badgeVariant\n          icon: @config.icon\n          hasErrors: @config.hasErrors\n          isComplete: @config.isComplete\n          className: @config.className\n          type: form-section-header\n        })\n    }\n\n    emits {\n      @config.onToggle -> external { }\n        @description \"Toggle collapse handler (makes header clickable)\"\n        @tier \"essential\"\n    }\n\n    config {\n      title : string = \"\"\n        @label \"Title\"\n        @description \"Section title\"\n        @tier \"presentation\"\n      subtitle : string\n        @label \"Subtitle\"\n        @description \"Section subtitle\"\n        @tier \"presentation\"\n      isCollapsed : boolean = false\n        @label \"Is Collapsed\"\n        @description \"Whether section is collapsed\"\n        @tier \"presentation\"\n      onToggle : event = \"TOGGLE\"\n        @label \"On Toggle\"\n        @description \"Toggle collapse handler (makes header clickable)\"\n        @tier \"presentation\"\n      badge : string\n        @label \"Badge\"\n        @description \"Badge text (e.g., '3 fields', 'Required', 'Complete')\"\n        @tier \"presentation\"\n      badgeVariant : \"default\" | \"primary\" | \"success\" | \"warning\" | \"danger\" = default\n        @label \"Badge Variant\"\n        @description \"Badge variant\"\n        @tier \"presentation\"\n      icon : icon\n        @label \"Icon\"\n        @description \"Lucide icon name or component to show before title\"\n        @tier \"presentation\"\n      hasErrors : boolean = false\n        @label \"Has Errors\"\n        @description \"Whether section has validation errors\"\n        @tier \"presentation\"\n      isComplete : boolean = false\n        @label \"Is Complete\"\n        @description \"Whether section is complete\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/form-section-header\" as FormSectionHeaderPage -> FormSectionHeaderRender\n}\n"
}