  "source": "",
  "lolo": "app ui-content-section \"1.0.0\"\n\"ContentSection — UI factory (1:1 with the @almadar/ui content-section pattern).\"\norbital ContentSectionOrbital {\n  entity ContentSectionItem [runtime] {\n    id : string!\n  }\n\n  trait ContentSectionRender -> @rebindable ContentSectionItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          children: @config.children\n          background: @config.background\n          padding: @config.padding\n          className: @config.className\n          type: content-section\n        })\n    }\n\n    config {\n      children : node\n        @label \"Children\"\n        @description \"Section content\"\n        @tier \"presentation\"\n      background : \"default\" | \"alt\" | \"dark\" | \"gradient\" = default\n        @label \"Background\"\n        @description \"Background style\"\n        @tier \"presentation\"\n      padding : \"sm\" | \"md\" | \"lg\" = lg\n        @label \"Padding\"\n        @description \"Vertical padding size\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/content-section\" as ContentSectionPage -> ContentSectionRender\n}\n"
}