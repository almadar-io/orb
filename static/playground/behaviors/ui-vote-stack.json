  "source": "",
  "lolo": "app ui-vote-stack \"1.0.0\"\n\"VoteStack — UI factory (1:1 with the @almadar/ui vote-stack pattern).\"\norbital VoteStackOrbital {\n  entity VoteStackItem [runtime] {\n    id : string!\n  }\n\n  trait VoteStackRender -> @rebindable VoteStackItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          count: @config.count\n          userVote: @config.userVote\n          onVote: @config.onVote\n          voteEvent: @config.voteEvent\n          disabled: @config.disabled\n          size: @config.size\n          variant: @config.variant\n          className: @config.className\n          label: @config.label\n          type: vote-stack\n        })\n    }\n\n    emits {\n      @config.onVote -> external {\n        next : string\n      }\n        @description \"Toggle handler. Clicking the same arrow clears (emits null).\"\n        @tier \"essential\"\n    }\n\n    config {\n      count : number = 1\n        @label \"Count\"\n        @description \"Current tally\"\n        @tier \"presentation\"\n      userVote : \"up\" | \"down\" | \"none\" = up\n        @label \"User Vote\"\n        @description \"Current user's vote (null = no vote cast)\"\n        @tier \"presentation\"\n      onVote : event = \"VOTE\"\n        @label \"On Vote\"\n        @description \"Toggle handler. Clicking the same arrow clears (emits null).\"\n        @tier \"presentation\"\n      voteEvent : event = \"VOTE\"\n        @label \"Vote Event\"\n        @description \"Event name dispatched on the bus when a vote is cast. Payload: { next: VoteValue }.\"\n        @tier \"presentation\"\n      disabled : boolean = false\n        @label \"Disabled\"\n        @description \"Disabled state\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Size variant\"\n        @tier \"presentation\"\n      variant : \"vertical\" | \"horizontal\" = vertical\n        @label \"Variant\"\n        @description \"Layout orientation. `vertical` = forum/Q&A column; `horizontal` = compact row.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Accessible label for the group\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/vote-stack\" as VoteStackPage -> VoteStackRender\n}\n"
}