  "source": "",
  "lolo": "app ui-game-audio-toggle \"1.0.0\"\n\"GameAudioToggle — UI factory (1:1 with the @almadar/ui game-audio-toggle pattern).\"\norbital GameAudioToggleOrbital {\n  type GameAudioToggleError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type GameAudioToggleOnAsset = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n  type GameAudioToggleOffAsset = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n\n  entity GameAudioToggleItem [runtime] {\n    id : string!\n  }\n\n  trait GameAudioToggleRender -> @rebindable GameAudioToggleItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          size: @config.size\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          onAsset: @config.onAsset\n          offAsset: @config.offAsset\n          type: game-audio-toggle\n        })\n    }\n\n    config {\n      size : \"sm\" | \"md\" | \"lg\" = sm\n        @label \"Size\"\n        @description \"Button size\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state (passed through)\"\n        @tier \"presentation\"\n      error : GameAudioToggleError\n        @label \"Error\"\n        @description \"Error state (passed through)\"\n        @tier \"presentation\"\n      onAsset : GameAudioToggleOnAsset\n        @label \"On Asset\"\n        @description \"Asset rendered when sound is ON. Falls back to 🔊 emoji.\"\n        @tier \"presentation\"\n      offAsset : GameAudioToggleOffAsset\n        @label \"Off Asset\"\n        @description \"Asset rendered when sound is OFF (muted). Falls back to 🔇 emoji.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/game-audio-toggle\" as GameAudioTogglePage -> GameAudioToggleRender\n}\n"
}