                          "label": "a8",
                          "radius": 5,
                          "x": 8
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "points": "@entity.points",
                        "width": 600,
                        "type": "math-canvas",
                        "curves": "@entity.curves",
                        "height": 400
                      }
                    ],
                    [
                      "emit",
                      "SEQUENCE_UPDATED",
                      {
                        "curves": "@entity.curves",
                        "points": "@entity.points"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "sequenceTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "let",
                    [
                      [
                        "nphase",
                        [
                          "+",
                          "@entity.phase",
                          4
                        ]
                      ]
                    ],
                    [
                      "let",
                      [
                        [
                          "idx",
                          [
                            "math/mod",
                            [
                              "math/round",
                              [
                                "/",
                                "@nphase",
                                12
                              ]
                            ],
                            9
                          ]
                        ]
                      ],
                      [
                        "let",
                        [
                          [
                            "my",
                            [
                              "+",
                              -7,
                              [
                                "*",
                                "@idx",
                                1.7
                              ]
                            ]
                          ]
                        ],
                        [
                          "let",
                          [
                            [
                              "marker",
                              {
                                "x": "@idx",
                                "y": "@my",
                                "label": "term",
                                "radius": 8,
                                "color": "#dc2626"
                              }
                            ]
                          ],
                          [
                            "do",
                            [
                              "set",
                              "@entity.phase",
                              "@nphase"
                            ],
                            [
                              "set",
                              "@entity.points",
                              [
                                "array/append",
                                [
                                  {
                                    "y": -7,
                                    "color": "#2563eb",
                                    "label": "a0",
                                    "radius": 5,
                                    "x": 0
                                  },
                                  {
                                    "radius": 5,
                                    "color": "#2563eb",
                                    "label": "a1",
                                    "x": 1,
                                    "y": -5.3
                                  },
                                  {
                                    "color": "#2563eb",
                                    "label": "a2",
                                    "radius": 5,
                                    "x": 2,
                                    "y": -3.6
                                  },
                                  {
                                    "label": "a3",
                                    "radius": 5,
                                    "y": -1.9,
                                    "color": "#2563eb",
                                    "x": 3
                                  },
                                  {
                                    "y": -0.2,
                                    "radius": 5,
                                    "color": "#2563eb",
                                    "label": "a4",
                                    "x": 4
                                  },
                                  {
                                    "color": "#2563eb",
                                    "label": "a5",
                                    "y": 1.5,
                                    "x": 5,
                                    "radius": 5
                                  },
                                  {
                                    "radius": 5,
                                    "x": 6,
                                    "y": 3.2,
                                    "label": "a6",
                                    "color": "#2563eb"
                                  },
                                  {
                                    "label": "a7",
                                    "y": 4.9,
                                    "radius": 5,
                                    "x": 7,
                                    "color": "#2563eb"
                                  },
                                  {
                                    "y": 6.6,
                                    "color": "#2563eb",
                                    "label": "a8",
                                    "radius": 5,
                                    "x": 8
                                  }
                                ],
                                "@marker"
                              ]
                            ],
                            [
                              "render-ui",
                              "main",
                              {
                                "height": 400,
                                "width": 600,
                                "points": "@entity.points",
                                "curves": "@entity.curves",
                                "type": "math-canvas"
                              }
                            ],
