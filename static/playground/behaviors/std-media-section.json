  "source": "",
  "lolo": "app std-media-section \"1.0.0\"\n\"std-media-section — content rows that pair copy with a screenshot or illustration: each row has an eyebrow, heading, body text, a short bullet list and an optional link action on one side and its media on the other, and consecutive rows alternate sides. A row without media sits alone at reading width. Stacks on small screens. Pick for 'how it works', product tours and feature-detail pages.\"\ntype MediaRow = { eyebrow : string, heading : string!, body : string, bullets : [string], mediaSrc : string, mediaAlt : string, actionLabel : string, actionHref : string }\norbital MediaSectionOrbital {\n  entity MediaSectionView [runtime] {\n    id : string!\n  }\n\n  trait MediaSectionRender -> @rebindable MediaSectionView [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          type: box\n          paddingY: xl\n          bg: (if (== @config.surface muted) muted transparent)\n          fullWidth: true\n          children: [{\n            type: container\n            size: xl\n            maxWidth: xl\n            padding: lg\n            children: [{\n              type: stack\n              direction: vertical\n              gap: \"2xl\"\n              children: (array/map @config.rows (fn row (if (== (object/get @row mediaSrc \"\") \"\") {\n                type: box\n                className: \"mx-auto w-full max-w-3xl\"\n                children: [{\n                  type: stack\n                  direction: vertical\n                  gap: md\n                  align: start\n                  children: [{\n                    type: badge\n                    label: (object/get @row eyebrow \"\")\n                    variant: primary\n                  }, {\n                    type: typography\n                    content: (object/get @row heading \"\")\n                    variant: h2\n                    weight: bold\n                  }, {\n                    type: typography\n                    content: (object/get @row body \"\")\n                    variant: large\n                    color: muted\n                    className: (if (== (object/get @row body \"\") \"\") hidden \"\")\n                  }, {\n                    type: markdown-content\n                    content: (if (== (array/len (object/get @row bullets [])) 0) \"\" (str/concat \"- \" (str/join (object/get @row bullets []) \"\\n- \")))\n                    className: (if (== (array/len (object/get @row bullets [])) 0) hidden \"\")\n                  }, {\n                    type: button\n                    label: (object/get @row actionLabel \"\")\n                    href: (object/get @row actionHref \"\")\n                    variant: secondary\n                    action: SECTION_ACTION\n                    actionPayload: { href: (object/get @row actionHref \"\") }\n                    className: (if (== (object/get @row actionLabel \"\") \"\") hidden \"\")\n                  }]\n                }]\n              } {\n                type: split\n                ratio: \"1:1\"\n                gap: xl\n                align: center\n                reverse: (== (math/mod (+ @index (if (== @config.firstMediaSide start) 1 0)) 2) 1)\n                children: [{\n                  type: stack\n                  direction: vertical\n                  gap: md\n                  align: start\n                  children: [{\n                    type: badge\n                    label: (object/get @row eyebrow \"\")\n                    variant: primary\n                  }, {\n                    type: typography\n                    content: (object/get @row heading \"\")\n                    variant: h2\n                    weight: bold\n                  }, {\n                    type: typography\n                    content: (object/get @row body \"\")\n                    variant: large\n                    color: muted\n                    className: (if (== (object/get @row body \"\") \"\") hidden \"\")\n                  }, {\n                    type: markdown-content\n                    content: (if (== (array/len (object/get @row bullets [])) 0) \"\" (str/concat \"- \" (str/join (object/get @row bullets []) \"\\n- \")))\n                    className: (if (== (array/len (object/get @row bullets [])) 0) hidden \"\")\n                  }, {\n                    type: button\n                    label: (object/get @row actionLabel \"\")\n                    href: (object/get @row actionHref \"\")\n                    variant: secondary\n                    action: SECTION_ACTION\n                    actionPayload: { href: (object/get @row actionHref \"\") }\n                    className: (if (== (object/get @row actionLabel \"\") \"\") hidden \"\")\n                  }]\n                }, {\n                  type: image\n                  src: (object/get @row mediaSrc \"\")\n                  alt: (object/get @row mediaAlt \"\")\n                  rounded: xl\n                  bordered: true\n                }]\n              })))\n            }]\n          }]\n        })\n      SECTION_ACTION -> idle\n        (emit SECTION_ACTION_CLICKED { href: ?href })\n    }\n\n    emits {\n      SECTION_ACTION_CLICKED -> external {\n        href : string\n      }\n        @description \"A row's link action was clicked; carries its href.\"\n        @tier \"domain\"\n    }\n\n    listens {\n      SECTION_ACTION {\n        href : string\n      }\n        @description \"Row link action click.\"\n        @tier \"internal\"\n    }\n\n    config {\n      rows : [MediaRow] = [{ heading: \"Everything in one place\", body: \"Say what you want and see it take shape.\", bullets: [\"Fast\", \"Verified\", \"Yours\"] }]\n        @label \"Rows\"\n        @description \"One row per entry: eyebrow, heading, body, bullets, media (mediaSrc + mediaAlt) and an optional link action (actionLabel + actionHref)\"\n        @synonyms \"feature rows, product tour, split sections, alternating sections, how it works\"\n        @tier \"presentation\"\n      firstMediaSide : \"start\" | \"end\" = end\n        @label \"First row media side\"\n        @description \"Which side the first row's media sits on; later rows alternate\"\n        @synonyms \"image position, image left, image right, flip\"\n        @tier \"presentation\"\n      surface : \"plain\" | \"muted\" = plain\n        @label \"Surface\"\n        @description \"Background behind the rows\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/media-section\" as MediaSectionPage -> MediaSectionRender\n}\n"
}