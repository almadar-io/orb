  "source": "",
  "lolo": "app ui-checkbox \"1.0.0\"\n\"Checkbox — UI factory (1:1 with the @almadar/ui checkbox pattern).\"\norbital CheckboxOrbital {\n  entity CheckboxItem [runtime] {\n    id : string!\n  }\n\n  trait CheckboxRender -> @rebindable CheckboxItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          checked: @config.checked\n          defaultChecked: @config.defaultChecked\n          label: @config.label\n          onChange: @config.onChange\n          type: checkbox\n        })\n    }\n\n    emits {\n      @config.onChange -> external {\n        id : string\n      }\n        @description \"onChange handler or declarative event key for trait dispatch\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes applied to the root element.\"\n        @tier \"presentation\"\n      checked : boolean\n        @label \"Checked\"\n        @description \"Whether the checkbox is checked\"\n        @tier \"presentation\"\n      defaultChecked : boolean\n        @label \"Default Checked\"\n        @description \"Default checked state (uncontrolled)\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"label prop\"\n        @tier \"presentation\"\n      onChange : string = \"CHANGE\"\n        @label \"On Change\"\n        @description \"onChange handler or declarative event key for trait dispatch\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/checkbox\" as CheckboxPage -> CheckboxRender\n}\n"
}