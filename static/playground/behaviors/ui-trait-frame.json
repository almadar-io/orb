  "source": "",
  "lolo": "app ui-trait-frame \"1.0.0\"\n\"TraitFrame — UI factory (1:1 with the @almadar/ui trait-frame pattern).\"\norbital TraitFrameOrbital {\n  entity TraitFrameItem [runtime] {\n    id : string!\n  }\n\n  trait TraitFrameRender -> @rebindable TraitFrameItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          traitName: @config.traitName\n          fallback: @config.fallback\n          type: trait-frame\n        })\n    }\n\n    config {\n      traitName : string = \"\"\n        @label \"Trait Name\"\n        @description \"Name of the trait whose current frame to embed. Must match a trait declared in the current orbital. Compiler validates that the name exists at build time (see `ORB_BINDING_TRAIT_UNKNOWN`).\"\n        @tier \"presentation\"\n      fallback : node\n        @label \"Fallback\"\n        @description \"Rendered when the referenced trait has not (yet) emitted any render-ui. Use a skeleton, spinner, or message. Defaults to `null` (renders nothing), so an unfulfilled reference drops cleanly out of a parent `children:` array.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/trait-frame\" as TraitFramePage -> TraitFrameRender\n}\n"
}