                  },
                  "y": {
                    "name": "y",
                    "type": "number",
                    "required": true
                  },
                  "fy": {
                    "name": "fy",
                    "type": "number",
                    "required": false
                  },
                  "vy": {
                    "name": "vy",
                    "type": "number",
                    "required": false
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "fx": {
                    "name": "fx",
                    "type": "number",
                    "required": false
                  },
                  "id": {
                    "name": "id",
                    "type": "string",
                    "required": false
                  },
                  "vx": {
                    "name": "vx",
                    "type": "number",
                    "required": false
                  },
                  "x": {
                    "name": "x",
                    "type": "number",
                    "required": true
                  }
                }
              }
            },
            {
              "name": "running",
              "type": "boolean",
              "default": true
            }
          ]
        },
        "traits": [
          {
            "name": "MagneticSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "bodies",
                "running"
              ]
            },
            "category": "interaction",
            "linkedEntity": "MagneticState",
            "emits": [
              {
                "event": "BODIES_UPDATED",
                "description": "The current scene each tick — a composed listener (graph, readout, mirror canvas) can subscribe; a harmless no-op when the atom runs standalone.",
                "synonyms": "tick, frame, step, redraw",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "bodies",
                    "type": "[MagneticBody]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "BODIES_UPDATED",
                  "name": "Bodies Updated",
                  "description": "The current scene each tick — a composed listener (graph, readout, mirror canvas) can subscribe; a harmless no-op when the atom runs standalone.",
                  "synonyms": "tick, frame, step, redraw",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "bodies",
                      "type": "[MagneticBody]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.bodies",
                      [
                        {
                          "x": 200,
                          "fx": 0,
                          "vy": 4,
                          "y": 120,
                          "fy": 0,
                          "label": "",
                          "radius": 12,
                          "id": "q1",
                          "vx": 0,
                          "color": "#2563eb"
                        },
                        {
                          "vx": 0,
                          "fy": 0,
                          "y": 150,
                          "color": "#dc2626",
                          "fx": 0,
                          "radius": 10,
                          "label": "",
                          "vy": -3,
                          "x": 420,
                          "id": "q2"
                        },
                        {
                          "vx": 5,
                          "x": 320,
                          "y": 300,
                          "label": "",
                          "fy": 0,
                          "radius": 8,
                          "vy": 0,
                          "id": "q3",
                          "fx": 0,
                          "color": "#16a34a"
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "type": "physics-canvas",
                        "width": 600,
                        "velocityScale": 10,
                        "showVelocity": true,
                        "backgroundColor": "#f8fafc",
                        "bodies": "@entity.bodies",
                        "showForces": false,
                        "height": 400
                      }
                    ],
                    [
                      "emit",
                      "BODIES_UPDATED",
                      {
                        "bodies": "@entity.bodies"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "magneticTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "set",
                    "@entity.bodies",
                    [
                      "array/map",
                      "@entity.bodies",
                      [
                        "fn",
                        "b",
                        [
                          "let",
                          [
                            [
                              "ax",
                              [
                                "*",
                                0.03,
                                [
                                  "object/get",
                                  "@b",
                                  "vy"
                                ]
                              ]
                            ],
                            [
                              "ay",
                              [
                                "*",
                                [
                                  "*",
                                  -1,
                                  0.03
                                ],
                                [
                                  "object/get",
                                  "@b",
                                  "vx"
                                ]
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "nvx",
                                [
                                  "+",
                                  [
                                    "object/get",
                                    "@b",
                                    "vx"
                                  ],
                                  "@ax"
                                ]
                              ],
                              [
                                "nvy",
                                [
                                  "+",
                                  [
                                    "object/get",
                                    "@b",
                                    "vy"
                                  ],
                                  "@ay"
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "nx",
                                  [
                                    "+",
                                    [
                                      "object/get",
                                      "@b",
                                      "x"
                                    ],
                                    "@nvx"
                                  ]
                                ],
                                [
                                  "ny",
                                  [
                                    "+",
                                    [
                                      "object/get",
                                      "@b",
                                      "y"
                                    ],
                                    "@nvy"
                                  ]
                                ]
                              ],
                              [
                                "object/merge",
                                "@b",
                                {
                                  "y": "@ny",
                                  "vy": "@nvy",
                                  "x": "@nx",
                                  "vx": "@nvx"
                                }
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "render-ui",
                    "main",
                    {
                      "bodies": "@entity.bodies",
                      "showForces": false,
                      "type": "physics-canvas",
                      "width": 600,
                      "backgroundColor": "#f8fafc",
                      "showVelocity": true,
                      "velocityScale": 10,
                      "height": 400
                    }
                  ],
                  [
                    "emit",
                    "BODIES_UPDATED",
                    {
                      "bodies": "@entity.bodies"
                    }
                  ]
                ]
              }
            ],
            "config": {
              "bodies": {
                "type": "[MagneticBody]",
                "default": [
                  {
                    "x": 200,
                    "fx": 0,
                    "vy": 4,
                    "y": 120,
                    "fy": 0,
                    "label": "",
                    "radius": 12,
                    "id": "q1",
                    "vx": 0,
                    "color": "#2563eb"
                  },
                  {
                    "vx": 0,
