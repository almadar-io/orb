  "lolo": "app ui-subagent-trace-panel \"1.0.0\"\n\"SubagentTracePanel — UI factory (1:1 with the @almadar/ui subagent-trace-panel pattern).\"\norbital SubagentTracePanelOrbital {\n  type SubagentTracePanelError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type SubagentTracePanelSubagentsItem = {\n    id : string!\n    name : string!\n    role : string!\n    orbitalName : string\n    parentId : string\n    status : \"running\" | \"complete\" | \"error\"!\n    task : string!\n    messages : [SubagentTracePanelSubagentsItemMessagesItem]!\n    durationMs : number\n  }\n  type SubagentTracePanelSubagentsItemMessagesItem = {\n    message : string!\n    tool : string\n    timestamp : number!\n  }\n  type SubagentTracePanelCoordinatorMessagesItem = {\n    role : \"system\" | \"user\" | \"assistant\" | \"tool\"!\n    content : string!\n    toolCalls : [SubagentTracePanelCoordinatorMessagesItemToolCallsItem]\n    toolCallId : string\n    toolName : string\n    reasoningContent : string\n  }\n  type SubagentTracePanelCoordinatorMessagesItemToolCallsItem = {\n    id : string!\n    name : string!\n  }\n\n  entity SubagentTracePanelItem [runtime] {\n    id : string!\n  }\n\n  trait SubagentTracePanelRender -> @rebindable SubagentTracePanelItem [interaction, instance] {\n    initial: closed\n\n    state closed {\n      INIT -> closed\n        (render-ui main {\n          label: \"Open Subagent-trace-panel\"\n          action: OPEN\n          type: button\n        })\n      OPEN -> open\n        (render-ui overlay {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          subagents: @config.subagents\n          focusedOrbital: @config.focusedOrbital\n          disclosureLevel: @config.disclosureLevel\n          open: @config.open\n          onClose: @config.onClose\n          coordinatorMessages: @config.coordinatorMessages\n          mode: @config.mode\n          type: subagent-trace-panel\n        })\n    }\n\n    state open {\n      CLOSE -> closed\n        (render-ui overlay null)\n        (render-ui main {\n          label: \"Open Subagent-trace-panel\"\n          action: OPEN\n          type: button\n        })\n    }\n\n    emits {\n      @config.onClose -> external { }\n        @description \"Optional dismiss handler.\"\n        @tier \"essential\"\n      OPEN -> external {\n        id : string\n      }\n        @description \"Open the Subagent-trace-panel.\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : SubagentTracePanelError\n        @label \"Error\"\n        @description \"Error state (UiError)\"\n        @tier \"presentation\"\n      sortBy : string\n        @label \"Sort By\"\n        @description \"Current sort field\"\n        @tier \"presentation\"\n      sortDirection : \"asc\" | \"desc\" = asc\n        @label \"Sort Direction\"\n        @description \"Current sort direction\"\n        @tier \"presentation\"\n      searchValue : string\n        @label \"Search Value\"\n        @description \"Current search query value\"\n        @tier \"presentation\"\n      pageProp : number\n        @label \"Page\"\n        @description \"Current page number\"\n        @synonyms \"page\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Number of items per page\"\n        @tier \"presentation\"\n      totalCount : number\n        @label \"Total Count\"\n        @description \"Total number of items\"\n        @tier \"presentation\"\n      activeFilters : Map string string = {}\n        @label \"Active Filters\"\n        @description \"Active filters\"\n        @tier \"presentation\"\n      selectedIds : [string] = []\n        @label \"Selected Ids\"\n        @description \"Currently selected item IDs\"\n        @tier \"presentation\"\n      subagents : [SubagentTracePanelSubagentsItem] = [{ id: \"Id\", name: \"Name\", role: \"Role\", orbitalName: \"Orbital Name\", parentId: \"Parent Id\", status: running, task: \"Task\", messages: [{ message: \"Message\", tool: \"Tool\", timestamp: 1 }, { message: \"Message 2\", tool: \"Tool 2\", timestamp: 2 }], durationMs: 1, timeline: [] }, { id: \"Id 2\", name: \"Name 2\", role: \"Role 2\", orbitalName: \"Orbital Name 2\", parentId: \"Parent Id 2\", status: complete, task: \"Task 2\", messages: [{ message: \"Message\", tool: \"Tool\", timestamp: 1 }, { message: \"Message 2\", tool: \"Tool 2\", timestamp: 2 }], durationMs: 2, timeline: [] }]\n        @label \"Subagents\"\n        @description \"All known subagents from the runner.\"\n        @tier \"presentation\"\n      focusedOrbital : string\n        @label \"Focused Orbital\"\n        @description \"Current canvas focus orbital — only used by overlay mode. Tab mode ignores this.\"\n        @tier \"presentation\"\n      disclosureLevel : number = 1\n        @label \"Disclosure Level\"\n        @description \"Drives density: 1-2 → compact, 3-4 → full activity embed (when mode='overlay').\"\n        @tier \"presentation\"\n      open : boolean = false\n        @label \"Open\"\n        @description \"Whether the panel is visible. Typically auto-opens during generation in overlay mode.\"\n        @tier \"presentation\"\n      onClose : event = \"CLOSE\"\n        @label \"On Close\"\n        @description \"Optional dismiss handler.\"\n        @tier \"presentation\"\n      coordinatorMessages : [SubagentTracePanelCoordinatorMessagesItem] = []\n        @label \"Coordinator Messages\"\n        @description \"Canonical Coordinator conversation — same shape live and on reload. When present, takes precedence over `coordinatorActivities` for the Coordinator section.\"\n        @tier \"presentation\"\n      mode : \"overlay\" | \"tab\" = overlay\n        @label \"Mode\"\n        @description \"Rendering mode. - `'overlay'` (default): floating side panel positioned absolutely over the canvas. Density follows `disclosureLevel` (compact L1/L2, rich L3+). The `open` flag actually hides the panel when false. - `'tab'`: full-width content for a dedicated 'trace' supplemental tab. Always renders rich (regardless of disclosure level), always visible (the `open` flag is ignored), and includes an empty state when no subagents are present so users see the surface even before generation starts.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/subagent-trace-panel\" as SubagentTracePanelPage -> SubagentTracePanelRender\n}\n"
}