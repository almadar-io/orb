  "source": "",
  "lolo": "app ui-ui-slot-renderer \"1.0.0\"\n\"UiSlotRenderer — UI factory (1:1 with the @almadar/ui ui-slot-renderer pattern).\"\norbital UiSlotRendererOrbital {\n  type UiSlotRendererError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type UiSlotRendererSuspense = {\n    enabled : boolean!\n    slotFallbacks : Map string node\n  }\n\n  entity UiSlotRendererItem [runtime] {\n    id : string!\n  }\n\n  trait UiSlotRendererRender -> @rebindable UiSlotRendererItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (fetch UiSlotRendererItem {})\n        (render-ui main {\n          includeHud: @config.includeHud\n          hudMode: @config.hudMode\n          includeFloating: @config.includeFloating\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          entity: UiSlotRendererItem\n          suspense: @config.suspense\n          type: ui-slot-renderer\n        })\n    }\n\n    config {\n      includeHud : boolean = false\n        @label \"Include Hud\"\n        @description \"Include HUD slots\"\n        @tier \"presentation\"\n      hudMode : \"fixed\" | \"inline\" = fixed\n        @label \"Hud Mode\"\n        @description \"HUD positioning mode: 'fixed' (default, viewport-relative) or 'inline' (container-relative, uses sticky)\"\n        @tier \"presentation\"\n      includeFloating : boolean = false\n        @label \"Include Floating\"\n        @description \"Include floating slot\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class name for the container\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : UiSlotRendererError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      suspense : UiSlotRendererSuspense\n        @label \"Suspense\"\n        @description \"Enable Suspense boundaries around each slot. When true, each inline slot is wrapped in `<ErrorBoundary><Suspense>` with Skeleton fallbacks. Opt-in — existing isLoading prop pattern still works.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/ui-slot-renderer\" as UiSlotRendererPage -> UiSlotRendererRender\n}\n"
}