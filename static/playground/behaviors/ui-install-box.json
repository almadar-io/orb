  "source": "",
  "lolo": "app ui-install-box \"1.0.0\"\n\"InstallBox — UI factory (1:1 with the @almadar/ui install-box pattern).\"\norbital InstallBoxOrbital {\n  entity InstallBoxItem [runtime] {\n    id : string!\n  }\n\n  trait InstallBoxRender -> @rebindable InstallBoxItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          command: @config.command\n          label: @config.label\n          className: @config.className\n          type: install-box\n        })\n    }\n\n    config {\n      command : string = \"\"\n        @label \"Command\"\n        @description \"The command to display and copy\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Optional label above the command\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/install-box\" as InstallBoxPage -> InstallBoxRender\n}\n"
