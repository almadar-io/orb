  "source": "",
  "lolo": "app ui-quiz-block \"1.0.0\"\n\"QuizBlock — a single quiz question with answer choices and submit/reveal feedback. — UI factory (1:1 with the @almadar/ui quiz-block pattern).\"\n;; @capabilities \"multiple-choice quiz, test question, exam item, assessment question, knowledge check, trivia question\"\norbital QuizBlockOrbital {\n  entity QuizBlockItem [runtime] {\n    id : string!\n  }\n\n  trait QuizBlockRender -> @rebindable QuizBlockItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          question: @config.question\n          answer: @config.answer\n          className: @config.className\n          type: quiz-block\n        })\n    }\n\n    config {\n      question : string = \"\"\n        @label \"Question\"\n        @description \"The quiz question\"\n        @tier \"presentation\"\n      answer : string = \"\"\n        @label \"Answer\"\n        @description \"The quiz answer (revealed on toggle)\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/quiz-block\" as QuizBlockPage -> QuizBlockRender\n}\n"
}