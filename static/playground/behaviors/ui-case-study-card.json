  "source": "",
  "lolo": "app ui-case-study-card \"1.0.0\"\n\"CaseStudyCard — a card summarizing a customer case study with logo, headline result, and link. — UI factory (1:1 with the @almadar/ui case-study-card pattern).\"\n;; @capabilities \"customer story, success story, client story card, results showcase, proof-point card\"\norbital CaseStudyCardOrbital {\n  entity CaseStudyCardItem [runtime] {\n    id : string!\n  }\n\n  trait CaseStudyCardRender -> @rebindable CaseStudyCardItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          title: @config.title\n          description: @config.description\n          category: @config.category\n          categoryColor: @config.categoryColor\n          href: @config.href\n          linkLabel: @config.linkLabel\n          className: @config.className\n          type: case-study-card\n        })\n    }\n\n    config {\n      title : string = \"\"\n        @label \"Title\"\n        @description \"Case study title\"\n        @tier \"presentation\"\n      description : string = \"\"\n        @label \"Description\"\n        @description \"Short description of the case study\"\n        @tier \"presentation\"\n      category : string = \"\"\n        @label \"Category\"\n        @description \"Category label shown as a badge\"\n        @tier \"presentation\"\n      categoryColor : string\n        @label \"Category Color\"\n        @description \"Custom background color for the category badge (CSS value)\"\n        @tier \"presentation\"\n      href : string = \"\"\n        @label \"Href\"\n        @description \"URL the card links to\"\n        @tier \"presentation\"\n      linkLabel : string = \"Read more\"\n        @label \"Link Label\"\n        @description \"Label for the link button\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/case-study-card\" as CaseStudyCardPage -> CaseStudyCardRender\n}\n"
}