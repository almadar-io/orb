  "source": "",
  "lolo": "app ui-filter-pill \"1.0.0\"\n\"FilterPill — UI factory (1:1 with the @almadar/ui filter-pill pattern).\"\norbital FilterPillOrbital {\n  entity FilterPillItem [runtime] {\n    id : string!\n    label : string\n  }\n\n  trait FilterPillRender -> @rebindable FilterPillItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.label @config.label)\n        (render-ui main {\n          className: @config.className\n          variant: @config.variant\n          size: @config.size\n          label: @entity.label\n          icon: @config.icon\n          onRemove: @config.onRemove\n          removable: @config.removable\n          onClick: @config.onClick\n          clickEvent: @config.clickEvent\n          removeEvent: @config.removeEvent\n          type: filter-pill\n        })\n      CLICK -> idle\n        (set @entity.label ?label)\n        (render-ui main {\n          className: @config.className\n          variant: @config.variant\n          size: @config.size\n          label: @entity.label\n          icon: @config.icon\n          onRemove: @config.onRemove\n          removable: @config.removable\n          onClick: @config.onClick\n          clickEvent: @config.clickEvent\n          removeEvent: @config.removeEvent\n          type: filter-pill\n        })\n    }\n\n    emits {\n      @config.onClick -> external {\n        label : string!\n      }\n        @description \"Click handler for the body of the pill (filter toggle)\"\n        @tier \"essential\"\n    }\n\n    listens {\n      CLICK {\n        label : string!\n      }\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes applied to the root element.\"\n        @tier \"presentation\"\n      variant : \"default\" | \"primary\" | \"secondary\" | \"success\" | \"warning\" | \"danger\" | \"info\" | \"neutral\" = default\n        @label \"Variant\"\n        @description \"variant prop\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = sm\n        @label \"Size\"\n        @description \"size prop\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Pill label text (alternative to children for schema-driven rendering).\"\n        @tier \"presentation\"\n      icon : icon\n        @label \"Icon\"\n        @description \"Lucide icon component or canonical kebab-case icon name string\"\n        @tier \"presentation\"\n      onRemove : event = \"\"\n        @label \"On Remove\"\n        @description \"Called when the user clicks the remove (×) button\"\n        @tier \"presentation\"\n      removable : boolean = true\n        @label \"Removable\"\n        @description \"Disable the remove button (renders without × control)\"\n        @tier \"presentation\"\n      onClick : event = \"CLICK\"\n        @label \"On Click\"\n        @description \"Click handler for the body of the pill (filter toggle)\"\n        @tier \"presentation\"\n      clickEvent : event = \"CLICK\"\n        @label \"Click Event\"\n        @description \"Event name dispatched via event bus when the pill body is clicked. Payload: { label }\"\n        @tier \"presentation\"\n      removeEvent : event = \"\"\n        @label \"Remove Event\"\n        @description \"Event name dispatched via event bus when the remove (×) button is clicked. Payload: { label }\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/filter-pill\" as FilterPillPage -> FilterPillRender\n}\n"
}