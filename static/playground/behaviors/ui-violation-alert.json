  "source": "",
  "lolo": "app ui-violation-alert \"1.0.0\"\n\"ViolationAlert — UI factory (1:1 with the @almadar/ui violation-alert pattern).\"\norbital ViolationAlertOrbital {\n  type ViolationAlertViolation = {\n    id : string!\n    law : string!\n    article : string!\n    message : string!\n    actionType : \"measure\" | \"admin\" | \"penalty\"!\n    adminAction : string\n    penaltyAction : string\n    fieldId : string\n    tabId : string\n  }\n\n  entity ViolationAlertItem [runtime] {\n    id : string!\n  }\n\n  trait ViolationAlertRender -> @rebindable ViolationAlertItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          violation: @config.violation\n          severity: @config.severity\n          dismissible: @config.dismissible\n          onDismiss: @config.onDismiss\n          onNavigateToField: @config.onNavigateToField\n          compact: @config.compact\n          className: @config.className\n          message: @config.message\n          type: violation-alert\n        })\n    }\n\n    emits {\n      @config.onDismiss -> external { }\n        @description \"Dismiss handler\"\n        @tier \"essential\"\n      @config.onNavigateToField -> external {\n        fieldId : string\n      }\n        @description \"Navigate to the field that caused violation\"\n        @tier \"essential\"\n    }\n\n    config {\n      violation : ViolationAlertViolation = { id: \"Id\", law: \"Law\", article: \"Article\", message: \"Message\", actionType: measure, adminAction: \"Admin Action\", penaltyAction: \"Penalty Action\", fieldId: \"Field Id\", tabId: \"Tab Id\" }\n        @label \"Violation\"\n        @description \"Violation data\"\n        @tier \"presentation\"\n      severity : \"warning\" | \"error\" = warning\n        @label \"Severity\"\n        @description \"Visual severity (derived from actionType if not specified)\"\n        @tier \"presentation\"\n      dismissible : boolean = false\n        @label \"Dismissible\"\n        @description \"Dismissible alert\"\n        @tier \"presentation\"\n      onDismiss : event = \"DISMISS\"\n        @label \"On Dismiss\"\n        @description \"Dismiss handler\"\n        @tier \"presentation\"\n      onNavigateToField : event = \"NAVIGATE_TO_FIELD\"\n        @label \"On Navigate To Field\"\n        @description \"Navigate to the field that caused violation\"\n        @tier \"presentation\"\n      compact : boolean = false\n        @label \"Compact\"\n        @description \"Compact display mode\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      message : string\n        @label \"Message\"\n        @description \"Fallback message from playground render-ui\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/violation-alert\" as ViolationAlertPage -> ViolationAlertRender\n}\n"
}