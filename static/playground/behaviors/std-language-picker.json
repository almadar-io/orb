  "lolo": "app std-language-picker \"1.0.0\"\n\"std-language-picker — the language switcher of a multilingual site or app: a globe button showing the current language code that opens a menu listing every language in its own name, with the current one ticked. Each entry links to the same page in that language. Routing convention: the default language lives at the root and every other language under a `/<code>/` prefix (`/pricing`, `/ar/pricing`, `/sl/pricing`), so each language has its own stable URL that can be linked from outside and indexed by search engines. Pick for public websites and app chrome that serve more than one language; std-site-header embeds it.\"\ntype SiteLanguage = { code : string!, label : string!, href : string! }\norbital LanguagePickerOrbital {\n  entity LanguagePickerView [runtime] {\n    id : string!\n  }\n\n  trait LanguagePickerRender -> @rebindable LanguagePickerView [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main @config.pickerContent)\n    }\n\n    config {\n      languages : [SiteLanguage] = [{ code: \"en\", label: \"English\", href: \"/\" }, { code: \"ar\", label: \"العربية\", href: \"/ar/\" }, { code: \"sl\", label: \"Slovenščina\", href: \"/sl/\" }]\n        @label \"Languages\"\n        @description \"Every language this page exists in, each named in its own language, with the href of THIS page in that language. The default language's href has no prefix; the others start with /<code>/.\"\n        @synonyms \"locales, translations, language list, language switcher, i18n\"\n        @tier \"presentation\"\n      currentLanguage : string = \"en\"\n        @label \"Current language\"\n        @description \"The code of the language this page is in; shown on the button and ticked in the menu\"\n        @synonyms \"locale, active language, page language\"\n        @tier \"presentation\"\n      pickerContent : render-ui = {\n        type: menu\n        position: bottom-end\n        className: (if (== (array/len @config.languages) 0) hidden \"\")\n        trigger: {\n          type: button\n          variant: ghost\n          size: sm\n          icon: globe\n          label: (str/upper @config.currentLanguage)\n        }\n        items: (array/map @config.languages (fn entry {\n          id: (object/get @entry code \"\")\n          label: (object/get @entry label \"\")\n          href: (object/get @entry href \"\")\n          icon: (if (== (object/get @entry code \"\") @config.currentLanguage) check \"\")\n        }))\n      }\n        @label \"Picker body\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/language-picker\" as LanguagePickerPage -> LanguagePickerRender\n}\n"
}