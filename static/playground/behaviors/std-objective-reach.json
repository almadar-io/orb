  "lolo": "app std-objective-reach \"1.0.0\"\n\"Headless reach-the-objective mechanic: owns features + score + objectivesLeft. Listens HERO_STEPPED and, when the hero lands on a target-type feature, scores it (optionally removing the model), emits a BURST pickup particle, and emits PROGRESS so round-flow can decide win/lose. Never writes units.\"\norbital ObjectiveReachOrbital {\n  type Asset = {\n    url : asset\n    role : string\n    category : string\n    animations : [string]\n    style : string\n    variant : string\n    dimension : string\n    aspect : string\n    name : string\n    thumbnailUrl : string\n  }\n  type Feature = {\n    id : string\n    x : number!\n    y : number!\n    z : number\n    type : string!\n    assetUrl : Asset\n    color : string\n    elevation : number\n    done : boolean\n  }\n  type Fx = {\n    id : string!\n    type : string!\n    x : number!\n    z : number\n    y : number\n    message : string\n    ttl : number!\n  }\n\n  entity ObjectiveState [runtime, shared] {\n    id : string!\n    features : [Feature]\n    score : number = 0\n    objectivesLeft : number = 0\n  }\n\n  trait ObjectiveReach -> @rebindable ObjectiveState [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.features @config.features)\n        (set @entity.score @config.startScore)\n        (set @entity.objectivesLeft (array/len (array/filter @config.features (fn f (== (object/get @f type) @config.targetType)))))\n\n      HERO_STEPPED -> active when @config.running\n        (let ((matched (array/filter @entity.features (fn f (and (== (object/get @f type) @config.targetType) (and (!= (object/get @f done) true) (<= (grid/manhattan-distance { x: (object/get @f x), y: (object/get @f y) } { x: @payload.x, y: @payload.z }) @config.reachRadius)))))))\n        (let ((hitCount (array/len @matched)))\n        (do\n          (set @entity.score (+ @entity.score (* @config.pointsPerTarget @hitCount)))\n          (set @entity.objectivesLeft (- @entity.objectivesLeft @hitCount))\n          (set @entity.features (if @config.removeOnReach (array/filter @entity.features (fn f (not (and (== (object/get @f type) @config.targetType) (and (!= (object/get @f done) true) (<= (grid/manhattan-distance { x: (object/get @f x), y: (object/get @f y) } { x: @payload.x, y: @payload.z }) @config.reachRadius)))))) (array/map @entity.features (fn f (if (and (== (object/get @f type) @config.targetType) (and (!= (object/get @f done) true) (<= (grid/manhattan-distance { x: (object/get @f x), y: (object/get @f y) } { x: @payload.x, y: @payload.z }) @config.reachRadius))) (object/merge @f { done: true }) @f)))))\n          (emit BURST { particles: (array/map @matched (fn f { id: (str/concat \"fx-obj-\" (object/get @f id)), type: \"pickup\", x: (object/get @f x), z: (object/get @f y), message: \"+1\", ttl: 3 })) })\n          (emit PROGRESS { objectivesLeft: @entity.objectivesLeft, movesLeft: @payload.movesLeft })\n        )))\n\n      RESTART -> active\n        (set @entity.features @config.features)\n        (set @entity.score @config.startScore)\n        (set @entity.objectivesLeft (array/len (array/filter @config.features (fn f (== (object/get @f type) @config.targetType)))))\n    }\n\n    emits {\n      BURST -> external {\n        particles : [Fx]\n      }\n        @description \"Pickup particle produced when a target is reached; a fx-particles listener spawns it\"\n        @tier \"domain\"\n      PROGRESS -> external {\n        objectivesLeft : number!\n        movesLeft : number!\n      }\n        @description \"Objectives remaining + moves remaining after this step; a round-flow listener decides win/lose\"\n        @tier \"domain\"\n    }\n\n    listens {\n      HERO_STEPPED { unitId : string, x : number, z : number, movesLeft : number }\n      RESTART { id : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, hero steps onto targets are scored; toggle to freeze\"\n        @tier \"domain\"\n      features : [Feature] = []\n        @label \"Features\"\n        @description \"Board features — collectible targets (matched by targetType) plus decorations\"\n        @tier \"domain\"\n      targetType : string = \"gift\"\n        @label \"Target Type\"\n        @description \"Feature type counted as a collectible objective\"\n        @tier \"domain\"\n      pointsPerTarget : number = 1\n        @label \"Points Per Target\"\n        @description \"Score awarded per objective reached\"\n        @tier \"domain\"\n      startScore : number = 0\n        @label \"Start Score\"\n        @description \"Score set on INIT\"\n        @tier \"domain\"\n      removeOnReach : boolean = true\n        @label \"Remove On Reach\"\n        @description \"When true the target model is removed once reached (collect); when false it is flagged done and stays (visit/deliver)\"\n        @tier \"domain\"\n      reachRadius : number = 0\n        @label \"Reach Radius\"\n        @description \"Manhattan distance at which a target counts as reached: 0 = step onto the tile (collect), 1 = adjacent (deliver)\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/objective-reach\" as ObjectiveReachPage -> ObjectiveReach\n}\n"
}