  "source": "",
  "lolo": "app ui-alert \"1.0.0\"\n\"Alert — UI factory (1:1 with the @almadar/ui alert pattern).\"\norbital AlertOrbital {\n  entity AlertItem [runtime] {\n    id : string!\n  }\n\n  trait AlertRender -> @rebindable AlertItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          children: @config.children\n          message: @config.message\n          variant: @config.variant\n          title: @config.title\n          dismissible: @config.dismissible\n          onDismiss: @config.onDismiss\n          onClose: @config.onClose\n          actions: @config.actions\n          className: @config.className\n          dismissEvent: @config.dismissEvent\n          type: alert\n        })\n    }\n\n    emits {\n      @config.onDismiss -> external { }\n        @description \"onDismiss prop\"\n        @tier \"essential\"\n      @config.onClose -> external { }\n        @description \"onClose prop\"\n        @tier \"essential\"\n    }\n\n    config {\n      children : node\n        @label \"Children\"\n        @description \"Alert content (children or message)\"\n        @tier \"presentation\"\n      message : string\n        @label \"Message\"\n        @description \"Alert message (alias for children)\"\n        @tier \"presentation\"\n      variant : \"info\" | \"success\" | \"warning\" | \"error\" = info\n        @label \"Variant\"\n        @description \"variant prop\"\n        @tier \"presentation\"\n      title : string\n        @label \"Title\"\n        @description \"title prop\"\n        @tier \"presentation\"\n      dismissible : boolean = false\n        @label \"Dismissible\"\n        @description \"dismissible prop\"\n        @tier \"presentation\"\n      onDismiss : event = \"DISMISS\"\n        @label \"On Dismiss\"\n        @description \"onDismiss prop\"\n        @tier \"presentation\"\n      onClose : event = \"CLOSE\"\n        @label \"On Close\"\n        @description \"onClose prop\"\n        @tier \"presentation\"\n      actions : node\n        @label \"Actions\"\n        @description \"actions prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      dismissEvent : event = \"DISMISS\"\n        @label \"Dismiss Event\"\n        @description \"Declarative dismiss event — emits UI:{dismissEvent} via eventBus when alert is dismissed\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/alert\" as AlertPage -> AlertRender\n}\n"
}