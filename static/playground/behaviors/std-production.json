  "source": "",
  "lolo": "app std-production \"1.0.0\"\n\"Headless unit-production mechanic: accrues productionPoints each turn (AI_TURN) and, on an affordable PRODUCE, emits a SPAWN intent for the grid-tactics authority to place a new unit. Owns only productionPoints (+ its spawn counter); never writes units directly.\"\norbital ProductionOrbital {\n  entity ProductionState [runtime, shared] {\n    id : string!\n    productionPoints : number = 0\n    spawnCount : number = 0\n  }\n\n  trait Producer -> @rebindable ProductionState [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.productionPoints @config.startPoints)\n        (set @entity.spawnCount 0)\n      AI_TURN -> active when @config.running\n        (set @entity.productionPoints (+ @entity.productionPoints @config.pointsPerTurn))\n      PRODUCE -> active when (and @config.running (>= @entity.productionPoints @config.spawnCost))\n        (emit SPAWN { id: (str/concat \"prod-u-\" @entity.spawnCount), x: @config.spawnX, y: @config.spawnY, team: @config.spawnTeam, health: @config.spawnHealth, maxHealth: @config.spawnHealth, unitType: @config.spawnUnitType })\n        (set @entity.spawnCount (+ @entity.spawnCount 1))\n        (set @entity.productionPoints (- @entity.productionPoints @config.spawnCost))\n    }\n\n    emits {\n      SPAWN -> external {\n        id : string!\n        x : number!\n        y : number!\n        team : string!\n        health : number!\n        maxHealth : number!\n        unitType : string!\n      }\n        @description \"New-unit intent applied by the grid-tactics authority (the sole units writer)\"\n        @tier \"domain\"\n    }\n\n    listens {\n      AI_TURN { turn : number }\n      PRODUCE { id : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, turns accrue points and PRODUCE spends them; toggle to freeze production.\"\n        @tier \"domain\"\n      startPoints : number = 0\n        @label \"Start Points\"\n        @description \"Production points set on INIT.\"\n        @tier \"domain\"\n      pointsPerTurn : number = 2\n        @label \"Points Per Turn\"\n        @description \"Points accrued each AI_TURN (turn advance).\"\n        @tier \"domain\"\n      spawnCost : number = 3\n        @label \"Spawn Cost\"\n        @description \"Points spent per produced unit; PRODUCE only fires when affordable.\"\n        @tier \"domain\"\n      spawnX : number = 0\n        @label \"Spawn X\"\n        @description \"Grid column where produced units appear (rally point).\"\n        @tier \"domain\"\n      spawnY : number = 0\n        @label \"Spawn Y\"\n        @description \"Grid row where produced units appear (rally point).\"\n        @tier \"domain\"\n      spawnTeam : string = \"player\"\n        @label \"Spawn Team\"\n        @description \"Team of produced units.\"\n        @tier \"domain\"\n      spawnUnitType : string = \"unit\"\n        @label \"Spawn Unit Type\"\n        @description \"unitType of produced units (drives the asset-manifest sprite).\"\n        @tier \"domain\"\n      spawnHealth : number = 3\n        @label \"Spawn Health\"\n        @description \"Health/maxHealth of produced units.\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/production\" as ProductionPage -> Producer\n}\n"
