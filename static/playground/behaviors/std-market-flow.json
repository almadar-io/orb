  "source": "",
  "lolo": "app std-market-flow \"1.0.0\"\n\"Headless win/lose authority for market-service boards: owns only result. Listens SERVICE_CHANGED (served + lost) and sets result to won when enough customers are served, lost when too many patience timers expire, else none. Renders nothing.\"\norbital MarketFlowOrbital {\n  entity MarketFlowData [runtime, shared] {\n    id : string!\n    result : string = \"none\"\n  }\n\n  trait MarketFlow -> @rebindable MarketFlowData [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.result \"none\")\n\n      SERVICE_CHANGED -> active when @config.running\n        (set @entity.result (if (>= @payload.served @config.targetServed) \"won\" (if (>= @payload.lost @config.maxLost) \"lost\" \"none\")))\n        (if (!= @entity.result \"none\") (emit GAME_END { result: @entity.result }) null)\n\n      RESTART -> active\n        (set @entity.result \"none\")\n    }\n\n    emits {\n      GAME_END -> external {\n        result : string!\n      }\n        @description \"Emitted when result becomes won or lost\"\n        @tier \"domain\"\n    }\n\n    listens {\n      SERVICE_CHANGED { served : number, pending : number, lost : number }\n      RESTART { id : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, SERVICE_CHANGED signals resolve win/lose; toggle to freeze\"\n        @tier \"domain\"\n      targetServed : number = 10\n        @label \"Target Served\"\n        @description \"Cumulative customers served needed to win\"\n        @tier \"domain\"\n      maxLost : number = 3\n        @label \"Max Lost\"\n        @description \"Cumulative starved-customer count that ends the round in a loss\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/market-flow\" as MarketFlowPage -> MarketFlow\n}\n"
}