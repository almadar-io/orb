  "source": "",
  "lolo": "app ui-jazari-state-machine \"1.0.0\"\n\"JazariStateMachine — UI factory (1:1 with the @almadar/ui jazari-state-machine pattern).\"\norbital JazariStateMachineOrbital {\n  type JazariStateMachineError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity JazariStateMachineItem [runtime] {\n    id : string!\n  }\n\n  trait JazariStateMachineRender -> @rebindable JazariStateMachineItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          traitIndex: @config.traitIndex\n          entityFields: @config.entityFields\n          direction: @config.direction\n          type: jazari-state-machine\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : JazariStateMachineError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n      traitIndex : number = 0\n        @label \"Trait Index\"\n        @description \"Which trait to visualize (default: 0)\"\n        @tier \"presentation\"\n      entityFields : [string] = []\n        @label \"Entity Fields\"\n        @description \"Override entity field labels\"\n        @tier \"presentation\"\n      direction : \"ltr\" | \"rtl\" = ltr\n        @label \"Direction\"\n        @description \"Text direction (default: 'ltr')\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/jazari-state-machine\" as JazariStateMachinePage -> JazariStateMachineRender\n}\n"
}