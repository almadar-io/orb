  "source": "",
  "lolo": "app ui-pagination \"1.0.0\"\n\"Pagination — UI factory (1:1 with the @almadar/ui pagination pattern).\"\norbital PaginationOrbital {\n  entity PaginationItem [runtime] {\n    id : string!\n    pageSize : number @intrinsic\n  }\n\n  trait PaginationRender -> @rebindable PaginationItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.pageSize @config.pageSize)\n        (render-ui main {\n          currentPage: @config.currentPage\n          totalPages: @config.totalPages\n          onPageChange: @config.onPageChange\n          showPageSize: @config.showPageSize\n          pageSizeOptions: @config.pageSizeOptions\n          pageSize: @entity.pageSize\n          onPageSizeChange: @config.onPageSizeChange\n          showJumpToPage: @config.showJumpToPage\n          showTotal: @config.showTotal\n          totalItems: @config.totalItems\n          maxVisiblePages: @config.maxVisiblePages\n          className: @config.className\n          pageChangeEvent: @config.pageChangeEvent\n          pageSizeChangeEvent: @config.pageSizeChangeEvent\n          type: pagination\n        })\n      PAGE_SIZE_CHANGE -> idle\n        (set @entity.pageSize ?pageSize)\n        (render-ui main {\n          currentPage: @config.currentPage\n          totalPages: @config.totalPages\n          onPageChange: @config.onPageChange\n          showPageSize: @config.showPageSize\n          pageSizeOptions: @config.pageSizeOptions\n          pageSize: @entity.pageSize\n          onPageSizeChange: @config.onPageSizeChange\n          showJumpToPage: @config.showJumpToPage\n          showTotal: @config.showTotal\n          totalItems: @config.totalItems\n          maxVisiblePages: @config.maxVisiblePages\n          className: @config.className\n          pageChangeEvent: @config.pageChangeEvent\n          pageSizeChangeEvent: @config.pageSizeChangeEvent\n          type: pagination\n        })\n    }\n\n    emits {\n      @config.onPageChange -> external {\n        page : number\n      }\n        @description \"Callback when page changes (optional - can be a no-op if not interactive)\"\n        @tier \"essential\"\n      @config.onPageSizeChange -> external {\n        size : number\n        pageSize : number!\n      }\n        @description \"Callback when page size changes\"\n        @tier \"essential\"\n    }\n\n    listens {\n      PAGE_SIZE_CHANGE {\n        size : number\n        pageSize : number!\n      }\n    }\n\n    config {\n      currentPage : number = 1\n        @label \"Current Page\"\n        @description \"Current page (1-indexed)\"\n        @tier \"presentation\"\n      totalPages : number = 1\n        @label \"Total Pages\"\n        @description \"Total number of pages\"\n        @tier \"presentation\"\n      onPageChange : event = \"PAGE_CHANGE\"\n        @label \"On Page Change\"\n        @description \"Callback when page changes (optional - can be a no-op if not interactive)\"\n        @tier \"presentation\"\n      showPageSize : boolean = false\n        @label \"Show Page Size\"\n        @description \"Show page size selector\"\n        @tier \"presentation\"\n      pageSizeOptions : [number] = [10, 20, 50, 100]\n        @label \"Page Size Options\"\n        @description \"Page size options\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Current page size\"\n        @tier \"presentation\"\n      onPageSizeChange : event = \"PAGE_SIZE_CHANGE\"\n        @label \"On Page Size Change\"\n        @description \"Callback when page size changes\"\n        @tier \"presentation\"\n      showJumpToPage : boolean = false\n        @label \"Show Jump To Page\"\n        @description \"Show jump to page input\"\n        @tier \"presentation\"\n      showTotal : boolean = false\n        @label \"Show Total\"\n        @description \"Show total count\"\n        @tier \"presentation\"\n      totalItems : number\n        @label \"Total Items\"\n        @description \"Total items count\"\n        @tier \"presentation\"\n      maxVisiblePages : number = 7\n        @label \"Max Visible Pages\"\n        @description \"Maximum number of page buttons to show\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      pageChangeEvent : event = \"PAGE_CHANGE\"\n        @label \"Page Change Event\"\n        @description \"Declarative page change event — emits UI:{pageChangeEvent} with { page }\"\n        @tier \"presentation\"\n      pageSizeChangeEvent : event = \"PAGE_SIZE_CHANGE\"\n        @label \"Page Size Change Event\"\n        @description \"Declarative page size change event — emits UI:{pageSizeChangeEvent} with { pageSize }\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/pagination\" as PaginationPage -> PaginationRender\n}\n"
}