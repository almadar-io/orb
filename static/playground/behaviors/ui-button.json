  "source": "",
  "lolo": "app ui-button \"1.0.0\"\n\"Button — UI factory (1:1 with the @almadar/ui button pattern).\"\norbital ButtonOrbital {\n  type ButtonIconAsset = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n\n  entity ButtonItem [runtime] {\n    id : string!\n  }\n\n  trait ButtonRender -> @rebindable ButtonItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          variant: @config.variant\n          size: @config.size\n          isLoading: @config.isLoading\n          leftIcon: @config.leftIcon\n          rightIcon: @config.rightIcon\n          icon: @config.icon\n          iconRight: @config.iconRight\n          iconAsset: @config.iconAsset\n          action: @config.action\n          actionPayload: @config.actionPayload\n          label: @config.label\n          disabled: @config.disabled\n          type: button\n        })\n    }\n\n    emits {\n      @config.action -> external { }\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes applied to the root element.\"\n        @tier \"presentation\"\n      variant : \"primary\" | \"secondary\" | \"ghost\" | \"danger\" | \"success\" | \"warning\" | \"default\" = primary\n        @label \"Variant\"\n        @description \"variant prop\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"size prop\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"isLoading prop\"\n        @tier \"presentation\"\n      leftIcon : icon\n        @label \"Left Icon\"\n        @description \"Left icon: a Lucide component or a canonical icon name string (e.g. 'plus', 'trash').\"\n        @tier \"presentation\"\n      rightIcon : icon\n        @label \"Right Icon\"\n        @description \"Right icon: a Lucide component or a canonical icon name string.\"\n        @tier \"presentation\"\n      icon : icon\n        @label \"Icon\"\n        @description \"Alias for leftIcon\"\n        @tier \"presentation\"\n      iconRight : icon\n        @label \"Icon Right\"\n        @description \"Alias for rightIcon\"\n        @tier \"presentation\"\n      iconAsset : ButtonIconAsset\n        @label \"Icon Asset\"\n        @description \"Asset image rendered as the leading icon; takes precedence over icon/leftIcon when provided.\"\n        @tier \"presentation\"\n      action : event = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"presentation\"\n      actionPayload : @payload @config.action\n        @label \"Action Payload\"\n        @description \"Payload to include with the action event\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Button label text (alternative to children for schema-driven rendering)\"\n        @tier \"presentation\"\n      disabled : boolean\n        @label \"Disabled\"\n        @description \"Disable the button (greys out, blocks click events)\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/button\" as ButtonPage -> ButtonRender\n}\n"
}