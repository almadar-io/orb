  "source": "",
  "lolo": "app ui-avl-glyph \"1.0.0\"\n\"AvlGlyph — UI factory (1:1 with the @almadar/ui avl-glyph pattern).\"\n;; @pattern \"avl-glyph\"\norbital AvlGlyphOrbital {\n  entity AvlGlyphItem [runtime] {\n    id : string!\n  }\n\n  trait AvlGlyphRender -> @rebindable AvlGlyphItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          kind: @config.kind\n          label: @config.label\n          effectType: @config.effectType\n          size: @config.size\n          showCaption: @config.showCaption\n          className: @config.className\n          type: avl-glyph\n        })\n    }\n\n    config {\n      kind : \"application\" | \"orbital\" | \"entity\" | \"trait\" | \"page\" | \"state\" | \"transition\" | \"event\" | \"guard\" | \"effect\" | \"field\" | \"fieldType\" | \"binding\" | \"bindingRef\" | \"persistence\" | \"operator\" | \"sexpr\" | \"literal\" = state\n        @label \"Kind\"\n        @description \"Which notation symbol to draw.\"\n        @tier \"presentation\"\n      label : string\n        @label \"Label\"\n        @description \"Caption, and the drawn text for operator / literal / bindingRef symbols.\"\n        @tier \"presentation\"\n      effectType : string\n        @label \"Effect Type\"\n        @description \"Effect symbol variant. @default 'set'\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Symbol height. @default 'md'\"\n        @tier \"presentation\"\n      showCaption : boolean = true\n        @label \"Show Caption\"\n        @description \"Show the caption under the symbol. @default true\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/avl-glyph\" as AvlGlyphPage -> AvlGlyphRender\n}\n"
}