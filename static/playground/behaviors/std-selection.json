  "source": "",
  "lolo": "app std-selection \"1.0.0\"\n\"std-selection as a Function\"\norbital SelectableItemOrbital {\n    type SelectableItemLoaded = Event { data : [SelectableItem] } \"Fired when SelectableItem finishes loading; payload.data holds the list\"\n\n    type SelectableItemLoadFailed = Event { error : string, code : string } \"Fired when SelectableItem fails to load\"\n\n  entity SelectableItem [runtime] {\n    id : string!\n    name : string! @description \"The item's display text or identifier.\" @synonyms \"label, title, identifier\"\n    description : string @description \"A textual explanation of the item.\" @synonyms \"details, explanation, notes\"\n    status : \"active\" | \"inactive\" | \"pending\" @description \"Indicates the current operational state of the item.\" @synonyms \"state, condition, flag\" = active\n    createdAt : string\n  }\n\n  trait SelectableItemSelection -> @rebindable SelectableItem [interaction, collection] {\n    initial: loading\n\n    state loading {\n      INIT -> loading\n        (fetch SelectableItem {\n          emit: { failure: SelectableItemLoadFailed, success: SelectableItemLoaded }\n        })\n        (render-ui main {\n          align: center\n          children: [{ type: spinner }, {\n            color: muted\n            content: \"Loading…\"\n            type: typography\n            variant: caption\n          }]\n          className: py-12\n          direction: vertical\n          gap: md\n          type: stack\n        })\n      SelectableItemLoaded -> idle\n        (render-ui main {\n          children: [{\n            align: center\n            children: [{ name: check-square, type: icon }, {\n              content: SelectableItems\n              type: typography\n              variant: h2\n            }]\n            direction: horizontal\n            gap: sm\n            type: stack\n          }, { type: divider }, {\n            color: muted\n            content: \"Choose a selectableitem to continue.\"\n            type: typography\n            variant: caption\n          }, {\n            className: \"transition-shadow hover:shadow-md cursor-pointer\"\n            entity: ?data\n            fields: []\n            itemActions: [{\n              event: SELECT\n              icon: check\n              label: Select\n            }]\n            look: @config.tableLook\n            renderItem: (fn item {\n              align: center\n              children: [{ label: @item.name, type: checkbox }]\n              direction: horizontal\n              gap: sm\n              type: stack\n            })\n            type: data-grid\n          }]\n          direction: vertical\n          gap: lg\n          type: stack\n        })\n      SelectableItemLoadFailed -> error\n        (render-ui main {\n          align: center\n          children: [{\n            color: error\n            name: alert-triangle\n            type: icon\n          }, {\n            content: \"Failed to load\"\n            type: typography\n            variant: h3\n          }, {\n            color: muted\n            content: ?error\n            type: typography\n            variant: body\n          }, {\n            action: RETRY\n            icon: rotate-ccw\n            label: Retry\n            type: button\n            variant: primary\n          }]\n          className: py-12\n          direction: vertical\n          gap: md\n          type: stack\n        })\n    }\n\n    state idle {\n      SELECT -> selecting\n        (render-ui main {\n          children: [{\n            align: center\n            children: [{\n              align: center\n              children: [{ name: check-square, type: icon }, {\n                content: SelectableItems\n                type: typography\n                variant: h2\n              }]\n              direction: horizontal\n              gap: md\n              type: stack\n            }, {\n              align: center\n              children: [{ label: Selecting, type: badge }, {\n                action: CLEAR\n                icon: x\n                label: Clear\n                type: button\n                variant: ghost\n              }]\n              direction: horizontal\n              gap: sm\n              type: stack\n            }]\n            direction: horizontal\n            gap: md\n            justify: between\n            type: stack\n          }, { type: divider }, {\n            message: ?id\n            type: alert\n            variant: info\n          }, {\n            children: [{\n              action: CONFIRM_SELECTION\n              actionPayload: { id: ?id }\n              icon: check\n              label: Confirm\n              type: button\n              variant: primary\n            }]\n            direction: horizontal\n            gap: sm\n            type: stack\n          }]\n          direction: vertical\n          gap: lg\n          type: stack\n        })\n    }\n\n    state selecting {\n      CONFIRM_SELECTION -> selected\n        (render-ui main {\n          children: [{\n            align: center\n            children: [{\n              align: center\n              children: [{ name: check-circle, type: icon }, {\n                content: \"Selection Confirmed\"\n                type: typography\n                variant: h2\n              }]\n              direction: horizontal\n              gap: md\n              type: stack\n            }, { label: Confirmed, type: badge }]\n            direction: horizontal\n            gap: md\n            justify: between\n            type: stack\n          }, { type: divider }, {\n            message: \"Selection confirmed successfully.\"\n            type: alert\n            variant: success\n          }, {\n            align: center\n            children: [{\n              content: \"Selected ID:\"\n              type: typography\n              variant: caption\n            }, {\n              content: ?id\n              type: typography\n              variant: body\n            }]\n            direction: horizontal\n            gap: md\n            type: stack\n          }, {\n            action: CLEAR\n            icon: rotate-ccw\n            label: \"Clear Selection\"\n            type: button\n            variant: ghost\n          }]\n          direction: vertical\n          gap: lg\n          type: stack\n        })\n      CLEAR -> loading\n        (fetch SelectableItem {\n          emit: { failure: SelectableItemLoadFailed, success: SelectableItemLoaded }\n        })\n        (render-ui main { type: spinner })\n    }\n\n    state selected {\n      CLEAR -> loading\n        (fetch SelectableItem {\n          emit: { failure: SelectableItemLoadFailed, success: SelectableItemLoaded }\n        })\n        (render-ui main { type: spinner })\n    }\n\n    state error {\n      INIT -> loading\n        (fetch SelectableItem {\n          emit: { failure: SelectableItemLoadFailed, success: SelectableItemLoaded }\n        })\n        (render-ui main { type: spinner })\n      ;; the error screen's Retry button: INIT is lifecycle-only and the bus never\n      ;; delivers it, so the affordance must target a first-class user event\n      RETRY -> loading\n        (fetch SelectableItem {\n          emit: { failure: SelectableItemLoadFailed, success: SelectableItemLoaded }\n        })\n        (render-ui main { type: spinner })\n    }\n\n    emits {\n      SelectableItemLoaded\n        @description \"Indicates a selectable item has been successfully loaded.\"\n        @synonyms \"loaded, initialized, ready\"\n        @tier \"domain\"\n      SelectableItemLoadFailed\n        @description \"Indicates a selectable item failed to load.\"\n        @synonyms \"error, failure, problem, unsuccessful\"\n        @tier \"internal\"\n    }\n\n    listens {\n      SELECT {\n        id : string!\n      }\n        @description \"Indicates an item has been chosen.\"\n        @synonyms \"chosen, picked, highlighted\"\n        @tier \"domain\"\n      CONFIRM_SELECTION {\n        id : string!\n      }\n        @description \"Indicates a selection has been finalized.\"\n        @synonyms \"accept, finalize, submit, choose\"\n        @tier \"domain\"\n      SelectableItemLoadFailed {\n        error : string\n        code : string\n      }\n        @description \"Indicates a selectable item failed to load.\"\n        @synonyms \"error, failure, problem, load error\"\n        @tier \"internal\"\n    }\n\n    config {\n      tableLook : \"dense\" | \"spacious\" | \"striped\" | \"borderless\" | \"card-rows\" = dense\n        @label \"Table look\"\n        @description \"Layer 2 visual treatment for the data table rendered by this atom.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/selectableitems/selection\" as SelectableItemSelectionPage -> SelectableItemSelection\n}"
}