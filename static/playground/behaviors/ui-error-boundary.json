  "source": "",
  "lolo": "app ui-error-boundary \"1.0.0\"\n\"ErrorBoundary — UI factory (1:1 with the @almadar/ui error-boundary pattern).\"\norbital ErrorBoundaryOrbital {\n  entity ErrorBoundaryItem [runtime] {\n    id : string!\n  }\n\n  trait ErrorBoundaryRender -> @rebindable ErrorBoundaryItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          children: @config.children\n          className: @config.className\n          type: error-boundary\n        })\n    }\n\n    config {\n      children : node\n        @label \"Children\"\n        @description \"Content to render when no error\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes for the wrapper\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/error-boundary\" as ErrorBoundaryPage -> ErrorBoundaryRender\n}\n"
