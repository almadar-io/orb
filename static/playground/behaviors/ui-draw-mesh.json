  "source": "",
  "lolo": "app ui-draw-mesh \"1.0.0\"\n\"DrawMesh — UI factory (1:1 with the @almadar/ui draw-mesh pattern).\"\norbital DrawMeshOrbital {\n  type DrawMeshPosition = {\n    x : number!\n    y : number!\n    z : number\n  }\n  type DrawMeshSkin = {\n    bones : [string]!\n    inverseBindMatrices : [[number]]!\n    indices : [[number]]!\n    weights : [[number]]!\n  }\n  type DrawMeshMaterial = {\n    kind : \"standard\" | \"physical\" | \"toon\" | \"basic\"\n    color : string\n    metalness : number\n    roughness : number\n    emissive : string\n    emissiveIntensity : number\n    opacity : number\n    transmission : number\n    ior : number\n    flatShading : boolean\n    side : \"front\" | \"back\" | \"double\"\n    map : string\n  }\n  type DrawMeshOutline = {\n    color : string\n    width : number\n  }\n  type DrawMeshAnimation = {\n    durationMs : number!\n    loop : boolean\n    keyframes : [DrawMeshAnimationKeyframesItem]!\n  }\n  type DrawMeshAnimationKeyframesItem = {\n    at : number!\n    offsetX : number\n    offsetY : number\n    offsetZ : number\n    rotateX : number\n    rotateY : number\n    rotateZ : number\n    scale : number\n    opacity : number\n    emissiveIntensity : number\n    color : string\n    emissive : string\n  }\n\n  entity DrawMeshItem [runtime] {\n    id : string!\n  }\n\n  trait DrawMeshRender -> @rebindable DrawMeshItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          shape: @config.shape\n          position: @config.position\n          width: @config.width\n          height: @config.height\n          depth: @config.depth\n          radius: @config.radius\n          radiusTop: @config.radiusTop\n          radiusBottom: @config.radiusBottom\n          tube: @config.tube\n          segments: @config.segments\n          vertices: @config.vertices\n          faces: @config.faces\n          uvs: @config.uvs\n          skin: @config.skin\n          rotation: @config.rotation\n          pivot: @config.pivot\n          material: @config.material\n          outline: @config.outline\n          castShadow: @config.castShadow\n          receiveShadow: @config.receiveShadow\n          animation: @config.animation\n          opacity: @config.opacity\n          type: draw-mesh\n        })\n    }\n\n    config {\n      shape : \"box\" | \"sphere\" | \"capsule\" | \"cylinder\" | \"cone\" | \"torus\" | \"plane\" | \"circle\" | \"polyhedron\" = box\n        @label \"Shape\"\n        @description \"shape prop\"\n        @tier \"presentation\"\n      position : DrawMeshPosition = { x: 1, y: 1, z: 1 }\n        @label \"Position\"\n        @description \"Logical scene position; `z` is height in cells (projected to world Y).\"\n        @tier \"presentation\"\n      width : number\n        @label \"Width\"\n        @description \"Box/plane X extent in cells (default 1).\"\n        @tier \"presentation\"\n      height : number\n        @label \"Height\"\n        @description \"Box Y (height) extent / capsule-cylinder-cone length in cells (default 1).\"\n        @tier \"presentation\"\n      depth : number\n        @label \"Depth\"\n        @description \"Box/plane Z extent in cells (default `width`).\"\n        @tier \"presentation\"\n      radius : number\n        @label \"Radius\"\n        @description \"Sphere/capsule/cone/torus/circle radius in cells (default 0.4).\"\n        @tier \"presentation\"\n      radiusTop : number\n        @label \"Radius Top\"\n        @description \"Cylinder top radius (default `radius`).\"\n        @tier \"presentation\"\n      radiusBottom : number\n        @label \"Radius Bottom\"\n        @description \"Cylinder bottom radius (default `radius`).\"\n        @tier \"presentation\"\n      tube : number\n        @label \"Tube\"\n        @description \"Torus tube radius in cells (default `radius` / 3).\"\n        @tier \"presentation\"\n      segments : number\n        @label \"Segments\"\n        @description \"Curved-surface tessellation, clamped 3..64 (default 24). 4–8 + `flatShading` = low-poly.\"\n        @tier \"presentation\"\n      vertices : [[number]] = []\n        @label \"Vertices\"\n        @description \"`polyhedron` only: raw vertices as scene-frame `[x, y, z]` triples in cells, `z` = up.\"\n        @tier \"presentation\"\n      faces : [[number]] = []\n        @label \"Faces\"\n        @description \"`polyhedron` only: triangle index triples into `vertices`, wound counter-clockwise seen from OUTSIDE in the scene frame.\"\n        @tier \"presentation\"\n      uvs : [[number]] = []\n        @label \"Uvs\"\n        @description \"`polyhedron` only: per-vertex `[u, v]` texture coordinates parallel to `vertices`, glTF convention (`v` grows DOWN from the image's top-left). Pairs with `material.map`.\"\n        @tier \"presentation\"\n      skin : DrawMeshSkin\n        @label \"Skin\"\n        @description \"`polyhedron` only: smooth-skinning weights binding the vertices to named bone groups. Vertices must then be authored in BIND POSE model space; the bones' animated transforms deform them.\"\n        @tier \"presentation\"\n      rotation : [number] = []\n        @label \"Rotation\"\n        @description \"Euler rotation `[x, y, z]` in radians.\"\n        @tier \"presentation\"\n      pivot : \"bottom\" | \"center\" = bottom\n        @label \"Pivot\"\n        @description \"`bottom` (default) rests the mesh on its position's ground plane; `center` centers it there. For `polyhedron`, `bottom` lifts by −min(z) and `center` applies no offset — the vertices are authoritative.\"\n        @tier \"presentation\"\n      material : DrawMeshMaterial\n        @label \"Material\"\n        @description \"material prop\"\n        @tier \"presentation\"\n      outline : DrawMeshOutline\n        @label \"Outline\"\n        @description \"outline prop\"\n        @tier \"presentation\"\n      castShadow : boolean\n        @label \"Cast Shadow\"\n        @description \"castShadow prop\"\n        @tier \"presentation\"\n      receiveShadow : boolean\n        @label \"Receive Shadow\"\n        @description \"receiveShadow prop\"\n        @tier \"presentation\"\n      animation : DrawMeshAnimation\n        @label \"Animation\"\n        @description \"Keyframe animation over transform/material tracks; the 3D host runs it per frame.\"\n        @tier \"presentation\"\n      opacity : number\n        @label \"Opacity\"\n        @description \"0..1 opacity; multiplies the material and enclosing group opacity.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/draw-mesh\" as DrawMeshPage -> DrawMeshRender\n}\n"
}