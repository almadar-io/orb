  "source": "",
  "lolo": "app ui-runtime-debugger \"1.0.0\"\n\"RuntimeDebugger — UI factory (1:1 with the @almadar/ui runtime-debugger pattern).\"\norbital RuntimeDebuggerOrbital {\n  entity RuntimeDebuggerItem [runtime] {\n    id : string!\n  }\n\n  trait RuntimeDebuggerRender -> @rebindable RuntimeDebuggerItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          position: @config.position\n          defaultCollapsed: @config.defaultCollapsed\n          className: @config.className\n          mode: @config.mode\n          defaultTab: @config.defaultTab\n          type: runtime-debugger\n        })\n    }\n\n    config {\n      position : \"bottom-right\" | \"bottom-left\" | \"top-right\" | \"top-left\" = \"bottom-right\"\n        @label \"Position\"\n        @description \"Initial position\"\n        @tier \"presentation\"\n      defaultCollapsed : boolean = true\n        @label \"Default Collapsed\"\n        @description \"Initial collapsed state\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      mode : \"floating\" | \"inline\" | \"verify\" = floating\n        @label \"Mode\"\n        @description \"Display mode: floating (fixed overlay), inline (block element), or verify (always-visible compact overlay for verification runs)\"\n        @tier \"presentation\"\n      defaultTab : string\n        @label \"Default Tab\"\n        @description \"Default active tab id\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/runtime-debugger\" as RuntimeDebuggerPage -> RuntimeDebuggerRender\n}\n"
}