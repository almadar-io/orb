  "source": "",
  "lolo": "app ui-calendar-grid \"1.0.0\"\n\"CalendarGrid — UI factory (1:1 with the @almadar/ui calendar-grid pattern).\"\norbital CalendarGridOrbital {\n    type CalendarGridLoaded = Event { data : [CalendarGridItem] } \"CalendarGrid rows finished loading; payload.data holds the collection\"\n\n  entity CalendarGridItem [runtime] {\n    id : string!\n    title : string = \"Title\"\n    startTime : string = \"Start Time\"\n    endTime : string = \"End Time\"\n    color : string = \"Color\"\n  }\n\n  trait CalendarGridRender -> @rebindable CalendarGridItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle when @config.selfFetch\n        (fetch CalendarGridItem { emit: { success: CalendarGridLoaded } })\n        (render-ui main {\n          weekStart: @config.weekStart\n          timeSlots: @config.timeSlots\n          events: @entity\n          onSlotClick: @config.onSlotClick\n          onDayClick: @config.onDayClick\n          onEventClick: @config.onEventClick\n          className: @config.className\n          longPressEvent: @config.longPressEvent\n          longPressPayload: @config.longPressPayload\n          swipeLeftEvent: @config.swipeLeftEvent\n          swipeRightEvent: @config.swipeRightEvent\n          dayWindow: @config.dayWindow\n          titleField: @config.titleField\n          startField: @config.startField\n          endField: @config.endField\n          colorField: @config.colorField\n          type: calendar-grid\n        })\n      INIT -> idle when (not @config.selfFetch)\n        (render-ui main {\n          weekStart: @config.weekStart\n          timeSlots: @config.timeSlots\n          events: @entity\n          onSlotClick: @config.onSlotClick\n          onDayClick: @config.onDayClick\n          onEventClick: @config.onEventClick\n          className: @config.className\n          longPressEvent: @config.longPressEvent\n          longPressPayload: @config.longPressPayload\n          swipeLeftEvent: @config.swipeLeftEvent\n          swipeRightEvent: @config.swipeRightEvent\n          dayWindow: @config.dayWindow\n          titleField: @config.titleField\n          startField: @config.startField\n          endField: @config.endField\n          colorField: @config.colorField\n          type: calendar-grid\n        })\n      CalendarGridLoaded -> idle\n        (render-ui main {\n          weekStart: @config.weekStart\n          timeSlots: @config.timeSlots\n          events: @payload.data\n          onSlotClick: @config.onSlotClick\n          onDayClick: @config.onDayClick\n          onEventClick: @config.onEventClick\n          className: @config.className\n          longPressEvent: @config.longPressEvent\n          longPressPayload: @config.longPressPayload\n          swipeLeftEvent: @config.swipeLeftEvent\n          swipeRightEvent: @config.swipeRightEvent\n          dayWindow: @config.dayWindow\n          titleField: @config.titleField\n          startField: @config.startField\n          endField: @config.endField\n          colorField: @config.colorField\n          type: calendar-grid\n        })\n    }\n\n    emits {\n      @config.onSlotClick -> external {\n        day : date\n        time : string\n      }\n        @description \"Called when a time slot is clicked\"\n        @tier \"essential\"\n      @config.onDayClick -> external {\n        day : date\n      }\n        @description \"Called when a day header is clicked\"\n        @tier \"essential\"\n      @config.onEventClick -> external {\n        event : @entity\n      }\n        @description \"Called when an event is clicked\"\n        @tier \"essential\"\n      @config.longPressEvent -> external {\n        date : string!\n        time : string\n      }\n        @description \"Event emitted on long-press of a time slot: UI:{longPressEvent} with { date, time, ...longPressPayload }\"\n        @tier \"essential\"\n      @config.swipeLeftEvent -> external { }\n        @description \"Event emitted on swipe left (next week): UI:{swipeLeftEvent}\"\n        @tier \"essential\"\n      @config.swipeRightEvent -> external { }\n        @description \"Event emitted on swipe right (prev week): UI:{swipeRightEvent}\"\n        @tier \"essential\"\n      CalendarGridLoaded\n        @description \"CalendarGrid rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      weekStart : date = \"2024-01-01\"\n        @label \"Week Start\"\n        @description \"Start of the week (defaults to current week's Monday)\"\n        @tier \"presentation\"\n      timeSlots : [string] = []\n        @label \"Time Slots\"\n        @description \"Time slot labels (defaults to 09:00-17:00)\"\n        @tier \"presentation\"\n      onSlotClick : event = \"SLOT_CLICK\"\n        @label \"On Slot Click\"\n        @description \"Called when a time slot is clicked\"\n        @tier \"presentation\"\n      onDayClick : event = \"DAY_CLICK\"\n        @label \"On Day Click\"\n        @description \"Called when a day header is clicked\"\n        @tier \"presentation\"\n      onEventClick : event = \"EVENT_CLICK\"\n        @label \"On Event Click\"\n        @description \"Called when an event is clicked\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      longPressEvent : event = \"LONG_PRESS\"\n        @label \"Long Press Event\"\n        @description \"Event emitted on long-press of a time slot: UI:{longPressEvent} with { date, time, ...longPressPayload }\"\n        @tier \"presentation\"\n      longPressPayload : @payload @config.longPressEvent\n        @label \"Long Press Payload\"\n        @description \"Additional payload for long-press events\"\n        @tier \"presentation\"\n      swipeLeftEvent : event = \"SWIPE_LEFT\"\n        @label \"Swipe Left Event\"\n        @description \"Event emitted on swipe left (next week): UI:{swipeLeftEvent}\"\n        @tier \"presentation\"\n      swipeRightEvent : event = \"SWIPE_RIGHT\"\n        @label \"Swipe Right Event\"\n        @description \"Event emitted on swipe right (prev week): UI:{swipeRightEvent}\"\n        @tier \"presentation\"\n      dayWindow : \"auto\"\n        @label \"Day Window\"\n        @description \"Override the viewport-driven day window. `'auto'` (default) tracks `window.innerWidth` — 1 day on mobile, 3 on tablet, 7 on laptop+. Pass an explicit number to force a fixed window (useful for print layouts or screenshot tests).\"\n        @tier \"presentation\"\n      titleField : string = title\n        @label \"Title Field\"\n        @description \"Row field holding the chip label. Defaults to `title`. Lets a host bound to its own entity name the column instead of being forced to rename its fields to this grid's contract (same accessor idiom as `DataList`'s `senderField` / `DataGrid`'s `imageField`).\"\n        @tier \"presentation\"\n      startField : string = startTime\n        @label \"Start Field\"\n        @description \"Row field holding the start timestamp (ISO or epoch). Defaults to `startTime`.\"\n        @tier \"presentation\"\n      endField : string = endTime\n        @label \"End Field\"\n        @description \"Row field holding the end timestamp (ISO or epoch). Defaults to `endTime`. When a row carries an end, the event's chip renders in its start slot and every further slot it covers shows a subdued continuation bar — without this, multi-hour events silently collapsed to their first hour.\"\n        @tier \"presentation\"\n      colorField : string = color\n        @label \"Color Field\"\n        @description \"Row field holding the chip's Tailwind colour class. Defaults to `color`.\"\n        @tier \"presentation\"\n      selfFetch : boolean = true\n        @label \"Fetch its own rows on mount?\"\n        @description \"true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/calendar-grid\" as CalendarGridPage -> CalendarGridRender\n}\n"
}