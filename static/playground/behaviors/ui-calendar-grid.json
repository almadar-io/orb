              },
              "dayWindow": {
                "type": "string",
                "label": "Day Window",
                "description": "Override the viewport-driven day window. `'auto'` (default) tracks `window.innerWidth` — 1 day on mobile, 3 on tablet, 7 on laptop+. Pass an explicit number to force a fixed window (useful for print layouts or screenshot tests).",
                "tier": "presentation"
              },
              "className": {
                "type": "string",
                "label": "Class Name",
                "description": "Additional CSS classes",
                "tier": "presentation"
              },
              "onDayClick": {
                "type": "event",
                "default": "DAY_CLICK",
                "label": "On Day Click",
                "description": "Called when a day header is clicked",
                "tier": "presentation"
              },
              "swipeRightEvent": {
                "type": "event",
                "default": "SWIPE_RIGHT",
                "label": "Swipe Right Event",
                "description": "Event emitted on swipe right (prev week): UI:{swipeRightEvent}",
                "tier": "presentation"
              },
              "titleField": {
                "type": "string",
                "default": "title",
                "label": "Title Field",
                "description": "Row field holding the chip label. Defaults to `title`. Lets a host bound to its own entity name the column instead of being forced to rename its fields to this grid's contract (same accessor idiom as `DataList`'s `senderField` / `DataGrid`'s `imageField`).",
                "tier": "presentation"
              },
              "onSlotClick": {
                "type": "event",
                "default": "SLOT_CLICK",
                "label": "On Slot Click",
                "description": "Called when a time slot is clicked",
                "tier": "presentation"
              },
              "colorField": {
                "type": "string",
                "default": "color",
                "label": "Color Field",
                "description": "Row field holding the chip's Tailwind colour class. Defaults to `color`.",
                "tier": "presentation"
              },
              "endField": {
                "type": "string",
                "default": "endTime",
                "label": "End Field",
                "description": "Row field holding the end timestamp (ISO or epoch). Defaults to `endTime`. When a row carries an end, the event's chip renders in its start slot and every further slot it covers shows a subdued continuation bar — without this, multi-hour events silently collapsed to their first hour.",
                "tier": "presentation"
              },
              "startField": {
                "type": "string",
                "default": "startTime",
                "label": "Start Field",
                "description": "Row field holding the start timestamp (ISO or epoch). Defaults to `startTime`.",
                "tier": "presentation"
              },
              "longPressEvent": {
                "type": "event",
                "default": "LONG_PRESS",
                "label": "Long Press Event",
                "description": "Event emitted on long-press of a time slot: UI:{longPressEvent} with { date, time, ...longPressPayload }",
