  "source": "",
  "lolo": "app ui-theme-toggle \"1.0.0\"\n\"ThemeToggle — UI factory (1:1 with the @almadar/ui theme-toggle pattern).\"\norbital ThemeToggleOrbital {\n  entity ThemeToggleItem [runtime] {\n    id : string!\n  }\n\n  trait ThemeToggleRender -> @rebindable ThemeToggleItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          size: @config.size\n          showLabel: @config.showLabel\n          type: theme-toggle\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Size variant\"\n        @tier \"presentation\"\n      showLabel : boolean = false\n        @label \"Show Label\"\n        @description \"Show label text\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/theme-toggle\" as ThemeTogglePage -> ThemeToggleRender\n}\n"
}