  "source": "",
  "lolo": "app std-marketing-hero \"1.0.0\"\n\"Hero section atom for marketing pages. Renders a full-width hero with tag, title, subtitle, actions, and optional image. Pick for landing pages, product launches, and campaign microsites.\"\n;; Config-driven hero that uses the `hero-section` marketing pattern.\n;; All copy, imagery, and styling are overrideable at the call site.\n;; The atom emits CTA_CLICK when the primary or secondary action is triggered.\norbital HeroItemOrbital {\n  entity HeroItem [runtime] {\n    id : string!\n  }\n\n  trait HeroItemHero -> HeroItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          align: @config.align\n          background: @config.background\n          image: { alt: @config.imageAlt, src: @config.imageSrc }\n          imagePosition: @config.imagePosition\n          installCommand: @config.installCommand\n          primaryAction: { href: @config.primaryActionHref, label: @config.primaryActionLabel }\n          secondaryAction: { href: @config.secondaryActionHref, label: @config.secondaryActionLabel }\n          subtitle: @config.subtitle\n          tag: @config.tag\n          tagVariant: @config.tagVariant\n          title: @config.title\n          titleAccent: @config.titleAccent\n          type: hero-section\n          className: @config.className\n        })\n      CTA_PRIMARY -> idle\n        (emit CTA_PRIMARY { href: @config.primaryActionHref })\n      CTA_SECONDARY -> idle\n        (emit CTA_SECONDARY { href: @config.secondaryActionHref })\n    }\n\n    emits {\n      CTA_PRIMARY -> external {\n        href : string\n      }\n        @description \"Signals the primary call to action has been triggered.\"\n        @synonyms \"click, activate, submit, trigger\"\n        @tier \"domain\"\n      CTA_SECONDARY -> external {\n        href : string\n      }\n        @description \"Signals a secondary call to action has been triggered.\"\n        @synonyms \"secondary action, second button, alternative link\"\n        @tier \"domain\"\n    }\n\n    listens {\n      CTA_PRIMARY {\n        href : string\n      }\n        @description \"A primary call to action has been triggered.\"\n        @synonyms \"click, select, submit, activate\"\n        @tier \"domain\"\n      CTA_SECONDARY {\n        href : string\n      }\n        @description \"A secondary call to action has been triggered.\"\n        @synonyms \"secondary action, second click, alternate button\"\n        @tier \"domain\"\n    }\n\n    config {\n      tag : string = \"\"\n        @label \"Tag\"\n        @description \"Small badge above the headline\"\n        @tier \"presentation\"\n      tagVariant : string = accent\n        @label \"Tag Variant\"\n        @description \"Visual style of the tag badge\"\n        @tier \"presentation\"\n      title : string = \"Build faster with Almadar\"\n        @label \"Title\"\n        @description \"Main headline\"\n        @tier \"presentation\"\n      titleAccent : string = \"\"\n        @label \"Title Accent\"\n        @description \"Highlighted portion of the title\"\n        @tier \"presentation\"\n      subtitle : string = \"From idea to production in minutes, not months.\"\n        @label \"Subtitle\"\n        @description \"Supporting text below the title\"\n        @tier \"presentation\"\n      primaryActionLabel : string = \"Get Started\"\n        @label \"Primary Action Label\"\n        @tier \"presentation\"\n      primaryActionHref : string = \"#\"\n        @label \"Primary Action Link\"\n        @tier \"presentation\"\n      secondaryActionLabel : string = \"\"\n        @label \"Secondary Action Label\"\n        @tier \"presentation\"\n      secondaryActionHref : string = \"\"\n        @label \"Secondary Action Link\"\n        @tier \"presentation\"\n      installCommand : string = \"\"\n        @label \"Install Command\"\n        @description \"CLI command shown in a copyable box\"\n        @tier \"presentation\"\n      imageSrc : string = \"\"\n        @label \"Image Source\"\n        @tier \"presentation\"\n      imageAlt : string = \"\"\n        @label \"Image Alt Text\"\n        @tier \"presentation\"\n      imagePosition : string = below\n        @label \"Image Position\"\n        @description \"below, right, or background\"\n        @tier \"presentation\"\n      background : string = gradient\n        @label \"Background\"\n        @description \"dark, gradient, or subtle\"\n        @tier \"presentation\"\n      align : string = center\n        @label \"Alignment\"\n        @description \"center or left\"\n        @tier \"presentation\"\n      className : string = \"\"\n        @label \"Extra CSS classes\"\n        @description \"Additional Tailwind classes applied to the hero root, e.g. to reduce height.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/hero\" as HeroItemHeroPage -> HeroItemHero\n}\n"
}