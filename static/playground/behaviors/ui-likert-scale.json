  "source": "",
  "lolo": "app ui-likert-scale \"1.0.0\"\n\"LikertScale — UI factory (1:1 with the @almadar/ui likert-scale pattern).\"\norbital LikertScaleOrbital {\n  type LikertScaleOptionsItem = {\n    value : string!\n    label : string!\n  }\n\n  entity LikertScaleItem [runtime] {\n    id : string!\n  }\n\n  trait LikertScaleRender -> @rebindable LikertScaleItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          question: @config.question\n          options: @config.options\n          value: @config.value\n          onChange: @config.onChange\n          changeEvent: @config.changeEvent\n          disabled: @config.disabled\n          size: @config.size\n          variant: @config.variant\n          className: @config.className\n          type: likert-scale\n        })\n    }\n\n    emits {\n      @config.onChange -> external {\n        value : number\n      }\n        @description \"Change callback\"\n        @tier \"essential\"\n    }\n\n    config {\n      question : string\n        @label \"Question\"\n        @description \"Optional row prompt above the scale\"\n        @tier \"presentation\"\n      options : [LikertScaleOptionsItem] = []\n        @label \"Options\"\n        @description \"Scale points (defaults to a 5-point agree/disagree set)\"\n        @tier \"presentation\"\n      value : scalar\n        @label \"Value\"\n        @description \"Selected value (controlled)\"\n        @tier \"presentation\"\n      onChange : event = \"CHANGE\"\n        @label \"On Change\"\n        @description \"Change callback\"\n        @tier \"presentation\"\n      changeEvent : event = \"CHANGE\"\n        @label \"Change Event\"\n        @description \"Event name dispatched via event bus on change. Payload: { value: number | string }\"\n        @tier \"presentation\"\n      disabled : boolean = false\n        @label \"Disabled\"\n        @description \"Disabled state\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Size variant\"\n        @tier \"presentation\"\n      variant : \"radios\" | \"buttons\" = radios\n        @label \"Variant\"\n        @description \"Visual variant: classic radios or pill segmented buttons\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/likert-scale\" as LikertScalePage -> LikertScaleRender\n}\n"
}