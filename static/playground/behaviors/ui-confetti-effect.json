  "source": "",
  "lolo": "app ui-confetti-effect \"1.0.0\"\n\"ConfettiEffect — UI factory (1:1 with the @almadar/ui confetti-effect pattern).\"\norbital ConfettiEffectOrbital {\n  entity ConfettiEffectItem [runtime] {\n    id : string!\n  }\n\n  trait ConfettiEffectRender -> @rebindable ConfettiEffectItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          trigger: @config.trigger\n          duration: @config.duration\n          particleCount: @config.particleCount\n          className: @config.className\n          type: confetti-effect\n        })\n    }\n\n    config {\n      trigger : boolean = false\n        @label \"Trigger\"\n        @description \"When this changes from false to true, a burst of particles is spawned\"\n        @tier \"presentation\"\n      duration : number = 2000\n        @label \"Duration\"\n        @description \"How long the animation lasts in milliseconds\"\n        @tier \"presentation\"\n      particleCount : number = 30\n        @label \"Particle Count\"\n        @description \"Number of particles to spawn\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional class names\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/confetti-effect\" as ConfettiEffectPage -> ConfettiEffectRender\n}\n"
}