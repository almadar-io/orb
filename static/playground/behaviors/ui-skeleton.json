  "source": "",
  "lolo": "app ui-skeleton \"1.0.0\"\n\"Skeleton — UI factory (1:1 with the @almadar/ui skeleton pattern).\"\norbital SkeletonOrbital {\n  entity SkeletonItem [runtime] {\n    id : string!\n  }\n\n  trait SkeletonRender -> @rebindable SkeletonItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          variant: @config.variant\n          rows: @config.rows\n          columns: @config.columns\n          fields: @config.fields\n          className: @config.className\n          type: skeleton\n        })\n    }\n\n    config {\n      variant : \"header\" | \"table\" | \"form\" | \"card\" | \"text\" = text\n        @label \"Variant\"\n        @description \"The skeleton variant to render\"\n        @tier \"presentation\"\n      rows : number = 5\n        @label \"Rows\"\n        @description \"Number of rows for table/text variants\"\n        @tier \"presentation\"\n      columns : number = 4\n        @label \"Columns\"\n        @description \"Number of columns for table variant\"\n        @tier \"presentation\"\n      fields : number = 4\n        @label \"Fields\"\n        @description \"Number of fields for form variant\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/skeleton\" as SkeletonPage -> SkeletonRender\n}\n"
}