  "source": "",
  "lolo": "app ui-draw-shape \"1.0.0\"\n\"DrawShape — UI factory (1:1 with the @almadar/ui draw-shape pattern).\"\norbital DrawShapeOrbital {\n  type DrawShapePosition = {\n    x : number!\n    y : number!\n    z : number\n  }\n  type DrawShapePointsItem = {\n    x : number!\n    y : number!\n  }\n  type DrawShapeGradient = {\n    kind : \"linear\" | \"radial\" | \"conic\"!\n    from : DrawShapeGradientFrom\n    to : DrawShapeGradientTo\n    center : DrawShapeGradientCenter\n    radius : number\n    angle : number\n    stops : [DrawShapeGradientStopsItem]!\n  }\n  type DrawShapeGradientFrom = {\n    x : number!\n    y : number!\n  }\n  type DrawShapeGradientTo = {\n    x : number!\n    y : number!\n  }\n  type DrawShapeGradientCenter = {\n    x : number!\n    y : number!\n  }\n  type DrawShapeGradientStopsItem = {\n    offset : number!\n    color : string!\n  }\n  type DrawShapeFillPattern = {\n    kind : \"noise\" | \"image\"!\n    url : string\n    scale : number\n    alpha : number\n    color : string\n  }\n  type DrawShapeStrokeGradient = {\n    kind : \"linear\" | \"radial\" | \"conic\"!\n    from : DrawShapeStrokeGradientFrom\n    to : DrawShapeStrokeGradientTo\n    center : DrawShapeStrokeGradientCenter\n    radius : number\n    angle : number\n    stops : [DrawShapeStrokeGradientStopsItem]!\n  }\n  type DrawShapeStrokeGradientFrom = {\n    x : number!\n    y : number!\n  }\n  type DrawShapeStrokeGradientTo = {\n    x : number!\n    y : number!\n  }\n  type DrawShapeStrokeGradientCenter = {\n    x : number!\n    y : number!\n  }\n  type DrawShapeStrokeGradientStopsItem = {\n    offset : number!\n    color : string!\n  }\n  type DrawShapePivot = {\n    x : number!\n    y : number!\n  }\n  type DrawShapeShadow = {\n    color : string!\n    blur : number!\n  }\n  type DrawShapeAnimation = {\n    durationMs : number!\n    loop : boolean\n    keyframes : [DrawShapeAnimationKeyframesItem]!\n  }\n  type DrawShapeAnimationKeyframesItem = {\n    at : number!\n    offsetX : number\n    offsetY : number\n    rotate : number\n    opacity : number\n    radiusX : number\n    radiusY : number\n    width : number\n    height : number\n    strokeWidth : number\n    strokeDashOffset : number\n    blur : number\n    fill : string\n    stroke : string\n    shadow : DrawShapeAnimationKeyframesItemShadow\n  }\n  type DrawShapeAnimationKeyframesItemShadow = {\n    color : string!\n    blur : number!\n  }\n\n  entity DrawShapeItem [runtime] {\n    id : string!\n  }\n\n  trait DrawShapeRender -> @rebindable DrawShapeItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          shape: @config.shape\n          position: @config.position\n          anchor: @config.anchor\n          width: @config.width\n          height: @config.height\n          radiusX: @config.radiusX\n          radiusY: @config.radiusY\n          offsetX: @config.offsetX\n          offsetY: @config.offsetY\n          points: @config.points\n          d: @config.d\n          fill: @config.fill\n          gradient: @config.gradient\n          fillPattern: @config.fillPattern\n          stroke: @config.stroke\n          strokeWidth: @config.strokeWidth\n          strokeGradient: @config.strokeGradient\n          strokeDash: @config.strokeDash\n          strokeDashOffset: @config.strokeDashOffset\n          blendMode: @config.blendMode\n          blur: @config.blur\n          rotate: @config.rotate\n          pivot: @config.pivot\n          shadow: @config.shadow\n          animation: @config.animation\n          opacity: @config.opacity\n          type: draw-shape\n        })\n    }\n\n    config {\n      shape : \"cell\" | \"rect\" | \"ellipse\" | \"poly\" | \"path\" = cell\n        @label \"Shape\"\n        @description \"shape prop\"\n        @tier \"presentation\"\n      position : DrawShapePosition = { x: 1, y: 1, z: 1 }\n        @label \"Position\"\n        @description \"Logical scene position; the projector maps it to pixels / world.\"\n        @tier \"presentation\"\n      anchor : \"top-left\" | \"ground\" | \"center\" = \"top-left\"\n        @label \"Anchor\"\n        @description \"How the shape aligns to its projected position. Default varies by `shape`.\"\n        @tier \"presentation\"\n      width : number\n        @label \"Width\"\n        @description \"Rect width in world units (fractions of `projector.tileWidth`).\"\n        @tier \"presentation\"\n      height : number\n        @label \"Height\"\n        @description \"Rect height in world units (fractions of `projector.tileWidth`).\"\n        @tier \"presentation\"\n      radiusX : number\n        @label \"Radius X\"\n        @description \"Ellipse horizontal radius in world units (fractions of `projector.tileWidth`).\"\n        @tier \"presentation\"\n      radiusY : number\n        @label \"Radius Y\"\n        @description \"Ellipse vertical radius in world units; omitted → `radiusX` (a circle).\"\n        @tier \"presentation\"\n      offsetX : number\n        @label \"Offset X\"\n        @description \"Fine nudge in world units — applies to every shape kind except `cell` (rect/ellipse from their anchor point; poly/path from the projected top-left).\"\n        @tier \"presentation\"\n      offsetY : number\n        @label \"Offset Y\"\n        @description \"offsetY prop\"\n        @tier \"presentation\"\n      points : [DrawShapePointsItem] = []\n        @label \"Points\"\n        @description \"Poly vertices as world-unit offsets relative to the cell's projected top-left.\"\n        @tier \"presentation\"\n      d : string\n        @label \"D\"\n        @description \"SVG path data in world units relative to the cell's projected top-left — same coordinate convention as `points`.\"\n        @tier \"presentation\"\n      fill : string\n        @label \"Fill\"\n        @description \"fill prop\"\n        @tier \"presentation\"\n      gradient : DrawShapeGradient\n        @label \"Gradient\"\n        @description \"Gradient fill in world units; overrides `fill` when present.\"\n        @tier \"presentation\"\n      fillPattern : DrawShapeFillPattern\n        @label \"Fill Pattern\"\n        @description \"Repeating texture painted over the fill (grain / tiling image).\"\n        @tier \"presentation\"\n      stroke : string\n        @label \"Stroke\"\n        @description \"stroke prop\"\n        @tier \"presentation\"\n      strokeWidth : number\n        @label \"Stroke Width\"\n        @description \"strokeWidth prop\"\n        @tier \"presentation\"\n      strokeGradient : DrawShapeStrokeGradient\n        @label \"Stroke Gradient\"\n        @description \"Gradient stroke in world units; overrides `stroke` when present.\"\n        @tier \"presentation\"\n      strokeDash : [number] = []\n        @label \"Stroke Dash\"\n        @description \"Dash pattern in painter-px (constant under group scale, like `strokeWidth`).\"\n        @tier \"presentation\"\n      strokeDashOffset : number\n        @label \"Stroke Dash Offset\"\n        @description \"Dash phase offset in painter-px; animatable (marching ants).\"\n        @tier \"presentation\"\n      blendMode : \"source-over\" | \"lighter\" | \"multiply\" | \"screen\" | \"overlay\" | \"darken\" | \"lighten\" | \"color-dodge\" | \"color-burn\" | \"hard-light\" | \"soft-light\" | \"difference\" | \"exclusion\" | \"hue\" | \"saturation\" | \"color\" | \"luminosity\" | \"source-atop\" | \"destination-over\" | \"destination-out\" | \"xor\" = \"source-over\"\n        @label \"Blend Mode\"\n        @description \"Composite/blend mode for this shape's draws (`lighter`, `multiply`, `screen`, …).\"\n        @tier \"presentation\"\n      blur : number\n        @label \"Blur\"\n        @description \"Gaussian blur in painter-px. Expensive — forces an intermediate raster; use sparingly.\"\n        @tier \"presentation\"\n      rotate : number\n        @label \"Rotate\"\n        @description \"Rotation in radians (painter units, same as `draw-group`), about `pivot`.\"\n        @tier \"presentation\"\n      pivot : DrawShapePivot\n        @label \"Pivot\"\n        @description \"Rotation pivot in world units relative to the cell's projected top-left; default `{x:0.5, y:0.5}` (cell center).\"\n        @tier \"presentation\"\n      shadow : DrawShapeShadow\n        @label \"Shadow\"\n        @description \"Soft glow / drop-shadow behind the shape; `blur` in world units.\"\n        @tier \"presentation\"\n      animation : DrawShapeAnimation\n        @label \"Animation\"\n        @description \"Keyframe animation over this shape's props; the host runs a paint clock while present.\"\n        @tier \"presentation\"\n      opacity : number\n        @label \"Opacity\"\n        @description \"0..1 opacity.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/draw-shape\" as DrawShapePage -> DrawShapeRender\n}\n"
}