  "source": "",
  "lolo": "app ui-hero-section \"1.0.0\"\n\"HeroSection — UI factory (1:1 with the @almadar/ui hero-section pattern).\"\norbital HeroSectionOrbital {\n  type HeroSectionPrimaryAction = {\n    label : string!\n    href : string!\n  }\n  type HeroSectionSecondaryAction = {\n    label : string!\n    href : string!\n  }\n  type HeroSectionImage = {\n    src : asset!\n    alt : string!\n  }\n\n  entity HeroSectionItem [runtime] {\n    id : string!\n  }\n\n  trait HeroSectionRender -> @rebindable HeroSectionItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          tag: @config.tag\n          tagVariant: @config.tagVariant\n          title: @config.title\n          titleAccent: @config.titleAccent\n          subtitle: @config.subtitle\n          primaryAction: @config.primaryAction\n          secondaryAction: @config.secondaryAction\n          installCommand: @config.installCommand\n          image: @config.image\n          imagePosition: @config.imagePosition\n          background: @config.background\n          align: @config.align\n          backgroundElement: @config.backgroundElement\n          children: @config.children\n          className: @config.className\n          type: hero-section\n        })\n    }\n\n    config {\n      tag : string\n        @label \"Tag\"\n        @description \"tag prop\"\n        @tier \"presentation\"\n      tagVariant : \"primary\" | \"secondary\" | \"accent\" = primary\n        @label \"Tag Variant\"\n        @description \"tagVariant prop\"\n        @tier \"presentation\"\n      title : string = \"\"\n        @label \"Title\"\n        @description \"title prop\"\n        @tier \"presentation\"\n      titleAccent : string\n        @label \"Title Accent\"\n        @description \"titleAccent prop\"\n        @tier \"presentation\"\n      subtitle : string = \"\"\n        @label \"Subtitle\"\n        @description \"subtitle prop\"\n        @tier \"presentation\"\n      primaryAction : HeroSectionPrimaryAction\n        @label \"Primary Action\"\n        @description \"primaryAction prop\"\n        @tier \"presentation\"\n      secondaryAction : HeroSectionSecondaryAction\n        @label \"Secondary Action\"\n        @description \"secondaryAction prop\"\n        @tier \"presentation\"\n      installCommand : string\n        @label \"Install Command\"\n        @description \"installCommand prop\"\n        @tier \"presentation\"\n      image : HeroSectionImage\n        @label \"Image\"\n        @description \"image prop\"\n        @tier \"presentation\"\n      imagePosition : \"below\" | \"right\" | \"background\" = below\n        @label \"Image Position\"\n        @description \"imagePosition prop\"\n        @tier \"presentation\"\n      background : \"dark\" | \"gradient\" | \"subtle\" = subtle\n        @label \"Background\"\n        @description \"background prop\"\n        @tier \"presentation\"\n      align : \"center\" | \"left\" = center\n        @label \"Align\"\n        @description \"align prop\"\n        @tier \"presentation\"\n      backgroundElement : node\n        @label \"Background Element\"\n        @description \"Background element (SVG animation, etc.) rendered behind hero content\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"children prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/hero-section\" as HeroSectionPage -> HeroSectionRender\n}\n"
}