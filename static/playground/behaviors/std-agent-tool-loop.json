  "source": "",
  "lolo": "app std-agent-tool-loop \"1.0.0\"\n\"Agent tool-loop molecule — call-tools, check response, emit result for iteration.\"\n\ntype LlmToolCall = { id: string!, type: \"function\", function: { name: string!, arguments: string! } }\n;; JSON Schema is recursive (@almadar/core JsonSchema: properties/items/$defs self-reference)\n;; and .lolo has no recursive-JSON type; this deliberately partial shape declares only the\n;; always-scalar top-level keys and leaves the recursive keys undeclared (honest, not checked).\ntype LlmToolSchema = { type: string, description: string }\ntype LlmMessage = { role: string!, content: string!, toolCalls: [LlmToolCall], toolCallId: string }\ntype LlmToolDef = { name: string!, description: string!, schema: LlmToolSchema }\n\norbital AgentToolLoopOrbital {\n\n  entity ToolLoop [runtime] {\n    messages : [LlmMessage] = []\n    tools : [LlmToolDef] = []\n    response : string = \"\"\n    iterations : number = 0\n    status : \"idle\" | \"calling\" | \"done\" = idle\n  }\n\n  trait ToolLoopExecution -> ToolLoop [lifecycle, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.messages [])\n        (set @entity.tools [])\n        (set @entity.response \"\")\n        (set @entity.iterations 0)\n        (set @entity.status idle)\n      EXECUTE -> calling\n        (set @entity.messages ?messages)\n        (set @entity.tools ?tools)\n        (llm/call-tools @entity.messages @entity.tools { emit: { success: TOOLS_CALLED_1, failure: TOOLS_FAILED_1 } })\n    }\n\n    state calling {\n      TOOLS_CALLED_1 -> done\n        (set @entity.response ?result)\n        (set @entity.iterations (+ @entity.iterations 1))\n        (set @entity.status done)\n        (emit LOOP_STEP { response: @entity.response, iteration: @entity.iterations })\n      TOOLS_FAILED_1 -> done\n        (set @entity.response \"\")\n        (set @entity.status done)\n      TOOLS_CALLED_2 -> done\n        (set @entity.response ?result)\n        (set @entity.iterations (+ @entity.iterations 1))\n        (set @entity.status done)\n        (emit LOOP_STEP { response: @entity.response, iteration: @entity.iterations })\n      TOOLS_FAILED_2 -> done\n        (set @entity.response \"\")\n        (set @entity.status done)\n    }\n\n    state done {\n      INIT -> done\n        (set @entity.status done)\n      CONTINUE -> calling\n        (llm/call-tools @entity.messages @entity.tools { emit: { success: TOOLS_CALLED_2, failure: TOOLS_FAILED_2 } })\n      RESET -> idle\n        (set @entity.messages [])\n        (set @entity.tools [])\n        (set @entity.response \"\")\n        (set @entity.iterations 0)\n        (set @entity.status idle)\n    }\n\n    emits {\n      LOOP_STEP {\n        response : string!\n        iteration : number!\n      }\n      TOOLS_CALLED_1 {\n        result : string!\n      }\n      TOOLS_CALLED_2 {\n        result : string!\n      }\n    }\n\n    listens {\n      EXECUTE {\n        messages : [LlmMessage]!\n        tools : [LlmToolDef]!\n      }\n      CONTINUE\n    }\n  }\n\n  trait ToolLoopListener -> ToolLoop [lifecycle, instance] {\n    initial: waiting\n\n    state waiting {\n      INIT -> waiting\n        (set @entity.status idle)\n      LOOP_STEP -> active\n        (set @entity.status done)\n    }\n\n    state active {\n      INIT -> active\n        (set @entity.status done)\n      RESET -> waiting\n        (set @entity.status idle)\n    }\n\n    listens {\n      ToolLoopExecution.LOOP_STEP -> LOOP_STEP\n      RESET\n    }\n  }\n\n  page \"/agent-tool-loop\" as AgentToolLoopPage -> ToolLoopExecution, ToolLoopListener\n}\n"
