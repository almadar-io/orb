  "source": "",
  "lolo": "app ui-doc-sidebar \"1.0.0\"\n\"DocSidebar — UI factory (1:1 with the @almadar/ui doc-sidebar pattern).\"\norbital DocSidebarOrbital {\n  type DocSidebarItemsItem = {\n    label : string!\n    href : string\n    items : [json]\n    active : boolean\n  }\n\n  entity DocSidebarItem [runtime] {\n    id : string!\n  }\n\n  trait DocSidebarRender -> @rebindable DocSidebarItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          items: @config.items\n          className: @config.className\n          type: doc-sidebar\n        })\n    }\n\n    config {\n      items : [DocSidebarItemsItem] = [{ label: \"Label\", href: \"Href\", items: [], active: false }, { label: \"Label 2\", href: \"Href 2\", items: [], active: true }]\n        @label \"Items\"\n        @description \"Sidebar navigation items\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/doc-sidebar\" as DocSidebarPage -> DocSidebarRender\n}\n"
}