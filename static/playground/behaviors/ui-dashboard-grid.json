  "source": "",
  "lolo": "app ui-dashboard-grid \"1.0.0\"\n\"DashboardGrid — UI factory (1:1 with the @almadar/ui dashboard-grid pattern).\"\norbital DashboardGridOrbital {\n  type DashboardGridError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n  type DashboardGridCellsItem = {\n    id : string\n    content : node\n    colSpan : number\n    rowSpan : number\n  }\n\n  entity DashboardGridItem [runtime] {\n    id : string!\n  }\n\n  trait DashboardGridRender -> @rebindable DashboardGridItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          sortBy: @config.sortBy\n          sortDirection: @config.sortDirection\n          searchValue: @config.searchValue\n          page: @config.pageProp\n          pageSize: @config.pageSize\n          totalCount: @config.totalCount\n          activeFilters: @config.activeFilters\n          selectedIds: @config.selectedIds\n          columns: @config.columns\n          gap: @config.gap\n          cells: @config.cells\n          type: dashboard-grid\n        })\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : DashboardGridError\n        @label \"Error\"\n        @description \"Error state (UiError)\"\n        @tier \"presentation\"\n      sortBy : string\n        @label \"Sort By\"\n        @description \"Current sort field\"\n        @tier \"presentation\"\n      sortDirection : \"asc\" | \"desc\" = asc\n        @label \"Sort Direction\"\n        @description \"Current sort direction\"\n        @tier \"presentation\"\n      searchValue : string\n        @label \"Search Value\"\n        @description \"Current search query value\"\n        @tier \"presentation\"\n      pageProp : number\n        @label \"Page\"\n        @description \"Current page number\"\n        @synonyms \"page\"\n        @tier \"presentation\"\n      pageSize : number\n        @label \"Page Size\"\n        @description \"Number of items per page\"\n        @tier \"presentation\"\n      totalCount : number\n        @label \"Total Count\"\n        @description \"Total number of items\"\n        @tier \"presentation\"\n      activeFilters : Map string string = {}\n        @label \"Active Filters\"\n        @description \"Active filters\"\n        @tier \"presentation\"\n      selectedIds : [string] = []\n        @label \"Selected Ids\"\n        @description \"Currently selected item IDs\"\n        @tier \"presentation\"\n      columns : number = 3\n        @label \"Columns\"\n        @description \"Number of columns\"\n        @tier \"presentation\"\n      gap : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Gap\"\n        @description \"Gap between cells\"\n        @tier \"presentation\"\n      cells : [DashboardGridCellsItem] = [{ id: \"Id\", content: \"Content\", colSpan: 1, rowSpan: 1 }, { id: \"Id 2\", content: \"Content 2\", colSpan: 2, rowSpan: 2 }]\n        @label \"Cells\"\n        @description \"Cell definitions\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/dashboard-grid\" as DashboardGridPage -> DashboardGridRender\n}\n"
}