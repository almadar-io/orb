{
  "name": "std-math-vectors",
  "description": "Vector addition engine — B oscillates via a triangle wave, animates the tip-to-tail A+B resultant on math-canvas.",
  "level": "atom",
  "topic": "ui/learning",
  "schema": {
    "name": "std-math-vectors",
    "version": "1.0.0",
    "description": "Vector addition engine — B oscillates via a triangle wave, animates the tip-to-tail A+B resultant on math-canvas.",
    "orbitals": [
      {
        "name": "MathVectorsEngineOrbital",
        "entity": {
          "name": "MathVectorsState",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "phase",
              "type": "number",
              "default": 0
            },
            {
              "name": "vectors",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
                  "vx": {
                    "name": "vx",
                    "type": "number",
                    "required": true
                  },
                  "x": {
                    "name": "x",
                    "type": "number",
                    "required": true
                  },
                  "vy": {
                    "name": "vy",
                    "type": "number",
                    "required": true
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "y": {
                    "name": "y",
                    "type": "number",
                    "required": true
                  }
                }
              }
            },
            {
              "name": "running",
              "type": "boolean",
              "default": false
            }
          ]
        },
        "traits": [
          {
            "name": "MathVectorsSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "phase",
                "running",
                "vectors"
              ]
            },
            "category": "interaction",
            "linkedEntity": "MathVectorsState",
            "emits": [
              {
                "event": "VECTORS_UPDATED",
                "description": "The current vector scene each tick — a composed listener (readout, graph) can subscribe; a harmless no-op when the atom runs standalone.",
                "synonyms": "tick, frame, step, redraw",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "vectors",
                    "type": "[MathVector]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "VECTORS_UPDATED",
                  "name": "Vectors Updated",
                  "description": "The current vector scene each tick — a composed listener (readout, graph) can subscribe; a harmless no-op when the atom runs standalone.",
                  "synonyms": "tick, frame, step, redraw",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "vectors",
                      "type": "[MathVector]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.phase",
                      0
                    ],
                    [
                      "set",
                      "@entity.vectors",
                      [
                        {
                          "vx": 4,
                          "color": "#2563eb",
                          "x": 0,
                          "y": 0,
                          "label": "A",
                          "vy": 3
                        },
                        {
                          "y": 3,
                          "vx": 3,
                          "x": 4,
                          "color": "#16a34a",
                          "label": "B",
                          "vy": 2
                        },
                        {
                          "color": "#dc2626",
                          "vy": 5,
                          "y": 0,
                          "vx": 7,
                          "label": "A+B",
                          "x": 0
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "width": 600,
                        "height": 400,
                        "type": "math-canvas",
                        "vectors": "@entity.vectors"
                      }
                    ],
                    [
                      "emit",
                      "VECTORS_UPDATED",
                      {
                        "vectors": "@entity.vectors"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "vectorTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "let",
                    [
                      [
                        "nphase",
                        [
                          "+",
                          "@entity.phase",
                          4
                        ]
                      ]
                    ],
                    [
                      "let",
                      [
                        [
                          "tw",
                          [
                            "math/abs",
                            [
                              "-",
                              [
                                "math/mod",
                                "@nphase",
                                200
                              ],
                              100
                            ]
                          ]
                        ]
                      ],
                      [
                        "let",
                        [
                          [
                            "bx",
                            [
                              "+",
                              1,
                              [
                                "*",
                                "@tw",
                                0.04
                              ]
                            ]
                          ]
                        ],
                        [
                          "let",
                          [
                            [
                              "vecA",
                              {
                                "vy": 3,
                                "x": 0,
                                "color": "#2563eb",
                                "y": 0,
                                "label": "A",
                                "vx": 4
                              }
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "vecB",
                                {
                                  "vy": 2,
                                  "label": "B",
                                  "vx": "@bx",
                                  "x": 4,
                                  "color": "#16a34a",
                                  "y": 3
                                }
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "vecSum",
                                  {
                                    "color": "#dc2626",
                                    "vx": [
                                      "+",
                                      4,
                                      "@bx"
                                    ],
                                    "vy": 5,
                                    "label": "A+B",
                                    "x": 0,
                                    "y": 0
                                  }
                                ]
                              ],
                              [
                                "do",
                                [
                                  "set",
                                  "@entity.phase",
                                  "@nphase"
                                ],
                                [
                                  "set",
                                  "@entity.vectors",
                                  [
                                    "@vecA",
                                    "@vecB",
                                    "@vecSum"
                                  ]
                                ],
                                [
                                  "render-ui",
                                  "main",
                                  {
                                    "width": 600,
                                    "type": "math-canvas",
                                    "vectors": "@entity.vectors",
                                    "height": 400
                                  }
                                ],
                                [
                                  "emit",
                                  "VECTORS_UPDATED",
                                  {
                                    "vectors": "@entity.vectors"
                                  }
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              }
            ],
            "config": {
              "vectors": {
                "type": "[MathVector]",
                "default": [
                  {
                    "vx": 4,
                    "color": "#2563eb",
                    "x": 0,
                    "y": 0,
                    "label": "A",
                    "vy": 3
                  },
                  {
                    "y": 3,
                    "vx": 3,
                    "x": 4,
                    "color": "#16a34a",
                    "label": "B",
                    "vy": 2
                  },
                  {
                    "color": "#dc2626",
                    "vy": 5,
                    "y": 0,
                    "vx": 7,
                    "label": "A+B",
                    "x": 0
                  }
                ],
                "label": "Vectors",
                "description": "Initial vector scene in data coordinates; A is fixed, B oscillates, A+B is the tip-to-tail resultant.",
                "tier": "domain",
                "items": {
                  "type": "object",
                  "properties": {
                    "vx": {
                      "name": "vx",
                      "type": "number",
                      "required": true
                    },
                    "color": {
                      "name": "color",
                      "type": "string",
                      "required": false
                    },
                    "x": {
                      "name": "x",
                      "type": "number",
                      "required": true
                    },
                    "vy": {
                      "name": "vy",
                      "type": "number",
                      "required": true
                    },
                    "y": {
                      "name": "y",
                      "type": "number",
                      "required": true
                    },
                    "label": {
                      "name": "label",
                      "type": "string",
                      "required": false
                    }
                  }
                }
              },
              "running": {
                "type": "boolean",
                "default": true,
                "label": "Running",
                "description": "When true the tick animates B's oscillation and updates the resultant; toggle to start/pause.",
                "tier": "domain"
              },
              "height": {
                "type": "number",
                "default": 400,
                "label": "Height",
                "description": "Canvas height in pixels.",
                "tier": "presentation"
              },
              "width": {
                "type": "number",
                "default": 600,
                "label": "Width",
                "description": "Canvas width in pixels.",
                "tier": "presentation"
              }
            },
            "scope": "instance"
          }
        ],
        "pages": [
          {
            "name": "MathVectorsEnginePage",
            "path": "/math-vectors",
            "traits": [
              {
                "ref": "MathVectorsSim"
              }
            ]
          }
        ]
      }
    ],
    "_metadata": {
      "configProvenance": {
        "MathVectorsEngineOrbital": [
          {
            "trait": "MathVectorsSim",
            "patternPath": "root",
            "prop": "width",
            "knob": "width"
          },
          {
            "trait": "MathVectorsSim",
            "patternPath": "root",
            "prop": "height",
            "knob": "height"
          }
        ]
      }
    }
  },
  "source": "",
  "lolo": ""
}