  "source": "",
  "lolo": "app ui-date-range-selector \"1.0.0\"\n\"DateRangeSelector — UI factory (1:1 with the @almadar/ui date-range-selector pattern).\"\norbital DateRangeSelectorOrbital {\n  type DateRangeSelectorOptionsItem = {\n    label : string!\n    value : string!\n  }\n\n  entity DateRangeSelectorItem [runtime] {\n    id : string!\n  }\n\n  trait DateRangeSelectorRender -> @rebindable DateRangeSelectorItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          options: @config.options\n          selected: @config.selected\n          onSelect: @config.onSelect\n          className: @config.className\n          type: date-range-selector\n        })\n    }\n\n    emits {\n      @config.onSelect -> external {\n        value : string\n      }\n        @description \"Callback when a range is selected\"\n        @tier \"essential\"\n    }\n\n    config {\n      options : [DateRangeSelectorOptionsItem] = []\n        @label \"Options\"\n        @description \"Available range options\"\n        @tier \"presentation\"\n      selected : string = month\n        @label \"Selected\"\n        @description \"Currently selected value\"\n        @tier \"presentation\"\n      onSelect : event = \"SELECT\"\n        @label \"On Select\"\n        @description \"Callback when a range is selected\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/date-range-selector\" as DateRangeSelectorPage -> DateRangeSelectorRender\n}\n"
