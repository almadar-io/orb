  "lolo": "app ui-behavior-view \"1.0.0\"\n\"BehaviorView — UI factory (1:1 with the @almadar/ui behavior-view pattern).\"\norbital BehaviorViewOrbital {\n  entity BehaviorViewItem [runtime] {\n    id : string!\n  }\n\n  trait BehaviorViewRender -> @rebindable BehaviorViewItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          data: @config.data\n          type: behavior-view\n        })\n    }\n\n    config {\n      data : object = {}\n        @label \"Data\"\n        @description \"data prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/behavior-view\" as BehaviorViewPage -> BehaviorViewRender\n}\n"
