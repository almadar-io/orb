  "source": "",
  "lolo": "app ui-behavior-view \"1.0.0\"\n\"BehaviorView — UI factory (1:1 with the @almadar/ui behavior-view pattern).\"\norbital BehaviorViewOrbital {\n  type BehaviorViewData = {\n    orbitalName : string!\n    entityName : string!\n    persistence : string!\n    fields : [BehaviorViewDataFieldsItem]!\n    traits : [BehaviorViewDataTraitsItem]!\n    pages : [BehaviorViewDataPagesItem]!\n    traitDetails : Map string BehaviorViewDataTraitDetailsValue!\n    externalLinks : [BehaviorViewDataExternalLinksItem]!\n  }\n  type BehaviorViewDataFieldsItem = {\n    name : string!\n    type : string!\n    required : boolean!\n    hasDefault : boolean!\n  }\n  type BehaviorViewDataTraitsItem = {\n    name : string!\n    stateCount : number!\n    eventCount : number!\n    transitionCount : number!\n    emits : [string]!\n    listens : [string]!\n  }\n  type BehaviorViewDataPagesItem = {\n    name : string!\n    route : string!\n  }\n  type BehaviorViewDataTraitDetailsValue = {\n    name : string!\n    linkedEntity : string!\n    states : [BehaviorViewDataTraitDetailsValueStatesItem]!\n    transitions : [BehaviorViewDataTraitDetailsValueTransitionsItem]!\n    emittedEvents : [string]!\n    listenedEvents : [string]!\n  }\n  type BehaviorViewDataTraitDetailsValueStatesItem = {\n    name : string!\n    isInitial : boolean!\n    isTerminal : boolean!\n  }\n  type BehaviorViewDataTraitDetailsValueTransitionsItem = {\n    from : string!\n    to : string!\n    event : string!\n    guard : opaque!\n    effects : [BehaviorViewDataTraitDetailsValueTransitionsItemEffectsItem]!\n    index : number!\n  }\n  type BehaviorViewDataTraitDetailsValueTransitionsItemEffectsItem = {\n    type : string!\n    args : [opaque]!\n  }\n  type BehaviorViewDataExternalLinksItem = {\n    targetOrbital : string!\n    eventName : string!\n    direction : string!\n    traitName : string!\n  }\n\n  entity BehaviorViewItem [runtime] {\n    id : string!\n  }\n\n  trait BehaviorViewRender -> @rebindable BehaviorViewItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          data: @config.data\n          type: behavior-view\n        })\n    }\n\n    config {\n      data : BehaviorViewData = { orbitalName: \"Orbital Name\", entityName: \"Entity Name\", persistence: \"Persistence\", fields: [{ name: \"Name\", type: \"Type\", required: false, hasDefault: false }, { name: \"Name 2\", type: \"Type 2\", required: true, hasDefault: true }], traits: [{ name: \"Name\", stateCount: 1, eventCount: 1, transitionCount: 1, emits: [\"Item\", \"Item 2\"], listens: [\"Item\", \"Item 2\"] }, { name: \"Name 2\", stateCount: 2, eventCount: 2, transitionCount: 2, emits: [\"Item\", \"Item 2\"], listens: [\"Item\", \"Item 2\"] }], pages: [{ name: \"Name\", route: \"Route\" }, { name: \"Name 2\", route: \"Route 2\" }], traitDetails: {}, externalLinks: [{ targetOrbital: \"Target Orbital\", eventName: \"Event Name\", direction: \"Direction\", traitName: \"Trait Name\" }, { targetOrbital: \"Target Orbital 2\", eventName: \"Event Name 2\", direction: \"Direction 2\", traitName: \"Trait Name 2\" }] }\n        @label \"Data\"\n        @description \"data prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/behavior-view\" as BehaviorViewPage -> BehaviorViewRender\n}\n"
