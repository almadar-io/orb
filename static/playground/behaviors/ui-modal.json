  "source": "",
  "lolo": "app ui-modal \"1.0.0\"\n\"Modal — UI factory (1:1 with the @almadar/ui modal pattern).\"\norbital ModalOrbital {\n  entity ModalItem [runtime] {\n    id : string!\n  }\n\n  trait ModalRender -> @rebindable ModalItem [interaction, instance] {\n    initial: closed\n\n    state closed {\n      INIT -> closed\n        (render-ui main {\n          label: \"Open Modal\"\n          action: OPEN\n          type: button\n        })\n      OPEN -> open\n        (render-ui modal {\n          isOpen: @config.isOpen\n          onClose: @config.onClose\n          onExited: @config.onExited\n          title: @config.title\n          children: @config.children\n          footer: @config.footer\n          size: @config.size\n          showCloseButton: @config.showCloseButton\n          closeOnOverlayClick: @config.closeOnOverlayClick\n          closeOnEscape: @config.closeOnEscape\n          className: @config.className\n          closeEvent: @config.closeEvent\n          swipeDownToClose: @config.swipeDownToClose\n          look: @config.look\n          type: modal\n        })\n    }\n\n    state open {\n      CLOSE -> closed\n        (render-ui modal null)\n        (render-ui main {\n          label: \"Open Modal\"\n          action: OPEN\n          type: button\n        })\n    }\n\n    emits {\n      @config.onClose -> external { }\n        @description \"Callback when modal should close (injected by slot wrapper)\"\n        @tier \"essential\"\n      @config.onExited -> external { }\n        @description \"Fires after the exit animation completes (the modal is about to unmount).\"\n        @tier \"essential\"\n      OPEN -> external {\n        id : string\n      }\n        @description \"Open the Modal.\"\n        @tier \"essential\"\n    }\n\n    config {\n      isOpen : boolean = true\n        @label \"Is Open\"\n        @description \"Whether the modal is open (defaults to true when rendered by slot wrapper)\"\n        @tier \"presentation\"\n      onClose : event = \"CLOSE\"\n        @label \"On Close\"\n        @description \"Callback when modal should close (injected by slot wrapper)\"\n        @tier \"presentation\"\n      onExited : event = \"EXITED\"\n        @label \"On Exited\"\n        @description \"Fires after the exit animation completes (the modal is about to unmount).\"\n        @tier \"presentation\"\n      title : string\n        @label \"Title\"\n        @description \"title prop\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"Modal content (can be empty if using slot content)\"\n        @tier \"presentation\"\n      footer : node\n        @label \"Footer\"\n        @description \"footer prop\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" | \"xl\" | \"full\" = md\n        @label \"Size\"\n        @description \"size prop\"\n        @tier \"presentation\"\n      showCloseButton : boolean = true\n        @label \"Show Close Button\"\n        @description \"showCloseButton prop\"\n        @tier \"presentation\"\n      closeOnOverlayClick : boolean = true\n        @label \"Close On Overlay Click\"\n        @description \"closeOnOverlayClick prop\"\n        @tier \"presentation\"\n      closeOnEscape : boolean = true\n        @label \"Close On Escape\"\n        @description \"closeOnEscape prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      closeEvent : event = \"CLOSE\"\n        @label \"Close Event\"\n        @description \"Declarative close event — emits UI:{closeEvent} via eventBus when modal should close\"\n        @tier \"presentation\"\n      swipeDownToClose : boolean = true\n        @label \"Swipe Down To Close\"\n        @description \"Enable swipe-down-to-close on mobile bottom sheet (default: true)\"\n        @tier \"presentation\"\n      look : \"centered-card\" | \"top-sheet\" | \"side-drawer\" | \"full-screen\" = \"centered-card\"\n        @label \"Look\"\n        @description \"Layer 2 visual treatment — orthogonal to the semantic variant.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/modal\" as ModalPage -> ModalRender\n}\n"
}