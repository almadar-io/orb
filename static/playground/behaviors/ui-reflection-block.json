  "source": "",
  "lolo": "app ui-reflection-block \"1.0.0\"\n\"ReflectionBlock — UI factory (1:1 with the @almadar/ui reflection-block pattern).\"\norbital ReflectionBlockOrbital {\n  entity ReflectionBlockItem [runtime] {\n    id : string!\n  }\n\n  trait ReflectionBlockRender -> @rebindable ReflectionBlockItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          prompt: @config.prompt\n          index: @config.index\n          savedNote: @config.savedNote\n          saveEvent: @config.saveEvent\n          className: @config.className\n          type: reflection-block\n        })\n    }\n\n    config {\n      prompt : string = \"\"\n        @label \"Prompt\"\n        @description \"The reflection prompt\"\n        @tier \"presentation\"\n      index : number = 1\n        @label \"Index\"\n        @description \"Zero-based index of this block (used in the emitted event payload)\"\n        @tier \"presentation\"\n      savedNote : string\n        @label \"Saved Note\"\n        @description \"Pre-filled note from saved state\"\n        @tier \"presentation\"\n      saveEvent : string = \"SAVE_REFLECTION\"\n        @label \"Save Event\"\n        @description \"Event name emitted on save (as `UI:<saveEvent>`). Defaults to 'SAVE_REFLECTION'.\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/reflection-block\" as ReflectionBlockPage -> ReflectionBlockRender\n}\n"
}