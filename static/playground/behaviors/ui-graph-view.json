  "source": "",
  "lolo": "app ui-graph-view \"1.0.0\"\n\"GraphView — UI factory (1:1 with the @almadar/ui graph-view pattern).\"\norbital GraphViewOrbital {\n  type GraphViewNodesItem = {\n    id : string!\n    label : string\n    color : string\n    size : number\n    group : string\n  }\n  type GraphViewEdgesItem = {\n    source : string!\n    target : string!\n    color : string\n    label : string\n  }\n  type GraphViewNODECLICKNode = {\n    id : string!\n    label : string\n    color : string\n    size : number\n    group : string\n  }\n  type GraphViewNODEHOVERNode = {\n    id : string!\n    label : string\n    color : string\n    size : number\n    group : string\n  }\n\n  entity GraphViewItem [runtime] {\n    id : string!\n  }\n\n  trait GraphViewRender -> @rebindable GraphViewItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          nodes: @config.nodes\n          edges: @config.edges\n          onNodeClick: @config.onNodeClick\n          onNodeHover: @config.onNodeHover\n          width: @config.width\n          height: @config.height\n          className: @config.className\n          showLabels: @config.showLabels\n          zoomToFit: @config.zoomToFit\n          layout: @config.layout\n          type: graph-view\n        })\n    }\n\n    emits {\n      @config.onNodeClick -> external {\n        node : GraphViewNODECLICKNode\n      }\n        @description \"Callback when a node is clicked\"\n        @tier \"essential\"\n      @config.onNodeHover -> external {\n        node : GraphViewNODEHOVERNode\n      }\n        @description \"Callback when a node is hovered (null on leave)\"\n        @tier \"essential\"\n    }\n\n    config {\n      nodes : [GraphViewNodesItem] = [{ id: \"Id\", label: \"Label\", color: \"Color\", size: 1, group: \"Group\" }, { id: \"Id 2\", label: \"Label 2\", color: \"Color 2\", size: 2, group: \"Group 2\" }]\n        @label \"Nodes\"\n        @description \"Graph nodes\"\n        @tier \"presentation\"\n      edges : [GraphViewEdgesItem] = [{ source: \"Source\", target: \"Target\", color: \"Color\", label: \"Label\" }, { source: \"Source 2\", target: \"Target 2\", color: \"Color 2\", label: \"Label 2\" }]\n        @label \"Edges\"\n        @description \"Graph edges\"\n        @tier \"presentation\"\n      onNodeClick : event = \"NODE_CLICK\"\n        @label \"On Node Click\"\n        @description \"Callback when a node is clicked\"\n        @tier \"presentation\"\n      onNodeHover : event = \"NODE_HOVER\"\n        @label \"On Node Hover\"\n        @description \"Callback when a node is hovered (null on leave)\"\n        @tier \"presentation\"\n      width : number\n        @label \"Width\"\n        @description \"Width in pixels\"\n        @tier \"presentation\"\n      height : number\n        @label \"Height\"\n        @description \"Height in pixels\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      showLabels : boolean = true\n        @label \"Show Labels\"\n        @description \"Show node labels (default true)\"\n        @tier \"presentation\"\n      zoomToFit : boolean = true\n        @label \"Zoom To Fit\"\n        @description \"Auto zoom-to-fit after layout settles (default true)\"\n        @tier \"presentation\"\n      layout : \"force\" | \"flow\" | \"tree\" | \"radial\" = force\n        @label \"Layout\"\n        @description \"Layout mode. force = physics simulation (default); flow = layered left-to-right process flow; tree = top-down hierarchy tiers from the roots; radial = concentric rings by depth (a pure cycle renders as a single ring). Non-force layouts are deterministic.\"\n        @synonyms \"layout mode, flow layout, tree layout, radial layout, hierarchy layout\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/graph-view\" as GraphViewPage -> GraphViewRender\n}\n"
}