  "source": "",
  "lolo": "app ui-timer-display \"1.0.0\"\n\"TimerDisplay — counts down every second while running; re-renders on each tick.\"\norbital TimerDisplayOrbital {\n  type TimerDisplayIconAsset = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n\n  entity TimerDisplayItem [runtime] {\n    id      : string!\n    seconds : number = 90\n    running : boolean = true\n  }\n\n  trait TimerDisplayRender -> @rebindable TimerDisplayItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (set @entity.seconds @config.seconds)\n        (set @entity.running @config.running)\n        (render-ui main {\n          seconds: @entity.seconds\n          running: @entity.running\n          format: @config.format\n          size: @config.size\n          className: @config.className\n          lowThreshold: @config.lowThreshold\n          iconAsset: @config.iconAsset\n          type: timer-display\n        })\n    }\n\n    ticks {\n      timerTick every 1s\n        when (and (== @entity.running true) (> @entity.seconds 0))\n        (set @entity.seconds (- @entity.seconds 1))\n        (render-ui main {\n          seconds: @entity.seconds\n          running: @entity.running\n          format: @config.format\n          size: @config.size\n          className: @config.className\n          lowThreshold: @config.lowThreshold\n          iconAsset: @config.iconAsset\n          type: timer-display\n        })\n    }\n\n    config {\n      seconds : number = 90\n        @label \"Seconds\"\n        @description \"Time in seconds\"\n        @tier \"presentation\"\n      running : boolean = true\n        @label \"Running\"\n        @description \"Whether the timer is running\"\n        @tier \"presentation\"\n      format : \"mm:ss\" | \"ss\" | \"countdown\" = \"mm:ss\"\n        @label \"Format\"\n        @description \"Display format\"\n        @tier \"presentation\"\n      size : \"sm\" | \"md\" | \"lg\" = md\n        @label \"Size\"\n        @description \"Size variant\"\n        @tier \"presentation\"\n      className : string = \"\"\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      lowThreshold : number = 0\n        @label \"Low Threshold\"\n        @description \"Seconds below which to pulse red\"\n        @tier \"presentation\"\n      iconAsset : TimerDisplayIconAsset\n        @label \"Icon Asset\"\n        @description \"Icon asset rendered to the left of the time value. Falls back to no icon.\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/timer-display\" as TimerDisplayPage -> TimerDisplayRender\n}\n"
}