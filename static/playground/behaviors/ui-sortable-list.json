  "source": "",
  "lolo": "app ui-sortable-list \"1.0.0\"\n\"SortableList — a drag-and-drop reorderable list of items. — UI factory (1:1 with the @almadar/ui sortable-list pattern).\"\n;; @capabilities \"checklist, task list, to-do list, priority list, ranked list, drag-to-reorder queue\"\norbital SortableListOrbital {\n    type SortableListLoaded = Event { data : [SortableListItem] } \"SortableList rows finished loading; payload.data holds the collection\"\n\n  entity SortableListItem [runtime] {\n    id : string!\n  }\n\n  trait SortableListRender -> @rebindable SortableListItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle when @config.selfFetch\n        (fetch SortableListItem { emit: { success: SortableListLoaded } })\n        (render-ui main {\n          items: @entity\n          renderItem: (fn item { content: (object/get @item @config.itemLabelField \"\"), type: typography })\n          reorderEvent: @config.reorderEvent\n          reorderPayload: @config.reorderPayload\n          dragHandlePosition: @config.dragHandlePosition\n          className: @config.className\n          type: sortable-list\n        })\n      INIT -> idle when (not @config.selfFetch)\n        (render-ui main {\n          items: @entity\n          renderItem: (fn item { content: (object/get @item @config.itemLabelField \"\"), type: typography })\n          reorderEvent: @config.reorderEvent\n          reorderPayload: @config.reorderPayload\n          dragHandlePosition: @config.dragHandlePosition\n          className: @config.className\n          type: sortable-list\n        })\n      SortableListLoaded -> idle\n        (render-ui main {\n          items: @payload.data\n          renderItem: (fn item { content: (object/get @item @config.itemLabelField \"\"), type: typography })\n          reorderEvent: @config.reorderEvent\n          reorderPayload: @config.reorderPayload\n          dragHandlePosition: @config.dragHandlePosition\n          className: @config.className\n          type: sortable-list\n        })\n    }\n\n    emits {\n      @config.reorderEvent -> external {\n        fromIndex : number!\n        toIndex : number!\n        item : @entity!\n      }\n        @description \"reorderEvent prop\"\n        @tier \"essential\"\n      SortableListLoaded\n        @description \"SortableList rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      itemLabelField : string = \"id\"\n        @label \"Item label field\"\n        @description \"Row field rendered as each item's label (defaults to id).\"\n        @tier \"presentation\"\n      reorderEvent : event = \"REORDER\"\n        @label \"Reorder Event\"\n        @description \"reorderEvent prop\"\n        @tier \"presentation\"\n      reorderPayload : @payload @config.reorderEvent\n        @label \"Reorder Payload\"\n        @description \"reorderPayload prop\"\n        @tier \"presentation\"\n      dragHandlePosition : \"left\" | \"right\" = left\n        @label \"Drag Handle Position\"\n        @description \"dragHandlePosition prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      selfFetch : boolean = true\n        @label \"Fetch its own rows on mount?\"\n        @description \"true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/sortable-list\" as SortableListPage -> SortableListRender\n}\n"
}