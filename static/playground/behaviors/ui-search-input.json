  "source": "",
  "lolo": "app ui-search-input \"1.0.0\"\n\"SearchInput — UI factory (1:1 with the @almadar/ui search-input pattern).\"\norbital SearchInputOrbital {\n  entity SearchInputItem [runtime] {\n    id : string!\n    value : string @intrinsic\n  }\n\n  trait SearchInputRender -> @rebindable SearchInputItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (fetch SearchInputItem {})\n        (set @entity.value @config.value)\n        (render-ui main {\n          value: @entity.value\n          onSearch: @config.onSearch\n          debounceMs: @config.debounceMs\n          isLoading: @config.isLoading\n          placeholder: @config.placeholder\n          clearable: @config.clearable\n          className: @config.className\n          event: @config.event\n          entity: SearchInputItem\n          query: @config.query\n          type: search-input\n        })\n      SEARCH -> idle\n        (set @entity.value ?value)\n        (render-ui main {\n          value: @entity.value\n          onSearch: @config.onSearch\n          debounceMs: @config.debounceMs\n          isLoading: @config.isLoading\n          placeholder: @config.placeholder\n          clearable: @config.clearable\n          className: @config.className\n          event: @config.event\n          entity: SearchInputItem\n          query: @config.query\n          type: search-input\n        })\n    }\n\n    emits {\n      @config.onSearch -> external {\n        value : string\n      }\n        @description \"Callback when search value changes\"\n        @tier \"essential\"\n      @config.event -> external {\n        searchTerm : string!\n        entity : string\n      }\n        @description \"Declarative search event — emits UI:{event} via eventBus on query submit (alongside canonical UI:SEARCH)\"\n        @tier \"essential\"\n    }\n\n    listens {\n      SEARCH {\n        value : string\n      }\n    }\n\n    config {\n      value : string\n        @label \"Value\"\n        @description \"Search value (controlled mode)\"\n        @tier \"presentation\"\n      onSearch : event = \"SEARCH\"\n        @label \"On Search\"\n        @description \"Callback when search value changes\"\n        @tier \"presentation\"\n      debounceMs : number = 300\n        @label \"Debounce Ms\"\n        @description \"Debounce delay in milliseconds\"\n        @tier \"presentation\"\n      isLoading : boolean = false\n        @label \"Is Loading\"\n        @description \"Show loading state\"\n        @tier \"presentation\"\n      placeholder : string\n        @label \"Placeholder\"\n        @description \"Placeholder text\"\n        @tier \"presentation\"\n      clearable : boolean = true\n        @label \"Clearable\"\n        @description \"Show clear button\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      event : event = \"EVENT\"\n        @label \"Event\"\n        @description \"Declarative search event — emits UI:{event} via eventBus on query submit (alongside canonical UI:SEARCH)\"\n        @tier \"presentation\"\n      query : string\n        @label \"Query\"\n        @description \"Query singleton binding for state management. When provided, syncs search state with the query singleton. Example: '@TaskQuery'\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/search-input\" as SearchInputPage -> SearchInputRender\n}\n"
}