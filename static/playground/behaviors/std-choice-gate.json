  "source": "",
  "lolo": "app std-choice-gate \"1.0.0\"\n\"Headless choice-gate mechanic for side-view boards: a gate of N labeled option platforms where progress stops until the player commits to an answer. Listens BODY_MOVED and judges a gate when the player stands grounded on one of its option platforms (|dx| <= reachX of the option center, |dy| <= reachY of the gate's option plane — the pad-lock touch pattern): the correct option stamps the gate solved + chosen on the shared entity and emits CHOICE_CORRECT once (a solved gate never judges again, so the path stays open); a wrong option emits CHOICE_WRONG carrying the gate id, the chosen optionId, and the option's world position, so the board can bounce the player back and float the gate's hint (the board owns the bounce — the atom only reports). RESTART unsolves every gate. Renders nothing; boards draw the option platforms and labels from the shared entity (the render authority).\"\norbital ChoiceGateOrbital {\n  type ChoiceOption = {\n    id : string!\n    dx : number!\n    label : string!\n    correct : boolean!\n  }\n  type ChoiceGate = {\n    id : string!\n    x : number!\n    y : number!\n    hint : string\n    options : [ChoiceOption]!\n    solved : boolean\n    chosen : string\n  }\n\n  entity ChoiceGateData [runtime, shared] {\n    id : string!\n    choices : [ChoiceGate] = []\n  }\n\n  trait ChoiceGate -> @rebindable ChoiceGateData [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.choices (array/map @config.gates (fn g (object/merge @g { solved: false, chosen: \"\" }))))\n\n      BODY_MOVED -> active when @config.running\n        (let ((touch (array/filter @entity.choices (fn g\n          (and (== (object/get @g solved) false)\n            (> (array/len (array/filter (object/get @g options) (fn o\n              (and (== @payload.grounded true)\n                (and (<= (math/abs (- @payload.x (+ (object/get @g x) (object/get @o dx)))) @config.reachX)\n                  (<= (math/abs (- @payload.y (object/get @g y))) @config.reachY)))))) 0))))))\n        (if (> (array/len @touch) 0)\n          (let ((g (array/first @touch)))\n          (let ((o (array/first (array/filter (object/get @g options) (fn oo\n            (and (== @payload.grounded true)\n              (and (<= (math/abs (- @payload.x (+ (object/get @g x) (object/get @oo dx)))) @config.reachX)\n                (<= (math/abs (- @payload.y (object/get @g y))) @config.reachY))))))))\n          (if (== (object/get @o correct) true)\n            (do\n              (set @entity.choices (array/map @entity.choices (fn c (if (== (object/get @c id) (object/get @g id)) (object/merge @c { solved: true, chosen: (object/get @o id) }) @c))))\n              (emit CHOICE_CORRECT { id: (object/get @g id), x: (object/get @g x), y: (object/get @g y) }))\n            (emit CHOICE_WRONG { id: (object/get @g id), optionId: (object/get @o id), x: (+ (object/get @g x) (object/get @o dx)), y: (object/get @g y) }))))\n          null))\n\n      RESTART -> active\n        (set @entity.choices (array/map @config.gates (fn g (object/merge @g { solved: false, chosen: \"\" }))))\n    }\n\n    emits {\n      CHOICE_CORRECT -> external {\n        id : string!\n        x : number!\n        y : number!\n      }\n        @description \"The player landed grounded on the gate's correct option; fires once per gate (solved gates stop judging). Carries the gate center so boards can burst the unlock there.\"\n        @tier \"domain\"\n      CHOICE_WRONG -> external {\n        id : string!\n        optionId : string!\n        x : number!\n        y : number!\n      }\n        @description \"The player landed grounded on a wrong option; carries the gate id, the chosen optionId, and the option's world position so boards can bounce the player back to the approach and float the gate's hint.\"\n        @tier \"domain\"\n    }\n\n    listens {\n      BODY_MOVED { x : number!, y : number!, vx : number!, vy : number!, grounded : boolean!, skating : boolean!, speed : number! }\n      RESTART { id : string }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, BODY_MOVED judges option landings; toggle to freeze every gate as-is.\"\n        @tier \"domain\"\n      gates : [ChoiceGate] = []\n        @label \"Choice Gates\"\n        @description \"One row per gate: id, gate center (x, y — y is the option-platform surface the judge tests against), the hint floated on a wrong answer, and the options: id, dx offset from the gate center, the label drawn above the platform, and correct. solved/chosen are stamped at runtime.\"\n        @tier \"domain\"\n      reachX : number = 0.7\n        @label \"Reach X\"\n        @description \"Horizontal tolerance (world units) around an option platform's center when testing a landing (approximates the body's half-width plus a step).\"\n        @tier \"domain\"\n      reachY : number = 1.2\n        @label \"Reach Y\"\n        @description \"Vertical tolerance (world units) around the gate's option plane when testing a landing (covers small hops onto the platform surface).\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/choice-gate\" as ChoiceGatePage -> ChoiceGate\n}\n"
}