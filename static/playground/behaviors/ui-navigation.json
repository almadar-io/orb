  "source": "",
  "lolo": "app ui-navigation \"1.0.0\"\n\"Navigation — UI factory (1:1 with the @almadar/ui navigation pattern).\"\norbital NavigationOrbital {\n  type NavigationItemsItem = {\n    id : string!\n    label : string!\n    icon : icon\n    badge : string\n    href : string\n    isActive : boolean\n    disabled : boolean\n    subMenu : [NavigationItemsItem]\n  }\n  type NavigationError = {\n    message : string!\n    name : string\n    code : string\n    stack : string\n  }\n\n  entity NavigationItem [runtime] {\n    id : string!\n  }\n\n  trait NavigationRender -> @rebindable NavigationItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          items: @config.items\n          orientation: @config.orientation\n          className: @config.className\n          isLoading: @config.isLoading\n          error: @config.error\n          type: navigation\n        })\n    }\n\n    config {\n      items : [NavigationItemsItem] = [{ id: \"Id\", label: \"Label\", icon: \"circle\", badge: \"Badge\", href: \"Href\", isActive: false, disabled: false, subMenu: [] }, { id: \"Id 2\", label: \"Label 2\", icon: \"circle\", badge: \"Badge 2\", href: \"Href 2\", isActive: true, disabled: true, subMenu: [] }]\n        @label \"Items\"\n        @description \"Navigation items\"\n        @tier \"presentation\"\n      orientation : \"horizontal\" | \"vertical\" = horizontal\n        @label \"Orientation\"\n        @description \"Navigation orientation\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      isLoading : boolean\n        @label \"Is Loading\"\n        @description \"Loading state indicator\"\n        @tier \"presentation\"\n      error : NavigationError\n        @label \"Error\"\n        @description \"Error state\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/navigation\" as NavigationPage -> NavigationRender\n}\n"
}