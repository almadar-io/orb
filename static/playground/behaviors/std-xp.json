  "source": "",
  "lolo": "app std-xp \"1.0.0\"\n\"Headless XP/progression mechanic: grants xp when the enemy survivor count drops (UNITS_CHANGED), and on reaching xpToNext levels up — raising the threshold and emitting a HEAL reward the grid-tactics authority applies. Owns only xp/xpToNext/level (+ kill baseline); never writes units.\"\norbital XpOrbital {\n  entity XpState [runtime, shared] {\n    id : string!\n    xp : number = 0\n    xpToNext : number = 100\n    level : number = 1\n    xpBaseline : number = 0\n  }\n\n  trait XpProgression -> @rebindable XpState [lifecycle] {\n    initial: active\n\n    state active {\n      INIT -> active\n        (set @entity.xp @config.startXp)\n        (set @entity.xpToNext @config.baseXpToNext)\n        (set @entity.level 1)\n        (set @entity.xpBaseline @config.initialEnemies)\n      UNITS_CHANGED -> active when @config.running\n        (set @entity.xp (if (< @payload.enemiesAlive @entity.xpBaseline) (+ @entity.xp (* (- @entity.xpBaseline @payload.enemiesAlive) @config.xpPerKill)) @entity.xp))\n        (set @entity.xpBaseline @payload.enemiesAlive)\n        (if (>= @entity.xp @entity.xpToNext) (emit HEAL { team: @config.healTeam, amount: @config.levelUpHeal }) null)\n        (set @entity.level (if (>= @entity.xp @entity.xpToNext) (+ @entity.level 1) @entity.level))\n        (set @entity.xpToNext (if (>= @entity.xp @entity.xpToNext) (+ @entity.xpToNext @config.xpToNextIncrement) @entity.xpToNext))\n    }\n\n    emits {\n      HEAL -> external {\n        team : string!\n        amount : number!\n      }\n        @description \"Level-up heal reward applied by the grid-tactics authority (the sole units writer)\"\n        @tier \"domain\"\n    }\n\n    listens {\n      UNITS_CHANGED { playersAlive : number, enemiesAlive : number }\n    }\n\n    config {\n      running : boolean = true\n        @label \"Running\"\n        @description \"When true, enemy-count drops grant xp and trigger level-ups; toggle to freeze.\"\n        @tier \"domain\"\n      xpPerKill : number = 25\n        @label \"XP Per Kill\"\n        @description \"XP awarded for each enemy removed since the last signal.\"\n        @tier \"domain\"\n      startXp : number = 0\n        @label \"Start XP\"\n        @description \"XP set on INIT.\"\n        @tier \"domain\"\n      baseXpToNext : number = 100\n        @label \"Base XP To Next\"\n        @description \"XP threshold for the first level-up.\"\n        @tier \"domain\"\n      xpToNextIncrement : number = 50\n        @label \"XP To Next Increment\"\n        @description \"Amount the threshold rises by on each level-up.\"\n        @tier \"domain\"\n      levelUpHeal : number = 2\n        @label \"Level-Up Heal\"\n        @description \"Health restored to the healTeam's units on each level-up.\"\n        @tier \"domain\"\n      healTeam : string = \"player\"\n        @label \"Heal Team\"\n        @description \"Team whose units are healed on level-up.\"\n        @tier \"domain\"\n      initialEnemies : number = 0\n        @label \"Initial Enemies\"\n        @description \"Enemy count at start; the kill baseline so the first kill grants xp correctly.\"\n        @tier \"domain\"\n    }\n  }\n\n  page \"/xp\" as XpPage -> XpProgression\n}\n"
}