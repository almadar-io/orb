  "source": "",
  "lolo": "app ui-swipeable-row \"1.0.0\"\n\"SwipeableRow — UI factory (1:1 with the @almadar/ui swipeable-row pattern).\"\n;; @pattern \"swipeable-row\"\norbital SwipeableRowOrbital {\n    type SwipeableRowLoaded = Event { data : SwipeableRowItem } \"SwipeableRow row finished loading; payload.data holds the single row\"\n  type SwipeableRowLeftActionsItem = {\n    label : string!\n    icon : icon\n    variant : \"primary\" | \"secondary\" | \"danger\" | \"ghost\"\n    event : event!\n    eventPayload : @payload event\n    when : SExpr\n    roles : [string]\n  }\n  type SwipeableRowRightActionsItem = {\n    label : string!\n    icon : icon\n    variant : \"primary\" | \"secondary\" | \"danger\" | \"ghost\"\n    event : event!\n    eventPayload : @payload event\n    when : SExpr\n    roles : [string]\n  }\n\n  entity SwipeableRowItem [runtime] {\n    id : string!\n  }\n\n  trait SwipeableRowRender -> @rebindable SwipeableRowItem [interaction, instance] {\n    initial: resolving\n\n    state resolving {\n      INIT -> idle when (and @config.selfFetch (!= (str/default ?id \"\") \"\"))\n        (fetch SwipeableRowItem { id: ?id, emit: { success: SwipeableRowLoaded } })\n        (render-ui main {\n          leftActions: (array/filter @config.leftActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))\n          rightActions: (array/filter @config.rightActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))\n          threshold: @config.threshold\n          children: @config.children\n          itemData: @entity\n          className: @config.className\n          type: swipeable-row\n        })\n      INIT -> idle when (not (and @config.selfFetch (!= (str/default ?id \"\") \"\")))\n        (render-ui main {\n          leftActions: (array/filter @config.leftActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))\n          rightActions: (array/filter @config.rightActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))\n          threshold: @config.threshold\n          children: @config.children\n          itemData: @entity\n          className: @config.className\n          type: swipeable-row\n        })\n    }\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          leftActions: (array/filter @config.leftActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))\n          rightActions: (array/filter @config.rightActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))\n          threshold: @config.threshold\n          children: @config.children\n          itemData: @entity\n          className: @config.className\n          type: swipeable-row\n        })\n      SwipeableRowLoaded -> idle\n        (render-ui main {\n          leftActions: (array/filter @config.leftActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))\n          rightActions: (array/filter @config.rightActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))\n          threshold: @config.threshold\n          children: @config.children\n          itemData: @payload.data\n          className: @config.className\n          type: swipeable-row\n        })\n    }\n\n    emits {\n      SwipeableRowLoaded\n        @description \"SwipeableRow row finished loading; payload.data holds the single row.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    listens {\n      INIT {\n        id : string\n      }\n        @description \"Mount payload; a host that routes to this panel by id (a :id page param) passes it here.\"\n        @tier \"internal\"\n    }\n\n    config {\n      leftActions : [SwipeableRowLeftActionsItem] = []\n        @label \"Left Actions\"\n        @description \"leftActions prop\"\n        @tier \"presentation\"\n      rightActions : [SwipeableRowRightActionsItem] = []\n        @label \"Right Actions\"\n        @description \"rightActions prop\"\n        @tier \"presentation\"\n      threshold : number = 80\n        @label \"Threshold\"\n        @description \"threshold prop\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"children prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n      viewerRole : string = \"\"\n        @label \"Viewer's role\"\n        @description \"The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show.\"\n        @tier \"policy\"\n      selfFetch : boolean = true\n        @label \"Fetch its own row on mount?\"\n        @description \"true (default) = a mount that carries an id loads that one row (never the collection); a create-mode mount skips the load. false = a composing atom owns the load.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/swipeable-row\" as SwipeableRowPage -> SwipeableRowRender\n}\n"
}