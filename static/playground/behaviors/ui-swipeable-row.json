  "source": "",
  "lolo": "app ui-swipeable-row \"1.0.0\"\n\"SwipeableRow — UI factory (1:1 with the @almadar/ui swipeable-row pattern).\"\norbital SwipeableRowOrbital {\n  type SwipeableRowLeftActionsItem = {\n    label : string!\n    icon : icon\n    variant : \"primary\" | \"secondary\" | \"danger\" | \"ghost\"\n    event : event!\n    eventPayload : Map string scalar\n  }\n  type SwipeableRowRightActionsItem = {\n    label : string!\n    icon : icon\n    variant : \"primary\" | \"secondary\" | \"danger\" | \"ghost\"\n    event : event!\n    eventPayload : Map string scalar\n  }\n\n  entity SwipeableRowItem [runtime] {\n    id : string!\n  }\n\n  trait SwipeableRowRender -> @rebindable SwipeableRowItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          leftActions: @config.leftActions\n          rightActions: @config.rightActions\n          threshold: @config.threshold\n          children: @config.children\n          itemData: @config.itemData\n          className: @config.className\n          type: swipeable-row\n        })\n    }\n\n    config {\n      leftActions : [SwipeableRowLeftActionsItem] = []\n        @label \"Left Actions\"\n        @description \"leftActions prop\"\n        @tier \"presentation\"\n      rightActions : [SwipeableRowRightActionsItem] = []\n        @label \"Right Actions\"\n        @description \"rightActions prop\"\n        @tier \"presentation\"\n      threshold : number = 80\n        @label \"Threshold\"\n        @description \"threshold prop\"\n        @tier \"presentation\"\n      children : node\n        @label \"Children\"\n        @description \"children prop\"\n        @tier \"presentation\"\n      itemData : Map string scalar = {}\n        @label \"Item Data\"\n        @description \"itemData prop\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"className prop\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/swipeable-row\" as SwipeableRowPage -> SwipeableRowRender\n}\n"
}