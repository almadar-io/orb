  "lolo": "app ui-book-chapter-view \"1.0.0\"\n\"BookChapterView — UI factory (1:1 with the @almadar/ui book-chapter-view pattern).\"\norbital BookChapterViewOrbital {\n    type BookChapterViewLoaded = Event { data : [BookChapterViewItem] } \"BookChapterView rows finished loading; payload.data holds the collection\"\n\n  entity BookChapterViewItem [runtime] {\n    id : string!\n  }\n\n  trait BookChapterViewRender -> @rebindable BookChapterViewItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle when @config.selfFetch\n        (fetch BookChapterViewItem { emit: { success: BookChapterViewLoaded } })\n        (render-ui main {\n          className: @config.className\n          chapter: @entity\n          direction: @config.direction\n          type: book-chapter-view\n        })\n      INIT -> idle when (not @config.selfFetch)\n        (render-ui main {\n          className: @config.className\n          chapter: @entity\n          direction: @config.direction\n          type: book-chapter-view\n        })\n      BookChapterViewLoaded -> idle\n        (render-ui main {\n          className: @config.className\n          chapter: @payload.data\n          direction: @config.direction\n          type: book-chapter-view\n        })\n    }\n\n    emits {\n      BookChapterViewLoaded\n        @description \"BookChapterView rows finished loading; payload.data holds the collection.\"\n        @synonyms \"loaded, fetched, retrieved\"\n        @tier \"essential\"\n    }\n\n    config {\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n      direction : \"rtl\" | \"ltr\" = rtl\n        @label \"Direction\"\n        @description \"direction prop\"\n        @tier \"presentation\"\n      selfFetch : boolean = true\n        @label \"Fetch its own rows on mount?\"\n        @description \"true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's.\"\n        @tier \"internal\"\n    }\n  }\n\n  page \"/book-chapter-view\" as BookChapterViewPage -> BookChapterViewRender\n}\n"
