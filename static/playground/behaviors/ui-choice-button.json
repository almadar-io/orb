  "source": "",
  "lolo": "app ui-choice-button \"1.0.0\"\n\"ChoiceButton — UI factory (1:1 with the @almadar/ui choice-button pattern).\"\norbital ChoiceButtonOrbital {\n  type ChoiceButtonAssetUrl = {\n    url : asset!\n    role : string!\n    category : string!\n    animations : [string]\n    style : \"pixel\" | \"vector\" | \"hd\" | \"1-bit\" | \"isometric\"\n    variant : string\n    dimension : \"2d\" | \"3d\"\n    aspect : \"1:1\" | \"16:9\" | \"5:7\" | \"8:1\"\n    atlas : asset\n    sprite : string\n    name : string\n    thumbnailUrl : string\n  }\n\n  entity ChoiceButtonItem [runtime] {\n    id : string!\n  }\n\n  trait ChoiceButtonRender -> @rebindable ChoiceButtonItem [interaction, instance] {\n    initial: idle\n\n    state idle {\n      INIT -> idle\n        (render-ui main {\n          text: @config.text\n          index: @config.index\n          assetUrl: @config.assetUrl\n          icon: @config.icon\n          disabled: @config.disabled\n          selected: @config.selected\n          onClick: @config.onClick\n          action: @config.action\n          payload: @config.payload\n          className: @config.className\n          type: choice-button\n        })\n    }\n\n    emits {\n      @config.onClick -> external {\n        id : string\n      }\n        @description \"Click handler\"\n        @tier \"essential\"\n      @config.action -> external {\n        id : string\n      }\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"essential\"\n    }\n\n    config {\n      text : string = \"Charge forward into the fray\"\n        @label \"Text\"\n        @description \"Choice text content\"\n        @tier \"presentation\"\n      index : number\n        @label \"Index\"\n        @description \"Choice index number (displayed as prefix)\"\n        @tier \"presentation\"\n      assetUrl : ChoiceButtonAssetUrl\n        @label \"Asset Url\"\n        @description \"Sprite asset — takes precedence over icon when provided\"\n        @tier \"presentation\"\n      icon : icon\n        @label \"Icon\"\n        @description \"Icon displayed before the text\"\n        @tier \"presentation\"\n      disabled : boolean = false\n        @label \"Disabled\"\n        @description \"Whether the choice is disabled\"\n        @tier \"presentation\"\n      selected : boolean = false\n        @label \"Selected\"\n        @description \"Whether the choice is currently selected\"\n        @tier \"presentation\"\n      onClick : string = \"CLICK\"\n        @label \"On Click\"\n        @description \"Click handler\"\n        @tier \"presentation\"\n      action : string = \"ACTION\"\n        @label \"Action\"\n        @description \"Declarative event name — emits UI:{action} via eventBus on click\"\n        @tier \"presentation\"\n      payload : Map string string = { item: \"Item\" }\n        @label \"Payload\"\n        @description \"Semantic payload emitted with the action (e.g. `{ nextId, choiceIndex }` for a branching choice).\"\n        @tier \"presentation\"\n      className : string\n        @label \"Class Name\"\n        @description \"Additional CSS classes\"\n        @tier \"presentation\"\n    }\n  }\n\n  page \"/choice-button\" as ChoiceButtonPage -> ChoiceButtonRender\n}\n"
}