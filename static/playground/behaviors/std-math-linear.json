{
  "name": "std-math-linear",
  "description": "Linear-systems engine — line A's slope animates on a Cartesian plot; the two lines' intersection point slides with it.",
  "level": "atom",
  "topic": "ui/learning",
  "schema": {
    "name": "std-math-linear",
    "version": "1.0.0",
    "description": "Linear-systems engine — line A's slope animates on a Cartesian plot; the two lines' intersection point slides with it.",
    "orbitals": [
      {
        "name": "MathLinearEngineOrbital",
        "entity": {
          "name": "MathLinearState",
          "persistence": "runtime",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "required": true
            },
            {
              "name": "phase",
              "type": "number",
              "default": 0
            },
            {
              "name": "curves",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "samples": {
                    "name": "samples",
                    "type": "array",
                    "required": false,
                    "items": {
                      "type": "object",
                      "properties": {
                        "y": {
                          "name": "y",
                          "type": "number",
                          "required": true
                        },
                        "x": {
                          "name": "x",
                          "type": "number",
                          "required": true
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "name": "points",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "y": {
                    "name": "y",
                    "type": "number",
                    "required": true
                  },
                  "color": {
                    "name": "color",
                    "type": "string",
                    "required": false
                  },
                  "label": {
                    "name": "label",
                    "type": "string",
                    "required": false
                  },
                  "radius": {
                    "name": "radius",
                    "type": "number",
                    "required": false
                  },
                  "x": {
                    "name": "x",
                    "type": "number",
                    "required": true
                  }
                }
              }
            },
            {
              "name": "running",
              "type": "boolean",
              "default": false
            }
          ]
        },
        "traits": [
          {
            "name": "MathLinearSim",
            "entityRebindable": true,
            "entityContract": {
              "requires": [],
              "provides": [
                "curves",
                "phase",
                "points",
                "running"
              ]
            },
            "category": "interaction",
            "linkedEntity": "MathLinearState",
            "emits": [
              {
                "event": "SYSTEM_UPDATED",
                "description": "The current scene each tick — a composed listener (readout, graph) can subscribe; a harmless no-op when the atom runs standalone.",
                "synonyms": "tick, frame, step, redraw",
                "tier": "domain",
                "scope": "external",
                "payloadSchema": [
                  {
                    "name": "curves",
                    "type": "[MathCurve]"
                  },
                  {
                    "name": "points",
                    "type": "[MathPoint]"
                  }
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "INIT",
                  "name": "Initialize"
                },
                {
                  "key": "SYSTEM_UPDATED",
                  "name": "System Updated",
                  "description": "The current scene each tick — a composed listener (readout, graph) can subscribe; a harmless no-op when the atom runs standalone.",
                  "synonyms": "tick, frame, step, redraw",
                  "tier": "domain",
                  "payloadSchema": [
                    {
                      "name": "curves",
                      "type": "[MathCurve]"
                    },
                    {
                      "name": "points",
                      "type": "[MathPoint]"
                    }
                  ]
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "INIT",
                  "effects": [
                    [
                      "set",
                      "@entity.phase",
                      0
                    ],
                    [
                      "set",
                      "@entity.curves",
                      [
                        {
                          "samples": [
                            {
                              "x": -9,
                              "y": -5
                            },
                            {
                              "y": 4,
                              "x": 9
                            }
                          ],
                          "color": "#2563eb",
                          "label": "A"
                        },
                        {
                          "color": "#16a34a",
                          "samples": [
                            {
                              "x": -9,
                              "y": 9.2
                            },
                            {
                              "x": 9,
                              "y": -1.6
                            }
                          ],
                          "label": "B"
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.points",
                      [
                        {
                          "y": 1.45,
                          "label": "solution",
                          "color": "#dc2626",
                          "radius": 6,
                          "x": 3.9
                        }
                      ]
                    ],
                    [
                      "set",
                      "@entity.running",
                      true
                    ],
                    [
                      "render-ui",
                      "main",
                      {
                        "type": "math-canvas",
                        "width": 600,
                        "curves": "@entity.curves",
                        "height": 400,
                        "points": "@entity.points"
                      }
                    ],
                    [
                      "emit",
                      "SYSTEM_UPDATED",
                      {
                        "points": "@entity.points",
                        "curves": "@entity.curves"
                      }
                    ]
                  ]
                }
              ]
            },
            "ticks": [
              {
                "name": "linearTick",
                "interval": 32,
                "guard": "@entity.running",
                "effects": [
                  [
                    "let",
                    [
                      [
                        "nphase",
                        [
                          "+",
                          "@entity.phase",
                          3
                        ]
                      ]
                    ],
                    [
                      "let",
                      [
                        [
                          "tw",
                          [
                            "-",
                            [
                              "/",
                              [
                                "math/abs",
                                [
                                  "-",
                                  [
                                    "math/mod",
                                    "@nphase",
                                    240
                                  ],
                                  120
                                ]
                              ],
                              120
                            ],
                            0.5
                          ]
                        ]
                      ],
                      [
                        "let",
                        [
                          [
                            "mA",
                            [
                              "*",
                              "@tw",
                              1.2
                            ]
                          ],
                          [
                            "mB",
                            -0.6
                          ]
                        ],
                        [
                          "let",
                          [
                            [
                              "denom",
                              [
                                "if",
                                [
                                  "<",
                                  [
                                    "math/abs",
                                    [
                                      "-",
                                      "@mA",
                                      "@mB"
                                    ]
                                  ],
                                  0.05
                                ],
                                0.05,
                                [
                                  "-",
                                  "@mA",
                                  "@mB"
                                ]
                              ]
                            ]
                          ],
                          [
                            "let",
                            [
                              [
                                "aInt",
                                [
                                  "+",
                                  -2,
                                  [
                                    "*",
                                    3,
                                    "@mA"
                                  ]
                                ]
                              ],
                              [
                                "bInt",
                                [
                                  "-",
                                  2,
                                  [
                                    "*",
                                    3,
                                    "@mB"
                                  ]
                                ]
                              ]
                            ],
                            [
                              "let",
                              [
                                [
                                  "xstar",
                                  [
                                    "/",
                                    [
                                      "-",
                                      "@bInt",
                                      "@aInt"
                                    ],
                                    "@denom"
                                  ]
                                ]
                              ],
                              [
                                "let",
                                [
                                  [
                                    "ystar",
                                    [
                                      "+",
                                      -2,
                                      [
                                        "*",
                                        "@mA",
                                        [
                                          "+",
                                          "@xstar",
                                          3
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [
                                  "let",
                                  [
                                    [
                                      "lineA",
                                      {
                                        "samples": [
                                          {
                                            "x": -9,
                                            "y": [
                                              "+",
                                              -2,
                                              [
                                                "*",
                                                "@mA",
                                                -6
                                              ]
                                            ]
                                          },
                                          {
                                            "y": [
                                              "+",
                                              -2,
                                              [
                                                "*",
                                                "@mA",
                                                12
                                              ]
                                            ],
                                            "x": 9
                                          }
                                        ],
                                        "color": "#2563eb",
                                        "label": "A"
                                      }
                                    ]
                                  ],
                                  [
                                    "let",
                                    [
                                      [
                                        "lineB",
                                        {
                                          "label": "B",
                                          "samples": [
                                            {
                                              "y": [
                                                "+",
                                                2,
                                                [
                                                  "*",
                                                  "@mB",
                                                  -12
                                                ]
                                              ],
                                              "x": -9
                                            },
                                            {
                                              "y": [
                                                "+",
                                                2,
                                                [
                                                  "*",
                                                  "@mB",
                                                  6
                                                ]
                                              ],
                                              "x": 9
                                            }
                                          ],
                                          "color": "#16a34a"
                                        }
                                      ]
                                    ],
                                    [
                                      "let",
                                      [
                                        [
                                          "solutionPoint",
                                          {
                                            "x": "@xstar",
                                            "label": "solution",
                                            "radius": 6,
                                            "color": "#dc2626",
                                            "y": "@ystar"
                                          }
                                        ]
                                      ],
                                      [
                                        "do",
                                        [
                                          "set",
                                          "@entity.phase",
                                          "@nphase"
                                        ],
                                        [
                                          "set",
                                          "@entity.curves",
                                          [
                                            "@lineA",
                                            "@lineB"
                                          ]
                                        ],
                                        [
                                          "set",
                                          "@entity.points",
                                          [
                                            "@solutionPoint"
                                          ]
                                        ],
                                        [
                                          "render-ui",
                                          "main",
                                          {
                                            "height": 400,
                                            "width": 600,
                                            "points": "@entity.points",
                                            "curves": "@entity.curves",
                                            "type": "math-canvas"
                                          }
                                        ],
                                        [
                                          "emit",
                                          "SYSTEM_UPDATED",
                                          {
                                            "curves": "@entity.curves",
                                            "points": "@entity.points"
                                          }
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              }
            ],
            "config": {
              "curves": {
                "type": "[MathCurve]",
                "default": [
                  {
                    "samples": [
                      {
                        "x": -9,
                        "y": -5
                      },
                      {
                        "y": 4,
                        "x": 9
                      }
                    ],
                    "color": "#2563eb",
                    "label": "A"
                  },
                  {
                    "color": "#16a34a",
                    "samples": [
                      {
                        "x": -9,
                        "y": 9.2
                      },
                      {
                        "x": 9,
                        "y": -1.6
                      }
                    ],
                    "label": "B"
                  }
                ],
                "label": "Curves",
                "description": "Initial pair of lines in data coordinates: A through (-3,-2), B through (3,2).",
                "tier": "domain",
                "items": {
                  "type": "object",
                  "properties": {
                    "samples": {
                      "name": "samples",
                      "type": "array",
                      "required": false,
                      "items": {
                        "type": "object",
                        "properties": {
                          "y": {
                            "name": "y",
                            "type": "number",
                            "required": true
                          },
                          "x": {
                            "name": "x",
                            "type": "number",
                            "required": true
                          }
                        }
                      }
                    },
                    "label": {
                      "name": "label",
                      "type": "string",
                      "required": false
                    },
                    "color": {
                      "name": "color",
                      "type": "string",
                      "required": false
                    }
                  }
                }
              },
              "width": {
                "type": "number",
                "default": 600,
                "label": "Width",
                "description": "Canvas width in pixels.",
                "tier": "presentation"
              },
              "height": {
                "type": "number",
                "default": 400,
                "label": "Height",
                "description": "Canvas height in pixels.",
                "tier": "presentation"
              },
              "points": {
                "type": "[MathPoint]",
                "default": [
                  {
                    "y": 1.45,
                    "label": "solution",
                    "color": "#dc2626",
                    "radius": 6,
                    "x": 3.9
                  }
                ],
                "label": "Points",
                "description": "Initial intersection point of the two lines in data coordinates.",
                "tier": "domain",
                "items": {
                  "type": "object",
                  "properties": {
                    "radius": {
                      "name": "radius",
                      "type": "number",
                      "required": false
                    },
                    "y": {
                      "name": "y",
                      "type": "number",
                      "required": true
                    },
                    "color": {
                      "name": "color",
                      "type": "string",
                      "required": false
                    },
                    "x": {
                      "name": "x",
                      "type": "number",
                      "required": true
                    },
                    "label": {
                      "name": "label",
                      "type": "string",
                      "required": false
                    }
                  }
                }
              },
              "mB": {
                "type": "number",
                "default": -0.6,
                "label": "Line B Slope",
                "description": "Fixed slope of line B through data point (3,2); line A's slope animates and the intersection tracks it.",
                "tier": "domain"
              },
              "running": {
                "type": "boolean",
                "default": true,
                "label": "Running",
                "description": "When true the tick animates line A's slope and recomputes the intersection; toggle to start/pause.",
                "tier": "domain"
              }
            },
            "scope": "instance"
          }
        ],
        "pages": [
          {
            "name": "MathLinearEnginePage",
            "path": "/math-linear",
            "traits": [
              {
                "ref": "MathLinearSim"
              }
            ]
          }
        ]
      }
    ],
    "_metadata": {
      "configProvenance": {
        "MathLinearEngineOrbital": [
          {
            "trait": "MathLinearSim",
            "patternPath": "root",
            "prop": "width",
            "knob": "width"
          },
          {
            "trait": "MathLinearSim",
            "patternPath": "root",
            "prop": "height",
            "knob": "height"
          }
        ]
      }
    }
  },
