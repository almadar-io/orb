{
  "name": "@almadar-io/behaviors",
  "version": "0.16.108",
  "description": "Almadar standard behaviors (app, game, marketing, probes, service, variations) — private companion to @almadar/std (core, agent).",
  "type": "module",
  "main": "./dist/behaviors/index.js",
  "module": "./dist/behaviors/index.js",
  "types": "./dist/behaviors/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/behaviors/index.js",
      "types": "./dist/behaviors/index.d.ts"
    },
    "./package.json": "./package.json",
    "./behaviors/*": {
      "import": "./dist/behaviors/*.js",
      "types": "./dist/behaviors/*.d.ts"
    },
    "./behaviors/functions/*": {
      "import": "./dist/behaviors/functions/*.js",
      "types": "./dist/behaviors/functions/*.d.ts"
    },
    "./behaviors/functions": {
      "import": "./dist/behaviors/functions/index.js",
      "types": "./dist/behaviors/functions/index.d.ts"
    },
    "./factory-runtime": {
      "import": "./dist/factory-runtime/index.js",
      "types": "./dist/factory-runtime/index.d.ts"
    }
  },
  "files": [
    "dist",
    "behaviors/registry/app",
    "behaviors/registry/curated",
    "behaviors/registry/dnd",
    "behaviors/registry/game",
    "behaviors/registry/kekec",
    "behaviors/registry/marketing",
    "behaviors/registry/mesh",
    "behaviors/registry/rpg",
    "behaviors/registry/service",
    "behaviors/registry/svg",
    "behaviors/registry/websites",
    "behaviors/lolo/app",
    "behaviors/lolo/curated",
    "behaviors/lolo/dnd",
    "behaviors/lolo/game",
    "behaviors/lolo/kekec",
    "behaviors/lolo/marketing",
    "behaviors/lolo/mesh",
    "behaviors/lolo/rpg",
    "behaviors/lolo/service",
    "behaviors/lolo/svg",
    "behaviors/lolo/websites"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@almadar/core": "^10.55.0"
  },
  "devDependencies": {
    "@almadar/llm": "^2.39.1",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "vitest": "^1.4.0",
    "turbo": "^2.8.17",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almadar-io/behaviors.git"
  },
  "license": "BSL-1.1",
  "keywords": [
    "almadar",
    "behaviors",
    "lolo",
    "orb"
  ],
  "scripts": {
    "build:embeddings": "node scripts/embed.mjs",
    "build:knob-embeddings": "node scripts/embed.mjs",
    "build": "tsup && pnpm run build:embeddings",
    "build:data": "node scripts/copy-dist-sidecars.mjs",
    "build:watch": "tsup --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  }
}