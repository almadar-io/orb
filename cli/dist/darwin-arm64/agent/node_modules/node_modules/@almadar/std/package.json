{
  "name": "@almadar/std",
  "version": "16.206.0",
  "description": "Standard library operators for Almadar (math, string, array, etc.)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json",
    "./modules/*": {
      "import": "./dist/modules/*.js",
      "require": "./dist/modules/*.js",
      "types": "./dist/modules/*.d.ts"
    },
    "./behaviors/*": {
      "import": "./dist/behaviors/*.js",
      "require": "./dist/behaviors/*.js",
      "types": "./dist/behaviors/*.d.ts"
    },
    "./behaviors/functions/*": {
      "import": "./dist/behaviors/functions/*.js",
      "require": "./dist/behaviors/functions/*.js",
      "types": "./dist/behaviors/functions/*.d.ts"
    },
    "./registry": {
      "import": "./dist/registry.js",
      "require": "./dist/registry.js",
      "types": "./dist/registry.d.ts"
    },
    "./behaviors/functions": {
      "import": "./dist/behaviors/functions/index.js",
      "require": "./dist/behaviors/functions/index.js",
      "types": "./dist/behaviors/functions/index.d.ts"
    },
    "./factory-runtime": {
      "import": "./dist/factory-runtime/index.js",
      "require": "./dist/factory-runtime/index.js",
      "types": "./dist/factory-runtime/index.d.ts"
    },
    "./canonical-operators.json": "./canonical-operators.json"
  },
  "files": [
    "dist",
    "behaviors/registry/agent",
    "behaviors/registry/infra",
    "behaviors/registry/ml",
    "behaviors/registry/ui",
    "behaviors/lolo",
    "canonical-operators.json"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@almadar/core": "^10.85.0"
  },
  "devDependencies": {
    "@almadar/eslint-plugin": "^2.17.0",
    "@almadar/llm": "^2.48.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "vitest": "^1.4.0",
    "turbo": "^2.8.17",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almadar-io/almadar-std.git",
    "directory": "docs/packages/std"
  },
  "license": "BSL-1.1",
  "keywords": [
    "almadar",
    "std",
    "standard-library",
    "operators"
  ],
  "homepage": "https://github.com/almadar-io/almadar#readme",
  "scripts": {
    "build:embeddings": "node scripts/embed.mjs",
    "build:knob-embeddings": "node scripts/embed.mjs",
    "build": "pnpm run build:embeddings && tsup",
    "build:data": "node scripts/copy-dist-sidecars.mjs",
    "build:watch": "tsup --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  }
}