{
  "name": "@almadar-io/behaviors",
  "version": "0.16.178",
  "description": "Almadar standard behaviors (app, game, marketing, probes, service, variations) — private companion to @almadar/std (core, agent).",
  "type": "module",
  "main": "./dist/behaviors/index.js",
  "module": "./dist/behaviors/index.js",
  "types": "./dist/behaviors/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/behaviors/index.js",
      "types": "./dist/behaviors/index.d.ts"
    },
    "./package.json": "./package.json",
    "./behaviors/*": {
      "import": "./dist/behaviors/*.js",
      "types": "./dist/behaviors/*.d.ts"
    },
    "./behaviors/functions/*": {
      "import": "./dist/behaviors/functions/*.js",
      "types": "./dist/behaviors/functions/*.d.ts"
    },
    "./behaviors/functions": {
      "import": "./dist/behaviors/functions/index.js",
      "types": "./dist/behaviors/functions/index.d.ts"
    },
    "./factory-runtime": {
      "import": "./dist/factory-runtime/index.js",
      "types": "./dist/factory-runtime/index.d.ts"
    }
  },
  "files": [
    "dist",
    "behaviors/registry/app",
    "behaviors/registry/game",
    "behaviors/registry/learning",
    "behaviors/registry/marketing",
    "behaviors/registry/service",
    "behaviors/registry/websites",
    "behaviors/registry/curated",
    "behaviors/registry/dnd",
    "behaviors/registry/svg",
    "behaviors/registry/mesh",
    "behaviors/registry/kekec",
    "behaviors/registry/riya",
    "behaviors/registry/kflow",
    "behaviors/registry/blaz-klemenc",
    "behaviors/registry/winning-11",
    "behaviors/registry/alummaalraqamia",
    "behaviors/registry/studio",
    "behaviors/registry/plugins",
    "behaviors/registry/project-friday",
    "behaviors/lolo/app",
    "behaviors/lolo/game",
    "behaviors/lolo/learning",
    "behaviors/lolo/marketing",
    "behaviors/lolo/service",
    "behaviors/lolo/websites",
    "behaviors/lolo/curated",
    "behaviors/lolo/dnd",
    "behaviors/lolo/svg",
    "behaviors/lolo/mesh",
    "behaviors/lolo/kekec",
    "behaviors/lolo/riya",
    "behaviors/lolo/kflow",
    "behaviors/lolo/blaz-klemenc",
    "behaviors/lolo/winning-11",
    "behaviors/lolo/alummaalraqamia",
    "behaviors/lolo/studio",
    "behaviors/lolo/plugins",
    "behaviors/lolo/project-friday",
    "behaviors/behaviors-registry.json",
    "behaviors/registry/factory-signatures.json",
    "behaviors/lolo-behavior-contracts.json",
    "behaviors/signatures.lolo"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "orb": {
    "prefix": "almadar-behaviors",
    "registry": "behaviors/registry",
    "index": "behaviors/behaviors-registry.json",
    "factorySignatures": "behaviors/registry/factory-signatures.json",
    "loloContracts": "behaviors/lolo-behavior-contracts.json",
    "signatures": "behaviors/signatures.lolo",
    "embeddings": [
      "dist/behaviors-embeddings.json",
      "dist/knob-embeddings.json"
    ],
    "compiler": ">=4.10.0"
  },
  "peerDependencies": {
    "@almadar/std": "^16.231.0"
  },
  "dependencies": {
    "@almadar/core": "^10.106.0"
  },
  "devDependencies": {
    "@almadar/llm": "^2.56.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "vitest": "^1.4.0",
    "turbo": "^2.8.17",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almadar-io/behaviors.git"
  },
  "license": "BSL-1.1",
  "keywords": [
    "almadar",
    "behaviors",
    "lolo",
    "orb"
  ],
  "scripts": {
    "build:embeddings": "node scripts/embed.mjs",
    "build:knob-embeddings": "node scripts/embed.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsup && pnpm run build:embeddings",
    "build:data": "node scripts/copy-dist-sidecars.mjs",
    "build:watch": "tsup --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  }
}